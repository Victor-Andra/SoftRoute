<!DOCTYPE html>
<html lang="pt-br">
<head>
	<title>DashBoard Administrativo</title>
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-sparklines/2.1.2/jquery.sparkline.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/flot/0.8.3/jquery.flot.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/flot/0.8.3/jquery.flot.pie.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
	<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
	<style>
		#grafico { width: 700px; height: 400px; }
		.tooltip {
			position: absolute; display: none; background: black; color: white;
			padding: 5px 10px; border-radius: 6px; font-size: 12px; pointer-events: none;
		}
	</style>
</head>
<body onload="javascript:controlaNave();" class="no-skin">
	<div class="page-header">
		<h1>
			DashBoard
			<small><i class="ace-icon fa fa-angle-double-right"></i> Administrativo</small>
		</h1>
		<div class="row" style="margin-bottom: 20px;">
			<div class="col-xs-12">
				<div class="alert alert-info text-center">
					<strong>Filtro de Período:</strong>
					<input style="height: 30px; margin: 0 5px;" id="dataFilDeTerapias" name="dataFilDeTerapias" type="date" value="{{dataIniFiltro}}">
					<label>até</label>
					<input style="height: 30px; margin: 0 5px;" id="dataFilAteTerapias" name="dataFilAteTerapias" type="date" value="{{dataFimFiltro}}">
					<button class="btn btn-sm btn-primary" onclick="recarregaTerapias()">Aplicar</button>
				</div>
			</div>
		</div>
	</div>

	<form class="form" role="form" action="" method="">
		<div class="form-horizontal" role="form">
			<div class="row">
				<div class="col-xs-12">
					<div class="tabbable">
						<ul class="inbox-tabs nav nav-tabs padding-16 tab-size-small tab-space-1" id="myTab">
							<li class="active"><a data-toggle="tab" href="#bene"><i class="red ace-icon fa fa-child"></i> Beneficiários</a></li>
							<li><a data-toggle="tab" href="#sessoes"><i class="orange ace-icon fa fa-coffee"></i> Sessões</a></li>
							<li><a data-toggle="tab" href="#terapias"><i class="green ace-icon fa fa-heartbeat"></i> Terapias</a></li>
							<li><a data-toggle="tab" href="#terapeutas"><i class="pink ace-icon fa fa-stethoscope"></i> Terapeutas</a></li>
							<li><a data-toggle="tab" href="#fat"><i class="blue ace-icon fa fa-money"></i> Faturamento</a></li>
						</ul>

						<div class="tab-content">
							<!-- ABA: Beneficiários -->
							<div id="bene" class="tab-pane fade active in">
								<div class="row">
									<div class="col-xs-12 col-sm-12 col-md-12 col-lg-4 col-xl-4">
										<div class="widget-box transparent">
											<div class="widget-header widget-header-flat">
												<h4 class="widget-title lighter"><i class="ace-icon fa fa-child purple"></i> Quantitativo dos Beneficiários</h4>
											</div>
											<div class="widget-body">
												<div class="widget-main no-padding">
													<p class="alert alert-info">Quantos beneficiários são liminar / credenciados / particular? <span class="badge badge-danger">Funcional!</span></p>
													<div id="pie-chart-beneficiarios" style="width: 100%; height: 300px;"></div>
													<br>
													<div class="clearfix">
														<div class="grid4">
															<span class="grey"><i class="ace-icon fa fa-home fa-2x green"></i>&nbsp; Particular</span><br>
															<h4 class="bigger pull-right">{{#each qtregsbenefiltrados}}{{#ifEqual campo 'qtConvEspecifico'}}{{valor}}{{/ifEqual}}{{/each}}</h4>
														</div>
														<div class="grid4">
															<span class="grey"><i class="ace-icon fa fa-gavel fa-2x red"></i>&nbsp; Liminar</span><br>
															<h4 class="bigger pull-right">{{#each qtregsbenefiltrados}}{{#ifEqual campo 'qtLiminarSim'}}{{valor}}{{/ifEqual}}{{/each}}</h4>
														</div>
														<div class="grid4">
															<span class="grey"><i class="ace-icon fa fa-heartbeat fa-2x blue"></i>&nbsp; Credênciados</span><br>
															<h4 class="bigger pull-right">{{#each qtregsbenefiltrados}}{{#ifEqual campo 'qtLiminarNao'}}{{valor}}{{/ifEqual}}{{/each}}</h4>
														</div>
														<div class="grid4">
															<span class="grey"><i class="ace-icon fa fa-university fa-2x purple"></i>&nbsp; Total</span><br>
															<h4 class="bigger pull-right">{{#each qtregsbenefiltrados}}{{#ifEqual campo 'qtAtivos'}}{{valor}}{{/ifEqual}}{{/each}}</h4>
														</div>
													</div>
													
													<div id="pie-chart-data"
														data-particular="{{#each qtregsbenefiltrados}}{{#ifEqual campo 'qtConvEspecifico'}}{{valor}}{{/ifEqual}}{{/each}}"
														data-convenios="{{#each qtregsbenefiltrados}}{{#ifEqual campo 'qtLiminarNao'}}{{valor}}{{/ifEqual}}{{/each}}"
														data-liminar="{{#each qtregsbenefiltrados}}{{#ifEqual campo 'qtLiminarSim'}}{{valor}}{{/ifEqual}}{{/each}}">
													</div>
												</div>
											</div>
										</div>
									</div>

									<div class="col-xs-12 col-sm-12 col-md-12 col-lg-4 col-xl-4">
										<div class="widget-box transparent">
											<div class="widget-header widget-header-flat">
												<h4 class="widget-title lighter">
													<i class="ace-icon fa fa-heartbeat red"></i>
													 Quantificação por Credenciados
												</h4>
											</div>
											<div class="widget-body">
												<div class="widget-main no-padding">
													<p class="alert alert-info">Quantidade de beneficiários por convênio <span class="badge badge-danger">Funcional!</span></p>
													<div id="grafico-barras-conv" style="width: 100%; max-width: 900px; margin: 0 auto;"></div>
												</div>
											</div>
										</div>
									</div>

									<div class="col-xs-12 col-sm-12 col-md-12 col-lg-4 col-xl-4">
										<div class="widget-box transparent">
											<div class="widget-header widget-header-flat">
												<h4 class="widget-title lighter">
													<i class="ace-icon fa fa-line-chart orange"></i>
													Evolução dos Beneficiários 
												</h4>
												
											</div>
											<div class="widget-body" >
												<div class="widget-main no-padding">
													<p class="alert alert-info">Evolução Mensal dos Beneficiários </p>
													<div id="GraficoBarrasSegEvolucaoBene" style="width: 100%; max-width: 1200px; margin: 0 auto;"></div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

							<!-- ABA: Sessões -->
							<div id="sessoes" class="tab-pane fade">

								<div class="row">
									<!-- Resumo 2 -->
									<div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
										<div class="widget-box transparent">
											<div class="widget-header"><h4 class="widget-title lighter"><i class="ace-icon fa fa-code purple"></i> Sessões por Particular, Credênciado e Liminar</h4></div>
											<div class="widget-body">
												<div class="widget-main">
													<div class="widget-main no-padding">
														<p class="alert alert-info">Total de Sessões Particulares, Credênciados e Liminares por período   <span class="badge badge-danger">Funcional!</span></p>
														
													</div>
													<div class="widget-box" id="widget-box-SessoesPorTipoBene">
														<div class="widget-header">
															<h5 class="widget-title">
																<i class="brown ace-icon fa fa-cogs"></i>
																Resumo dos Totais de Sessões
															</h5>
															<div class="widget-toolbar" >
																<a href="#" data-action="fullscreen" class="orange2">
																	<i class="ace-icon fa fa-expand"></i>
																</a>
																
																<a href="#" data-action="collapse">
																	<i class="ace-icon fa fa-chevron-up"></i>
																</a>
															</div>
														</div>
														<div class="widget-body" style="display: block;">
															<div class="widget-main">
																<div class="row">
																	<div class="col-xs-12">
																		<table name="tabSessoesTipoBene" class="table table-condensed table-bordered">
																			<thead>
																				<tr class="info">
																					<th>Tipo de Beneficiário</th>
																					<th class="center">Total de Sessões</th>
																				</tr>
																			</thead>
																			<tbody>
																				{{#each resumoSessoesPorTipo}}
																				<tr>
																					<td>{{tipo}}</td>
																					<td class="center">{{total}}</td>
																				</tr>
																				{{/each}}
																			</tbody>
																			<tfoot>
																				<tr class="success">
																					<td><strong>Total Geral</strong></td>
																					<td class="center"><strong>{{totalSessoes}}</strong></td>
																				</tr>
																			</tfoot>
																		</table>
																	</div>
																</div>
															</div>
														</div>
													</div>
													<div id="graficoSessoesPorTipo" style="width: 100%; height: 300px;"></div>
													

												</div>
											</div>
										</div>
									</div>
									
									<div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
										<div class="widget-box transparent">
											<div class="widget-header"><h4 class="widget-title lighter"><i class="ace-icon fa fa-code purple"></i>Evolução dos Atendimentos por Convênio Anual</h4></div>
											<div class="widget-body">
												<div class="widget-main">
													<div class="widget-main no-padding">
														<p class="alert alert-info">Evolução dos Atendimentos por Convênio Anual, infome o período para definir o anoi apenas. <span class="badge badge-danger">Funcional!</span></p>
														
													</div>
													
													<div id="GraficoAtendimentosConv" style="width: 100%; height: 300px;"></div>
													

												</div>
											</div>
										</div>
									</div>
									
								</div>

							</div>

							<!-- ABA: Terapias (NOVA) -->
							<div id="terapias" class="tab-pane fade">
								<div class="row">
									<!-- Resumo 2 -->
									<div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
										<div class="widget-box transparent">
											<div class="widget-header"><h4 class="widget-title lighter"><i class="ace-icon fa fa-code purple"></i> Atendimentos por Código (nomecid)</h4></div>
											<div class="widget-body">
												<div class="widget-main">
													<div class="widget-main no-padding">
														<p class="alert alert-info">Quantidade de Terapias por Período <span class="badge badge-danger">Funcional!</span></p>
														<div id="stackedBarrasChartFatConv" style="width: 100%; max-width: 900px; margin: 0 auto;"></div>
													</div>
													<div class="widget-box" id="widget-box-TerapiaNomeCid">
														<div class="widget-header">
															<h5 class="widget-title">
																<i class="brown ace-icon fa fa-cogs"></i>
																Resumo por Terapia
															</h5>
															<div class="widget-toolbar" >
																<a href="#" data-action="fullscreen" class="orange2">
																	<i class="ace-icon fa fa-expand"></i>
																</a>
																
																<a href="#" data-action="collapse">
																	<i class="ace-icon fa fa-chevron-up"></i>
																</a>
															</div>
														</div>
														<div class="widget-body" style="display:none;">
															<div class="widget-main" >
																<div class="row">
																	<div class="col-xs-12">
																		
																			<table name="tabTerapiaNomeCid" class="table table-condensed table-bordered">
																				<thead>
																					<tr class="info">
																						<th>Código</th>
																						<th class="center">Total</th>
																					</tr>
																				</thead>
																				<tbody>
																					{{#each resumoTerapiaNomecid}}
																					<tr>
																						<td>{{terapiaNomecid}}</td>
																						<td class="center">{{total}}</td>
																					</tr>
																					{{/each}}
																				</tbody>
																			</table>
																		
																	</div>
																</div>
															</div>
														</div>
													</div>
													<div style=" margin-bottom: 15px;"><canvas id="graficoTerapiaNomecid"></canvas></div>
													
												</div>
											</div>
										</div>
									</div>
									<!-- Resumo 1 -->
									<div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
										<div class="widget-box transparent">
											<div class="widget-header"><h4 class="widget-title lighter"><i class="ace-icon fa fa-bar-chart green"></i> Atendimentos por Terapia</h4></div>
											<div class="widget-body">
												<div class="widget-main">
													<div class="widget-main no-padding">
														<p class="alert alert-info">Quantidade de Terapias Específicas <span class="badge badge-danger">Funcional!</span></p>
														<div id="stackedBarrasChartFatConv" style=" margin: 0 auto;"></div>
													</div>
													<div class="widget-box" id="widget-box-TerapiaNomeEsp">
														<div class="widget-header">
															<h5 class="widget-title">
																<i class="brown ace-icon fa fa-cogs"></i>
																Resumo por Terapia Específicas
															</h5>
															<div class="widget-toolbar" >
																<a href="#" data-action="fullscreen" class="orange2">
																	<i class="ace-icon fa fa-expand"></i>
																</a>
																
																<a href="#" data-action="collapse">
																	<i class="ace-icon fa fa-chevron-up"></i>
																</a>
															</div>
														</div>
														<div class="widget-body">
															<div class="widget-main">
																<div class="row">
																	<div class="col-xs-12">
																		
																			<table name="tabTerapiaNomeEsp" class="table table-condensed table-bordered">
																				<thead>
																					<tr class="info">
																						<th>Terapia</th>
																						<th class="center">Total</th>
																					</tr>
																				</thead>
																				<tbody>
																					{{#each resumoTerapia}}
																					<tr>
																						<td>{{terapiaNome}}</td>
																						<td class="center">{{total}}</td>
																					</tr>
																					{{/each}}
																				</tbody>
																			</table>
																		
																	</div>
																</div>
															</div>
														</div>
													</div>
													<div style=" margin-bottom: 15px;"><canvas id="graficoTerapiaNome"></canvas></div>
													
													
												</div>
											</div>
										</div>
									</div>
								
									
								</div>
							</div>

							<!-- ABA: Terapeutas -->
							<div id="terapeutas" class="tab-pane fade">
								<div class="row">
									<!-- Resumo 3 - Atendimentos por Terapeuta-->
									<div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
										<div class="widget-box transparent">
											<div class="widget-header"><h4 class="widget-title lighter"><i class="ace-icon fa fa-user-md orange"></i> Atendimentos por Terapeuta</h4></div>
											<div class="widget-body">
												<div class="widget-main">
													<div class="widget-main no-padding">
														<p class="alert alert-info">Quantidade de Terapias Realizadas pelos Terapeutas por Período <span class="badge badge-danger">Funcional</span></p>
														<div id="stackedBarrasChartFatConv" style="width: 100%; max-width: 900px; margin: 0 auto;"></div>
													</div>
													<div class="widget-box" id="widget-box-TerapiaNomeEsp">
														<div class="widget-header">
															<h5 class="widget-title">
																<i class="brown ace-icon fa fa-cogs"></i>
																Resumo por Terapias Realizadas pelos Terapeutas por Período
															</h5>
															<div class="widget-toolbar" >
																<a href="#" data-action="fullscreen" class="orange2">
																	<i class="ace-icon fa fa-expand"></i>
																</a>
																
																<a href="#" data-action="collapse">
																	<i class="ace-icon fa fa-chevron-up"></i>
																</a>
															</div>
														</div>
														<div class="widget-body" ">
															<div class="widget-main">
																<div class="row">
																	<div class="col-xs-12">
																		
																			<table name="tabTerapiaNomeEsp" class="table table-condensed table-bordered">
																				<thead>
																					<tr class="info">
																						<th>Terapeuta</th>
																						<th class="center">Total</th>
																					</tr>
																				</thead>
																				<tbody>
																					{{#each resumoTerapeuta}}
																					<tr>
																						<td>{{nome}}</td>
																						<td class="center">{{total}}</td>
																					</tr>
																					{{/each}}
																				</tbody>
																			</table>
																		
																	</div>
																</div>
															</div>
														</div>
													</div>
													<div style=" margin-bottom: 15px;"><canvas id="graficoTerapeuta"></canvas></div>
													
												</div>
											</div>
										</div>
									</div>
									<!-- Resumo 4 - Atendimentos e Terapias por Terapeuta-->
									<div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
										<div class="widget-box transparent">
											<div class="widget-header"><h4 class="widget-title lighter"><i class="ace-icon fa fa-th-list blue"></i> Atendimentos e Terapias por Terapeuta</h4></div>
											<div class="widget-body">
												<div class="widget-main">
													<div class="widget-main no-padding">
														<p class="alert alert-info">Resumo por Terapias Realizadas pelos Terapeutas por Período <span class="badge badge-danger">Funcional</span></p>
														<div id="stackedBarrasChartFatConv" style="width: 100%; max-width: 900px; margin: 0 auto;"></div>
													</div>
													<div class="widget-box" id="widget-box-TerapeutaAtendeTerapias">
														<div class="widget-header">
															<h5 class="widget-title">
																<i class="brown ace-icon fa fa-cogs"></i>
																Resumo por Terapias Realizadas pelos Terapeutas por Período
															</h5>
															<div class="widget-toolbar" >
																<a href="#" data-action="fullscreen" class="orange2">
																	<i class="ace-icon fa fa-expand"></i>
																</a>
																
																<a href="#" data-action="collapse">
																	<i class="ace-icon fa fa-chevron-up"></i>
																</a>
															</div>
														</div>
														<div class="widget-body" style="display: block;">
															<div class="widget-main">
																<div class="row">
																	<div class="col-xs-12">
																		
																			<table name="tabTerapeutaAtendeTerapias" class="table table-condensed table-bordered">
																				<thead>
																					<tr class="info">
																						<th>Terapeuta</th>
																						<th class="center">Atendimentos</th>
																						<th class="center">Terapias</th>
																					</tr>
																				</thead>
																				<tbody>
																					{{#each resumoDetalhado}}
																					<tr>
																						<td>{{nome}}</td>
																						<td>{{totalAtendimentos}}</td>
																						<td class="center">{{totalTerapias}}</td>
																					</tr>
																					{{/each}}
																				</tbody>
																			</table>
																		
																	</div>
																</div>
															</div>
														</div>
													</div>
													<div style=" margin-bottom: 15px;"><canvas id="graficoDetalhado"></canvas></div>
													
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

							<!-- ABA: Faturamento -->
							<div id="fat" class="tab-pane fade">
								<div class="row">
									<div class="col-xs-12 col-sm-12 col-md-12 col-lg-4 col-xl-4">
										<div class="widget-box transparent">
											<div class="widget-header widget-header-flat">
												<h4 class="widget-title lighter"><i class="ace-icon fa fa-child purple"></i> Faturamento por Categoria</h4>
											</div>
											<div class="widget-body">
												<div class="widget-main no-padding">
													<p class="alert alert-info">Faturamento por categoria <span class="badge badge-warning">Em Desenvolvimento</span></p>
													<canvas id="stackedPieChartFatCateg" width="200" height="200"></canvas>
													<div class="clearfix">
														<!-- (valores iguais aos de beneficiários) -->
													</div>
													<div id="pie-chart-faturamento" style="width: 100%; height: 300px;"></div>
												</div>
											</div>
										</div>
									</div>
									<div class="col-xs-12 col-sm-12 col-md-12 col-lg-4 col-xl-4">
										<div class="widget-box transparent">
											<div class="widget-header widget-header-flat">
												<h4 class="widget-title lighter"><i class="ace-icon fa fa-heartbeat red"></i> Faturamento por Credenciados</h4>
											</div>
											<div class="widget-body">
												<div class="widget-main no-padding">
													<p class="alert alert-info">Quantidade de beneficiários por convênio <span class="badge badge-warning">Em Desenvolvimento</span></p>
													<div id="stackedBarrasChartFatConv" style="width: 100%; max-width: 900px; margin: 0 auto;"></div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

							<!-- ABA TEMP (gráficos de exemplo) -->
