	<!-- Gráfico de Pizza (Flot.js) - Beneficiários -->
	<script>
		function renderGraficoPizzaBeneficiarios() {
			console.log("🔍 Renderizando: Gráfico de Pizza - Beneficiários (Flot.js)");
			const $data = $("#pie-chart-data");
			const particular = parseFloat($data.attr("data-particular")) || 0;
			const convenios = parseFloat($data.attr("data-convenios")) || 0;
			const liminar = parseFloat($data.attr("data-liminar")) || 0;

			if (isNaN(particular) || isNaN(convenios) || isNaN(liminar)) {
				console.error("⚠️ Dados inválidos para gráfico de beneficiários.");
				return;
			}

			const data = [
				{ label: "Particular", data: particular, color: "#1abc9c" },
				{ label: "Convênios", data: convenios, color: "#3498db" },
				{ label: "Liminar", data: liminar, color: "#e74c3c" }
			];
			const options = {
				series: { pie: { show: true, radius: 1, label: { show: true, radius: 3/4, formatter: (label, series) => `<div style='font-size:12px;text-align:center;padding:5px;color:white;'>${label}<br>${Math.round(series.percent)}%</div>`, background: { opacity: 0.5, color: '#000' } } } },
				legend: { show: false }
			};
			$.plot("#pie-chart-beneficiarios", data, options);
		}
	</script>

	<!-- Gráfico de Barras Horizontal - Convênios (ApexCharts) -->
	<script>
		function renderGraficoBarrasConv() {
			console.log("🔍 Renderizando: Gráfico de Barras - Convênios (ApexCharts)");
			const nomes = [{{#each convs}}"{{conv_nome}}"{{#unless @last}},{{/unless}}{{/each}}];
			const quantidades = [{{#each convs}}{{#each ../arrayRelQtValors}}{{#ifEqual ../_id idlocal}}{{valor}}{{#unless @last}},{{/unless}}{{/ifEqual}}{{/each}}{{/each}}];
			const options = {
				series: [{ name: "Qt", data: quantidades }],
				chart: { type: 'bar', height: 450, toolbar: { show: true } },
				plotOptions: { bar: { horizontal: true } },
				dataLabels: { enabled: true },
				xaxis: { categories: nomes, title: { text: 'Beneficiários' } },
				colors: ['#00E396'],
				tooltip: { y: { formatter: v => v + " Beneficiários" } }
			};
			new ApexCharts(document.querySelector("#grafico-barras-conv"), options).render();
		}
	</script>

	<!-- Evolução Mensal (ApexCharts) -->
	<script>
function renderGraficoEvolucaoMensalBene() {
	console.log("📊 Renderizando gráfico de evolução mensal de beneficiários (ApexCharts)");

	const labels = [{{#each evolucaoBene.labels}}"{{this}}"{{#unless @last}},{{/unless}}{{/each}}];
	const base = [{{#each evolucaoBene.seriesBase}}{{this}}{{#unless @last}},{{/unless}}{{/each}}];
	const novos = [{{#each evolucaoBene.seriesNovos}}{{this}}{{#unless @last}},{{/unless}}{{/each}}];
	const descontinuados = [{{#each evolucaoBene.seriesDescontinuados}}{{this}}{{#unless @last}},{{/unless}}{{/each}}];
	const total = [{{#each evolucaoBene.totals}}{{this}}{{#unless @last}},{{/unless}}{{/each}}];

	const options = {
		series: [
			{ name: "Anos Anteriores (Ativos)", type: "column", data: base },
			{ name: "Novos Cadastrados", type: "column", data: novos },
			{ name: "Descontinuados", type: "column", data: descontinuados },
			{ name: "Total Acumulado", type: "line", data: total }
		],
		chart: {
			height: 420,
			stacked: true,
			toolbar: { show: true },
			zoom: { enabled: false }
		},
		plotOptions: {
			bar: { horizontal: false, columnWidth: "55%", borderRadius: 4 }
		},
		stroke: {
			width: [0, 0, 0, 3],
			curve: "smooth"
		},
		markers: {
			size: 5,
			strokeWidth: 2,
			strokeColors: "#fff",
			fillOpacity: 1,
			hover: { size: 7 }
		},
		xaxis: {
			categories: labels,
			title: { text: "Mês" }
		},
		yaxis: { title: { text: "Quantidade de Beneficiários" }, min: 0 },
		legend: { position: "top", horizontalAlign: "center" },
		fill: { opacity: [1, 1, 1, 0] },
		dataLabels: { enabled: false },
		colors: ["#3498db", "#2ecc71", "#e74c3c", "#2c3e50"],
		tooltip: {
			shared: true,
			intersect: false,
			y: { formatter: val => `${Math.round(val)} beneficiários` }
		},
		grid: { borderColor: "#eee", strokeDashArray: 4 }
	};

	const chart = new ApexCharts(document.querySelector("#GraficoBarrasSegEvolucaoBene"), options);
	chart.render();
}
</script>



