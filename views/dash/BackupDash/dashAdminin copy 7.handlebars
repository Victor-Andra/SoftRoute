		<script>
			$(document).ready(function () {
			console.log("gráfico de pizza 1 carregado");

			function drawPieChart() {
				console.log("Desenhando o gráfico de pizza...");

				// Recuperar os valores dos atributos data-* usando .attr()
				var particular = parseFloat($("#pie-chart-data").attr("data-particular")) || 0;
				var convenios = parseFloat($("#pie-chart-data").attr("data-convenios")) || 0;
				var liminar = parseFloat($("#pie-chart-data").attr("data-liminar")) || 0;

				console.log("Particular (antes da conversão):", $("#pie-chart-data").attr("data-particular"));
				console.log("Convênios (antes da conversão):", $("#pie-chart-data").attr("data-convenios"));
				console.log("Liminar (antes da conversão):", $("#pie-chart-data").attr("data-liminar"));

				console.log("Particular da função:", particular);
				console.log("Convênios da função:", convenios);
				console.log("Liminar da função:", liminar);

				// Verificar se os valores foram convertidos corretamente
				if (isNaN(particular) || isNaN(convenios) || isNaN(liminar)) {
					console.error("Erro: Os valores não são números válidos.");
					return;
				}

				var data = [
					{ label: "Particular", data: particular, color: "#1abc9c" },
					{ label: "Convênios", data: convenios, color: "#3498db" },
					{ label: "Liminar", data: liminar, color: "#e74c3c" }
				];

				var options = {
					series: {
						pie: {
							show: true,
							radius: 1,
							label: {
								show: true,
								radius: 3 / 4,
								formatter: function (label, series) {
									return `<div style="font-size:12px; text-align:center; padding:5px; color:white;">${label}<br>${Math.round(series.percent)}%</div>`;
								},
								background: {
									opacity: 0.5,
									color: '#000'
								}
							}
						}
					},
					legend: { show: false }
				};

				if ($("#pie-chart").length > 0) {
					$.plot($("#pie-chart"), data, options);
					console.log("Gráfico desenhado com sucesso");
				} else {
					console.error("Elemento #pie-chart não encontrado");
				}
			}

			drawPieChart();
		});
		</script>

		<script>
			function initEasySparkline() {
				console.log("Iniciando Sparkline");

				if (typeof $.fn.sparkline !== "function") {
					console.error("Biblioteca Sparkline não carregada.");
					return;
				}

				const fixedColors = [
					'#FF0000', // Vermelho
					'#00FF00', // Verde
					'#0000FF', // Azul
					'#FFFF00', // Amarelo
					'#FFA500', // Laranja
					'#800080', // Roxo
					'#00FFFF'  // Ciano
				];

				$('.sparkline').each(function () {
					const $this = $(this);
					const values = $this.data('values');

					if (!values) {
						console.error("Atributo data-values não definido ou vazio:", $this);
						return;
					}

					try {
						$this.sparkline('html', {
							tagValuesAttribute: 'data-values',
							type: 'bar',
							barWidth: 8,
							height: '30px',
							chartRangeMin: 0,
							colorMap: fixedColors.slice(0, values.split(',').length), // Seleciona cores com base na quantidade de barras
							barColor: null // Evita sobrescrever o colorMap com uma cor única
						});
						console.log("Sparkline desenhado com cores fixas no elemento:", $this);
					} catch (error) {
						console.error("Erro ao desenhar Sparkline:", error);
					}
				});
			}
		</script>
		
		<script>
			function initBargraf() {
				console.log("Iniciando gráfico de barras...");
				
				const ctx = document.getElementById('stackedBarChart-Simples').getContext('2d');
				
				if (!ctx) {
					console.error('Não foi possível encontrar o elemento canvas.');
					return;
				}

				// Dados do gráfico
				const data = {
					labels: ['Tipos de Faturamentos'],
					datasets: [
						{
							label: 'Credenciados',
							backgroundColor: 'rgba(0, 255, 0, 0.5)', // verde limão
							data: [2000.00]
						},
						{
							label: 'Particular',
							backgroundColor: 'rgba(255, 255, 0, 0.5)', // amarelo
							data: [500.00]
						},
						{
							label: 'Liminar',
							backgroundColor: 'rgba(255, 99, 132, 0.5)', // cor padrão
							data: [1000.00]
						}
						
					]
				};

				// Opções do gráfico
				const options = {
					responsive: true,
					scales: {
						x: { stacked: true },
						y: { stacked: true, min: 0, max: 3500 }
					}
				};

				// Criar o gráfico
				new Chart(ctx, {
					type: 'bar',
					data: data,
					options: options
				});

				console.log("Gráfico de barras renderizado com sucesso!");
			}
