		<script>//stackedPieChartFatCategBene
			document.addEventListener("DOMContentLoaded", function () {
				const ctx = document.getElementById('stackedPieChartFatCategBene').getContext('2d');

				const dataValues = [2000.00, 500.00, 1000.00];

				new Chart(ctx, {
					type: 'pie',
					data: {
						labels: ['Credenciados', 'Particular', 'Liminar'],
						datasets: [{
							data: dataValues,
							backgroundColor: [
								'rgba(0, 255, 0, 0.5)',
								'rgba(255, 255, 0, 0.5)',
								'rgba(255, 99, 132, 0.5)'
							],
							hoverOffset: 4
						}]
					},
					options: {
						responsive: true,
						plugins: {
							datalabels: {
								formatter: (value, context) => {
									const total = context.chart._metasets[0].total;
									const percentage = ((value / total) * 100).toFixed(1) + '%';
									return percentage;
								},
								color: '#000',
								font: {
									weight: 'bold',
									size: 14
								}
							},
							legend: {
								position: 'top',
							},
							tooltip: {
								callbacks: {
									label: function (context) {
										const value = context.raw;
										const total = context.chart._metasets[0].total;
										const percentage = ((value / total) * 100).toFixed(1) + '%';
										return `R$ ${value.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} (${percentage})`;
									}
								}
							}
						}
					},
					plugins: [ChartDataLabels]
				});
			});
		</script>


