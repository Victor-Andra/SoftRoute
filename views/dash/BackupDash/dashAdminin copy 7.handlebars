		<script>
			document.addEventListener("DOMContentLoaded", function () {
				// Seleciona a div que contém os atributos data-*
				const pieChartData = document.getElementById("pie-chart-data");

				// Obtém os valores dos atributos data-*
				const particular = pieChartData.getAttribute("data-particular");
				const convenios = pieChartData.getAttribute("data-convenios");
				const liminar = pieChartData.getAttribute("data-liminar");
				const total = pieChartData.getAttribute("data-total");

				// Preenche os inputs com os valores obtidos
				document.getElementById("qtConvEspecifico").value = particular;
