<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>DashBoard Financeiro</title>
		<script type="text/javascript">
			function atualizaDataIni(){
				let fulldate = (document.getElementById('dataFilDe').value+' 00:00:00.000Z').toString();
				document.getElementById('dataIni').value = fulldate;
			}
			function atualizaDataFin(){
				let fulldate = (document.getElementById('dataFilAte').value+' 00:00:00.000Z').toString();
				document.getElementById('dataFim').value = fulldate;
			}
			function carregaBody(){
				/*
				let sessoes = document.getElementsByName("sessoes")
				let valores = document.getElementsByName("valor")
				sessoes.forEach((s)=>{
					let subTotal = s.value * (document.getElementById("valor"+s.id).value);
					document.getElementById("subtotal"+s.id).value = subTotal;
				})*/
			}
		</script>
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">


			<div class="main-content">
				<div class="main-content-inner">
					<div class="espace">
					</div>
					<div class="page-header">
						<h1>
							DashBoard
							<small>
								<i class="ace-icon fa fa-angle-double-right"></i>
								 Financeiro
							</small>
						</h1>
					</div><!-- /.page-header -->

					<div class="row">
						<div class="col-xs-12">
							<!-- PAGE CONTENT BEGINS -->
							

					<form role="form" action="/menu/dash/dashFinan" method="POST">
						<div class="breadcrumbs" id="breadcrumbs" style="align-items: center;" style="text-align: center;" />
							<ul class="breadcrumb" >
								<label>Período de:</label>
								<input style="height: 30px;" id="dataFilDe" name="dataFilDe" type="date" onchange="javascript:atualizaDataIni()">
								<input class="hidden" id="dataIni" name="dataIni" />
								<label>até:</label>
								<input style="height: 30px;" id="dataFilAte" name="dataFilAte" type="date" onchange="javascript:atualizaDataFin()">
								<input class="hidden" id="dataFim" name="dataFim" />
								<label>Convênio: </label>
								<select style="height: 30px; width:300px;" name="relConvid"  id="relConvid" class="select2" data-placeholder="Escolha...">
									{{#each convs}}
										<option value="{{_id}}">{{conv_nome}}</option>
									{{/each}}
								</select>
								&nbsp;&nbsp;&nbsp;&nbsp;
								<label class="control-label bolder red">
									<select name="exibeInativos" id="exibeInativos" class="select2" value=""  >
											<option value="nao">Não</option>
											<option value="sim">Sim</option>
									</select>
									<span class="lbl">&nbsp;Exibir Inativos?</span>
								</label>
								<button class="btn btn-info" name="acaoSalvar" id="acaoSalvar" type="submit">
									<i class="ace-icon fa fa-search bigger-110"></i>
									Pesquisar
								</button>
							</ul><!-- /.breadcrumb -->
						</div>
					</form>
				</div>
				<div class="row">
					<div class="col-xs-12">
						<!-- PAGE CONTENT BEGINS -->
						<div class="space-6"></div>
						<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Relatório Financeiro</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            line-height: 1.6;
        }
        h1, h2 {
            color: #333;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f4f4f4;
            color: #333;
        }
        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        tr:hover {
            background-color: #f1f1f1;
        }
        .summary {
            margin-top: 30px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <h1>Relatório Financeiro</h1>

    <!-- Período Selecionado -->
    <div>
        <strong>Período:</strong> De {{periodoDe}} até {{periodoAte}}
    </div>

    <!-- Convênio Selecionado -->
    <div>
        <strong>Convênio:</strong> {{conv_nome}}
    </div>

    <!-- Tabela de Terapias e Relatórios -->
    <h2>Relatório por Terapia</h2>
    <table>
        <thead>
            <tr>
                <th>Terapia</th>
                <th>Sessões</th>
                <th>Valor Unitário</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            {{#if rels.length}}
                {{#each rels}}
                    <tr>
                        <td>{{this.nomecid}}</td>
                        <td>{{this.sessoes}}</td>
                        <td>R$ {{this.valor}}</td>
                        <td>R$ {{this.total}}</td>
                    </tr>
                {{/each}}
            {{else}}
                <tr>
                    <td colspan="4">Nenhum dado disponível</td>
                </tr>
            {{/if}}
        </tbody>
    </table>

    <!-- Totais Gerais -->
    <div class="summary">
        <h3>Totais Gerais</h3>
        <p><strong>Total de Sessões:</strong> {{total.sessoes}}</p>
        <p><strong>Valor Total:</strong> R$ {{total.valor}}</p>
    </div>
</body>
</html>




				</div>
			</div><!-- /.main-content -->


		</div><!-- /.main-container -->





