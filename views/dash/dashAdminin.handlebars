		<script>
			function initEasySparkline() {
				console.log("Iniciando Sparkline");

				if (typeof $.fn.sparkline !== "function") {
					console.error("Biblioteca Sparkline não carregada.");
					return;
				}

				const fixedColors = [
					'#FF0000', // Vermelho
					'#00FF00', // Verde
					'#0000FF', // Azul
					'#FFFF00', // Amarelo
					'#FFA500', // Laranja
					'#800080', // Roxo
					'#00FFFF'  // Ciano
				];

				$('.sparkline').each(function () {
					const $this = $(this);
					const values = $this.data('values');

					if (!values) {
						console.error("Atributo data-values não definido ou vazio:", $this);
						return;
					}

					try {
						$this.sparkline('html', {
							tagValuesAttribute: 'data-values',
							type: 'bar',
							barWidth: 8,
							height: '30px',
							chartRangeMin: 0,
							colorMap: fixedColors.slice(0, values.split(',').length), // Seleciona cores com base na quantidade de barras
							barColor: null // Evita sobrescrever o colorMap com uma cor única
						});
						console.log("Sparkline desenhado com cores fixas no elemento:", $this);
					} catch (error) {
						console.error("Erro ao desenhar Sparkline:", error);
					}
				});
			}
		</script>
		<script>
			function initBargraf() {
				console.log("Iniciando gráfico de barras...");
				
				const ctx = document.getElementById('stackedBarChart-Simples').getContext('2d');
				
				if (!ctx) {
					console.error('Não foi possível encontrar o elemento canvas.');
					return;
				}

				// Dados do gráfico
				const data = {
					labels: ['Tipos de Faturamentos'],
					datasets: [
						{
							label: 'Credenciados',
							backgroundColor: 'rgba(0, 255, 0, 0.5)', // verde limão
							data: [2000.00]
						},
						{
							label: 'Particular',
							backgroundColor: 'rgba(255, 255, 0, 0.5)', // amarelo
							data: [500.00]
						},
						{
							label: 'Liminar',
							backgroundColor: 'rgba(255, 99, 132, 0.5)', // cor padrão
							data: [1000.00]
						}
						
					]
				};

				// Opções do gráfico
				const options = {
					responsive: true,
					scales: {
						x: { stacked: true },
						y: { stacked: true, min: 0, max: 3500 }
					}
				};

				// Criar o gráfico
				new Chart(ctx, {
					type: 'bar',
					data: data,
					options: options
				});

				console.log("Gráfico de barras renderizado com sucesso!");
			}
   		</script>
		<script>
			function initBargrafconv() {
				console.log("Iniciando gráfico de barras...");

				const ctx = document.getElementById('stackedBarChart-comprido').getContext('2d');

				if (!ctx) {
					console.error('Não foi possível encontrar o elemento canvas.');
					return;
				}

				// Dados do gráfico com categorias separadas
				const data = {
					labels: ['Bradesco', 'Particular', 'Amil','Bradesco', 'Particular', 'Amil'],
					datasets: [
						{
							label: 'Faturamento',
							backgroundColor: ['rgba(0, 255, 0, 0.5)', 'rgba(255, 255, 0, 0.5)', 'rgba(255, 99, 132, 0.5)'],
							data: [2000.00, 500.00, 1000.00]
						}
					]
				};

				// Opções do gráfico
				const options = {
					responsive: true,
					scales: {
						y: { beginAtZero: true },
						x: { beginAtZero: true }
					}
				};

				// Criar o gráfico de barras separadas
				new Chart(ctx, {
					type: 'bar',
						data: data,
						options: options
					});

					console.log("Gráfico de barras renderizado com sucesso!");
				}
		</script>
		<script>
		function renderMeuGraficoDeBarras() {
		console.log("Iniciando gráfico de barras com ApexCharts...");

		// Meses do ano para o eixo X
		const meses = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];

		// Valores para cada categoria por mês (exemplo inicial)
		const valoresParticular = [500, 600, 700, 800, 900, 1000, 1100, 1200, 1300, 1400, 1500, 1600];
		const valoresLiminar = [400, 450, 500, 550, 600, 650, 700, 750, 800, 850, 900, 950];
		const valoresConvenio = [300, 350, 400, 450, 500, 550, 600, 650, 700, 750, 800, 850];

		// Configurações do gráfico
		const options = {
			series: [
				{
					name: 'Particular',
					data: valoresParticular,
					color: '#00FF0080' // Verde
				},
				{
					name: 'Liminar',
					data: valoresLiminar,
					color: '#FF638480' // Azul
					
				},
				{
					name: 'Convênio',
					data: valoresConvenio,
					color: '#0000FF80' // azul
					
				}
			],
			chart: {
				type: 'bar',
				height: 350,
				stacked: true, // Barras agrupadas
				toolbar: {
					show: true // Mostrar ferramentas de interação
				}
			},
			plotOptions: {
				bar: {
					horizontal: false,
					columnWidth: '70%', // Largura das colunas
					endingShape: 'rounded' // Bordas arredondadas
				}
			},
			dataLabels: {
				enabled: false // Desabilitar rótulos de dados
			},
			xaxis: {
				categories: meses,
				title: {
					text: 'Meses'
				}
			},
			yaxis: {
				title: {
					text: 'Valores'
				}
			},
			legend: {
				position: 'top', // Posição da legenda
				horizontalAlign: 'center'
			},
			fill: {
				opacity: 1 // Opacidade das barras
			}
		};

		// Renderizar o gráfico
		const chart = new ApexCharts(document.querySelector("#meuGraficoDeBarras"), options);
		chart.render();

		console.log("Gráfico de barras renderizado com sucesso!");
		}
		</script>

		<script>
			// Chama a função para inicializar o gráfico
			function graficobarrasconv() {
				// Dados do gráfico
				const dados = {
					nomes: ["Convênio A", "Convênio B", "Convênio C", "Convênio D", "Convênio E"], // Nomes (eixo Y)
