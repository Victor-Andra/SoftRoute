    <style>
        /* Tooltip personalizado */
        .custom-tooltip {
            position: relative;
            display: inline-block;
            cursor: pointer;
        }
        .tooltip-text {
            visibility: hidden;
            width: max-content;
            background-color: #f3dfdf;
            color: red;
            font-size: 10px;
            text-align: left;
            border-radius: 4px;
            padding: 8px 12px;
            position: absolute;
            z-index: 9999;
            bottom: 125%;
            left: 50%;
            transform: translateX(-50%);
            opacity: 0.95;
            min-width: 150px;
            max-width: 260px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }
        .tooltip-text::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 50%;
            margin-left: -5px;
            border-width: 5px;
            border-style: solid;
            border-color: #f3dfdf transparent transparent transparent;
        }
        .custom-tooltip:hover .tooltip-text {
            visibility: visible;
        }
    </style>
