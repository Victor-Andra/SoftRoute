<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Funcionalidade dos Usuários</title>
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">


			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Funcionalidade dos Usuários</a>
							</li>

							<li class="active">Cadastro</li>
						</ul><!-- /.breadcrumb -->

					</div>

					<div class="row">
						<div class="col-xs-12">
							<!-- PAGE CONTENT BEGINS -->
							<form class="form-horizontal" role="form"  action="/menu/ferramentas/usufunc/add" method="POST">
								<div class="form-horizontal" role="form">
									<div class="col-sm-12"><!-- Widget Dados Básicos -->
										<div class="widget-box">
											<div class="widget-header">
												<h4 class="widget-title">Funcionalidade dos Usuários</h4>

												<span class="widget-toolbar">

													<a href="#" data-action="reload">
														<i class="ace-icon fa fa-refresh"></i>
													</a>

													<a href="#" data-action="collapse">
														<i class="ace-icon fa fa-chevron-up"></i>
													</a>

												</span>
											</div>
											<div class="widget-body">
												<div class="widget-main">

													<label> Código da Funcionalidade</label>
													<div class="form-group">
														<div class="col-sm-6">
															<input type="text" name="usufuncCodigo" id="usufuncCodigo" class="form-control" />
														</div>
													</div>
													<div class="space space-8"></div>
													<label> Nome da Funcionalidade</label>
													<div class="form-group">
														<div class="col-sm-6">
															<input type="text" name="usufuncNome" id="usufuncNome" class="form-control" />
														</div>
													</div>
													<div class="space space-8"></div>
													<label> Descrição da Funcionalidade</label>
													<div class="form-group">
														<div class="col-sm-6">
															<input type="text" name="usufuncDescricao" id="usufuncDescricao" class="form-control" />
														</div>
													</div>
													<label>Status</label>
													<div class="form-group">
														<div class="col-sm-4">
															<select name="usufuncStatus" id="usufuncStatus" class="chosen-select">
																<option value="">Selecione o status</option>
																<option value="Ativo">Ativo</option>
																<option value="Inativo">Inativo</option>
															</select>
														</div>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
								<div class="space-4"></div>							
								<div class="space-4"></div>

								<div class="form-actions">
									<div class="col-md-offset-3 col-md-9">
										<button class="btn btn-info"  name="acao" type="submit">
											<i class="ace-icon fa fa-check bigger-110"></i>
											Salvar
										</button>

										&nbsp; &nbsp; &nbsp;
										<button class="btn btn-warning"  type="reset">
											<i class="ace-icon fa fa-undo bigger-110"></i>
											Voltar
										</button>
									</div>
								</div>
							</form>

							
						</div><!-- /.col -->
					</div><!-- /.row -->




				</div>
			</div><!-- /.main-content -->


		</div><!-- /.main-container -->





		<!-- basic scripts -->
		<script>
			$(document).ready(function() {
			// Inicializa APENAS o select de status
			$('#usufuncStatus').select2({
				placeholder: "Selecione o status",
				allowClear: false,  // mantém sempre uma opção selecionada (como nativo)
				width: '100%'       // responsivo dentro do col-sm-4
			});
			});
		</script>
	</body>
</html>
