<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista de Funcionalidade dos Usuários</title>
		 <style>
        /*Tooltip personalizado */
            .custom-tooltip {
                position: relative;
                display: inline-block;
                cursor: pointer;
            }

            .tooltip-text {
                visibility: hidden;
                width: max-content;
                background-color: #f3dfdf;
                color: red;
                font-size: 8px;
                text-align: left;
                border-radius: 4px;
                padding: 8px 12px;
                position: absolute;
                z-index: 9999;
                bottom: 125%; /* Acima do ícone */
                left: 50%;
                transform: translateX(-50%);
                opacity: 0.9;
                white-space: normal;
                min-width: 150px;
                max-width: 300px;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
                transition: opacity 0.3s;
            }

            .tooltip-text::after {
                content: "";
                position: absolute;
                top: 100%;
                left: 50%;
                margin-left: -5px;
                border-width: 5px;
                border-style: solid;
                border-color: #f3dfdf transparent transparent transparent;
            }

            /* Mostra o tooltip quando o mouse passa sobre o link */
            .custom-tooltip:hover .tooltip-text {
                visibility: visible;
            }
    </style>
		
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Funcionalidade dos Usuários</li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<div class="row">
									<div class="col-xs-12">
											<div class="clearfix" >
												<div class="pull-right tableTools-container">


												</div>
											</div>

											<div id="dynamic-table_wrapper" class="dataTables_wrapper form-inline no-footer">
											</div>
											
											<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
												
												<thead>
													<tr role="row">
														<th class="center">
															<label class="pos-rel">
																<input type="checkbox" class="ace" />
																<span class="lbl"></span>
															</label>
														</th>
														<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1">Código</th>
														<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1">Nome</th>
														<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1">Descrição</th>
														<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1">Ìcone</th>
														<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1">Cor</th>
														<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1">Ordem</th>
														<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1">Rota</th>
														<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1">Status</th>
														<th>Ação
															<a class="blue" href="/menu/ferramentas/usufunc/cad">
																<i class="ace-icon fa fa-plus bigger-130"></i>
															</a>
														</th>

													</tr>
													
												</thead>
												
												<tbody>
													{{#each usufuncs}}
														<tr>
															<th class="center">
																<label class="pos-rel">
																	<input type="checkbox" class="ace" />
																	<span class="lbl"></span>
																</label>
															</th>
															<td>{{usufunc_codigo}}</td>
															<td>{{usufunc_nome}}</td>
															<td>{{usufunc_descricao}}</td>
															<td>{{usufunc_icone}}</td>
															<td>{{usufunc_cor}}</td>
															<td>{{usufunc_ordem}}</td>
															<td>{{usufunc_rota}}</td>
															<td>
																{{#ifEqual this.usufunc_status "Inativo"}}
																	<span class="label label-sm label-danger">{{usufunc_status}}</span>
																	{{else}}
																	<span class="label label-sm label-success">{{usufunc_status}}</span>
																{{/ifEqual}}
															</td>
															<td>
																<div class="action-buttons">
																	<a class="green" href="/menu/ferramentas/usufunc/edi/{{_id}}">
																		<i class="ace-icon fa fa-pencil bigger-130"></i>
																	</a>
																	<a class="hidden" class="red" href="/menu/ferramentas/usufunc/del/{{_id}}">
																		<i class="ace-icon fa fa-trash-o bigger-130"></i>
																	</a>
																	<a class="blue custom-tooltip" name="acaoVerquemalterou" id="acaoVerquemalterou">
																		<i class="ace-icon fa fa-eye bigger-130"></i>
																		<span class="tooltip-text">{{funcionalidade_dataedi}}<br>
																		
																			{{#each usuarios}}
																				{{#ifEqual this._id ../funcionalidade_usuidedi}}
																					<td>{{usuario_nome}}</td>
																				{{/ifEqual}}
																			{{/each}}
																		
																		</span>
																	</a>
																</div>
																
															</td>
														</tr>
													{{/each}}
												</tbody>

											</table>


										
										
										
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

		
		</div><!-- /.main-container ace-save-state -->

		
		<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		

		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
			"language": {
            "url": "/js/lang/datatable-pt-br.json" // Substitua pelo caminho correto
        },
			"aaSorting": [],
			"aoColumns": [{ "bSortable": false }, null, null, null, null, null, null, null,null,{ "bSortable": false }],
			"responsive": true,
			"lengthMenu": [ 200, 300, 500],
			"lengthChange": true,
			"autoWidth": true,
			"paging": true,
			"lengthChange": true,
			"searching": true,
			"ordering": true,
			"info": true,
			
			select: {
						style: 'multi'
					}
			});
		});
		$.fn.dataTable.Buttons.defaults.dom.container.className = 'dt-buttons btn-overlap btn-group btn-overlap';
		</script>
	
	

	</body>

</html>