<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
	<meta charset="utf-8">
	<title>Lista de Manuais</title>

	<style>
		/* Tooltip personalizado */
		.custom-tooltip {
			position: relative;
			display: inline-block;
			cursor: pointer;
		}
		.tooltip-text {
			visibility: hidden;
			width: max-content;
			background-color: #f3dfdf;
			color: red;
			font-size: 10px;
			text-align: left;
			border-radius: 4px;
			padding: 8px 12px;
			position: absolute;
			z-index: 9999;
			bottom: 125%;
			left: 50%;
			transform: translateX(-50%);
			opacity: 0.95;
			min-width: 150px;
			max-width: 260px;
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
		}
		.tooltip-text::after {
			content: "";
			position: absolute;
			top: 100%;
			left: 50%;
			margin-left: -5px;
			border-width: 5px;
			border-style: solid;
			border-color: #f3dfdf transparent transparent transparent;
		}
		.custom-tooltip:hover .tooltip-text {
			visibility: visible;
		}
	</style>

</head>

<body onload="javascript:controlaNave();" class="no-skin">

	<div class="main-container ace-save-state" id="main-container">
		<div class="main-content">
			<div class="main-content-inner">

				<div class="breadcrumbs" id="breadcrumbs">
					<ul class="breadcrumb">
						<li><i class="ace-icon fa fa-home home-icon"></i>
							<a href="/">Home</a>
						</li>
						<li class="active">Lista de Manuais</li>
					</ul>
				</div>

				{{#each error}}
					<div class="alert alert-danger">{{this}}</div>
				{{/each}}

				<div class="page-content">
					<div class="row">
						<div class="col-xs-12">

							<div class="row">
								<div class="col-xs-12">
									

									<table id="dynamic-table" class="table table-striped table-bordered table-hover">
										<thead>
											<tr>
												<th class="center">
													<label class="pos-rel">
														<input type="checkbox" class="ace"/>
														<span class="lbl"></span>
													</label>
												</th>
												<th>Nome</th>
												<th>Título</th>
												<th>Versão</th>
												<th>Data Versão</th>
												<th>Ações&nbsp;&nbsp;
                                                   
                                                        <a class="green" title="Adicionar Novo" href="/menu/ferramentas/manual/form">
                                                            <i class="ace-icon fa fa-plus bigger-130"></i>
                                                        </a>
                                                  
                                                </th>
											</tr>
										</thead>

										<tbody>
											{{#each manuals}}

												<tr>
													<td class="center">
														<label class="pos-rel">
															<input type="checkbox" class="ace"/>
															<span class="lbl"></span>
														</label>
													</td>

													<td>{{man_nome}}</td>
													<td>{{man_titulo}}</td>
													<td>{{man_versao}}</td>

													<td>
														{{dataversao}}
													</td>

													<td>
														<div class="action-buttons">

															<!-- EDITAR -->
															<a class="green"
                                                                href="/menu/ferramentas/manual/form/{{_id}}"
                                                                title="Editar">
                                                                <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                            </a>


															<!-- EXCLUIR -->
															<a class="red" 
															   href="/menu/ferramentas/manual/del/{{_id}}" 
															   onclick="return confirm('Tem certeza que deseja excluir este manual?')"
															   title="Excluir">
																<i class="ace-icon fa fa-trash-o bigger-130"></i>
															</a>

															<!-- DETALHES - TOOLTIP -->
															<a class="purple custom-tooltip">
																<i class="ace-icon fa fa-eye bigger-130"></i>
																<span class="tooltip-text">

																	<strong>Última Edição:</strong>
																	{{#if dataedi}}
																		<p><b>{{dataedi}}</b></p>
																	{{else}}
																		<p>--/--/----</p>
																	{{/if}}
																	<p>Por: {{usuarioEdiNome}}</p>

																	<strong>Cadastrado em:</strong>
																	{{#if datacad}}
																		<p><b>{{datacad}}</b></p>
																	{{else}}
																		<p>--/--/----</p>
																	{{/if}}
																	<p>Por: {{usuarioCadNome}}</p>

																</span>
															</a>

														</div>
													</td>

												</tr>

											{{/each}}
										</tbody>

									</table>
								</div>
							</div>

						</div>
					</div>
				</div>

			</div>
		</div>

		<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse display">
			<i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
		</a>
	</div>

	<script src="/js/jquery.dataTables.js"></script>

	<script>
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
				language: { url: "/js/lang/datatable-pt-br.json" },
				aaSorting: [],
				aoColumns: [
					{ bSortable: false },
					null, null, null, null,
					{ bSortable: false }
				],
				responsive: true,
				lengthMenu: [ 100, 200]
			});
		});
	</script>

</body>
</html>
