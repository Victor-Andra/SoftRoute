<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta charset="utf-8">
    <title>Lista de Manuais</title>
    <style>
        /* Tooltip personalizado */
        .custom-tooltip {
            position: relative;
            display: inline-block;
            cursor: pointer;
        }
        .tooltip-text {
            visibility: hidden;
            width: max-content;
            background-color: #f3dfdf;
            color: red;
            font-size: 12px;
            text-align: left;
            border-radius: 4px;
            padding: 8px 12px;
            position: absolute;
            z-index: 9999;
            bottom: 125%;
            left: 50%;
            transform: translateX(-50%);
            opacity: 0.9;
            white-space: normal;
            min-width: 180px;
            max-width: 300px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            transition: opacity 0.3s;
        }
        .tooltip-text::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 50%;
            margin-left: -5px;
            border-width: 5px;
            border-style: solid;
            border-color: #f3dfdf transparent transparent transparent;
        }
        .custom-tooltip:hover .tooltip-text {
            visibility: visible;
        }
    </style>
</head>

<body onload="javascript:controlaNave();" class="no-skin">
    <div class="main-container ace-save-state" id="main-container">
        <div class="main-content">
            <div class="main-content-inner">
                <div class="breadcrumbs ace-save-state" id="breadcrumbs">
                    <ul class="breadcrumb">
                        <li><i class="ace-icon fa fa-home home-icon"></i><a href="/">Home</a></li>
                        <li class="active">Lista de Manuais</li>
                    </ul>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger"><%= error %></div>
                <% } %>

                <div class="page-content">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="clearfix">
                                <div class="pull-right tableTools-container">
                                    <!-- Botão de novo manual -->
                                    <a class="btn btn-white btn-info btn-bold" href="/ferramentas/manual/form">
                                        <i class="ace-icon fa fa-plus"></i> Novo Manual
                                    </a>
                                </div>
                            </div>

                            <table id="dynamic-table" class="table table-striped table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th class="center">
                                            <label class="pos-rel">
                                                <input type="checkbox" class="ace" />
                                                <span class="lbl"></span>
                                            </label>
                                        </th>
                                        <th>Nome</th>
                                        <th>Título</th>
                                        <th>Versão</th>
                                        <th>Data Versão</th>
                                        <th>Ação</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (manuals && manuals.length > 0) { %>
                                        <% manuals.forEach(function(manual) { %>
                                            <tr>
                                                <td class="center">
                                                    <label class="pos-rel">
                                                        <input type="checkbox" class="ace" />
                                                        <span class="lbl"></span>
                                                    </label>
                                                </td>
                                                <td><%= manual.man_nome || '--' %></td>
                                                <td><%= manual.man_titulo || '--' %></td>
                                                <td><%= manual.man_versao || '--' %></td>
                                                <td>
                                                    <% if (manual.man_versao) { %>
                                                        <%= (new Date(manual.man_versao)).toLocaleDateString('pt-BR') %>
                                                    <% } else { %>
                                                        --
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <div class="action-buttons">
                                                       <!-- Editar -->
														<a class="green" href="/ferramentas/manual/form/<%= manual._id %>" title="Editar">
															<i class="ace-icon fa fa-pencil bigger-130"></i>
														</a>

														<!-- Excluir -->
														<a class="red" href="/ferramentas/manual/del/<%= manual._id %>" 
														onclick="return confirm('Tem certeza que deseja excluir este manual?')" 
														title="Excluir">
															<i class="ace-icon fa fa-trash-o bigger-130"></i>
														</a>

                                                        <!-- Tooltip com detalhes -->
                                                        <a class="purple custom-tooltip" title="Detalhes">
                                                            <i class="ace-icon fa fa-eye bigger-130"></i>
                                                            <span class="tooltip-text">
                                                                <strong>Última Edição:</strong>
                                                                <p><b><%= manual.dataedi %></b></p>
                                                                <p>Por: <%= manual.usuarioEdiNome %></p>

                                                                <strong>Cadastrado em:</strong>
                                                                <p><b><%= manual.datacad %></b></p>
                                                                <p>Por: <%= manual.usuarioCadNome %></p>
                                                            </span>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center">Nenhum manual encontrado.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer">
            <div class="footer-inner">
                <div class="footer-content">
                    <span class="bigger-120"><span class="blue bolder">Soft</span>Route</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/assets/js/jquery.min.js"></script>
    <script src="/assets/js/bootstrap.min.js"></script>
    <script src="/js/jquery.dataTables.js"></script>

    <script>
        $(document).ready(function() {
            $("#dynamic-table").DataTable({
                "language": {
                    "url": "/js/lang/datatable-pt-br.json"
                },
                "aaSorting": [],
                "aoColumns": [
                    { "bSortable": false },
                    null,
                    null,
                    null,
                    null,
                    { "bSortable": false }
                ],
                "responsive": true,
                "lengthMenu": [25, 50, 100],
                "paging": true,
                "searching": true,
                "info": true
            });
        });
    </script>
</body>
</html>