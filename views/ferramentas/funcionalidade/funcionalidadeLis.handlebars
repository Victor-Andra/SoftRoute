<!DOCTYPE html>
<html lang="pt-br"><head>
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
	<meta charset="utf-8">
	<title>Lista de Funcionalidades de Uso do sistema</title>
	<style>
			/* Tooltip personalizado */
			.custom-tooltip .tooltip-text {
				visibility: hidden; /* Inicialmente oculto */
				width: auto; /* Ajusta automaticamente ao conteúdo */
				background-color: rgb(243, 223, 223); /* Fundo escuro para contraste */
				color: red; /* Cor do texto vermelha */
				font-size: 6px; /* Tamanho da fonte pequena */
				text-align: center;
				padding: 2px 5px; /* Espaçamento interno */
				border-radius: 4px; /* Borda arredondada */

				/* Posicionamento do tooltip */
				position: absolute;
				top: -20px; /* Acima do ícone */
				left: 50%; /* Centralizado horizontalmente */
				transform: translateX(-50%); /* Ajuste fino para centralizar */
				z-index: 1; /* Garante que o tooltip fique acima de outros elementos */
				white-space: nowrap; /* Evita que o texto quebre linha */
			}

			/* Mostra o tooltip quando o mouse passa sobre o link */
			.custom-tooltip:hover .tooltip-text {
				visibility: visible;
			}
		</style>
		
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Lista de Funcionalidades de Uso do Sistema</li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<div class="row">
									<div class="col-xs-12">
											<div class="clearfix" >
												<div class="pull-right tableTools-container">


												</div>
											</div>

											<div id="dynamic-table_wrapper" class="dataTables_wrapper form-inline no-footer">
											</div>
											
											<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
												
												<thead>
													<tr role="row">
														<th class="center">
															<label class="pos-rel">
																<input type="checkbox" class="ace" />
																<span class="lbl"></span>
															</label>
														</th>
														<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1" >Código</th>
														<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1" >Funcionalidade</th>
														<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1" >Informação</th>
														<th>Ação
															<a href="/menu/ferramentas/funcionalidade/cad">
																<i class="menu-icon fa fa-plus purple"></i>
															</a>
														</th>

													</tr>funcionalidade
													
												</thead>
												
												<tbody>
													{{#each funcionalidades}}
														<tr>
															<th class="center">
																<label class="pos-rel">
																	<input type="checkbox" class="ace" />
																	<span class="lbl"></span>
																</label>
															</th>
															<td>{{funcionalidade_codigo}}</td>
															<td>{{funcionalidade_nome}}</td>
															<td>{{funcionalidade_descricao}}</td>
															<td>
																<div class="action-buttons">
																	<a class="green" href="/menu/ferramentas/funcionalidade/edi/{{_id}}">
																		<i class="ace-icon fa fa-pencil bigger-130"></i>
																	</a>
																	<a class="red" class="red" href="/menu/ferramentas/funcionalidade/del/{{_id}}">
																		<i class="ace-icon fa fa-trash-o bigger-130"></i>
																	</a>
																	<a class="blue custom-tooltip" name="acaoVerquemalterou" id="acaoVerquemalterou">
																		<i class="ace-icon fa fa-eye bigger-130"></i>
																		<span class="tooltip-text">{{funcionalidade_dataedi}}<br>
																		
																			{{#each usuarios}}
																				{{#ifEqual this._id ../funcionalidade_usuidedi}}
																					<td>{{usuario_nome}}</td>
																				{{/ifEqual}}
																			{{/each}}
																		
																		</span>
																	</a>
																</div>
															
															</td>
														</tr>
													{{/each}}
												</tbody>

											</table>


										
										
										
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

			<div class="footer">
				<div class="footer-inner">
					<div class="footer-content">
						<span class="bigger-120">
							<span class="blue bolder">Soft</span>
							Route
						</span>

						&nbsp; &nbsp;
						<span class="action-buttons">
							<a href="#">
								<i class="ace-icon fa fa-twitter-square light-blue bigger-150"></i>
							</a>

							<a href="#">
								<i class="ace-icon fa fa-facebook-square text-primary bigger-150"></i>
							</a>

		
						</span>
					</div>
				</div>
			</div>

			<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse display">
				<i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
			</a>
		</div><!-- /.main-container ace-save-state -->

		
		<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		

		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
			"language": {
            "url": "/js/lang/datatable-pt-br.json" // Substitua pelo caminho correto
        },
			"aaSorting": [],
			
			"responsive": true,
			"lengthMenu": [ 100, 200],
			"lengthChange": true,
			"autoWidth": true,
			"paging": true,
			"lengthChange": true,
			"searching": true,
			"ordering": true,
			"info": true,
			
			select: {
						style: 'multi'
					}
			});
		});
		$.fn.dataTable.Buttons.defaults.dom.container.className = 'dt-buttons btn-overlap btn-group btn-overlap';
		</script>
	
	

	</body>

</html>