<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Permissões dos Usuários</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body onload="javascript:controlaNave();" class="no-skin">

<div class="main-container ace-save-state" id="main-container">

    <div class="main-content">
        <div class="main-content-inner">
            <div class="breadcrumbs ace-save-state" id="breadcrumbs">
                <ul class="breadcrumb">
                    <li>
                        <i class="ace-icon fa fa-home home-icon"></i>
                        <a href="#">Gestão de Permissões</a>
                    </li>
                    <li class="active">Cadastro</li>
                </ul>
            </div>

            <div class="row">
                <div class="col-xs-12">
                    <!-- PAGE CONTENT BEGINS -->
                    <!-- views/ferramentas/usupermis/usupermisCad.handlebars -->

<div class="breadcrumbs ace-save-state">
    <ul class="breadcrumb">
        <li>
            <i class="ace-icon fa fa-home home-icon"></i>
            <a href="/menu">Início</a>
        </li>
        <li>
            <a href="/menu/ferramentas/usupermis/lis">Permissões</a>
        </li>
        <li class="active">Cadastro Individual</li>
    </ul>
</div>

<div class="page-header">
    <h1>
        <i class="ace-icon fa fa-lock blue"></i>
        Cadastro de Permissão
        <small>
            <i class="ace-icon fa fa-angle-double-right"></i>
            Associe uma funcionalidade a um usuário
        </small>
    </h1>
</div>

<div class="row">
    <div class="col-xs-12">
        <form action="/menu/ferramentas/usupermis/add" method="POST" class="form-horizontal" role="form">

            <!-- Widget: Dados da Permissão -->
            <div class="widget-box">
                <div class="widget-header">
                    <h4 class="widget-title">Informações da Permissão</h4>
                    <div class="widget-toolbar">
                        <a href="#" data-action="collapse">
                            <i class="ace-icon fa fa-chevron-up"></i>
                        </a>
                    </div>
                </div>

                <div class="widget-body">
                    <div class="widget-main">

                        <!-- Empresa -->
                        <div class="form-group">
                            <label class="col-sm-3 control-label no-padding-right" for="usupermisEmpresaid">
                                Empresa
                            </label>
                            <div class="col-sm-9">
                                <select name="usupermisEmpresaid" id="usupermisEmpresaid" 
                                        class="chosen-select form-control" required>
                                    <option value="">Selecione a Empresa</option>
                                    {{#each empresas}}
                                        <option value="{{_id}}">{{empresa_nome}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>

                        <div class="space-6"></div>

                        <!-- Usuário -->
                        <div class="form-group">
                            <label class="col-sm-3 control-label no-padding-right" for="usupermisUsuid">
                                Usuário
                            </label>
                            <div class="col-sm-9">
                                <select name="usupermisUsuid" id="usupermisUsuid" 
                                        class="chosen-select form-control" required>
                                    <option value="">Selecione o Usuário</option>
                                    {{#each usuarios}}
                                        <option value="{{_id}}">{{usuario_nome}}</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>

                        <div class="space-6"></div>

                        <!-- Funcionalidade -->
                        <div class="form-group">
                            <label class="col-sm-3 control-label no-padding-right" for="usupermisCodfunc">
                                Funcionalidade
                            </label>
                            <div class="col-sm-9">
                                <select name="usupermisCodfunc" id="usupermisCodfunc" 
                                        class="chosen-select form-control" required>
                                    <option value="">Selecione a Funcionalidade</option>
                                    {{#each usufuncs}}
                                        <option value="{{_id}}">{{usufunc_nome}} ({{usufunc_codigo}})</option>
                                    {{/each}}
                                </select>
                            </div>
                        </div>

                        <div class="space-6"></div>

                        <!-- Tipo de Permissão -->
                        <div class="form-group">
                            <label class="col-sm-3 control-label no-padding-right" for="usupermisTipo">
                                Nível de Acesso
                            </label>
                            <div class="col-sm-9">
                                <select name="usupermisTipo" id="usupermisTipo" 
                                        class="chosen-select form-control" required>
                                    <option value="">Selecione o Nível</option>
                                    <option value="1">1 - Sem acesso</option>
                                    <option value="2">2 - Listar</option>
                                    <option value="3">3 - ver</option>
                                    <option value="4">4 - Criar</option>
                                    <option value="5">5 - Editar</option>
                                    <option value="6">6 - Total (Completo)</option>
                                </select>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Ações do Formulário -->
            <div class="clearfix form-actions">
                <div class="col-md-offset-3 col-md-9">
                    <button class="btn btn-info" type="submit">
                        <i class="ace-icon fa fa-check bigger-110"></i>
                        Salvar Permissão
                    </button>

                    &nbsp; &nbsp; &nbsp;

                    <a class="btn btn-warning" href="/menu/ferramentas/usupermis/lis">
                        <i class="ace-icon fa fa-undo bigger-110"></i>
                        Voltar
                    </a>
                </div>
            </div>

        </form>
    </div>
</div>


                </div>
            </div>
        </div>
    </div>
</div>


<script>
    // Inicializa os selects com chosen
    jQuery(function($) {
        $('.chosen-select').chosen({allow_single_deselect: true});
        $(window).off('resize.chosen').on('resize.chosen', function() {
            $('.chosen-select').each(function() {
                var $this = $(this);
                $this.next().css({'width': $this.parent().width()});
            });
        }).trigger('resize.chosen');
    });
</script>
</body>
</html>