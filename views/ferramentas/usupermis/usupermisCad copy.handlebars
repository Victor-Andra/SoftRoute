<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Gestão de Permissões em Massa</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body onload="javascript:controlaNave();" class="no-skin">

<div class="main-container ace-save-state" id="main-container">
    <div class="main-content">
        <div class="main-content-inner">
            <div class="breadcrumbs ace-save-state" id="breadcrumbs">
                <ul class="breadcrumb">
                    <li><i class="ace-icon fa fa-home home-icon"></i><a href="/menu">Home</a></li>
                    <li><a href="/menu/ferramentas/usupermis/lis">Permissões</a></li>
                    <li class="active">Em Massa</li>
                </ul>
            </div>

            <div class="row">
                <div class="col-xs-12">
                    <!-- Filtros -->
                    <div class="widget-box">
                        <div class="widget-header"><h4>Selecione Empresa e Usuário</h4></div>
                        <div class="widget-body">
                            <div class="widget-main">
                                <p>Selecione um usuário e empresa para configurar todas as funcionalidades de uma vez.</p>

                                <form class="form-horizontal" style="margin-bottom: 20px;">
                                    <div class="form-group">
                                        <label class="col-sm-2">Empresa</label>
                                        <div class="col-sm-4">
                                            <select id="select-empresa" class="chosen-select" required>
                                                <option value="">Selecione</option>
                                                {{#each empresas}}
                                                    <option value="{{_id}}">{{empresa_nome}}</option>
                                                {{/each}}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-2">Usuário</label>
                                        <div class="col-sm-4">
                                            <select id="select-usuario" class="chosen-select" required>
                                                <option value="">Selecione</option>
                                                {{#each usuarios}}
                                                    <option value="{{_id}}">{{usuario_nome}}</option>
                                                {{/each}}
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="col-sm-offset-2 col-sm-4">
                                            <button type="button" class="btn btn-primary" onclick="carregarPermissoes()">
                                                <i class="ace-icon fa fa-refresh"></i> Carregar Funcionalidades
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
					<!-- Barra de Ações Rápidas -->
					<div id="botoes-permissao" style="display: none; margin: 15px 0; padding: 10px; background: #f8f9fa; border-radius: 5px;">

						<strong style="margin-right: 10px;">Aplicar para selecionados:</strong>

						<button type="button" class="btn btn-xs" style="background: #ddd; color: #333;" onclick="aplicarPermissao('1')">1 - Sem acesso</button>
						
						<button type="button" class="btn btn-xs btn-info" onclick="aplicarPermissao('2')">2 - Listar</button>
						
						<button type="button" class="btn btn-xs btn-primary" onclick="aplicarPermissao('3')">3 - Ver</button>
						
						<button type="button" class="btn btn-xs btn-success" onclick="aplicarPermissao('4')">4 - Criar</button>
						
						<button type="button" class="btn btn-xs btn-warning" onclick="aplicarPermissao('5')">5 - Editar</button>
						
						<button type="button" class="btn btn-xs btn-danger" onclick="aplicarPermissao('6')">6 - Total</button>

					</div>
                    <!-- Tabela de Permissões (carregada dinamicamente) -->

                    <div id="container-tabela" style="display: none;">
                        <div class="widget-box">
                            <div class="widget-header">
                                <h4 id="titulo-usuario">Permissões para: </h4>
                            </div>
                            <div class="widget-body">
                                <div class="widget-main">
                                    <!-- Tabela com DataTable -->
									<table id="dynamic-table-permissoes" class="table table-striped table-bordered table-hover">
										<thead>
											<tr>
												<th class="center" style="width: 5%;">
													<label class="pos-rel">
														<input type="checkbox" class="ace" onclick="toggleAll(this)" />
														<span class="lbl"></span>
													</label>
												</th>
												<th class="sorting" style="width: 15%;">Código</th>
												<th class="sorting" style="width: 30%;">Nome</th>
												<th class="sorting" style="width: 50%;">Permissão</th>
											</tr>
										</thead>
										<tbody id="lista-funcionalidades">
											<!-- Preenchido dinamicamente -->
										</tbody>
									</table>

                                    <div class="form-actions center">
                                        <button class="btn btn-success" onclick="salvarPermissoes()">
                                            <i class="ace-icon fa fa-save"></i> Salvar Todas as Permissões
                                        </button>
                                        &nbsp;
                                        <a href="/menu/ferramentas/usupermis/lis" class="btn btn-warning">
                                            <i class="ace-icon fa fa-arrow-left"></i> Voltar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

									<script>
									// Armazena os dados das funcionalidades (com código, nome e _id)
									const funcionalidades = [
										{{#each usufuncs}}
										{ 
											_id: "{{_id}}", 
											nome: "{{usufunc_nome}}", 
											codigo: "{{usufunc_codigo}}" 
										}{{#unless @last}},{{/unless}}
										{{/each}}
									];

									let dataTable;

									// Função para carregar as permissões do usuário
									async function carregarPermissoes() {
										const empId = document.getElementById('select-empresa').value;
										const usuid = document.getElementById('select-usuario').value;

										if (!empId || !usuid) {
											alert("Selecione empresa e usuário.");
											return;
										}

										const usuarioNome = document.querySelector('#select-usuario option[value="' + usuid + '"]').text;
										document.getElementById('titulo-usuario').textContent = `Permissões para: ${usuarioNome}`;
										document.getElementById('container-tabela').style.display = 'block';

										// Buscar permissões existentes
										const res = await fetch(`/menu/ferramentas/usupermis/api/permissoes?usuid=${usuid}&empid=${empId}`);
										const permissoes = await res.json();

										// Destruir DataTable se já existir
										if (dataTable) {
											dataTable.destroy();
											document.getElementById('lista-funcionalidades').innerHTML = '';
										}

										// Preencher linhas
										const tbody = document.getElementById('lista-funcionalidades');
										funcionalidades.forEach(f => {
											const tipo = permissoes[f._id] || '1';

											const tr = document.createElement('tr');

											tr.innerHTML = `
												<td class="center">
													<label class="pos-rel">
														<input type="checkbox" class="ace perm-checkbox" data-funcid="${f._id}" />
														<span class="lbl"></span>
													</label>
												</td>
												<td>${f.codigo}</td>
												<td>${f.nome}</td>
												<td>
													<select name="perm[${f._id}]" class="form-control input-sm" style="width: 100%;">
														<option value="1" ${tipo === '1' ? 'selected' : ''}>1 - Sem acesso</option>
														<option value="2" ${tipo === '2' ? 'selected' : ''}>2 - Listar</option>
														<option value="3" ${tipo === '3' ? 'selected' : ''}>3 - Ver</option>
														<option value="4" ${tipo === '4' ? 'selected' : ''}>4 - Criar</option>
														<option value="5" ${tipo === '5' ? 'selected' : ''}>5 - Editar</option>
														<option value="6" ${tipo === '6' ? 'selected' : ''}>6 - Total</option>
													</select>
												</td>
											`;

											tbody.appendChild(tr);
										});

										// Inicializar DataTable
										dataTable = $('#dynamic-table-permissoes').DataTable({
											"language": {
												"url": "/js/lang/datatable-pt-br.json"
											},
											"aaSorting": [],
											"aoColumns": [
												{ "bSortable": false },
												null,
												null,
												{ "bSortable": false } // Permissão não ordenável
											],
											"responsive": true,
											"lengthMenu": [200, 500],
											"autoWidth": false,
											"paging": true,
											"searching": true,
											"ordering": true,
											"info": true,
											"drawCallback": function() {
												$('.chosen-select').chosen({ width: "100%" });
											}
										});

										// Reaplicar chosen após DataTable
										$('.chosen-select').chosen({ width: "100%" });
									}

									// Função para selecionar/deselecionar todos
									function toggleAll(checkbox) {
										const checkboxes = document.querySelectorAll('.perm-checkbox');
										checkboxes.forEach(cb => cb.checked = checkbox.checked);
									}

									// Salvar todas as permissões
									async function salvarPermissoes() {
										const empId = document.getElementById('select-empresa').value;
										const usuid = document.getElementById('select-usuario').value;

										const formData = new FormData();
										formData.append('usupermis_usuid', usuid);
										formData.append('usupermis_empresaid', empId);

										document.querySelectorAll('select[name^="perm"]').forEach(el => {
											const funcId = el.name.match(/\[(.*?)\]/)[1];
											formData.append(`permissoes[${funcId}]`, el.value);
										});

										const res = await fetch('/menu/ferramentas/usupermis/salvar-massa', {
											method: 'POST',
											body: new URLSearchParams(formData)
										});

										if (res.ok) {
											alert('Permissões salvas com sucesso!');
										} else {
											alert('Erro ao salvar permissões.');
										}
									}
									</script>
<script>
// Armazena os dados das funcionalidades (com código e nome)
const funcionalidades = [
    {{#each usufuncs}}
    { 
        _id: "{{_id}}", 
        nome: "{{usufunc_nome}}", 
        codigo: "{{usufunc_codigo}}" 
    }{{#unless @last}},{{/unless}}
    {{/each}}
];

// Função para carregar as permissões do usuário
async function carregarPermissoes() {
    const empId = document.getElementById('select-empresa').value;
    const usuid = document.getElementById('select-usuario').value;

    if (!empId || !usuid) {
        alert("Selecione empresa e usuário.");
        return;
    }

    const usuarioNome = document.querySelector('#select-usuario option[value="' + usuid + '"]').text;
    document.getElementById('titulo-usuario').textContent = `Permissões para: ${usuarioNome}`;
    document.getElementById('container-tabela').style.display = 'block';

    // Buscar permissões existentes
    const res = await fetch(`/menu/ferramentas/usupermis/api/permissoes?usuid=${usuid}&empid=${empId}`);
    const permissoes = await res.json();

    let html = '';
    funcionalidades.forEach(f => {
        const tipo = permissoes[f._id] || '1'; // Padrão: sem acesso

        html += `
        <tr>
            <td><strong>[${f.codigo}]</strong> ${f.nome}</td>
            <td>
                <select name="perm[${f._id}]" class="form-control input-sm">
                    <option value="1" ${tipo === '1' ? 'selected' : ''}>1 - Sem acesso</option>
                    <option value="2" ${tipo === '2' ? 'selected' : ''}>2 - Listar</option>
                    <option value="3" ${tipo === '3' ? 'selected' : ''}>3 - Ver</option>
                    <option value="4" ${tipo === '4' ? 'selected' : ''}>4 - Criar</option>
                    <option value="5" ${tipo === '5' ? 'selected' : ''}>5 - Editar</option>
                    <option value="6" ${tipo === '6' ? 'selected' : ''}>6 - Total</option>
                </select>
            </td>
        </tr>`;
    });

    document.getElementById('lista-funcionalidades').innerHTML = html;
}

// Salvar todas as permissões
async function salvarPermissoes() {
    const empId = document.getElementById('select-empresa').value;
    const usuid = document.getElementById('select-usuario').value;

    const formData = new FormData();
    formData.append('usupermis_usuid', usuid);
    formData.append('usupermis_empresaid', empId);

    document.querySelectorAll('select[name^="perm"]').forEach(el => {
        const funcId = el.name.match(/\[(.*?)\]/)[1];
        formData.append(`permissoes[${funcId}]`, el.value);
    });

    const res = await fetch('/menu/ferramentas/usupermis/salvar-massa', {
        method: 'POST',
        body: new URLSearchParams(formData)
    });

    if (res.ok) {
        alert('Permissões salvas com sucesso!');
    } else {
        const text = await res.text();
        console.error('Erro:', text);
        alert('Erro ao salvar permissões.');
    }
}
</script>

<!-- Inicializa chosen -->
<script>
jQuery(function($) {
    $('.chosen-select').chosen({allow_single_deselect: true});
    $(window).off('resize.chosen').on('resize.chosen', function() {
        $('.chosen-select').each(function() {
            var $this = $(this);
            $this.next().css({'width': $this.parent().width()});
        });
    }).trigger('resize.chosen');
});
</script>

</body>
</html>