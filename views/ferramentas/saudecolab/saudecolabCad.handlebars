<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Ficha Médica</title>
		<script>
			function aceitaTermo() {
				let aceita = document.getElementById("saudecolabAceitartermos").value;
				console.log(aceita);

				if (aceita === "-") {
					document.getElementById('btnSalvar').style.display = 'none';
				} else if (aceita === "Não") {
					document.getElementById('btnSalvar').style.display = 'none';
				}else{
					document.getElementById('btnSalvar').style.display = 'block';
				}
			}
		</script>
	</head>

	<body onload="javascript:controlaNave();aceitaTermo();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">


			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Ficha Médica</a>
							</li>

							<li class="active">Cadastro</li>
						</ul><!-- /.breadcrumb -->

					</div>

					<div class="row">
						<div class="col-xs-12">
							<!-- PAGE CONTENT BEGINS -->
							<form class="form-horizontal" role="form"  action="/menu/ferramentas/saudecolab/add" method="POST">
								<div class="form-horizontal" role="form">
									<div class="col-sm-12"><!-- Widget Dados Básicos -->
										<div class="widget-box">
											<div class="widget-header">
												<h4 class="widget-title">Ficha Médica</h4>

												<span class="widget-toolbar">

													<a href="#" data-action="reload">
														<i class="ace-icon fa fa-refresh"></i>
													</a>

													<a href="#" data-action="collapse">
														<i class="ace-icon fa fa-chevron-up"></i>
													</a>

												</span>
											</div>
											<div class="widget-body">
												<div class="widget-main">
																								
													<label>Nome completo:</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-6">
															<select name="saudecolabSaudecolabusuid" id="saudecolabSaudecolabusuid" class="select2" onchange="">
																<option value="766f69643132333435366964">-</option>
																{{#each usuarios}}
																	<option value="{{_id}}">{{usuario_nome}}</option>
																{{/each}}
															</select>
														</div>
													</div>

													

													<label>Tipo Sanguíneo:</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-3">
															<select name="saudecolabTiposangue" id="saudecolabTiposangue" class="select2" onchange="">
																<option value="-">-</option>
																<option value="A+">A+</option>
																<option value="A-">A-</option>
																<option value="B+">B+</option>
																<option value="B-">B-</option>
																<option value="AB+">AB+</option>
																<option value="AB-">AB-</option>
																<option value="O+">O+</option>
																<option value="O-">O-</option>
																
															</select>
														</div>
													</div>

													<label>Possui plano de saúde?</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabPlanosaude" id="saudecolabPlanosaude" class="select2">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Se sim, qual plano de saúde você possui?</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-6">
															<input type="text" name="saudecolabPlanosaudequal" id="saudecolabPlanosaudequal" class="form-control" />
														</div>
													</div>

													<label>Qual hospital você gostaria de ser levado em caso de emergência?</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-6">
															<input type="text" name="saudecolabHospitalqual" id="saudecolabHospitalqual" class="form-control" />
														</div>
													</div>

													<label>Possui algum tipo de alergia?</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabAlergia" id="saudecolabAlergia" class="select2">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Se sim, descreva qual tipo de alergia você possui?</label>
													<div class="form-group">
														<div class="col-xs-62 col-sm-6">
															<input type="text" name="saudecolabAlergiaqual" id="saudecolabAlergiaqual" class="form-control" />
														</div>
													</div>

													<label>Há algum medicamento que não possa ingerir?</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabMedicamentonao" id="saudecolabMedicamentonao" class="select2">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Se sim, descreva qual medicamento?</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-12">
															<input type="text" name="saudecolabMedicamentonaoqual" id="saudecolabMedicamentonaoqual" class="form-control" />
														</div>
													</div>

													<label hidden>Usa medicamentos regularmente?</label>
													<div class="form-group" hidden>
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabMedicamentosim" id="saudecolabMedicamentosim" class="select2">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label hidden>Quais medicamentos usa regularmente?</label>
													<div class="form-group" hidden>
														<div class="col-xs-6 col-sm-12">
															<input type="text" name="saudecolabMedicamentosimqual" id="saudecolabMedicamentosimqual" class="form-control" />
														</div>
													</div>

													<label>É hipertenso?</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabHipertenso" id="saudecolabHipertenso" class="select2">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>É cardíaco?</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabCardiaco" id="saudecolabCardiaco" class="select2">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>É diabético?</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabDiabetico" id="saudecolabDiabetico" class="select2">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Faz uso de insulina?</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabInsulina" id="saudecolabInsulina" class="select2">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Possui alguma condição de saúde que seja importante ser relatada?</label>
													<label style="color: chocolate;">(ex.: asma, desmaios, convulsão, epilepsia, entre outras)?</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-12">
															<input type="text" name="saudecolabCondicaosaude" id="saudecolabCondicaosaude" class="form-control" />
														</div>
													</div>
													
													<div class="alert alert-warning" style="font-style: initial;">
														<strong>
															Indique duas pessoas que possamos entrar em contato em caso de emergência:
														</strong>
													</div>
													
													<label>Primeiro Contato:</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-6">
															<input type="text" name="saudecolabContato1" id="saudecolabContato1" class="form-control" />
														</div>
													</div>

													<label>Parentesco:</label>
													<div class="form-group">
														<div class="col-xs-3 col-sm-3">
															<input type="text" name="saudecolabParentesco1" id="saudecolabParentesco1" class="form-control" />
														</div>
													</div>

													<label>Celular:</label>
													<div class="form-group">
														<div class="col-xs-3 col-sm-3">
															<input type="text" name="saudecolabCelular1" id="saudecolabCelular1" class="form-control" />
														</div>
													</div>

													<label>Segundo Contato:</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-6">
															<input type="text" name="saudecolabContato2" id="saudecolabContato2" class="form-control" />
														</div>
													</div>

													<label>Parentesco:</label>
													<div class="form-group">
														<div class="col-xs-3 col-sm-3">
															<input type="text" name="saudecolabParentesco2" id="saudecolabParentesco2" class="form-control" />
														</div>
													</div>

													<label>Celular:</label>
													<div class="form-group">
														<div class="col-xs-3 col-sm-3">
															<input type="text" name="saudecolabCelular2" id="saudecolabCelular2" class="form-control" />
														</div>
													</div>

													<label hidden>Observações gerais:</label>
													<div class="form-group" hidden>
														<div class="col-xs-6 col-sm-12">
															<input type="text" name="saudecolabObs" id="saudecolabObs" class="form-control" />
														</div>
													</div>
													
														<div class="alert alert-warning">
															<strong>Veracidade das Informações</strong><br>
															Declaro que as informações são atuais e me responsabilizo pela veracidade.
															<br>
														</div>
													
												
														<div class="alert alert-warning">
															<strong>Armazenamento em Nuvem</strong><br>
															Autorizo o armazenamento seguro das informações fornecidas neste sistema em uma plataforma de armazenamento na nuvem, em conformidade com as normas de proteção de dados aplicáveis.
															<br>
														</div>
													
												
														<div class="alert alert-warning">
														<strong>Acesso às Informações por Usuários</strong><br>
														Autorizo que os usuários devidamente autorizados possam visualizar as informações fornecidas, 
														especialmente em emergências médica, com o objetivo de garantir a minha segurança
														 e o pronto atendimento médico necessário.
														</div>
														<hr>
													
													<label>Data da informação:</label>
													<div class="form-group">
														<div class="col-xs-3 col-sm-3">
															<input type="date" name="saudecolabSaudecolabdata" id="saudecolabSaudecolabdata" class="form-control" />
														</div>
													</div>
													<label>Aceitar os termos acima?</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabAceitartermos" id="saudecolabAceitartermos" class="select2" onchange="aceitaTermo();">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>
													
												</div>
											</div>
										</div>
									</div>
								</div>
								<div class="space-4"></div>							
								<div class="space-4"></div>

								<div class="form-actions">
									<div class="col-sm-12">
										<div class="row">
											<div class="col-sm-2">
												<button class="btn btn-info"  id="btnSalvar" name="acao" type="submit">
												<i class="ace-icon fa fa-check bigger-110"></i>
												Salvar
												</button>
											</div>
												&nbsp;
											<div class="col-sm-2">
												<button class="btn btn-warning"  type="reset">
												<i class="ace-icon fa fa-undo bigger-110"></i>
												Voltar
												</button>
											</div>
										</div>
									</div>
								</div>
							</form>

							
						</div><!-- /.col -->
					</div><!-- /.row -->




				</div>
			</div><!-- /.main-content -->


		</div><!-- /.main-container -->





		<!-- basic scripts -->

	</body>
</html>
