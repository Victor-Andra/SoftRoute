<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Ficha de Saúde dos Colaboradores</title>
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">


			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Ficha de Saúde dos Colaboradores</a>
							</li>

							<li class="active">Cadastro</li>
						</ul><!-- /.breadcrumb -->

					</div>

					<div class="row">
						<div class="col-xs-12">
							<!-- PAGE CONTENT BEGINS -->
							<form class="form-horizontal" role="form"  action="/menu/ferramentas/saudecolab/add" method="POST">
								<div class="form-horizontal" role="form">
									<div class="col-sm-12"><!-- Widget Dados Básicos -->
										<div class="widget-box">
											<div class="widget-header">
												<h4 class="widget-title">Ficha de Saúde dos Colaboradores</h4>

												<span class="widget-toolbar">

													<a href="#" data-action="reload">
														<i class="ace-icon fa fa-refresh"></i>
													</a>

													<a href="#" data-action="collapse">
														<i class="ace-icon fa fa-chevron-up"></i>
													</a>

												</span>
											</div>
											<div class="widget-body">
												<div class="widget-main">

												
													<label>Colaborador</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-6">
															<select name="saudecolabSaudecolabusuid" id="saudecolabSaudecolabusuid" class="chosen-select" onchange="">
																<option value="766f69643132333435366964">-</option>
																{{#each usuarios}}
																	<option value="{{_id}}">{{usuario_nome}}</option>
																{{/each}}
															</select>
														</div>
													</div>

													<label>Data da Informação Dada Pelo Colaborador</label>
													<div class="form-group">
														<div class="col-xs-3 col-sm-3">
															<input type="date" name="saudecolabSaudecolabdata" id="saudecolabSaudecolabdata" class="form-control" />
														</div>
													</div>

													<label>Tipo Sanguíneo</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-3">
															<select name="saudecolabTiposangue" id="saudecolabTiposangue" class="chosen-select" onchange="">
																<option value="-">-</option>
																<option value="A+">A+</option>
																<option value="A-">A-</option>
																<option value="B+">B+</option>
																<option value="B-">B-</option>
																<option value="AB+">AB+</option>
																<option value="AB-">AB-</option>
																<option value="O+">O+</option>
																<option value="O-">O-</option>
																
															</select>
														</div>
													</div>

													<label>Plano de Saúde</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabPlanosaude" id="saudecolabPlanosaude" class="form-control">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Plano de Saúde Qual</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-6">
															<input type="text" name="saudecolabPlanosaudequal" id="saudecolabPlanosaudequal" class="form-control" />
														</div>
													</div>

													<label>Hospital Qual</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-6">
															<input type="text" name="saudecolabHospitalqual" id="saudecolabHospitalqual" class="form-control" />
														</div>
													</div>

													<label>Alergia</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabAlergia" id="saudecolabAlergia" class="form-control">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Alergia Qual</label>
													<div class="form-group">
														<div class="col-xs-62 col-sm-6">
															<input type="text" name="saudecolabAlergiaqual" id="saudecolabAlergiaqual" class="form-control" />
														</div>
													</div>

													<label>Medicamentos Que Não Pode Usar</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabMedicamentonao" id="saudecolabMedicamentonao" class="form-control">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Liste os Medicamento Que Não Podem Ser Usados</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-12">
															<input type="text" name="saudecolabMedicamentonaoqual" id="saudecolabMedicamentonaoqual" class="form-control" />
														</div>
													</div>

													<label>Usa Medicamentos Regularmente?</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabMedicamentosim" id="saudecolabMedicamentosim" class="form-control">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Quais Medicamentos Usa Regularmente?</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-12">
															<input type="text" name="saudecolabMedicamentosimqual" id="saudecolabMedicamentosimqual" class="form-control" />
														</div>
													</div>

													<label>Hipertenso</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabHipertenso" id="saudecolabHipertenso" class="form-control">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Cardíaco</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabCardiaco" id="saudecolabCardiaco" class="form-control">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Diabético</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabDiabetico" id="saudecolabDiabetico" class="form-control">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Insulina</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabInsulina" id="saudecolabInsulina" class="form-control">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>

													<label>Condição de Saúde</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-12">
															<input type="text" name="saudecolabCondicaosaude" id="saudecolabCondicaosaude" class="form-control" />
														</div>
													</div>

													<label>Primeiro Contato</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-6">
															<input type="text" name="saudecolabContato1" id="saudecolabContato1" class="form-control" />
														</div>
													</div>

													<label>Parentesco</label>
													<div class="form-group">
														<div class="col-xs-3 col-sm-3">
															<input type="text" name="saudecolabParentesco1" id="saudecolabParentesco1" class="form-control" />
														</div>
													</div>

													<label>Celular</label>
													<div class="form-group">
														<div class="col-xs-3 col-sm-3">
															<input type="text" name="saudecolabCelular1" id="saudecolabCelular1" class="form-control" />
														</div>
													</div>

													<label>Segundo Contato</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-6">
															<input type="text" name="saudecolabContato2" id="saudecolabContato2" class="form-control" />
														</div>
													</div>

													<label>Parentesco</label>
													<div class="form-group">
														<div class="col-xs-3 col-sm-3">
															<input type="text" name="saudecolabParentesco2" id="saudecolabParentesco2" class="form-control" />
														</div>
													</div>

													<label>Celular</label>
													<div class="form-group">
														<div class="col-xs-3 col-sm-3">
															<input type="text" name="saudecolabCelular2" id="saudecolabCelular2" class="form-control" />
														</div>
													</div>

													<label>Observações Gerais</label>
													<div class="form-group">
														<div class="col-xs-6 col-sm-12">
															<input type="text" name="saudecolabObs" id="saudecolabObs" class="form-control" />
														</div>
													</div>
													<div class="col-xs-12">
														<div class="alert alert-warning">
															<strong>Veracidade das Informações</strong><br>
															Declaro que as informações são atuais e me responsabilizando pela veracidade.
															<br>
														</div>
													</div>
													<div class="col-xs-12">
														<div class="alert alert-warning">
															<strong>Armazenamento em Nuvem</strong><br>
															Autorizo o armazenamento seguro das informações fornecidas neste sistema em uma plataforma de armazenamento na nuvem, em conformidade com as normas de proteção de dados aplicáveis.
															<br>
														</div>
													</div>
													<div class="col-xs-12">
														<div class="alert alert-warning">
															<strong>Acesso às Informações por Colaboradores</strong><br>
															Autorizo que colaboradores devidamente autorizados possam visualizar as informações fornecidas, especialmente em situações de Emergência e/ou Urgência Médica, com o objetivo de garantir a minha segurança e o pronto atendimento médico necessário.
															<br>
														</div>
														<hr>
													</div>
													
													<label>Aceitar Termos acima</label>
													<div class="form-group">
														<div class="col-xs-2 col-sm-2">
															<select name="saudecolabAceitartermos" id="saudecolabAceitartermos" class="form-control">
																<option value="-">-</option>
																<option value="Sim">Sim</option>
																<option value="Não">Não</option>
															</select>
														</div>
													</div>
													
												</div>
											</div>
										</div>
									</div>
								</div>
								<div class="space-4"></div>							
								<div class="space-4"></div>

								<div class="form-actions">
									<div class="col-md-offset-3 col-md-9">
										<button class="btn btn-info"  name="acao" type="submit">
											<i class="ace-icon fa fa-check bigger-110"></i>
											Salvar
										</button>

										&nbsp; &nbsp; &nbsp;
										<button class="btn btn-warning"  type="reset">
											<i class="ace-icon fa fa-undo bigger-110"></i>
											Voltar
										</button>
									</div>
								</div>
							</form>

							
						</div><!-- /.col -->
					</div><!-- /.row -->




				</div>
			</div><!-- /.main-content -->


		</div><!-- /.main-container -->





		<!-- basic scripts -->

	</body>
</html>
