<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista das Ficha Médica</title>
		
		<!-- Importação do Font Awesome -->
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
		/>
		<style>
        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #ddd;
			align-items: center;
			text-align: center;
			width: 10px; /* Ajuste o valor conforme necessário */
            padding: 8px;
			white-space: wrap; /* quebre em múltiplas linhas o tetxo */
        }

        /* Deixa a primeira coluna com largura fixa */
        td:first-child, th:first-child {
            width: 130px; /* Ajuste o valor conforme necessário */
			text-align: left;
			white-space: nowrap; /* Impede que o texto quebre em múltiplas linhas */
            
        }
    </style>
		
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					{{#compareString flash.sucesso "true"}}
						<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-success">
							<p>
								<strong>
									<i class="ace-icon fa fa-check"></i>
									{{flash.texto}}
								</strong>
								<button type="button" class="close" onclick="javascript:OcultaMsg()">
									<i class="ace-icon fa fa-times"></i>
								</button>
							</p>
						</div>
						<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-success">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
					{{else}}
						{{#compareString flash.sucesso "false"}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">
								<p>
									<strong>
										<i class="ace-icon fa fa-times"></i>
										{{flash.texto}}
									</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()">
										<i class="ace-icon fa fa-times"></i>
									</button>
								</p>
							</div>
							<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
						{{else}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-warning">
								<p>
									<strong>
										<i class="ace-icon fa fa-check"></i>
										{{flash.texto}}
									</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()">
										<i class="ace-icon fa fa-times"></i>
									</button>
								</p>
							</div>
							<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
						{{/compareString}}
					{{/compareString}}
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Lista das Fichas Médicas</li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<div class="row">
									<div class="col-xs-12">
											<div class="clearfix" >
												<div class="pull-right tableTools-container">


												</div>
											</div>

											<div id="dynamic-table_wrapper" class="dataTables_wrapper form-inline no-footer">
											</div>
											
											<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable " role="grid" aria-describedby="dynamic-table_info">
												
												<thead>
													<tr role="row">
														 <tr>
															<th rowspan="2" style="width: 15%;">Nome</th>
															<th rowspan="2" style="width: 5%;">Data <br>Atualização</th>
															<th colspan="8">Principais Pontuações</th>
															<th colspan="2">Em Caso de Urgência</th>
															<th rowspan="2" style="width: 1%;">Ações<br>
																<a hidden class="red" href="/menu/ferramentas/saudecolab/cad">
																		<i class="ace-icon fa fa-plus bigger-130" title="Adicionar Nova Ficha de Saúde"></i>
																	</a>
															</th>
														</tr>
														<tr>
															<th style="width: 5%;">Tipo<br>Sanguíneo</th>
															<th style="width: 5%;">Plano Saúde</th>
															<th style="width: 5%;">Alérgico&nbsp;&nbsp;<a class="pink"><i class="ace-icon fa fa-podcast small"></i></a></th>
															<th style="width: 5%;">Medicamentos&nbsp;&nbsp;<a class="red"><i class="ace-icon fa fa-ban small" title="Não pode tomar."></i></a><br>
															não pode tomar.</th>
															<th style="width: 5%;">Hipertensão&nbsp;&nbsp;<a class="red"><i class="ace-icon fa fa-heartbeat small"></i></a></th>
															<th style="width: 5%;">Cardíaco&nbsp;&nbsp;<a class="purple"><i class="ace-icon fa fa-heart small"></i></a></th>
															<th style="width: 5%;">Diabetes&nbsp;&nbsp;<a class="orange"><i class="ace-icon fa fa-tint small"></i></a></th>
															<!-- /.row 
															<th style="width: 5%;">Mendicamentos&nbsp;&nbsp;<a class="green"><i class="ace-icon fa fa-plus small" title="Deve tomar regularmente."></i></a> </th>
															-->
															<th style="width: 5%; white-space: wrap;">Hospital</th>
															<th colspan="2" style="width: 5%;">Contatos</th>
														</tr>
														
														
													</tr>
													
													
												</thead>
												
												<tbody>
													{{#each saudecolabs}}
														<tr>
															{{#each ../usuarios}}
																	{{#ifEqual this._id ../saudecolab_saudecolabusuid}}
																		<td style="width: 15%; white-space: wrap;">
																			<span class="badge badge-info">{{usuario_nome}}</span>
																		</td>
																	{{/ifEqual}}
																{{/each}}
															<td  style="width: 5%;">
																<span class="badge badge-info">{{saudecolab_saudecolabdata}}</span>
															</td>
															<td  style="width: 5%;">
																<span class="badge badge-warning">{{saudecolab_tiposangue}}</span>
															</td>
															<td  style="width: 5%; white-space: wrap;">
																{{#ifEqual this.saudecolab_planosaude "Sim"}}
																	<span style="white-space: wrap;" class="badge badge-info">{{saudecolab_planosaudequal}}</span>
																	{{else}}
																	<span style="white-space: wrap;" class="badge badge-danger">{{saudecolab_planosaude}}</span>
																{{/ifEqual}}
															</td>
															<td style="width: 5%; white-space: wrap;">
																{{#ifEqual this.saudecolab_alergia "Sim"}}
																	<span style="white-space: wrap;" class="badge badge-danger">{{saudecolab_alergia}}</span>
																	<a class="red">
																		<i class="ace-icon fa fa-search bigger-130" title="{{saudecolab_alergiaqual}}"></i>
																	</a>
																	{{else}}
																	<span style="white-space: wrap;" class="badge badge-success">{{saudecolab_alergia}}</span>
																{{/ifEqual}}
															</td>
															<td  style="width: 5%;">
																{{#ifEqual this.saudecolab_medicamentonao "Sim"}}
																	<span style="white-space: wrap;" class="badge badge-danger">{{saudecolab_medicamentonaoqual}}</span>
																	{{else}}
																	<span style="white-space: wrap;" class="badge badge-success">{{saudecolab_medicamentonao}}</span>
																{{/ifEqual}}
																
															</td>
															<td  style="width: 5%;">
																{{#ifEqual this.saudecolab_hipertenso "Sim"}}
																	<span class="badge badge-danger">{{saudecolab_hipertenso}}</span>
																	
																	{{else}}
																	<span class="badge badge-success">{{saudecolab_hipertenso}}</span>
																{{/ifEqual}}
																
															</td>
															<td  style="width: 5%;">
																{{#ifEqual this.saudecolab_cardiaco "Sim"}}
																	<span class="badge badge-danger">{{saudecolab_cardiaco}}</span>
																	
																	{{else}}
																	<span class="badge badge-success">{{saudecolab_cardiaco}}</span>
																{{/ifEqual}}
																
															</td>
															<td  style="width: 5%;">
																{{#ifEqual this.saudecolab_diabetico "Sim"}}
																	<span class="badge badge-danger">{{saudecolab_diabetico}}</span><br>
																		{{#ifEqual this.saudecolab_insulina "Sim"}}
																		<a class="black">
																			<i class="ace-icon fa fa-toggle-on bigger-130" title="Toma Insulina"></i>
																		</a>
																		{{else}}
																		
																		{{/ifEqual}}
																	{{else}}
																	<span class="badge badge-success">{{saudecolab_diabetico}}</span>
																{{/ifEqual}}
															</td>
															<!-- /.row 
															<td >
																<span class="badge badge-success">{{saudecolab_medicamentosimqual}}</span>
															</td>
															-->
															<td>
																<span style="white-space: wrap;" class="badge badge-warning">{{saudecolab_hospitalqual}}</span>
															</td>
															
															<td>
																<span style="white-space: wrap;" class="badge badge-info">{{saudecolab_contato1}}</span><br>
																<span class="badge badge-info">{{saudecolab_parentesco1}}</span><br>
																<span class="badge badge-info">{{saudecolab_celular1}}</span>
															</td>
															<td>
																<span style="white-space: wrap;" class="badge badge-info">{{saudecolab_contato2}}</span><br>
																<span class="badge badge-info">{{saudecolab_parentesco2}}</span><br>
																<span class="badge badge-info">{{saudecolab_celular2}}</span>
															</td>

															<td>
																<div class="action-buttons">
																	<a class="blue" href="/menu/ferramentas/saudecolab/edi/{{_id}}">
																		<i class="ace-icon fa fa-search bigger-130"></i>
																	</a>
																	
																</div>
																<div class="hidden-md hidden-lg">
																	
																	</div>
																</div>
															</td>
														</tr>
													{{/each}}
												</tbody>

											</table>


										
										
										
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

		
		</div><!-- /.main-container ace-save-state -->

		<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		

		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
			"language": { "url": "/js/lang/datatable-pt-br.json" },
			"aaSorting": [],
			"aoColumns": [null, null, null, null, null, null, null,null, null, null, null,  null,{ "bSortable": false }],
			"responsive": true,
			"lengthMenu": [200, 500],
			"lengthChange": true,
			"autoWidth": false,
			"paging": true,
			"lengthChange": true,
			"searching": true,
			"ordering": true,
			"info": true,
			
			select: {
						style: 'multi'
					}
			});
		});
		$.fn.dataTable.Buttons.defaults.dom.container.className = 'dt-buttons btn-overlap btn-group btn-overlap';
		</script>

	</body>

</html>