<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Empresa - Editar</title>
    <style>
        /* Estilo local para garantir consistência visual */
        .tab-pane .form-group {
            margin-bottom: 15px;
        }
        .tab-pane .input-group {
            max-width: 30%;
        }
        .tab-pane .input-group input,
        .tab-pane .input-group select {
            width: 100%;
        }
        .tab-pane label {
            font-weight: 500;
            margin-bottom: 4px;
            color: #555;
        }
        .widget-main {
            padding: 15px;
        }
        .form-actions {
            margin-top: 20px;
            text-align: center;
            padding: 10px 15px;
        }
        .hidden {
            display: none;
        }
    </style>
</head>

<body onload="javascript:controlaNave();" class="no-skin">

<div class="main-container ace-save-state" id="main-container">

    <div class="main-content">
        <div class="main-content-inner">
            <div class="breadcrumbs ace-save-state" id="breadcrumbs">
                <ul class="breadcrumb">
                    <li>
                        <i class="ace-icon fa fa-home home-icon"></i>
                        <a href="#">Home</a>
                    </li>
                    <li class="active">Empresa - Editar</li>
                </ul>
            </div>

            <div class="row">
                <div class="col-xs-12">
                    <form class="form-horizontal" role="form" action="/menu/ferramentas/empresa/atualizar" method="POST">

                        <!-- ABAS -->
                        <div class="tabbable">
                            <ul class="nav nav-tabs padding-16" id="myTab">
                                <li class="active">
                                    <a data-toggle="tab" href="#basico">
                                        <i class="red ace-icon fa fa-building bigger-120"></i>
                                        Dados Básicos
                                    </a>
                                </li>
                                <li>
                                    <a data-toggle="tab" href="#end">
                                        <i class="orange ace-icon fa fa-map-marker bigger-120"></i>
                                        Endereço
                                    </a>
                                </li>
                                <li>
                                    <a data-toggle="tab" href="#contato">
                                        <i class="green ace-icon fa fa-phone-square bigger-120"></i>
                                        Contato
                                    </a>
                                </li>
                                <li>
                                    <a data-toggle="tab" href="#obs">
                                        <i class="pink ace-icon fa fa-file-text bigger-120"></i>
                                        Observações
                                    </a>
                                </li>
                            </ul>

                            <div class="tab-content">

                                <!-- DADOS BÁSICOS -->
                                <div id="basico" class="tab-pane fade active in" role="tabpanel">
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <div class="widget-box">
                                                <div class="widget-header">
                                                    <h4 class="widget-title">Informações Básicas</h4>
                                                </div>
                                                <div class="widget-body">
                                                    <div class="widget-main">
                                                        <div class="form-group">
                                                            <label>Unidade</label>
                                                            <input type="text" name="empresaUnidade" class="form-control" value="{{empresa.empresa_unidade}}" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Razão Social</label>
                                                            <input type="text" name="empresaNome" class="form-control" value="{{empresa.empresa_nome}}" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Nome Fantasia</label>
                                                            <input type="text" name="empresaFantasia" class="form-control" value="{{empresa.empresa_fantasia}}" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>CNPJ</label>
                                                            <input type="text" name="empresaCnpj" class="form-control" value="{{empresa.empresa_cnpj}}" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Inscrição Municipal</label>
                                                            <input type="text" name="empresaMuni" class="form-control" value="{{empresa.empresa_muni}}" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Inscrição Estadual</label>
                                                            <input type="text" name="empresaEstad" class="form-control" value="{{empresa.empresa_estad}}" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- ENDEREÇO -->
                                <div id="end" class="tab-pane fade" role="tabpanel">
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <div class="widget-box">
                                                <div class="widget-header">
                                                    <h4 class="widget-title">Endereço</h4>
                                                </div>
                                                <div class="widget-body">
                                                    <div class="widget-main">
                                                        <div class="form-group">
                                                            <label>Endereço</label>
                                                            <input type="text" name="empresaEnd" class="form-control" value="{{empresa.empresa_end}}" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Complemento</label>
                                                            <input type="text" name="empresaEndcompl" class="form-control" value="{{empresa.empresa_endcompl}}" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Bairro</label>
                                                            <input type="text" name="empresaEndbairro" class="form-control" value="{{empresa.empresa_endbairro}}" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Cidade</label>
                                                            <input type="text" name="empresaEndcidade" class="form-control" value="{{empresa.empresa_endcidade}}" />
                                                        </div>
                                                        <div class="form-group">
                                                            
															<label>UF</label>
															<div class="input-group">
																	<div >
																		<select name="empresaEnduf" id="empresaEnduf" class="select2" data-placeholder="Escolha...">
																				{{#each estados}}
																				<option value="{{_id}}">{{estado_uf}}</option>
																				{{else}}
																				{{/each}}
																		</select>
																	</div>
															</div>
														</div>
                                                        <div class="form-group">
                                                            <label>CEP <small class="text-warning">00000-000</small></label>
                                                            <input type="text" name="empresaEndcep" class="form-control" value="{{empresa.empresa_endcep}}" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- CONTATO -->
                                <div id="contato" class="tab-pane fade" role="tabpanel">
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <div class="widget-box">
                                                <div class="widget-header">
                                                    <h4 class="widget-title">Contatos</h4>
                                                </div>
                                                <div class="widget-body">
                                                    <div class="widget-main">
                                                        <div class="form-group">
                                                            <label>WhatsApp</label>
                                                            <div class="input-group">
                                                                <span class="input-group-addon">
                                                                    <i class="ace-icon fa fa-whatsapp"></i>
                                                                </span>
                                                                <input type="text" name="empresaWhatsapp" class="form-control input-mask-phone" value="{{empresa.empresa_whatsapp}}" />
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Celular</label>
                                                            <div class="input-group">
                                                                <span class="input-group-addon">
                                                                    <i class="ace-icon fa fa-phone"></i>
                                                                </span>
                                                                <input type="text" name="empresaCel" class="form-control input-mask-phone" value="{{empresa.empresa_cel}}" />
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Telefone Fixo</label>
                                                            <div class="input-group">
                                                                <span class="input-group-addon">
                                                                    <i class="ace-icon fa fa-phone"></i>
                                                                </span>
                                                                <input type="text" name="empresaFixo" class="form-control input-mask-phone" value="{{empresa.empresa_fixo}}" />
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label>E-mail</label>
                                                            <div class="input-group">
                                                                <span class="input-group-addon">
                                                                    <i class="ace-icon fa fa-envelope"></i>
                                                                </span>
                                                                <input type="email" name="empresaEmail" class="form-control" value="{{empresa.empresa_email}}" />
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Site</label>
                                                            <div class="input-group">
                                                                <span class="input-group-addon">
                                                                    <i class="ace-icon fa fa-globe"></i>
                                                                </span>
                                                                <input type="url" name="empresaSite" class="form-control" value="{{empresa.empresa_site}}" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- OBSERVAÇÕES -->
                                <div id="obs" class="tab-pane fade" role="tabpanel">
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <div class="widget-box">
                                                <div class="widget-header">
                                                    <h4 class="widget-title">Observações</h4>
                                                </div>
                                                <div class="widget-body">
                                                    <div class="widget-main">
														<div class="col-xs-10 col-sm-4">
															<label>Status</label>
															<div class="input-group">
																<div >
																	<select name="empresaStatus" id="empresaStatus" class="select2" data-placeholder="Escolha...">
																		<option value="true">Ativo</option>
																		<option value="false">Inativo</option>
																	</select>
																</div>
															</div>
														</div>
                                                        <div class="form-group">
                                                            <label>Observações</label>
                                                            <textarea name="empresaObs" class="form-control" rows="5">{{empresa.empresa_obs}}</textarea>
                                                        </div>
                                                        <div class="hidden">
                                                            <input type="text" name="empresaId" value="{{_id}}" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div> <!-- fim tab-content -->
                        </div> <!-- fim tabbable -->

                        <!-- BOTÕES -->
                        <div class="space-4"></div>
                        <div class="space-4"></div>
                        <div class="form-actions" style="text-align: center;">
                            <button class="btn btn-info" type="submit" name="acao">
                                <i class="ace-icon fa fa-check bigger-110"></i>
                                Salvar
                            </button>
                            &nbsp;
                            <a href="/menu/ferramentas/empresa/lis" class="btn btn-warning">
                                <i class="ace-icon fa fa-undo bigger-110"></i>
                                Voltar
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- =========================================== -->
<!-- SCRIPTS OBRIGATÓRIOS (jQuery + Bootstrap) -->
<!-- =========================================== -->
<!-- 1. jQuery (obrigatório) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- 2. Bootstrap JS (para os tabs funcionarem) -->
<script src="https://stackpath.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>




</body>
</html>