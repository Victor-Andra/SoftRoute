<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Usuários</title>
		<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
		<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
		<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
		<style>
		.textarea {
			width: 100%;
			box-sizing: border-box;
			font-size: 12px;
		}
		.select2-container {
			width: 100% !important;
		}

		.select2-selection__choice {
			background-color: #007bff !important;
			color: #fff !important;
			border: none !important;
			border-radius: 4px !important;
			padding: 2px 8px !important;
		}

		</style>
		<script>
			$(document).ready(function() {
				 // Inicializa o Select2
				const $select = $('#usuarioEmpresaselect').select2({
					width: '100%',
					placeholder: 'Escolha as empresas...',
					allowClear: true,
					closeOnSelect: false
				});

				// 👉 Evento: quando seleciona algo
				$select.on('change', function(e) {
					const valores = $(this).val() || [];

					// Se "Acesso total" for selecionado
					if (valores.includes('Total')) {
						// Desmarca todas as outras opções e mantém só "Total"
						$(this).val(['Total']).trigger('change.select2');
					}
				});

				// 👉 Botão "Selecionar tudo"
				$('#selectAllEmpresas').on('click', function() {
					const allValues = [];
					$('#usuarioEmpresaselect option').each(function() {
						if ($(this).val() !== 'Total') {
							allValues.push($(this).val());
						}
					});
					$select.val(allValues).trigger('change.select2');
				});

				// 👉 Botão "Limpar"
				$('#clearEmpresas').on('click', function() {
					$select.val(null).trigger('change.select2');
				});
			});
			function exibenome() {
				document.getElementById("usuarioNomeCompletoinfo").value = document.getElementById("usuarioNome").value;
			}
			function carregarImagem() {
				var preview = document.getElementById('previewImage');
				var fileInput = document.getElementById('usuarioCarimbo');

				if (fileInput.files && fileInput.files[0]) {
					var reader = new FileReader();

					reader.onload = function (e) {
						preview.src = e.target.result;
						document.getElementById('previewCarimbo').style.display = 'block'; // Exibe a div
					};

					reader.readAsDataURL(fileInput.files[0]);
				}
			}

			function validarFormulario() {
				var usuarioCarimboInput = document.getElementById("usuarioCarimbo");
				if (usuarioCarimboInput.files.length === 0) {
					alert("Selecione uma imagem para o carimbo!");
					return false; // Impede o envio do formulário
				}
				return true; // Permite o envio do formulário
			}

			//Graduação multipla seleção:
			// Obtém todos os checkboxes com o nome 'usuarioGraduacaoOp'
			var checkboxes = document.getElementsByName('usuarioGraduacaoOp');

			// Adiciona um evento change a cada checkbox
			checkboxes.forEach(function(checkbox) {
				checkbox.addEventListener('change', function() {
				updateUsuarioGraduacao();
				});
			});

			// Função para atualizar o valor do input text com base nas seleções
			function updateUsuarioGraduacao() {
				// Obtém todos os checkboxes marcados
				var selectedCheckboxes = Array.from(checkboxes).filter(function(checkbox) {
				return checkbox.checked;
				});

				// Obtém os valores dos checkboxes marcados
				var selectedValues = selectedCheckboxes.map(function(checkbox) {
				return checkbox.value;
				});

				// Atualiza o valor do input text com os valores separados por ';'
				document.getElementById('usuarioGraduacao').value = selectedValues.join(';');

			}
		
			//Especialização multipla seleção:
			// Obtém todos os checkboxes com o nome 'usuarioEspecializacaoOp'
			var especializacaoCheckboxes = document.getElementsByName('usuarioEspecializacaoOp');

			// Adiciona um evento change a cada checkbox
			especializacaoCheckboxes.forEach(function(checkbox) {
				checkbox.addEventListener('change', function() {
					updateUsuarioEspecializacao();
				});
			});

			// Função para atualizar o valor do input text com base nas seleções de especialização
			function updateUsuarioEspecializacao() {
				// Obtém todos os checkboxes de especialização marcados
				var selectedCheckboxes = Array.from(especializacaoCheckboxes).filter(function(checkbox) {
					return checkbox.checked;
				});

				// Obtém os valores dos checkboxes de especialização marcados
				var selectedValues = selectedCheckboxes.map(function(checkbox) {
					return checkbox.value;
				});

				// Atualiza o valor do input text com os valores separados por ';'
				document.getElementById('usuarioEspecializacao').value = selectedValues.join(';');
			}

			//Método multipla seleção:
			// Obtém todos os checkboxes com o nome 'usuarioMetodoOp'
			var metodoCheckboxes = document.getElementsByName('usuarioMetodoOp');

			// Adiciona um evento change a cada checkbox
			metodoCheckboxes.forEach(function(checkbox) {
				checkbox.addEventListener('change', function() {
					updateUsuarioMetodo();
				});
			});

			// Função para atualizar o valor do input text com base nas seleções de método
			function updateUsuarioMetodo() {
				// Obtém todos os checkboxes de método marcados
				var selectedCheckboxes = Array.from(metodoCheckboxes).filter(function(checkbox) {
					return checkbox.checked;
				});

				// Obtém os valores dos checkboxes de método marcados
				var selectedValues = selectedCheckboxes.map(function(checkbox) {
					return checkbox.value;
				});

				// Atualiza o valor do input text com os valores separados por ';'
				document.getElementById('usuarioMetodo').value = selectedValues.join(';');
			}

			//Outros Método multipla seleção:
			// Obtém todos os checkboxes com o nome 'usuarioMetoutOp'
			var metoutCheckboxes = document.getElementsByName('usuarioMetoutOp');

			// Adiciona um evento change a cada checkbox
			metoutCheckboxes.forEach(function(checkbox) {
				checkbox.addEventListener('change', function() {
					updateUsuarioMetout();
				});
			});

			// Função para atualizar o valor do input text com base nas seleções de método
			function updateUsuarioMetout() {
				// Obtém todos os checkboxes de método marcados
				var selectedCheckboxes = Array.from(metoutCheckboxes).filter(function(checkbox) {
					return checkbox.checked;
				});

				// Obtém os valores dos checkboxes de método marcados
				var selectedValues = selectedCheckboxes.map(function(checkbox) {
					return checkbox.value;
				});

				// Atualiza o valor do input text com os valores separados por ';'
				document.getElementById('usuarioMetout').value = selectedValues.join(';');
			}

			function salvar() {
				if (document.getElementById("login") == undefined || document.getElementById("login") == "") {
					alert("Por favor preencha o login corretamente.");
				} else if (document.getElementById("senha") == undefined || document.getElementById("senha") == "") {
					alert("Por favor preencha a senha corretamente.");
				} else if (document.getElementById("usuarioEmail") == undefined || document.getElementById("usuarioEmail") == "") {
					alert("Por favor preencha o email corretamente.");
				} else {
					let form = document.getElementById("formUsuarioCad");
					form.action = "/menu/ferramentas/usuario/add";
					form.submit();
				}
			}
			function addEmpresaId() {
				document.getElementById("spanShowEmpresaid").style = "display:none";

				var id = document.getElementById("usuarioEmpresaselect").value;
				var progSubid = document.getElementById("usuarioEmpresaselect");
				var span = document.getElementById(id + "_spanExce").cloneNode(true);

				// Obtendo o nome da opção selecionada
				var selectedOptionText = $("#usuarioEmpresaselect option:selected").text();

				span.id = "" + id + "_cloneExceTera";
				document.getElementById("divExcecaoDica").append(span);

				if (progSubid.value == "") {
					progSubid.value = "" + id + "";
				} else {
					progSubid.value = "" + progSubid.value + "," + id + "";
				}

				// Adicionando o nome da opção à div usuarioEmpresatext
				var usuarioEmpresatextInput = document.getElementById("usuarioEmpresatext");
				if (usuarioEmpresatextInput.value == "") {
					usuarioEmpresatextInput.value = selectedOptionText;
				} else {
					usuarioEmpresatextInput.value += ", " + selectedOptionText;
				}

				// Chamando atualizaProgressBars após adicionar uma seleção
				var selectedTextValues = usuarioEmpresatextInput.value; // Alteração aqui
				atualizaProgressBars(selectedTextValues); // Alteração aqui

				// Resetando o valor do select
				document.getElementById("usuarioEmpresaselect").value = "766f69643132333435366964";
			}
			function addEmpresaId() {
				document.getElementById("spanShowExceTera").style = "display:none";

				var id = document.getElementById("progDicatiposelect").value;
				var progSubid = document.getElementById("progDicatipo");
				var span = document.getElementById(id + "_spanExce").cloneNode(true);

				// Obtendo o nome da opção selecionada
				var selectedOptionText = $("#progDicatiposelect option:selected").text();

				span.id = "" + id + "_cloneExceTera";
				document.getElementById("divExcecaoDica").append(span);

				if (progSubid.value == "") {
					progSubid.value = "" + id + "";
				} else {
					progSubid.value = "" + progSubid.value + "," + id + "";
				}

				// Adicionando o nome da opção à div progDicatipotext
				var progDicatipotextInput = document.getElementById("progDicatipotext");
				if (progDicatipotextInput.value == "") {
					progDicatipotextInput.value = selectedOptionText;
				} else {
					progDicatipotextInput.value += ", " + selectedOptionText;
				}

				// Chamando atualizaProgressBars após adicionar uma seleção
				var selectedTextValues = progDicatipotextInput.value; // Alteração aqui
				atualizaProgressBars(selectedTextValues); // Alteração aqui

				// Resetando o valor do select
				document.getElementById("progDicatiposelect").value = "766f69643132333435366964";
			}

			function carregaBody(){
				$(document).ready(function() {
					// Inicializa o Select2
					const $select = $('#usuarioEmpresaselect').select2({
						width: '100%',
						placeholder: 'Escolha as empresas...',
						allowClear: true,
						closeOnSelect: false
					});

					// 👉 Evento: quando seleciona algo
					$select.on('change', function(e) {
						const valores = $(this).val() || [];

						// Se "Acesso total" for selecionado
						if (valores.includes('Total')) {
							// Desmarca todas as outras opções e mantém só "Total"
							$(this).val(['Total']).trigger('change.select2');
						}
					});

					// 👉 Botão "Selecionar tudo"
					$('#selectAllEmpresas').on('click', function() {
						const allValues = [];
						$('#usuarioEmpresaselect option').each(function() {
							if ($(this).val() !== 'Total') {
								allValues.push($(this).val());
							}
						});
						$select.val(allValues).trigger('change.select2');
					});

					// 👉 Botão "Limpar"
					$('#clearEmpresas').on('click', function() {
						$select.val(null).trigger('change.select2');
					});
				});
			}
		</script>
	</head>

