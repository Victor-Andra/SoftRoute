<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8" />
        <title>Login - Bem Vindos!</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <style>
            /* Reset básico */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            /* Fundo completo */
            body {
                width: 100vw;
                min-height: 100vh;
                background-image: url("../images/papelparede/temaLogin.png");
                background-repeat: no-repeat;
                background-position: center center;
                background-attachment: fixed;
                background-size: cover;
                font-family: 'Segoe UI', sans-serif;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            /* Container dos campos */
            .login-form {
                background: rgba(255, 255, 255, 0.9);
                padding: 30px;
                border-radius: 16px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
                width: 100%;
                max-width: 400px;
            }

            h1 {
                text-align: center;
                color: #006b4e;
                margin-bottom: 20px;
                font-size: 1.8em;
            }

            .form-group {
                margin-bottom: 18px;
            }

            label {
                display: block;
                margin-bottom: 6px;
                font-weight: 600;
                color: #333;
            }

            input,
            select {
                width: 100%;
                padding: 10px;
                border: 1px solid #ccc;
                border-radius: 8px;
                font-size: 1em;
                height: 40px;
            }

            button {
                width: 100%;
                padding: 12px;
                background-color: #28a745;
                color: white;
                border: none;
                border-radius: 8px;
                font-size: 1.1em;
                font-weight: bold;
                cursor: pointer;
                margin-top: 10px;
            }

            button:hover {
                background-color: #218838;
            }

            .forgot-btn {
                background-color: #ddd;
                border: none;
                border-radius: 10px;
                padding: 10px 20px;
                color: #333;
                font-weight: 500;
                margin-top: 15px;
                transition: background-color 0.3s;
            }

            .forgot-btn:hover {
                background-color: #ccc;
            }
        </style>
    </head>
    <body>
        <div class="login-form">
            <div class="login-box">
                <div class="logo">
                    <h1>
                        <i class="fa fa-puzzle-piece pink"></i>
                        <span class="red">Soft</span>
                        <span class="grey" id="id-text2">Route</span>
                    </h1>
                </div>

                <h5 class="header blue lighter bigger" style="text-align: center;">
                    <b>Bem-vindo!</b> Faça seu login
                </h5>

                <form action="/menu/loginDB" method="post">
                    <div class="form-group" hidden>
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" value="{{email}}" />
                    </div>

                    <div class="form-group" hidden>
                        <label for="senha">Senha</label>
                        <input type="password" id="senha" name="senha" value="{{senha}}" />
                    </div>

                    <div class="form-group">
                        <label for="Base" style="text-align: center;">Selecione uma organização:</label>
                        <select id="dbEscolhida" name="dbEscolhida" data-placeholder="Escolha...">
                            {{#each empresas}}
                                <option value="{{empresa_chavedb}}">{{empresa_fantasia}}</option>
                            {{/each}}
                        </select>
                    </div>

                    <button type="submit">
                        <i class="fa fa-key"></i> Entrar
                    </button>
                </form>
            </div>
        </div>
    </body>
</html>