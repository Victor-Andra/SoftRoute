		<style>
		.textarea {
			width: 100%;
			box-sizing: border-box;
			font-size: 12px;
		}
		/* Quebra de lçinha e palavras quando esta dentro do span */
		/* Substitua o seletor global por uma classe específica */
			span.quebra-texto {
				word-wrap: break-word;
				word-break: break-word;
				white-space: normal;
				display: inline-block;
				overflow-wrap: break-word;
			}
		</style>
		<script>
			function carregaBody(){
    
				// 🔧 Helper interna: atualiza um campo e, se for select com Chosen, dispara a atualização da UI
				function atualizaCampo(idDestino, idOrigem, ehChosen = false) {
					const origem = document.getElementById(idOrigem);
					const destino = document.getElementById(idDestino);
					
					if (!origem || !destino) {
						console.warn(`Campos não encontrados: origem="${idOrigem}", destino="${idDestino}"`);
						return;
					}
					
					destino.value = origem.value;
					
					// ✅ Verifica 'select2' e dispara evento correto
					if (ehSelect2 && typeof $ !== 'undefined' && $(destino).hasClass('select2')) {
						setTimeout(() => {
							// Select2 escuta o evento 'change' para atualizar a UI
							$(destino).trigger('change');
						}, 50);
					}
				}
				
				// 🔧 Helper específica para campos que precisam de split (ex: empresaids)
				function atualizaCampoComSplit(idDestino, idOrigem, separador = ',', indice = 0, ehChosen = false) {
					const origem = document.getElementById(idOrigem);
					const destino = document.getElementById(idDestino);
					
					if (!origem || !destino) {
						console.warn(`Campos não encontrados: origem="${idOrigem}", destino="${idDestino}"`);
						return;
					}
					
					const valorBruto = origem.value;
					const valorFinal = valorBruto ? valorBruto.split(separador)[indice] : '';
					destino.value = valorFinal;
					
					if (ehChosen && typeof $ !== 'undefined' && $(destino).hasClass('chosen-select')) {
						setTimeout(() => {
							if ($(destino).data('chosen') || $(destino).next('.chosen-container').length) {
								$(destino).trigger('chosen:updated');
							}
						}, 50);
					}
				}
				
				// 📋 Dados básicos (campos de texto simples)
				atualizaCampo('usuarioFilhosQt', 'usuFilhosQt');
				
				// 📋 Selects simples (com Chosen)
				atualizaCampo('usuarioFilhos', 'usuFilhos', true);
				atualizaCampo('usuarioPerfilid', 'usuPerfilId', true);
				atualizaCampo('usuarioContaTipo', 'usuContaTipo', true);
				atualizaCampo('usuarioTipoPix', 'usuTipoPix', true);
				atualizaCampo('usuarioContrato', 'usuContrato', true);
				atualizaCampo('usuarioEscolaridade', 'usuEscolaridade', true);
				atualizaCampo('usuarioAba', 'usuAba', true);
				
				// 📋 Função (select com Chosen + largura customizada)
				atualizaCampo('usuarioFuncaoid', 'usuFuncaoId', true);
				
				// 📋 Empresa (precisa de split, pois pode vir como lista)
				atualizaCampoComSplit('usuarioEmpresaid', 'usuempresaids', ',', 0, true);
				
				// 📋 UF (select de estados)
				atualizaCampo('usuarioEnduf', 'usuUFId', true);
				
				// 📋 Campos de texto/textarea da escolaridade
				atualizaCampo('usuarioEscolaridadeobs', 'usuEscolaridadeobs');
				
				// 📋 Campos hidden que armazenam valores dos checkboxes (graduacao, especializacao, etc)
				// Estes NÃO são selects, então não precisam de Chosen
				atualizaCampo('usuarioGraduacao', 'usuGraduacao');
				atualizaCampo('usuarioEspecializacao', 'usuEspecializacao');
				atualizaCampo('usuarioMetodo', 'usuMetodo');
				atualizaCampo('usuarioMetout', 'usuMetout');
				
				// ✅ Log de conclusão (útil para debug)
				console.log('✅ carregaBody: campos populados com sucesso');
			}
			
			function carregarImagem() {
				var preview = document.getElementById('previewImage');
				var fileInput = document.getElementById('usuarioCarimbo');

				if (fileInput.files && fileInput.files[0]) {
					var reader = new FileReader();

					reader.onload = function (e) {
						preview.src = e.target.result;
						document.getElementById('previewCarimbo').style.display = 'block'; // Exibe a div
					};

					reader.readAsDataURL(fileInput.files[0]);
				}
			}
			
			// Função para preencher os checkboxes ao carregar a página
			function preencherCheckboxes() {
				preencherCheckbox('usuarioGraduacaoOp', 'usuarioGraduacao');
				preencherCheckbox('usuarioEspecializacaoOp', 'usuarioEspecializacao');
				preencherCheckbox('usuarioMetodoOp', 'usuarioMetodo');
				preencherCheckbox('usuarioMetoutOp', 'usuarioMetout');
			}

			function preencherCheckbox(nomeCheckbox, nomeCampoTexto) {
				var campoTexto = document.getElementById(nomeCampoTexto);
				if (!campoTexto) {
					console.warn('Campo não encontrado:', nomeCampoTexto);
					return;
				}
				var checkboxes = document.getElementsByName(nomeCheckbox);
				var valoresSelecionados = campoTexto.value ? campoTexto.value.split(';').filter(v => v) : [];
				
				Array.from(checkboxes).forEach(function(checkbox) {
					checkbox.checked = valoresSelecionados.includes(checkbox.value);
				});
			}

			// Adiciona eventos change aos checkboxes
			function adicionarEventosChange(nomeCheckbox, nomeCampoTexto) {
				var checkboxes = document.getElementsByName(nomeCheckbox);

				checkboxes.forEach(function(checkbox) {
				checkbox.addEventListener('change', function() {
					atualizarCampoTexto(nomeCheckbox, nomeCampoTexto);
				});
				});
			}

			// Função para atualizar o valor do input text com base nas seleções
			function atualizarCampoTexto(nomeCheckbox, nomeCampoTexto) {
				var checkboxes = document.getElementsByName(nomeCheckbox);

				// Obtém todos os checkboxes marcados
				var selectedCheckboxes = Array.from(checkboxes).filter(function(checkbox) {
				return checkbox.checked;
				});

				// Obtém os valores dos checkboxes marcados
				var selectedValues = selectedCheckboxes.map(function(checkbox) {
				return checkbox.value;
				});

				// Atualiza o valor do input text com os valores separados por ';'
				document.getElementById(nomeCampoTexto).value = selectedValues.join(';');
			}

			// Adiciona eventos change aos checkboxes
			adicionarEventosChange('usuarioGraduacaoOp', 'usuarioGraduacao');
			adicionarEventosChange('usuarioEspecializacaoOp', 'usuarioEspecializacao');
			adicionarEventosChange('usuarioMetodoOp', 'usuarioMetodo');
			adicionarEventosChange('usuarioMetoutOp', 'usuarioMetout');

			// Chama a função para preencher os checkboxes ao carregar a página
			preencherCheckboxes();

			

			function atualizarCamposTexto(nomeCheckbox, nomeCampoTexto) {
				var checkboxes = document.getElementsByName(nomeCheckbox);
				var selectedCheckboxes = Array.from(checkboxes).filter(function (checkbox) {
					return checkbox.checked;
				});
				var selectedValues = selectedCheckboxes.map(function (checkbox) {
					return checkbox.value;
				});
				document.getElementById(nomeCampoTexto).value = selectedValues.join(';');
			}

			function validarFormulario() {
				var usuarioCarimboInput = document.getElementById("usuarioCarimbo");
				if (usuarioCarimboInput.files.length === 0) {
					alert("Selecione uma imagem para o carimbo!");
					return false; // Impede o envio do formulário
				}
				return true; // Permite o envio do formulário
			}
			function submeterFormulario(){
				document.getElementById("previewImage").remove();
				let form = document.getElementById("formUsuarioAdd");
				form.submit();
			}
		</script>
