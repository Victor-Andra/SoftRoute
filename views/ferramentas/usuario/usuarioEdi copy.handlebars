				alert('Selecione pelo menos uma funcionalidade.');
				return;
			}
			checkboxes.forEach(cb => {
				const row = cb.closest('tr');
				const select = row.querySelector('select[name^="permissoes"]');
				if (select) select.value = tipo;
			});
		}

		// Marcar/desmarcar todos POR EMPRESA
		document.addEventListener('change', function(e) {
			if (e.target.classList.contains('check-all')) {
				const empId = e.target.dataset.empresaId;
				document.querySelectorAll(`.perm-checkbox[data-empresa-id="${empId}"]`)
					.forEach(cb => cb.checked = e.target.checked);
			}
		});	
		
			// Helper para atualizar select + Chosen
			function atualizaSelectComChosen(idSelect, idOrigem) {
				const valor = document.getElementById(idOrigem).value;
				const select = document.getElementById(idSelect);
				if (select) {
					select.value = valor;
					// Se o Chosen estiver inicializado, atualiza a UI
					if ($(select).hasClass('chosen-select') && $(select).data('chosen')) {
						$(select).trigger('chosen:updated');
					}
				}
			}
			// Antes: document.querySelector('#permiss form')
			// Depois:
			document.getElementById('formPermissoes').addEventListener('submit', function(e) {
				const selects = this.querySelectorAll('select[name^="permissoes"]');
				selects.forEach(select => {
					const name = select.name;
					const value = select.value;
					let hidden = this.querySelector(`input[name="${name}"]`);
					if (!hidden) {
						hidden = document.createElement('input');
						hidden.type = 'hidden';
						hidden.name = name;
						this.appendChild(hidden);
					}
					hidden.value = value;
				});
			});
			// Após carregar a página, inicialize o Chosen apenas para a tab ativa
			$(document).ready(function() {
								
				// Quando mudar de tab, inicializa o Chosen nos novos elementos
				$('#myTab a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
					const targetTab = $(e.target).attr('href');
					$(targetTab + ' .chosen-select').each(function() {
						if (!$(this).data('chosen')) {
							$(this).chosen({ width: '100%' });
							// Se já tiver valor, força atualização
							$(this).trigger('chosen:updated');
						}
					});
				});
			});
			</script>
	</body>
</html>