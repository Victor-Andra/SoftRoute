<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Terapia</title>
	</head>
	<body onload="javascript:controlaNave();" class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Terapia Cadastro</li>
						</ul><!-- /.breadcrumb -->
					</div>
					<div class="row">
						<div class="col-xs-12">
							<form class="form-horizontal" role="form" action="/menu/ferramentas/terapia/add" method="POST">
								<div class="col-sm-12"><!-- Widget Dados Básicos -->
									<div class="widget-box">
										<div class="widget-header">
											<h4 class="widget-title">Dados Básicos</h4>
											<span class="widget-toolbar">
												<a href="#" data-action="reload">
													<i class="ace-icon fa fa-refresh"></i>
												</a>
												<a href="#" data-action="collapse">
													<i class="ace-icon fa fa-chevron-up"></i>
												</a>
											</span>
										</div>
										<div class="widget-body">
											<div class="widget-main">
												<label > Terapia </label>
												<div class="form-group">
													<div class="col-sm-6">
														<input type="text" name="terapiaNome"  id="terapiaNome" placeholder="" class="form-control" />
													</div>
												</div>
												<label > Nome da Terapia para o Convênio</label>
												<div class="form-group">
													<div class="col-sm-6">
														<select name="terapiaNomeCid" id="terapiaNomeCid" class="form-control select2" data-search="true" data-placeholder="Escolha...">
															<option value="Não Informado">Não Informado</option>
															<option value="ARTETERAPIA">ARTETERAPIA</option>
															<option value="ABA">ABA</option>
															<option value="AVALIAÇÃO">AVALIAÇÃO</option>
															<option value="FISIOTERAPIA">FISIOTERAPIA</option>
															<option value="FONOAUDIOLOGIA">FONOAUDIOLOGIA</option>
															<option value="JUDÔ">JUDÔ</option>
															<option value="MUSICOTERAPIA">MUSICOTERAPIA</option>
															<option value="NUTRIÇÃO">NUTRIÇÃO</option>
															<option value="PSICOLOGIA">PSICOLOGIA</option>
															<option value="PSICOMOTRICIDADE">PSICOMOTRICIDADE</option>
															<option value="PSICOMOTRICIDADE FUNCIONAL">PSICOMOTRICIDADE FUNCIONAL</option>
															<option value="PSICOMOTRICIDADE RELACIONAL">PSICOMOTRICIDADE RELACIONAL</option>
															<option value="PSICOPEDAGOGIA">PSICOPEDAGOGIA</option>
															<option value="TCC">TCC</option>
															<option value="TERAPIA AQUATICA">TERAPIA AQUÁTICA</option>
															<option value="TO AVD">TO AVD</option>
															<option value="TO IS">TO IS</option>
														</select>
													</div>
												</div>
												<label > CID</label>
												<div class="form-group">
													<div class="col-sm-3">
														<input type="text" name="terapiaCid" id="terapiaCid" placeholder="" class="form-control" />
													</div>
												</div>
												 <!-- Campo: Nome para exibir em relatórios -->
												
												 <label>Nome em Relatórios</label>
												<div class="form-group">
													<div class="col-sm-6">
														<input type="text" id="terapiaNomesnorelatorio" name="terapiaNomesnorelatorio" class="form-control" placeholder="Ex: Terapia Ocupacional focada em AVD" />
													</div>
												</div>

												<label > Descrição </label>
												<div class="form-group">
													<div class="col-sm-12">
														<input type="text" name="terapiaDescricao" placeholder="" class="form-control" />
													</div>
												</div>
												<label>Status</label>
												<div class="form-group">
													<div class="col-sm-4">
														<select name="terapiaStatus" id="terapiaStatus" class="form-control select2" data-search="true" data-placeholder="Escolha...">
															<option value="-">Não informado</option>
															<option value="Ativo">Ativo</option>
															<option value="Inativo">Inativo</option>
														</select>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
								<div class="space-4">
								</div>
								<div class="form-actions">
									<div class="col-md-offset-3 col-md-9">
										<button class="btn btn-info"  name="acao" type="submit">
											<i class="ace-icon fa fa-check bigger-110"></i>
											Salvar
										</button>
										&nbsp; &nbsp; &nbsp;
										<button class="btn btn-warning"  type="reset">
											<i class="ace-icon fa fa-undo bigger-110"></i>
											Cancelar
										</button>
									</div>
								</div>
							</form>
						</div><!-- /.col -->
					</div><!-- /.row -->
				</div>
			</div><!-- /.main-container-->
		</div><!-- /.main-container ace-save-state -->
		<script>
$(function() {
  if (typeof $.fn.select2 === 'function') {
    $('.select2').each(function() {
      var $this = $(this);
      
      // ✅ Respeita data-search="true" OU data-search="false"
      var forceSearch = $this.data('search'); // undefined, true, ou false
      var minSearch;
      
      if (forceSearch === true) {
        minSearch = 0; // força busca
      } else if (forceSearch === false) {
        minSearch = Infinity; // desativa busca mesmo com muitas opções
      } else {
        // comportamento padrão: só ativa busca se ≥8 opções
        minSearch = $this.find('option').length >= 8 ? 0 : Infinity;
      }

      $this.select2({
        width: '100%',
        placeholder: $this.data('placeholder') || 'Selecione...',
        allowClear: false,
        minimumResultsForSearch: minSearch
      });
    });
  }
});
</script>
	</body>
</html>