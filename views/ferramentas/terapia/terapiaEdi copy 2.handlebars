				</div>
			</div><!-- /.main-content -->


		</div><!-- /.main-container -->

		<!-- Variáveis para carregar valores do banco -->
				<!-- Variáveis para carregar valores do banco -->
		<script>
	$(document).ready(function() {
		// 1. Captura os valores do Handlebars de forma segura
		var nomeCid = "{{terapia.terapia_nomecid}}";
		var status = "{{terapia.terapia_status}}";
		
		console.log("[DEBUG] Valores recebidos:", { nomeCid, status });

		// 2. Função segura para atualizar o select sem quebrar a página
		function atualizarSelectSeguro(idElemento, valor) {
			var $select = $('#' + idElemento);
			
			// Se o elemento não existir, sai da função sem dar erro
			if ($select.length === 0) {
				console.warn("[DEBUG] Elemento #" + idElemento + " não encontrado.");
				return;
			}

			// Define o valor no HTML padrão
			$select.val(valor);
			console.log("[DEBUG] Valor bruto definido no #" + idElemento + ": " + valor);

			// 3. Tenta atualizar a interface gráfica (Select2 ou Chosen)
			if ($.fn.select2) {
				$select.trigger('change.select2');
				console.log("[DEBUG] Select2 atualizado para #" + idElemento);
			} else if ($.fn.chosen) {
				$select.trigger('chosen:updated');
				console.log("[DEBUG] Chosen atualizado para #" + idElemento);
			} else {
				console.log("[DEBUG] Nenhum plugin de select detectado, usando padrão HTML.");
			}
		}

		// 4. Aplica a atualização apenas se o valor for válido
		if (nomeCid && nomeCid !== 'null' && nomeCid !== 'undefined' && nomeCid.trim() !== '') {
			atualizarSelectSeguro('terapiaNomeCid', nomeCid);
		}

		if (status && status !== 'null' && status !== 'undefined' && status.trim() !== '') {
			atualizarSelectSeguro('terapiaStatus', status);
		}
	});
</script>

	</body>
</html>