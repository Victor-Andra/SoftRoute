<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Editar Terapia</title>
    <!-- CSS será inserido aqui na Parte 2 -->
	<style>
		/* Integração Select2 com Ace Admin */
.select2-container .select2-selection--single {
    border: 1px solid #ced4da !important;
    border-radius: 4px !important;
    box-shadow: none !important;
    background: white !important;
    height: 30px !important;
    line-height: 30px !important;
}

.select2-container .select2-selection--single .select2-selection__rendered {
    line-height: 28px !important;
    padding-left: 10px !important;
    color: #333 !important;
}

.select2-container .select2-selection--single .select2-selection__arrow {
    height: 28px !important;
}

.select2-container--default .select2-selection--single .select2-selection__placeholder {
    color: #999 !important;
}

.select2-container .select2-selection--single:hover,
.select2-container--default.select2-container--open .select2-selection--single {
    border-color: #5bc0de !important;
}

.select2-dropdown {
    border: 1px solid #ced4da !important;
    border-top: none !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1) !important;
    border-radius: 0 0 4px 4px !important;
}

.select2-search--dropdown .select2-search__field {
    border: 1px solid #ced4da !important;
    border-radius: 4px !important;
    padding: 4px 8px !important;
}

.select2-results__option {
    padding: 6px 10px !important;
}

/* COR AZUL CLARA NO HOVER E SELEÇÃO */
.select2-results__option--highlighted[aria-selected],
.select2-results__option:hover {
    background-color: #5bc0de !important;
    color: white !important;
}

.select2-results__option[aria-selected="true"] {
    background-color: #d9edf7 !important;
    color: #31708f !important;
}

.form-group .select2-container {
    width: 100% !important;
}
	</style>
</head>

<body onload="javascript:controlaNave();" class="no-skin">

    <div class="main-container ace-save-state" id="main-container">
        <div class="main-content">
            <div class="main-content-inner">
                <!-- Breadcrumbs -->
                <div class="breadcrumbs ace-save-state" id="breadcrumbs">
                    <ul class="breadcrumb">
                        <li>
                            <i class="ace-icon fa fa-home home-icon"></i>
                            <a href="/menu/ferramentas/terapia/lis">Terapias</a>
                        </li>
                        <li class="active">Editar Terapia</li>
                    </ul>
                </div>

                <div class="row">
                    <div class="col-xs-12">
						<!-- PAGE CONTENT BEGINS -->
                        <form class="form-horizontal" role="form" action="/menu/ferramentas/terapia/atualizar" method="POST" id="formTerapia">
                            <div class="col-sm-12"><!-- Widget Dados Básicos -->
								<!-- Widget: Dados Básicos -->
								<div class="widget-box">
									<div class="widget-header">
										<h4 class="widget-title">Dados Básicos</h4>
										<span class="widget-toolbar">
											<a href="#" data-action="collapse">
												<i class="ace-icon fa fa-chevron-up"></i>
											</a>
										</span>
									</div>

									<div class="widget-body">
										<div class="widget-main">
											
											<!-- Campo: Nome da Terapia -->
											<div class="form-group">
												<label class="col-sm-2 control-label no-padding-right" for="terapiaNome">Terapia</label>
												<div class="col-sm-6">
													<input type="text" id="terapiaNome" name="terapiaNome" class="form-control" placeholder="Ex: Psicologia" value="{{terapia.terapia_nome}}" required />
												</div>
											</div>

											<!-- Campo: Terapia Nome CID / Convênio (Select2) -->
											<div class="form-group">
												<label class="col-sm-2 control-label no-padding-right" for="terapiaNomeCid">Nome CID / Convênio</label>
												<div class="col-sm-6">
													<select name="terapiaNomeCid" id="terapiaNomeCid" class="form-control select2">
														<option value="">Selecione...</option>
														<option value="ARTETERAPIA">ARTETERAPIA</option>
														<option value="ABA">ABA</option>
														<option value="AVALIAÇÃO">AVALIAÇÃO</option>
														<option value="FISIOTERAPIA">FISIOTERAPIA</option>
														<option value="FONOAUDIOLOGIA">FONOAUDIOLOGIA</option>
														<option value="JUDÔ">JUDÔ</option>
														<option value="MUSICOTERAPIA">MUSICOTERAPIA</option>
														<option value="NUTRIÇÃO">NUTRIÇÃO</option>
														<option value="PSICOLOGIA">PSICOLOGIA</option>
														<option value="PSICOMOTRICIDADE">PSICOMOTRICIDADE</option>
														<option value="PSICOMOTRICIDADE FUNCIONAL">PSICOMOTRICIDADE FUNCIONAL</option>
														<option value="PSICOMOTRICIDADE RELACIONAL">PSICOMOTRICIDADE RELACIONAL</option>
														<option value="PSICOPEDAGOGIA">PSICOPEDAGOGIA</option>
														<option value="TCC">TCC</option>
														<option value="TERAPIA AQUATICA">TERAPIA AQUÁTICA</option>
														<option value="TO AVD">TO AVD</option>
														<option value="TO IS">TO IS</option>
													</select>
												</div>
											</div>

											<!-- Campo: CID -->
											<div class="form-group">
												<label class="col-sm-2 control-label no-padding-right" for="terapiaCid">CID</label>
												<div class="col-sm-3">
													<input type="text" id="terapiaCid" name="terapiaCid" class="form-control" placeholder="Ex: F84.0" value="{{terapia.terapia_cid}}" />
												</div>
											</div>
											
											<!-- Campo: Descrição -->
											<div class="form-group">
												<label class="col-sm-2 control-label no-padding-right" for="terapiaDescricao">Descrição</label>
												<div class="col-sm-10">
													<textarea id="terapiaDescricao" name="terapiaDescricao" class="form-control" rows="3" placeholder="Descreva detalhes da terapia...">{{terapia.terapia_descricao}}</textarea>
												</div>
											</div>

											<!-- Campo: Status (Select2) -->
											<div class="form-group">
												<label class="col-sm-2 control-label no-padding-right" for="terapiaStatus">Status</label>
												<div class="col-sm-4">
													<select name="terapiaStatus" id="terapiaStatus" class="form-control select2">
														<option value="">Selecione...</option>
														<option value="Ativo">Ativo</option>
														<option value="Inativo">Inativo</option>
													</select>
												</div>
											</div>

											<!-- Campo Oculto: ID da Terapia -->
											<input type="hidden" name="terapiaId" value="{{terapia._id}}" />

											<!-- 
												INPUTS HIDDEN para consumo pelo carregaValoresForm()
												Esses campos NÃO são enviados ao backend (name vazio ou fora do form principal)
												mas servem como "ponte" entre o Handlebars e o JavaScript
											-->
											<input type="hidden" id="hidTerapiaNomeCid" value="{{terapia.terapia_nomecid}}" />
											<input type="hidden" id="hidTerapiaStatus" value="{{terapia.terapia_status}}" />

										</div>
									</div>
								</div>
								<!-- Fim do Widget -->

								<div class="space-4"></div>

								<!-- Ações do Formulário -->
								<div class="clearfix form-actions">
									<div class="col-md-offset-2 col-md-9">
										<button class="btn btn-info" name="acao" type="submit">
											<i class="ace-icon fa fa-check bigger-110"></i>
											Salvar
										</button>
										&nbsp; &nbsp; &nbsp;
										<a class="btn btn-warning" href="/menu/ferramentas/terapia/lis">
											<i class="ace-icon fa fa-undo bigger-110"></i>
											Voltar
										</a>
									</div>
								</div>
							</div>	
                        </form>
                        <!-- Fim do Formulário -->

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts serão inseridos aqui na Parte 3 -->
	<script>
    $(document).ready(function() {
        console.log('[DEBUG] $(document).ready() executando...');
        
        // 1. PRIMEIRO: Inicializa o Select2
        if ($.fn.select2) {
            $('.select2').select2({
                placeholder: 'Selecione...',
                allowClear: true,
                width: '100%'
            });
            console.log('[DEBUG] Select2 inicializado');
            
            // 2. DEPOIS: Chama a função para popular os valores
            carregaValoresForm();
            
        } else {
            console.error('[DEBUG] ERRO: Select2 não carregado');
        }
    });
</script>
</body>
</html>