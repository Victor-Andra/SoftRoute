        </div>
    </div>

    <!-- Scripts -->
    <script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
    <script type="text/javascript">
        $(document).ready(function() {
            $("#dynamic-table1").DataTable({
                "language": { "url": "/js/lang/datatable-pt-br.json" },
                "aaSorting": [],
                "responsive": true,
                "lengthMenu": [25, 50],
                "lengthChange": true,
                "autoWidth": false,
                "paging": true,
                "searching": true,
                "ordering": true,
                "info": true
            });
        });
    </script>

    <script>
        function carregaBody(){
            console.log("🚀 [carregaBody] INICIANDO formatação...");
            let dias = ["seg","ter","qua","qui","sex"];
            
            try{
                dias.forEach((dia)=>{
                    const elementos = document.getElementsByName(dia);
                    console.log(`🔍 [carregaBody] Dia ${dia}: ${elementos.length} elementos`);
                    
                    elementos.forEach((e)=>{
                        let id = "hora" + e.id;
                        let beneId = e.value;
                        let categoria = e.getAttribute('data-categoria');
                        let tempId = e.id + "_" + beneId;
                        
                        if(beneId && beneId != "766f69643132333435366964"){
                            if(e.id.indexOf("BeneId_") != -1){
                                let val = document.getElementById(beneId)?.cloneNode(true);
                                if(!val) return;
                                
                                val.id = val.id + "x";
                                
                                document.getElementsByName(tempId).forEach((ti)=>{
                                    pintaAgenda(val, categoria);
                                });
                                
                                let destino = document.getElementById(id);
                                if(destino){
                                    destino.innerHTML = '';
                                    destino.appendChild(val);
                                }
                            }
                        }
                    });
                });
                console.log("✅ [carregaBody] FINALIZADO");
            } catch(err){
                console.error("❌ ERRO em carregaBody:", err);
            }
        }

        function pintaAgenda(val, motivo){
            const coresTexto = {
                "Falta": "#ffc107",
                "Falta Justificada": "#ffc107",
                "Falta Absoluta": "#e65100",
                "Substituição": "#00bcd4",
                "Feriado": "#e65100",
                "default": "#397097"
            };
            
            const motivoKey = motivo?.trim() || "default";
            const corTexto = coresTexto[motivoKey] || coresTexto.default;
            const texto = val?.textContent?.trim() || "—";
            
            if (val) {
                val.innerHTML = '';
                const span = document.createElement('span');
                span.className = 'badge-agenda';
                span.style.cssText = `
                    color: ${corTexto} !important;
                    font-weight: ${motivoKey === "Falta Absoluta" ? "bold" : "600"};
                    ${motivoKey === "Falta Absoluta" ? "text-shadow: 0 0 1px rgba(0,0,0,0.1);" : ""}
                `;
                span.textContent = texto;
                val.appendChild(span);
            }
        }

        // Executar quando DOM estiver pronto
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(carregaBody, 200);
        });
        
        window.addEventListener('load', function() {
            setTimeout(carregaBody, 100);
        });
    </script>

    {{!-- Modal de Evoluções Pendentes --}}
    {{#if mostrarModalEvolucoes}}
        {{#ifCond evolucoesPendentesMes ">" 0}}
            <div id="modalEvolucoesPendentes" 
                style="display: none; position: fixed !important; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 999999 !important; overflow: auto;">
                <div style="display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 20px;">
                    <div style="background: rgba(255, 255, 255, 0.95); border-radius: 20px; max-width: 500px; width: 100%; box-shadow: 0 10px 40px rgba(0,0,0,0.3); overflow: hidden; backdrop-filter: blur(10px);">
                        <div style="padding: 40px 30px 20px 30px; text-align: center;">
                            <p style="font-size: 18px; color: #333; margin-bottom: 10px; font-weight: 600; line-height: 1.4;">
                                Olá! em breve vou ajudar você a lembrar de suas evoluções. Caso você esqueça!
                            </p>
                            <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 15px; padding: 20px; margin-bottom: 20px; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);">
                                <div style="font-size: 20px; font-weight: 700; line-height: 1;">
                                    {{evolucoesPendentesMes}}
                                </div>
                                <div style="font-size: 12px; margin-top: 5px; opacity: 0.9;">
                                    evolução(ões) pendente(s)
                                </div>
                            </div>
                        </div>
                        <div style="padding: 0 20px 20px 20px; text-align: center;">
                            <img src="/images/character.png" alt="Personagem" style="max-width: 150px; width: 70%; height: 50%; display: inline-block;">
                        </div>
                        <div style="padding: 15px 30px 30px 30px; text-align: center; background: rgba(248, 249, 250, 0.8);">
                            <button type="button" onclick="fecharModalEvolucoes()" 
                                    style="padding: 12px 60px; font-weight: 600; border-radius: 25px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; cursor: pointer; font-size: 16px; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); transition: transform 0.2s;">
                                <i class="ace-icon fa fa-check"></i> OK
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <script type="text/javascript">
                (function() {
                    const QUANTIDADE_PENDENTES = {{evolucoesPendentesMes}};
                    const INTERVALO_MINUTOS = 30;
                    const USUARIO_ID = '{{usuId}}';
                    const CHAVE_STORAGE = 'ultimoModalEvolucoes_' + USUARIO_ID;
                    
                    function mostrarModalAloMundo() {
                        const modal = document.getElementById('modalEvolucoesPendentes');
                        if (modal) {
                            modal.style.display = 'block';
                            localStorage.setItem(CHAVE_STORAGE, Date.now().toString());
                        }
                    }
                    
                    window.fecharModalEvolucoes = function() {
                        const modal = document.getElementById('modalEvolucoesPendentes');
                        if (modal) {
                            modal.style.display = 'none';
                        }
                    };
                    
                    document.addEventListener('click', function(event) {
                        const modal = document.getElementById('modalEvolucoesPendentes');
                        if (event.target === modal) {
                            fecharModalEvolucoes();
                        }
                    });
                    
                    if (document.readyState === 'complete' || document.readyState === 'interactive') {
                        setTimeout(mostrarModalAloMundo, 500);
                    } else {
                        document.addEventListener('DOMContentLoaded', function() {
                            setTimeout(mostrarModalAloMundo, 500);
                        });
                    }
                    
                    setInterval(function() {
                        if (QUANTIDADE_PENDENTES > 0) {
                            const ultimo = localStorage.getItem(CHAVE_STORAGE);
                            if (!ultimo) {
                                mostrarModalAloMundo();
                            } else {
                                const diffMinutos = (Date.now() - parseInt(ultimo)) / (1000 * 60);
                                if (diffMinutos >= INTERVALO_MINUTOS) {
                                    mostrarModalAloMundo();
                                }
                            }
                        }
                    }, INTERVALO_MINUTOS * 60 * 1000);
                })();
            </script>
        {{/ifCond}}
    {{/if}}
</body>
</html>