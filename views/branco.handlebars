                                                                    <i class="ace-icon fa fa-eraser bigger-130" style="color: #d15b47 !important;"></i>
                                                                </a>
                                                            {{/if}}
                                                            
                                                            <span class="tooltip-text">
                                                                <strong style="color:#c00">{{ui.tooltipTitulo}}</strong><br>
                                                                {{ui.tooltipTexto}}
                                                            </span>
                                                        </div>
                                                    </td>
                                                </tr>
                                                {{/each}}
                                            </tbody>
                                        </table>
                                        
                                        <!-- Labels Ocultos -->
                                        <div class="hidden" id="divBeneLabels">
                                            {{#each benes}}
