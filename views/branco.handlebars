                                            {{/each}}
                                        </div>

                                        <!-- Inputs para JS -->
                                        <div class="hidden" id="divBeneData">
                                            {{#each agendas}}
                                                <input name="{{agenda_data_semana}}BeneId_{{agenda_hora}}_{{agenda_beneid}}" 
                                                    value="{{agenda_beneid}}"
                                                    data-categoria="{{cadeia.ultimoCategoria}}{{#unless cadeia.ultimoCategoria}}{{agenda_categoria}}{{/unless}}">
                                            {{/each}}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Widget 2: Pontuações -->
                <div class="col-12 col-sm-12 col-md-4" name="Pontage" id="Pontage">
                    <div class="widget-box">
                        <div class="widget-header">
                            <h4 class="widget-title">
                                <i class="purple ace-icon fa fa-bullseye bigger-110"></i>
                                Pontuações na Agenda
                            </h4>
                            <span class="widget-toolbar">
                                <a href="#" data-action="collapse">
                                    <i class="ace-icon fa fa-chevron-up"></i>
                                </a>
                            </span>
                        </div>
                        <div class="widget-body">
                            <div class="widget-main">
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="col-xs-12 col-sm-12" style="padding-top: 2px;">
                                            <div class="alert alert-danger">
                                                <strong>Agenda:</strong>
