<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>SisRoute - Home</title>
    <style>
        /* ========================================================================
        🎨 TOOLTIP - COMPORTAMENTO HOVER
        ======================================================================== */
        .custom-tooltip {
            position: relative;
            display: inline-block;
            cursor: help;
            z-index: 99999 !important;
            vertical-align: middle;
        }

        .tooltip-text {
            visibility: hidden !important;
            opacity: 0 !important;
            width: max-content;
            max-width: 280px;
            background-color: #f3dfdf;
            color: #c00;
            font-size: 9px !important;
            text-align: left;
            border-radius: 4px;
            padding: 8px 10px;
            position: absolute;
            z-index: 100000 !important;
            bottom: 130%;
            left: 50%;
            transform: translateX(-50%);
            white-space: normal;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            border: 1px solid #e0b0b0;
            transition: opacity 0.2s ease, visibility 0.2s ease;
            line-height: 1.4;
            pointer-events: none !important;
        }

        .tooltip-text::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 50%;
            margin-left: -5px;
            border-width: 5px;
            border-style: solid;
            border-color: #f3dfdf transparent transparent transparent;
        }

        .custom-tooltip:hover .tooltip-text,
        .custom-tooltip:hover > .tooltip-text,
        .custom-tooltip a:hover + .tooltip-text,
        .custom-tooltip i:hover + .tooltip-text {
            visibility: visible !important;
            opacity: 1 !important;
            pointer-events: none !important;
        }

        #dynamic-table1 td:last-child {
            overflow: visible !important;
            position: static !important;
        }
        #dynamic-table1 tr {
            position: static !important;
        }

        /* ========================================================================
        🏷️ BADGE AGENDA - PADRONIZAÇÃO COMPLETA
        ======================================================================== */
        .badge-agenda {
            display: inline-block !important;
            padding: 2px 6px !important;
            font-size: 9px !important;
            font-weight: 500 !important;
            border-radius: 3px !important;
            white-space: normal !important; 
            line-height: 1.3 !important;
            vertical-align: middle !important;
            max-width: 100% !important;
            overflow: visible !important;
            text-overflow: unset !important;
        }
    </style>
    <script>
        function OcultaMsg(){
            document.getElementById("alertMsgFlash").hidden = true;
        }

        function evolucaoSemanalEmDia(id){
            window.location.href=("/menu/agenda/evolucaoTemp/"+id);
        }

        function apagarEvolucao(idAgenda) {
            if (confirm("⚠️ ATENÇÃO!\n\nVocê está prestes a apagar uma evolução registrada indevidamente em um registro de Falta Absoluta.\n\nEsta ação:\n• Irá limpar o campo de evolução\n• Irá resetar o selo de evolução\n• Será registrada com sua identificação e data/hora\n\nTem certeza que deseja continuar?")) {
                window.location.href = "/menu/agenda/apagarEvolucaobranco/" + idAgenda;
            }
        }
    </script>
</head>

<body class="no-skin" background-image="/assets/images/papelparede/temaSetembroAmarelo.png" onload="javascript:controlaNave();">
    <div class="main-container ace-save-state" id="main-container">
        <div class="main-content">
            <div class="main-content-inner">
                {{#compareString flash.sucesso "true"}}
                    <div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-success">
                        <p>
                            <strong>
                                <i class="ace-icon fa fa-check"></i>
                                {{flash.texto}}
                            </strong>
                            <button type="button" class="close" onclick="javascript:OcultaMsg()">
                                <i class="ace-icon fa fa-times"></i>
                            </button>
                        </p>
                    </div>
                {{else}}
                    {{#compareString flash.sucesso "false"}}
                        <div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">
                            <p>
                                <strong>
                                    <i class="ace-icon fa fa-times"></i>
                                    {{flash.texto}}
                                </strong>
                                <button type="button" class="close" onclick="javascript:OcultaMsg()">
                                    <i class="ace-icon fa fa-times"></i>
                                </button>
                            </p>
                        </div>
                    {{else}}
                        <div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-warning">
                            <p>
                                <strong>
                                    <i class="ace-icon fa fa-check"></i>
                                    {{flash.texto}}
                                </strong>
                                <button type="button" class="close" onclick="javascript:OcultaMsg()">
                                    <i class="ace-icon fa fa-times"></i>
                                </button>
                            </p>
                        </div>
                    {{/compareString}}
                {{/compareString}}

