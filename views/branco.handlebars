                                                                    <span class="badge-agenda" style="{{../badgeStyle}}">
                                                                        {{this.bene_nome}}
                                                                    </span>
                                                                    {{#if ../simboloAlerta}}
                                                                        <span class="custom-tooltip" style="margin-left: 3px; cursor: help;">
                                                                            <span style="font-size: 12px;">{{../simboloAlerta}}</span>
                                                                            <span class="tooltip-text">
                                                                                <strong style="color:#c00">⚠️ Atenção</strong><br>
                                                                                {{../tooltipAlerta}}
                                                                            </span>
                                                                        </span>
                                                                    {{/if}}
                                                                </label>
                                                            {{/ifEqual}}
                                                        {{/each}}
                                                    </td>
                                                    
                                                    <!-- Ação com tooltip (COM SUPORTE A BORRACHA) -->
                                                    <td class="text-center" style="vertical-align: middle; width: 70px;">
                                                        <div class="custom-tooltip">
                                                            {{#if ui.temLink}}
                                                                <a href="javascript:evolucaoSemanalEmDia('{{_id}}');">
                                                                    <i class="ace-icon fa fa-{{ui.icone}} bigger-130"></i>
                                                                </a>
                                                            {{else}}
                                                                <i class="ace-icon fa fa-{{ui.icone}} bigger-130"></i>
                                                            {{/if}}
                                                            
                                                            {{#if temEvolucaoIndevida}}
