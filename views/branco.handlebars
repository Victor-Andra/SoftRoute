                                                    <th style="width: 70px;">Sala</th>
                                                    <th style="width: 12px;">Terapia</th>
                                                    <th>Beneficiário</th>
                                                    <th style="width: 70px;">Evoluir</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {{#each agendas}}
                                                <tr role="row" class="odd">
                                                    <td>{{agenda_hora}}</td>
                                                    
                                                    <td>
                                                        {{#each ../salas}}
                                                            {{#ifEqual this._id ../agenda_salaid}}{{sala_nome}}{{/ifEqual}}
                                                        {{/each}}
                                                    </td>
                                                    
                                                    <td>
                                                        {{#each ../terapias}}
                                                            {{#ifEqual this._id ../agenda_terapiaid}}{{terapia_nomecid}}{{/ifEqual}}
                                                        {{/each}}
                                                    </td>

                                                    <!-- Beneficiário (COM SÍMBOLO DE ALERTA) -->
