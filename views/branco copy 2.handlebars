<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>SisRoute - Home</title>
		<style>
			/* ========================================================================
		📋 TABELAS - FONTE PADRÃO 11px PARA TODAS AS TABELAS
		======================================================================== */

		/* 👉 REGRA GERAL: Todas as tabelas na view branco.hbs */
		.table,
		table,
		.dataTable,
		.dataTables_wrapper {
			font-size: 11px !important;
			line-height: 1.3 !important;
		}

		/* Células e cabeçalhos */
		.table td,
		.table th,
		table td,
		table th,
		.dataTable td,
		.dataTable th {
			font-size: 11px !important;
			line-height: 1.3 !important;
			vertical-align: middle !important;
			padding: 4px 6px !important;
		}

		/* Cabeçalhos em negrito */
		.table th,
		table th,
		.dataTable th {
			font-weight: 600 !important;
			background-color: #f5f5f5 !important;
		}

		/* DataTables específico (se usar plugin) */
		.dataTables_wrapper .dataTables_info,
		.dataTables_wrapper .dataTables_paginate,
		.dataTables_wrapper .dataTables_length,
		.dataTables_wrapper .dataTables_filter {
			font-size: 11px !important;
		}

		.dataTables_wrapper .dataTables_filter input {
			font-size: 11px !important;
			height: 26px !important;
			padding: 2px 6px !important;
		}

		/* 👉 Tabela específica #dynamic-table1 (mantém regras específicas) */
		#dynamic-table1 {
			font-size: 11px !important;
		}

		#dynamic-table1 td:last-child,
		#dynamic-table1 th:last-child {
			width: 50px !important;
			text-align: center !important;
		}

		#dynamic-table1 td:nth-child(5) {
			white-space: nowrap !important;
			max-width: 150px !important;
			overflow: hidden !important;
			text-overflow: ellipsis !important;
		}

		/* Evitar quebra de linha em células de ação */
		#dynamic-table1 td:last-child {
			white-space: nowrap !important;
		}

		/* ========================================================================
		🎨 TOOLTIP E ÍCONES (CORRIGIDO PARA FUNCIONAR DENTRO DE TABELAS)
		======================================================================== */

		/* 👉 CONTAINER DO TOOLTIP */
		.custom-tooltip {
			position: relative;
			display: inline-block;
			cursor: help;
			z-index: 99999 !important;  /* ← Aumentado pra garantir prioridade */
			vertical-align: middle;
		}

		.custom-tooltip a,
		.custom-tooltip i {
			display: inline-block;
			position: relative;
			z-index: 2;
			pointer-events: auto;
		}

		/* 👉 CAIXA DO TOOLTIP (com ajustes de posicionamento) */
		.tooltip-text {
			visibility: hidden;
			width: max-content;
			max-width: 280px;
			background-color: #f3dfdf;
			color: #c00;
			font-size: 9px !important;
			text-align: left;
			border-radius: 4px;
			padding: 8px 10px;
			position: absolute;
			z-index: 100000 !important;  /* ← Bem alto pra ficar por cima de tudo */
			bottom: 130%;
			left: 50%;
			transform: translateX(-50%);
			opacity: 0;  /* ← Começa invisível (mais suave que 0.95) */
			white-space: normal;
			box-shadow: 0 4px 10px rgba(0,0,0,0.2);
			border: 1px solid #e0b0b0;
			transition: opacity 0.2s ease, visibility 0.2s ease;
			line-height: 1.4;
			pointer-events: none !important;
		}

		/* Seta do tooltip */
		.tooltip-text::after {
			content: "";
			position: absolute;
			top: 100%;
			left: 50%;
			margin-left: -5px;
			border-width: 5px;
			border-style: solid;
			border-color: #f3dfdf transparent transparent transparent;
			z-index: 100001;  /* ← Seta acima do tooltip */
		}

		/* 👉 HOVER: Mostra o tooltip com transição suave */
		.custom-tooltip:hover .tooltip-text,
		.custom-tooltip i:hover + .tooltip-text,
		.custom-tooltip a:hover + .tooltip-text {
			visibility: visible !important;
			opacity: 1 !important;
			pointer-events: none !important;
			z-index: 100000 !important;
		}

		/* ========================================================================
		🔧 CORREÇÃO CRÍTICA: PERMITIR TOOLTIP "VAZAR" DA CÉLULA DA TABELA
		======================================================================== */

		/* 👉 Célula de ação (última coluna) e coluna 5: permitir overflow */
		#dynamic-table1 td:last-child,
		#dynamic-table1 td:nth-child(5) {
			overflow: visible !important;      /* ← Permite tooltip sair da célula */
			position: static !important;       /* ← Evita stacking context indesejado */
			z-index: auto !important;          /* ← Não cria novo contexto de empilhamento */
		}

		/* 👉 Garante que a linha da tabela também não corte o tooltip */
		#dynamic-table1 tr {
			position: static !important;
			z-index: auto !important;
		}

		/* 👉 Se usar tbody com overflow, libera também */
		#dynamic-table1 tbody {
			overflow: visible !important;
		}

		/* ========================================================================
		🎨 ÍCONES (mantido + pequenos ajustes)
		======================================================================== */

		#dynamic-table1 .ace-icon.fa {
			font-size: 1.25em !important;
			vertical-align: middle !important;
			line-height: 1 !important;
			display: inline-block !important;
		}

		#dynamic-table1 .fa.fa-ban {
			color: #d65959 !important;
		}

		#dynamic-table1 a.blue .fa.fa-pencil {
			color: #2083c5 !important;
		}

		#dynamic-table1 a.blue .fa.fa-pencil:hover {
			color: #1c6ca1 !important;
		}

		#dynamic-table1 .fa.fa-pencil {
			color: #999 !important;
			cursor: default !important;
		}

		/* ========================================================================
		🏷️ BADGES E CORES DO BENEFICIÁRIO
		======================================================================== */

		.badge-ok {
			background-color: #8bc34a !important;
			color: #fff !important;
			padding: 2px 8px !important;
			border-radius: 12px !important;
			font-size: 10px !important;
			font-weight: bold !important;
			vertical-align: middle !important;
			display: inline-flex !important;
			align-items: center !important;
			min-width: 24px !important;
		}

		.badge-agenda {
			display: inline-block;
			padding: 2px 6px;
			font-size: 9px;
			font-weight: 500;
			border-radius: 3px;
			white-space: nowrap;
			line-height: 1.3;
		}

		.bene-default { color: #397097 !important; font-weight: normal; }
		.bene-orange-light { color: #ff9800 !important; font-weight: 500; }
		.bene-orange { color: #e65100 !important; font-weight: bold; }
		.bene-cyan { color: #00bcd4 !important; font-weight: 600; }
		.bene-yellow { color: #ffc107 !important; font-weight: 600; }
		</style>
		<script>
			function OcultaMsg(){
				document.getElementById("alertMsgFlash").hidden = true;
			}

			function obterMesAtual() {
				const dataAtual = new Date();
				const mesAtual = dataAtual.getMonth() + 1;
				return mesAtual;
			}

			function evolucaoSemanalEmDia(id){
				window.location.href=("/menu/agenda/evolucaoTemp/"+id);
			}
		</script>
	</head>
	
	<body class="no-skin" background-image="/assets/images/papelparede/temaLoginCopa2026.jpeg" onload="javascript:controlaNave();obterMesAtual();">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					{{#compareString flash.sucesso "true"}}
						<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-success">
							<p>
								<strong>
									<i class="ace-icon fa fa-check"></i>
									{{flash.texto}}
								</strong>
								<button type="button" class="close" onclick="javascript:OcultaMsg()">
									<i class="ace-icon fa fa-times"></i>
								</button>
							</p>
						</div>
					{{else}}
						{{#compareString flash.sucesso "false"}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">
								<p>
									<strong>
										<i class="ace-icon fa fa-times"></i>
										{{flash.texto}}
									</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()">
										<i class="ace-icon fa fa-times"></i>
									</button>
								</p>
							</div>
						{{else}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-warning">
								<p>
									<strong>
										<i class="ace-icon fa fa-check"></i>
										{{flash.texto}}
									</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()">
										<i class="ace-icon fa fa-times"></i>
									</button>
								</p>
							</div>
						{{/compareString}}
					{{/compareString}}
					
					<!-- Widget 1: Evoluções Ausentes -->
					<div class="col-12 col-sm-12 col-md-4" name="Faltaevo" id="Faltaevo">
						<div class="widget-box">
							<div class="widget-header">
								<h4 class="widget-title">
									<i class="red ace-icon fa fa-bookmark bigger-110"></i>
									Evoluções Ausentes do dia
								</h4>
								<span class="widget-toolbar">
									<a href="#" data-action="collapse">
										<i class="ace-icon fa fa-chevron-up"></i>
									</a>
								</span>
							</div>
							<div class="widget-body">
								<div class="widget-main">
									<div class="row">
										<div class="col-xs-12">
											<table id="dynamic-table1" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid">
												<thead>
													<tr role="row">
														<th style="width: 40px;">Hora</th>
														<th style="width: 50px;">Sala</th>
														<th style="width: 12px;">Terapia</th>
														<th>Beneficiário</th>
														<th>Evoluir</th>
													</tr>
												</thead>
												<tbody>
													{{#each agendas}}
													<tr role="row" class="odd">
														<!-- Hora -->
														<td>{{agenda_hora}}</td>
															
														<td>
															{{#each ../salas}}
																{{#ifEqual this._id ../agenda_salaid}}
																	{{sala_nome}}
																{{/ifEqual}}
															{{/each}}
														</td>
														
													
														
														<!-- Terapia -->
														<td>
															{{#each ../terapias}}
																{{#ifEqual this._id ../agenda_terapiaid}}
																	{{terapia_nomecid}}
																{{/ifEqual}}
															{{/each}}
														</td>

														<!-- 👉 DEPOIS (formatado igual agenda pessoal): -->
														<td>
															{{#each ../benes}}
																{{#ifEqual this._id ../agenda_beneid}}
																	<label style="width:85px;border:0px;margin-bottom:2px;font-size:10px;" id="{{this._id}}x">
																		<span class="badge-agenda" style="{{../badgeStyle}}">
																			{{this.bene_nome}}
																		</span>
																	</label>
																{{/ifEqual}}
															{{/each}}
														</td>
														
														<!-- 👉 Evoluir: ícone com tooltip -->
															<td class="text-center" style="vertical-align: middle; width: 50px;">
																{{#ifEqual agenda_selo true}}
																	<span class="badge badge-success badge-ok">Ok</span>
																{{else}}
																	<div class="custom-tooltip">
																		{{#ifEqual ui.icone "ban"}}
																			<i class="ace-icon fa fa-ban bigger-130" ></i>
																		{{else}}
																			{{#if ui.temLink}}
																				<a href="javascript:evolucaoSemanalEmDia('{{_id}}');" style="display:inline-block;">
																					<i class="ace-icon fa fa-pencil bigger-130" ></i>
																				</a>
																			{{else}}
																				<i class="ace-icon fa fa-pencil bigger-130" ></i>
																			{{/if}}
																		{{/ifEqual}}
																		<span class="tooltip-text">
																			<strong style="color:#c00">{{ui.tooltipTitulo}}</strong><br>
																			{{ui.tooltipTexto}}
																		</span>
																	</div>
																{{/ifEqual}}
															</td>
													</tr>
													{{/each}}
												</tbody>
											</table>
										</div>
									</div>
									<!-- 👉 LABELS OCULTOS: Nomes dos beneficiários (para o JS clonar) -->
									<div class="hidden" id="divBeneLabels">
										{{#each benes}}
											<label id="{{_id}}" style="display:none;">{{bene_nome}}</label>
										{{/each}}
									</div>

									<!-- 👉 INPUTS PARA JS: Mapeia dia/hora → beneId + categoria -->
									<div class="hidden" id="divBeneData">
										{{#each agendas}}
											<input name="{{agenda_data_semana}}BeneId_{{agenda_hora}}_{{agenda_beneid}}" 
												value="{{cadeia.ultimoCategoria}}{{#unless cadeia.ultimoCategoria}}{{agenda_categoria}}{{/unless}}">
										{{/each}}
									</div>
								</div>
							</div>		
						</div>
					</div>
					
					<!-- Widget 2: Pontuações na Agenda -->
					<div class="col-12 col-sm-12 col-md-4" name="Pontage" id="Pontage">
						<div class="widget-box">
							<div class="widget-header">
								<h4 class="widget-title">
									<i class="purple ace-icon fa fa-bullseye bigger-110"></i>
									Pontuações na Agenda
								</h4>
								<span class="widget-toolbar">
									<a href="#" data-action="collapse">
										<i class="ace-icon fa fa-chevron-up"></i>
									</a>
								</span>
							</div>
							<div class="widget-body">
								<div class="widget-main">
									<div class="row">
										<div class="col-xs-12">
											<div class="col-xs-12 col-sm-12" style="padding-top: 2px;">
												<div class="alert alert-danger">
													<strong>Agenda:</strong>
													<div><hr></div>
													{{#each agendas}}
														{{#isNull agenda_obs}}
														{{else}}
															<label>{{agenda_data_semana}} : {{agenda_hora}} / {{#each ../salas}}{{#ifEqual ../agenda_salaid _id}}{{sala_nome}}{{/ifEqual}}{{/each}} / {{#each ../benes}}{{#ifEqual ../agenda_beneid _id}}{{bene_apelido}}{{/ifEqual}}{{/each}} - {{agenda_obs}}</label>
															<br>
														{{/isNull}}
													{{/each}}
													<br>
												</div>
												<div class="alert alert-warning">
													<strong>Evoluções Ausentes:</strong>
													<div><hr></div>
													{{#each evolucaoFaltante}}
													<div class="action-buttons">
														<label>{{formatDate "" agenda_data}}, {{agenda_hora}}, {{sala_nome}}, {{terapia_nomecid}}, {{bene_apelido}}</label>
														<a class="blue" name="acaoEvolucaoSemanal" id="acaoEvolucaoSemanal" onclick="javascript:evolucaoSemanalEmDia('{{_id}}');">
															<i class="ace-icon fa fa-pencil bigger-130"></i>
														</a><br>
													</div>
													{{/each}}
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>		
						</div>
					</div>
					
					<!-- Widget 3: Aniversariantes -->
					<div class="col-12 col-sm-12 col-md-4" name="percep" id="percep">
						<div class="widget-box">
							<div class="widget-header">
								<h4 class="widget-title">
									<i class="orange ace-icon fa fa-birthday-cake bigger-110"></i>
									Aniversariantes da Semana
								</h4>
								<span class="widget-toolbar">
									<a href="#" data-action="collapse">
										<i class="ace-icon fa fa-chevron-up"></i>
									</a>
								</span>
							</div>
							<div class="widget-body">
								<div class="widget-main">
									<!-- Beneficiários -->
									<div class="row">
										<div class="col-xs-12 col-md-12 col-sm-12">
											<p class="alert alert-info">
												<b>Beneficiários</b>
											</p>
											{{#if aniversariantesDaSemanaBene.length}}
												<table id="dynamic-table" class="table table-striped table-bordered table-hover" role="grid">
													<thead>
														<tr>
															<th style="width: 5%;">Dia</th>
															<th>Aniversariante</th>
														</tr>
													</thead>
													<tbody>
														{{#each aniversariantesDaSemanaBene}}
															<tr>
																<td>{{this.diaNascimento}}/{{this.mesNascimento}}</td>
																<td>
																	{{this.nome}}
																	{{#if this.hoje}}
																		<span class="badge badge-success">Hoje!</span>
																	{{/if}}
																</td>
															</tr>
														{{/each}}
													</tbody>
												</table>
											{{else}}
												<label>Não há aniversariantes hoje.</label>
											{{/if}}
										</div>
									</div>	
									
									<!-- Colaboradores -->
									<div class="row">
										<div class="col-12 col-sm-12 col-md-12">
											<p class="alert alert-warning">
												<b>Colaboradores</b>
											</p>
											{{#if aniversariantesDaSemanaUsuario.length}}
												<table id="dynamic-table" class="table table-striped table-bordered table-hover" role="grid">
													<thead>
														<tr>
															<th style="width: 5%;">Dia</th>
															<th>Aniversariante</th>
														</tr>
													</thead>
													<tbody>
														{{#each aniversariantesDaSemanaUsuario}}
															<tr>
																<td>{{this.diaNascimento}}/{{this.mesNascimento}}</td>
																<td>
																	{{this.nome}}
																	{{#if this.hoje}}
																		<span class="badge badge-success">Hoje!</span>
																	{{/if}}
																</td>
															</tr>
														{{/each}}
													</tbody>
												</table>
											{{else}}
												<label>Não há aniversariantes hoje.</label>
											{{/if}}
										</div>
									</div>
								</div>
							</div>		
						</div>
					</div>				
				</div>
			</div>
		</div>
		<!-- ========================================================================
     🚀 FUNÇÕES DE CARREGAMENTO DA AGENDA (carregaBody + pintaAgenda)
		======================================================================== -->
		<script>
			// Aguarda DOM estar pronto
			document.addEventListener('DOMContentLoaded', function() {
				console.log("🚀 [branco.hbs] DOM pronto, inicializando formatação...");
				setTimeout(carregaBody, 100);
			});

			function carregaBody(){
				console.log("🚀 [carregaBody] Iniciando formatação de beneficiários...");
				let dias = ["seg","ter","qua","qui","sex"];
				
				try{
					dias.forEach((dia)=>{
						document.getElementsByName(dia).forEach((e)=>{
							let id = "hora" + e.id;
							let valor = e.value;
							let tempId = e.id + "_" + valor;
							
							if(valor && valor != "766f69643132333435366964"){
								// ✅ BENEFICIÁRIO
								if(e.id.indexOf("BeneId_") != -1){
									let val = document.getElementById(valor)?.cloneNode(true);
									if(!val) return;
									
									val.id = val.id + "x";
									
									// Busca categoria e aplica formatação
									document.getElementsByName(tempId).forEach((ti)=>{
										pintaAgenda(val, ti.value);
									});
									
									// Insere na célula de destino
									let destino = document.getElementById(id);
									if(destino){
										destino.innerHTML = '';  // Limpa antes
										destino.appendChild(val);
										console.log(`✅ Bene formatado: #${id}`);
									}
								}
							}
						});
					});
					console.log("✅ [carregaBody] Finalizado");
				} catch(err){
					console.error("❌ ERRO em carregaBody:", err);
				}
			}

			function pintaAgenda(val, motivo){
				// 🎨 CORES POR CATEGORIA (TEXTO, não background)
				const coresTexto = {
					"Falta": "#ffc107",              // 🟡 Amarelo
					"Falta Justificada": "#ffc107",  // 🟡 Amarelo
					"Falta Absoluta": "#e65100",     // 🟠 Laranja forte
					"Substituição": "#00bcd4",       // 🔵 Ciano
					"Feriado": "#e65100",            // 🟠 Laranja forte
					"default": "#397097"             // 🔵 Azul padrão
				};
				
				const motivoKey = motivo?.trim() || "default";
				const corTexto = coresTexto[motivoKey] || coresTexto.default;
				const texto = val?.textContent?.trim() || "—";
				
				if (val) {
					val.innerHTML = '';  // Limpa
					
					// 👉 CRIA SPAN COM COR DE TEXTO (igual agenda pessoal, mas com color)
					const span = document.createElement('span');
					span.style.cssText = `
						color: ${corTexto} !important;
						font-weight: ${motivoKey === "Falta Absoluta" ? "bold" : "600"};
						display: inline-block;
						white-space: nowrap;
						line-height: 1.3;
						${motivoKey === "Falta Absoluta" ? "text-shadow: 0 0 1px rgba(0,0,0,0.1);" : ""}
					`;
					span.textContent = texto;
					val.appendChild(span);
				}
				console.log(`🎨 Span aplicado: "${motivoKey}" → ${corTexto}`);
			}
		</script>
	</body>
</html>