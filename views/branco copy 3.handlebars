<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>SisRoute - Home</title>
		<script>
			function OcultaMsg(){
				document.getElementById("alertMsgFlash").hidden = true;
			}


			function evolucaoSemanalEmDia(id){
				window.location.href=("/menu/agenda/evolucaoTemp/"+id);
			}
			
		</script>
		
		
	</head>
	<body class="no-skin" background-image="/assets/images/papelparede/temaLoginArraial.jpeg" onload="javascript:controlaNave();"  >
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					{{#compareString flash.sucesso "true"}}
						<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-success">
							<p>
								<strong>
									<i class="ace-icon fa fa-check"></i>
									{{flash.texto}}
								</strong>
								<button type="button" class="close" onclick="javascript:OcultaMsg()">
									<i class="ace-icon fa fa-times"></i>
								</button>
							</p>
						</div>
						<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-success">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
					{{else}}
						{{#compareString flash.sucesso "false"}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">
								<p>
									<strong>
										<i class="ace-icon fa fa-times"></i>
										{{flash.texto}}
									</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()">
										<i class="ace-icon fa fa-times"></i>
									</button>
								</p>
							</div>
							<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
						{{else}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-warning">
								<p>
									<strong>
										<i class="ace-icon fa fa-check"></i>
										{{flash.texto}}
									</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()">
										<i class="ace-icon fa fa-times"></i>
									</button>
								</p>
							</div>
							<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
						{{/compareString}}
					{{/compareString}}
					<div class="col-12 col-sm-12 col-md-4" name="Faltaevo" id="Faltaevo"><!-- Evoluções Ausentes-->
						<div class="widget-box">
							<div class="widget-header">
								<h4 class="widget-title">
									<i class="red ace-icon fa fa-bookmark bigger-110"></i>
									Evoluções Ausentes do dia</h4>
								<span class="widget-toolbar">
									
									<a href="#" data-action="collapse">
										<i class="ace-icon fa fa-chevron-up"></i>
									</a>
								</span>
							</div>
							<div class="widget-body">
								<div class="widget-main">
									<div class="row">
										<div class="col-xs-12">
										
											<head>
												<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
												<meta charset="utf-8">
											
												<script type="text/javascript">
													function carregaBody() {
														// Função para carregar os dados ao iniciar a página
														console.log("Carregando lista de agendamentos pendentes...");
														
													}
												</script>
											</head>
											<body onload="javascript:carregaBody();" class="no-skin">
												<div class="main-container ace-save-state" id="main-container">
													<div class="main-content">
														<div class="main-content-inner">
															
															<div class="page-content">
																<div class="row">
																	<div class="col-xs-12">
																	
																		<table id="dynamic-table1" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid">
																			<thead>
																				<tr role="row">
																					<th>Hora</th>
																					<th>Terapia</th>
																					<th>Beneficiário</th>
																					<th>Evoluir</th>
																				</tr>
																			</thead>
																			<tbody>
																				{{#each agendas}}
																					
																						<tr role="row" class="odd">
																							<td>{{agenda_hora}}</td>
																							<td>
																								{{#each ../terapias}}
																									{{#ifEqual this._id ../agenda_terapiaid}}
																										{{terapia_nomecid}}
																									{{/ifEqual}}
																								{{/each}}
																							</td>
																							
																							<td>
																								{{#each ../benes}}
																									{{#ifEqual this._id ../agenda_beneid}}
																										{{bene_nome}}
																									{{/ifEqual}}
																								{{/each}}
																							</td>
																							<td>
																								{{#ifEqual agenda_selo false}}
																								<div class="action-buttons">
																									<a class="blue" name="acaoEvolucaoSemanal" id="acaoEvolucaoSemanal" onclick="javascript:evolucaoSemanalEmDia('{{_id}}');">
																										<i class="ace-icon fa fa-pencil bigger-130"></i>
																									</a>
																								</div>
																								{{else}}
																								<span class="badge badge-success">Ok</span>
																								{{/ifEqual}}
																							</td>
																						</tr>
																					
																				{{/each}}
																			</tbody>
																		</table>
																	</div>
																</div>
															</div>
														</div>
													</div>
													
												</div>
												<!-- basic scripts -->
												<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
												<script type="text/javascript">
													$(document).ready(function() {
														$("#dynamic-table1").DataTable({
															"language": { "url": "/js/lang/datatable-pt-br.json" },
															"aaSorting": [],
															"responsive": true,
															"lengthMenu": [25, 50],
															"lengthChange": true,
															"autoWidth": false,
															"paging": true,
															"searching": true,
															"ordering": true,
															"info": true
														});
													});
												</script>
											</body>
											</html>
										</div>
									</div>
								</div>
							</div>		
						</div>
					</div>
					<div class="col-12 col-sm-12 col-md-4" name="Pontage" id="Pontage"><!-- Pontuações na Agenda, Faltya Substituição etc -->
						<div class="widget-box">
							<div class="widget-header">
								<h4 class="widget-title">
									<i class="purple ace-icon fa fa-bullseye bigger-110"></i>
									Pontuações na Agenda</h4>
								<span class="widget-toolbar">
									
									<a href="#" data-action="collapse">
										<i class="ace-icon fa fa-chevron-up"></i>
									</a>
								</span>
							</div>
							<div class="widget-body">
								<div class="widget-main">
									<div class="row">
										<div class="col-xs-12">
										<div class="col-xs-12 col-sm-12" style="padding-top: 2px;">
												<div class="alert alert-danger">
													<strong>
													Agenda:
													</strong>
													<div><hr></div>
													
													{{#each agendas}}
														{{#isNull agenda_obs}}
														{{else}}
															<label>{{agenda_data_semana}} : {{agenda_hora}} / {{#each ../salas}}{{#ifEqual ../agenda_salaid _id}}{{sala_nome}}{{/ifEqual}}{{/each}} / {{#each ../benes}}{{#ifEqual ../agenda_beneid _id}}{{bene_apelido}}{{/ifEqual}}{{/each}} - {{agenda_obs}}</label>
															<br>
														{{/isNull}}
													{{/each}}
													
													<br>
												</div>
												<div class="alert alert-warning">
													<strong>
													Evoluções Ausentes:
													</strong>
													<div><hr></div>
													
													{{#each evolucaoFaltante}}
													<div class="action-buttons"><label>{{formatDate "" agenda_data}}, {{agenda_hora}}, {{sala_nome}}, {{terapia_nomecid}}, {{bene_apelido}}</label>
														<a class="blue" class="action-buttons" name="acaoEvolucaoSemanal" id="acaoEvolucaoSemanal" onclick="javascript:evolucaoSemanalEmDia('{{_id}}');">
															<i class="ace-icon fa fa-pencil bigger-130"></i>
														</a><br>
													</div>
													{{/each}}

												</div>
											</div>
										</div>
									</div>
								</div>
							</div>		
						</div>
					</div>
					<div class="col-12 col-sm-12 col-md-4" name="percep" id="percep"><!-- Aniversariantes do MÊS -->
						<div class="widget-box">
							<div class="widget-header">
								<h4 class="widget-title">
									<i class="orange ace-icon fa fa-birthday-cake bigger-110"></i>
									Aniversariantes da Semana</h4>
								<span class="widget-toolbar">
									
									<a href="#" data-action="collapse">
										<i class="ace-icon fa fa-chevron-up"></i>
									</a>
								</span>
							</div>
							<div class="widget-body">
								<div class="widget-main">
									<div class="row">
										<div class="col-xs-12 col-md-12 col-sm-12">
											<p class="alert alert-info">
												<b>Beneficiários</b>
											</p>
											{{#if aniversariantesDaSemanaBene.length}}
												<table id="dynamic-table" class="table table-striped table-bordered table-hover" role="grid" aria-describedby="dynamic-table_info">
													<thead>
														<tr>
															<th style="width: 5%;" class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1" >Dia</th>
															<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1" >Aniversariante</th>
														</tr>
													</thead>
													<tbody>
														{{#each aniversariantesDaSemanaBene}}
															<tr>
																<td>{{this.diaNascimento}}/{{this.mesNascimento}}</td>
																<td>{{this.nome}}
																	{{#if this.hoje}}
																		<span class="badge badge-success">Hoje!</span>
																	{{/if}}
																</td>
															</tr>
														{{/each}}
													</tbody>
												</table>
											{{else}}
												<label>Não há aniversariantes hoje.</label>
											{{/if}}
										</div>
									</div>	
									<div class="row">
										<div class="col-12 col-sm-12 col-md-12">
											<p class="alert alert-warning">
												<b>Colaboradores</b>
											</p>
											{{#if aniversariantesDaSemanaUsuario.length}}
												<table id="dynamic-table" class="table table-striped table-bordered table-hover" role="grid" aria-describedby="dynamic-table_info">
													<thead>
														<tr>
															<th style="width: 5%;" class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1" >Dia</th>
															<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1" >Aniversariante</th>
														</tr>
													</thead>
													<tbody>
														{{#each aniversariantesDaSemanaUsuario}}
															<tr>
																<td>{{this.diaNascimento}}/{{this.mesNascimento}}</td>
																<td>{{this.nome}}
																{{#if this.hoje}}
																	<span class="badge badge-success">Hoje!</span>
																{{/if}}
																</td>
															</tr>
														{{/each}}
													</tbody>
												</table>
											{{else}}
												<label>Não há aniversariantes hoje.</label>
											{{/if}}

										</div>
									</div>
								</div>
							</div>		
						</div>
					</div>				
				</div>
			</div><!-- /.main-content -->
		</div><!-- /.main-container -->
		<!-- basic scripts -->
		
	</body>
</html>