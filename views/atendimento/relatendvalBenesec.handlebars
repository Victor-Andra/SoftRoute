		<script type="text/javascript">
			function atualizaDataIni(){
				let fulldate = (document.getElementById('dataFilDe').value+' 00:00:00.000Z').toString();
				document.getElementById('dataIni').value = fulldate;
			}
			function atualizaDataFin(){
				let fulldate = (document.getElementById('dataFilAte').value+' 00:00:00.000Z').toString();
				document.getElementById('dataFim').value = fulldate;
			}
		
			function restaurarFiltro(filtro) {
				if (!filtro) return;

				// Atualiza os campos VISÍVEIS
				if (filtro.dataIni) {
					// Formato esperado: YYYY-MM-DD (para input type="date")
					const dataIniFormatada = filtro.dataIni.split('T')[0]; // remove hora
					document.getElementById('dataFilDe').value = dataIniFormatada;
				}
				if (filtro.dataFim) {
					const dataFimFormatada = filtro.dataFim.split('T')[0];
					document.getElementById('dataFilAte').value = dataFimFormatada;
				}
				if (filtro.convenioId) {
					document.getElementById('relConvid').value = filtro.convenioId;
				}
			}

			document.addEventListener('DOMContentLoaded', () => {
				const filtro = {{#if filtro}} {{{json filtro}}} {{else}} null {{/if}};
				restaurarFiltro(filtro);
			});
		</script>
