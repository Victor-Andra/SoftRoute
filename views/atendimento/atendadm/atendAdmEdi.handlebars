			// ✅ Executa APÓS Chosen estar totalmente inicializado
			document.addEventListener("DOMContentLoaded", function() {
				// Aguarda Chosen carregar (seu main usa $(document).ready + initChosen)
				// Esperamos um pouco mais para garantir (100ms é seguro com jQuery 2.1.4)
				setTimeout(function() {
					// Primeiro: carrega os valores brutos nos <select> reais
					carregaBody();

					// Segundo: força atualização do Chosen em TODOS os selects
					$('.chosen-select').each(function() {
						if ($(this).data('chosen')) {
							$(this).trigger('chosen:updated');
						}
					});

					// Terceiro: chama lógica dependente (ex: selectConv, carregaValores)
					if (document.getElementById("atendBeneid").value) {
						selectConv(); // atualiza convênio com base no beneficiário
					}
					if (document.getElementById("atendTerapiaid").value) {
						carregaValores(); // atualiza valores com base na terapia
					}
				}, 200); // 200ms para garantir inicialização do Chosen
			});
