		<script type="text/javascript">
			// ===== SELECT CONVÊNIO =====
			function selectConv(){
    var beneId = document.getElementById("atendBeneid").value;
    
    // Validação: se não selecionou beneficiário, limpa convênio
    if (!beneId || beneId === "766f69643132333435366964") {
        document.getElementById("atendConvid").value = "766f69643132333435366964";
        document.getElementById("tabilConvid").value = "";

        return;
    }
    
    // Pega o input hidden que contém o ID do convênio vinculado ao beneficiário
    var convInput = document.getElementById(beneId);
    if (convInput && convInput.value) {
        var convId = convInput.value.toString();
        
        // Atualiza os campos
        document.getElementById("atendConvid").value = convId;
        document.getElementById("tabilConvid").value = convId;
        
        // Recarrega valores da terapia automaticamente
        carregaValores();
		carregaValoresFixo();
		carregaValoresMerge();
    }
}

			// ===== CARREGA VALORES PRINCIPAIS =====
			function carregaValores(){
    let teraId = document.getElementById("atendTerapiaid").value;
    document.getElementById("creditTerapiaid").value = teraId;
    document.getElementById("debitTerapiaid").value = teraId;
    
    try {
        let convId = document.getElementById("atendConvid").value;
        if (convId && teraId && convId !== "766f69643132333435366964" && teraId !== "766f69643132333435366964") {
            let elCre = document.getElementById(convId+"/"+teraId+"/cre");
            let elDeb = document.getElementById(convId+"/"+teraId+"/deb");
            
            let valorCre = (elCre && elCre.value) ? elCre.value : "0,00";
            let valorDeb = (elDeb && elDeb.value) ? elDeb.value : "0,00";
            
            document.getElementById("atendValorcre").value = valorCre;
            document.getElementById("atendValordeb").value = valorDeb;
            document.getElementById("tabilValorcredit").value = valorCre;
            document.getElementById("tabilValordebit").value = valorDeb;
        }
    } catch(err) {
        console.log("Erro ao carregar valores:", err);
        document.getElementById("atendValorcre").value = "0,00";
        document.getElementById("atendValordeb").value = "0,00";
        document.getElementById("tabilValorcredit").value = "0,00";
        document.getElementById("tabilValordebit").value = "0,00";
    }
}
	function carregaValoresFixo(){
		let teraId = document.getElementById("atendFixoTerapiaid").value;
		document.getElementById("creditFixoTerapiaid").value = teraId;
		document.getElementById("debitFixoTerapiaid").value = teraId;
		
		try {
			let convId = document.getElementById("atendConvid").value;
			console.log(convId)
			if (convId && teraId && convId !== "766f69643132333435366964" && teraId !== "766f69643132333435366964") {
				let elCre = document.getElementById(convId+"/"+teraId+"/cre");
				let elDeb = document.getElementById(convId+"/"+teraId+"/deb");
				
				let valorCre = (elCre && elCre.value) ? elCre.value : "0,00";
				let valorDeb = (elDeb && elDeb.value) ? elDeb.value : "0,00";
				console.log("valorCre"+valorCre)
				
				document.getElementById("atendFixovalorcre").value = valorCre;
				document.getElementById("atendFixovalordeb").value = valorDeb;
			}
		} catch(err) {
			console.log("Erro ao carregar valores:", err);
			document.getElementById("atendValorcre").value = "0,00";
			document.getElementById("atendValordeb").value = "0,00";
			document.getElementById("tabilValorcredit").value = "0,00";
			document.getElementById("tabilValordebit").value = "0,00";
		}
	}

	function carregaValoresMerge(){
		let teraId = document.getElementById("atendMergeTerapiaid").value;
		document.getElementById("creditMergeTerapiaid").value = teraId;
		document.getElementById("debitMergeTerapiaid").value = teraId;
		
		try {
			let convId = document.getElementById("atendConvid").value;
			if (convId && teraId && convId !== "766f69643132333435366964" && teraId !== "766f69643132333435366964") {
				let elCre = document.getElementById(convId+"/"+teraId+"/cre");
				let elDeb = document.getElementById(convId+"/"+teraId+"/deb");
				
				document.getElementById("atendMergevalorcre").value = (elCre && elCre.value) ? elCre.value : "0,00";
				document.getElementById("atendMergevalordeb").value = (elDeb && elDeb.value) ? elDeb.value : "0,00";
			}
		} catch(err) {
			console.log("Erro ao carregar valores merge:", err);
			document.getElementById("atendMergevalorcre").value = "0,00";
			document.getElementById("atendMergevalordeb").value = "0,00";
		}
	}

			

			// ===== ATUALIZAÇÕES SIMPLES =====
			function atualizaTerapeutaId(){
				$('#tabilTerapeutaId').val($('#atendTerapeutaid').val());
			}
			
			function atualizaMergeTerapeutaId(){
				// Mantida por compatibilidade, mas sem lógica de exibição
				console.log('Merge terapeuta:', $('#atendMergeTerapeutaid').val());
			}

			// ===== CATEGORIA - apenas define valor, NUNCA esconde opções =====
			function controlaCategoria(){
				let origem = $('#atendOrg').val();
				// Apenas define o valor, sem mexer em display de opções
				if (origem == "Padrão") {
					$('#atendCategoria').val("Padrão").trigger('chosen:updated');
				} else {
					$('#atendCategoria').val("Apoio").trigger('chosen:updated');
				}
			}

			// ===== CARREGA BODY - POPULA TUDO, SEM CONDICIONAIS DE EXIBIÇÃO =====
			function carregaBody(){
				console.log("=== START carregaBody (modo tudo visível) ===");
				
				// --- Campos básicos ---
				$('#atendId').val($('#idEdi').val());
				$('#atenddata').val(formataData($('#atendAtenddataEdi').val()));
				$('#atendHora').val($('#atendHoraEdi').val()).trigger('chosen:updated');
				$('#atendOrg').val($('#atendOrgEdi').val()).trigger('chosen:updated');
				$('#atendCategoria').val($('#atendCategoriaEdi').val()).trigger('chosen:updated');
				$('#atendBeneid').val($('#atendBeneidEdi').val()).trigger('chosen:updated');
				$('#atendConvid').val($('#atendConvidEdi').val()).trigger('chosen:updated');
				$('#atendTerapeutaid').val($('#atendTerapeutaidEdi').val()).trigger('chosen:updated');
				$('#atendTerapiaid').val($('#atendTerapiaidEdi').val()).trigger('chosen:updated');
				$('#atendValorcre').val($('#atendValorcreEdi').val());
				$('#atendValordeb').val($('#atendValordebEdi').val());
				$('#atendSalaid').val($('#atendSalaidEdi').val()).trigger('chosen:updated');
				$('#atendObs').val($('#atendObsEdi').val());
				
				// --- Campos Merge (sempre visíveis) ---
				$('#atendMergeTerapeutaid').val($('#atendMergeTerapeutaidEdi').val()).trigger('chosen:updated');
				$('#atendMergeTerapiaid').val($('#atendMergeTerapiaidEdi').val()).trigger('chosen:updated');
				$('#atendMergevalorcre').val($('#atendMergevalorcreEdi').val());
				$('#atendMergevalordeb').val($('#atendMergevalordebEdi').val());
				
				// --- Campos Fixo (sempre visíveis, sem toggle) ---
				// Apenas popula, independente do valor de atendFixo
				$('#atendFixoTerapeutaid').val($('#atendFixoTerapeutaidEdi').val()).trigger('chosen:updated');
				$('#atendFixoTerapiaid').val($('#atendFixoTerapiaidEdi').val()).trigger('chosen:updated');
				$('#atendFixovalorcre').val($('#atendFixovalorcreEdi').val());
				$('#atendFixovalordeb').val($('#atendFixovalordebEdi').val());
				// Checkbox apenas como indicador, não controla exibição
				$('#atendFixoCheck').prop('checked', $('#atendFixoEdi').val() === "true");
				
				// --- Sincroniza campos ocultos da tabela ---
				$('#tabilTerapeutaId').val($('#atendTerapeutaid').val());
				$('#tabilConvid').val($('#atendConvid').val());
				$('#tabilCategoria').val($('#atendCategoria').val());
				
				atualizaData();
				toggleDivSubFixo();
				
				console.log("=== FINISH carregaBody ===");
			}
			function toggleDivSubFixo(){
				document.getElementById("atendFixo").value = document.getElementById("atendFixoCheck").checked ? "true" : "false";
			}

			// ===== FUNÇÕES DE DATA =====
			function atualizaData(){
				var data = $('#atenddata').val() + "T" + $('#atendHora').val() + ":00.000Z";
				var datafmt = new Date(data);
				$('#atendAtenddata').val(datafmt.toISOString());
			}
			
			function atualizaDataEdi(){
				$('#atenddata').val(formataData($('#atendAtenddataEdi').val()));
			}
			
			function formataData(date) {
				var d = new Date(date);
				if (d.getTimezoneOffset() == 180) {
					d.setHours(d.getHours() + 3);
				}
				var month = '' + (d.getMonth() + 1);
				var day = '' + d.getDate();
				var year = d.getFullYear();
				if (month.length == 1) month = '0' + month;
				if (day.length == 1) day = '0' + day;
				return [year, month, day].join('-');
			}

			// ===== INICIALIZAÇÃO DO CHOSEN + CARREGAMENTO =====
			$(document).ready(function() {
				
				
				// 2️⃣ Depois: garante que a seção Fixo esteja visível
				$('#divSubFixo').show().css('display', '');
				
				// 3️⃣ POR ÚLTIMO: popula os campos e atualiza o Chosen
				// Remove o onload do <body> e chama aqui:
				carregaBody();
				controlaNave(); // se essa função também depender do DOM pronto
			});
		</script>
