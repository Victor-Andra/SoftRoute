			function carregaBody() {
    // IDs
    document.getElementById("atendId").value = document.getElementById("idEdi").value;
    document.getElementById("nextNum").value = document.getElementById("nextNum").value;

    // Data/Hora
    atualizaDataEdi();
    document.getElementById("atendHora").value = document.getElementById("atendHoraEdi").value;

    // Beneficiário, Convênio, Sala
    document.getElementById("atendBeneid").value = document.getElementById("atendBeneidEdi").value;
    document.getElementById("atendConvid").value = document.getElementById("atendConvidEdi").value;
    document.getElementById("atendSalaid").value = document.getElementById("atendSalaidEdi").value;

    // Terapeutas e Terapias
    document.getElementById("atendTerapeutaid").value = document.getElementById("atendTerapeutaidEdi").value;
    document.getElementById("atendTerapiaid").value = document.getElementById("atendTerapiaidEdi").value;
    document.getElementById("atendMergeTerapeutaid").value = document.getElementById("atendMergeTerapeutaidEdi").value;
    document.getElementById("atendMergeTerapiaid").value = document.getElementById("atendMergeTerapiaidEdi").value;
    document.getElementById("atendFixoTerapeutaid").value = document.getElementById("atendFixoTerapeutaidEdi").value || "";
    document.getElementById("atendFixoTerapiaid").value = document.getElementById("atendFixoTerapiaidEdi").value || "";

    // Valores
    document.getElementById("atendValorcre").value = document.getElementById("atendValorcreEdi").value;
    document.getElementById("atendValordeb").value = document.getElementById("atendValordebEdi").value;
    document.getElementById("atendMergevalorcre").value = document.getElementById("atendMergevalorcreEdi").value;
    document.getElementById("atendMergevalordeb").value = document.getElementById("atendMergevalordebEdi").value;
    document.getElementById("atendFixovalorcre").value = document.getElementById("atendFixovalorcreEdi").value || "0,00";
    document.getElementById("atendFixovalordeb").value = document.getElementById("atendFixovalordebEdi").value || "0,00";

    // Observação
    document.getElementById("atendObs").value = document.getElementById("atendObsEdi").value;

    // ✅ Origem e Categoria — CRÍTICO
    const orgEdi = document.getElementById("atendOrgEdi").value;
    const categoriaEdi = document.getElementById("atendCategoriaEdi").value;

    // 1. Define origem
    document.getElementById("atendOrg").value = orgEdi;

    // 2. Atualiza opções de categoria COM BASE NA ORIGEM
    controlaCategoria(); // ← isso já popula as opções e define valor padrão

    // 3. ✅ SOBREPÕE com o valor do banco (se ainda for válido)
    const selectCat = document.getElementById("atendCategoria");
    const opcaoValida = Array.from(selectCat.options).some(opt => opt.value === categoriaEdi);
    if (opcaoValida) {
        selectCat.value = categoriaEdi;
    }
    document.getElementById("tabilCategoria").value = selectCat.value;
	// ✅ Carrega Substituto Fixo (Sim/Não)
	const fixoEdi = (document.getElementById("atendFixoEdi")?.value || "").trim();
	document.getElementById("atendFixo").value = fixoEdi; // "true", "false", ou ""
	
	// 4. Atualiza Chosen
    $('.chosen-select').trigger('chosen:updated');

    console.log("✅ carregaBody() — categoria:", selectCat.value);
}
			function atualizaData(){
				var data = document.getElementById("atenddata").value+"T"+document.getElementById("atendHora").value+":00.000Z";
				console.log("data:"+data);
				var datafmt = new Date(data);
				console.log("datafmt:"+datafmt);
				document.getElementById("atendAtenddata").value = datafmt.toISOString();
				//
				//var dataIso = document.getElementById("dataAg").value+"T"+document.getElementById("agendaHora").value+":00.000Z";
				//var dataFmt = new Date(dataIso);
				//console.log(dataIso);
				//document.getElementById("agendaData").value = dataFmt;
			}
			function atualizaDataEdi(){
				document.getElementById("atenddata").value = formataData(document.getElementById("atendAtenddataEdi").value);
			}
			function formataData(date) {//yyyy-MM-dd
				var d = new Date(date);
				if (d.getTimezoneOffset() == 180){
					d.setHours(d.getHours()+3);
				}
				console.log("d:"+d);
					month = '' + (d.getMonth() + 1);
					day = '' + d.getDate();
					year = d.getFullYear();

				if (month.length == 1) {
					month = '0' + month;
				}
					
				if (day.length == 1) {
					day = '0' + day;
				}

				return [year, month, day].join('-');
			}
		</script>
