		<script type="text/javascript">
			// === INICIALIZAÇÃO DO CHOSEN (executar após DOM carregar) ===
function inicializaChosen() {
    // Inicializa todos os selects com a classe chosen-select
    if (typeof jQuery !== 'undefined' && jQuery.fn.chosen) {
        jQuery('.chosen-select').chosen({
            width: '100%',
            allow_single_deselect: true,
            no_results_text: 'Nenhum resultado encontrado...'
        });
        
        // Bind dos eventos change para garantir que funcionem com Chosen
        jQuery('#atendBeneid').on('change', function() {
            selectConv();
        });
        
        jQuery('#atendTerapiaid').on('change', function() {
            carregaValores();
        });
        
        jQuery('#atendMergeTerapiaid').on('change', function() {
            carregaValoresMerge();
        });
        
        jQuery('#atendTerapeutaid').on('change', function() {
            atualizaTerapeutaId();
        });
    }
}

// === FUNÇÃO PARA SINCRONIZAR CONVÊNIO ===
function selectConv(){
    var beneId = document.getElementById("atendBeneid").value;
    
    // Validação: se não selecionou beneficiário, limpa convênio
    if (!beneId || beneId === "766f69643132333435366964") {
        document.getElementById("atendConvid").value = "766f69643132333435366964";
        document.getElementById("tabilConvid").value = "";
        if (typeof jQuery !== 'undefined') {
            jQuery('#atendConvid').trigger('chosen:updated');
        }
        return;
    }
    
    // Pega o input hidden que contém o ID do convênio vinculado ao beneficiário
    var convInput = document.getElementById(beneId);
    if (convInput && convInput.value) {
        var convId = convInput.value.toString();
        
        // Atualiza os campos
        document.getElementById("atendConvid").value = convId;
        document.getElementById("tabilConvid").value = convId;
        
        // === IMPORTANTE: Atualiza a UI do Chosen ===
        if (typeof jQuery !== 'undefined' && jQuery('#atendConvid').data('chosen')) {
            jQuery('#atendConvid').trigger('chosen:updated');
        }
        
        // Recarrega valores da terapia automaticamente
        carregaValores();
    }
}

// === CARREGA VALORES DE CRÉDITO/DÉBITO DA TERAPIA ===
function carregaValores(){
    let teraId = document.getElementById("atendTerapiaid").value;
    document.getElementById("creditTerapiaid").value = teraId;
    document.getElementById("debitTerapiaid").value = teraId;
    
    try {
        let convId = document.getElementById("atendConvid").value;
        if (convId && teraId && convId !== "766f69643132333435366964" && teraId !== "766f69643132333435366964") {
            let elCre = document.getElementById(convId+"/"+teraId+"/cre");
            let elDeb = document.getElementById(convId+"/"+teraId+"/deb");
            
            let valorCre = (elCre && elCre.value) ? elCre.value : "0,00";
            let valorDeb = (elDeb && elDeb.value) ? elDeb.value : "0,00";
            
            document.getElementById("atendValorcre").value = valorCre;
            document.getElementById("atendValordeb").value = valorDeb;
            document.getElementById("tabilValorcredit").value = valorCre;
            document.getElementById("tabilValordebit").value = valorDeb;
        }
    } catch(err) {
        console.log("Erro ao carregar valores:", err);
        document.getElementById("atendValorcre").value = "0,00";
        document.getElementById("atendValordeb").value = "0,00";
        document.getElementById("tabilValorcredit").value = "0,00";
        document.getElementById("tabilValordebit").value = "0,00";
    }
}

// === CARREGA VALORES DO MERGE ===
function carregaValoresMerge(){
    let teraId = document.getElementById("atendMergeTerapiaid").value;
    document.getElementById("creditMergeTerapiaid").value = teraId;
    document.getElementById("debitMergeTerapiaid").value = teraId;
    document.getElementById("tabilMergeTerapiaid").value = teraId;
    
    try {
        let convId = document.getElementById("atendConvid").value;
        if (convId && teraId && convId !== "766f69643132333435366964" && teraId !== "766f69643132333435366964") {
            let elCre = document.getElementById(convId+"/"+teraId+"/cre");
            let elDeb = document.getElementById(convId+"/"+teraId+"/deb");
            
            document.getElementById("atendMergevalorcre").value = (elCre && elCre.value) ? elCre.value : "0,00";
            document.getElementById("atendMergevalordeb").value = (elDeb && elDeb.value) ? elDeb.value : "0,00";
        }
    } catch(err) {
        console.log("Erro ao carregar valores merge:", err);
        document.getElementById("atendMergevalorcre").value = "0,00";
        document.getElementById("atendMergevalordeb").value = "0,00";
    }
}

// === ATUALIZA ID DO TERAPEUTA NOS CAMPOS OCULTOS ===
function atualizaTerapeutaId(){
    let ati = document.getElementById("atendTerapeutaid").value;
    document.getElementById("tabilTerapeutaId").value = ati;
}

function atualizaMergeTerapeutaId(){
    console.log("Merge terapeuta:", document.getElementById("atendMergeTerapeutaid").value);
}

// === FORMATA DATA PARA ISO ===
function atualizaData(){
    var hora = document.getElementById("atendHora").value;
    var data = document.getElementById("atenddata").value + "T" + hora + ":00.000Z";
    var datafmt = new Date(data);
    document.getElementById("atendAtenddata").value = datafmt.toISOString();
}

// === TOGGLE SUBSTITUTO FIXO ===
function toggleDivSubFixo(){
    document.getElementById("atendFixo").value = document.getElementById("atendFixoCheck").checked ? "true" : "false";
}

// === CARREGA BODY ===
function carregaBody(){
    // Aguarda um tick para garantir que o DOM esteja pronto
    setTimeout(function() {
        inicializaChosen();
        carregaValores();
    }, 100);
}
		</script>
