<!DOCTYPE html>
<html lang="pt-br">
<head>
	<title>Atendimentos</title>
	<meta charset="utf-8" />
	<!-- Select2 CSS (remova se já incluído globalmente) -->
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
	<!-- Se usar tema Bootstrap (aceAdmin), substitua pela versão compatível -->
	<!-- <link href="/assets/css/select2-bootstrap4.min.css" rel="stylesheet" /> -->

	<script type="text/javascript">
			document.addEventListener("DOMContentLoaded", function() {
			// Garante que listeners estão prontos
			var org = document.getElementById("atendOrg");
			var cat = document.getElementById("atendCategoria");

			if (org) org.addEventListener("change", controlaCategoria);
			if (cat) cat.addEventListener("change", function() {
				document.getElementById("tabilCategoria").value = this.value;
				atualizaSubFixo();
			});

			// Chama uma vez ao carregar (para estado inicial)
			setTimeout(controlaCategoria, 50);
		});
		// Funções auxiliares
		function selectConv(){
			var v1 = document.getElementById(document.getElementById("atendBeneid").value).value.toString();
			document.getElementById("atendConvid").value = v1;
			let convId = document.getElementById("atendConvid").value;
			document.getElementById("tabilConvid").value = convId;
		}

		function carregaValores(){
			let teraId = document.getElementById("atendTerapiaid").value;
			document.getElementById("creditTerapiaid").value = teraId;
			document.getElementById("debitTerapiaid").value = teraId;
			try{
				let convId = document.getElementById("atendConvid").value;
				document.getElementById("atendValorcre").value = document.getElementById(convId+"/"+teraId+"/cre").value;
				document.getElementById("atendValordeb").value = document.getElementById(convId+"/"+teraId+"/deb").value;
				document.getElementById("tabilValorcredit").value = document.getElementById(convId+"/"+teraId+"/cre").value;
				document.getElementById("tabilValordebit").value = document.getElementById(convId+"/"+teraId+"/deb").value;
			} catch(err){
				document.getElementById("atendValorcre").value = "0,00";
				document.getElementById("atendValordeb").value = "0,00";
				document.getElementById("tabilValorcredit").value = "0,00";
				document.getElementById("tabilValordebit").value = "0,00";
			}
			atualizaSubFixo();
		}

		function carregaValoresFixo(){
			let teraId = document.getElementById("atendFixoTerapiaid").value;
			document.getElementById("creditFixoTerapiaid").value = teraId;
			document.getElementById("debitFixoTerapiaid").value = teraId;
			try{
				let convId = document.getElementById("atendConvid").value;
				document.getElementById("atendFixovalorcre").value = document.getElementById(convId+"/"+teraId+"/cre").value;
				document.getElementById("atendFixovalordeb").value = document.getElementById(convId+"/"+teraId+"/deb").value;
				document.getElementById("tabilValorcredit").value = document.getElementById(convId+"/"+teraId+"/cre").value;
				document.getElementById("tabilValordebit").value = document.getElementById(convId+"/"+teraId+"/deb").value;
			} catch(err){
				document.getElementById("atendFixovalorcre").value = "0,00";
				document.getElementById("atendFixovalordeb").value = "0,00";
				document.getElementById("tabilValorcredit").value = "0,00";
				document.getElementById("tabilValordebit").value = "0,00";
			}
			atualizaSubFixo();
		}

		function carregaValoresMerge(){
			let teraId = document.getElementById("atendMergeTerapiaid").value;
			document.getElementById("creditMergeTerapiaid").value = teraId;
			document.getElementById("debitMergeTerapiaid").value = teraId;
			document.getElementById("tabilMergeTerapiaid").value = teraId;
			
			try{
				let convId = document.getElementById("atendConvid").value;
				document.getElementById("atendMergevalorcre").value = document.getElementById(convId+"/"+teraId+"/cre").value;
				document.getElementById("atendMergevalordeb").value = document.getElementById(convId+"/"+teraId+"/deb").value;
			} catch(err){
				document.getElementById("atendMergevalorcre").value = "0,00";
				document.getElementById("atendMergevalordeb").value = "0,00";
			}
			atualizaSubFixo();
		}

		function atualizaSubFixo(){
			if (document.getElementById("atendCategoria").value === "SubstitutoFixo") {
				document.getElementById("atendFixoCheck").checked = true;
				document.getElementById("divSubFixo").style.display = "";
			} else {
				document.getElementById("atendFixoCheck").checked = false;
				document.getElementById("divSubFixo").style.display = "none";
			}
		}

		function atualizaTerapeutaId(){
			let ati = document.getElementById("atendTerapeutaid").value;
			document.getElementById("tabilTerapeutaId").value = ati;
		}

		function atualizaData(){
			var hora = document.getElementById("atendHora").value;
			var data = document.getElementById("atenddata").value + "T" + hora + ":00.000Z";
			var datafmt = new Date(data);
			document.getElementById("atendAtenddata").value = datafmt.toISOString();
		}

		function toggleDivSubFixo(){
			if (document.getElementById("atendFixoCheck").checked) {
				document.getElementById("divSubFixo").style.display = "";
				document.getElementById("atendFixo").value = "true";
			} else {
				document.getElementById("divSubFixo").style.display = "none";
				document.getElementById("atendFixo").value = "false";
			}
		}

		function carregaBody(){
			carregaValores();
			// Garante que o estado inicial da categoria esteja correto
			controlaCategoria();
		}

		// ✅ FUNÇÃO ATUALIZADA PARA SELECT2 ✅
		function controlaCategoria() {
			const origem = document.getElementById("atendOrg").value;
			const selectEl = document.getElementById("atendCategoria");

			// ✅ Passo 1: Remove TODAS as opções atuais (antes de atualizar Chosen)
			selectEl.innerHTML = '';

			let opcoes = [];
			let valorPadrao = "Apoio";

			if (origem === "Padrão") {
				opcoes = [{ value: "Padrão", label: "Padrão" }];
				valorPadrao = "Padrão";
			} else {
				opcoes = [
					{ value: "Apoio", label: "Apoio" },
					{ value: "Extra", label: "Extra" },
					{ value: "Falta", label: "Falta" },
					{ value: "Falta Justificada", label: "Falta Justificada" },
					{ value: "Falta Absoluta", label: "Falta Absoluta" },
					{ value: "Feriado", label: "Feriado" },
					{ value: "Glosa", label: "Glosa" },
					{ value: "Pais", label: "Pais" },
					{ value: "Substituto", label: "Substituto" },
					{ value: "SubstitutoFixo", label: "Substituto Fixo" },
					{ value: "Supervisão", label: "Supervisão" }
				];
			}

			// ✅ Passo 2: Adiciona novas opções ao <select> REAL
			opcoes.forEach(opt => {
				const option = document.createElement("option");
				option.value = opt.value;
				option.textContent = opt.label;
				selectEl.appendChild(option);
			});

			// ✅ Passo 3: Define valor e campo oculto
			selectEl.value = valorPadrao;
			document.getElementById("tabilCategoria").value = valorPadrao;

			// ✅ Passo 4: Atualiza o Chosen (sem destruir/recriar — use .trigger("chosen:updated"))
			// Isso é o equivalente ao 'destroy + init' do Select2, mas para Chosen
			if (typeof $(selectEl).trigger === 'function') {
				$(selectEl).trigger("chosen:updated");
			}

			// ✅ Passo 5: Dispara lógica dependente
			atualizaSubFixo();

			// ✅ Passo 6: Força disparo de 'change' para garantir que `atualizaSubFixo()` rode com valor correto
			// (útil se `atualizaSubFixo` depender do valor do select)
			selectEl.dispatchEvent(new Event('change', { bubbles: true }));
		}	
	</script>

	<!-- Se já tem Select2 global, remova os links/scripts abaixo -->
	
</head>
