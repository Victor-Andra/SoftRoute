<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta charset="utf-8">
  <title>Relatório Detalhado por Convênio</title>
  
  <style>
    .custom-tooltip { position: relative; display: inline-block; cursor: pointer; }
    .tooltip-text {
      visibility: hidden; width: max-content; background-color: #f3dfdf; color: red; font-size: 8px;
      padding: 8px 12px; position: absolute; z-index: 9999; bottom: 125%; left: 50%;
      transform: translateX(-50%); opacity: 0.9; border-radius: 4px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }
    .tooltip-text::after {
      content: ""; position: absolute; top: 100%; left: 50%; margin-left: -5px;
      border-width: 5px; border-style: solid;
      border-color: #f3dfdf transparent transparent transparent;
    }
    .custom-tooltip:hover .tooltip-text { visibility: visible; }

    .detalhe-linha {
      background-color: #fafafa;
      display: none;
    }
    .detalhe-conteudo {
      padding: 12px 24px;
    }
    .linha-anomalia {
      background-color: #fff8e1 !important;
    }
    .btn-expand {
      cursor: pointer;
      color: #428bca; /* azul do aceAdmin */
      font-size: 16px;
    }
  </style>
</head>

<body onload="javascript:controlaNave(); carregaBody();" class="no-skin">
  <div class="main-container ace-save-state" id="main-container">
    <div class="main-content">
      <div class="main-content-inner">
        <div class="breadcrumbs ace-save-state" id="breadcrumbs">
          <ul class="breadcrumb">
            <li><i class="ace-icon fa fa-home home-icon"></i> <a href="#">Home</a></li>
            <li class="active">Relatório Detalhado por Convênio</li>
          </ul>
        </div>

        <!-- Formulário -->
        <form role="form" action="/menu/atendimento/tabdimAtendimentoValFiltro" method="POST" onsubmit="atualizaDataIni(); atualizaDataFin();">
          <div class="row" style="margin: 0 12px 20px;">
            <div class="col-sm-12">
              <label>Período de:</label>
              <input style="height: 30px; width: 140px;" id="dataFilDe" name="dataFilDe" type="date" onchange="atualizaDataIni()">
              <input class="hidden" id="dataIni" name="dataIni" value="{{filtro.dataIni}}">

              <label>até:</label>
              <input style="height: 30px; width: 140px;" id="dataFilAte" name="dataFilAte" type="date" onchange="atualizaDataFin()">
              <input class="hidden" id="dataFim" name="dataFim" value="{{filtro.dataFim}}">

              <label>Convênio:</label>
              <select style="height: 30px; width: 250px;" name="relConvid" id="relConvid" class="chosen-select">
                <option value="766f69643132333435366964">—</option>
                {{#each convs}}
                <option value="{{_id}}">{{conv_nome}}</option>
                {{/each}}
              </select>
              <input class="hidden" id="relConvIdFiltro" name="relConvIdFiltro" value="{{filtro.convId}}">

              <button class="btn btn-info btn-sm" type="submit">
                <i class="ace-icon fa fa-search bigger-110"></i> Pesquisar
              </button>
            </div>
          </div>
        </form>

        <!-- Tabela -->
        <div class="row">
          <div class="col-sm-12">
            <div class="widget-box">
              <div class="widget-header">
                <h4 class="widget-title">
                  <i class="ace-icon fa fa-bar-chart green"></i>
                  Tabela Dinâmica Consolidado por Convênio — {{conv_nome}}
                  <small class="text-muted">({{periodoDe}} a {{periodoAte}})</small>
                </h4>
                <span class="widget-toolbar">
                  <a href="#" data-action="reload"><i class="ace-icon fa fa-refresh"></i></a>
                  <a href="#" data-action="collapse"><i class="ace-icon fa fa-chevron-up"></i></a>
                </span>
              </div>

              <div class="widget-body">
                <div class="widget-main">
                  <div class="row">
                    <div class="col-xs-12">
                      <table class="table table-striped table-bordered table-hover">
                        <thead>
                          <tr>
                            <th style="width: 30px;"></th>
                            <th>Terapia</th>
                            <th class="text-right">Sessões</th>
                            <th class="text-right">Valor Unitário</th>
                            <th class="text-right">Valor Total</th>
                            <th>Ação</th>
                          </tr>
                        </thead>
                        <tbody>
                          {{#each rels}}
                          <!-- ✅ Linha principal com data-terapia-id -->
                          <tr data-terapia-id="{{terapiaId}}"
                            {{#if temFaltaAbsoluta}}class="linha-anomalia"{{/if}}
                            {{#if temFaltaJustificada}}class="linha-anomalia"{{/if}}
                            {{#if temValorDivergente}}class="linha-anomalia"{{/if}}
                          >
                            <td class="center">
                              <i class="btn-expand ace-icon fa fa-plus-circle bigger-140"></i>
                            </td>
                            <td>{{terapiaNome}}</td>
                            <td class="text-right">{{sessoes}}</td>
                            <td class="text-right">{{valorUnitario}}</td>
                            <td class="text-right">{{valorTotal}}</td>
                            <td class="center">
                              {{#if temFaltaAbsoluta}}
                              <span class="label label-danger label-sm">
                                <i class="ace-icon fa fa-ban"></i> Falta Absoluta
                              </span>
                              {{else if temFaltaJustificada}}
                              <span class="label label-warning label-sm">
                                <i class="ace-icon fa fa-exclamation-triangle"></i> Justificada
                              </span>
                              {{else if temValorDivergente}}
                              <span class="label label-orange label-sm">
                                <i class="ace-icon fa fa-money"></i> Valor divergente
                              </span>
                              {{/if}}
                            </td>
                          </tr>

                          <!-- ✅ Linha detalhe (imediatamente após) -->
                          <tr class="detalhe-linha">
                            <td colspan="6">
                              <div class="detalhe-conteudo">
                                <h5>
                                  <i class="ace-icon fa fa-list"></i> 
                                  Detalhes de "{{terapiaNome}}" ({{sessoes}} sessões)
                                </h5>
                                <table class="table table-condensed table-bordered">
                                  <thead>
                                    <tr>
                                      <th>Data</th>
                                      <th>Beneficiário</th>
                                      <th>Categoria</th>
                                      <th class="text-right">Valor</th>
                                      <th>Status</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    {{#each atendimentos}}
                                    <tr
                                      {{#if ehFaltaAbsoluta}}class="linha-anomalia"{{/if}}
                                      {{#if ehFaltaJustificada}}class="linha-anomalia"{{/if}}
                                    >
                                      <td>{{data}}</td>
                                      <td>{{bene_nome}}</td>
                                      <td>{{categoria}}</td>
                                      <td class="text-right">{{valorFormatado}}</td>
                                      <td>
                                        {{#if ehFaltaAbsoluta}}
                                        <span class="label label-danger">
                                          <i class="ace-icon fa fa-ban"></i> Falta Absoluta
                                        </span>
                                        {{else if ehFaltaJustificada}}
                                        <span class="label label-warning">
                                          <i class="ace-icon fa fa-exclamation-triangle"></i> Justificada
                                        </span>
                                        {{else}}
                                        <span class="label label-success">
                                          <i class="ace-icon fa fa-check"></i> OK
                                        </span>
                                        {{/if}}
                                      </td>
                                    </tr>
                                    {{/each}}
                                  </tbody>
                                </table>
                              </div>
                            </td>
                          </tr>
                          {{/each}}
                        </tbody>
                        <tfoot>
                          <tr>
                            <td colspan="2" class="text-right"><b>Total Geral:</b></td>
                            <td class="text-right"><b>{{total.sessoes}}</b></td>
                            <td class="text-right">—</td>
                            <td class="text-right"><b>{{total.total}}</b></td>
                            <td></td>
                          </tr>
                        </tfoot>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ✅ Script corrigido: toggle por nextElementSibling -->
  <script>
    function atualizaDataIni() {
      const v = document.getElementById('dataFilDe').value;
      if (v) document.getElementById('dataIni').value = v + ' 00:00:00.000Z';
    }
    function atualizaDataFin() {
      const v = document.getElementById('dataFilAte').value;
      if (v) document.getElementById('dataFim').value = v + ' 00:00:00.000Z';
    }
    function carregaBody() {
      const ini = document.getElementById('dataIni').value;
      const fim = document.getElementById('dataFim').value;
      if (ini) document.getElementById('dataFilDe').value = ini.split(' ')[0];
      if (fim) document.getElementById('dataFilAte').value = fim.split(' ')[0];
      
      const convId = document.getElementById('relConvIdFiltro').value || '766f69643132333435366964';
      document.getElementById('relConvid').value = convId;
      
      if (typeof $.fn.chosen === 'function') {
        $('.chosen-select').trigger('chosen:updated');
      }
    }

    // ✅ Toggle robusto usando nextElementSibling
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.btn-expand').forEach(btn => {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const icon = this;
          const mainRow = icon.closest('tr'); // linha da terapia
          const detailRow = mainRow.nextElementSibling; // próxima <tr> (detalhe)

          if (!detailRow || !detailRow.classList.contains('detalhe-linha')) return;

          const isExpanded = detailRow.style.display === 'table-row';
          
          if (isExpanded) {
            detailRow.style.display = 'none';
            icon.classList.replace('fa-minus-circle', 'fa-plus-circle');
          } else {
            detailRow.style.display = 'table-row';
            icon.classList.replace('fa-plus-circle', 'fa-minus-circle');
          }
        });
      });
    });
  </script>
</body>
</html>