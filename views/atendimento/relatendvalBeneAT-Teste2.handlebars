<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta charset="utf-8">
  <title>Relatório Analítico de Atendimentos por Beneficiário</title>

  <!-- Bootstrap / Ace Admin (mantenha os links do seu projeto) -->
  <!-- <link rel="stylesheet" href="assets/css/bootstrap.min.css" /> -->
  <!-- <link rel="stylesheet" href="assets/css/font-awesome.min.css" /> -->
  <!-- <link rel="stylesheet" href="assets/css/ace.min.css" /> -->

  <style>
    /* ============================================================
       TABELA – respeita larguras e quebra texto
       ============================================================ */
    table.table-bordered {
      width: 100% !important;
      border-collapse: collapse !important;
    }
    table.table-bordered td,
    table.table-bordered th {
      word-wrap: break-word !important;
      overflow-wrap: break-word !important;
      vertical-align: middle !important;
    }

    /* ============================================================
       BARRA DE PESQUISA (NÃO ALTERAR – padronizada)
       ============================================================ */
    .toolbar-pesquisa{background:linear-gradient(135deg,#21e2f3 0%,#1976d2 100%);color:#fff;padding:15px;border-radius:8px;margin:0 12px 20px 12px;box-shadow:0 4px 6px rgba(0,0,0,.1);border:1px solid #1976d2}
    .toolbar-pesquisa h5{margin:0 0 12px 0;font-size:14px;font-weight:600;display:flex;align-items:center;gap:8px}
    .toolbar-pesquisa h5 i{font-size:18px}
    .toolbar-pesquisa .form-inline{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end}
    .toolbar-pesquisa .form-row{display:flex;flex-wrap:wrap;gap:12px;width:100%;align-items:flex-end}
    .toolbar-pesquisa .form-group{margin:0;display:flex;flex-direction:column;align-items:flex-start;min-width:140px;flex:1;max-width:220px}
    .toolbar-pesquisa label{font-size:11px;font-weight:500;margin-bottom:4px;color:#f8f9fa;white-space:nowrap}
    .toolbar-pesquisa input[type="date"],.toolbar-pesquisa input[type="time"],.toolbar-pesquisa select{padding:6px 10px;border:2px solid #e2e8f0;border-radius:4px;font-size:12px;width:100%;box-sizing:border-box;background:#fff;color:#333;transition:all .3s;height:30px}
    .toolbar-pesquisa input:focus,.toolbar-pesquisa select:focus{border-color:#fff;box-shadow:0 0 0 3px rgba(255,255,255,.2);outline:none}
    .toolbar-pesquisa .btn-pesquisar{background:#dc3545;color:#fff;border:none;padding:8px 24px;border-radius:4px;font-weight:600;font-size:13px;cursor:pointer;transition:all .3s;display:flex;align-items:center;gap:6px;box-shadow:0 2px 4px rgba(0,0,0,.2);margin-left:auto}
    .toolbar-pesquisa .btn-pesquisar:hover{background:#c82333;transform:translateY(-2px);box-shadow:0 4px 8px rgba(0,0,0,.3)}
    .grupo-horario{display:flex;gap:6px;align-items:flex-end;flex-wrap:wrap}
    .grupo-horario .form-group{min-width:70px;max-width:90px;flex:none}
    .grupo-horario label{font-size:10px}
    .toolbar-pesquisa .chosen-container .chosen-single{border:2px solid #e2e8f0!important;border-radius:4px!important;box-shadow:none!important;background:#fff!important;height:30px!important;line-height:28px!important;font-size:12px!important}
    .toolbar-pesquisa .chosen-container-active.chosen-with-drop .chosen-single{border-color:#fff!important}
    .toolbar-pesquisa .chosen-container .chosen-drop{border:1px solid #ced4da!important;border-top:none!important;box-shadow:0 2px 8px rgba(0,0,0,.1)!important}

    /* ============================================================
       CABEÇALHO DO RELATÓRIO (cards)
       ============================================================ */
    .relatorio-wrapper{padding:0 12px}
    .rel-header{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:14px;
      margin-bottom:18px;
    }
    .rel-card{
      background:#fff;
      border:1px solid #e3e6ea;
      border-left:4px solid #1976d2;
      border-radius:6px;
      padding:14px 18px;
      box-shadow:0 1px 3px rgba(0,0,0,.04);
    }
    .rel-card.alt{border-left-color:#28a745}
    .rel-card h4{
      margin:0 0 10px 0;
      font-size:13px;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:.5px;
      color:#1976d2;
      display:flex;align-items:center;gap:8px;
      border-bottom:1px solid #eef0f3;
      padding-bottom:8px;
    }
    .rel-card.alt h4{color:#218838}
    .rel-card .rel-line{
      font-size:12.5px;
      color:#333;
      margin:4px 0;
      display:flex;gap:6px;
    }
    .rel-card .rel-line strong{color:#555;min-width:95px;display:inline-block}

    /* Faixa título da tabela */
    .tabela-titulo{
      background:linear-gradient(90deg,#1976d2,#21e2f3);
      color:#fff;
      padding:10px 16px;
      border-radius:6px 6px 0 0;
      font-size:13px;
      font-weight:600;
      letter-spacing:.4px;
      display:flex;align-items:center;gap:8px;
      text-transform:uppercase;
    }

    /* Tabela atendimentos */
    .tbl-atendimentos{
      width:100%;
      border-collapse:collapse;
      background:#fff;
      border:1px solid #e3e6ea;
      border-top:none;
      border-radius:0 0 6px 6px;
      overflow:hidden;
      box-shadow:0 1px 3px rgba(0,0,0,.04);
    }
    .tbl-atendimentos thead th{
      background:#f4f6f9;
      color:#37475a;
      font-size:11.5px;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:.4px;
      padding:10px 12px;
      border-bottom:2px solid #1976d2;
      text-align:left;
    }
    .tbl-atendimentos tbody td{
      padding:9px 12px;
      font-size:12.5px;
      color:#333;
      border-bottom:1px solid #eef0f3;
    }
    .tbl-atendimentos tbody tr:nth-child(even) td{background:#fbfcfd}
    .tbl-atendimentos tbody tr:hover td{background:#eef6ff}

    .col-data{width:140px;white-space:nowrap;font-weight:600;color:#1976d2}
    .col-esp{width:32%}
    .col-prof{width:auto}

    /* Assinaturas */
    .assinaturas{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:60px;
      margin-top:60px;
      padding:0 40px;
    }
    .assinatura{
      text-align:center;
      font-size:12px;
      color:#333;
    }
    .assinatura .linha{
      border-top:1px solid #333;
      margin-bottom:6px;
      padding-top:6px;
    }

    /* Cabeçalho impressão */
    .print-header{display:none}

    /* ============================================================
       IMPRESSÃO
       ============================================================ */
    @media print{
      *{
        -webkit-print-color-adjust:exact!important;
        print-color-adjust:exact!important;
        color-adjust:exact!important;
      }
      .noprint{display:none!important}
      body{margin:0;padding-top:14mm;padding-bottom:10mm;font-size:9.5pt!important;background:#fff}

      .print-header{
        display:block;
        position:fixed;top:0;left:0;right:0;
        text-align:center;font-size:10px;
        padding:4px 0;background:#fff;
        border-bottom:1px solid #ccc;
        z-index:9999;
      }

      @page{
        margin:1cm;
        @top-center{content:"Página " counter(page) " de " counter(pages);font-size:10px;color:#000}
        @bottom-center{content:""}
      }

      .relatorio-wrapper{padding:0}
      .rel-card{box-shadow:none;break-inside:avoid}
      .tabela-titulo{background:#1976d2!important;color:#fff!important}
      .tbl-atendimentos thead{display:table-header-group}
      .tbl-atendimentos tr{break-inside:avoid}
      .tbl-atendimentos tbody tr:nth-child(even) td{background:#f4f6f9!important}

      .label-info{background:#17a2b8!important;color:#fff!important;border-color:#138496!important}
      .label-success{background:#28a745!important;color:#fff!important;border-color:#218838!important}
      .label-warning{background:#ffc107!important;color:#212529!important;border-color:#e0a800!important}
      .blue{color:#1976d2!important}
      .green{color:#28a745!important}

      .assinaturas{margin-top:40px;break-inside:avoid}
    }
  </style>
</head>
<body>

  <!-- Cabeçalho fixo de impressão -->
  <div class="print-header">
    <strong>Route Centro de Terapia</strong> &nbsp;|&nbsp;
    Relatório Analítico de Atendimentos por Beneficiário
  </div>

  <!-- ====================================================
       BREADCRUMB / TÍTULO (tela)
       ==================================================== -->
  <div class="noprint" style="padding:12px 12px 0">
    <ul class="breadcrumb" style="background:transparent;padding:0;margin:0 0 6px">
      <li><i class="ace-icon fa fa-home home-icon"></i><a href="#">Home</a></li>
      <li class="active">Relatório de Atendimentos por Beneficiário</li>
    </ul>
    <h3 style="margin:0 0 14px;color:#1976d2;font-weight:600">
      <i class="ace-icon fa fa-file-text-o"></i>
      Relatório de Atendimentos por Beneficiário
    </h3>
  </div>

  <!-- ====================================================
       TOOLBAR DE PESQUISA  (NÃO MEXER – padronizada)
       ==================================================== -->
  <div class="toolbar-pesquisa noprint">
    <h5><i class="ace-icon fa fa-filter"></i> Filtros do Relatório</h5>
    <div class="form-inline">
      <div class="form-row">
        <div class="form-group">
          <label>Período de:</label>
          <input type="date" id="periodoDe">
        </div>
        <div class="form-group">
          <label>até:</label>
          <input type="date" id="periodoAte">
        </div>
        <div class="form-group">
          <label>Beneficiário:</label>
          <select id="beneficiario" class="chosen-select">
            {{#each benes}}
              <option value="{{_id}}">{{bene_nome}}</option>
            {{/each}}
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group" style="max-width:140px">
          <label>Exibir:</label>
          <select id="exibir">
            <option value="horas">Horas</option>
            <option value="resumo">Resumo</option>
          </select>
        </div>
        <div class="form-group" style="max-width:120px">
          <label>Inativos:</label>
          <select id="inativos">
            <option value="nao">Não</option>
            <option value="sim">Sim</option>
          </select>
        </div>

        <div class="grupo-horario">
          <div class="form-group">
            <label>Turno:</label>
            <select id="turno">
              <option value="auto">Auto</option>
              <option value="manha">Manhã</option>
              <option value="tarde">Tarde</option>
              <option value="dia">Dia</option>
            </select>
          </div>
          <div class="form-group"><label>Início:</label><input type="time" id="ini"></div>
          <div class="form-group"><label>Fim:</label><input type="time" id="fim"></div>
          <div class="form-group"><label>Início D:</label><input type="time" id="iniD"></div>
          <div class="form-group"><label>Fim D:</label><input type="time" id="fimD"></div>
        </div>

        <button type="button" class="btn-pesquisar">
          <i class="ace-icon fa fa-search"></i> Pesquisar
        </button>
      </div>
    </div>
  </div>

  <!-- ====================================================
       CONTEÚDO DO RELATÓRIO
       ==================================================== -->
  <div class="relatorio-wrapper">

    {{#each rels}}
    <!-- Cabeçalho com cards -->
    <div class="rel-header">
      <div class="rel-card">
        <h4><i class="ace-icon fa fa-hospital-o"></i> Informações do Prestador</h4>
        <div class="rel-line"><strong>Prestador:</strong> Route Centro de Terapia</div>
        <div class="rel-line"><strong>CNPJ:</strong> 33.346.423/0001-17</div>
      </div>

      <div class="rel-card alt">
        <h4><i class="ace-icon fa fa-user"></i> Informações do Relatório</h4>
        <div class="rel-line"><strong>Período:</strong> {{periodoDe}} até {{periodoAte}}</div>
        <div class="rel-line"><strong>Beneficiário:</strong> {{bene_nome}}</div>
        <div class="rel-line"><strong>Convênio:</strong> {{conv_nome}}</div>
      </div>
    </div>

    <!-- Tabela de Atendimentos -->
    <div class="tabela-titulo">
      <i class="ace-icon fa fa-calendar-check-o"></i>
      Informações dos Atendimentos
    </div>

    <table class="tbl-atendimentos table-bordered">
      <thead>
        <tr>
          <th class="col-data">Data do Atendimento</th>
          <th class="col-esp">Especialidade</th>
          <th class="col-prof">Profissional</th>
        </tr>
      </thead>
      <tbody>
        {{#each atendimentos}}
        <tr>
          <td class="col-data">{{dt}}</td>
          <td>
            {{#each ../terapias}}{{#ifEqual this._id ../especialidade}}{{terapia_nomecid}}{{/ifEqual}}{{/each}}
          </td>
          <td>
            {{#each ../terapeutas}}{{#ifEqual this._id ../profissional}}{{usuario_nomecompleto}}{{/ifEqual}}{{/each}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- Assinaturas -->
    <div class="assinaturas">
      <div class="assinatura">
        <div class="linha"></div>
        Assinatura do Responsável
      </div>
      <div class="assinatura">
        <div class="linha"></div>
        Assinatura da Clínica
      </div>
    </div>
    {{/each}}

  </div>

</body>
</html>
