<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Relatório Analítico de Atendimentos por Beneficiário</title>
		<style>
			/* Estilos para tela */
			@media screen {
				.print-header {
					display: none;
				}
			}

			/* Estilos para impressão */
			@media print {
				.noprint {
					display: none !important;
				}

				/* Cabeçalho fixo com paginação no topo */
				.print-header {
					position: fixed;
					top: 0;
					left: 0;
					right: 0;
					text-align: center;
					font-size: 11px;
					padding: 4px 0;
					background: white;
					z-index: 9999;
					content: "Página " counter(page) " de " counter(pages);
				}

				/* Margem superior para não sobrepor conteúdo */
				body {
					margin-top: 12mm; /* suficiente para o cabeçalho */
					margin-bottom: 10mm;
				}

				/* Configuração da página: permite retrato ou paisagem conforme escolha do usuário */
				@page {
					margin: 1cm;
					/* NÃO defina `size` aqui — isso bloqueia a orientação! */
					@top-center {
						content: "Página " counter(page) " de " counter(pages);
						font-size: 11px;
						color: black;
					}
					@bottom-center {
						content: ""; /* remove qualquer rodapé automático */
					}
				}

				/* Garante que elementos grandes não quebrem mal */
				table {
					page-break-inside: avoid;
				}
			}
		</style>
		<script>
			function carregaBody(){
				//Filtro persistente
				document.getElementById('dataFilDe').value = document.getElementById('dataIni').value.replace(" 00:00:00.000Z", "") || new Date().toISOString().split('T')[0];
				document.getElementById('dataFilAte').value = document.getElementById('dataFim').value.replace(" 00:00:00.000Z", "") || new Date().toISOString().split('T')[0];
			}
		</script>
	</head>
	<body onload="javascript:controlaNave();carregaBody();"  class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content"><!-- /main-container -->
				<div class="main-content-inner noprint"><!-- /main-content-inner -->
					<div class="breadcrumbs ace-save-state noprint" id="breadcrumbs_home" ><!-- /breadcrumbs -->
						<ul class="breadcrumb"><!-- /breadcrumbs -->
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Relatório de Atendimentos por Beneficiário</li>
						</ul>
					</div><!-- /.breadcrumbs -->
					

					<form style="font-size: 11px;" role="form" action="/menu/atendimento/relatendbenes" method="POST"><!-- /form -->
						<div class="breadcrumbs" id="breadcrumbs" style="align-items: center; text-align: center;"><!-- /breadcrumbs -->
							<ul class="breadcrumb">
								<label>Período de:</label>
								<input style="height: 30px;" id="dataFilDe" name="dataFilDe" type="date" onchange="javascript:atualizaDataIni()">
								<input class="hidden" id="dataIni" name="dataIni" value="{{filtro.dataIni}}"/>
								<label>até:</label>
								<input style="height: 30px;" id="dataFilAte" name="dataFilAte" type="date" onchange="javascript:atualizaDataFin()">
								<input class="hidden" id="dataFim" name="dataFim" value="{{filtro.dataFim}}"/>
								<label>Beneficiário: </label>
								<select style="height: 30px; width:300px;" name="relBeneid" id="relBeneid" class="chosen-select" data-placeholder="Escolha..." value="{{filtro.relConvid}}">
									{{#each benes}}
									<option value="{{_id}}">{{bene_nome}}</option>
									{{/each}}
								</select>
								&nbsp;&nbsp;&nbsp;&nbsp;
								<label class="control-label bolder red">
									<select name="porHoras" id="porHoras" class="chosen-select" value="">
										<option value="nao">Não</option>
										<option value="sim">Sim</option>
									</select>
									<span class="lbl">&nbsp;Mostrar horas?</span>
								</label>
								&nbsp;&nbsp;&nbsp;&nbsp;
								<label class="control-label bolder red">
									<select name="exibeInativos" id="exibeInativos" class="chosen-select" value="">
										<option value="sim">Sim</option>
										<option value="nao">Não</option>
									</select>
									<span class="lbl">&nbsp;Exibir Inativos?</span>
								</label>
								<button class="btn btn-info" name="acaoSalvar" id="acaoSalvar" type="submit">
									<i class="ace-icon fa fa-search bigger-110"></i>
									Pesquisar
								</button>
							</ul>
							<!-- /.breadcrumb -->
						</div><!-- /.breadcrumbs -->
					</form><!-- /.form -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->
			<div class="row"><!-- /row -->
				<div class="col-xs-12"><!-- /col-xs-12 -->
					<!-- PAGE CONTENT BEGINS -->
					<div class="space-6"></div>
					<div class="row">
						<!-- /row -->
						<div class="col-sm-10 col-sm-offset-1">
							<!-- /col-sm-10 col-sm-offset-1 -->

							<div class="widget-box transparent">
								<!-- /widget-box transparent -->

								<div style="text-align: center;">
									<!-- /text-align center -->
									<img width="140" height="60" alt="150x150" src="/images/gallery/logo_route_centro.png">
								</div>
								<!-- /.text-align center -->

								<div class="widget-header widget-header-large">
									<!-- /widget-header -->
									<h3 class="widget-title grey lighter">
										<i class="ace-icon fa fa-leaf green"></i>
										Atendimentos por Beneficiário
									</h3>
								</div>
								<!-- /.widget-header -->

								<div class="widget-body">
									<!-- /widget-body -->
									<div class="widget-main padding-24">
										<!-- /widget-main padding-24 -->
										<div class="row">
											<!-- /row -->
											<div class="col-sm-12">
												<!-- /col-sm-12 -->

												<div class="row">
													<!-- /row -->
													<div class="col-xs-12 label label-lg label-info arrowed-in arrowed-right">
														<!-- /col-xs-12 label -->
														<b>Informações do Prestador</b>
													</div>
													<!-- /.col-xs-12 label -->
												</div>
												<!-- /.row -->

												<div>
													<!-- /informacoes prestador -->
													<ul class="list-unstyled">
														<li>
															<i class="ace-icon fa fa-caret-right blue"></i><b>Prestador: </b>Route Centro de Terapia e Apoio Infantil
														</li>
														<li>
															<i class="ace-icon fa fa-caret-right blue"></i><b>CNPJ: </b> 33.346.423/0001-17
														</li>
													</ul>
												</div>
												<!-- /.informacoes prestador -->

												<div class="row">
													<!-- /row -->
													<div class="col-xs-12 label label-lg label-success arrowed-in arrowed-right">
														<!-- /col-xs-12 label -->
														<b>Informações do Relatório</b>
													</div>
													<!-- /.col-xs-12 label -->
												</div>
												<!-- /.row -->

												<div>
													<!-- /informacoes relatorio -->
													<ul class="list-unstyled">
														<li>
															<i class="ace-icon fa fa-caret-right green"></i><b>Período de: </b>{{periodoDe}}<b> até: </b>{{periodoAte}}
														</li>
														<li>
															<i class="ace-icon fa fa-caret-right green"></i><b>Beneficiário: </b>{{bene_nome}}
														</li>
														<li>
															<i class="ace-icon fa fa-caret-right green"></i><b>Convênio:</b> {{conv_nome}}
														</li>
													</ul>
												</div>
												<!-- /.informacoes relatorio -->

												<div class="row"><!-- /row -->
													<div class="col-xs-12 label label-lg label-warning arrowed-in arrowed-right"><!-- /col-xs-12 label -->
														<b>Informações dos Atendimentos</b>
													</div><!-- /.col-xs-12 label -->
												</div><!-- /.row -->
											</div><!-- /.col-sm-12 -->
											
										</div><!-- /.row -->
										<div class="page"><!-- /page -->
											<table class="table table-striped table-bordered" style="font-size: 11px;">
												<thead>
												<tr>
													<th>Data do Atendimento</th>
													<th>Especialidade</th>
													<th>Profissional</th>
												</tr>
												</thead>
												<tbody>
												{{#each rels}}
													<tr>
													<td>{{dt}}</td>
													{{#each ../terapias}}
														{{#ifEqual this._id ../especialidade}}
														<td>{{terapia_nomecid}}</td>
														{{/ifEqual}}
													{{/each}}
													{{#each ../terapeutas}}
														{{#ifEqual this._id ../profissional}}
														<td>{{usuario_nomecompleto}}</td>
														{{/ifEqual}}
													{{/each}}
													</tr>
												{{/each}}
												</tbody>
												
											</table>
											
										</div><!-- /.page -->
									
									</div>
									<!-- /.widget-main padding-24 -->
								</div>
								<!-- /.widget-body -->
								
							</div>
							<!-- /.widget-box transparent -->

						</div>
						<!-- /.col-sm-10 col-sm-offset-1 -->
					</div>
					<!-- /.row -->

					<!-- PAGE CONTENT ENDS -->
				</div>
				
				<!-- /.col-xs-12 -->
			</div><!-- /.row -->
			

		</div><!-- /.main-container -->
		

<!-- basic scripts -->
		
		<div class="row">
			<div class="col-xs-12">
				<div style="margin-top: 32px;"></div>
				<div class="row">
					<div class="col-xs-4 col-sm-4 text-center">
						<div class="hr"></div>
						<label>Assinatura do Responsável</label>
					</div>
					<div class="col-xs-4 col-sm-4"></div>
					<div class="col-xs-4 col-sm-4 text-center">
						<div class="hr"></div>
						<label>Assinatura da Clínica</label>
					</div>
				</div>
			</div>
		</div>
			
		<!-- Cabeçalho de impressão (paginação no topo) -->
		<div class="print-header"></div>

		<!-- Página em branco única no final -->
		<div style="page-break-before: always;"></div>
		<script type="text/javascript">
			function atualizaDataIni(){
				let fulldate = (document.getElementById('dataFilDe').value+' 00:00:00.000Z').toString();
				document.getElementById('dataIni').value = fulldate;
			}
			function atualizaDataFin(){
				let fulldate = (document.getElementById('dataFilAte').value+' 00:00:00.000Z').toString();
				document.getElementById('dataFim').value = fulldate;
			}
		
			function restaurarFiltro(filtro) {
				if (!filtro) return;

				// Atualiza os campos VISÍVEIS
				if (filtro.dataIni) {
					// Formato esperado: YYYY-MM-DD (para input type="date")
					const dataIniFormatada = filtro.dataIni.split('T')[0]; // remove hora
					document.getElementById('dataFilDe').value = dataIniFormatada;
				}
				if (filtro.dataFim) {
					const dataFimFormatada = filtro.dataFim.split('T')[0];
					document.getElementById('dataFilAte').value = dataFimFormatada;
				}
				if (filtro.convenioId) {
					document.getElementById('relConvid').value = filtro.convenioId;
				}
			}

			document.addEventListener('DOMContentLoaded', () => {
				const filtro = {{#if filtro}} {{{json filtro}}} {{else}} null {{/if}};
				restaurarFiltro(filtro);
			});
		</script>
	</body>

</html>
