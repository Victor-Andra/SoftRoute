    <!-- 🔹 SCRIPTS -->
    <script type="text/javascript">
      function atualizaDataIni(){
        let fulldate = (document.getElementById('dataFilDe').value+' 00:00:00.000Z').toString();
        document.getElementById('dataIni').value = fulldate;
      }
      function atualizaDataFin(){
        let fulldate = (document.getElementById('dataFilAte').value+' 00:00:00.000Z').toString();
        document.getElementById('dataFim').value = fulldate;
      }

      function restaurarFiltro(filtro) {
        if (!filtro) return;
        if (filtro.dataIni) document.getElementById('dataFilDe').value = filtro.dataIni.split('T')[0];
        if (filtro.dataFim) document.getElementById('dataFilAte').value = filtro.dataFim.split('T')[0];
        if (filtro.relBeneid) document.getElementById('relBeneid').value = filtro.relBeneid;
        if (filtro.porHoras) document.getElementById('porHoras').value = filtro.porHoras;
        if (filtro.exibeInativos) document.getElementById('exibeInativos').value = filtro.exibeInativos;
        if (filtro.horaInicialSet !== undefined) document.getElementById('horaInicialSet').value = filtro.horaInicialSet;
        if (filtro.horaFinalSet !== undefined) document.getElementById('horaFinalSet').value = filtro.horaFinalSet;
        if (filtro.turnoSet !== undefined) document.getElementById('turnoSet').value = filtro.turnoSet;
        
        // Atualiza Chosen se disponível
        if (typeof $('.chosen-select').chosen === 'function') {
          $('.chosen-select').trigger('chosen:updated');
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        const filtro = {{#if filtro}} {{{json filtro}}} {{else}} null {{/if}};
        restaurarFiltro(filtro);
        
        // Inicializa Chosen
        if (typeof $('.chosen-select').chosen === 'function') {
          $('.chosen-select').chosen({
            width: '100%',
            disable_search_threshold: 10,
            allow_single_deselect: true,
            no_results_text: 'Nenhum resultado'
          });
        }
      });
    </script>
