  <script>
    function carregaBody() {
      const urlParams = new URLSearchParams(window.location.search);
      const dataIni = urlParams.get('dataIni');
      const dataFim = urlParams.get('dataFim'); 
      if (dataIni) document.getElementById('dataFilDe').value = dataIni;
      if (dataFim) document.getElementById('dataFilAte').value = dataFim;

      // Controlar visibilidade dos containers baseado nos checkboxes
      controlarVisibilidade();
    }

    function controlarVisibilidade() {
      const chkGeral = document.getElementById('chkGeral').checked;
      const chkClinica = document.getElementById('chkClinica').checked;
      const chkExternos = document.getElementById('chkExternos').checked;

      document.getElementById('containerGeral').style.display = chkGeral ? 'block' : 'none';
      document.getElementById('containerClinica').style.display = chkClinica ? 'block' : 'none';
      document.getElementById('containerExternos').style.display = chkExternos ? 'block' : 'none';

      // Mostrar mensagem se nenhum checkbox estiver marcado
      const nenhumMarcado = !chkGeral && !chkClinica && !chkExternos;
      document.getElementById('mensagemVazia').style.display = nenhumMarcado ? 'block' : 'none';
    }

    // Event listeners para os checkboxes
    document.addEventListener('DOMContentLoaded', function() {
      document.getElementById('chkGeral').addEventListener('change', controlarVisibilidade);
      document.getElementById('chkClinica').addEventListener('change', controlarVisibilidade);
      document.getElementById('chkExternos').addEventListener('change', controlarVisibilidade);

      // Expansão das linhas de detalhes
      document.querySelectorAll('.btn-expand').forEach(btn => {
        btn.addEventListener('click', function() {
          const mainRow = this.closest('tr');
          const detailRow = mainRow.nextElementSibling;
          if (!detailRow || !detailRow.classList.contains('detalhe-linha')) return;

          const isExpanded = detailRow.style.display === 'table-row';
          detailRow.style.display = isExpanded ? 'none' : 'table-row';

          this.classList.toggle('fa-plus-circle', isExpanded);
          this.classList.toggle('fa-minus-circle', !isExpanded);
        });
      });

      // Capturar valores dos checkboxes antes de submeter o formulário
      document.getElementById('formFiltro').addEventListener('submit', function(e) {
        const checkboxes = ['geral', 'clinica', 'externos'];
        const selecionados = [];
        
        checkboxes.forEach(tipo => {
          const chk = document.querySelector(`input[value="${tipo}"]`);
          if (chk.checked) selecionados.push(tipo);
        });

        // Remover inputs antigos de 'mostrar'
        document.querySelectorAll('input[name="mostrar"]').forEach(el => el.remove());

        // Adicionar novo input com os valores selecionados
        if (selecionados.length > 0) {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'mostrar';
          input.value = selecionados.join(',');
          this.appendChild(input);
        }
      });
    });
  </script>
</body>
</html>