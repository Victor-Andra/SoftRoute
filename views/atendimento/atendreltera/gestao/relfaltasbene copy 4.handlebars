<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta charset="utf-8">
  <title>Relatório de Faltas por Beneficiário</title>

  <style>
    .detalhe-linha { background-color: #fafafa; display: none; }
    .detalhe-conteudo { padding: 12px 24px; }
    .btn-expand { cursor: pointer; color: #428bca; font-size: 16px; }
    
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
      height: 30px; padding: 3px 6px; font-size: 12px;
    }
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate { font-size: 12px; }

    .custom-tooltip { position: relative; display: inline-block; cursor: pointer; }
    .tooltip-text {
      visibility: hidden; width: max-content; background-color: #f3dfdf; color: red;
      font-size: 11px; text-align: left; border-radius: 4px; padding: 8px 12px;
      position: absolute; z-index: 9999; bottom: 125%; left: 50%;
      transform: translateX(-50%); opacity: 0.9; white-space: normal;
      min-width: 180px; max-width: 300px; box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      transition: opacity 0.3s;
    }
    .tooltip-text::after {
      content: ""; position: absolute; top: 100%; left: 50%; margin-left: -5px;
      border-width: 5px; border-style: solid;
      border-color: #f3dfdf transparent transparent transparent;
    }
    .custom-tooltip:hover .tooltip-text { visibility: visible; }
    
    .text-orange { color: #d15b47 !important; font-weight: bold; }

    /* Checkboxes de controle */
    .checkbox-container {
      background: #f9f9f9;
      border: 1px solid #ddd;
      border-radius: 4px;
      padding: 12px 20px;
      margin: 15px 0;
    }
    .checkbox-container label {
      margin-right: 25px;
      font-weight: normal;
      cursor: pointer;
    }
    .checkbox-container input[type="checkbox"] {
      margin-right: 5px;
      cursor: pointer;
    }

    /* Mensagem quando nenhum checkbox está marcado */
    .mensagem-vazia {
      text-align: center;
      padding: 40px 20px;
      color: #999;
      font-size: 14px;
    }
    .mensagem-vazia i {
      font-size: 48px;
      margin-bottom: 15px;
      display: block;
    }
  </style>
</head>

<body onload="javascript:controlaNave(); carregaBody();" class="no-skin">
  <div class="main-container ace-save-state" id="main-container">
    <div class="main-content">
      <div class="main-content-inner">

        <div class="breadcrumbs ace-save-state" id="breadcrumbs">
          <ul class="breadcrumb">
            <li><i class="ace-icon fa fa-home home-icon"></i> <a href="#">Home</a></li>
            <li class="active">Relatório de Faltas por Beneficiário</li>
          </ul>
        </div>

        <div class="page-content">

          <!-- FILTRO -->
          <form role="form" method="GET" id="formFiltro">
            <div class="row">
              <div class="col-sm-12">
                <br>
                <label>Período de:</label>
                <input style="height: 30px; width: 140px;" id="dataFilDe" name="dataIni" type="date">
                <label>até:</label>
                <input style="height: 30px; width: 140px;" id="dataFilAte" name="dataFim" type="date">
                <button class="btn btn-info btn-sm" type="submit">
                  <i class="ace-icon fa fa-search bigger-110"></i> Pesquisar
                </button>
              </div>
            </div>

            <!-- CHECKBOXES DE CONTROLE -->
            <div class="row">
              <div class="col-sm-12">
                <div class="checkbox-container">
                  <strong><i class="ace-icon fa fa-filter"></i> Exibir:</strong>&nbsp;&nbsp;
                  <label>
                    <input type="checkbox" name="mostrar" value="geral" id="chkGeral" {{#if mostrarGeral}}checked{{/if}}>
                    Geral
                  </label>
                  <label>
                    <input type="checkbox" name="mostrar" value="clinica" id="chkClinica" {{#if mostrarClinica}}checked{{/if}}>
                    Clínica
                  </label>
                  <label>
                    <input type="checkbox" name="mostrar" value="externos" id="chkExternos" {{#if mostrarExternos}}checked{{/if}}>
                    Externos
