<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta charset="utf-8">
  <title>Relatório de Faltas por Beneficiário</title>

  <style>
    .detalhe-linha { background-color: #fafafa; display: none; }
    .detalhe-conteudo { padding: 12px 24px; }
    .linha-anomalia { background-color: #fff8e1 !important; } /* se backend setar essa classe, aparecerá */
    .btn-expand { cursor: pointer; color: #428bca; font-size: 16px; }
    /* DataTables + aceAdmin */
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
      height: 30px;
      padding: 3px 6px;
      font-size: 12px;
    }
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate {
      font-size: 12px;
    }
  </style>
  <style>
    /* Tooltip personalizado */
    .custom-tooltip { position: relative; display: inline-block; cursor: pointer; }
    .tooltip-text {
      visibility: hidden; width: max-content; background-color: #f3dfdf; color: red;
      font-size: 8px; text-align: left; border-radius: 4px; padding: 8px 12px;
      position: absolute; z-index: 9999; bottom: 125%; left: 50%;
      transform: translateX(-50%); opacity: 0.9; white-space: normal;
      min-width: 150px; max-width: 300px; box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      transition: opacity 0.3s;
    }
    .tooltip-text::after {
      content: ""; position: absolute; top: 100%; left: 50%; margin-left: -5px;
      border-width: 5px; border-style: solid;
      border-color: #f3dfdf transparent transparent transparent;
    }
    .custom-tooltip:hover .tooltip-text { visibility: visible; }
  </style>
</head>

<body onload="javascript:controlaNave(); carregaBody();" class="no-skin">
  <div class="main-container ace-save-state" id="main-container">
    <div class="main-content">
      <div class="main-content-inner">

        <div class="breadcrumbs ace-save-state" id="breadcrumbs">
          <ul class="breadcrumb">
            <li><i class="ace-icon fa fa-home home-icon"></i> <a href="#">Home</a></li>
            <li class="active">Relatório de Faltas por Beneficiário</li>
          </ul>
        </div>

        <div class="page-content">

          <!-- FILTRO -->
          <form role="form" method="GET">
            <div class="row">
              <div class="col-sm-12">
                <br>
                <label>Período de:</label>
                <input style="height: 30px; width: 140px;" id="dataFilDe" name="dataIni" type="date">
                <label>até:</label>
                <input style="height: 30px; width: 140px;" id="dataFilAte" name="dataFim" type="date">
                <button class="btn btn-info btn-sm" type="submit">
                  <i class="ace-icon fa fa-search bigger-110"></i> Pesquisar
                </button>
              </div>
            </div>
          </form>

          <!-- TABELA -->
          <div class="row">
            <div class="col-sm-12">
              <div class="widget-box">
                <div class="widget-header">
                  <h4 class="widget-title">
                    <i class="ace-icon fa fa-user-md green"></i>
                    Faltas por Beneficiário
                    <small class="text-muted">({{periodoDe}} a {{periodoAte}})</small>
                  </h4>
                  <span class="widget-toolbar">
                    <a href="#" data-action="reload"><i class="ace-icon fa fa-refresh"></i></a>
                    <a href="#" data-action="collapse"><i class="ace-icon fa fa-chevron-up"></i></a>
                  </span>
                </div>

                <div class="widget-body">
                  <div class="widget-main">
                    <div class="row">
                      <div class="col-xs-12">

                        {{#if rels.length}}
                        <table id="tabela-faltas" class="table table-striped table-bordered table-hover">
                          <thead>
                            <tr>
                              <th style="width: 30px;"></th>
                              <th>Beneficiário</th>
                              <th>Convênio</th>
                              <th class="text-right"><span style="white-space: wrap;" class="badge badge-info">Registros</span></th>
                              <th class="text-right"><span style="white-space: wrap;" class="badge badge-yellow">Faltas</span></th>
                              <th class="text-right"><span style="white-space: wrap;" class="badge badge-danger">F. Justificada</span></th>
                              <th class="text-right"><span style="white-space: wrap;" class="badge badge-warning">F. Absoluta</span></th>
                              <th class="text-right"><span style="white-space: wrap;" class="badge badge-black">Feriado</span></th>
                              <th class="text-right">
                                <a class="purple custom-tooltip"><i class="ace-icon fa fa-eye bigger-130"></i>
                                  <span class="tooltip-text">
                                    <strong>Obs:</strong><br>
                                    O índice é gerado pela soma dos campos:<br>
                                    Faltas + F.Justificadas + F.Absolutas<br>
                                    Dividido pelo Total de Registros
                                  </span>
                                </a>
                                &nbsp;&nbsp;
                                <span style="white-space: wrap;" class="badge badge-purple">Índice</span>
                                
                              </th>
                            </tr>
                          </thead>

                          <tbody>
                            {{#each rels}}
                            <tr data-bene-id="{{bene_id}}">
                              <td class="center">
                                <i class="btn-expand ace-icon fa fa-plus-circle bigger-140"></i>
                              </td>
                              <td>{{bene_nome}}</td>
                              <td>{{convenio}}</td>
                              <td class="text-right">{{total_registros}}</td>
                              <td class="text-right">{{qt_falta}}</td>
                              <td class="text-right">{{qt_falta_jus}}</td>
                              <td class="text-right">{{qt_falta_abs}}</td>
                              <td class="text-right">{{qt_feriado}}</td>
                              <td class="text-right">
                                {{#if indice_faltas}}
                                  {{indice_faltas}}%
                                {{else}}
                                  —
                                {{/if}}
                              </td>
                            </tr>

                            <!-- DETALHES -->
                            <tr class="detalhe-linha">
                              <td colspan="9">
                                <div class="detalhe-conteudo">
                                  <h5>
                                    <i class="ace-icon fa fa-exclamation-triangle orange"></i>
                                    Lista de agendamentos, com faltas "{{bene_nome}}" — Convênio: "{{convenio}}"
                                  </h5>

                                  {{#if detalhes.length}}
                                  <table class="table table-condensed table-bordered" style="font-size:11px;">
                                    <thead>
                                      <tr>
                                        <th>Data</th>
                                        <th>Hora</th>
                                        <th>Terapia</th>
                                        <th>Terapeuta</th>
                                        <th>Categoria</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      {{#each detalhes}}
                                      <tr>
                                        <td style="white-space: nowrap;">{{data}}</td>
                                        <td>{{hora}}</td>
                                        <td>{{terapia}}</td>
                                        <td>{{terapeuta}}</td>
                                        <td>{{categoria}}</td>
                                      </tr>
                                      {{/each}}
                                    </tbody>
                                  </table>
                                  {{else}}
                                  <p class="text-muted">
                                    <i class="ace-icon fa fa-check green"></i>
                                    Nenhuma falta registrada.
                                  </p>
                                  {{/if}}

                                </div>
                              </td>
                            </tr>
                            {{/each}}
                          </tbody>
                        </table>

                        {{else}}
                        <div class="alert alert-info">
                          <i class="ace-icon fa fa-info-circle"></i>
                          Nenhum registro encontrado no período.
                        </div>
                        {{/if}}

                      </div>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script>
    /* Preenche datas da URL */
    function carregaBody() {
      const urlParams = new URLSearchParams(window.location.search);
      const dataIni = urlParams.get('dataIni');
      const dataFim = urlParams.get('dataFim'); 
      if (dataIni) document.getElementById('dataFilDe').value = dataIni;
      if (dataFim) document.getElementById('dataFilAte').value = dataFim;
    }

    /* Expansão das linhas */
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.btn-expand').forEach(btn => {
        btn.addEventListener('click', function() {
          const mainRow = this.closest('tr');
          const detailRow = mainRow.nextElementSibling;
          if (!detailRow || !detailRow.classList.contains('detalhe-linha')) return;

          const isExpanded = detailRow.style.display === 'table-row';
          detailRow.style.display = isExpanded ? 'none' : 'table-row';

          this.classList.toggle('fa-plus-circle', isExpanded);
          this.classList.toggle('fa-minus-circle', !isExpanded);
        });
      });
    });
  </script>
    
</body>
</html>