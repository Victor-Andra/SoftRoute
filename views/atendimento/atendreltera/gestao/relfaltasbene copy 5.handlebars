                                        <td class="{{#ifCond categoria '==' 'Falta Absoluta'}}text-orange{{else}}{{#ifCond categoria '==' 'Falta Justificada'}}text-orange{{/ifCond}}{{/ifCond}}">{{categoria}}</td>
                                      </tr>
                                      {{/each}}
                                    </tbody>
                                  </table>
                                  {{else}}
                                  <p class="text-muted"><i class="ace-icon fa fa-check green"></i> Nenhuma falta registrada.</p>
                                  {{/if}}
                                </div>
                              </td>
                            </tr>
                            {{/each}}
                          </tbody>
                          <tfoot>
                            <tr style="background-color: #e8f5e9; font-weight: bold; border-top: 3px solid #4caf50;">
                              <td></td>
                              <td colspan="2" class="text-right" style="vertical-align: middle;"><i class="ace-icon fa fa-calculator green"></i>&nbsp;CONSOLIDADO TOTAL</td>
                              <td class="text-right">{{totaisClinica.total_registros}}</td>
                              <td class="text-right">{{totaisClinica.qt_falta}}</td>
                              <td class="text-right">{{totaisClinica.qt_falta_jus}}</td>
                              <td class="text-right">{{totaisClinica.qt_falta_abs}}</td>
                              <td class="text-right">{{totaisClinica.qt_feriado}}</td>
                              <td class="text-right">{{totaisClinica.indice_faltas}}%</td>
                            </tr>
                          </tfoot>
