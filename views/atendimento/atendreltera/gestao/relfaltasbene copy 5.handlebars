<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta charset="utf-8">
  <title>Relatório de Faltas por Beneficiário</title>

  <!-- Certifique-se de que o CSS do Select2 está sendo carregado no seu layout principal (Ace Admin) -->
  
  <style>
    .detalhe-linha { background-color: #fafafa; display: none; }
    .detalhe-conteudo { padding: 12px 24px; }
    .btn-expand { cursor: pointer; color: #428bca; font-size: 16px; }
    
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
      height: 30px; padding: 3px 6px; font-size: 12px;
    }
    .dataTables_wrapper .dataTables_info,
    .dataTables_wrapper .dataTables_paginate { font-size: 12px; }

    .custom-tooltip { position: relative; display: inline-block; cursor: pointer; }
    .tooltip-text {
      visibility: hidden; width: max-content; background-color: #f3dfdf; color: red;
      font-size: 11px; text-align: left; border-radius: 4px; padding: 8px 12px;
      position: absolute; z-index: 9999; bottom: 125%; left: 50%;
      transform: translateX(-50%); opacity: 0.9; white-space: normal;
      min-width: 180px; max-width: 300px; box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      transition: opacity 0.3s;
    }
    .tooltip-text::after {
      content: ""; position: absolute; top: 100%; left: 50%; margin-left: -5px;
      border-width: 5px; border-style: solid;
      border-color: #f3dfdf transparent transparent transparent;
    }
    .custom-tooltip:hover .tooltip-text { visibility: visible; }
    
    .text-orange { color: #d15b47 !important; font-weight: bold; }

    .checkbox-container {
      background: #f9f9f9;
      border: 1px solid #ddd;
      border-radius: 4px;
      padding: 12px 20px;
      margin: 15px 0;
    }
    .checkbox-container label {
      margin-right: 25px;
      font-weight: normal;
      cursor: pointer;
    }
    .checkbox-container input[type="checkbox"] {
      margin-right: 5px;
      cursor: pointer;
    }

    .mensagem-vazia {
      text-align: center;
      padding: 40px 20px;
      color: #999;
      font-size: 14px;
    }
    .mensagem-vazia i {
      font-size: 48px;
      margin-bottom: 15px;
      display: block;
    }

    /* Estilo para o container do Select2 ficar alinhado */
    #containerSelectBene {
      margin-top: 10px;
      padding-left: 20px;
    }
  </style>
</head>

<body onload="javascript:controlaNave(); carregaBody();" class="no-skin">
  <div class="main-container ace-save-state" id="main-container">
    <div class="main-content">
      <div class="main-content-inner">

        <div class="breadcrumbs ace-save-state" id="breadcrumbs">
          <ul class="breadcrumb">
            <li><i class="ace-icon fa fa-home home-icon"></i> <a href="#">Home</a></li>
            <li class="active">Relatório de Faltas por Beneficiário</li>
          </ul>
        </div>

        <div class="page-content">

          <!-- FILTRO -->
          <form role="form" method="GET" id="formFiltro">
            <div class="row">
              <div class="col-sm-12">
                <br>
                <label>Período de:</label>
                <input style="height: 30px; width: 140px;" id="dataFilDe" name="dataIni" type="date">
                <label>até:</label>
                <input style="height: 30px; width: 140px;" id="dataFilAte" name="dataFim" type="date">
                <button class="btn btn-info btn-sm" type="submit">
                  <i class="ace-icon fa fa-search bigger-110"></i> Pesquisar
                </button>
              </div>
            </div>

            <!-- CHECKBOXES DE CONTROLE -->
            <div class="row">
             <div class="col-sm-12">
              <div class="checkbox-container" style="white-space: nowrap; overflow-x: auto;">
                <strong><i class="ace-icon fa fa-filter"></i> Exibir:</strong>&nbsp;&nbsp;
                <label style="display: inline-block; margin-right: 15px;">
                  <input type="checkbox" name="mostrar" value="geral" id="chkGeral" {{#if mostrarGeral}}checked{{/if}}>
                  Geral
                </label>
                <label style="display: inline-block; margin-right: 15px;">
                  <input type="checkbox" name="mostrar" value="clinica" id="chkClinica" {{#if mostrarClinica}}checked{{/if}}>
                  Clínica
                </label>
                <label style="display: inline-block; margin-right: 15px;">
                  <input type="checkbox" name="mostrar" value="externos" id="chkExternos" {{#if mostrarExternos}}checked{{/if}}>
                  Externos
                </label>
                
                <span style="border-left: 1px solid #ccc; margin: 0 15px; display: inline-block; height: 20px; vertical-align: middle;"></span>
                
                <label style="display: inline-block; margin-right: 15px; vertical-align: middle;">
                  <input type="checkbox" id="chkFiltrarBene" {{#if filtrarBene}}checked{{/if}}>
                  Filtrar por Beneficiário
                </label>
                
                <!-- SELECT2 (Oculto por padrão, inline quando visível) -->
                <div id="containerSelectBene" style="display: none; vertical-align: middle; width: 300px;">
                  <select id="selectBene" name="beneId" class="form-control" style="width: 100%;">
                    <option value="">Escolha um beneficiário...</option>
                    {{#each todosBenes}}
                      <option value="{{_id}}" {{#ifCond _id '==' ../beneIdSelecionado}}selected{{/ifCond}}>{{bene_nome}}</option>
                    {{/each}}
                  </select>
                </div>
              </div>
            </div>
            </div>
          </form>

          <!-- MENSAGEM: Nenhum container selecionado -->
          <div id="mensagemVazia" class="mensagem-vazia" style="display: none;">
            <i class="ace-icon fa fa-info-circle blue"></i>
            Selecione ao menos um tipo de relatório acima para visualizar.
          </div>

          <!-- MENSAGEM: Filtro de beneficiário ativo, mas nenhum escolhido (Opção A) -->
          <div id="msgEscolhaBene" class="mensagem-vazia" style="display: none;">
            <i class="ace-icon fa fa-user blue"></i>
            Selecione um beneficiário na lista acima para visualizar os dados.
          </div>

          <!-- ============================================ -->
          <!-- CONTAINER 1 — GERAL                          -->
          <!-- ============================================ -->
          <div id="containerGeral" class="row" style="display: none;">
            <div class="col-sm-12">
              <div class="widget-box">
                <div class="widget-header">
                  <h4 class="widget-title">
                    <i class="ace-icon fa fa-globe blue"></i>
                    Faltas por Beneficiário — Geral
                    <small class="text-muted">({{periodoDe}} a {{periodoAte}})</small>
                  </h4>
                  <span class="widget-toolbar">
                    <a href="#" data-action="reload"><i class="ace-icon fa fa-refresh"></i></a>
                    <a href="#" data-action="collapse"><i class="ace-icon fa fa-chevron-up"></i></a>
                  </span>
                </div>
                <div class="widget-body">
                  <div class="widget-main">
                    <div class="row">
                      <div class="col-xs-12">
                        {{#if relsGeral.length}}
                        <table class="table table-striped table-bordered table-hover">
                          <thead>
                            <tr>
                              <th style="width: 30px;"></th>
                              <th>Beneficiário</th>
                              <th>Convênio</th>
                              <th class="text-right"><span class="badge badge-info">Registros</span></th>
                              <th class="text-right"><span class="badge badge-yellow">Faltas</span></th>
                              <th class="text-right"><span class="badge badge-danger">F. Justificada</span></th>
                              <th class="text-right"><span class="badge badge-warning">F. Absoluta</span></th>
                              <th class="text-right"><span class="badge badge-black">Feriado</span></th>
                              <th class="text-right">
                                <a class="purple custom-tooltip"><i class="ace-icon fa fa-eye bigger-130"></i>
                                  <span class="tooltip-text">
                                    <strong>Obs:</strong><br>
                                    O índice é gerado pela soma:<br>
                                    Faltas + F.Absolutas + F.Justificadas<br>
                                    Dividido pelo Total de Registros
                                  </span>
                                </a>
                                &nbsp;&nbsp;
                                <span class="badge badge-purple">Índice</span>
                              </th>
                            </tr>
                          </thead>
                          <tbody>
                            {{#each relsGeral}}
                            <tr data-bene-id="{{bene_id}}">
                              <td class="center"><i class="btn-expand ace-icon fa fa-plus-circle bigger-140"></i></td>
                              <td>{{bene_nome}}</td>
                              <td>{{convenio}}</td>
                              <td class="text-right">{{total_registros}}</td>
                              <td class="text-right">{{qt_falta}}</td>
                              <td class="text-right">{{qt_falta_jus}}</td>
                              <td class="text-right">{{qt_falta_abs}}</td>
                              <td class="text-right">{{qt_feriado}}</td>
                              <td class="text-right">{{#if indice_faltas}}{{indice_faltas}}%{{else}}—{{/if}}</td>
                            </tr>
                            <tr class="detalhe-linha">
                              <td colspan="9">
                                <div class="detalhe-conteudo">
                                  <h5><i class="ace-icon fa fa-exclamation-triangle orange"></i> Lista de agendamentos: "{{bene_nome}}" — Convênio: "{{convenio}}"</h5>
                                  {{#if detalhes.length}}
                                  <table class="table table-condensed table-bordered" style="font-size:11px; width: 100%;">
                                    <thead>
                                      <tr>
                                        <th>Data</th>
                                        <th>Hora</th>
                                        <th>Sala</th>
                                        <th>Terapia</th>
                                        <th>Terapeuta</th>
                                        <th>Categoria</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      {{#each detalhes}}
                                      <tr>
                                        <td style="white-space: nowrap;">{{data}}</td>
                                        <td>{{hora}}</td>
                                        <td>{{sala}}</td>
                                        <td>{{terapia}}</td>
                                        <td>{{terapeuta}}</td>
                                        <td class="{{#ifCond categoria '==' 'Falta Absoluta'}}text-orange{{else}}{{#ifCond categoria '==' 'Falta Justificada'}}text-orange{{/ifCond}}{{/ifCond}}">{{categoria}}</td>
                                      </tr>
                                      {{/each}}
                                    </tbody>
                                  </table>
                                  {{else}}
                                  <p class="text-muted"><i class="ace-icon fa fa-check green"></i> Nenhuma falta registrada.</p>
                                  {{/if}}
                                </div>
                              </td>
                            </tr>
                            {{/each}}
                          </tbody>
                          <tfoot>
                            <tr style="background-color: #e8f5e9; font-weight: bold; border-top: 3px solid #4caf50;">
                              <td></td>
                              <td colspan="2" class="text-right" style="vertical-align: middle;"><i class="ace-icon fa fa-calculator green"></i>&nbsp;CONSOLIDADO TOTAL</td>
                              <td class="text-right">{{totaisGeral.total_registros}}</td>
                              <td class="text-right">{{totaisGeral.qt_falta}}</td>
                              <td class="text-right">{{totaisGeral.qt_falta_jus}}</td>
                              <td class="text-right">{{totaisGeral.qt_falta_abs}}</td>
                              <td class="text-right">{{totaisGeral.qt_feriado}}</td>
                              <td class="text-right">{{totaisGeral.indice_faltas}}%</td>
                            </tr>
                          </tfoot>
                        </table>
                        {{else}}
                        <div class="alert alert-info"><i class="ace-icon fa fa-info-circle"></i> Nenhum registro encontrado no período.</div>
                        {{/if}}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

