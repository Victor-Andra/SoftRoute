          <!-- ============================================ -->
          <!-- CONTAINER 3 — EXTERNOS                       -->
          <!-- ============================================ -->
          <div id="containerExternos" class="row" style="display: none;">
            <div class="col-sm-12">
              <div class="widget-box">
                <div class="widget-header">
                  <h4 class="widget-title">
                    <i class="ace-icon fa fa-home orange"></i>
