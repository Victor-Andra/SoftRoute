  <script>
    function carregaBody() {
      const urlParams = new URLSearchParams(window.location.search);
      const dataIni = urlParams.get('dataIni');
      const dataFim = urlParams.get('dataFim'); 
      if (dataIni) document.getElementById('dataFilDe').value = dataIni;
      if (dataFim) document.getElementById('dataFilAte').value = dataFim;

      // Inicializa o Select2 (garantindo compatibilidade com Ace Admin)
      if (typeof $.fn.select2 !== 'undefined') {
        $('#selectBene').select2({
          placeholder: "Escolha um beneficiário...",
          allowClear: true,
          width: 'resolve'
        });
      }

      atualizarEstadoFiltros();
    }

    function atualizarEstadoFiltros() {
      const chkGeral = document.getElementById('chkGeral').checked;
      const chkClinica = document.getElementById('chkClinica').checked;
      const chkExternos = document.getElementById('chkExternos').checked;
      const chkFiltrarBene = document.getElementById('chkFiltrarBene').checked;
      
      const containerSelect = document.getElementById('containerSelectBene');
      const msgEscolhaBene = document.getElementById('msgEscolhaBene');
      const selectBene = document.getElementById('selectBene');
      const beneSelecionado = selectBene.value;

      // 1. Controla visibilidade do Select2 e da mensagem de aviso
      if (chkFiltrarBene) {
        containerSelect.style.display = 'block';
        if (!beneSelecionado) {
          msgEscolhaBene.style.display = 'block';
          // Esconde os containers principais se o filtro estiver ativo mas sem escolha
          document.getElementById('containerGeral').style.display = 'none';
          document.getElementById('containerClinica').style.display = 'none';
          document.getElementById('containerExternos').style.display = 'none';
          document.getElementById('mensagemVazia').style.display = 'none';
          return; // Sai da função, pois a mensagem de escolher bene tem prioridade
        } else {
          msgEscolhaBene.style.display = 'none';
        }
      } else {
        containerSelect.style.display = 'none';
        msgEscolhaBene.style.display = 'none';
      }

      // 2. Controla visibilidade dos containers baseada nos checkboxes de tipo
      document.getElementById('containerGeral').style.display = chkGeral ? 'block' : 'none';
      document.getElementById('containerClinica').style.display = chkClinica ? 'block' : 'none';
      document.getElementById('containerExternos').style.display = chkExternos ? 'block' : 'none';

      // 3. Mensagem se nenhum tipo de relatório estiver marcado
      const nenhumTipoMarcado = !chkGeral && !chkClinica && !chkExternos;
      document.getElementById('mensagemVazia').style.display = nenhumTipoMarcado ? 'block' : 'none';
    }

    document.addEventListener('DOMContentLoaded', function() {
      // Listeners para os checkboxes de tipo
      document.getElementById('chkGeral').addEventListener('change', atualizarEstadoFiltros);
      document.getElementById('chkClinica').addEventListener('change', atualizarEstadoFiltros);
      document.getElementById('chkExternos').addEventListener('change', atualizarEstadoFiltros);
      document.getElementById('chkFiltrarBene').addEventListener('change', atualizarEstadoFiltros);

      // Listener para o Select2: ao mudar, submete o formulário (Opção A: recarrega a página)
      $('#selectBene').on('change', function() {
        document.getElementById('formFiltro').submit();
      });

      // Expansão das linhas de detalhes
      document.querySelectorAll('.btn-expand').forEach(btn => {
        btn.addEventListener('click', function() {
          const mainRow = this.closest('tr');
          const detailRow = mainRow.nextElementSibling;
          if (!detailRow || !detailRow.classList.contains('detalhe-linha')) return;

          const isExpanded = detailRow.style.display === 'table-row';
          detailRow.style.display = isExpanded ? 'none' : 'table-row';

          this.classList.toggle('fa-plus-circle', isExpanded);
          this.classList.toggle('fa-minus-circle', !isExpanded);
        });
      });

      // Capturar valores dos checkboxes antes de submeter o formulário
      document.getElementById('formFiltro').addEventListener('submit', function(e) {
        const checkboxes = ['geral', 'clinica', 'externos'];
        const selecionados = [];
        
        checkboxes.forEach(tipo => {
          const chk = document.querySelector(`input[value="${tipo}"]`);
          if (chk && chk.checked) selecionados.push(tipo);
        });

        document.querySelectorAll('input[name="mostrar"]').forEach(el => el.remove());

        if (selecionados.length > 0) {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'mostrar';
          input.value = selecionados.join(',');
          this.appendChild(input);
        }

        // Se o checkbox de filtrar beneficiário estiver DESMARCADO, limpamos o beneId da URL
        // para evitar que ele persista indevidamente se o usuário desmarcar.
        const chkFiltrarBene = document.getElementById('chkFiltrarBene');
        if (!chkFiltrarBene.checked) {
            // Opcional: remover o parâmetro beneId da URL atual antes de submeter
            // Mas como é um GET, o próprio navegador lida com os campos do form.
            // Apenas garantimos que o select esteja desabilitado ou vazio se não for usar.
            document.getElementById('selectBene').disabled = true;
        }
      });
    });
  </script>
</body>
</html>