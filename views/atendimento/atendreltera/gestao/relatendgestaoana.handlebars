<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Relatório Analítico de Atendimento – Gestão</title>
    <style>
        /* Estilos para tela */
        @media screen {
            .print-footer { display: none; }
        }

        /* Estilos para impressão */
        @media print {
            .noprint { display: none !important; }
            .print-footer {
                display: block;
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                text-align: center;
                font-size: 11px;
                padding: 5px 0;
                background: white;
                z-index: 9999;
            }
            body { margin-bottom: 30mm; }
            @page {
                margin: 1cm;
                @bottom-center {
                    content: "Página " counter(page) " de " counter(pages);
                    font-size: 12px;
                }
            }
        }
    </style>
    <script>
        function validarIntervalo() {
            const dataInicio = document.getElementById('dataFilDe').value;
            const dataFim = document.getElementById('dataFilAte').value;

            if (!dataInicio || !dataFim) {
                alert("Por favor, preencha ambas as datas.");
                return false;
            }

            const dtIni = new Date(dataInicio);
            const dtFim = new Date(dataFim);

            if (dtIni > dtFim) {
                alert("A data inicial não pode ser maior que a data final.");
                return false;
            }

            // Calcula a diferença em dias
            const diffTime = Math.abs(dtFim - dtIni);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays > 31) {
                alert("O intervalo máximo permitido é de 31 dias.");
                return false;
            }

            return true; // permite o envio
        }
</script>
    <script>
        function atualizaDataIni(){
            let fulldate = (document.getElementById('dataFilDe').value+' 00:00:00.000Z').toString();
            document.getElementById('dataIni').value = fulldate;
        }
        function atualizaDataFin(){
            let fulldate = (document.getElementById('dataFilAte').value+' 00:00:00.000Z').toString();
            document.getElementById('dataFim').value = fulldate;
        }
        function carregaBody(){
            document.getElementById("dataFilDe").value = "{{pesquisa.dataIni}}".substring(0,10);
            document.getElementById("dataFilAte").value = "{{pesquisa.dataFim}}".substring(0,10);
        }
    </script>
</head>
<body onload="javascript:carregaBody();controlaNave();" class="no-skin">
    <div class="main-container ace-save-state" id="main-container">
        <div class="main-content">
            <div class="main-content-inner noprint">
                <div class="breadcrumbs ace-save-state" id="breadcrumbs">
                    <ul class="breadcrumb">
                        <li><i class="ace-icon fa fa-home home-icon"></i><a href="#">Home</a></li>
                        <li class="active">Relatório Analítico de Atendimento – Gestão</li>
                    </ul>
                </div>

                <form class="noprint" role="form" method="GET" onsubmit="return validarIntervalo()">
                    <div class="breadcrumbs" style="align-items: center;">
                        <ul class="breadcrumb">
                            <label>Período de:</label>
                            <input style="height: 30px;" id="dataFilDe" name="dataIni" type="date" />
                            <label>até:</label>
                            <input style="height: 30px;" id="dataFilAte" name="dataFim" type="date" />
                            <button class="btn btn-info" type="submit">
                                <i class="ace-icon fa fa-search bigger-110"></i> Pesquisar
                            </button>
                        </ul>
                    </div>
                </form>
            </div>

            <div class="row">
                <div class="col-xs-12">
                    <div class="space-6"></div>
                    <div class="row">
                        <div class="col-sm-10 col-sm-offset-1">
                            <div class="widget-box transparent">
                                <div style="text-align: center;">
                                    <img width="140" height="60" src="/images/gallery/logo_route_centro.png">
                                </div>
                                <div class="widget-header widget-header-large">
                                    <h3 class="widget-title grey lighter">
                                        <i class="ace-icon fa fa-leaf green"></i>
                                        Relatório Analítico de Atendimento – Gestão
                                    </h3>
                                </div>
                                <div class="widget-body">
                                    <div class="widget-main padding-24">
                                        <div class="row">
                                            <div class="col-xs-12 label label-lg label-info arrowed-in arrowed-right">
                                                <b>Informações da Clínica</b>
                                            </div>
                                        </div>
                                        <div>
                                            <ul class="list-unstyled">
                                                <li><i class="ace-icon fa fa-caret-right blue"></i><b>Prestador:</b> Route Centro de Terapia e Apoio Infantil</li>
                                                <li><i class="ace-icon fa fa-caret-right blue"></i><b>CNPJ:</b> 33.346.423/0001-17</li>
                                            </ul>
                                        </div>

                                        <div class="row">
                                            <div class="col-xs-12 label label-lg label-success arrowed-in arrowed-right">
                                                <b>Período do Relatório</b>
                                            </div>
                                        </div>
                                        <div>
                                            <ul class="list-unstyled">
                                                <li><i class="ace-icon fa fa-caret-right green"></i><b>De:</b> {{periodoDe}} <b>Até:</b> {{periodoAte}}</li>
                                            </ul>
                                        </div>

                                        <div class="row">
                                            <div class="col-xs-12 label label-lg label-warning arrowed-in arrowed-right">
                                                <b>Atendimentos Detalhados</b>
                                            </div>
                                        </div>

                                        <div>
                                            <table class="table table-striped table-bordered">
                                                <thead>
                                                    <tr>
                                                        <th>#</th>
                                                        <th>Data</th>
                                                        <th>Hora</th>
                                                        <th>Convênio</th>
                                                        <th>Beneficiário</th>
                                                        <th>Liminar</th>
                                                        <th>Terapeuta</th>
                                                        <th>Terapia</th>
                                                        <th>Sala</th>
                                                        <th>Valor CRE</th>
                                                        <th>Valor DEB</th>
                                                        <th>Terapeuta Substituido</th>
                                                        <th>Terapia Substituida</th>
                                                        <th>Merge CRE</th>
                                                        <th>Merge DEB</th>
                                                        <th>Terapeuta Fixo</th>
                                                        <th>Terapia Fixa</th>
                                                        <th>Fixo CRE</th>
                                                        <th>Fixo DEB</th>
                                                        <th>Categoria</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {{#each rels}}
                                                    <tr>
                                                        <td class="center">{{inc @index}}</td>
                                                        <td>{{dt}}</td>
                                                        <td>{{hora}}</td>
                                                        <td>{{conv_nome}}</td>
                                                        <td>{{bene_nome}}</td>
                                                        <td>{{#ifEqual bene_liminar "Sim"}}Sim{{else}}Não{{/ifEqual}}</td>
                                                        <td>{{terapeuta_nome}}</td>
                                                        <td>{{terapia_nomecid}}</td>
                                                        <td>{{sala_nome}}</td>
                                                        <td style="text-align: right;">{{atend_valorcre_num}}</td>
                                                        <td style="text-align: right;">{{atend_valordeb_num}}</td>
                                                        <td>{{mergeterapeuta_nome}}</td>
                                                        <td>{{mergeterapia_nomecid}}</td>
                                                        
                                                        <td style="text-align: right;">{{atend_mergevalorcre_num}}</td>
                                                        <td style="text-align: right;">{{atend_mergevalordeb_num}}</td>
                                                        <td>{{fixoterapeuta_nome}}</td>
                                                        <td>{{fixoterapia_nomecid}}</td>
                                                        <td style="text-align: right;">{{atend_fixovalorcre_num}}</td>
                                                        <td style="text-align: right;">{{atend_fixovalordeb_num}}</td>
                                                        <td>{{atend_categoria}}</td>
                                                    </tr>
                                                    {{/each}}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="print-footer" id="printFooter"></div>
</body>
</html>