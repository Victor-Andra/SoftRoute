<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Relatório de Consolidado de Valores por Terapia</title>
		<style>
			/* Estilos para tela */
			@media screen {
				.print-header {
					display: none;
				}
			}

			/* Estilos para impressão */
			@media print {
				.noprint {
					display: none !important;
				}

				/* Cabeçalho fixo com paginação no topo */
				.print-header {
					position: fixed;
					top: 0;
					left: 0;
					right: 0;
					text-align: center;
					font-size: 11px;
					padding: 4px 0;
					background: white;
					z-index: 9999;
					content: "Página " counter(page) " de " counter(pages);
				}

				/* Margem superior para não sobrepor conteúdo */
				body {
					margin-top: 12mm; /* suficiente para o cabeçalho */
					margin-bottom: 10mm;
				}

				/* Configuração da página: permite retrato ou paisagem conforme escolha do usuário */
				@page {
					margin: 1cm;
					/* NÃO defina `size` aqui — isso bloqueia a orientação! */
					@top-center {
						content: "Página " counter(page) " de " counter(pages);
						font-size: 11px;
						color: black;
					}
					@bottom-center {
						content: ""; /* remove qualquer rodapé automático */
					}
				}

				/* Garante que elementos grandes não quebrem mal */
				table {
					page-break-inside: avoid;
				}
			}
		</style>
		<script type="text/javascript">
			function atualizaDataIni(){
				let fulldate = (document.getElementById('dataFilDe').value+' 00:00:00.000Z').toString();
				document.getElementById('dataIni').value = fulldate;
			}
			function atualizaDataFin(){
				let fulldate = (document.getElementById('dataFilAte').value+' 00:00:00.000Z').toString();
				document.getElementById('dataFim').value = fulldate;
			}
			function checkNoventaDias(){
				var date1 = new Date(document.getElementById("dataFilDe").value);
				var date2 = new Date(document.getElementById("dataFilAte").value);
				var timeDiff = Math.abs(date2.getTime() - date1.getTime());
				var diffDays = Math.ceil(timeDiff / (1000 * 3600 * 24));
				return diffDays > 90;
			}
			// Função de validação
			function validarConsAtendTera(event) {
				const selectTerapia = document.getElementById('relTeraid');
				const alertaErro = document.getElementById('alertaErro');

				if (!selectTerapia || !selectTerapia.value) {
					event.preventDefault();
					alertaErro.style.display = 'block';
					return false;
				} else {
					alertaErro.style.display = 'none';
					return true;
				}
			}

			// Esconde o alerta quando o usuário seleciona um beneficiário
			function esconderAlertaAoSelecionarTerapia() {
				const alertaErro = document.getElementById('alertaErro');
				if (this.value) {
					alertaErro.style.display = 'none';
				}
			}

			// Inicializa os listeners quando o DOM estiver pronto
			document.addEventListener('DOMContentLoaded', function () {
				const form = document.getElementById('ConsTerapeuta');
				const selectTerapia = document.getElementById('relTeraid');

				if (form) {
					form.addEventListener('submit', validarConsAtendTera);
				}
				if (selectTerapia) {
					selectTerapia.addEventListener('change', esconderAlertaAoSelecionarTerapia);
				}
			});
			function carregaBody(){
				/*
				let sessoes = document.getElementsByName("sessoes")
				let valores = document.getElementsByName("valor")
				sessoes.forEach((s)=>{
					let subTotal = s.value * (document.getElementById("valor"+s.id).value);
					document.getElementById("subtotal"+s.id).value = subTotal;
				})*/

				//Filtro persistente
					document.getElementById("dataFilDe").value = document.getElementById("dataIni").value.substring(0,10) || new Date().toISOString().split('T')[0];
				document.getElementById("dataFilAte").value =  document.getElementById("dataFim").value.substring(0,10) || new Date().toISOString().split('T')[0];
			}
		</script>
	</head>
	<body onload="javascript:controlaNave();" class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner noprint">
					<div class="breadcrumbs ace-save-state noprint" id="breadcrumbs_home" >
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Relatório Consolidado do Terapeuta - Terapia e Valores</li>
						</ul><!-- /.breadcrumb -->
					</div>
					<form id="ConsTerapeuta" name="ConsTerapeuta" role="form" class="noprint" action="/menu/atendimento/atendreltera/relatendterapiaconss" method="POST">
						<!-- Alerta-->
						<div id="alertaErro" style="display: none;" class="alert alert-danger">
							<button type="button" class="close" data-dismiss="alert">
								<i class="ace-icon fa fa-times"></i>
							</button>
							<strong>Importante!</strong> Por favor escolha um Terapeuta.
						</div>
						<div class="breadcrumbs" id="breadcrumbs" style="align-items: center; text-align: center;">
							<ul class="breadcrumb" >
								<label>Período de:</label>
								<input style="height: 30px;" id="dataFilDe" name="dataFilDe" type="date" onchange="javascript:atualizaDataIni()">
								<input class="hidden" id="dataIni" name="dataIni" value="{{filtro.dataIni}}" />
								<label>até:</label>
								<input style="height: 30px;" id="dataFilAte" name="dataFilAte" type="date" onchange="javascript:atualizaDataFin()">
								<input class="hidden" id="dataFim" name="dataFim" value="{{filtro.dataFim}}" />
								<label>Terapeuta: </label>
									<select name="relTeraid" id="relTeraid" class="chosen-select">
										{{#each terapeutas}}
											<option value="{{_id}}">{{usuario_nome}}</option>
										{{/each}}
									</select>
								<button class="btn btn-info" name="acaoSalvar" id="acaoSalvar" type="submit">
									<i class="ace-icon fa fa-search bigger-110"></i>
									Pesquisar
								</button>
							</ul><!-- /.breadcrumb -->
						</div>
					</form>
				</div>
				<div class="row">
					<div class="col-xs-12">
						<!-- PAGE CONTENT BEGINS -->
						<div class="space-6"></div>
						<div class="row">
							<div class="col-sm-10 col-sm-offset-1">
								<div class="widget-box transparent">
									<div style="text-align: center;">
										<img width="140" height="60" alt="150x150" style="alight: center" src="/images/gallery/logo_route_centro.png">
									</div>
										<div class="widget-header widget-header-large">
											<h3 class="widget-title grey lighter">
												<i class="ace-icon fa fa-leaf green"></i>
												Atendimentos e Valores
											</h3>
										</div>
									<div class="widget-body">
										<div class="widget-main padding-24">
											<div class="row">
												<div class="col-sm-12">
													<div class="row">
														<div class="col-xs-12 label label-lg label-info arrowed-in arrowed-right">
															<b>Informações do Prestador</b>
														</div>
													</div>
													<div>
														<ul class="list-unstyled">
															<li>
																<i class="ace-icon fa fa-caret-right blue"></i><b>Prestador: </b>Route Centro de Terapia e Apoio Infantil
															</li>
															<li>
																<i class="ace-icon fa fa-caret-right blue"></i><b>CNPJ: </b> 33.346.423/0001-17
															</li>
														</ul>
													</div>
													<div class="row">
														<div class="col-xs-12 label label-lg label-success arrowed-in arrowed-right">
															<b>Informações do Relatório</b>
														</div>
													</div>
													<div>
														<ul class="list-unstyled ">
															<li>
																<i class="ace-icon fa fa-caret-right green"></i><b>Período de: </b>{{periodoDe}}<b> até: </b>{{periodoAte}}
															</li>
															<li>
																<i class="ace-icon fa fa-caret-right green"></i><b>Terapeuta: </b>{{terapeuta_nome}}
															</li>
														</ul>
													</div>
													<div class="row">
														<div class="col-xs-12 label label-lg label-warning arrowed-in arrowed-right">
															<b>Informações dos Atendimentos</b>
														</div>
													</div>
											</div><!-- /.row -->
											<div>
												<table class="table table-striped table-bordered">
													<thead>
														<tr>
															<th class="center">#</th>
															<th>Terapeuta</th>
															<th>Sessões</th>
															<th>Valor da Sessão</th>
															<th>Valor Total</th>															
														</tr>
													</thead>
													{{#each rels}}
														<tbody>
															<tr>
																<td class="center">#</td>
																{{#each ../usuarios}}<!-- Ok -->
																	{{#ifEqual this._id ../usu_id}}
																		{{usuario_nome}}
																	{{/ifEqual}}
																{{/each}}
																<td>{{sessoes}}</td>
																<td>{{valor}}</td>		
																<td>{{total}}</td>				
															</tr>
														</tbody>
													{{/each}}
													<footer>
														<tr class="hr-double">
															<td class="right">-</td>
															<td><b>Total</b></td>
															<td><b>{{total.sessoes}}</b></td>
															<td><b>-</b></td>		
															<td><b>{{total.total}}</b></td>					
														</tr>
													</footer>
												</table>
											</div>
											
										</div>
									</div>
								</div>
							</div>
						</div><!-- PAGE CONTENT ENDS -->
					</div><!-- /.col -->
				</div><!-- /.row -->
			</div><!-- /.main-content -->
		</div><!-- /.main-container --><!-- basic scripts -->
		 <div class="row"><!-- Área reservada para Assinaturas -->
			<div class="col-xs-12">
				<div style="margin-top: 32px;"></div>
				<div class="row">
					<div class="col-xs-4 col-sm-4 text-center">
						<div class="hr"></div>
						<label>Assinatura do(a) Terapeuta</label>
					</div>
					<div class="col-xs-4 col-sm-4"></div>
					<div class="col-xs-4 col-sm-4 text-center">
						<div class="hr"></div>
						<label>Assinatura da Clínica</label>
					</div>
				</div>
			</div>
		</div><!-- /.Área reservada para Assinaturas -->
	  <div class="print-footer" id="printFooter"></div>
	</body>
</html>
