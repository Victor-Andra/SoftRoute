			}
			.toolbar-pesquisa h5 i {
				font-size: 18px;
			}
			.toolbar-pesquisa .form-inline {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				align-items: flex-end;
			}
			.toolbar-pesquisa .form-row {
				display: flex;
				flex-wrap: wrap;
				gap: 12px;
				width: 100%;
				align-items: flex-end;
			}
			.toolbar-pesquisa .form-group {
				margin: 0;
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				min-width: 140px;
				flex: 1;
