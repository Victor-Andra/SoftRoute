    </h5>

    <div class="form-inline">
        <div class="form-row">

            <!-- Período de -->
            <div class="form-group">
                <label>Período de:</label>
                <input id="dataFilDe" name="dataFilDe" type="date"
                       onchange="atualizaDataIni()">
                <input type="hidden" id="dataIni" name="dataIni" value="{{filtro.dataIni}}">
            </div>

            <!-- Até -->
            <div class="form-group">
                <label>até:</label>
                <input id="dataFilAte" name="dataFilAte" type="date"
                       onchange="atualizaDataFin()">
                <input type="hidden" id="dataFim" name="dataFim" value="{{filtro.dataFim}}">
            </div>

            <!-- Terapeuta -->
            <div class="form-group" style="min-width: 260px;">
                <label>Terapeuta:</label>
                <select name="relTeraid" id="relTeraid"
                        class="select2"
                        data-placeholder="Escolha...">
                    <option value=""></option>
                    {{#each terapeutas}}
                        <option value="{{_id}}">{{usuario_nome}}</option>
                    {{/each}}
                </select>
            </div>

            <!-- Botão -->
            <button class="btn-pesquisar"
                    name="acaoPesquisar"
                    id="acaoPesquisar"
                    type="submit">
                <i class="ace-icon fa fa-search"></i>
                Pesquisar
            </button>

        </div>
    </div>

</div>
