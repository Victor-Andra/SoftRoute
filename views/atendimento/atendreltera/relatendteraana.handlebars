<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Relatório Analítico de Atendimento dos Terapeutas</title>
		<style>
			/* Estilos para tela */
			@media screen {
				.print-header {
					display: none;
				}
			}

			/* Estilos para impressão */
			@media print {
				.noprint {
					display: none !important;
				}

				/* Cabeçalho fixo com paginação no topo */
				.print-header {
					position: fixed;
					top: 0;
					left: 0;
					right: 0;
					text-align: center;
					font-size: 11px;
					padding: 4px 0;
					background: white;
					z-index: 9999;
					content: "Página " counter(page) " de " counter(pages);
				}

				/* Margem superior para não sobrepor conteúdo */
				body {
					margin-top: 12mm; /* suficiente para o cabeçalho */
					margin-bottom: 10mm;
				}

				/* Configuração da página: permite retrato ou paisagem conforme escolha do usuário */
				@page {
					margin: 1cm;
					/* NÃO defina `size` aqui — isso bloqueia a orientação! */
					@top-center {
						content: "Página " counter(page) " de " counter(pages);
						font-size: 11px;
						color: black;
					}
					@bottom-center {
						content: ""; /* remove qualquer rodapé automático */
					}
				}

				/* Garante que elementos grandes não quebrem mal */
				table {
					page-break-inside: avoid;
				}
			}
		</style>
		<script type="text/javascript">
			function atualizaDataIni(){
				let fulldate = (document.getElementById('dataFilDe').value+' 00:00:00.000Z').toString();
				document.getElementById('dataIni').value = fulldate;
			}
			function atualizaDataFin(){
				let fulldate = (document.getElementById('dataFilAte').value+' 00:00:00.000Z').toString();
				document.getElementById('dataFim').value = fulldate;
			}
			function carregaBody(){
				/*
				let sessoes = document.getElementsByName("sessoes")
				let valores = document.getElementsByName("valor")
				sessoes.forEach((s)=>{
					let subTotal = s.value * (document.getElementById("valor"+s.id).value)
					document.getElementById("subtotal"+s.id).value = subTotal;
				})*/

				//Filtro persistente
				document.getElementById("relTeraid").value  = document.getElementById("teraFiltro").value
				document.getElementById("dataFilDe").value = document.getElementById("dataIni").value.substring(0,10);
				document.getElementById("dataFilAte").value =  document.getElementById("dataFim").value.substring(0,10);
			}
		</script>
	</head>
	<body onload="javascript:controlaNave();carregaBody();" class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner noprint">
					<div class="breadcrumbs ace-save-state noprint" id="breadcrumbs_home" >
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Relatório Analítico de Atendimento dos Terapeutas</li>
						</ul><!-- /.breadcrumb -->
					</div>
					<form style="noprint" role="form" action="/menu/atendimento/atendreltera/relatendteraanas" method="POST">
						<div class="breadcrumbs" id="breadcrumbs" style="align-items: center; text-align: center;" >
							<ul class="breadcrumb">
								<label>Período de:</label>
								<input style="height: 30px;" id="dataFilDe" name="dataFilDe" type="date" onchange="javascript:atualizaDataIni()"  />
								<input class="hidden" id="dataIni" name="dataIni" value="{{pesquisa.dataIni}}" />
								<label>até:</label>
								<input style="height: 30px;" id="dataFilAte" name="dataFilAte" type="date" onchange="javascript:atualizaDataFin()"  />
								<input class="hidden" id="dataFim" name="dataFim" value="{{pesquisa.dataFim}}" />
								<label>Terapeuta: </label>
								<select style="height: 30px; width:300px;" name="relTeraid"  id="relTeraid" class="chosen-select" data-placeholder="Escolha...">
									{{#each terapeutas}}
										<option value="{{_id}}">{{usuario_nome}}</option>
									{{/each}}
								</select>
								<input  hidden id="teraFiltro" name="teraFiltro"  value="{{pesquisa.terapeuta}}" />
								<button class="btn btn-info" name="acaoSalvar" id="acaoSalvar" type="submit">
									<i class="ace-icon fa fa-search bigger-110"></i>
									Pesquisar
								</button>
							</ul><!-- /.breadcrumb -->
						</div>
					</form>
				</div>
				<div class="row">
					<div class="col-xs-12">
						<!-- PAGE CONTENT BEGINS -->
						<div class="space-6"></div>
						<div class="row">
							<div class="col-sm-10 col-sm-offset-1">
								<div class="widget-box transparent">
									<div style="text-align: center;">
										<img width="140" height="60" alt="150x150" style="alight: center" src="/images/gallery/logo_route_centro.png">
									</div>
										<div class="widget-header widget-header-large">
											<h3 class="widget-title grey lighter">
												<i class="ace-icon fa fa-leaf green"></i>
												Atendimentos por Terapeuta
											</h3>
										</div>
									<div class="widget-body">
										<div class="widget-main padding-24">
											<div class="row">
												<div class="col-sm-12">
													<div class="row">
														<div class="col-xs-12 label label-lg label-info arrowed-in arrowed-right">
															<b>Informações do Prestador</b>
														</div>
													</div>
													<div>
														<ul class="list-unstyled">
															<li>
																<i class="ace-icon fa fa-caret-right blue"></i><b>Prestador: </b>Route Centro de Terapia e Apoio Infantil
															</li>
															<li>
																<i class="ace-icon fa fa-caret-right blue"></i><b>CNPJ: </b> 33.346.423/0001-17
															</li>
														</ul>
													</div>
													<div class="row">
														<div class="col-xs-12 label label-lg label-success arrowed-in arrowed-right">
															<b>Informações do Terapeuta</b>
														</div>
													</div>
													<div>
														<ul class="list-unstyled ">
															<li>
																<i class="ace-icon fa fa-caret-right green"></i><b>Período de: </b>{{periodoDe}}<b> até: </b>{{periodoAte}}
															</li>
															<li>
																<i class="ace-icon fa fa-caret-right green"></i><b>Terapeuta: </b>{{terapeuta_nome}}
															</li>
														</ul>
													</div>
													<div class="row">
														<div class="col-xs-12 label label-lg label-warning arrowed-in arrowed-right">
															<b>Informações dos Atendimentos</b>
														</div>
													</div>
												</div>
											</div><!-- /.row -->
											<div>
												<table class="table table-striped table-bordered">
													<thead>
														<tr>
															<th class="center">#</th>
															<th>Data do Atendimento</th>
															<th>Hora do Atendimento</th>
															<th>Especialidade Detalhada</th>
															<th>Especialidade</th>
															<th>Beneficiário</th>
														</tr>
													</thead>
													{{#each rels}}
														<tbody>
															<tr>
																<th class="center">{{inc @index}}</th>
																<td style="width:10%">{{dt}}</td>
																<td style="width:10%">{{hora}}</td>
																{{#each ../terapias}}
																	{{#ifEqual this._id ../especialidade}}
																		<td>{{terapia_nome}}</td>
																	{{/ifEqual}}
																{{/each}}
																{{#each ../terapias}}
																	{{#ifEqual this._id ../especialidade}}
																		<td>{{terapia_nomecid}}</td>
																	{{/ifEqual}}
																{{/each}}
																{{#each ../benes}}
																	{{#ifEqual this._id ../beneficiario}}
																		<td>{{bene_nome}}</td>
																	{{/ifEqual}}
																{{/each}}
															</tr>
														</tbody>
													{{/each}}
													<footer>
														<tr class="hr-double">
															<td><b>-</b></td>
															<td><b>-</b></td>
															<td><b>-</b></td>
															<td><b>-</b></td>
															<td><b>-</b></td>
														</tr>
													</footer>
												</table>
											</div>
											
										</div>
									</div>
								</div>
							</div>
						</div><!-- PAGE CONTENT ENDS -->
						<!-- Resumo de Contagem por Terapia -->
						<form style="noprint">
						<div class="col-sm-6" >
							<div class="row">
								<div class="col-xs-6" style="margin-top: 20px;">
									<div class="widget-box transparent" style="noprint">
										<div class="widget-header">
											<h5 class="widget-title grey lighter" style="text-align: center;">
												<i class="ace-icon fa fa-bar-chart green"></i>
												Resumo por Terapia
											</h5>
										</div>
										<div class="widget-body">
											<div class="widget-main">
												<table class="table table-condensed table-bordered">
													<thead >
														<tr class="info">
															<th>Terapia</th>
															<th class="center">Total</th>
														</tr>
													</thead>
													<tbody>
														{{#each totaisTerapia}}
														<tr>
															<td>{{terapiaNome}}</td>
															<td class="center">{{total}}</td>
														</tr>
														{{/each}}
														<tr class="info">
															<td><b>Total Geral</b></td>
															<td class="center"><b>{{totalGeral}}</b></td>
														</tr>
													</tbody>
												</table>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
																							  </form>
					</div><!-- /.col -->
				</div><!-- /.row -->
			</div><!-- /.main-content -->
		</div><!-- /.main-container --><!-- basic scripts -->
		<div class="row"><!-- Área reservada para Assinaturas -->
			<div class="space"></div>
			<div class="col-xs-4 col-sm-4">
				<div class="hr"></div>
				<label>Assinatura do Responsável</label>
			</div>
			<div class="col-xs-4 col-sm-4">
				<div class=""></div>
				<label></label>
			</div>
			<div class="col-xs-4 col-sm-4">
				<div class="hr"></div>
				<label>Assinatura da Clínica</label>
			</div>
		</div><!-- /.Área reservada para Assinaturas -->
		<div class="print-footer" id="printFooter"></div>
	</body>
</html>
