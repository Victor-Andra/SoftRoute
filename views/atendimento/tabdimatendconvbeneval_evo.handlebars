                              <td>{{{debOrig}}}</td>
                              <td>{{terapiaFixa}}</td>
                              <td>{{terapeutaFixo}}</td>
                              <td>{{{credFixo}}}</td>
                              <td>{{{debFixo}}}</td>
                              <td>{{terapiaSubst}}</td>
                              <td>{{terapeutaSubst}}</td>
                              <td>{{{credSubst}}}</td>
                              <td>{{{debSubst}}}</td>
                              <td class="text-center">{{{credUsado}}}</td>
                              <td class="text-center">{{{debUsado}}}</td>
                              <td class="text-center">
                                {{#if evolucaoTexto}}
