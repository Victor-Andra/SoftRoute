                                    {{{seloLabel}}}
                                    <span class="evo-tooltip">{{evolucaoTexto}}</span>
                                  </span>
                                {{else}}
                                  {{{seloLabel}}}
                                {{/if}}
                              </td>
                              <td class="text-center">
                                {{#if permiteEdicao}}
                                <a class="green" href="/menu/atendimento/atendadm/edi/{{_id}}">
                                  <i class="ace-icon fa fa-pencil bigger-130"></i>
