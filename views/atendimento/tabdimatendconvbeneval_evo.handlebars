<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
  <meta charset="utf-8">
  <title>Relatório Detalhado por Convênio e Beneficiário — por Distinção de Evolução</title>
  <style>
    /* ── Tela / Impressão ─────────────────────────────────────── */
    @media screen {
      .print-header { display: none; }
    }
    @media print {
      .noprint { display: none !important; }
      .print-header {
        position: fixed; top: 0; left: 0; right: 0;
        text-align: center; font-size: 11px; padding: 4px 0;
        background: white; z-index: 9999;
      }
      body { margin-top: 12mm; margin-bottom: 10mm; }
      @page { margin: 1cm; }
      table { page-break-inside: avoid; }

      /* ── Na impressão: mostra todas as 4 abas (ignora display:none) ── */
      .painel-aba { display: block !important; }
      /* Separa cada painel na impressão */
      .painel-aba + .painel-aba { page-break-before: always; }
      /* Expande todos os detalhes expandíveis */
      .detalhe-linha { display: table-row !important; }
      /* Esconde os toggles de expand/collapse */
      .btn-expand { display: none !important; }
    }

    /* ── Toolbar de pesquisa ──────────────────────────────────── */
    .toolbar-pesquisa {
      background: linear-gradient(135deg, #21e2f3 0%, #1976d2 100%);
      color: white; padding: 15px; border-radius: 8px;
      margin: 0 12px 20px 12px;
      box-shadow: 0 4px 6px rgba(0,0,0,.1); border: 1px solid #1976d2;
    }
    .toolbar-pesquisa h5 {
      margin: 0 0 12px 0; font-size: 14px; font-weight: 600;
      display: flex; align-items: center; gap: 8px;
    }
    .toolbar-pesquisa .form-inline { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
    .toolbar-pesquisa .form-row    { display: flex; flex-wrap: wrap; gap: 12px; width: 100%; align-items: flex-end; }
    .toolbar-pesquisa .form-group  {
      margin: 0; display: flex; flex-direction: column;
      align-items: flex-start; min-width: 140px; flex: 1; max-width: 220px;
    }
    .toolbar-pesquisa label { font-size: 11px; font-weight: 500; margin-bottom: 4px; color: #f8f9fa; white-space: nowrap; }
    .toolbar-pesquisa input[type="date"],
    .toolbar-pesquisa select {
      padding: 6px 10px; border: 2px solid #e2e8f0; border-radius: 4px;
      font-size: 12px; width: 100%; box-sizing: border-box;
      background: white; color: #333; height: 30px;
    }
    .btn-pesquisar {
      background: #dc3545; color: white; border: none;
      padding: 8px 24px; border-radius: 4px; font-weight: 600; font-size: 13px;
      cursor: pointer; display: flex; align-items: center; gap: 6px;
      box-shadow: 0 2px 4px rgba(0,0,0,.2); margin-left: auto;
    }
    .btn-pesquisar:hover { background: #c82333; }

    /* ── Navegação entre abas ─────────────────────────────────── */
    .nav-abas {
      display: flex; gap: 4px; margin: 0 12px 0 12px;
      border-bottom: 2px solid #dee2e6; padding-bottom: 0;
    }
    .nav-abas .aba-btn {
      padding: 8px 18px; border: 1px solid #dee2e6; border-bottom: none;
      border-radius: 4px 4px 0 0; cursor: pointer; font-size: 13px;
      font-weight: 600; background: #f8f9fa; color: #495057;
      transition: all .2s; position: relative; top: 2px;
    }
    .nav-abas .aba-btn:hover { background: #e9ecef; }
    .nav-abas .aba-btn.ativa {
      background: white; color: #1976d2;
      border-color: #dee2e6; border-bottom-color: white;
    }
    .nav-abas .aba-btn .badge-sessoes {
      display: inline-block; margin-left: 6px;
      padding: 1px 7px; border-radius: 10px; font-size: 11px;
      font-weight: 700; color: white;
    }
    .badge-geral         { background: #1976d2; }
    .badge-comevo        { background: #28a745; }
    .badge-semevo-at     { background: #dc3545; }
    .badge-semevo-outros { background: #e67e22; }

    /* ── Painel de cada aba ───────────────────────────────────── */
    .painel-aba { display: none; padding: 16px 12px; }
    .painel-aba.ativo { display: block; }

    /* ── Tabelas ──────────────────────────────────────────────── */
    .detalhe-linha    { background-color: #fafafa; display: none; }
    .detalhe-conteudo { padding: 12px 24px; }
    .btn-expand { cursor: pointer; color: #428bca; font-size: 16px; }
    .text-center { text-align: center; }
    .text-right  { text-align: right; }

    /* ── Caixa de evolução (tooltip) ─────────────────────────── */
    .evo-box { display: none; } /* não usado mais */
    .evo-vazia { color: #aaa; font-style: italic; }

    /* Label com tooltip de evolução */
    .evo-label-wrap {
      position: relative; display: inline-block;
    }
    .evo-label-wrap .evo-tooltip {
      visibility: hidden; opacity: 0;
      background: #333; color: #fff;
      font-size: 11px; line-height: 1.4;
      border-radius: 4px; padding: 6px 10px;
      white-space: pre-wrap; word-break: break-word;
      max-width: 320px; min-width: 140px;
      position: absolute; z-index: 9999;
      bottom: calc(100% + 6px); left: 50%;
      transform: translateX(-50%);
      box-shadow: 0 3px 10px rgba(0,0,0,.35);
      transition: opacity .15s ease;
      pointer-events: none;
    }
    /* Seta do tooltip */
    .evo-label-wrap .evo-tooltip::after {
      content: '';
      position: absolute; top: 100%; left: 50%;
      transform: translateX(-50%);
      border: 5px solid transparent;
      border-top-color: #333;
    }
    .evo-label-wrap:hover .evo-tooltip {
      visibility: visible; opacity: 1;
    }

    @media print {
      /* Na impressão: esconde o tooltip, mostra só o label */
      .evo-label-wrap .evo-tooltip { display: none !important; }
    }

    /* ── Chosen ───────────────────────────────────────────────── */
    .chosen-container .chosen-single {
      border: 1px solid #ced4da !important; border-radius: 0 !important;
      box-shadow: none !important; background: #f8f9fa !important;
    }
    .chosen-container .chosen-drop {
      border: 1px solid #ced4da !important; border-top: none !important;
      box-shadow: 0 2px 8px rgba(0,0,0,.1) !important;
    }
  </style>
</head>

<body onload="javascript:controlaNave(); carregaBody();" class="no-skin">
<div class="main-container ace-save-state" id="main-container">
<div class="main-content">
<div class="main-content-inner">

  <!-- Breadcrumb -->
  <div class="breadcrumbs ace-save-state" id="breadcrumbs">
    <ul class="breadcrumb">
      <li><i class="ace-icon fa fa-home home-icon"></i> <a href="#">Home</a></li>
      <li class="active">Relatório Detalhado por Convênio e Beneficiário — por Distinção de Evolução</li>
    </ul>
  </div>

  <div class="page-content">

    <!-- ══ FORMULÁRIO DE FILTRO ══════════════════════════════════════ -->
    <form role="form" action="/menu/atendimento/tabdimConvBeneAtendvalFiltroEvo" method="POST"
          onsubmit="atualizaDataIni(); atualizaDataFin();">
      <div class="toolbar-pesquisa noprint">
        <h5>
          <i class="ace-icon fa fa-line-chart"></i>
          <span>Filtros — Relatório por Distinção de Evolução</span>
        </h5>
        <div class="form-inline">
          <div class="form-row">

            <div class="form-group">
              <label>Período de:</label>
              <input id="dataFilDe" name="dataFilDe" type="date" onchange="atualizaDataIni()">
              <input type="hidden" id="dataIni" name="dataIni" value="{{filtro.dataIni}}">
            </div>

            <div class="form-group">
              <label>até:</label>
              <input id="dataFilAte" name="dataFilAte" type="date" onchange="atualizaDataFin()">
              <input type="hidden" id="dataFim" name="dataFim" value="{{filtro.dataFim}}">
            </div>

            <div class="form-group">
              <label>Convênio:</label>
              <select name="relConvid" id="relConvid" class="chosen-select">
                <option value="766f69643132333435366964">-</option>
                {{#each convs}}
                  <option value="{{_id}}">{{conv_nome}}</option>
                {{/each}}
              </select>
              <input type="hidden" id="relConvIdFiltro" name="relConvIdFiltro" value="{{filtro.convid}}">
            </div>

            <button class="btn-pesquisar" type="submit">
              <i class="ace-icon fa fa-search"></i>
              Pesquisar
            </button>

            <button type="button" onclick="window.print();"
                    style="background:#6c757d; color:white; border:none; padding:8px 18px; border-radius:4px; font-weight:600; font-size:13px; cursor:pointer; display:flex; align-items:center; gap:6px; box-shadow:0 2px 4px rgba(0,0,0,.2);">
              <i class="ace-icon fa fa-print"></i>
              Imprimir (4 abas)
            </button>

          </div>
        </div>
      </div>
    </form>

    <!-- ══ ABAS DE NAVEGAÇÃO ════════════════════════════════════════ -->
    <div class="nav-abas noprint">
      <button class="aba-btn ativa" onclick="trocarAba('geral', this)">
        <i class="ace-icon fa fa-list"></i>
        Geral
        <span class="badge-sessoes badge-geral">{{totalGeral.sessoes}}</span>
      </button>
      <button class="aba-btn" onclick="trocarAba('comevo', this)">
        <i class="ace-icon fa fa-check-circle green"></i>
        Com Evolução
        <span class="badge-sessoes badge-comevo">{{totalComEvo.sessoes}}</span>
      </button>
      <button class="aba-btn" onclick="trocarAba('semevo-at', this)">
        <i class="ace-icon fa fa-times-circle red"></i>
        Sem Evo AT
        <span class="badge-sessoes badge-semevo-at">{{totalSemEvoAT.sessoes}}</span>
      </button>
      <button class="aba-btn" onclick="trocarAba('semevo-outros', this)">
        <i class="ace-icon fa fa-times-circle orange"></i>
        Sem Evo (Outros)
        <span class="badge-sessoes badge-semevo-outros">{{totalSemEvoNaoAT.sessoes}}</span>
      </button>
    </div>

    <!-- ══════════════════════════════════════════════════════════════
         ABA 1 — GERAL (todos os atendimentos)
    ══════════════════════════════════════════════════════════════════ -->
    <div id="painel-geral" class="painel-aba ativo">
      <div class="row">
        <div class="col-sm-12">
          <div class="widget-box">
            <div class="widget-header">
              <h4 class="widget-title">
                <i class="ace-icon fa fa-bar-chart"></i>
                Geral — {{conv_nome}}
                <small class="text-muted">({{periodoDe}} a {{periodoAte}})</small>
              </h4>
              <span class="widget-toolbar">
                <a href="#" data-action="reload"><i class="ace-icon fa fa-refresh"></i></a>
                <a href="#" data-action="collapse"><i class="ace-icon fa fa-chevron-up"></i></a>
              </span>
            </div>
            <div class="widget-body">
              <div class="widget-main">
                <div class="row"><div class="col-xs-12">
                  <table id="tabela-geral" class="table table-striped table-bordered table-hover">
                    <thead>
                      <tr>
                        <th style="width:30px;"></th>
                        <th>Beneficiário</th>
                        <th class="text-right">Sessões</th>
                        <th class="text-right">Vlr Unit Créd</th>
                        <th class="text-right">Vlr Total Créd</th>
                        <th class="text-right">Vlr Unit Déb</th>
                        <th class="text-right">Vlr Total Déb</th>
                        <th>Ação</th>
                      </tr>
                    </thead>
                    <tbody>
                    {{#each relsGeral}}
                    <tr data-bene-id="{{beneId}}">
                      <td class="text-center">
                        <i class="btn-expand ace-icon fa fa-plus-circle bigger-140"></i>
                      </td>
                      <td>{{beneNome}}</td>
                      <td class="text-right">{{sessoes}}</td>
                      <td class="text-right">{{valorUnitarioCred}}</td>
                      <td class="text-right">{{valorTotalCred}}</td>
                      <td class="text-right">{{valorUnitarioDeb}}</td>
                      <td class="text-right">{{valorTotalDeb}}</td>
                      <td></td>
                    </tr>

                    <tr class="detalhe-linha">
                      <td colspan="8">
                        <div class="detalhe-conteudo">
                          <h5>
                            <i class="ace-icon fa fa-list"></i>
                            Detalhes de "{{beneNome}}" ({{sessoes}} sessões)
                          </h5>
                          <table class="table table-condensed table-bordered" style="font-size:11px;">
                            <thead>
                              <tr>
                                <th>#</th>
                                <th>Data</th>
                                <th>Hora</th>
                                <th>Beneficiário</th>
                                <th>Convênio</th>
                                <th>Origem</th>
                                <th>Categoria</th>
                                <th>Evento</th>
                                <th>Terapia</th>
                                <th>Terapeuta</th>
                                <th>Cred</th>
                                <th>Deb</th>
                                <th>Terapia</th>
                                <th>Terapeuta</th>
                                <th>Cred</th>
                                <th>Deb</th>
                                <th>Terapia</th>
                                <th>Terapeuta</th>
                                <th>Cred</th>
                                <th>Deb</th>
                                <th class="text-center">Cred Usado</th>
                                <th class="text-center">Deb Usado</th>
                                <th class="text-center">Evolução</th>
                                <th class="text-center">Ação</th>
                              </tr>
                            </thead>
                            <tbody>
                            {{#each atendimentos}}
                            <tr>
                              <td class="text-center">{{ordem}}</td>
                              <td style="white-space:nowrap;min-width:75px;">{{data}}</td>
                              <td>{{hora}}</td>
                              <td>{{beneNome}}</td>
                              <td>{{convNome}}</td>
                              <td>{{{origemLabel}}}</td>
                              <td>{{{categoriaLabel}}}</td>
                              <td>{{{eventoLabel}}}</td>
                              <td>{{terapiaOrig}}</td>
                              <td>{{terapeutaOrig}}</td>
                              <td>{{{credOrig}}}</td>
                              <td>{{{debOrig}}}</td>
                              <td>{{terapiaFixa}}</td>
                              <td>{{terapeutaFixo}}</td>
                              <td>{{{credFixo}}}</td>
                              <td>{{{debFixo}}}</td>
                              <td>{{terapiaSubst}}</td>
                              <td>{{terapeutaSubst}}</td>
                              <td>{{{credSubst}}}</td>
                              <td>{{{debSubst}}}</td>
                              <td class="text-center">{{{credUsado}}}</td>
                              <td class="text-center">{{{debUsado}}}</td>
                              <td class="text-center">
                                {{#if evolucaoTexto}}
                                  <span class="evo-label-wrap">
                                    {{{seloLabel}}}
                                    <span class="evo-tooltip">{{evolucaoTexto}}</span>
                                  </span>
                                {{else}}
                                  {{{seloLabel}}}
                                {{/if}}
                              </td>
                              <td class="text-center">
                                {{#if permiteEdicao}}
                                <a class="green" href="/menu/atendimento/atendadm/edi/{{_id}}">
                                  <i class="ace-icon fa fa-pencil bigger-130"></i>
                                </a>
                                {{/if}}
                              </td>
                            </tr>
                            {{/each}}
                            </tbody>
                          </table>
                        </div>
                      </td>
                    </tr>
                    {{/each}}
                    </tbody>
                    <tfoot>
                      <tr>
                        <td colspan="2" class="text-right"><b>Total Geral:</b></td>
                        <td class="text-right"><b>{{totalGeral.sessoes}}</b></td>
                        <td class="text-right">-</td>
                        <td class="text-right"><b>{{totalGeral.totalCred}}</b></td>
                        <td class="text-right">-</td>
                        <td class="text-right"><b>{{totalGeral.totalDeb}}</b></td>
                        <td></td>
                      </tr>
                    </tfoot>
                  </table>
                </div></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div><!-- /painel-geral -->

    <!-- ══════════════════════════════════════════════════════════════
         ABA 2 — COM EVOLUÇÃO SELADA
    ══════════════════════════════════════════════════════════════════ -->
    <div id="painel-comevo" class="painel-aba">
      <div class="row">
        <div class="col-sm-12">
          <div class="widget-box">
            <div class="widget-header" style="background:#d4edda; border-color:#28a745;">
              <h4 class="widget-title">
                <i class="ace-icon fa fa-check-circle green"></i>
                Com Evolução Selada — {{conv_nome}}
                <small class="text-muted">({{periodoDe}} a {{periodoAte}})</small>
              </h4>
              <span class="widget-toolbar">
                <a href="#" data-action="reload"><i class="ace-icon fa fa-refresh"></i></a>
                <a href="#" data-action="collapse"><i class="ace-icon fa fa-chevron-up"></i></a>
              </span>
            </div>
            <div class="widget-body">
              <div class="widget-main">
                {{#if relsComEvo}}
                <div class="row"><div class="col-xs-12">
                  <table id="tabela-comevo" class="table table-striped table-bordered table-hover">
                    <thead>
                      <tr>
                        <th style="width:30px;"></th>
                        <th>Beneficiário</th>
                        <th class="text-right">Sessões</th>
                        <th class="text-right">Vlr Unit Créd</th>
                        <th class="text-right">Vlr Total Créd</th>
                        <th class="text-right">Vlr Unit Déb</th>
                        <th class="text-right">Vlr Total Déb</th>
                        <th>Ação</th>
                      </tr>
                    </thead>
                    <tbody>
                    {{#each relsComEvo}}
                    <tr data-bene-id="{{beneId}}">
                      <td class="text-center">
                        <i class="btn-expand ace-icon fa fa-plus-circle bigger-140"></i>
                      </td>
                      <td>{{beneNome}}</td>
                      <td class="text-right">{{sessoes}}</td>
                      <td class="text-right">{{valorUnitarioCred}}</td>
                      <td class="text-right">{{valorTotalCred}}</td>
                      <td class="text-right">{{valorUnitarioDeb}}</td>
                      <td class="text-right">{{valorTotalDeb}}</td>
                      <td></td>
                    </tr>

                    <tr class="detalhe-linha">
                      <td colspan="8">
                        <div class="detalhe-conteudo">
                          <h5>
                            <i class="ace-icon fa fa-check-circle green"></i>
                            Detalhes de "{{beneNome}}" — Com Evolução ({{sessoes}} sessões)
                          </h5>
                          <table class="table table-condensed table-bordered" style="font-size:11px;">
                            <thead>
                              <tr>
                                <th>#</th>
                                <th>Data</th>
                                <th>Hora</th>
                                <th>Beneficiário</th>
                                <th>Convênio</th>
                                <th>Origem</th>
                                <th>Categoria</th>
                                <th>Evento</th>
                                <th>Terapia</th>
                                <th>Terapeuta</th>
                                <th>Cred</th>
                                <th>Deb</th>
                                <th>Terapia</th>
                                <th>Terapeuta</th>
                                <th>Cred</th>
                                <th>Deb</th>
                                <th>Terapia</th>
                                <th>Terapeuta</th>
                                <th>Cred</th>
                                <th>Deb</th>
                                <th class="text-center">Cred Usado</th>
                                <th class="text-center">Deb Usado</th>
                                <th class="text-center">Evolução</th>
                                <th class="text-center">Ação</th>
                              </tr>
                            </thead>
                            <tbody>
                            {{#each atendimentos}}
                            <tr>
                              <td class="text-center">{{ordem}}</td>
                              <td style="white-space:nowrap;min-width:75px;">{{data}}</td>
                              <td>{{hora}}</td>
                              <td>{{beneNome}}</td>
                              <td>{{convNome}}</td>
                              <td>{{{origemLabel}}}</td>
                              <td>{{{categoriaLabel}}}</td>
                              <td>{{{eventoLabel}}}</td>
                              <td>{{terapiaOrig}}</td>
                              <td>{{terapeutaOrig}}</td>
