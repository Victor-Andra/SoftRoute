                        </div>
                      </td>
                    </tr>
                    {{/each}}
                    </tbody>
                    <tfoot>
                      <tr>
                        <td colspan="2" class="text-right"><b>Total Com Evolução:</b></td>
                        <td class="text-right"><b>{{totalComEvo.sessoes}}</b></td>
                        <td class="text-right">-</td>
                        <td class="text-right"><b>{{totalComEvo.totalCred}}</b></td>
                        <td class="text-right">-</td>
