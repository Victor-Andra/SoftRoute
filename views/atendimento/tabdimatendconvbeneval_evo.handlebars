                      </tr>
                    </tfoot>
                  </table>
                </div></div>
                {{else}}
                  <div class="alert alert-success" style="margin:16px;">
                    <i class="ace-icon fa fa-info-circle"></i>
                    Nenhum atendimento com evolução selada encontrado para o período/convênio selecionado.
                  </div>
                {{/if}}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div><!-- /painel-comevo -->

    <!-- ══════════════════════════════════════════════════════════════
         ABA 3 — SEM EVOLUÇÃO — AT
    ══════════════════════════════════════════════════════════════════ -->
    <div id="painel-semevo-at" class="painel-aba">
      <div class="row">
        <div class="col-sm-12">
          <div class="widget-box">
            <div class="widget-header" style="background:#f8d7da; border-color:#dc3545;">
              <h4 class="widget-title">
                <i class="ace-icon fa fa-times-circle red"></i>
                Sem Evolução Selada — AT — {{conv_nome}}
                <small class="text-muted">({{periodoDe}} a {{periodoAte}})</small>
              </h4>
              <span class="widget-toolbar">
                <a href="#" data-action="reload"><i class="ace-icon fa fa-refresh"></i></a>
                <a href="#" data-action="collapse"><i class="ace-icon fa fa-chevron-up"></i></a>
              </span>
            </div>
