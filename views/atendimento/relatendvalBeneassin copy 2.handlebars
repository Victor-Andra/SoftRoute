<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Relatório Analítico de Atendimentos por Beneficiário</title>
		<style>
			/* Estilos para tela */
			@media screen {
				.print-footer {
					display: none;
				}
			}

			/* Estilos para impressão */
			@media print {
				.noprint {
					display: none !important;
				}

				.print-footer {
					display: block;
					position: fixed;
					bottom: 0;
					left: 0;
					right: 0;
					text-align: center;
					font-size: 11px;
					padding: 5px 0;
					background: white;
					z-index: 9999;
				}

				body {
					margin-bottom: 40mm; /* Espaço para rodapé fixo */
				}

				@page {
					margin: 1cm;
					@bottom-center {
						content: "Página " counter(page) " de " counter(pages);
						font-size: 11px;
					}
				}
			}

			/* Estilos específicos para impressão em modo paisagem */
			@media print and (orientation: landscape) {
				/* Apenas garantimos que o noprint continue funcionando */
				.noprint {
					display: none !important;
				}
			}
		</style>
		<script type="text/javascript">
			function atualizaDataIni(){
				let fulldate = (document.getElementById('dataFilDe').value+' 00:00:00.000Z').toString();
				document.getElementById('dataIni').value = fulldate;
			}
			function atualizaDataFin(){
				let fulldate = (document.getElementById('dataFilAte').value+' 00:00:00.000Z').toString();
				document.getElementById('dataFim').value = fulldate;
			}
		</script>
	</head>
	<body onload="javascript:controlaNave();" class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner noprint">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs" style="display: none">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Relatório de Atendimentos por Beneficiário</li>
						</ul><!-- /.breadcrumb -->
					</div>
					<form role="form" action="/menu/atendimento/relatendbeneassins" method="POST">
						<div class="breadcrumbs noprint" id="breadcrumbs" style="align-items: center;" style="text-align: center;"/>
							<ul class="breadcrumb">
								<label>Período de:</label>
								<input style="height: 30px;" id="dataFilDe" name="dataFilDe" type="date" onchange="javascript:atualizaDataIni()">
								<input class="hidden" id="dataIni" name="dataIni" />
								<label>até:</label>
								<input style="height: 30px;" id="dataFilAte" name="dataFilAte" type="date" onchange="javascript:atualizaDataFin()">
								<input class="hidden" id="dataFim" name="dataFim" />
								<label>Beneficiário: </label>
								<select style="height: 30px; width:300px;" name="relBeneid"  id="relBeneid" class="chosen-select" data-placeholder="Escolha...">
									{{#each benes}}
										<option value="{{_id}}">{{bene_nome}}</option>
									{{/each}}
								</select>
								&nbsp;&nbsp;&nbsp;&nbsp;
								<label class="control-label bolder red">
									<select name="porHoras" id="porHoras" class="chosen-select" value=""  >
											<option value="nao">Não</option>
											<option value="sim">Sim</option>
									</select>
									<span class="lbl">&nbsp;Mostrar horas?</span>
								</label>
								&nbsp;&nbsp;&nbsp;&nbsp;
								<label class="control-label bolder red">
									<select name="porSala" id="porSala" class="chosen-select" value=""  >
											<option value="nao">Não</option>
											<option value="sim">Sim</option>
									</select>
									<span class="lbl">&nbsp;Mostrar sala?</span>
								</label>
								&nbsp;&nbsp;&nbsp;&nbsp;
								<label class="control-label bolder red">
									<select name="exibeInativos" id="exibeInativos" class="chosen-select" value=""  >
											<option value="nao">Não</option>
											<option value="sim">Sim</option>
									</select>
									<span class="lbl">&nbsp;Exibir Inativos?</span>
								</label>
								<button class="btn btn-info" name="acaoSalvar" id="acaoSalvar" type="submit">
									<i class="ace-icon fa fa-search bigger-110"></i>
									Pesquisar
								</button>
							</ul><!-- /.breadcrumb -->
						</div>
					</form>
				</div>
				<div class="row">
					<div class="col-xs-12">
						<!-- PAGE CONTENT BEGINS -->
						<div class="space-6"></div>
						<div class="row">
							<div id="divPadds" class="col-sm-12">
								<div class="widget-box transparent">
									<div style="text-align: center;">
										<img width="140" height="60" alt="150x150" style="alight: center" src="/images/gallery/logo_route_centro.png">
									</div>
										<div class="widget-header widget-header-large" style="padding-left: 20px;">
											<h3 class="widget-title grey lighter">
												<i class="ace-icon fa fa-leaf green"></i>
												Atendimentos por Beneficiário
											</h3>
										</div>
									<div class="widget-body">
										<div class="widget-main padding-24">
											<div class="row">
												<div class="col-sm-12">
													<div class="row">
														<div class="col-xs-12 label label-lg label-info arrowed-in arrowed-right">
															<b>Informações do Prestador</b>
														</div>
													</div>
													<div>
														<ul class="list-unstyled">
															<li>
																<i class="ace-icon fa fa-caret-right blue"></i><b>Prestador: </b>Route Centro de Terapia e Apoio Infantil
															</li>
															<li>
																<i class="ace-icon fa fa-caret-right blue"></i><b>CNPJ: </b> 33.346.423/0001-17
															</li>
														</ul>
													</div>
													<div class="row">
														<div class="col-xs-12 label label-lg label-success arrowed-in arrowed-right">
															<b>Informações do Relatório</b>
														</div>
													</div>
													<div>
														<ul class="list-unstyled ">
															<li>
																<i class="ace-icon fa fa-caret-right green"></i><b>Período de: </b>{{periodoDe}}<b> até: </b>{{periodoAte}}
															</li>
															<li>
																<i class="ace-icon fa fa-caret-right green"></i><b>Beneficiário: </b>{{bene_nome}}
															</li>
															<li>
																<i class="ace-icon fa fa-caret-right green"></i><b>Convênio:</b> {{conv_nome}}
															</li>
														</ul>
													</div>
													<div class="row">
														<div class="col-xs-12 label label-lg label-warning arrowed-in arrowed-right">
															<b>Informações dos Atendimentos</b>
														</div>
													</div>
											</div><!-- /.row -->
											<div>
												<table class="table table-striped table-bordered" style="font-size: 10px;">
													<thead>
														
														<tr>
															{{#compareString porHoras "sim"}}
															<th style="width:11%">Data do Atendimento/<br>Horário de início e fim da sessão</th>
															{{else}}
															<th style="width:11%">Data do Atendimento</th>
															{{/compareString}}
															{{#compareString porSala "sim"}}
															<th>Local do <br>Atendimento</th>
															{{else}}
															{{/compareString}}
															<th style="width:11%">Especialidade</th>
															<th style="width:24%">Profissional</th>
															<th style="width:24%">Ass. Profissional</th>
															<th style="width:24%">Ass. Responsável</th>
														</tr>
													</thead>
													{{#each rels}}
														<tbody>
															<tr>
																<td style="width:8%;height:100px">{{dt}}
																	{{#compareString ../porHoras "sim"}}
																	<br>Hora Ini: {{horaIni}}<br>Hora Fim: {{horaFim}}
																	{{/compareString}}
																	</td><!-- /.somente data -->
																{{#compareString ../porSala "sim"}}
																<td>{{sala}}</td>
																{{else}}
																{{/compareString}}
																{{#each ../terapias}}
																	{{#ifEqual this._id ../especialidade}}
																		<td>{{terapia_nomecid}}</td>
																	{{/ifEqual}}
																{{/each}}
																{{#each ../terapeutas}}
																	{{#ifEqual this._id ../profissional}}
																		<td>{{usuario_nomecompleto}}</td>
																	{{/ifEqual}}
																{{/each}}
																<td style="width:18%">
																	-
																</td>
																<td style="width:18%">
																	-
																</td>
															</tr>
														</tbody>
													{{/each}}
													<footer>
														
													</footer>
												</table>
											</div>
											
										</div>
									</div>
								</div>
							</div>
						</div><!-- PAGE CONTENT ENDS -->
					</div><!-- /.col -->
				</div><!-- /.row -->
			</div><!-- /.main-content -->
		</div><!-- /.main-container --><!-- basic scripts -->
		<div id="rodape" style="text-align: center; margin-top: 20px;"></div>
		<script>
			// Exemplo: Mostrar a primeira página
            //mostrarPagina(1, 7);
            function mostrarPagina(paginaAtual, totalPaginas) {
                  const rodape = document.getElementById("rodape");
                  if (rodape) {
                        rodape.innerHTML = `Página ${paginaAtual} de ${totalPaginas}`;
                  }
            }
      </script>
	  <div class="row"><!-- Área reservada para Assinaturas -->
			<div class="space"></div>
			
			<div class="col-xs-4 col-sm-4">
				<div class="hr"></div>
				<label>Assinatura da Clínica</label>
			</div>
		</div><!-- /.Área reservada para Assinaturas -->
		<div class="print-footer" id="printFooter"></div>
	</body>
</html>
