<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<style>
			/* Estilos para tela */
			@media screen {
				.print-header {
					display: none;
				}
			}

			/* Estilos para impressão */
			@media print {
				.noprint {
					display: none !important;
				}

				/* Cabeçalho fixo com paginação no topo */
				.print-header {
					position: fixed;
					top: 0;
					left: 0;
					right: 0;
					text-align: center;
					font-size: 11px;
					padding: 4px 0;
					background: white;
					z-index: 9999;
					content: "Página " counter(page) " de " counter(pages);
				}

				/* Margem superior para não sobrepor conteúdo */
				body {
					margin-top: 12mm; /* suficiente para o cabeçalho */
					margin-bottom: 10mm;
				}

				/* Configuração da página: permite retrato ou paisagem conforme escolha do usuário */
				@page {
					margin: 1cm;
					/* NÃO defina `size` aqui — isso bloqueia a orientação! */
					@top-center {
						content: "Página " counter(page) " de " counter(pages);
						font-size: 11px;
						color: black;
					}
					@bottom-center {
						content: ""; /* remove qualquer rodapé automático */
					}
				}

				/* Garante que elementos grandes não quebrem mal */
				table {
					page-break-inside: avoid;
				}
			}
		</style>

		<title>Relatório de Atendimentos e Valores</title>
		<script type="text/javascript">
			function atualizaDataIni() {
				const val = document.getElementById('dataFilDe').value;
				if (val) {
				document.getElementById('dataIni').value = val + ' 00:00:00.000Z';
				}
			}
			function atualizaDataFin() {
				const val = document.getElementById('dataFilAte').value;
				if (val) {
				document.getElementById('dataFim').value = val + ' 00:00:00.000Z';
				}
			}
			function carregaBody() {
				// Preenche campos visíveis com base nos ocultos (persistência)
				const ini = document.getElementById('dataIni').value || '';
				const fim = document.getElementById('dataFim').value || '';
				
				if (ini) document.getElementById('dataFilDe').value = ini.split(' ')[0];
				if (fim) document.getElementById('dataFilAte').value = fim.split(' ')[0];
				
				// Seleciona convênio
				const convId = document.getElementById('relConvIdFiltro').value || '766f69643132333435366964';
				document.getElementById('relConvid').value = convId;
				
				// Atualiza chosen
				if (typeof $.fn.chosen === 'function') {
				$('.chosen-select').trigger('chosen:updated');
				}
			}
		</script>
	</head>
	<body onload="controlaNave(); carregaBody();" class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state noprint" id="breadcrumbs_home">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Relatório de Atendimentos e Valores por Convênio</li>
						</ul>
					</div>

					<!-- ✅ Formulário com validação no submit -->
					<form role="form" action="/menu/atendimento/relatendvals" method="POST" id="relForm">
						<div class="breadcrumbs noprint" style="align-items: center; ">
							<ul class="breadcrumb">
								<li>
									<label>Período de:</label>
									<input style="height: 30px;" id="dataFilDe" name="dataFilDe" type="date" onchange="atualizaDataIni()">
									<!-- ✅ Removido onchange -->
								</li>
								<li>
									<label>até:</label>
									<input style="height: 30px;" id="dataFilAte" name="dataFilAte" type="date" onchange="atualizaDataFin()">
									<!-- ✅ Removido onchange -->
								</li>
								<li>
									<label>Convênio:</label>
								</li>
								<li>
									<div style="width: 300px;">
										<select name="relConvid" id="relConvid" class="chosen-select" data-placeholder="Escolha...">
											<option value="766f69643132333435366964">-</option>
											{{#each convs}}
												<option value="{{_id}}">{{conv_nome}}</option>
											{{/each}}
										</select>
									</div>
								</li>
								<li>
									<label class="control-label bolder red">
										<span class="lbl">&nbsp;Exibir Inativos?</span>
										<select name="exibeInativos" id="exibeInativos" class="chosen-select">
											<option value="nao">Não</option>
											<option value="sim">Sim</option>
										</select>
										
									</label>
								</li>
								<li>
									<button class="btn btn-info"  type="submit">
										<i class="ace-icon fa fa-search bigger-110"></i>
										Pesquisar
									</button>
								</li>
							</ul>
						</div>
						<!-- ✅ Campos ocultos (sem redundância) -->
						<!-- ... inputs ... -->
						<input class="hidden" id="dataIni" name="dataIni" value="{{filtro.dataIni}}">

						<input class="hidden" id="dataFim" name="dataFim" value="{{filtro.dataFim}}">

						
						<input class="hidden" id="relConvIdFiltro" name="relConvIdFiltro" value="{{filtro.convId}}">
					</form>

					
					
						
						

					<!-- Conteúdo do relatório (sem alteração) -->
					<div class="row">
						<div class="col-xs-12">
							<div class="space-6"></div>
							<div class="row">
								<div class="col-sm-10 col-sm-offset-1">
									<div class="widget-box transparent">
										<div style="text-align: center;">
											<img width="140" height="60" alt="Logo" src="/images/gallery/logo_route_centro.png">
										</div>
										<div class="widget-header widget-header-large">
											<h3 class="widget-title grey lighter">
												<i class="ace-icon fa fa-leaf green"></i>
												Atendimentos e Valores
											</h3>
										</div>
										<div class="widget-body">
											<div class="widget-main padding-24">
												<div class="row">
													<div class="col-sm-12">
														<div class="row">
															<div class="col-xs-12 label label-lg label-info arrowed-in arrowed-right">
																<b>Informações do Prestador</b>
															</div>
														</div>
														<ul class="list-unstyled">
															<li><i class="ace-icon fa fa-caret-right blue"></i><b>Prestador: </b>Route Centro de Terapia e Apoio Infantil</li>
															<li><i class="ace-icon fa fa-caret-right blue"></i><b>CNPJ: </b>33.346.423/0001-17</li>
														</ul>

														<div class="row">
															<div class="col-xs-12 label label-lg label-success arrowed-in arrowed-right">
																<b>Informações do Relatório</b>
															</div>
														</div>
														<ul class="list-unstyled">
															<li><i class="ace-icon fa fa-caret-right green"></i><b>Período de: </b>{{periodoDe}}<b> até: </b>{{periodoAte}}</li>
															<li><i class="ace-icon fa fa-caret-right green"></i><b>Convênio:</b> {{conv_nome}}</li>
														</ul>

														<div class="row">
															<div class="col-xs-12 label label-lg label-warning arrowed-in arrowed-right">
																<b>Informações dos Atendimentos</b>
															</div>
														</div>
													</div>
												</div>

												<table class="table table-striped table-bordered">
													<thead>
														<tr>
															<th class="center">#</th>
															<th>Terapia</th>
															<th>Sessões</th>
															<th>Valor da Sessão</th>
															<th>Valor Total</th>
														</tr>
													</thead>
													{{#each rels}}
														<tr>
															<td class="center">#</td>
															{{#each ../terapias}}
																{{#ifEqual this._id ../nomecid}}
																	<td>{{terapia_nome}}</td>
																{{/ifEqual}}
															{{/each}}
															<td>{{sessoes}}</td>
															<td>{{valor}}</td>
															<td>{{total}}</td>
														</tr>
													{{/each}}
													<tfoot>
														<tr class="hr-double">
															<td class="right">-</td>
															<td><b>Total</b></td>
															<td><b>{{total.sessoes}}</b></td>
															<td><b>-</b></td>
															<td><b>{{total.total}}</b></td>
														</tr>
													</tfoot>
												</table>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Áreas de rodapé/assinatura (sem alteração) -->
		<div id="rodape" style="text-align: center; margin-top: 20px;"></div>
		<div class="row">
			<div class="col-xs-12">
				<div style="margin-top: 32px;"></div>
				<div class="row">
					<div class="col-xs-4 col-sm-4"></div>
					<div class="col-xs-4 col-sm-4"></div>
					<div class="col-xs-4 col-sm-4 text-center">
						<div class="hr"></div>
						<label>Assinatura da Clínica</label>
					</div>
				</div>
			</div>
		</div>
		<div class="print-header"></div>
		<div style="page-break-before: always;"></div>

		<!-- ✅ Script essencial (refatorado) -->
	
	</body>
</html>
