					</h4>
					<span class="widget-toolbar">
					<a href="#" data-action="reload"><i class="ace-icon fa fa-refresh"></i></a>
					<a href="#" data-action="collapse"><i class="ace-icon fa fa-chevron-up"></i></a>
					</span>
				</div>

				<div class="widget-body">
					<div class="widget-main">
					<div class="row">
						<div class="col-xs-12">
						<table id="tabela-consolidada" class="table table-striped table-bordered table-hover">
							<thead>
							<tr>
								<th style="width: 30px;"></th>
								<th>Terapia</th>
								<th class="text-right">Sessões</th>
								<th class="text-right">Vlr Unit Créd</th>
								<th class="text-right">Vlr Total Créd</th>
								<th class="text-right">Vlr Unit Déb</th>
								<th class="text-right">Vlr Total Déb</th>
								<th>Ação</th>
							</tr>
							</thead>
							<tbody>
							{{#each rels}}
							<tr data-terapia-id="{{terapiaId}}">
								<td class="text-center">
								<i class="btn-expand ace-icon fa fa-plus-circle bigger-140"></i>
								</td>
								<td>{{terapiaNome}}</td>
								<td class="text-right">{{sessoes}}</td>
								<td class="text-right">{{valorUnitarioCred}}</td>
								<td class="text-right">{{valorTotalCred}}</td>
								<td class="text-right">{{valorUnitarioDeb}}</td>
								<td class="text-right">{{valorTotalDeb}}</td>
								<td></td>
							</tr>

							<tr class="detalhe-linha">
								<td colspan="8">
								<div class="detalhe-conteudo">
									<h5>
									<i class="ace-icon fa fa-list"></i> 
									Detalhes de "{{terapiaNome}}" ({{sessoes}} sessões)
									</h5>

									<table class="table table-condensed table-bordered" style="font-size:11px;">
									<thead>
										<tr>
										<th>#</th>
										<th>Data</th>
										<th>Hora</th>
										<th>Beneficiário</th>
										<th>Convênio</th>
										<th>Origem</th>
										<th>Categoria</th>
										<th>Evento</th>
										<th>Terapia</th>
										<th>Terapeuta</th>
										<th>Cred</th>
										<th>Deb</th>
										<th>Terapia</th>
										<th>Terapeuta</th>
										<th>Cred</th>
										<th>Deb</th>
										<th>Terapia</th>
										<th>Terapeuta</th>
										<th>Cred</th>
										<th>Deb</th>
										<th class="text-center">Cred Usado</th>
										<th class="text-center">Deb Usado</th>
										<th class="text-center">Ação</th>
										</tr>
									</thead>
									<tbody>
										{{#each atendimentos}}
										<tr>
										<td class="text-center">{{ordem}}</td>
										<td style="white-space: nowrap !important; min-width: 75px;">{{data}}</td>
										<td>{{hora}}</td>
										<td>{{beneNome}}</td>
										<td>{{convNome}}</td>
										<td>{{{origemLabel}}}</td>
										<td>{{{categoriaLabel}}}</td>
										<td>{{{eventoLabel}}}</td>

										<td>{{terapiaOrig}}</td>
										<td>{{terapeutaOrig}}</td>
										<td>{{{credOrig}}}</td>
										<td>{{{debOrig}}}</td>

										<td>{{terapiaFixa}}</td>
										<td>{{terapeutaFixo}}</td>
										<td>{{{credFixo}}}</td>
										<td>{{{debFixo}}}</td>

										<td>{{terapiaSubst}}</td>
										<td>{{terapeutaSubst}}</td>
										<td>{{{credSubst}}}</td>
										<td>{{{debSubst}}}</td>

										<td class="text-center">{{{credUsado}}}</td>
										<td class="text-center">{{{debUsado}}}</td>

										<td class="text-center">
											{{#if permiteEdicao}}
											<a class="green" href="/menu/atendimento/atendadm/edi/{{_id}}">
											<i class="ace-icon fa fa-pencil bigger-130"></i>
											</a>
											{{/if}}
										</td>
										</tr>
										{{/each}}
									</tbody>
									</table>
								</div>
								</td>
							</tr>
							{{/each}}
							</tbody>
							<tfoot>
							<tr>
								<td colspan="2" class="text-right"><b>Total Geral:</b></td>
								<td class="text-right"><b>{{total.sessoes}}</b></td>
								<td class="text-right">-</td>
								<td class="text-right"><b>{{total.totalCred}}</b></td>
								<td class="text-right">-</td>
								<td class="text-right"><b>{{total.totalDeb}}</b></td>
								<td></td>
							</tr>
							</tfoot>
						</table>
						</div>
					</div>
					</div>
				</div>
				</div>
			</div>
			</div>

		<!-- Áreas de rodapé/assinatura (sem alteração) -->
		<div id="rodape" style="text-align: center; margin-top: 20px;"></div>
		<div class="row">
			<div class="col-xs-12">
				<div style="margin-top: 32px;"></div>
				<div class="row">
					<div class="col-xs-4 col-sm-4"></div>
					<div class="col-xs-4 col-sm-4"></div>
					<div class="col-xs-4 col-sm-4 text-center">
						<div class="hr"></div>
						<label>Assinatura da Clínica</label>
					</div>
				</div>
			</div>
		</div>

		<!-- ✅ Script essencial (refatorado) -->
		<script type="text/javascript">
			// Aguarda o DOM estar pronto
			$(document).ready(function() {
				
				// Toggle expand/recolher nas linhas da tabela dinâmica
				$('.btn-expand').on('click', function(e) {
					e.preventDefault();
					e.stopPropagation();
					
					var $icon = $(this);
					var $linhaDetalhe = $icon.closest('tr').next('.detalhe-linha');
					
					// Alterna a classe de expansão
					$linhaDetalhe.toggleClass('expandida');
					$icon.toggleClass('expandida');
					
					// Opcional: muda o ícone de + para -
					if ($icon.hasClass('expandida')) {
						$icon.removeClass('fa-plus-circle').addClass('fa-minus-circle');
					} else {
						$icon.removeClass('fa-minus-circle').addClass('fa-plus-circle');
					}
				});
				
				// Opcional: recolher todos ao recarregar a página
				// $('.detalhe-linha').removeClass('expandida');
				// $('.btn-expand').removeClass('expandida fa-minus-circle').addClass('fa-plus-circle');
			});
		</script>
	</body>
</html>
