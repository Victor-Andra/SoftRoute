		<script>
			async function auditareExtra(id) {
				// Confirmação antes de prosseguir
				if (!confirm("Tem certeza que deseja auditar este extra e marcar como 'Gerado'?")) {
					return;
				}

				try {
					const response = await fetch(`/menu/atendimento/extra/auditare/${id}`, {
						method: 'PATCH',
						headers: {
							'Content-Type': 'application/json',
						},
						body: JSON.stringify({
							extra_auditado: true,
							extra_extraStatus: "Gerado"
						})
					});

					if (response.ok) {
						// ✅ Sucesso: atualiza a interface
						const cell = document.getElementById(`auditado-cell-${id}`);
						cell.innerHTML = '<span class="badge badge-success">Sim</span>';

						// Mostra alerta de sucesso
						mostraAlerta("Extra auditado e marcado como 'Gerado' com sucesso!", "success");

						// Opcional: recarrega a página após 2 segundos para atualizar contadores
						// setTimeout(() => location.reload(), 2000);
					} else {
						const data = await response.json();
						mostraAlerta("Erro: " + (data.message || "Falha ao atualizar"), "danger");
					}
				} catch (err) {
					console.error(err);
					mostraAlerta("Erro de conexão com o servidor.", "danger");
				}
			}

			// Função para exibir alerta dinâmico
			function mostraAlerta(mensagem, tipo = "info") {
				const alerta = document.createElement("div");
				alerta.className = `alert alert-${tipo} alert-dismissible fade in`;
				alerta.style.marginTop = "10px";
				alerta.innerHTML = `
					<button type="button" class="close" data-dismiss="alert" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
					${mensagem}
				`;
				const formPesquisa = document.getElementById("divFormPesquisa");
				formPesquisa.parentNode.insertBefore(alerta, formPesquisa.nextSibling);

				// Remove o alerta após 5 segundos
				setTimeout(() => {
					alerta.remove();
				}, 5000);
			}
		</script>
				
