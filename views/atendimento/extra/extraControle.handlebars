<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Controle e Auditoria de Extras e Geração de Atendimentos</title>
		<style>
			@media print and (orientation: landscape) {
				.noprint {
					display: none;
				}
			}
			@media print {
               .noprint {
                  display: none;
               }
            }
			@media print {
				.print-hide-link::after {
					content: none !important;
				}
			}
			.detail-row {
				display: none;
			}
			.detail-row.open {
				display: table-row;
			}

			#TabelaExpansiva td .action-buttons {
				margin-bottom: 0 !important;
			}
		
			#dynamic-table th,
			#dynamic-table td {
				font-size: 10px;
			}
		</style>
		<!-- Script que controla a expansão da linha -->
		<script type="text/javascript">
			jQuery(function ($) {
				$('.show-details-btn').on('click', function (e) {
					e.preventDefault();
					var $this = $(this);
					var $target = $this.closest('tr').next('.detail-row');
					$target.toggleClass('open');

					var icon = $this.find('i');
					icon.toggleClass('fa-angle-double-up').toggleClass('fa-angle-double-down');
				});
			});
		</script>
		<script type="text/javascript">

			function ajustaData(){
				let fullDatas = document.getElementsByName("fullData");
				fullDatas.forEach((elementox)=>{
					let id = "atenddata"+elementox.id;
					let dat = new Date(elementox.value);
					let mes = (dat.getMonth()+1).toString();
					let dia = (dat.getUTCDate()).toString();

					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}

					let fulldate=(dia+"/"+mes+"/"+dat.getFullYear()).toString();
				})
			}
			function formataData(){
				let tipo = document.getElementById("tipoData").value;
				console.log("tipoData:"+tipoData);
				if(tipo == "Ano/Mes"){
					let dat = new Date(document.getElementById('anoAtend').value+"-"+document.getElementById('mesAtend').value+"-01 00:00:00.000Z");
					let mes = (dat.getUTCMonth()+1).toString();
					let dia = (dat.getUTCDate()).toString();
					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}
					let fulldate = (dat.getFullYear()+"-"+mes+"-"+dia+' 00:00:00.000Z').toString();
					document.getElementById('dataFinal').value = fulldate;
					console.log("dataFinal:"+document.getElementById('dataFinal').value);
				} else if (tipo == "Semana"){
					let dat = new Date(document.getElementById('dataFil').value);
					let mes = (dat.getUTCMonth()).toString();
					let dia = (dat.getUTCDate()).toString();
					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}
					let fulldate = (dat.getFullYear()+"-"+mes+"-"+dia+' 00:00:00.000Z').toString();
					document.getElementById('dataFinal').value = fulldate;
					console.log("dataFinal:"+document.getElementById('dataFinal').value);
				} else if (tipo == "Dia"){
					let dat = new Date(document.getElementById('dataFil').value);
					let mes = (dat.getUTCMonth()).toString();
					let dia = (dat.getUTCDate()).toString();
					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}
					let fulldate = (dat.getFullYear()+"-"+mes+"-"+dia+' 00:00:00.000Z').toString();
					document.getElementById('dataFinal').value = fulldate;
					console.log("dataFinal:"+document.getElementById('dataFinal').value);
				}
			}
			function trocaFiltroData(){
				let fill = document.getElementById("tipoData").value;
				if(fill == "Ano/Mes"){
					document.getElementById("divAnoAtend").hidden = false;
					document.getElementById("divMesAtend").hidden = false;
					document.getElementById("divDataFil").hidden = true;
				} else if (fill == "Semana"){
					document.getElementById("divAnoAtend").hidden = true;
					document.getElementById("divMesAtend").hidden = true;
					document.getElementById("divDataFil").hidden = false;
				} else {
					document.getElementById("divAnoAtend").hidden = true;
					document.getElementById("divMesAtend").hidden = true;
					document.getElementById("divDataFil").hidden = false;
				}
			}
			
			function carregaBody(){
				trocaFiltroData();
				formataData();
				if (document.getElementById("carregaFiltro").value == "true"){
					document.getElementById("tipoData").value = document.getElementById("tipoDataFil").value;
					if(document.getElementById("tipoData").value == "Ano/Mes"){
						document.getElementById("anoAtend").value = document.getElementById("anoAtendFil").value;
						document.getElementById("mesAtend").value = document.getElementById("mesAtendFil").value;
					} else if (document.getElementById("tipoData").value == "Semana"){
						document.getElementById("dataFil").value = document.getElementById("dataFinalFil").value;
					} else if (document.getElementById("tipoData").value == "Dia"){
						document.getElementById("dataFil").value = document.getElementById("dataFinalFil").value;
					}

					document.getElementById("atendTipoPessoa").value = document.getElementById("tipoPessoaFil").value;
					if (document.getElementById("atendTipoPessoa").value == "Geral"){

					} else if (document.getElementById("atendTipoPessoa").value == "Beneficiario"){
						document.getElementById("atendBeneficiario").value = document.getElementById("atendBeneficiarioFil").value
					} else if (document.getElementById("atendTipoPessoa").value == "Terapeuta"){
						document.getElementById("atendTerapeuta").value = document.getElementById("atendTerapeutaFil").value;
					}

				}
			}
			
		</script>
		
	</head>

	<body onload="javascript:controlaNave();carregaBody();" class="no-skin">
		
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Route</a>
							</li>
							<li class="active">Controle e Auditoria de Extras e Geração de Atendimentos (sem Filtro)</li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<form id="divFormPesquisa" class="form-horizontal" role="form" action="/menu/atendimento/extra/ctrlextraF" method="POST">
							<div class="col-xs-12" class="row">
								<div class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label>Tipo Filtro:&nbsp;</label>
											<select name="tipoData" id="tipoData" class="chosen-select" data-placeholder="Escolha..." value="Ano/Mes" onchange="javascript:trocaFiltroData()">
												<option selected value="Ano/Mes">Ano/Mês</option>
												<option value="Semana">Semana</option>
												<option value="Dia">Dia</option>
											</select>
										</div>
									</div>
								</div>
								
								<div id="divAnoAtend" class="col-xs-12 col-sm-1">
									<div class="row">
										<div class="input-group">
											<label for="id-date-picker-1">Ano:&nbsp;</label>
											<select name="anoAtend" id="anoAtend" class="chosen-select" data-placeholder="Escolha..." value="2023" onchange="javascript:formataData();">
												<option value="2024">2024</option>
												<option selected value="2025">2025</option>
												<option value="2026">2026</option>
											</select>
										</div>
									</div>
								</div>
								<div id="divMesAtend" class="col-xs-12 col-sm-2">
									<div class="row">
										<div class="input-group">
											<label for="id-date-picker-1">Mês:&nbsp;</label>
											<select name="mesAtend" id="mesAtend" class="chosen-select" data-placeholder="Escolha..." value="Janeiro" onchange="javascript:formataData();">
												<option value="0">Janeiro</option>
												<option value="1">Fevereiro</option>
												<option value="2">Março</option>
												<option value="3">Abril</option>
												<option value="4">Maio</option>
												<option value="5">Junho</option>
												<option value="6">Julho</option>
												<option value="7">Agosto</option>
												<option value="8">Setembro</option>
												<option value="9">Outubro</option>
												<option value="10">Novembro</option>
												<option value="11">Dezembro</option>
											</select>
										</div>
									</div>
								</div>
								<div id="divDataFil" class="col-xs-12 col-sm-2">
									<div class="input-group">
										<label>Data:&nbsp;</label>
										<input style="height: 30px;" id="dataFil" name="dataFil" type="date" onchange="javascript:formataData();">
										<input class="hidden" id="dataFinal" name="dataFinal" />
									</div>
								</div>
								
								<div class="row">
									<button name="acaoPesquisar" id="acaoPesquisar" type="submit" class="btn btn-xs btn-info" style="margin-left: 25px;">
										<i class="ace-icon fa fa-search-plus "></i>
										Pesquisar
									</button>
									
								</div>
								<hr>
							</div>
						</form>
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<table>
									<thead>
										<tr role="row">
											<b>Etapas de Controle dos Extras</b>
										</tr>
										<tr class="odd">
											
											<td style="text-align: center;"><div class="alert alert-success">1</div></td>
											<td style="text-align: center;"><div class="alert alert-success">2</div></td>
											<td style="text-align: center;"><div class="alert alert-success">3</div></td>
											<td style="text-align: center;"><div class="alert alert-info"><span class="badge badge-info">4</span></div></td>
											<td style="text-align: center;"><div class="alert alert-warning">5</div></td>
											<td style="text-align: center;"><div class="alert alert-danger">6</div></td>
											<td style="text-align: center;"><div class="alert alert-danger">7</div></td>
											
										</tr>
									</thead>
									<tbody>
										<tr role="row" class="odd">
											<td><div class="alert alert-success">Agendamento dos Extras</div></td>
											<td><div class="alert alert-success">Verificação dos Extras</div></td>
											<td><div class="alert alert-success">Exportar Controle dos Extras</div></td>
											<td><div class="alert alert-info">Auditar Controle dos Extras</div></td>
											<td><div class="alert alert-warning">Criar Atendimento</div></td>
											<td><div class="alert alert-danger">Fechamento</div></td>
											<td><div class="alert alert-danger">Gerenciar Pagamento dos Extras</div></td>
										</tr>
									</tbody>
								</table>
								<div class="row">
									<div class="col-xs-12">
										<div class="row">
											<div class="alert alert-warning">
												<button type="button" class="close" data-dismiss="alert">
													<i class="ace-icon fa fa-times"></i>
												</button>
													Aqui você realiza a auditoria dos extras, analisa o momento e a forma como os atendimentos correspondentes aos extras serão gerados e acompanha se os pagamentos foram realizados de maneira total, parcial ou se houve glosa.<br>
													Caso necessário, é possível gerar novos atendimentos até que ocorra a quitação completa.
											</div>
										</div>
									</div>
								</div>
								<div class="col-xs-12">
										<table id="TabelaExpansiva" class="table table-bordered table-hover">
											<thead>
												<tr role="row">
													<th class="center">
														<label class="pos-rel">
															<input type="checkbox" class="ace" />
															<span class="lbl"></span>
														</label>
													</th>
													<th class="center detail-col">Detalhes</th>
													<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1">Beneficiário</th>
													<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1">Convênio</th>
													<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1">Data</th>
													<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1">Hora</th>
													<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1">Terapia</th>
													<th>Ações</th>
												</tr>
											</thead>
											<tbody>
												{{#each extras}}
													<tr>
														<td class="center">
																<label class="pos-rel">
																	<input type="checkbox" class="ace" />
																	<span class="lbl"></span>
																</label>
															</td>
														<td class="center">
															<div class="action-buttons">
																<a href="#" class="green bigger-140 show-details-btn" title="Show Details">
																	<i class="ace-icon fa fa-angle-double-up"></i>
																</a>
															</div>
														</td>
														{{#each ../benes}}
																{{#ifEqual this._id ../extra_beneid}}
																	<td>{{bene_nome}}</td>
																{{/ifEqual}}
															{{/each}}
														{{#each ../convs}}<!-- Ok -->	
															{{#ifEqual this._id ../extra_convid}}
																<td>{{conv_nome}}</td>
															{{/ifEqual}}
														{{/each}}
														<td>{{datacad}}</td>
														<td>hora</td>
														{{#each ../terapias}}<!-- Ok -->
															{{#ifEqual this._id ../extra_terapiaid}}
																<td>{{terapia_nome}}</td>
															{{/ifEqual}}
														{{/each}}
														<td>
															<!-- Ações -->
															<div class="hidden-sm hidden-xs action-buttons">
																<a class="blue" href="/menu/beneficiario/sessao/edi/{{_id}}">
																	<i class="ace-icon fa fa-search-plus bigger-120"></i>
																</a>
																<a class="green" href="#">
																	<i class="ace-icon fa fa-pencil bigger-130"></i>
																</a>
																<a class="red" href="#">
																	<i class="ace-icon fa fa-trash-o bigger-130"></i>
																</a>
															</div>
														</td>
													</tr>

													<!-- Linha de detalhe (expansível) -->
													<tr class="detail-row">
														<td colspan="8">
															<div class="table-detail">
																Detalhes adicionais sobre esta linha...
															</div>
														</td>
													</tr>
												{{/each}}
											</tbody>
										</table>
									</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

			<div class="footer">
				
			</div>

			<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse display">
				<i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
			</a>
		</div><!-- /.main-container ace-save-state -->

		<!-- basic scripts -->

		<script type="text/javascript">
			if('ontouchstart' in document.documentElement) document.write("<script src='../../../assets/js/jquery.mobile.custom.min.js'>"+"<"+"/script>");
		</script>
		<!-- page specific plugin scripts -->
		<script src="/assets/js/jquery.dataTables.min.js"></script>
		<script src="/assets/js/jquery.dataTables.bootstrap.min.js"></script>
		<script src="/assets/js/dataTables.tableTools.min.js"></script>
		<script src="/assets/js/dataTables.colVis.min.js"></script>

		<script type="text/javascript">
			$(document).ready(function () {
				$('#TabelaExpansiva').DataTable({
					"language": {
						"url": "/js/lang/datatable-pt-br.json"
					},
					"aaSorting": [],
					"aoColumns": [
						{ "bSortable": false }, // Coluna de detalhes
						null,
						null,
						null,
						null,
						null,
						{ "bSortable": false } // Ações
					],
					"responsive": true,
					"lengthMenu": [10, 25, 50, 100],
					"pageLength": 25,
					"lengthChange": true,
					"autoWidth": false,
					"paging": true,
					"searching": true,
					"ordering": true,
					"info": true,
					"select": {
						style: 'multi'
					}
				});

				$.fn.dataTable.Buttons.defaults.dom.container.className = 'dt-buttons btn-overlap btn-group btn-overlap';
			});
		</script>
		<script type="text/javascript">
			jQuery(function($) {
				// Mostra/esconde linha de detalhes ao clicar no ícone
				$('.show-details-btn').on('click', function(e) {
					e.preventDefault();
					var $this = $(this);
					var $target = $this.closest('tr').next('.detail-row');
					$target.toggleClass('open');

					var icon = $this.find('i');
					icon.toggleClass('fa-angle-double-up').toggleClass('fa-angle-double-down');
				});
			});
		</script>
	</body>

</html>