<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista de Extras Previstos no Agendamento</title>
		<style>
			@media print and (orientation: landscape) {
				.noprint {
					display: none;
				}
			}
			@media print {
               .noprint {
                  display: none;
               }
            }
			@media print {
				.print-hide-link::after {
					content: none !important;
				}
			}
			.detail-row {
				display: none;
			}
			.detail-row.open {
				display: table-row;
			}

			#TabelaExpansiva td .action-buttons {
				margin-bottom: 0 !important;
			}
		
			#dynamic-table th,
			#dynamic-table td {
				font-size: 10px;
			}
			/*Tooltip personalizado */
			.custom-tooltip {
				position: relative;
				display: inline-block;
				cursor: pointer;
			}

			.tooltip-text {
				visibility: hidden;
				width: max-content;
				background-color: #f3dfdf;
				color: red;
				font-size: 8px;
				text-align: left;
				border-radius: 4px;
				padding: 8px 12px;
				position: absolute;
				z-index: 9999;
				bottom: 125%; /* Acima do ícone */
				left: 50%;
				transform: translateX(-50%);
				opacity: 0.9;
				white-space: normal;
				min-width: 150px;
				max-width: 300px;
				box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
				transition: opacity 0.3s;
			}

			.tooltip-text::after {
				content: "";
				position: absolute;
				top: 100%;
				left: 50%;
				margin-left: -5px;
				border-width: 5px;
				border-style: solid;
				border-color: #f3dfdf transparent transparent transparent;
			}

			/* Mostra o tooltip quando o mouse passa sobre o link */
			.custom-tooltip:hover .tooltip-text {
				visibility: visible;
			}
		</style>
		
		<script type="text/javascript">
			
			function carregaBody(){
				//vazio
			}
			
		</script>
		<!-- Script que controla a expansão da linha -->
				
	</head>

	<body onload="javascript:controlaNave();carregaBody();" class="no-skin">
		
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Route</a>
							</li>
							<li class="active">Lista de Extras Previstos nos Agendamentos </li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<form id="divFormPesquisa" class="form-horizontal" role="form" action="/menu/atendimento/extra/lisF" method="POST">
							<div class="col-xs-12" class="row">
								<div class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label>Tipo Filtro:&nbsp;</label>
											<select name="tipoData" id="tipoData" class="chosen-select" data-placeholder="Escolha..." value="Ano/Mes" onchange="javascript:trocaFiltroData()">
												<option selected value="Ano/Mes">Ano/Mês</option>
												
											</select>
										</div>
									</div>
								</div>
								
								<div id="divAnoAtend" class="col-xs-12 col-sm-1">
									<div class="row">
										<div class="input-group">
											<label for="id-date-picker-1">Ano:&nbsp;</label>
											<select name="anoAtend" id="anoAtend" class="chosen-select" data-placeholder="Escolha..." value="2023" onchange="javascript:formataData();">
												<option value="2024">2024</option>
												<option selected value="2025">2025</option>
												<option value="2026">2026</option>
											</select>
										</div>
									</div>
								</div>
								<div id="divMesAtend" class="col-xs-12 col-sm-2">
									<div class="row">
										<div class="input-group">
											<label for="id-date-picker-1">Mês:&nbsp;</label>
											<select name="mesAtend" id="mesAtend" class="chosen-select" data-placeholder="Escolha..." value="Janeiro" onchange="javascript:formataData();">
												<option value="0">Janeiro</option>
												<option value="1">Fevereiro</option>
												<option value="2">Março</option>
												<option value="3">Abril</option>
												<option value="4">Maio</option>
												<option value="5">Junho</option>
												<option value="6">Julho</option>
												<option value="7">Agosto</option>
												<option value="8">Setembro</option>
												<option value="9">Outubro</option>
												<option value="10">Novembro</option>
												<option value="11">Dezembro</option>
											</select>
										</div>
									</div>
								</div>
																
								<div class="row">
									<button name="acaoPesquisar" id="acaoPesquisar" type="submit" class="btn btn-xs btn-info" style="margin-left: 25px;">
										<i class="ace-icon fa fa-search-plus "></i>
										Pesquisar
									</button>
									
								</div>
								<hr>
							</div>
						</form>
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<table>
									<thead>
										<tr role="row">
											<b>Etapas de Controle dos Extras</b>
										</tr>
										<tr class="odd">
											<strong>
											<td style="text-align: center;"><div class="alert alert-success">1</div></td>
											<td style="text-align: center;"><div class="alert alert-info">2</div></td>
											<td style="text-align: center;"><div class="alert alert-info">3</div></td>
											<td style="text-align: center;"><div class="alert alert-warning"><span class="badge badge-info">4</span></div></td>
											<td style="text-align: center;"><div class="alert alert-warning"><span class="badge badge-info">5</span></div></td>
											<td style="text-align: center;"><div class="alert alert-danger">6</div></td>
											<td style="text-align: center;"><div class="alert alert-danger">7</div></td>
											
										</tr>
									</thead>
									<tbody>
										<tr role="row" class="odd">
											<td><div class="alert alert-success">Agendamento dos Extras</div></td>
											<td><div class="alert alert-info">Verificação dos Extras</div></td>
											<td><div class="alert alert-info">Exportar Controle dos Extras</div></td>
											<td><div class="alert alert-warning">Auditar Controle dos Extras</div></td>
											<td><div class="alert alert-warning">Criar Atendimento</div></td>
											<td><div class="alert alert-danger">Fechamento</div></td>
											<td><div class="alert alert-danger">Gerenciar Pagamento dos Extras</div></td>
										</tr>
									</tbody>
								</table>
								<div class="row">
									<div class="col-xs-12">
										<div class="row">
									
									
										<div class="alert alert-warning">
											<button type="button" class="close" data-dismiss="alert">
												<i class="ace-icon fa fa-times"></i>
											</button>
												As etapas <span class="badge badge-info">4</span> e <span class="badge badge-info">5</span>, você gerencia os extras e se os mesmos são passíveis de cobrança (gerar o atendimento ou não).<br>
												
										</div>
									</div>
								
										
										<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info" style="font-size: 11px;">
											<thead>
												<tr role="row">
													
												
													<th style="width: 90px; white-space: nowrap;" class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data</th>
													<th style="width: 80px;" class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1" >Hora</th>
													<th class="sorting" tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="1" >Beneficiário</th>
													<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Convênio</th>
													<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapia</th>
													<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapeuta</th>
													<th class="sorting" tabindex="8" aria-controls="dynamic-table" rowspan="1" colspan="1" >Auditado</th>
													<th class="sorting" tabindex="8" aria-controls="dynamic-table" rowspan="1" colspan="1" >Status</th>
													<th style="width: 50%;"class="sorting" tabindex="8" aria-controls="dynamic-table" rowspan="1" colspan="1" >Histórico</th>
													
												</tr>
											</thead>
											<tbody>
												{{#each extras}}
													<tr>
														<td style="width: 90px; white-space: nowrap;">{{extraDatafor}}</td> <!-- Data formatada -->
														<td>{{extra_hora}}</td>
														<td><b><span class="badge badge-info">{{bene_nome}}</span></b><br>
														{{extra_obs}}
														</td> <!-- Nome do beneficiário -->
														<td>{{conv_nome}}</td> <!-- Nome do convênio -->
														<td>{{terapia_nome}}</td> <!-- Nome da terapia -->
														<td>{{extraTeraputa}}</td> <!-- Nome do terapeuta -->
														<td>
															<span class="badge badge-success">Sim</span>
														</td>
														<td>
															<span class="badge badge-warning">Aguardando</span>
																<!-- Tooltip com dados -->
																<a class="purple custom-tooltip" name="acaoCrud" id="acaoCrud">
																	<i class="ace-icon fa fa-eye bigger-130"></i>
																	<span class="tooltip-text">

																		<strong>Última Edição:</strong>
																		<p><b>{{dataedi}}</b></p>
																		<p>{{usuario_nome_edi}}</p>

																		<strong>Cadastrado em:</strong>
																		<p><b>{{datacad}}</b></p>
																		<p>{{usuario_nome_cad}}</p>

																	</span>
																</a>
																<!-- Tooltip com dados -->
																<a class="purple custom-tooltip" name="acaoCrud" id="acaoCrud">
																	<i class="ace-icon red fa fa-ban bigger-130"></i>
																	<span class="tooltip-text">

																		<strong>Ainda não foram cadastrados atendimentos para esse EXTRA.</strong>
																		
																	</span>
																</a>
														</td>
														<td>
															<div class="widget-box collapsed">
																<div class="widget-header">
																	<h6 class="widget-title">
																		<a href="#" data-action="reload">
																			<i class="ace-icon green fa fa-archive bigger-130"></i>
																		</a>
																		Container dos Atendimentos gerados para Esse Extra!
																	</h6>
																	<span class="widget-toolbar">
																		<a href="#" data-action="collapse">
																			<i class="orange ace-icon fa fa-chevron-up bigger-130"></i>
																		</a>
																	</span>
																	<span class="widget-toolbar">
																		<a name="acaoViz" id="acaoViz">
																			{{#if countProgs}}
																				<i class="ace-icon green fa fa-check bigger-130"></i>
																			{{else}}
																				<i class="ace-icon red fa fa-ban bigger-130" title="Ainda não foram cadastrados programas ABA para esse beneficiário."></i>
																			{{/if}}
																		</a>
																	</span>
																	<span class="widget-toolbar">
																		Qt. atendimentos:&nbsp;&nbsp;
																		<span class="badge badge-info">{{countProgs}}</span>
																	</span>
																</div>

																<div class="widget-body">
																	<div class="widget-main">
																		<div class="row">
																			<div class="col-sm-12">
																				<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
																					<thead style="font-size: 11px;">
																						<tr>
																							<th tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="5" style="width: 100px;" >Atendimento</th>
																							<th tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="7" style="width: 100px;" ><span class="label label-sm label-success" style="font-size: 14px;" >Original</span></th>
																							<th tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="4" style="width: 100px;" ><span class="label label-sm label-danger" style="font-size: 14px;" >Substituto Fixo</span></th>
																							<th tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1" style="width: 100px;" >&nbsp;</th>
																						</tr>
																						<tr role="row">
																							<th class="" class="center" tabindex="0">
																								<label class="pos-rel">
																									<input type="checkbox" id="marcar" name="marcar" class="ace" />
																									<span class="lbl"></span>
																								</label>
																							</th>
																							<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1" style="width: 100px;" >Data</th>
																							<th tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="1" style="width: 50px;" >Hora</th>
																							<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Beneficiário</th>
																							<th class="sorting" tabindex="4" aria-controls="dynamic-table" rowspan="1" colspan="1" >Convênio</th>
																							<th class="sorting" tabindex="5" aria-controls="dynamic-table" rowspan="1" colspan="1" >Origem</th>
																							<th class="sorting" tabindex="5" aria-controls="dynamic-table" rowspan="1" colspan="1" >Categoria</th>
																							<th class="sorting" tabindex="5" aria-controls="dynamic-table" rowspan="1" colspan="1" >Evento</th>
																							<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapia</th>
																							<th class="sorting" tabindex="7" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapeuta</th>
																							<th class="sorting" tabindex="8" aria-controls="dynamic-table" rowspan="1" colspan="1" >Cred</th>
																							<th class="sorting" tabindex="9" aria-controls="dynamic-table" rowspan="1" colspan="1" >Deb</th>
																							
																							<th class="sorting" tabindex="10" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapia</th>
																							<th class="sorting" tabindex="11" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapeuta</th>
																							<th class="sorting" tabindex="12" aria-controls="dynamic-table" rowspan="1" colspan="1" >Cred</th>
																							<th class="sorting" tabindex="13" aria-controls="dynamic-table" rowspan="1" colspan="1" >Deb</th>

																							<th class="" tabindex="14" aria-controls="dynamic-table" rowspan="1" colspan="1" style="width: 100px;">Ação</th>
																						</tr>
																					</thead>
																					<tbody style="font-size: 11px;">
																					</tbody>
																				</table>
																			</div>
																		</div>
																	</div>
																</div>
															</div>
														</td>
														
													</tr>
												{{/each}}
											</tbody>
										</table>
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

			<div class="footer">
				
			</div>

			<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse display">
				<i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
			</a>
		</div><!-- /.main-container ace-save-state -->

		<!-- basic scripts -->

		
		<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
			"language": { "url": "/js/lang/datatable-pt-br.json" },
			"aaSorting": [],
			"aoColumns": [ null, null,null, null, null, null, null, null, null],
			"responsive": true,
			"lengthMenu": [ 50, 100, 200],
			"lengthChange": true,
			"autoWidth": true,
			"paging": true,
			"lengthChange": true,
