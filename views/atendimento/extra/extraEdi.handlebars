                                                            {{/ifEqual}}
                                                        {{/each}}
                                                    {{/each}}
                                                    <input value="766f69643132333435366964" id="defaultConv" name="refBeneConv" /> <!-- void123456id -->
                                                </div>

                                                <label> Beneficiário</label>
												<div class="hidden">
													{{#each benes}}
														{{#each ../convs}}
															{{#ifEqual ../bene_convid _id}}
																<input value="{{../bene_convid}}" id="{{../_id}}" name="refBeneConv" />
															{{/ifEqual}}
														{{/each}}
													{{/each}}
												</div>
												<div class="form-group">
													<div class="col-sm-9">
