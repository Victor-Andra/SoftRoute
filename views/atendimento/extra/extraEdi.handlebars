                                                            </select>
                                                        </div>
                                                </div>

                                                <!-- Categoria do Extra (se aplicável) -->
                                                <label > Categoria </label>
												<div class="form-group">
													<div class="col-sm-6">
														<input type="text" name="extraCategoria" id="extraCategoria" placeholder="Padrão" class="form-control" readonly="true" value="{{atend_categoria}}"/>
													</div>
												</div>

                                                <!-- Associação de Convênio ao Beneficiário (lógica oculta) -->
