                                                        <textarea type="text" id="extraObs" name="extraObs" placeholder="Observações sobre este extra..." class="form-control" rows="3">{{extra.extra_obs}}</textarea>
                                                    </div>
                                                </div>

                                                <!-- Campos Ocultos para Edição (Dados Originais) -->
                                                <div id="divCarrega" name="divCarrega" class="hidden">
                                                    <!-- Campos de data/hora -->
                                                    <input id="extraDataEdi" name="extraDataEdi" value="{{extra.extra_data}}" />
                                                    <input id="extraHoraEdi" name="extraHoraEdi" value="{{extra.extra_hora}}" />

                                                    <!-- Campos de relacionamento -->
                                                    <input id="extraOrgEdi" name="extraOrgEdi" value="{{extra.extra_org}}" />
                                                    {{#if extra.extra_categoria}}<input id="extraCategoriaEdi" name="extraCategoriaEdi" value="{{extra.extra_categoria}}" />{{/if}}
                                                    <input id="extraBeneidEdi" name="extraBeneidEdi" value="{{extra.extra_beneid}}" />
                                                    <input id="extraConvidEdi" name="extraConvidEdi" value="{{extra.extra_convid}}" />
                                                    <input id="extraTerapeutaidEdi" name="extraTerapeutaidEdi" value="{{extra.extra_terapeutaid}}" />
                                                    <input id="extraTerapiaidEdi" name="extraTerapiaidEdi" value="{{extra.extra_terapiaid}}" />
                                                    <input id="extraSalaidEdi" name="extraSalaidEdi" value="{{extra.extra_salaid}}" />
                                                    <input id="extraObsEdi" name="extraObsEdi" value="{{extra.extra_obs}}" />

                                                    
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="space-4"></div>
                                <div class="space-4"></div>
                                <div class="form-actions">
