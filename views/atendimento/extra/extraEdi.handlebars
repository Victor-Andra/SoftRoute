<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <title>Edição de Extra</title> <!-- Título atualizado -->
        <script type="text/javascript">
            
            // Esta função é crucial - precisa carregar os dados do 'Extra' para edição
            function carregaBody(){
                console.log("START - Carregando dados do Extra para edição");
                // --- Campos principais do Extra ---
                // Data (assumindo que extra_data existe e está no formato correto)
                if (document.getElementById("extraDataEdi").value) {
                     document.getElementById("extradata").value = formataData(document.getElementById("extraDataEdi").value);
                }
                // Hora
                if (document.getElementById("extraHoraEdi").value) {
                     document.getElementById("extraHora").value = document.getElementById("extraHoraEdi").value;
                }
                // Origem
                if (document.getElementById("extraOrgEdi").value) {
                     document.getElementById("extraOrg").value = document.getElementById("extraOrgEdi").value;
                }
                // Categoria (se aplicável)
                if (document.getElementById("extraCategoriaEdi")) {
                     document.getElementById("extraCategoria").value = document.getElementById("extraCategoriaEdi").value;
                }
                // Beneficiário
                if (document.getElementById("extraBeneidEdi").value) {
                     document.getElementById("extraBeneid").value = document.getElementById("extraBeneidEdi").value;
                    
                }
                // Convênio
                if (document.getElementById("extraConvidEdi").value) {
                     document.getElementById("extraConvid").value = document.getElementById("extraConvidEdi").value;
                }
                // Terapeuta
                if (document.getElementById("extraTerapeutaidEdi").value) {
                     document.getElementById("extraTerapeutaid").value = document.getElementById("extraTerapeutaidEdi").value;
                }
                // Terapia
                if (document.getElementById("extraTerapiaidEdi").value) {
                     document.getElementById("extraTerapiaid").value = document.getElementById("extraTerapiaidEdi").value;
                }
                // Sala
                if (document.getElementById("extraSalaidEdi").value) {
                     document.getElementById("extraSalaid").value = document.getElementById("extraSalaidEdi").value;
                }
                // Observação
                if (document.getElementById("extraObsEdi").value) {
                     document.getElementById("extraObs").value = document.getElementById("extraObsEdi").value;
                }
               
               
                if (document.getElementById("extraDatacadEdi").value) {
                    document.getElementById("extraDatacad").value = formataData(document.getElementById("extraDatacadEdi").value);
                }

                if (document.getElementById("extraDataediEdi").value) {
                    document.getElementById("extraDataEdi").value = formataData(document.getElementById("extraDataediEdi").value);
                }

                if (document.getElementById("extraDtaExportadoEdi").value) {
                    document.getElementById("extraDtaExportado").value = formataData(document.getElementById("extraDtaExportadoEdi").value);
                }

                  if (document.getElementById("extraHoraExportadoEdi").value) {
                    document.getElementById("extraHoraExportado").value = document.getElementById("extraHoraExportadoEdi").value;
                 }
                  if (document.getElementById("extraUsuidExportouEdi").value) {
                    document.getElementById("extraUsuidExportou").value = document.getElementById("extraUsuidExportouEdi").value;
                 }
                  if (document.getElementById("extraExtraStatusEdi").value) {
                    document.getElementById("extraExtraStatus").value = document.getElementById("extraExtraStatusEdi").value;
                 }
                  if (document.getElementById("extraExtraStatusPgEdi").value) {
                    document.getElementById("extraExtraStatusPg").value = document.getElementById("extraExtraStatusPgEdi").value;
                 }
                  if (document.getElementById("extraAuditadoEdi").value) {
                    document.getElementById("extraAuditado").value = document.getElementById("extraAuditadoEdi").value;
                 }
                  if (document.getElementById("extraAuditadoObsEdi").value) {
                    document.getElementById("extraAuditadoObs").value = document.getElementById("extraAuditadoObsEdi").value;
                 }
              

                console.log("FINISH - Dados do Extra carregados");
            }

         
            function atualizaData(){
                // Atualiza o campo de data/hora combinada do Extra
                var dataInput = document.getElementById("extradata").value;
                var horaInput = document.getElementById("extraHora").value;
                if (dataInput && horaInput) {
                     var dataStr = dataInput + "T" + horaInput + ":00.000Z";
                     console.log("Data/Hora combinada:", dataStr);
                     var dataObj = new Date(dataStr);
                     if (!isNaN(dataObj.getTime())) {
                          document.getElementById("extraAtenddata").value = dataObj.toISOString(); // Ou outro formato esperado
                     } else {
                          console.error("Data/Hora inválida:", dataStr);
                     }
                } else {
                     console.log("Data ou Hora não preenchidas para combinar.");
                }
            }

            function formataData(dateStr) { // yyyy-MM-dd
                if (!dateStr) return '';
                var d = new Date(dateStr);
                if (isNaN(d.getTime())) {
                     console.error("Data inválida para formatação:", dateStr);
                     return '';
                }
                // Ajuste de timezone pode ser necessário dependendo de como a data é armazenada
                // if (d.getTimezoneOffset() == 180){ // Exemplo para UTC-3
                //     d.setHours(d.getHours() + 3);
                // }
                console.log("Formatando data:", d);
                let month = '' + (d.getMonth() + 1);
                let day = '' + d.getDate();
                let year = d.getFullYear();
                if (month.length < 2) month = '0' + month;
                if (day.length < 2) day = '0' + day;
                return [year, month, day].join('-');
            }


        </script>
    </head>
