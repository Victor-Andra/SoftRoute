                                                <div class="form-group">
                                                    <div class="col-sm-6">
                                                        <input type="text" id="extraUsuid" name="extraUsuid" class="form-control" readonly="true" value="{{usuarioAtual}}" />
                                                        <!-- Ou mostrar o nome do usuário logado -->
                                                        <!-- <input type="text" id="extraUsuid" name="extraUsuid" class="form-control" readonly="true" value="Usuário Atual ({{usuarioAtual}})" /> -->
                                                    </div>
                                                </div>

                                                <!-- Data do Extra -->
