            // --- Funções auxiliares ---
            function toggleDivSubFixo(){
                // Ajustar se 'Extra' tiver funcionalidade semelhante
                if (document.getElementById("extraFixoCheck") && document.getElementById("extraFixoCheck").checked == true) {
                    // document.getElementById("divSubFixo").style.display = "";
                    document.getElementById("extraFixo").value = "true";
                } else {
                    // document.getElementById("divSubFixo").style.display = "none";
                    document.getElementById("extraFixo").value = "false";
                }
            }

            function atualizaData(){
                // Atualiza o campo de data/hora combinada do Extra
                var dataInput = document.getElementById("extradata").value;
                var horaInput = document.getElementById("extraHora").value;
                if (dataInput && horaInput) {
                     var dataStr = dataInput + "T" + horaInput + ":00.000Z";
                     console.log("Data/Hora combinada:", dataStr);
                     var dataObj = new Date(dataStr);
                     if (!isNaN(dataObj.getTime())) {
                          document.getElementById("extraAtenddata").value = dataObj.toISOString(); // Ou outro formato esperado
                     } else {
                          console.error("Data/Hora inválida:", dataStr);
                     }
                } else {
                     console.log("Data ou Hora não preenchidas para combinar.");
                }
            }

            function formataData(dateStr) { // yyyy-MM-dd
                if (!dateStr) return '';
                var d = new Date(dateStr);
                if (isNaN(d.getTime())) {
                     console.error("Data inválida para formatação:", dateStr);
                     return '';
                }
                // Ajuste de timezone pode ser necessário dependendo de como a data é armazenada
                // if (d.getTimezoneOffset() == 180){ // Exemplo para UTC-3
                //     d.setHours(d.getHours() + 3);
                // }
                console.log("Formatando data:", d);
                let month = '' + (d.getMonth() + 1);
                let day = '' + d.getDate();
                let year = d.getFullYear();
                if (month.length < 2) month = '0' + month;
                if (day.length < 2) day = '0' + day;
                return [year, month, day].join('-');
            }

            // Funções que podem não ser aplicáveis ou precisam ser refeitas
