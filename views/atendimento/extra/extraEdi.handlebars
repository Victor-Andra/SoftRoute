                          document.getElementById("tabilConvid").value = convId; // Se ainda usar
                          console.log("Convênio selecionado:", convId);
                     } else {
                          console.log("Convênio não encontrado para o beneficiário.");
                     }
                } else {
                     document.getElementById("extraConvid").value = "766f69643132333435366964"; // void123456id
                     document.getElementById("tabilConvid").value = "766f69643132333435366964"; // Se ainda usar
                     console.log("Nenhum beneficiário selecionado.");
                }
            }

            // --- Outras funções precisam ser revistas ---
