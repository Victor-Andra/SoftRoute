                                <!-- Campo oculto para data/hora combinada -->
                                <input type="hidden" id="extraAtenddata" name="extraAtenddata" value="{{extra.extra_data}}" /> <!-- Ajustar conforme campo real -->

                                <div class="col-sm-12"><!-- Widget Dados Básicos -->
