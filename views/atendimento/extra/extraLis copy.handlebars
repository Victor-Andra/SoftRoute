<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista de Extras</title>
		<style>
			@media print and (orientation: landscape) {
				.noprint {
					display: none;
				}
			}
			@media print {
               .noprint {
                  display: none;
               }
            }
			 /* OCULTA O LINK GERADO PELO NAVEGADOR NA IMPRESSÃO */
			@media print {
				a[href]:after {
					content: none !important;
					display: none !important;
				}

				.action-buttons a {
					text-decoration: none !important;
					color: inherit !important;
					background: transparent !important;
				}
			}
			#tabela-customizada {
				border-collapse: separate; /* Permite usar border-spacing */
				border-spacing: 10px 5px; /* Espaçamento menor entre células (horizontal e vertical) */
				border: none; /* Remove borda externa */
				}

				#tabela-customizada th,
				#tabela-customizada td {
				border: none; /* Remove bordas das células */
				padding: 4px; /* Reduz o preenchimento interno para aproximar ainda mais */
				white-space: nowrap; /* Evita quebra de linha no cabeçalho */
				flex-direction: column;
    			align-items: flex-start;
				}
			#dynamic-table th,
			#dynamic-table td {
				font-size: 10px;
			}
		</style>
		<script>
			function atualizaCampos() {
				document.getElementById('anoAtend').value = document.getElementById('anoSelect').value;
				document.getElementById('mesAtend').value = document.getElementById('mesSelect').value;
			}
			// Inicializa
			atualizaCampos();
		</script>
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">
		
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Route</a>
							</li>
							<li class="active">Lista de Extras Previstos nos Agendamentos</li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<form id="divFormPesquisa" class="form-horizontal" role="form" action="/menu/atendimento/extra/lisF" method="POST">
						
							<div class="col-xs-12">
								<div class="row">
									<table id="tabela-customizada">
										<thead>
											<tr>
												<th><label>Tipo Filtro:&nbsp;</label></th>
												<th><label id="divAnoAtendlab" for="id-date-picker-1">Ano:&nbsp;</label></th>
												<th><label id="divMesAtendlab" for="id-date-picker-1">Mês:&nbsp;</label></th>
												<th><label id="divDataFillab"  >Data:&nbsp;</label></th>
												<th></th>
												<th></th>
											</tr>
										</thead>
										<tbody>
											<tr>
												<td>
													<div class="input-group">
														<select name="tipoData" id="tipoData" class="select2" data-placeholder="Escolha..." value="Ano/Mes">
															<option selected value="Ano/Mes">Ano/Mês</option>
															
														</select>
													</div>
												</td>
												<td>
													<div id="divAnoAtend">
														<select name="anoAtend" id="anoAtend" class="select2" data-placeholder="Escolha..." value="2023" >
															{{#each anos}}
																<option value="{{ano_nome}}">{{ano_nome}}</option>
															{{/each}}
														</select>
													</div>
												</td>
												<td>
													<div id="divMesAtend">
														<select name="mesAtend" id="mesAtend" class="select2" data-placeholder="Escolha..." value="Janeiro" >
															<option value="0">Janeiro</option>
															<option value="1">Fevereiro</option>
															<option value="2">Março</option>
															<option value="3">Abril</option>
															<option value="4">Maio</option>
															<option value="5">Junho</option>
															<option value="6">Julho</option>
															<option value="7">Agosto</option>
															<option value="8">Setembro</option>
															<option value="9">Outubro</option>
															<option value="10">Novembro</option>
															<option value="11">Dezembro</option>
														</select>
													</div>
												</td>
												<td>
													<button name="acaoPesquisar" id="acaoPesquisar" type="submit" class="btn btn-xs btn-info">
													<i class="ace-icon fa fa-search-plus"></i>
													Pesquisar
													</button>
												</td>
												<td>
													
												</td>
											</tr>
										</tbody>
									</table>
									
								</div>
							</div>
						</form>
						<form action="/menu/atendimento/extra/extraCopia" method="POST">
										<!-- Campos ocultos preenchidos pelo JS -->
										<input type="text" name="anoAtend" id="anoAtend" value="2025">
										<input type="text" name="mesAtend" id="mesAtend" value="7">

										

										<button 
											type="submit"
											class="btn btn-xs btn-danger"
											style="margin-left: 25px;"
											onclick="return confirm('Exportar agendamentos extras?')">
											<i class="ace-icon fa fa-cogs"></i>
											Exportar Agendamentos para Extra
										</button>
									</form>
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<table>
									<thead>
										<tr role="row">
											<b>Etapas de Controle dos Extras</b>
										</tr>
										<tr class="odd">
											
											<td style="text-align: center;"><div class="alert alert-success">1</div></td>
											<td style="text-align: center;"><div class="alert alert-info">2</div></td>
											<td style="text-align: center;"><div class="alert alert-info"><span class="badge badge-info">3</span></div></td>
											<td style="text-align: center;"><div class="alert alert-warning">4</div></td>
											<td style="text-align: center;"><div class="alert alert-warning">5</div></td>
											<td style="text-align: center;"><div class="alert alert-danger">6</div></td>
											<td style="text-align: center;"><div class="alert alert-danger">7</div></td>
											
										</tr>
									</thead>
									<tbody>
										<tr role="row" class="odd">
											<td><div class="alert alert-success">Agendamento dos Extras</div></td>
											<td><div class="alert alert-info">Verificação dos Extras</div></td>
											<td><div class="alert alert-info">Exportar Controle dos Extras</div></td>
											<td><div class="alert alert-warning">Auditar Controle dos Extras</div></td>
											<td><div class="alert alert-warning">Criar Atendimento</div></td>
											<td><div class="alert alert-danger">Fechamento</div></td>
											<td><div class="alert alert-danger">Gerenciar Pagamento dos Extras</div></td>
										</tr>
									</tbody>
								</table>
								<div class="row">
									<div class="col-sm-12">
										<div class="alert alert-info">
											<button type="button" class="close" data-dismiss="alert">
												<i class="ace-icon fa fa-times"></i>
											</button>
												<strong>Nessa etapa aqui <span class="badge badge-info">3</span></strong>, você verifica se os mesmos são passíveis de exportação para controle.<br>
												Após a exportação, você deve ir para o Controle de Extras e acompanhar, auditar e supervisionar os atendimentos dos extras.<br>
												
										</div>
									</div>
								</div>
								
								<div class="row">
									<div class="col-sm-12">		
										<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info" style="font-size: 11px;">
											<thead>
												<tr role="row">
													
													<th class="center" tabindex="1">
														<label class="pos-rel">
															<input type="checkbox" class="ace" />
															<span class="lbl"></span>
														</label>
													</th>
													
													<th style="width: 80px;" class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data</th>
													<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1" >Hora</th>
													<th style="width: 200px;" class="sorting" tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="1" >Beneficiário</th>
													<th style="width: 120px;" class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Convênio</th>
													<th class="sorting" tabindex="4" aria-controls="dynamic-table" rowspan="1" colspan="1" >Origem</th>
													<th class="sorting" tabindex="5" aria-controls="dynamic-table" rowspan="1" colspan="1" >Tipo</th>
													<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapia</th>
													<th style="width: 200px;" class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapeuta</th>
													<th class="sorting" tabindex="8" aria-controls="dynamic-table" rowspan="1" colspan="1" >Observação</th>
													<th class="sorting" tabindex="9" aria-controls="dynamic-table" rowspan="1" colspan="1" >Cobrar</th>
													
												</tr>
											</thead>
											<tbody>
												{{#each extras}}
														<tr role="row" class="odd">
															<td class="center">
																<label class="pos-rel">
																	<input type="checkbox" class="ace" />
																	<span class="lbl"></span>
																</label>
															</td>
															
															<td><b>{{extra_data_dia}}</b></td>
															
															<td>{{extra_hora}}</td>
					

															{{#each ../benes}}
																{{#ifEqual this._id ../agenda_beneid}}
																	<td>{{bene_nome}}</td>
																{{/ifEqual}}
															{{/each}}

															{{#each ../convs}}<!-- Ok -->	
																{{#ifEqual this._id ../agenda_convid}}
																	<td>{{conv_nome}}</td>
																{{/ifEqual}}
															{{/each}}
															<td>{{agenda_org}}</td>
															<td>{{agenda_categoria}}</td>
															
															{{#each ../terapias}}<!-- Ok -->
																{{#ifEqual this._id ../agenda_terapiaid}}
																	<td>{{terapia_nome}}</td>
																{{/ifEqual}}
															{{/each}}
															
															
															{{#each ../terapeutas}}<!-- Ok -->
																{{#ifEqual this._id ../agenda_usuid}}
																	<td>{{usuario_nome}}</td>
																{{/ifEqual}}
															{{/each}}
															
															<td>{{agenda_obs}}</td>
															<td>
																
															{{#ifEqual agenda_cobrarextra "true"}}
																<a class="green">
																	<i class="ace-icon fa fa-check bigger-130"></i>
																</a>
															{{/ifEqual}}
															</td>
															
															
												
														</tr>
													{{/each}}
											</tbody>
										</table>
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

		</div><!-- /.main-container ace-save-state -->

		<!-- basic scripts -->

		<script type="text/javascript">
			if('ontouchstart' in document.documentElement) document.write("<script src='../../../assets/js/jquery.mobile.custom.min.js'>"+"<"+"/script>");
		</script>
		<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		

		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
			"language": {
            "url": "/js/lang/datatable-pt-br.json" // Substitua pelo caminho correto
        },
			"aaSorting": [],
			"aoColumns": [{ "bSortable": false }, null, null, null, null, null, null, null, null, null, { "bSortable": false }],
			"responsive": true,
			"lengthMenu": [ 200,300],
			"lengthChange": true,
			"autoWidth": false,
			"paging": true,
			"lengthChange": true,
			"searching": true,
			"ordering": true,
			"info": true,
			
			select: {
						style: 'multi'
					}
			});
		});
		$.fn.dataTable.Buttons.defaults.dom.container.className = 'dt-buttons btn-overlap btn-group btn-overlap';
		</script>
	


	</body>

</html>