<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Relatório de Consolidado por Beneficiário</title>
				<style>
			
			<style>
		/* Oculta elementos na tela */
		@media screen {
			.print-header {
				display: none;
			}
		}

		/* Estilos para impressão */
		@media print {
			.noprint {
				display: none !important;
			}

			/* Cabeçalho fixo com paginação no topo */
			.print-header {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				text-align: center;
				font-size: 11px;
				padding: 5px 0;
				background: white;
				z-index: 9999;
				/* Sem borda inferior */
			}

			/* Margem superior para acomodar o cabeçalho fixo */
			body {
				margin-top: 5mm;
				margin-bottom: 1cm;
			}

			/* Paginação no topo de cada página */
			@page {
				margin: 1cm;
				size: A4 portrait;
				@top-center {
					content: "Página " counter(page) " de " counter(pages);
					font-size: 11px;
					color: #000;
				}
				@bottom-center {
					content: ""; /* Remove rodapé padrão */
				}
			}

			/* Garante apenas uma página em branco no final */
			.blank-page {
				page-break-before: always;
			}
		}
		/* Estilos específicos para impressão em modo paisagem */
			@media print and (orientation: landscape) {
				/* Apenas garantimos que o noprint continue funcionando */
				.noprint {
					display: none !important;
				}
			}
	    </style>
		<script type="text/javascript">
			function atualizaDataIni(){
				let fulldate = (document.getElementById('dataFilDe').value+' 00:00:00.000Z').toString();
				document.getElementById('dataIni').value = fulldate;
			}
			function atualizaDataFim(){
				let fulldate = (document.getElementById('dataFilAte').value+' 00:00:00.000Z').toString();
				document.getElementById('dataFim').value = fulldate;
			}
			// Função de validação
			function validarConsAtendBene(event) {
				const selectBeneficiario = document.getElementById('relBeneid');
				const alertaErro = document.getElementById('alertaErro');

				if (!selectBeneficiario || !selectBeneficiario.value) {
					event.preventDefault();
					alertaErro.style.display = 'block';
					return false;
				} else {
					alertaErro.style.display = 'none';
					return true;
				}
			}

			// Esconde o alerta quando o usuário seleciona um beneficiário
			function esconderAlertaAoSelecionarBeneficiario() {
				const alertaErro = document.getElementById('alertaErro');
				if (this.value) {
					alertaErro.style.display = 'none';
				}
			}

			// Inicializa os listeners quando o DOM estiver pronto
			document.addEventListener('DOMContentLoaded', function () {
				const form = document.getElementById('ConsAtendBene');
				const selectBeneficiario = document.getElementById('relBeneid');

				if (form) {
					form.addEventListener('submit', validarConsAtendBene);
				}
				if (selectBeneficiario) {
					selectBeneficiario.addEventListener('change', esconderAlertaAoSelecionarBeneficiario);
				}
			});
			function carregaBody(){
				//Filtro persistente
				document.getElementById('dataFilDe').value = document.getElementById('dataIni').value.replace(" 00:00:00.000Z", "") || new Date().toISOString().split('T')[0];
				document.getElementById('dataFilAte').value = document.getElementById('dataFim').value.replace(" 00:00:00.000Z", "") || new Date().toISOString().split('T')[0];
				atualizaDataIni()
				atualizaDataFim()
			}
		</script>
	</head>
	<body onload="javascript:controlaNave();carregaBody();" class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner noprint">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs_home" style="noprint">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Consolidado por Beneficiário</li>
						</ul><!-- /.breadcrumb -->
					</div>
					<form role="form" class="noprint" name="ConsAtendBene" id="ConsAtendBene" action="/menu/atendimento/relatendvalconss" method="POST">
						
						<!-- Alerta-->
						<div id="alertaErro" style="display: none;" class="alert alert-danger">
							<button type="button" class="close" data-dismiss="alert">
								<i class="ace-icon fa fa-times"></i>
							</button>
							<strong>Importante!</strong> Por favor escolha um beneficiário.
						</div>
						<!-- /.Alerta-->

						<div class="breadcrumbs" id="breadcrumbs" style="align-items: center; text-align: center;" >
							<ul class="breadcrumb" >
								<label>Período de:</label>
								<input style="height: 30px;" id="dataFilDe" name="dataFilDe" type="date" onchange="javascript:atualizaDataIni()">
								<input class="hidden" id="dataIni" name="dataIni" />
								<label>até:</label>
								<input style="height: 30px;" id="dataFilAte" name="dataFilAte" type="date" onchange="javascript:atualizaDataFim()">
								<input class="hidden" id="dataFim" name="dataFim" />
								<label>Beneficiário: </label>
								<select style="height: 30px; width:300px;" name="relBeneid"  id="relBeneid" class="chosen-select" data-placeholder="Escolha...">
									{{#each benes}}
										<option value="{{_id}}">{{bene_nome}}</option>
									{{/each}}
								</select>
								&nbsp;&nbsp;&nbsp;&nbsp;
								<label class="control-label bolder red">
									<select name="exibeInativos" id="exibeInativos" class="chosen-select" value=""  >
											<option value="nao">Não</option>
											<option value="sim">Sim</option>
									</select>
									<span class="lbl">&nbsp;Exibir Inativos?</span>
								</label>
								<button class="btn btn-info" name="acaoSalvar" id="acaoSalvar" type="submit">
									<i class="ace-icon fa fa-search bigger-110"></i>
									Pesquisar
								</button>
							</ul><!-- /.breadcrumb -->
						</div>
					</form>
				</div>
				<div class="row">
					<div class="col-xs-12">
						<!-- PAGE CONTENT BEGINS  -->
						<div class="space-6"></div>
						<div class="row">
							<div class="col-sm-10 col-sm-offset-1">
								<div class="widget-box transparent">
									<div style="text-align: center;">
										<img width="140" height="60" alt="150x150" style="alight: center" src="/images/gallery/logo_route_centro.png">
									</div>
										<div class="widget-header widget-header-large">
											<h3 class="widget-title grey lighter">
												<i class="ace-icon fa fa-leaf green"></i>
												Atendimentos e Valores
											</h3>
										</div>
									<div class="widget-body">
										<div class="widget-main padding-24">
											<div class="row">
												<div class="col-sm-12">
													<div class="row">
														<div class="col-xs-12 label label-lg label-info arrowed-in arrowed-right">
															<b>Informações do Prestador</b>
														</div>
													</div>
													<div>
														<ul class="list-unstyled">
															<li>
																<i class="ace-icon fa fa-caret-right blue"></i><b>Prestador: </b>Route Centro de Terapia e Apoio Infantil
															</li>
															<li>
																<i class="ace-icon fa fa-caret-right blue"></i><b>CNPJ: </b> 33.346.423/0001-17
															</li>
														</ul>
													</div>
													<div class="row">
														<div class="col-xs-12 label label-lg label-success arrowed-in arrowed-right">
															<b>Informações do Relatório</b>
														</div>
													</div>
													<div>
														<ul class="list-unstyled ">
															<li>
																<i class="ace-icon fa fa-caret-right green"></i><b>Período de: </b>{{periodoDe}}<b> até: </b>{{periodoAte}}
															</li>
															<li>
																<i class="ace-icon fa fa-caret-right green"></i><b>Beneficiário:</b> {{bene_nome}}
															</li>
															<li>
																<i class="ace-icon fa fa-caret-right green"></i><b>Convênio:</b> {{conv_nome}}
															</li>
														</ul>
													</div>
													<div class="row">
														<div class="col-xs-12 label label-lg label-warning arrowed-in arrowed-right">
															<b>Informações dos Atendimentos</b>
														</div>
													</div>
											</div><!-- /.row -->
											<div>
												<table class="table table-striped table-bordered">
													<thead>
														<tr>
															<th class="center">#</th>
															<th>Terapia</th>
															<th>Sessões</th>
															<th>Valor da Sessão</th>
															<th>Valor Total</th>															
														</tr>
													</thead>
													{{#each rels}}
														<tbody>
															<tr>
																<td class="center">#</td>
																{{#each ../terapias}}
																	{{#ifEqual this._id ../nomecid}}
																		<td>{{terapia_nomecid}}</td>
																	{{/ifEqual}}
																{{/each}}
																<td>{{sessoes}}</td>
																<td>{{valor}}</td>		
																<td>{{total}}</td>				
															</tr>
														</tbody>
													{{/each}}
													<footer>
														<tr class="hr-double">
															<td class="right">-</td>
															<td><b>Total</b></td>
															<td><b>{{total.sessoes}}</b></td>
															<td><b>-</b></td>		
															<td><b>{{total.total}}</b></td>					
														</tr>
													</footer>
												</table>
											</div>
											
										</div>
									</div>
								</div>
							</div>
						</div><!-- PAGE CONTENT ENDS -->
					</div><!-- /.col -->
				</div><!-- /.row -->
			</div><!-- /.main-content -->
		</div><!-- /.main-container --><!-- basic scripts -->
	   <div class="row"><!-- Área reservada para Assinaturas -->
			<div class="col-xs-12">
				<div style="margin-top: 32px;"></div>
				<div class="row">
					<div class="col-xs-4 col-sm-4 text-center">
					</div>
					<div class="col-xs-4 col-sm-4"></div>
					<div class="col-xs-4 col-sm-4 text-center">
						<div class="hr"></div>
						<label>Assinatura da Clínica</label>
					</div>
				</div>
			</div>
		</div><!-- /.Área reservada para Assinaturas -->
	<!-- Cabeçalho de impressão (paginação no topo) -->
		<div class="print-header"></div>

		<!-- Página em branco única no final -->
		<div style="page-break-before: always;"></div>
	</body>
</html>
