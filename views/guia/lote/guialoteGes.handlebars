                </div>
                <div class="modal-body">
                    <form id="formEditarLote">
                        <input type="hidden" id="loteId" name="loteId">
                        
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>Número do Lote</label>
                                    <input type="text" id="guialote_num" name="guialote_num" class="form-control" placeholder="Ex: 12345678">
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>Data do Lote</label>
                                    <input type="date" id="guialote_numdatacad" name="guialote_numdatacad" class="form-control">
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>Número do Protocolo / Remessa</label>
                                    <input type="text" id="guialote_numprotocolo" name="guialote_numprotocolo" class="form-control" placeholder="Ex: 87654321">
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>Data do Envio</label>
                                    <input type="date" id="guialote_dataenvio" name="guialote_dataenvio" class="form-control">
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>Valor Total do Lote (R$)</label>
                                    <input type="text" id="guialote_guialotevalor" name="guialote_guialotevalor" class="form-control" placeholder="0,00">
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label>Status</label>
                                    <select id="guialote_status" name="guialote_status" class="form-control">
                                        <option value="Aberto">Aberto</option>
                                        <option value="Enviado">Enviado</option>
                                        <option value="Fechado">Fechado</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label>Log / Observações</label>
                            <textarea id="guialote_log" name="guialote_log" class="form-control" rows="4" placeholder="Adicione observações sobre este lote..."></textarea>
                            <p class="help-block">
                                <strong>ℹ️ Dica:</strong> Use este campo para registrar eventos importantes do lote
                            </p>
                        </div>
                        
                        <div class="alert alert-info">
                            <strong>⚠️ Atenção:</strong> Ao salvar, o sistema registrará automaticamente:
                            <ul>
                                <li><strong>Usuário:</strong> {{usuarioLogado.usuario_nome}} (ID: {{usuarioLogado._id}})</li>
                                <li><strong>Data/Hora:</strong> Registro automático no momento da edição</li>
                            </ul>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">
                        <i class="ace-icon fa fa-times"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-success" id="btnSalvarLote">
                        <i class="ace-icon fa fa-save"></i> Salvar Alterações
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script>
        // ============================================
        // ✅ TOGGLE DE EXPANSÃO DAS LINHAS DE DETALHE
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.btn-expand').forEach(btn => {
                btn.addEventListener('click', function() {
                    const mainRow = this.closest('tr');
                    const detailRow = mainRow.nextElementSibling;
                    if (!detailRow || !detailRow.classList.contains('detalhe-linha')) return;
                    
                    const isExpanded = detailRow.style.display === 'table-row';
                    detailRow.style.display = isExpanded ? 'none' : 'table-row';
                    
                    this.classList.toggle('fa-plus-circle', isExpanded);
                    this.classList.toggle('fa-minus-circle', !isExpanded);
                });
            });

            // ============================================
            // ✅ MODAL DE EDIÇÃO DE LOTE - INICIALIZAÇÃO
            // ============================================
            
            // ✅ Abrir modal ao clicar 2x no badge do lote
            $(document).on('dblclick', '.badge-lote-editavel', function(e) {
                e.stopPropagation();
                e.preventDefault();
                const loteId = $(this).data('lote-id');
                if (loteId && loteId !== 'null' && loteId !== 'undefined') {
                    carregarLoteParaEdicao(loteId);
                } else {
                    alert('⚠️ Este lote não possui um ID válido para edição.');
                }
            });

            // ✅ Salvar alterações do lote
            $('#btnSalvarLote').on('click', function() {
                const btn = $(this);
                btn.prop('disabled', true).html('<i class="ace-icon fa fa-spinner fa-spin"></i> Salvando...');
                
                const dados = {
                    loteId: $('#loteId').val(),
                    guialote_num: $('#guialote_num').val().trim() || null,
                    guialote_numdatacad: $('#guialote_numdatacad').val() || null,
                    guialote_numprotocolo: $('#guialote_numprotocolo').val().trim() || null,
                    guialote_dataenvio: $('#guialote_dataenvio').val() || null,
                    guialote_guialotevalor: removerFormatacaoMoeda($('#guialote_guialotevalor').val()),
                    guialote_status: $('#guialote_status').val(),
                    guialote_log: $('#guialote_log').val().trim() || null
                };
                
                // Validação básica
                if (!dados.loteId) {
                    alert('❌ ID do lote não encontrado.');
                    btn.prop('disabled', false).html('<i class="ace-icon fa fa-save"></i> Salvar Alterações');
                    return;
                }
                
                $.ajax({
                    url: '/menu/guia/lote/editar',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dados),
                    success: function(response) {
                        if (response.ok) {
                            // ✅ Fechar modal
                            $('#modalEditarLote').modal('hide');
                            
                            // ✅ Feedback visual
                            alert('✅ Lote atualizado com sucesso!\n\nUsuário: ' + response.usuario + '\nData: ' + response.dataEdicao);
                            
                            // ✅ Recarregar página para atualizar dados
                            setTimeout(() => location.reload(), 500);
                        } else {
                            alert('❌ Erro ao salvar: ' + (response.message || 'Desconhecido'));
                            btn.prop('disabled', false).html('<i class="ace-icon fa fa-save"></i> Salvar Alterações');
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('[ERRO] editarLote:', error);
                        alert('❌ Erro de comunicação ao salvar lote. Tente novamente.');
                        btn.prop('disabled', false).html('<i class="ace-icon fa fa-save"></i> Salvar Alterações');
                    }
                });
            });

            // ✅ Fechar modal ao clicar fora ou pressionar ESC
            $('#modalEditarLote').on('hidden.bs.modal', function() {
                // Limpar formulário ao fechar
                $('#formEditarLote')[0].reset();
                $('#loteId').val('');
                $('#modalLoteNum').text('');
            });
        });

        // ============================================
        // ✅ FUNÇÕES AUXILIARES (fora do DOMContentLoaded)
        // ============================================

        // ✅ Carregar dados do lote via AJAX
        function carregarLoteParaEdicao(loteId) {
            console.log('[DEBUG] Carregando lote para edição:', loteId);
            
            $.ajax({
                url: '/menu/guia/lote/buscar/' + loteId,
                method: 'GET',
                dataType: 'json',
                success: function(response) {
                    if (response.ok && response.lote) {
                        const lote = response.lote;
                        
                        // Preencher formulário
                        $('#loteId').val(lote._id);
                        $('#guialote_num').val(lote.guialote_num || '');
                        $('#guialote_numdatacad').val(lote.guialote_numdatacad ? formatarDataISO(lote.guialote_numdatacad) : '');
                        $('#guialote_numprotocolo').val(lote.guialote_numprotocolo || '');
                        $('#guialote_dataenvio').val(lote.guialote_dataenvio ? formatarDataISO(lote.guialote_dataenvio) : '');
                        $('#guialote_guialotevalor').val(lote.guialote_guialotevalor ? formatarMoeda(lote.guialote_guialotevalor) : '');
                        $('#guialote_status').val(lote.guialote_status || 'Aberto');
                        $('#guialote_log').val(lote.guialote_log || '');
                        $('#modalLoteNum').text(lote.guialote_num ? `#${lote.guialote_num}` : '(sem número)');
                        
                        // Mostrar modal
                        $('#modalEditarLote').modal('show');
                    } else {
                        alert(`❌ Erro ao carregar dados do lote: ${response.message || 'Desconhecido'}`);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('[ERRO] buscarLote:', error);
                    alert('❌ Erro de comunicação ao carregar lote. Tente novamente.');
                }
            });
        }

        // ✅ Formatar data ISO para input date
        function formatarDataISO(data) {
            if (!data) return '';
            const d = new Date(data);
            return d.toISOString().split('T')[0];
        }

        // ✅ Formatar moeda para exibição
        function formatarMoeda(valor) {
            if (!valor && valor !== 0) return '';
            return parseFloat(valor).toLocaleString('pt-BR', { 
                minimumFractionDigits: 2, 
                maximumFractionDigits: 2 
            });
        }

        // ✅ Remover formatação para envio
        function removerFormatacaoMoeda(valor) {
            if (!valor) return 0;
            return parseFloat(valor.toString().replace(/\./g, '').replace(',', '.')) || 0;
        }
    </script>
</body>
</html>