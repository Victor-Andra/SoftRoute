// MODAL DE EDIÇÃO DE LOTE
// ============================================

// ✅ Abrir modal ao clicar 2x no badge do lote
$(document).on('dblclick', '.badge-lote-editavel', function(e) {
    e.stopPropagation();
    e.preventDefault();
    const loteId = $(this).data('lote-id');
    if (loteId && loteId !== 'null' && loteId !== 'undefined') {
        carregarLoteParaEdicao(loteId);
    } else {
        alert('⚠️ Este agendamento não possui um lote vinculado válido para edição.');
    }
});

// ✅ Carregar dados do lote via AJAX
function carregarLoteParaEdicao(loteId) {
    console.log('[DEBUG] Carregando lote para edição:', loteId);
    
    $.ajax({
        url: '/menu/guia/lote/buscar/' + loteId,
        method: 'GET',
        dataType: 'json',
        success: function(response) {
            if (response.ok && response.lote) {
                const lote = response.lote;
                
                // Preencher formulário
                $('#loteId').val(lote._id);
                $('#guialote_num').val(lote.guialote_num || '');
                $('#guialote_numdatacad').val(lote.guialote_numdatacad ? formatarDataISO(lote.guialote_numdatacad) : '');
                $('#guialote_numprotocolo').val(lote.guialote_numprotocolo || '');
                $('#guialote_dataenvio').val(lote.guialote_dataenvio ? formatarDataISO(lote.guialote_dataenvio) : '');
                $('#guialote_guialotevalor').val(lote.guialote_guialotevalor ? formatarMoeda(lote.guialote_guialotevalor) : '');
                $('#guialote_status').val(lote.guialote_status || 'Aberto');
                $('#guialote_log').val(lote.guialote_log || '');
                $('#modalLoteNum').text(lote.guialote_num ? `#${lote.guialote_num}` : '(sem número)');
                
                // Mostrar modal
                $('#modalEditarLote').modal('show');
            } else {
                alert(`❌ Erro ao carregar dados do lote: ${response.message || 'Desconhecido'}`);
            }
        },
        error: function(xhr, status, error) {
            console.error('[ERRO] buscarLote:', error);
            alert('❌ Erro de comunicação ao carregar lote. Tente novamente.');
        }
    });
}

// ✅ Formatar data ISO para input date
function formatarDataISO(data) {
    if (!data) return '';
    const d = new Date(data);
    return d.toISOString().split('T')[0];
}

// ✅ Formatar moeda para exibição
function formatarMoeda(valor) {
    if (!valor && valor !== 0) return '';
    return parseFloat(valor).toLocaleString('pt-BR', { 
        minimumFractionDigits: 2, 
        maximumFractionDigits: 2 
    });
}

// ✅ Remover formatação para envio
function removerFormatacaoMoeda(valor) {
    if (!valor) return 0;
    return parseFloat(valor.replace(/\./g, '').replace(',', '.')) || 0;
}

// ✅ Salvar alterações do lote
$('#btnSalvarLote').on('click', function() {
    const btn = $(this);
    btn.prop('disabled', true).html('<i class="ace-icon fa fa-spinner fa-spin"></i> Salvando...');
    
    const dados = {
        loteId: $('#loteId').val(),
        guialote_num: $('#guialote_num').val().trim() || null,
        guialote_numdatacad: $('#guialote_numdatacad').val() || null,
        guialote_numprotocolo: $('#guialote_numprotocolo').val().trim() || null,
        guialote_dataenvio: $('#guialote_dataenvio').val() || null,
        guialote_guialotevalor: removerFormatacaoMoeda($('#guialote_guialotevalor').val()),
        guialote_status: $('#guialote_status').val(),
        guialote_log: $('#guialote_log').val().trim() || null
    };
    
    // Validação básica
    if (!dados.loteId) {
        alert('❌ ID do lote não encontrado.');
        btn.prop('disabled', false).html('<i class="ace-icon fa fa-save"></i> Salvar Alterações');
        return;
    }
    
    $.ajax({
        url: '/menu/guia/lote/editar',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(dados),
        success: function(response) {
            if (response.ok) {
                // ✅ Fechar modal
                $('#modalEditarLote').modal('hide');
                
                // ✅ Feedback visual
                alert('✅ Lote atualizado com sucesso!\n\nUsuário: ' + response.usuario + '\nData: ' + response.dataEdicao);
                
                // ✅ Recarregar página para atualizar dados
                setTimeout(() => location.reload(), 500);
            } else {
                alert('❌ Erro ao salvar: ' + (response.message || 'Desconhecido'));
                btn.prop('disabled', false).html('<i class="ace-icon fa fa-save"></i> Salvar Alterações');
            }
        },
        error: function(xhr, status, error) {
            console.error('[ERRO] editarLote:', error);
            alert('❌ Erro de comunicação ao salvar lote. Tente novamente.');
            btn.prop('disabled', false).html('<i class="ace-icon fa fa-save"></i> Salvar Alterações');
        }
    });
});

// ✅ Fechar modal ao clicar fora ou pressionar ESC
$('#modalEditarLote').on('hidden.bs.modal', function() {
    // Limpar formulário ao fechar
    $('#formEditarLote')[0].reset();
    $('#loteId').val('');
    $('#modalLoteNum').text('');
});
	</script>
	
</body>
</html>