<script>
	const $id = (id) => document.getElementById(id);  // ← ADICIONAR ISSO!
	/* =========================
    FILTROS UI - NOMES PADRONIZADOS
    ========================= */
	function trocaFiltroData() {
		const tipo = $('#tipoData').val();
		const isAnoMes = (tipo === 'Ano/Mes');
		
		// ✅ LÓGICA CORRIGIDA:
		// Se for Ano/Mês → mostra Ano e Mês, OCULTA Data
		// Se for Semana/Dia → oculta Ano e Mês, MOSTRA Data
		$('#divAnoAtend').toggle(isAnoMes);
		$('#divMesAtend').toggle(isAnoMes);
		$('#divDataFil').toggleClass('hidden-div', isAnoMes); // ← CORREÇÃO: era !isAnoMes
		
		// ✅ Força Select2 recalcular após mudar visibilidade
		setTimeout(() => {
			if (isAnoMes) {
				// Atualiza Ano e Mês
				['#anoAtend', '#mesAtend'].forEach(sel => {
					const $el = $(sel);
					if ($el.data('select2')) {
						$el.select2('destroy').select2({ 
							width: 'resolve', 
							placeholder: "Selecione...",
							allowClear: false  // ← Remove o X
						});
					}
				});
			} else {
				// Atualiza Data
				const $el = $('#dataFil');
				if ($el.data('select2')) {
					$el.select2('destroy').select2({ 
						width: 'resolve', 
						placeholder: "Selecione...",
						
					});
				}
			}
		}, 50);
		
		console.log('[DEBUG] Tipo Data:', tipo, '| isAnoMes:', isAnoMes);
	}

function trocaFilpessoa() {
    const tipo = $('#atendTipoPessoa').val();
    
    // Mostra/Oculta campos
    $('#divAtendBeneficiario').toggleClass('hidden-div', tipo !== 'Beneficiario');
    $('#divAtendTerapeuta').toggleClass('hidden-div', tipo !== 'Terapeuta');
    
    // ✅ FORÇA SELECT2 RECALCULAR APÓS MUDAR VISIBILIDADE
    setTimeout(() => {
        $('#atendBeneficiario, #atendTerapeuta').each(function() {
            if ($(this).data('select2')) {
                $(this).select2('destroy').select2({ width: 'resolve', allowClear: true, placeholder: "Selecione..." });
            }
        });
    }, 50);
    
    console.log('[DEBUG] Tipo Pessoa:', tipo);
}

/* =========================
   INIT (SUBSTITUI carregaBody)
========================= */
function carregaBody() {
    console.log('🟢 Iniciando carregaBody...');
    
    // Valores padrão
    if (!$id("tipoData").value) $id("tipoData").value = "Ano/Mes";
    if (!$id("atendTipoPessoa").value) $id("atendTipoPessoa").value = "Geral";
    
    // Aplica visibilidade inicial
    trocaFiltroData();
    trocaFilpessoa();
    
    // Carrega filtros salvos
    if ($id("carregaFiltro")?.value === "true") {
        carregarFiltros();
    }
    
    // Carrega edição
    carregarEdicao();
    
   
}

/* =========================
   CARREGAR FILTROS
========================= */
function carregarFiltros() {
    const tipoData = $id("tipoDataFil")?.value || "Ano/Mes";
    const tipoPessoa = $id("tipoPessoaFil")?.value || "Geral";

    $id("tipoData").value = tipoData;
    trocaFiltroData();

    if (tipoData === "Ano/Mes") {
        $id("anoAtend").value = $id("anoAtendFil")?.value || "";
        $id("mesAtend").value = $id("mesAtendFil")?.value || "0";
    } else {
        const data = $id("dataFinalFil")?.value;
        if (data) $id("dataFil").value = data.split('T')[0];
    }

    $id("atendTipoPessoa").value = tipoPessoa;
    trocaFilpessoa();

    if (tipoPessoa === "Beneficiario") {
        $id("atendBeneficiario").value = $id("atendBeneficiarioFil")?.value || "";
    }
    if (tipoPessoa === "Terapeuta") {
        $id("atendTerapeuta").value = $id("atendTerapeutaFil")?.value || "";
    }
}

/* =========================
   CARREGAR EDIÇÃO
========================= */
function carregarEdicao() {
    const tipoData = $id("tipoDataEdi")?.value;
    const tipoPessoa = $id("tipoPessoaEdi")?.value;

    if (tipoData) {
        $('#tipoData').val(tipoData).trigger('change');
        trocaFiltroData();

        if (tipoData === "Ano/Mes") {
            $id("anoAtend").value = $id("anoAtendEdi")?.value || "";
            $id("mesAtend").value = $id("mesAtendEdi")?.value || "0";
        } else {
            const data = $id("dataFinalEdi")?.value;
            if (data) $id("dataFil").value = formatDateToInput(data);
        }
    }

    if (tipoPessoa) {
        $id("atendTipoPessoa").value = tipoPessoa;
        trocaFilpessoa();

        if (tipoPessoa === "Beneficiario") {
            $id("atendBeneficiario").value = $id("atendBeneficiarioEdi")?.value || "";
        }
        if (tipoPessoa === "Terapeuta") {
            $id("atendTerapeuta").value = $id("atendTerapeutaEdi")?.value || "";
        }
    }
}
</script>>
