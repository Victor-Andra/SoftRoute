	<script type="text/javascript">
$(document).ready(function() {
   
    // ✅ Eventos CORRETOS para Select2 (usa .on('change.select2'))
    $('#tipoData').on('change.select2', function() {
        console.log('🔄 tipoData mudou para:', $(this).val());
        trocaFiltroData();
    });

    $('#atendTipoPessoa').on('change.select2', function() {
        console.log('🔄 atendTipoPessoa mudou para:', $(this).val());
        trocaFilpessoa();
    });

   
    // ✅ DataTable
    $("#dynamic-table").DataTable({
        language: { url: "/js/lang/datatable-pt-br.json" },
        aaSorting: [],
        aoColumns: [
            { bSortable: false }, null, null, null, null, null,
            null, null, null, null, null, null, null, { bSortable: false }
        ],
        responsive: true,
        lengthMenu: [200, 300, 500],
        paging: true,
        searching: true,
        ordering: true,
        info: true,
        select: { style: 'multi' }
    });

    // ✅ Inicializar contador
    atualizarContadorSelecionados();
    
    console.log('✅ $(document).ready finalizado');
});
// No seu $(document).ready():
$(document).on('click', '.btnSalvarGuia', function(e) {
    e.preventDefault();
    const row = $(this).closest('tr');
    const agendaId = row.find('input[name="agendaId"]').val();
    
    // Coleta os dados da linha
    const dados = {
        guia_num: row.find(`input[name="guia_num${agendaId}"]`).val(),
        dataguia: row.find(`input[name="dataguia_${agendaId}"]`).val(),
        senha: row.find(`input[name="senha_${agendaId}"]`).val(),
        datasenha: row.find(`input[name="datasenha_${agendaId}"]`).val()
    };
    
    // Envia via AJAX
    $.post('/menu/guia/salvar', { id: agendaId, ...dados }, function(res) {
        if(res.sucesso) {
            // Feedback visual
            $(this).addClass('btn-success-pulse');
            setTimeout(() => $(this).removeClass('btn-success-pulse'), 500);
        } else {
            alert('Erro ao salvar: ' + res.erro);
        }
    });
});
</script>
	
