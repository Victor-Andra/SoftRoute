<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
	<meta charset="utf-8">
	<title>Lista de Guias e Senhas</title>
	<style>
        /*Tooltip personalizado */
            .custom-tooltip {
                position: relative;
                display: inline-block;
                cursor: pointer;
            }

            .tooltip-text {
                visibility: hidden;
                width: max-content;
                background-color: #f3dfdf;
                color: red;
                font-size: 8px;
                text-align: left;
                border-radius: 4px;
                padding: 8px 12px;
                position: absolute;
                z-index: 9999;
                bottom: 125%; /* Acima do ícone */
                left: 50%;
                transform: translateX(-50%);
                opacity: 0.9;
                white-space: normal;
                min-width: 150px;
                max-width: 300px;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
                transition: opacity 0.3s;
            }

            .tooltip-text::after {
                content: "";
                position: absolute;
                top: 100%;
                left: 50%;
                margin-left: -5px;
                border-width: 5px;
                border-style: solid;
                border-color: #f3dfdf transparent transparent transparent;
            }

            /* Mostra o tooltip quando o mouse passa sobre o link */
            .custom-tooltip:hover .tooltip-text {
                visibility: visible;
            }
    </style>
	<script type="text/javascript">
		function ajustaData(){
			let fullDatas = document.getElementsByName("fullData");
			fullDatas.forEach((elementox)=>{
				let id = "atenddata"+elementox.id;
				let dat = new Date(elementox.value);
				let mes = (dat.getMonth()+1).toString();
				let dia = (dat.getUTCDate()).toString();

				if (mes.length == 1){
					mes = "0"+mes;
				}
				if (dia.length == 1){
					dia = "0"+dia;
				}

				let fulldate=(dia+"/"+mes+"/"+dat.getFullYear()).toString();
			})
		}

		function formataData(){
			let tipo = document.getElementById("tipoData").value;
			if(tipo == "Ano/Mes"){
				let ano = document.getElementById('anoAtend').value;
				let mes = document.getElementById('mesAtend').value;
				if (!ano || !mes) return;
				let dat = new Date(Date.UTC(parseInt(ano), parseInt(mes), 1));
				let mesStr = (dat.getUTCMonth() + 1).toString().padStart(2, '0');
				let diaStr = dat.getUTCDate().toString().padStart(2, '0');
				let fulldate = `${dat.getUTCFullYear()}-${mesStr}-${diaStr}T00:00:00.000Z`;
				document.getElementById('dataFinal').value = fulldate;
			} else if (tipo == "Semana" || tipo == "Dia"){
				let dataInput = document.getElementById('dataFil').value;
				if (!dataInput) return;
				let dat = new Date(dataInput);
				let mesStr = (dat.getUTCMonth() + 1).toString().padStart(2, '0');
				let diaStr = dat.getUTCDate().toString().padStart(2, '0');
				let fulldate = `${dat.getUTCFullYear()}-${mesStr}-${diaStr}T00:00:00.000Z`;
				document.getElementById('dataFinal').value = fulldate;
			}
		}

		function trocaFiltroData(){
			let fill = document.getElementById("tipoData").value;
			if(fill == "Ano/Mes"){
				document.getElementById("divAnoAtend").hidden = false;
				document.getElementById("divMesAtend").hidden = false;
				document.getElementById("divDataFil").hidden = true;
			} else {
				document.getElementById("divAnoAtend").hidden = true;
				document.getElementById("divMesAtend").hidden = true;
				document.getElementById("divDataFil").hidden = false;
			}
		}

		function trocaFilpessoa() {
			let fillTipopessoa = document.getElementById("atendTipoPessoa").value;
			if(fillTipopessoa == "Geral"){
				document.getElementById("divAtendBeneficiario").hidden = true;
			} else if(fillTipopessoa == "Beneficiario"){
				document.getElementById("divAtendBeneficiario").hidden = false;
			}
		}

		function carregaBody(){
				//formataData();
				if (document.getElementById("carregaFiltro").value == "true"){
					document.getElementById("tipoData").value = document.getElementById("tipoDataFil").value;
					if(document.getElementById("tipoData").value == "Ano/Mes"){
						document.getElementById("anoAtend").value = document.getElementById("anoAtendFil").value;
						document.getElementById("mesAtend").value = document.getElementById("mesAtendFil").value;
					} else if (document.getElementById("tipoData").value == "Semana"){
						document.getElementById("dataFil").value = document.getElementById("dataFinalFil").value;
					} else if (document.getElementById("tipoData").value == "Dia"){
						document.getElementById("dataFil").value = document.getElementById("dataFinalFil").value;
					}

					document.getElementById("atendTipoPessoa").value = document.getElementById("tipoPessoaFil").value;
					if (document.getElementById("atendTipoPessoa").value == "Geral"){

					} else if (document.getElementById("atendTipoPessoa").value == "Beneficiario"){
						document.getElementById("atendBeneficiario").value = document.getElementById("atendBeneficiarioFil").value
					} else if (document.getElementById("atendTipoPessoa").value == "Terapeuta"){
						document.getElementById("atendTerapeuta").value = document.getElementById("atendTerapeutaFil").value;
					}

				}
				let tipoDataEdi = document.getElementById("tipoDataEdi").value;
				let tipoPessoaEdi =document.getElementById("tipoPessoaEdi").value;
				if (tipoDataEdi == "Ano/Mes"){
					document.getElementById("tipoData").value = tipoDataEdi;
					document.getElementById("anoAtend").value = document.getElementById("anoAtendEdi").value;
					document.getElementById("mesAtend").value = document.getElementById("mesAtendEdi").value;
				} else if (tipoDataEdi == "Semana"){
					document.getElementById("tipoData").value = tipoDataEdi;
					let dat = new Date(document.getElementById('dataFinalEdi').value);
					let mes = (dat.getUTCMonth()).toString();
					let dia = (dat.getUTCDate()).toString();
					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}
					let fulldate = (dat.getFullYear()+"-"+mes+"-"+dia).toString();
					document.getElementById("dataFil").value = fulldate;
					document.getElementById("dataFinal").value = (fulldate+' 00:00:00.000Z');
				} else if (tipoDataEdi == "Dia"){
					document.getElementById("tipoData").value = tipoDataEdi;
					let dat = new Date(document.getElementById('dataFinalEdi').value);
					let mes = (dat.getUTCMonth()).toString();
					let dia = (dat.getUTCDate()).toString();
					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}
					let fulldate = (dat.getFullYear()+"-"+mes+"-"+dia).toString();
					document.getElementById("dataFil").value = fulldate;
					document.getElementById("dataFinal").value = (fulldate+' 00:00:00.000Z');
				}
				if (tipoPessoaEdi == "Geral"){
					document.getElementById("atendTipoPessoa").value = tipoPessoaEdi;
				} else if (tipoPessoaEdi == "Beneficiario"){
					document.getElementById("atendTipoPessoa").value = tipoPessoaEdi;
					document.getElementById("atendBeneficiario").value = document.getElementById("atendBeneficiarioEdi").value;
				} else if (tipoPessoaEdi == "Terapeuta"){
					document.getElementById("atendTipoPessoa").value = tipoPessoaEdi;
					document.getElementById("atendTerapeuta").value = document.getElementById("atendTerapeutaEdi").value;
				}
				trocaFiltroData();
				trocaFilpessoa();
			}
		
		document.addEventListener('click', async (e) => {
			if (!e.target.classList.contains('btnSalvarGuia')) return;

			e.preventDefault();

			const tr = e.target.closest('tr');
			//const agendaId = tr.dataset.agendaId;
			const agendaId = tr.querySelector(`[name="agendaId"]`)?.value;
			const guia_num = tr.querySelector(`[name="guia_num${agendaId}"]`)?.value;
			const guia_numdatacad = tr.querySelector(`[name="dataguia_${agendaId}"]`)?.value;
			const guia_senha = tr.querySelector(`[name="senha_${agendaId}"]`)?.value;
			const guia_senhadatacad = tr.querySelector(`[name="datasenha_${agendaId}"]`)?.value;
			const payload = {
				agendaId,
				guia_num,
				guia_numdatacad,
				guia_senha,
				guia_senhadatacad
			};
			console.log("payload: "+payload);
			console.log("JSON.stringify(payload): "+JSON.stringify(payload));
			try {
				const resp = await fetch('/menu/guia/addguia', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload)
				});
				const result = await resp.json();

				if (result.ok) {
					e.target.innerText = '✔';
					setTimeout(() => e.target.innerText = '💾', 1000);
				} else {
					alert(result.message || 'Erro ao salvar');
				}
			} catch (err) {
				console.error(err);
				alert('Erro de comunicação');
			}
		});
	</script>
</head>
<body onload="javascript:controlaNave();carregaBody();" class="no-skin">
	<div class="main-container ace-save-state" id="main-container">
		<div class="main-content">
			<div class="main-content-inner">
				<div class="breadcrumbs" id="breadcrumbs">
					<ul class="breadcrumb">
						<li>
							<i class="ace-icon fa fa-home home-icon"></i>
							<a href="#">Route</a>
						</li>
						<li class="active">Lista de Guias e Senhas</li>
					</ul>
				</div>

				{{#each error}}
					<div class="alert alert-danger">{{texto}}{{error}}</div>
				{{/each}}

				<div class="page-content">
					<form id="divFormPesquisa" class="form-horizontal" role="form" action="/menu/guia/guiaLilfil" method="POST">
						<div class="col-xs-12" class="row">
								<div class="hidden">
									<input id="carregaFiltro" value="{{carregaFiltro.carregaFiltro}}" />
									<input id="atendTerapeutaFil" value="{{atendTerapeuta.atendTerapeuta}}" />
									<input id="atendBeneficiarioFil" value="{{atendBeneficiario.atendBeneficiario}}" />
									<input id="dataFinalFil" value="{{dataFinal.dataFinal}}" />
									<input id="mesAtendFil" value="{{mesAtend.mesAtend}}" />
									<input id="anoAtendFil" value="{{anoAtend.anoAtend}}" />
									<input id="tipoPessoaFil" value="{{tipoPessoa.tipoPessoa}}" />
									<input id="tipoDataFil" value="{{tipoData.tipoData}}" />
									<input id="dataIniFil" value="{{dataIni.dataIni}}" />
									<input id="dataFimFil" value="{{dataFim.dataFim}}" />
									<input id="idsChecked" value="" />
								</div>
								<div class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label>Tipo Filtro:&nbsp;</label>
											<select name="tipoData" id="tipoData" class="chosen-select" data-placeholder="Escolha..." value="Ano/Mes" onchange="javascript:trocaFiltroData()">
												<option value="Ano/Mes">Ano/Mês</option>
												<option value="Semana">Semana</option>
												<option value="Dia">Dia</option>
											</select>
										</div>
									</div>
								</div>
								<div class="hidden col-sm-2">
									<div class="row">
										<div class="input-group">
											<label> Filial:&nbsp;</label>
											<select name="empresaFilial" id="empresaFilial" class="chosen-select" data-placeholder="Escolha..." value="Natriz">
												<option value="Matriz">Matriz</option>
												<option value="Filial 1">Filial 1</option>
												<option value="Filial 2">Filial 2</option>
												<option value="Filial 3">Filial 3</option>
												<option value="Filial 4">Filial 4</option>
											</select>
										</div>
									</div>
								</div>
								<div id="divAnoAtend" class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label for="id-date-picker-1">Ano:&nbsp;</label>
											<select name="anoAtend" id="anoAtend" class="chosen-select" data-placeholder="Escolha..." onchange="javascript:formataData();">
												{{#each anos}}
													<option value="{{ano_nome}}">{{ano_nome}}</option>
												{{/each}}
											</select>
										</div>
									</div>
								</div>
								<div id="divMesAtend" class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label for="id-date-picker-1">Mês:&nbsp;</label>
											<select name="mesAtend" id="mesAtend" class="chosen-select" data-placeholder="Escolha..." value="Janeiro" onchange="javascript:formataData();">
												<option value="0">Janeiro</option>
												<option value="1">Fevereiro</option>
												<option value="2">Março</option>
												<option value="3">Abril</option>
												<option value="4">Maio</option>
												<option value="5">Junho</option>
												<option value="6">Julho</option>
												<option value="7">Agosto</option>
												<option value="8">Setembro</option>
												<option value="9">Outubro</option>
												<option value="10">Novembro</option>
												<option value="11">Dezembro</option>
											</select>
										</div>
									</div>
								</div>
								<div id="divDataFil" class="col-sm-2">
									<div class="input-group">
										<label>Data:&nbsp;</label>
										<input style="height: 30px;" id="dataFil" name="dataFil" type="date" onchange="javascript:formataData();">
										<input class="hidden" id="dataFinal" name="dataFinal" />
										<input class="hidden" id="idDeletar" name="idDeletar" />
										<input class="hidden" id="tipoDataEdi" name="tipoDataEdi" value="{{filtroTela.tipoData}}" />
										<input class="hidden" id="anoAtendEdi" name="anoAtendEdi" value="{{filtroTela.anoAtend}}" />
										<input class="hidden" id="mesAtendEdi" name="mesAtendEdi" value="{{filtroTela.mesAtend}}" />
										<input class="hidden" id="dataFinalEdi" name="dataFinalEdi" value="{{filtroTela.dataFinal}}" />
										<input class="hidden" id="tipoPessoaEdi" name="tipoPessoaEdi" value="{{filtroTela.tipoPessoa}}" />
										<input class="hidden" id="atendBeneficiarioEdi" name="atendBeneficiarioEdi" value="{{filtroTela.atendBeneficiario}}" />
										<input class="hidden" id="atendTerapeutaEdi" name="atendTerapeutaEdi" value="{{filtroTela.atendTerapeuta}}" />
										<input class="hidden" id="idEdi" name="idEdi" value="{{filtroTela.atendTerapeuta}}" />
									</div>
								</div>
								<div id="divTipoFil" class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label>Tipo Filtro:&nbsp;</label>
											<select name="atendTipoPessoa" id="atendTipoPessoa" class="chosen-select" data-placeholder="Escolha..." value="Geral" onchange="javascript:trocaFilpessoa()">
												<option value="Geral">Geral</option>
												<option value="Beneficiario">Beneficiário</option>
												<option value="Terapeuta">Terapeuta</option>
											</select>
										</div>
									</div>
								</div>
								<div id="divAtendBeneficiario" class="col-sm-4">
									<div class="row">
										<div class="input-group">
											<label>Beneficiário:&nbsp;</label>
											<select name="atendBeneficiario" id="atendBeneficiario" class="chosen-select" data-placeholder="Escolha..." value="">
												{{#each benes}}
													<option value="{{_id}}">{{bene_nome}}</option>
												{{/each}}
											</select>
										</div>
									</div>
								</div>
								
								<div class="row">
									<button name="acaoPesquisar" id="acaoPesquisar" type="submit" class="btn btn-xs btn-info" style="margin-left: 25px;">
										<i class="ace-icon fa fa-search-plus "></i>
										Pesquisar
									</button>
									
								</div>
								<hr>
							</div>
					</form>

					<div class="row">
						<div class="col-xs-12">
							<div class="alert alert-warning">
								<button type="button" class="close" data-dismiss="alert">
									<i class="ace-icon fa fa-times"></i>
								</button>
								Aqui você localiza os agendamentos para inserir o número da guia e senha, essa é a primeira etapa para o nosso controle de guias. <br>
							</div>

							<div class="clearfix">
								<div class="pull-right tableTools-container"></div>
							</div>

							<div id="dynamic-table_wrapper" class="dataTables_wrapper form-inline no-footer"></div>
							<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid">
								<thead>
									<tr role="row">
										<th class="center">
											<label class="pos-rel">
												<input type="checkbox" class="ace" />
												<span class="lbl"></span>
											</label>
										</th>
										<th width="100px;">Data</th>
										<th width="70px;">Hora</th>
										<th>Beneficiário</th>
										<th>Convênio</th>
										<th>Terapeuta</th>
										<th>Terapia</th>
										<th width="70px;">Evolução</th>
										<th>Guia</th>
										<th  width="100px;">Data guia</th>
										<th>Senha</th>
										<th  width="90px;">Data Senha</th>
										<th>Ação</th>
									</tr>
								</thead>
								<tbody>
									{{#each extras}}
										<tr role="row" class="odd">
											<td class="center">
												<label class="pos-rel">
													<input type="checkbox" class="ace" />
													<span class="lbl"></span>
												</label>
											</td>
											<td>{{agenda_data_dia}}</td>
											<td>{{agenda_hora}}</td>

											{{#each ../benes}}
												{{#ifEqual this._id ../agenda_beneid}}
													<td>{{bene_nome}}</td>
												{{/ifEqual}}
											{{/each}}

											{{#each ../convs}}
												{{#ifEqual this._id ../agenda_convid}}
													<td>{{conv_nome}}</td>
												{{/ifEqual}}
											{{/each}}

											{{#each ../terapeutas}}
												{{#ifEqual this._id ../agenda_usuid}}
													<td>{{usuario_nome}}</td>
												{{/ifEqual}}
											{{/each}}

											{{#each ../terapias}}
												{{#ifEqual this._id ../agenda_terapiaid}}
													<td>{{terapia_nomecid}}</td>
												{{/ifEqual}}
											{{/each}}

											<!-- 2. Evolução: Sim / Não -->
											<td>{{evolucaoSimNao}}</td>

											<!-- 3. Guia, Senha, Data Senha como inputs -->
											<td>
												<input type="text" name="agendaId" value="{{_id}}" hidden />
												<input type="text" name="guia_num{{_id}}" value="{{agenda_guia.guia_num}}" style="width:100%; padding:2px; font-size:12px;" />
											</td>
											<td>
												<input type="date" name="dataguia_{{_id}}" 
													{{#if agenda_guia.guia_numdatacad}}
														value="{{#dataISOToDate agenda_guia.guia_numdatacad}}{{/dataISOToDate}}"
													{{/if}}
													style="width:100%; padding:2px; font-size:12px;" />
											</td>
											<td>
												<input type="text" name="senha_{{_id}}" value="{{agenda_guia.guia_senha}}" style="width:100%; padding:2px; font-size:12px;" />
											</td>
											<td>
												<input type="date" name="datasenha_{{_id}}" 
													{{#if agenda_guia.guia_senhadatacad}}
														value="{{#dataISOToDate agenda_guia.guia_senhadatacad}}{{/dataISOToDate}}"
													{{/if}}
													style="width:100%; padding:2px; font-size:12px;" />
											</td>

											<!-- 4. Tooltip com dados de edição/cadastro -->
											<td>
												<div class="action-buttons">
													<button class="btnSalvarGuia">💾</button>
													<a class="purple custom-tooltip" href="#" title="Detalhes">
														<i class="ace-icon fa fa-eye bigger-130"></i>
														<span class="tooltip-text">
															<strong>Cadastrado em:</strong><br>
															{{this.datacad}}<br>
															<strong>Por:</strong><br>
															{{this.usuarioCadNome}}<br><br>

															<strong>Última Edição:</strong><br>
															{{this.dataedi}}<br>
															<strong>Por:</strong><br>
															{{this.usuarioEdiNome}}
														</span>
													</a>
												</div>
											</td>
										</tr>
									{{/each}}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>



	<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
				"language": { "url": "/js/lang/datatable-pt-br.json" },
				"aaSorting": [],
				"aoColumns": [{ "bSortable": false } , null, null, null, null, null, null, null, null, null, null, null, { "bSortable": false } ],
				"responsive": true,
				"lengthMenu": [ 200, 300, 500 ],
				"paging": true,
				"searching": true,
				"ordering": true,
				"info": true,
				select: { style: 'multi' }
			});
		});
		
	</script>
	
</body>
</html>