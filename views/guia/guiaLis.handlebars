													<div class="count-header">
														<i class="ace-icon fa fa-calendar count-icon"></i>
														<span class="count-label">Agendamentos</span>
													</div>
													<div class="count-value">{{estatisticas.qa}}</div>
												</div>
											</div>
											
											<!-- QT - Atendimentos Válidos -->
											<div class="col-xs-6 col-sm-3">
												<div class="count-card convenio" title="Atendimentos Válidos (exclui Feriado e Falta Absoluta)">
													<div class="count-header">
														<i class="ace-icon fa fa-check-circle count-icon"></i>
														<span class="count-label">Atendimentos</span>
													</div>
													<div class="count-value">{{estatisticas.qt}}</div>
												</div>
											</div>
											
											<!-- QAC - Cancelados -->
											<div class="col-xs-6 col-sm-3">
												<div class="count-card liminar" title="Agendamentos Cancelados (Feriado + Falta Absoluta)">
													<div class="count-header">
														<i class="ace-icon fa fa-times-circle count-icon"></i>
														<span class="count-label">Cancelados</span>
													</div>
													<div class="count-value">{{estatisticas.qac}}</div>
												</div>
											</div>
											
											<!-- QTV - Validados com Evolução -->
											<div class="col-xs-6 col-sm-3">
												<div class="count-card particular" title="Atendimentos com Evolução Preenchida">
													<div class="count-header">
														<i class="ace-icon fa fa-file-text count-icon"></i>
														<span class="count-label">Validados</span>
													</div>
													<div class="count-value">{{estatisticas.qtv}}</div>
												</div>
											</div>
											
											<!-- QTSE - Sem Evolução -->
											<div class="col-xs-6 col-sm-3">
												<div class="count-card warning" title="Atendimentos Válidos SEM Evolução">
													<div class="count-header">
														<i class="ace-icon fa fa-exclamation-triangle count-icon"></i>
														<span class="count-label">Sem Evolução</span>
													</div>
													<div class="count-value">{{estatisticas.qtse}}</div>
												</div>
											</div>
											
											<!-- QACE - Cancelados com Evolução -->
											<div class="col-xs-6 col-sm-3">
												<div class="count-card danger" title="Cancelados com Evolução (inconsistência)">
													<div class="count-header">
														<i class="ace-icon fa fa-ban count-icon"></i>
														<span class="count-label">Cancel c/ Evol</span>
													</div>
													<div class="count-value">{{estatisticas.qace}}</div>
												</div>
											</div>
											
											<!-- ATVO - Órfãos -->
											<div class="col-xs-6 col-sm-3">
												<div class="count-card orphan" title="Atendimentos Válidos Órfãos de Guia e/ou Senha">
													<div class="count-header">
														<i class="ace-icon fa fa-child count-icon"></i>
														<span class="count-label">Órfãos</span>
													</div>
													<div class="count-value">{{estatisticas.atvo}}</div>
												</div>
											</div>
											
											<!-- QTVA - Com Guia e Autorização -->
											<div class="col-xs-6 col-sm-3">
												<div class="count-card success" title="Atendimentos com Guia e Senha Cadastradas (prontos para lote)">
													<div class="count-header">
														<i class="ace-icon fa fa-key count-icon"></i>
														<span class="count-label">Completo</span>
													</div>
													<div class="count-value">{{estatisticas.qtva}}</div>
												</div>
											</div>
											<!-- QTGU - Guias Únicas -->
											<div class="col-xs-6 col-sm-3">
												<div class="count-card success" title="Quantidade de números de guia distintos (unívocos) no período">
													<div class="count-header">
														<i class="ace-icon fa fa-fingerprint count-icon"></i>
														<span class="count-label">Guias Únicas</span>
													</div>
													<div class="count-value">{{estatisticas.qguiasUnicas}}</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
							<!-- ============================================
								CONSOLIDADO POR TERAPIA (RETRÁTIL)
								============================================ -->
						<div class="widget-box">
								<div class="widget-header widget-header-flat widget-header-small">
									<h4 class="widget-title">
										<i class="ace-icon fa fa-pie-chart"></i>
										Consolidado de Guias por Terapia
									</h4>
									<div class="widget-toolbar">
										<a href="#" data-action="collapse">
											<i class="ace-icon fa fa-chevron-up"></i>
										</a>
									</div>
								</div>
								<div class="widget-body">
									<div class="widget-main">
										<table class="table table-striped table-bordered table-hover" style="font-size: 12px;">
											<thead>
												<tr>
													<th>Terapia</th>
													<th class="center">Qtd. Total de Guias</th>
													<th class="center">Qtd. Guias Únicas</th>
												</tr>
											</thead>
											<tbody>
												{{#each consolidadoTerapias}}
												<tr>
													<td><strong>{{this.terapia_nome}}</strong></td>
													<td class="center">{{this.total_guias}}</td>
													<td class="center"><span class="badge badge-info">{{this.guias_unicas}}</span></td>
												</tr>
												{{else}}
												<tr>
													<td colspan="3" class="center text-muted">Nenhuma guia encontrada no período filtrado.</td>
												</tr>
												{{/each}}
											</tbody>
											{{#if consolidadoTerapias}}
											<tfoot>
												<tr style="background-color: #f5f5f5; font-weight: bold;">
													<td class="text-right">TOTAL GERAL:</td>
													<td class="center">{{totalGeralGuias}}</td>
													<td class="center"><span class="badge badge-success">{{estatisticas.qguiasUnicas}}</span></td>
												</tr>
											</tfoot>
											{{/if}}
										</table>
									</div>
								</div>
							</div>
							<!-- Tabela de Agendamentos para Insercao das guias e senhas de autorizacao -->
                            <div class="widget-box">
                                <div class="widget-header widget-header-flat widget-header-small">
                                    <h5 class="widget-title">
                                        <i class="ace-icon fa fa-table"></i>
                                        Lista dos Agendamentos para cadastro das Guias e Senhas
                                    </h5>
                                    <div class="widget-toolbar">
                                        <a href="#" data-action="reload">
                                            <i class="ace-icon fa fa-refresh"></i>
                                        </a>
                                        <a href="#" data-action="collapse">
                                            <i class="ace-icon fa fa-chevron-up"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="widget-body">
                                    <div class="widget-main">
										<div id="dynamic-table_wrapper" class="dataTables_wrapper form-inline no-footer"></div>
										<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid">
											<thead>
												<tr role="row">
													<th class="center">
														<label class="pos-rel">
															<input type="checkbox" class="ace" />
															<span class="lbl"></span>
														</label>
													</th>
													<th width="100px;">Data</th>
													<th width="70px;">Hora</th>
													<th>Beneficiário</th>
													<th>Convênio</th>
													<th>Terapeuta</th>
													<th>Terapia</th>
													<th>Evento</th>
													<th width="70px;">Evolução</th>
													<th>Guia</th>
													<th width="100px;">Data guia</th>
													<th>Senha</th>
													<th width="90px;">Data Senha</th>
													<th width="90px;">Ação</th>
												</tr>
											</thead>
											<tbody>
												{{#each extras}}
													<tr role="row" class="odd">
														<td class="center">
															<label class="pos-rel">
																<input type="checkbox" class="ace" />
																<span class="lbl"></span>
															</label>
														</td>
														<td>{{agenda_data_dia}}</td>
														<td>{{agenda_hora}}</td>
														
														<!-- ✅ CAMPOS ENRIQUECIDOS COM _display (acesso direto, sem loops) -->
														<td>{{bene_nome_display}}</td>
														<td>{{conv_nome_display}}</td>
														<td>{{terapeuta_nome_display}}</td>
														<td>{{terapia_nomecid_display}}</td>
														
														<td>{{agenda_categoria}}</td>
														
														<!-- Evolução: Sim / Não -->
														<td>
															{{#ifEqual evolucaoSimNao "Sim"}}
																<span class="badge badge-success">Sim</span>
															{{else}}
																<span class="badge badge-danger">Não</span>
															{{/ifEqual}}
														</td>

														<!-- Guia, Senha, Data Senha como inputs -->
														<td>
															<input type="text" name="agendaId" value="{{_id}}" hidden />
															<input type="text" name="guia_num{{_id}}" value="{{agenda_guia.guia_num}}" style="width:100%; padding:2px; font-size:12px;" />
														</td>
														<td>
															<input type="date" name="dataguia_{{_id}}" 
																{{#if guia_numdatacad_input}}
																	value="{{guia_numdatacad_input}}"
																{{/if}}
																style="width:100%; padding:2px; font-size:12px;" />
														</td>
														<td>
															<input type="text" name="senha_{{_id}}" value="{{agenda_guia.guia_senha}}" style="width:100%; padding:2px; font-size:12px;" />
														</td>
														<td>
														<input type="date" name="datasenha_{{_id}}" 
															value="{{guia_senhadatacad_input}}"
															style="width:100%; padding:2px; font-size:12px;" />
														</td>

													<!-- Tooltip com dados de edição/cadastro CORRIGIDO para mostrar dados da GUIA -->
<td>
    <div class="action-buttons">
        <button class="btnSalvarGuia">💾</button>
        <a class="purple custom-tooltip" href="javascript:void(0);" title="Detalhes">
            <i class="ace-icon fa fa-eye bigger-130"></i>
            <span class="tooltip-text">
                <strong style="color:#0056b3;">📅 DADOS DO AGENDAMENTO:</strong><br>
                Criado: {{datacad}} por {{usuarioCadNome}}<br>
                Editado: {{dataedi}} por {{usuarioEdiNome}}<br>
                <hr style="margin: 5px 0; border: 0; border-top: 1px solid #ccc;">
                <strong style="color:#28a745;">💰 DADOS DA GUIA/FATURAMENTO:</strong><br>
                Inserida: {{guiaDatacad}} por {{guiaUsuarioCadNome}}<br>
                Alt. Guia: {{guiaDataedi}} por {{guiaUsuarioEdiNome}}
            </span>
        </a>
    </div>
</td>
													</tr>
												{{/each}}
											</tbody>
										</table>
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="alert alert-warning">
						<button type="button" class="close" data-dismiss="alert">
							<i class="ace-icon fa fa-times"></i>
						</button>
						Aqui você localiza os agendamentos para inserir o número da guia e senha, essa é a primeira etapa para o nosso controle de guias. <br>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script type="text/javascript">
		$(document).ready(function() {

			// ✅ Listeners para Chosen Select (crucial para funcionar)
			$("#tipoData").on("change", function() {
				trocaFiltroData();
			});

			$("#atendTipoPessoa").on("change", function() {
				trocaFilpessoa();
			});

			$("#dynamic-table").DataTable({
				"language": { "url": "/js/lang/datatable-pt-br.json" },
				"aaSorting": [],
				"aoColumns": [{ "bSortable": false } , null, null,null, null, null, null, null, null, null, null, null, null, { "bSortable": false } ],
				"responsive": true,
				"lengthMenu": [ 300, 500, 1000, 1500, 2500, 5000 ],
				"paging": true,
				"searching": true,
				"ordering": true,
				"info": true,
				select: { style: 'multi' }
			});
			
			// Inicializar contador
			atualizarContadorSelecionados();
		});
		
	</script>
	
</body>
</html>