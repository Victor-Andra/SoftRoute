	<script type="text/javascript">
		function ajustaData(){
			let fullDatas = document.getElementsByName("fullData");
			fullDatas.forEach((elementox)=>{
				let id = "atenddata"+elementox.id;
				let dat = new Date(elementox.value);
				let mes = (dat.getMonth()+1).toString();
				let dia = (dat.getUTCDate()).toString();

				if (mes.length == 1){
					mes = "0"+mes;
				}
				if (dia.length == 1){
					dia = "0"+dia;
				}

				let fulldate=(dia+"/"+mes+"/"+dat.getFullYear()).toString();
			})
		}

		function formataData(){
			let tipo = document.getElementById("tipoData").value;
			if(tipo == "Ano/Mes"){
				let ano = document.getElementById('anoAtend').value;
				let mes = document.getElementById('mesAtend').value;
				if (!ano || !mes) return;
				let dat = new Date(Date.UTC(parseInt(ano), parseInt(mes), 1));
				let mesStr = (dat.getUTCMonth() + 1).toString().padStart(2, '0');
				let diaStr = dat.getUTCDate().toString().padStart(2, '0');
				let fulldate = `${dat.getUTCFullYear()}-${mesStr}-${diaStr}T00:00:00.000Z`;
				document.getElementById('dataFinal').value = fulldate;
			} else if (tipo == "Semana" || tipo == "Dia"){
				let dataInput = document.getElementById('dataFil').value;
				if (!dataInput) return;
				let dat = new Date(dataInput);
				let mesStr = (dat.getUTCMonth() + 1).toString().padStart(2, '0');
				let diaStr = dat.getUTCDate().toString().padStart(2, '0');
				let fulldate = `${dat.getUTCFullYear()}-${mesStr}-${diaStr}`;
				document.getElementById('dataFinal').value = fulldate;
			}
		}

		// ✅ CORRIGIDO: Usa style.display em vez de atributo hidden
		function trocaFiltroData(){
			const tipo = document.getElementById("tipoData").value;
			
			// Oculta tudo
			document.getElementById("divAnoAtend").classList.add('hidden-div');
			document.getElementById("divMesAtend").classList.add('hidden-div');
			document.getElementById("divDataFil").classList.add('hidden-div');
			
			// Mostra conforme seleção
			if(tipo == "Ano/Mes"){
				document.getElementById("divAnoAtend").classList.remove('hidden-div');
				document.getElementById("divMesAtend").classList.remove('hidden-div');
			} else if (tipo == "Semana" || tipo == "Dia"){
				document.getElementById("divDataFil").classList.remove('hidden-div');
			}
			
			console.log('[DEBUG] Tipo Data:', tipo);
		}

		// ✅ CORRIGIDO: Usa style.display em vez de atributo hidden
		function trocaFilpessoa() {
			const tipo = $('#atendTipoPessoa').val();

			// Oculta todos primeiro
			$('#divAtendBeneficiario').addClass('hidden-div');
			$('#divAtendTerapeuta').addClass('hidden-div');
			$('#divAtendConvenio').addClass('hidden-div');  // ✅ Adicionado

			// Mostra apenas o relevante
			if (tipo === 'Geral') {
				// Todos ocultos (já feito acima)
			} else if (tipo === 'Beneficiario') {
				$('#divAtendBeneficiario').removeClass('hidden-div');
			} else if (tipo === 'Terapeuta') {
				$('#divAtendTerapeuta').removeClass('hidden-div');
			} else if (tipo === 'Convênio') {  // ✅ Adicionado
				$('#divAtendConvenio').removeClass('hidden-div');
			}
		}

		// ✅ CORRIGIDO: Carrega estado inicial com visibilidade correta
		function carregaBody(){
			// Define valores padrão
			if (!document.getElementById("tipoData").value) {
				document.getElementById("tipoData").value = "Ano/Mes";
			}
			if (!document.getElementById("atendTipoPessoa").value) {
				document.getElementById("atendTipoPessoa").value = "Geral";
			}
			
			// Aplica visibilidade inicial
			trocaFiltroData();
			trocaFilpessoa();
			
			// Carrega valores do filtro se existirem
			if (document.getElementById("carregaFiltro").value == "true"){
				// Tipo Data
				document.getElementById("tipoData").value = document.getElementById("tipoDataFil").value || "Ano/Mes";
				trocaFiltroData();
				
				if(document.getElementById("tipoData").value == "Ano/Mes"){
					document.getElementById("anoAtend").value = document.getElementById("anoAtendFil").value || "";
					document.getElementById("mesAtend").value = document.getElementById("mesAtendFil").value || "0";
				} else if (document.getElementById("tipoData").value == "Semana" || document.getElementById("tipoData").value == "Dia"){
					document.getElementById("dataFil").value = document.getElementById("dataFinalFil").value.split('T')[0] || "";
				}

				// Tipo Pessoa
				document.getElementById("atendTipoPessoa").value = document.getElementById("tipoPessoaFil").value || "Geral";
				trocaFilpessoa();
				
				if (document.getElementById("atendTipoPessoa").value == "Beneficiario"){
					document.getElementById("atendBeneficiario").value = document.getElementById("atendBeneficiarioFil").value || "766f69643132333435366964";
				} else if (document.getElementById("atendTipoPessoa").value == "Terapeuta"){
					document.getElementById("atendTerapeuta").value = document.getElementById("atendTerapeutaFil").value || "766f69643132333435366964";
				}
			}
			
			// Carrega valores de edição se existirem
			const tipoDataEdi = document.getElementById("tipoDataEdi").value;
			const tipoPessoaEdi = document.getElementById("tipoPessoaEdi").value;
			
			if (tipoDataEdi == "Ano/Mes"){
				document.getElementById("tipoData").value = tipoDataEdi;
				trocaFiltroData();
				document.getElementById("anoAtend").value = document.getElementById("anoAtendEdi").value || "";
				document.getElementById("mesAtend").value = document.getElementById("mesAtendEdi").value || "0";
			} else if (tipoDataEdi == "Semana" || tipoDataEdi == "Dia"){
				document.getElementById("tipoData").value = tipoDataEdi;
				trocaFiltroData();
				const dataEdi = document.getElementById("dataFinalEdi").value;
				if (dataEdi) {
					const dat = new Date(dataEdi);
					const mes = (dat.getUTCMonth() + 1).toString().padStart(2, '0');
					const dia = dat.getUTCDate().toString().padStart(2, '0');
					document.getElementById("dataFil").value = `${dat.getUTCFullYear()}-${mes}-${dia}`;
				}
			}
			
			if (tipoPessoaEdi == "Beneficiario"){
				document.getElementById("atendTipoPessoa").value = tipoPessoaEdi;
				trocaFilpessoa();
				document.getElementById("atendBeneficiario").value = document.getElementById("atendBeneficiarioEdi").value || "766f69643132333435366964";
			} else if (tipoPessoaEdi == "Terapeuta"){
				document.getElementById("atendTipoPessoa").value = tipoPessoaEdi;
				trocaFilpessoa();
				document.getElementById("atendTerapeuta").value = document.getElementById("atendTerapeutaEdi").value || "766f69643132333435366964";
			}
			
			
		}
		
		// ============================================
		// SALVAR EM MASSA - NOVA FUNCIONALIDADE
		// ============================================
		async function salvarEmMassa() {
			const guiaMassa = document.getElementById('guiaMassa').value.trim();
			const dataGuiaMassa = document.getElementById('dataGuiaMassa').value;
			const senhaMassa = document.getElementById('senhaMassa').value.trim();
			const dataSenhaMassa = document.getElementById('dataSenhaMassa').value;

			// Validar se pelo menos um campo foi preenchido
			if (!guiaMassa && !dataGuiaMassa && !senhaMassa && !dataSenhaMassa) {
				alert('⚠️ Preencha pelo menos um campo (Guia, Data Guia, Senha ou Data Senha) para salvar em massa.');
				return;
			}

			// Obter checkboxes selecionados
			const checkboxes = document.querySelectorAll('#dynamic-table tbody input[type="checkbox"]:checked');
			
			if (checkboxes.length === 0) {
				alert('⚠️ Selecione pelo menos um registro para salvar em massa.');
				return;
			}

			// ✅ Substitui "localhost" por "SoftRoute" na mensagem de confirmação
			if (!confirm(`SoftRoute\n\nDeseja salvar os dados em massa para ${checkboxes.length} registro(s) selecionado(s)?\n\n⚠️ ATENÇÃO: Registros que já possuem dados NÃO serão atualizados para evitar sobrescrita.`)) {
				return;
			}

			const btnSalvar = document.getElementById('btnSalvarMassa');
			btnSalvar.disabled = true;
			btnSalvar.innerHTML = '<i class="ace-icon fa fa-spinner fa-spin"></i> Processando...';

			try {
				const updates = [];
				
				checkboxes.forEach(checkbox => {
					const tr = checkbox.closest('tr');
					const agendaId = tr.querySelector(`[name="agendaId"]`)?.value;
					
					if (agendaId) {
						updates.push({
							agendaId: agendaId,
							guia_num: guiaMassa || null,
							guia_numdatacad: dataGuiaMassa || null,
							guia_senha: senhaMassa || null,
							guia_senhadatacad: dataSenhaMassa || null
						});
					}
				});

				const resp = await fetch('/menu/guia/addguia/massa', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ updates })
				});

				const result = await resp.json();

				if (result.ok) {
					// Atualizar visualmente os campos nas linhas ATUALIZADAS
					if (result.atualizados && result.atualizados.length > 0) {
						result.atualizados.forEach(atualizado => {
							const tr = document.querySelector(`[name="agendaId"][value="${atualizado.agendaId}"]`)?.closest('tr');
							if (tr) {
								tr.style.backgroundColor = '#d4edda';
								tr.style.transition = 'background-color 0.5s';
								
								if (guiaMassa) {
									const inputGuia = tr.querySelector(`[name="guia_num${atualizado.agendaId}"]`);
									if (inputGuia) inputGuia.value = guiaMassa;
								}
								if (dataGuiaMassa) {
									const inputDataGuia = tr.querySelector(`[name="dataguia_${atualizado.agendaId}"]`);
									if (inputDataGuia) inputDataGuia.value = dataGuiaMassa;
								}
								if (senhaMassa) {
									const inputSenha = tr.querySelector(`[name="senha_${atualizado.agendaId}"]`);
									if (inputSenha) inputSenha.value = senhaMassa;
								}
								if (dataSenhaMassa) {
									const inputDataSenha = tr.querySelector(`[name="datasenha_${atualizado.agendaId}"]`);
									if (inputDataSenha) inputDataSenha.value = dataSenhaMassa;
								}
								
								setTimeout(() => {
									tr.style.backgroundColor = '';
								}, 2000);
							}
						});
					}

					// Destacar linhas IGNORADAS (com dados  existentes)
					if (result.ignorados && result.ignorados.length > 0) {
						result.ignorados.forEach(ignorado => {
							const tr = document.querySelector(`[name="agendaId"][value="${ignorado.agendaId}"]`)?.closest('tr');
							if (tr) {
								tr.style.backgroundColor = '#fff3cd';
								tr.style.transition = 'background-color 0.5s';
								
								const tooltipCell = tr.querySelector('td:last-child');
								if (tooltipCell) {
									tooltipCell.innerHTML = `
										<div class="action-buttons">
											<span class="label label-warning" title="Registro ignorado - já possui dados">
												<i class="ace-icon fa fa-exclamation-triangle"></i> Ignorado
											</span>
											${tooltipCell.innerHTML}
										</div>
									`;
								}
								
								setTimeout(() => {
									tr.style.backgroundColor = '';
								}, 3000);
							}
						});
					}

					// Feedback visual de sucesso
					btnSalvar.classList.add('btn-success-pulse');
					btnSalvar.innerHTML = '<i class="ace-icon fa fa-check"></i> Concluído!';
					
					setTimeout(() => {
						btnSalvar.disabled = false;
						btnSalvar.classList.remove('btn-success-pulse');
						btnSalvar.innerHTML = '<i class="ace-icon fa fa-save"></i> Salvar em Massa';
						
						// Limpar campos após salvar
						document.getElementById('guiaMassa').value = '';
						document.getElementById('dataGuiaMassa').value = '';
						document.getElementById('senhaMassa').value = '';
						document.getElementById('dataSenhaMassa').value = '';
						
						// Atualizar contador
						atualizarContadorSelecionados();
						
						// ✅ Substitui "localhost" por "SoftRoute" no alerta
						mostrarRelatorioMassa(result);
						
					}, 1500);
				} else {
					throw new Error(result.message || 'Erro ao salvar em massa');
				}
			} catch (err) {
				console.error('[ERRO salvarEmMassa]', err);
				// ✅ Substitui "localhost" por "SoftRoute" no erro
				alert(`❌ SoftRoute\n\nErro ao salvar em massa: ${err.message}`);
				btnSalvar.disabled = false;
				btnSalvar.innerHTML = '<i class="ace-icon fa fa-save"></i> Salvar em Massa';
			}
		}

		// Função para mostrar relatório detalhado em modal
		function mostrarRelatorioMassa(result) {
			const res = result.resumo;
			
			// ✅ Substitui "localhost" por "SoftRoute" na mensagem
			let mensagem = `✅ SoftRoute\n\nSALVAMENTO EM MASSA CONCLUÍDO!\n\n`;
			mensagem += `📊 Resumo:\n`;
			mensagem += `   • Total selecionados: ${res.total}\n`;
			mensagem += `   • Atualizados: ${res.atualizados} ✅\n`;
			mensagem += `   • Ignorados (já possuem dados): ${res.ignorados} ⚠️\n`;
			mensagem += `   • Erros: ${res.erros} ❌\n\n`;
			
			if (result.ignorados && result.ignorados.length > 0) {
				mensagem += `⚠️ REGISTROS IGNORADOS:\n`;
				result.ignorados.forEach((ignorado, index) => {
					const campos = ignorado.camposComDados.join(', ');
					mensagem += `   ${index + 1}. ID: ${ignorado.agendaId.substring(0, 8)}... - Campos com dados: ${campos}\n`;
				});
				mensagem += `\n💡 Dica: Para atualizar registros ignorados, edite-os individualmente.`;
			}
			
			alert(mensagem);
		}

		// Atualizar contador de selecionados
		function atualizarContadorSelecionados() {
			const count = document.querySelectorAll('#dynamic-table tbody input[type="checkbox"]:checked').length;
			const contador = document.querySelector('.badge-selecionados');
			if (contador) {
				contador.textContent = count;
			}
		}

		// Event listener para checkboxes
		document.addEventListener('change', (e) => {
			if (e.target.matches('#dynamic-table tbody input[type="checkbox"]')) {
				atualizarContadorSelecionados();
			}
		});

		// ✅ Checkbox de seleção em massa
		function toggleAllCheckboxes(checked) {
			const checkboxes = document.querySelectorAll('#dynamic-table tbody input[type="checkbox"]');
			checkboxes.forEach(checkbox => {
				checkbox.checked = checked;
			});
			atualizarContadorSelecionados();
		}

		// Listener para checkbox do cabeçalho
		document.addEventListener('change', (e) => {
			if (e.target.matches('#dynamic-table thead input[type="checkbox"]')) {
				toggleAllCheckboxes(e.target.checked);
			}
		});

		// Listener para botão individual (mantido)
		document.addEventListener('click', async (e) => {
			if (!e.target.classList.contains('btnSalvarGuia')) return;

			e.preventDefault();

			const tr = e.target.closest('tr');
			const agendaId = tr.querySelector(`[name="agendaId"]`)?.value;
			const guia_num = tr.querySelector(`[name="guia_num${agendaId}"]`)?.value;
			const guia_numdatacad = tr.querySelector(`[name="dataguia_${agendaId}"]`)?.value;
			const guia_senha = tr.querySelector(`[name="senha_${agendaId}"]`)?.value;
			const guia_senhadatacad = tr.querySelector(`[name="datasenha_${agendaId}"]`)?.value;
			
			const payload = {
				agendaId,
				guia_num,
				guia_numdatacad,
				guia_senha,
				guia_senhadatacad
			};

			try {
				const resp = await fetch('/menu/guia/addguia', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload)
				});
				const result = await resp.json();

				if (result.ok) {
					e.target.innerText = '✔';
					setTimeout(() => e.target.innerText = '💾', 1000);
				} else {
					// ✅ Substitui "localhost" por "SoftRoute" no erro
					alert(`❌ SoftRoute\n\n${result.message || 'Erro ao salvar'}`);
				}
			} catch (err) {
				console.error(err);
				// ✅ Substitui "localhost" por "SoftRoute" no erro
				alert(`❌ SoftRoute\n\nErro de comunicação`);
			}
		});
	</script>
</head>
