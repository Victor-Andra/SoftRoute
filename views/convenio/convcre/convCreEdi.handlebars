<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Créditos de Convênios Edição</title>
	</head>

	<body class="no-skin" onload="javascript:carregaBody();controlaNave();">
		<!-- Inputs hidden para valores de edição -->
		<input id="convcreStatusEdi" name="convcreStatusEdi" class="hidden" value="{{convcre.convcre_status}}"/>
		<input id="convIdEdi" name="convIdEdi" class="hidden" value="{{convcre.convcre_convid}}"/>
		<input id="terapiaIdEdi" name="terapiaIdEdi" class="hidden" value="{{convcre.convcre_terapiaid}}"/>
		<input id="dataEdi" name="dataEdi" class="hidden" value="{{convcre.convcre_data}}"/>

		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li><i class="ace-icon fa fa-home home-icon"></i><a href="#">Home</a></li>
							<li class="active">Créditos de Convênios Edição</li>
						</ul>
					</div>

					<div class="row">
						<div class="col-xs-12">
							<form class="form-horizontal" role="form" action="/menu/convenio/convcre/atualizar" method="POST">
								<input id="convcreId" name="convcreId" class="hidden" value="{{convcre._id}}"/>
								<div class="col-sm-12">
									<div class="widget-box">
										<div class="widget-header">
											<h4 class="widget-title">Crédito de Convênios</h4>
											<span class="widget-toolbar">
												<a href="#" data-action="reload"><i class="ace-icon fa fa-refresh"></i></a>
												<a href="#" data-action="collapse"><i class="ace-icon fa fa-chevron-up"></i></a>
											</span>
										</div>
										<div class="widget-body">
											<div class="widget-main">
												<label>Convênio</label>
												<div class="form-group">
													<div class="col-sm-4">
														<select name="convcreConvid" id="convcreConvid" class="select2" data-placeholder="Escolha...">
															{{#each convs}}
															<option value="{{_id}}">{{conv_nome}}</option>
															{{/each}}
														</select>
													</div>
												</div>

												<label>Terapia</label>
												<div class="form-group">
													<div class="col-sm-4">
														<select name="convcreTerapiaid" id="convcreTerapiaid" class="select2" data-placeholder="Escolha...">
															{{#each terapias}}
															<option value="{{_id}}">{{terapia_nome}}</option>
															{{/each}}
														</select>
													</div>
												</div>

												<label for="id-date-picker-1">Data</label>
												<div class="row">
													<div class="col-sm-3">
														<div class="input-group">
															<input name="convcreData" id="convcreData" type="date" onchange="javascript:atualizaData()" />
															<input name="convcreDataFinal" id="convcreDataFinal" class="hidden" />
														</div>
													</div>
												</div>

												<div class="space space-8"></div>
												<label>Valor de Crédito</label>
												<div class="form-group">
													<div class="col-sm-6">
														<input type="text" name="convcreValor" placeholder="" class="form-control" value="{{convcre.convcre_valor}}"/>
													</div>
												</div>
												
												<label>Status</label>
												<div class="form-group">
													<div class="col-sm-2">
														<select name="convcreStatus" id="convcreStatus" class="select2" style="width: 100px;">
															<option value="Ativo">Ativo</option>
															<option value="Inativo">Inativo</option>
														</select>
													</div>
												</div>

												<div class="space space-8"></div>
												<label>Observações</label>
												<div class="form-group">
													<div class="col-sm-6">
														<input type="text" name="convcreObs" id="convcreObs" placeholder="" class="form-control" value="{{convcre.convcre_obs}}"/>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							
								<div class="space-6"></div>
								<div class="form-actions">
									<div class="col-xs-12" style="text-align: center;">
										<button class="btn btn-info" name="acao" type="submit">
											<i class="ace-icon fa fa-check bigger-110"></i> Salvar
										</button>
										&nbsp; &nbsp; &nbsp;
										<button type="button" class="btn btn-warning" onclick="window.location.href='/menu/convenio/convcre/lis'">
											<i class="ace-icon fa fa-undo bigger-110"></i> Voltar
										</button>
									</div>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- 🔹 SCRIPTS CORRIGIDOS -->
		<script type="text/javascript">
			function atualizaData(){
				var dataInput = document.getElementById("convcreData").value;
				if(!dataInput) return;
				var datafmt = new Date(dataInput + "T00:00:00.000Z");
				document.getElementById("convcreDataFinal").value = datafmt.toISOString();
			}

			function carregaBody(){
				// 1️⃣ Pega valores dos hidden inputs
				var convid = document.getElementById("convIdEdi").value;
				var terapiaid = document.getElementById("terapiaIdEdi").value;
				var status = document.getElementById("convcreStatusEdi").value;
				var dataEdi = document.getElementById("dataEdi").value;

				// 2️⃣ Formata e aplica data
				if(dataEdi){
					document.getElementById("convcreData").value = dataEdi.substring(0,10); // YYYY-MM-DD
					atualizaData();
				}

				// 3️⃣ Atualiza selects COM suporte ao Chosen
				if (typeof jQuery !== 'undefined' && jQuery.fn.chosen) {
					$('#convcreConvid').val(convid).trigger('chosen:updated');
					$('#convcreTerapiaid').val(terapiaid).trigger('chosen:updated');
					$('#convcreStatus').val(status).trigger('chosen:updated');
				} else {
					// Fallback puro JS (caso Chosen falhe)
					document.getElementById("convcreConvid").value = convid;
					document.getElementById("convcreTerapiaid").value = terapiaid;
					document.getElementById("convcreStatus").value = status;
				}
			}

			// 🔒 Inicialização segura: roda APÓS o DOM e Chosen estarem prontos
			$(document).ready(function() {
				// 1. Inicializa Chosen
				if (typeof $.fn.chosen === 'function') {
					$('.chosen-select').chosen({
						width: '100%',
						disable_search_threshold: 10,
						allow_single_deselect: true,
						no_results_text: 'Nenhum resultado encontrado'
					});
				}
				
				// 2. Carrega os valores corretamente
				carregaBody();
				
				// 3. Inicializa navegação do Ace Admin
				if(typeof controlaNave === 'function') controlaNave();
			});
		</script>
	</body>
</html>