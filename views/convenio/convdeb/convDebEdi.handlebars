<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Débitos de Convênios Edição</title>
		<script>
			function carregaBody(){
				// Valores dos hidden inputs
				const conveniosId = document.getElementById("convdebConvidEdi").value;
				const terapiaId = document.getElementById("convdebTerapiaidEdi").value;
				const status = document.getElementById("convdebStatusEdi").value;
				
				// 🎯 Atualiza os selects E dispara o evento do Chosen
				if (typeof jQuery !== 'undefined' && jQuery.fn.chosen) {
					$('#convdebConvid').val(conveniosId).trigger('chosen:updated');
					$('#convdebTerapiaid').val(terapiaId).trigger('chosen:updated');
					$('#convdebStatus').val(status).trigger('chosen:updated');
				} else {
					// Fallback caso Chosen não esteja carregado ainda
					document.getElementById("convdebConvid").value = conveniosId;
					document.getElementById("convdebTerapiaid").value = terapiaId;
					document.getElementById("convdebStatus").value = status;
				}
				
				// Data
				atualizaData();
			}
			function atualizaData(){
				var hora = "00:00"
				var data = document.getElementById("convdebData").value+"T"+hora+":00.000Z";
				var datafmt = new Date(data);
				document.getElementById("convdebDataFinal").value = datafmt.toISOString();
			}
		</script>
	</head>
	<body onload="javascript:controlaNave(); carregaBody();" class="no-skin">
		<div id="divCarrega" name="divCarrega" class="hidden">
			<input id="convdebStatusEdi" name="convdebStatusEdi" value="{{convdeb.convdeb_status}}"/>
		</div>
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Débitos de Convênios Edição</li>
						</ul><!-- /.breadcrumb -->
					</div>
					<div class="row">
						<div class="col-xs-12">
							<!-- PAGE CONTENT BEGINS -->
							<form class="form-horizontal" role="form"  action="/menu/convenio/convdeb/atualizar" method="POST">
								<input id="convdebId" name="convdebId" hidden value="{{convdeb._id}}"/>
								<div class="col-sm-12"><!-- Widget Dados Básicos -->
									<div class="widget-box">
										<div class="widget-header">
											<h4 class="widget-title">Débito de Convênios</h4>
											<span class="widget-toolbar">
												<a href="#" data-action="reload">
													<i class="ace-icon fa fa-refresh"></i>
												</a>
												<a href="#" data-action="collapse">
													<i class="ace-icon fa fa-chevron-up"></i>
												</a>
											</span>
										</div>
										<div class="widget-body">
											<div class="widget-main">
												<input name="convdebId" class="hidden" value="{{convdeb._id}}"/>
												<label> Convênio </label>
												<div class="form-group">
													<div class="col-sm-6">
														<select name="convdebConvid" id="convdebConvid" class="select2" data-placeholder="Escolha...">
															{{#each convs}}
																<option value="{{_id}}">{{conv_nome}}</option>
															{{/each}}
														</select>
													</div>
												</div>
												<div class="space space-8"></div>
												<label>Terapia</label>
												<div class="form-group">
													<div class="col-sm-4">
														<select name="convdebTerapiaid" id="convdebTerapiaid" class="select2" data-placeholder="Escolha...">
															{{#each terapias}}
																<option value="{{_id}}">{{terapia_nome}}</option>
															{{/each}}
														</select>
													</div>
												</div>
												<label for="id-date-picker-1">Data</label>
												<div class="row">
													<div class="col-sm-3">
														<div class="input-group">
															<input name="convdebData" id="convdebData"  type="date" value="{{convdeb.convdeb_data}}"/>
														</div>
													</div>
												</div>
												<label>Status</label>
												<div class="form-group">
													<div class="col-sm-2">
														<select name="convdebStatus" id="convdebStatus" class="select2" style="width: 100px;">
															<option value="Ativo">Ativo</option>
															<option value="Inativo">Inativo</option>
														</select>
													</div>
												</div>
												<div class="space space-8"></div>
												<label> Valor a Débito</label>
												<div class="form-group">
													<div class="col-sm-6">
														<input type="text" name="convdebValor" id="convdebValor" placeholder="" class="form-control" value="{{convdeb.convdeb_valor}}"/>
													</div>
												</div>
												<div class="space space-8"></div>
												<label> Observações</label>
												<div class="form-group">
													<div class="col-sm-6">
														<input type="text" name="convdebObs" id="convdebObs" placeholder="" class="form-control" value="{{convdeb.convdeb_obs}}"/>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
								<div class="space-6"></div>
											
									<div class="form-actions">
										<div class="col-xs-12" style="text-align: center;" >
											<button class="btn btn-info" name="acao" type="submit">
												<i class="ace-icon fa fa-check bigger-110"></i>
												Salvar
											</button>
											&nbsp; &nbsp; &nbsp;
											<button class="btn btn-warning"  href="/menu/convenio/convdeb/lis">
												<i class="ace-icon fa fa-undo bigger-110"></i>
												Voltar
											</button>
										</div>
									</div>
							</form>
							<div class="hidden">
								<input id="convdebTerapiaidEdi" name="convdebTerapiaidEdi" value="{{convdeb.convdeb_terapiaid}}" />
								<input id="convdebConvidEdi" name="convdebConvidEdi" value="{{convdeb.convdeb_convid}}" />
							</div>
						</div><!-- /.col -->
					</div><!-- /.row -->
				</div>
			</div><!-- /.main-content -->
		</div><!-- /.main-container -->
	</body><!-- basic scripts -->
</html>
