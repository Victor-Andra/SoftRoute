<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Convênios</title>
		<script>
			function carregaBody(){
				document.getElementById("beneEnduf").value = document.getElementById("beneEndufEdi").value;
				document.getElementById("convStatus").value = document.getElementById("convStatusEdi").value;
			}
		</script>
	</head>

	<body onload="javascript:controlaNave();carregaBody();" class="no-skin">
		<div id="divCarrega" name="divCarrega" class="hidden">
			<input id="convEndufEdi" name="convEndufEdi" value="{{conv.conv_enduf}}"/>
			<input id="convStatusEdi" name="convStatusEdi" value="{{conv.conv_status}}"/>
			
		</div>
		

		<div class="main-container ace-save-state" id="main-container">


			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>

							<li class="active">Convênios Editar</li>
						</ul><!-- /.breadcrumb -->

					</div>

					<div class="row">
						<div class="col-xs-12">
							<!-- PAGE CONTENT BEGINS -->
							<form class="form-horizontal" role="form" action="/menu/convenio/conv/atualizar" method="POST">
								<div class="col-sm-12">
									<div class="tabbable"><!-- tabbable -->
										<ul class="nav nav-tabs" id="myTab">
											<li class="active">
												<a data-toggle="tab" href="#dados">
													<i class="red ace-icon fa fa-heartbeat bigger-120"></i>
													Dados Básicos
												</a>
											</li>
											<li>
												<a data-toggle="tab" href="#end">
													Endereço
													<i class="orange ace-icon fa fa-globe bigger-120"></i>
												</a>
											</li>
											<li>
												<a data-toggle="tab" href="#contato">
													Contato
													<i class="pink ace-icon fa fa-phone bigger-120"></i>
												</a>
											</li>
											<li>
												<a data-toggle="tab" href="#imp">
													Impostos
													<i class="red ace-icon fa fa-paw bigger-120"></i>
												</a>
											</li>
											<li>
												<a data-toggle="tab" href="#obs">
													Observações
													<i class="blue ace-icon fa fa-commenting-o bigger-120"></i>
												</a>
											</li>
										</ul>
										<div class="tab-content">
											<div id="dados" class="tab-pane fade in active">
													<label> Nome Convênio</label>
														<div class="form-group">
															<div class="col-sm-6">
																<input type="text" name="convNome" id="convNome"  class="form-control" value="{{conv.conv_nome}}"/>
															</div>
														</div>


													<label> Razão Social</label>
														<div class="form-group">
															<div class="col-sm-9">
																<input type="text" name="convRazao" id="convRazao"  class="form-control" value="{{conv.conv_razao}}"/>
															</div>
														</div>

													<div class="space space-8"></div>
													<label> Nº Contrato</label>
														<div class="form-group">
															<div class="col-sm-6">
																<input type="text" name="convContrato" id="convContrato"  class="form-control" value="{{conv.conv_contrato}}"/>
															</div>
														</div>

													<div class="space space-8"></div>
													<label> CNPJ</label>
														<div class="form-group">
															<div class="col-sm-6">
																<input type="text" name="convCnpj" placeholder="" class="form-control" value="{{conv.conv_cnpj}}"/>
															</div>
														</div>
													<label>Status</label>
													<div class="form-group">
															<div class="col-sm-6">
																<select name="convStatus" id="convStatus" class="chosen-select" data-placeholder="" >
																	<option value="Ativo">Ativo</option>
																	<option value="Inativo">Inativo</option>
																</select>
															</div>
													</div>
											</div>
													
											<div id="end" class="tab-pane fade">
												<label > Endereço </label>
												<div class="form-group">
													<div class="col-sm-9">
														<input type="text" name="convEnd" id="convEnd" class="form-control" value="{{conv.conv_end}}"/>
													</div>
												</div>
				
												<label> Complemento </label>
												<div class="form-group">
													<div class="col-sm-9">
														<input type="text" name="convEndcompl" id="convEndcompl"  class="form-control" value="{{conv.conv_endcompl}}"/>
													</div>
												</div>
				
												<label> Bairro </label>
												<div class="form-group">
													<div class="col-sm-9">
														<input type="text" name="convEndbairro" id="convEndbairro" class="form-control" value="{{conv.conv_endbairro}}"/>
													</div>
												</div>
				
												<label> Cidade </label>
												<div class="form-group">
													<div class="col-sm-9">
														<input type="text" name="convEndcidade" id="convEndcidade" class="form-control" value="{{conv.conv_endcidade}}"/>
													</div>
												</div>

				
												<label>UF</label>
												<div class="form-group">
														<div class="col-sm-6">
															<select name="convEnduf" id="convEnduf"  class="chosen-select" data-placeholder="Escolha o estado..." >
																{{#each estados}}
																	<option value="{{_id}}">{{estado_uf}}</option>
																	{{else}}
																{{/each}}
															</select>
														</div>
												</div>
				
												<label> CEP </label>
												<div class="form-group">
													<div class="col-sm-3">
														<input type="text" name="convEndcep" id="convEndcep" class="form-control" value="{{conv.conv_endcep}}"/>
													</div>
												</div>
											</div>
											<div id="contato" class="tab-pane fade">
												<div>
													<label>WhatsApp
														<small class="text-warning"></small>
													</label>
									
													<div class="input-group">
														<span class="input-group-addon">
															<i class="ace-icon fa fa-phone"></i>
														</span>
									
														<input name="convWhatsapp" id="convWhatsapp" class="col-sm-4" class="form-control input-mask-phone" type="text" id="Whatsapp" value="{{conv.conv_whatsapp}}"/>
													</div>
												</div>
				
									
												<div>
													<label>Celular
														<small class="text-warning"> </small>
													</label>
									
													<div class="input-group">
														<span class="input-group-addon">
															<i class="ace-icon fa fa-phone"></i>
														</span>
									
														<input name="convCel" id="convCel" class="col-sm-4" class="form-control input-mask-phone" type="text" id="Celular" value="{{conv.conv_cel}}" />
													</div>
												</div>

												<div>
													<label>Celular
														<small class="text-warning"> </small>
													</label>
									
													<div class="input-group">
														<span class="input-group-addon">
															<i class="ace-icon fa fa-phone"></i>
														</span>
									
														<input name="convFixo" id="convFixo" class="col-sm-4" class="form-control input-mask-phone" type="text" id="Celular" value="{{conv.conv_fixo}}"/>
													</div>
												</div>

												<div>
													<label>E-mail
														<small class="text-warning"></small>
													</label>
									
													<div class="input-group">
														<span class="input-group-addon">
															<i class="ace-icon fa fa-envelope-o"></i>
														</span>
									
														<input name="convEmail" id="convEmail" class="col-sm-4" class="form-control input-mask-phone" type="text" value="{{conv.conv_email}}" />
													</div>
												</div>


												<div>
													<label>Site
														<small class="text-warning"></small>
													</label>
									
													<div class="input-group">
														<span class="input-group-addon">
															<i class="ace-icon fa fa-home"></i>
														</span>
									
														<input name="convSite" id="convSite" class="col-sm-4" class="form-control input-mask-phone" type="text" value="{{conv.conv_site}}" />
													</div>
												</div>
											</div>
											<div id="imp" class="tab-pane fade"></div>
											
											<div id="obs" class="tab-pane fade">
												<label> Observações </label>
													<div class="form-group">
														<div class="col-sm-9">
															<input type="text" name="convObs"  id="convObs" class="form-control" value="{{conv.conv_obs}}"/>
														</div>
													</div>
													<div class="hidden">
														<input name="convId" id="convId" value="{{_id}}" />
													</div>

											</div>
										</div>
									</div><!-- /.tabbable -->
								</div>
								<div class="form-actions">
									<div class="col-xs-12" style="text-align: center;" >
										<button class="btn btn-info" name="acao" type="submit">
											<i class="ace-icon fa fa-check bigger-110"></i>
											Salvar
										</button>
	
										&nbsp; &nbsp; &nbsp;
										<button class="btn btn-warning"  href="/menu/convenio/conv/edi">
											<i class="ace-icon fa fa-undo bigger-110"></i>
											Voltar
										</button>
									</div>
								</div>

							</form>


						</div><!-- /.col -->
					</div><!-- /.row -->




				</div>
			</div><!-- /.main-content -->


		</div><!-- /.main-container -->





		<!-- basic scripts -->

	</body>
</html>
