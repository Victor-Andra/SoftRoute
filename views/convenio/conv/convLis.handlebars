<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista de Convênios</title>

		<meta name="description" content="Static &amp; Dynamic Tables">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
		<style>
        /*Tooltip personalizado */
            .custom-tooltip {
                position: relative;
                display: inline-block;
                cursor: pointer;
            }

            .tooltip-text {
                visibility: hidden;
                width: max-content;
                background-color: #f3dfdf;
                color: red;
                font-size: 8px;
                text-align: left;
                border-radius: 4px;
                padding: 8px 12px;
                position: absolute;
                z-index: 9999;
                bottom: 125%; /* Acima do ícone */
                left: 50%;
                transform: translateX(-50%);
                opacity: 0.9;
                white-space: normal;
                min-width: 150px;
                max-width: 300px;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
                transition: opacity 0.3s;
            }

            .tooltip-text::after {
                content: "";
                position: absolute;
                top: 100%;
                left: 50%;
                margin-left: -5px;
                border-width: 5px;
                border-style: solid;
                border-color: #f3dfdf transparent transparent transparent;
            }

            /* Mostra o tooltip quando o mouse passa sobre o link */
            .custom-tooltip:hover .tooltip-text {
                visibility: visible;
            }
		</style>
		
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Lista de Convênios</li>
							
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<div class="row">
									<div class="col-xs-12">
											<div class="clearfix" >
												<div class="pull-right tableTools-container">


												</div>
											</div>

											<div id="dynamic-table_wrapper" class="dataTables_wrapper form-inline no-footer">
											</div>
											
											<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
												
												<thead>
													<tr role="row">
														<th class="center">
															<label class="pos-rel">
																<input type="checkbox" class="ace" />
																<span class="lbl"></span>
															</label>
														</th>

														<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1">Convênio</th>
														<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1" >CNPJ</th>
														<th class="sorting" tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="1" >Cobrança de Laudo</th>
														<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data da Cobrança de Laudo</th>
														<th class="sorting" tabindex="4" aria-controls="dynamic-table" rowspan="1" colspan="1">Status</th>
														<th>Ação</th>

													</tr>
													
												</thead>
												
												<tbody>
													{{#each convs}}
														<tr role="row" class="odd">

															<th class="center">
																<label class="pos-rel">
																	<input type="checkbox" class="ace" />
																	<span class="lbl"></span>
																</label>
															</th>

														<td>{{conv_nome}}</td>
														<td>{{conv_cnpj}}</td>
														<td>
															{{#ifEqual this.conv_cobralaudo "0 Mês"}}
																<a href="#" data-action="">
																	<i class="ace-icon green fa fa-minus bigger-130"></i>
																</a>
																<span class="badge badge-success">&nbsp;
																	Não
																</span>
															{{else}}
																{{#ifEqual this.conv_cobralaudo "6 Meses"}}
																	<a href="#" data-action="">
																		<i class="ace-icon warning fa fa-time bigger-130"></i>
																	</a>
																	<span class="badge badge-warning">&nbsp;
																		Sim - prazo de 6 Meses
																	</span>
																{{else}}
																	{{#ifEqual this.conv_cobralaudo "12 Meses"}}
																		<a href="#" data-action="">
																			<i class="ace-icon warning fa fa-time bigger-130"></i>
																		</a>
																		<span class="badge badge-warning">&nbsp;
																			Sim - prazo de 12 Meses
																		</span>
																	{{else}}
																	{{/ifEqual}}
																{{/ifEqual}}
															{{/ifEqual}}
														</td>
														<td>{{conv_cobralaudodata}}</td>
														<td>
															{{#ifEqual this.conv_status "Inativo"}}
																<span class="badge badge-danger">{{conv_status}}</span>
															{{else}}
																<span class="badge badge-success">{{conv_status}}</span>															
															{{/ifEqual}}
														</td>

															<td>
																<div class="action-buttons">
																
																	<a class="green" href="/menu/convenio/conv/edi/{{_id}}">
																		<i class="ace-icon fa fa-pencil bigger-130"></i>
																	</a>
																	<a class="red" href="/menu/convenio/conv/del/{{_id}}">
																		<i class="ace-icon fa fa-trash-o bigger-130"></i>
																	</a>
																	<a class="purple custom-tooltip" name="acaoCrud" id="acaoCrud-{{_id}}">
																			<i class="ace-icon fa fa-eye bigger-130"></i>
																			<span class="tooltip-text">
																				<!-- Bloco Última Edição -->
																				<strong>Última Edição:</strong>
																				{{#if dataedi}}
																					<p><b>{{dataedi}}</b></p>
																				{{else}}
																					<p>--/--/----</p>
																				{{/if}}
																				{{#if usuarioEdiNome}}
																					<p>Por: {{usuarioEdiNome}}</p>
																				{{else}}
																					<p>Por: Não informado</p>
																				{{/if}}

																				<!-- Bloco Cadastrado em -->
																				<strong>Cadastrado em:</strong>
																				{{#if datacad}}
																					<p><b>{{datacad}}</b></p>
																				{{else}}
																					<p>--/--/----</p>
																				{{/if}}
																				{{#if usuarioCadNome}}
																					<p>Por: {{usuarioCadNome}}</p>
																				{{else}}
																					<p>Por: Não informado</p>
																				{{/if}}
																			</span>
																		</a>
																	
																</div>
																										
															</td>
												
														</tr>
													{{/each}}
												</tbody>

											</table>

									
										
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->



			<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse display">
				<i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
			</a>
		</div><!-- /.main-container ace-save-state -->

		
		<script type="text/javascript">
			if('ontouchstart' in document.documentElement) document.write("<script src='../../../assets/js/jquery.mobile.custom.min.js'>"+"<"+"/script>");
		</script>
		<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		

		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
			"language": { "url": "/js/lang/datatable-pt-br.json" },
			"aaSorting": [],
			"responsive": true,
			"lengthMenu": [ 200, 300, 500],
			"lengthChange": true,
			"autoWidth": true,
			"paging": true,
			"lengthChange": true,
			"searching": true,
			"ordering": true,
			"info": true,
			
			select: {
						style: 'multi'
					}
			});
		});
		$.fn.dataTable.Buttons.defaults.dom.container.className = 'dt-buttons btn-overlap btn-group btn-overlap';
		</script>
	

	</body>

</html>