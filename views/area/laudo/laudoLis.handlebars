<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista de Laudos</title>
		<style>
			/* Tooltip personalizado */
			.custom-tooltip {
				position: relative; /* Garante que o tooltip seja posicionado em relação a este elemento */
				display: inline-block; /* Permite que o tooltip seja alinhado corretamente */
			}

			.custom-tooltip .tooltip-text {
				display: none; /* Inicialmente oculto e fora do fluxo */
				width: auto; /* Ajusta automaticamente ao conteúdo */
				background-color: rgb(243, 223, 223); /* Fundo escuro para contraste */
				color: red; /* Cor do texto vermelha */
				font-size: 7px; /* Tamanho da fonte pequena */
				text-align: center;
				padding: 2px 5px; /* Espaçamento interno */
				border-radius: 4px; /* Borda arredondada */

				/* Posicionamento do tooltip */
				position: absolute;
				top: -20px; /* Acima do ícone */
				left: 50%; /* Centralizado horizontalmente */
				transform: translateX(-50%); /* Ajuste fino para centralizar */
				z-index: 1; /* Garante que o tooltip fique acima de outros elementos */
				white-space: nowrap; /* Evita que o texto quebre linha */
			}

			/* Mostra o tooltip quando o mouse passa sobre o link */
			.custom-tooltip:hover .tooltip-text {
						display: block; /* Torna o tooltip visível e flutuante */
					}
			@media print and (orientation: landscape) {
				.noprint {
					display: none;
				}
			}
			@media print {
               .noprint {
                  display: none;
               }
            }
			 /* OCULTA O LINK GERADO PELO NAVEGADOR NA IMPRESSÃO */
			@media print {
				a[href]:after {
					content: none !important;
					display: none !important;
				}

				.action-buttons a {
					text-decoration: none !important;
					color: inherit !important;
					background: transparent !important;
				}
			}
			#tabela-customizada {
				border-collapse: separate; /* Permite usar border-spacing */
				border-spacing: 10px 5px; /* Espaçamento menor entre células (horizontal e vertical) */
				border: none; /* Remove borda externa */
				}

				#tabela-customizada th,
				#tabela-customizada td {
				border: none; /* Remove bordas das células */
				padding: 4px; /* Reduz o preenchimento interno para aproximar ainda mais */
				white-space: nowrap; /* Evita quebra de linha no cabeçalho */
				flex-direction: column;
    			align-items: flex-start;
				}
			#dynamic-table th,
			#dynamic-table td {
				font-size: 10px;
			}
			.btn-purple {
				color: #fff;
				background-color: #9D8AC7;
				border-color: #9D8AC7;
			}
			.btn-purple:hover {
				background-color: #8A77B9;
				border-color: #8A77B9;
			}
		</style>
		
		
		
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
						<li class="active">Lista de Laudos</li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<div class="row">
									<div class="col-xs-12">
										<form id="divFormPesquisa" class="form-horizontal" role="form" action="/menu/area/laudo/lisF" method="POST">	
											<p class="alert alert-warning">
												<b>&nbsp;&nbsp;Legenda</b><br> 
												&nbsp;&nbsp;Alguns convênios não exigem a apresentação de laudos dentro de prazos determinados, enquanto outros exigem.<br>
												&nbsp;&nbsp;Nesses casos, os períodos podem variar entre 6 meses ou 1 ano, e essas informações são cadastradas no menu 'Convênio'.<br>
												&nbsp;&nbsp;Segue as informações das cores exibidas nas datas de validade.<br>
												<span class="badge badge-success">Dentro do prazo</span><span class="badge badge-warning">Prazo esgotando, atenção!</span><span class="badge badge-danger">Prazo esgotando, precisa requerer novo laudo! com Urgência!</span><span class="badge badge-purple">Prazo esgotado, possíveis glossas de atendimento!</span>
											</p>
											
											<p class="alert alert-danger">
												
												Por padrão todos os beneficiários Inativos forão ocultados!<br>
												para exibí-los marque a caixa abaixo e clique no botão pesquisar.
											</p>
											
											<table id="tabela-customizada" style="border: 1px solid #ccc; display: inline-block; width:100%">
												<thead>
													<tr>
														<th><span class="badge badge-danger">Exibir Inativos?</span></th>
														<th>
															<div class="input-group">
																<label class="pos-rel">
																	<input type="checkbox" class="ace" id="mostraInativos" name="mostraInativos" {{#if mostraInativos}}checked{{/if}} />
																	<span class="lbl"></span>
																</label>		
															</div>
														</th>
														<th>
															<button name="acaoPesquisar" id="acaoPesquisar" type="submit" class="btn btn-xs btn-info">
																<i class="ace-icon fa fa-search-plus"></i>
																Pesquisar
															</button>
														</th>
														<th>
															<!-- Botões de Filtro por Status com Contador -->
												<div class="row" style="margin: 15px 0; display: flex; flex-wrap: wrap; gap: 8px; align-items: center;">
													<div class="col-xs-12">
														<label style="font-weight: bold; margin-right: 10px;">Filtrar por status:</label>

														<a href="/menu/area/laudo/lis" class="btn btn-xs btn-white btn-bold">
															<i class="ace-icon fa fa-list"></i> Todos <span id="contador-todos" class="badge badge-grey" style="margin-left: 5px;">0</span>
														</a>

														<button type="button" class="btn btn-xs btn-purple btn-bold" onclick="filtrarPorStatus('Expirado')">
															<i class="ace-icon fa fa-clock-o"></i> Expirado <span id="contador-expirado" class="badge badge-white" style="margin-left: 5px;">0</span>
														</button>

														<button type="button" class="btn btn-xs btn-danger btn-bold" onclick="filtrarPorStatus('Urgente')">
															<i class="ace-icon fa fa-warning"></i> Urgente <span id="contador-urgente" class="badge badge-white" style="margin-left: 5px;">0</span>
														</button>

														<button type="button" class="btn btn-xs btn-warning btn-bold" onclick="filtrarPorStatus('Atenção')">
															<i class="ace-icon fa fa-exclamation-triangle"></i> Atenção <span id="contador-atencao" class="badge badge-white" style="margin-left: 5px;">0</span>
														</button>

														<button type="button" class="btn btn-xs btn-success btn-bold" onclick="filtrarPorStatus('Ok')">
															<i class="ace-icon fa fa-check"></i> Ok <span id="contador-ok" class="badge badge-white" style="margin-left: 5px;">0</span>
														</button>

														
													</div>
												</div>
														</th>
													</tr>
												</thead>
											</table>
											
										</form>
									</div>
								</div>
								<div class="row">
									<div class="col-xs-12">
										<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
											
											<thead>
											<tr role="row">
												<th class="center" tabindex="1">
													<label class="pos-rel">
														<input type="checkbox" class="ace" />
														<span class="lbl"></span>
													</label>
												</th>
												<th class="sorting" tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="1" >Beneficiário</th>
												<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Convênio</th>
												<th class="sorting" tabindex="4" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data do Laudo</th>
												<th class="sorting" tabindex="5" aria-controls="dynamic-table" rowspan="1" colspan="1" >Período Validade</th>
												<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data de Validade</th>
												<th class="sorting" tabindex="7" aria-controls="dynamic-table" rowspan="1" colspan="1" >Status</th>
												<th class="sorting" tabindex="8" aria-controls="dynamic-table" rowspan="1" colspan="1" >Médico</th>
												<th class="sorting" tabindex="9" aria-controls="dynamic-table" rowspan="1" colspan="1" >Especialidade</th>
												<th class="sorting" tabindex="10" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data alteração</th>
												<th tabindex="11">Ação</th>
											</tr>
										</thead>
											
											<tbody>
											{{#each laudos}}

												<tr role="row" class="odd">
													<td class="center">
														<label class="pos-rel">
															<input type="checkbox" class="ace" />
															<span class="lbl"></span>
														</label>
													</td>
													<td>
													{{#each ../benes}}
														{{#ifEqual this._id ../laudo_beneid}}
															{{bene_nome}}
														{{/ifEqual}}
													{{/each}}
													</td>
													<td>
													{{#each ../benes}}
														{{#ifEqual this._id ../laudo_beneid}}
															{{#each ../../convs}}
																{{#ifEqual this._id ../bene_convid}}
																	{{conv_nome}}
																{{/ifEqual}}
															{{/each}}
														{{/ifEqual}}
													{{/each}}
													</td>
													<td>{{laudo_dataString}}</td>
													<td>{{laudo_periodoValidade}}</td>
													<td>{{laudo_prazo}}</td>
													<td></td>
													<td>{{laudo_medico}}</td>
													<td>{{laudo_medicoesp}}</td>
													<td>{{#verificarVazioOuIndefinido laudo_dataediString}}
														{{else}}
															{{laudo_dataediString}}
																<a class="orange custom-tooltip" name="acaoVerquemalterou" id="acaoVerquemalterou">
																	<i class="ace-icon fa fa-eye bigger-130"></i>
																	<span class="tooltip-text">
																		
																	{{#each usuarios}}
																		{{#ifEqual this._id ../laudo_usuidedi}}
																			{{usuario_nome}}
																		{{/ifEqual}}
																	{{/each}}
																	
																	</span>
																</a>
														{{/verificarVazioOuIndefinido}}
													</td>
													<td>
														<div class="action-buttons">
															<a class="green" href="/menu/area/laudo/edi/{{_id}}">
																<i class="ace-icon fa fa-pencil bigger-130"></i>
															</a>
															<a class="hidden" class="blue" >
																<i class="ace-icon fa fa-print bigger-130"></i>
															</a>
														</div>
													</td>
												</tr>
											{{/each}}
										</tbody>

										</table>
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

		
		</div><!-- /.main-container ace-save-state -->

		<!-- basic scripts -->

				<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		<!-- inline scripts related to this page -->
		<!-- ÚNICO SCRIPT FINAL - TUDO EM ORDEM -->
<!-- ÚNICO SCRIPT FINAL - TUDO EM ORDEM -->
<script>
// Função principal: aplica cores, status e atualiza contadores
function aplicarCoresPrazo() {
    const linhas = document.querySelectorAll("tbody tr");
    const hoje = new Date();
    hoje.setHours(0, 0, 0, 0); // zerar horas

    const statusPorClasse = {
        "purple": "Expirado",
        "danger": "Urgente",
        "warning": "Atenção",
        "success": "Ok"
    };

    const contadores = { "Expirado": 0, "Urgente": 0, "Atenção": 0, "Ok": 0 };

    linhas.forEach(linha => {
        const celulaPrazo = linha.querySelector("td:nth-child(6)"); // Data de Validade
        const celulaStatus = linha.querySelector("td:nth-child(7)"); // Status

        if (!celulaPrazo || !celulaStatus) return;

        const dataTexto = celulaPrazo.textContent.trim();
        if (!dataTexto) return;

        const [dia, mes, ano] = dataTexto.split("/").map(Number);
        if (isNaN(dia) || isNaN(mes) || isNaN(ano)) return;

        const dataPrazo = new Date(ano, mes - 1, dia);
        dataPrazo.setHours(0, 0, 0, 0);

        const diffMs = dataPrazo - hoje;
        const diffDias = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
        const diffMeses = (dataPrazo.getFullYear() - hoje.getFullYear()) * 12 + (dataPrazo.getMonth() - hoje.getMonth());

        let classeBadge = "success";
        if (diffMs <= 0) classeBadge = "purple";
        else if (diffDias < 30) classeBadge = "danger";
        else if (diffMeses < 2) classeBadge = "warning";

        const nomeStatus = statusPorClasse[classeBadge];
        if (contadores[nomeStatus] !== undefined) {
            contadores[nomeStatus]++;
        }

        // === Atualiza coluna 6: data com badge ===
        const spanData = document.createElement("span");
        spanData.className = `badge badge-${classeBadge}`;
        spanData.textContent = dataTexto;
        celulaPrazo.innerHTML = "";
        celulaPrazo.appendChild(spanData);

        // === Atualiza coluna 7: status com badge ===
        const spanStatus = document.createElement("span");
        spanStatus.className = `badge badge-${classeBadge}`;
        spanStatus.textContent = nomeStatus;
        celulaStatus.innerHTML = "";
        celulaStatus.appendChild(spanStatus);
        celulaStatus.setAttribute("data-status", nomeStatus.toLowerCase());
    });

    // === Atualiza contadores nos botões ===
    $("#contador-expirado").text(contadores["Expirado"]);
    $("#contador-urgente").text(contadores["Urgente"]);
    $("#contador-atencao").text(contadores["Atenção"]);
    $("#contador-ok").text(contadores["Ok"]);
    $("#contador-todos").text(linhas.length);
}

// Variável global para armazenar a instância do DataTable
let tabelaInstancia = null;

// Função para filtrar por status
function filtrarPorStatus(status) {
    if (!tabelaInstancia) {
        console.warn("Tabela ainda não inicializada.");
        return;
    }

    if (status === '') {
        tabelaInstancia.search('').draw(); // Mostra todos
    } else {
        tabelaInstancia.column(6).search(status, false, false).draw(); // Filtro na coluna 7
    }
}

// Função para limpar o filtro (igual a "Todos")
function resetarFiltro() {
    if (!tabelaInstancia) {
        console.warn("Tabela ainda não inicializada.");
        return;
    }
    tabelaInstancia.search('').draw();
}

// Execução principal: tudo em ordem
document.addEventListener("DOMContentLoaded", function () {
    // Primeiro: aplica cores e status
    aplicarCoresPrazo();

    // Depois: inicializa o DataTables e armazena a instância
    tabelaInstancia = $("#dynamic-table").DataTable({
        "language": { "url": "/js/lang/datatable-pt-br.json" },
        "aaSorting": [],
        "aoColumns": [
            { "bSortable": false }, null, null, null, null,
            null, null, null, null, null, { "bSortable": false }
        ],
        "responsive": true,
        "lengthMenu": [100, 200],
        "lengthChange": true,
        "autoWidth": true,
        "paging": true,
        "searching": true,
        "ordering": true,
        "info": true,
        select: { style: 'multi' }
    });

    // Sincroniza contadores ao digitar na busca
    $('#dynamic-table_filter input').on('keyup', function() {
        setTimeout(aplicarCoresPrazo, 150);
    });
});
</script>

	</body>

</html>