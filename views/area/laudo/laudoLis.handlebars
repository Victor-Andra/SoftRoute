<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista de Laudos</title>
		<style>
			/* Tooltip personalizado */
	.custom-tooltip {
		position: relative; /* Garante que o tooltip seja posicionado em relação a este elemento */
		display: inline-block; /* Permite que o tooltip seja alinhado corretamente */
	}

	.custom-tooltip .tooltip-text {
		display: none; /* Inicialmente oculto e fora do fluxo */
		width: auto; /* Ajusta automaticamente ao conteúdo */
		background-color: rgb(243, 223, 223); /* Fundo escuro para contraste */
		color: red; /* Cor do texto vermelha */
		font-size: 7px; /* Tamanho da fonte pequena */
		text-align: center;
		padding: 2px 5px; /* Espaçamento interno */
		border-radius: 4px; /* Borda arredondada */

		/* Posicionamento do tooltip */
		position: absolute;
		top: -20px; /* Acima do ícone */
		left: 50%; /* Centralizado horizontalmente */
		transform: translateX(-50%); /* Ajuste fino para centralizar */
		z-index: 1; /* Garante que o tooltip fique acima de outros elementos */
		white-space: nowrap; /* Evita que o texto quebre linha */
	}

	/* Mostra o tooltip quando o mouse passa sobre o link */
	.custom-tooltip:hover .tooltip-text {
				display: block; /* Torna o tooltip visível e flutuante */
			}
			
		</style>
		<script>
			function aplicarCoresPrazo() {
					// Seleciona todas as linhas da tabela que têm os dados
					const linhas = document.querySelectorAll("tbody tr");

					// Data atual
					const hoje = new Date();
					hoje.setHours(0, 0, 0, 0); // padronizar para comparar apenas datas

					// Itera por cada linha
					linhas.forEach(linha => {
						// Encontra a célula com o prazo (assumindo que é a 6ª <td>)
						const celulaPrazo = linha.querySelector("td:nth-child(6)");

						if (!celulaPrazo) return;

						// Obtém o texto da data
						const dataTexto = celulaPrazo.textContent.trim();
						if (!dataTexto) return;

						// Converte texto para objeto Date
						const [dia, mes, ano] = dataTexto.split("/").map(Number);
						const dataPrazo = new Date(ano, mes - 1, dia); // Mês começa do 0 no JS
						dataPrazo.setHours(0, 0, 0, 0);

						// Calcula diferença em dias
						const diffMs = dataPrazo - hoje;
						const diffDias = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
						const diffMeses = (dataPrazo.getFullYear() - hoje.getFullYear()) * 12 + (dataPrazo.getMonth() - hoje.getMonth());

						let classeBadge = "success"; // padrão: verde

						if (diffMs <= 0) {
							classeBadge = "purple";
						} else if (diffDias < 30) {
							classeBadge = "danger"; // vermelho
						} else if (diffMeses < 2) {
							classeBadge = "warning"; // amarelo
						} else {
							classeBadge = "success"; // verde
						}

						// Cria o span com a classe badge correspondente
						const span = document.createElement("span");
						span.className = `badge badge-${classeBadge}`;
						span.textContent = dataTexto;

						// Substitui o conteúdo da célula
						celulaPrazo.innerHTML = "";
						celulaPrazo.appendChild(span);
					});
				}
			</script>
		
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
						<li class="active">Lista de Laudos</li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<div class="row">
									<div class="col-xs-12">
											
											<p class="alert alert-warning">
												<b>&nbsp;&nbsp;Legenda</b><br> 
												&nbsp;&nbsp;Alguns convênios não exigem a apresentação de laudos dentro de prazos determinados, enquanto outros exigem.<br>
												&nbsp;&nbsp;Nesses casos, os períodos podem variar entre 6 meses ou 1 ano, e essas informações são cadastradas no menu 'Convênio'.<br>
												&nbsp;&nbsp;Segue as informações das cores exibidas nas datas de validade.<br>
												<span class="badge badge-success">Dentro do prazo</span><span class="badge badge-warning">Prazo esgotando, atenção!</span><span class="badge badge-danger">Prazo esgotando, precisa requerer novo laudo! com Urgência!</span><span class="badge badge-purple">Prazo esgotado, possíveis glossas de atendimento!</span>
											</p>
																						
											<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable " role="grid" aria-describedby="dynamic-table_info">
												
												<thead>
												<tr role="row">
													<th class="center" tabindex="1">
														<label class="pos-rel">
															<input type="checkbox" class="ace" />
															<span class="lbl"></span>
														</label>
													</th>
													<th class="sorting" tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="1" >Beneficiário</th>
													<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Convênio</th>
													<th class="sorting" tabindex="4" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data do Laudo</th>
													<th class="sorting" tabindex="5" aria-controls="dynamic-table" rowspan="1" colspan="1" >Período Validade</th>
													<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data de Validade</th>
													<th class="sorting" tabindex="7" aria-controls="dynamic-table" rowspan="1" colspan="1" >Médico</th>
													<th class="sorting" tabindex="8" aria-controls="dynamic-table" rowspan="1" colspan="1" >Especialidade</th>
													<th class="sorting" tabindex="9" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data alteração</th>
													<th tabindex="10">Ação</th>
												</tr>
											</thead>
												
												<tbody>
												{{#each laudos}}

													<tr role="row" class="odd">
														<td class="center">
															<label class="pos-rel">
																<input type="checkbox" class="ace" />
																<span class="lbl"></span>
															</label>
														</td>
														<td>
														{{#each ../benes}}
															{{#ifEqual this._id ../laudo_beneid}}
																{{bene_nome}}
															{{/ifEqual}}
														{{/each}}
														<td>
														{{#each ../benes}}
															{{#ifEqual this._id ../laudo_beneid}}
																{{#each ../../convs}}
																	{{#ifEqual this._id ../bene_convid}}
																		{{conv_nome}}
																	{{/ifEqual}}
																{{/each}}
															{{/ifEqual}}
														{{/each}}
														</td>
														<td>{{laudo_dataString}}</td>
														<td>{{laudo_periodoValidade}}</td>
														<td>{{laudo_prazo}}</td>
														<td>{{laudo_medico}}</td>
														<td>{{laudo_medicoesp}}</td>
														<td>{{#verificarVazioOuIndefinido laudo_dataediString}}
															{{else}}
																{{laudo_dataediString}}
																	<a class="orange custom-tooltip" name="acaoVerquemalterou" id="acaoVerquemalterou">
																		<i class="ace-icon fa fa-eye bigger-130"></i>
																		<span class="tooltip-text">
																			
																		{{#each usuarios}}
																			{{#ifEqual this._id ../laudo_usuidedi}}
																				{{usuario_nome}}
																			{{/ifEqual}}
																		{{/each}}
																		
																		</span>
																	</a>
															{{/verificarVazioOuIndefinido}}
														</td>
														<td>
															<div class="action-buttons">
																<a class="green" href="/menu/area/laudo/edi/{{_id}}">
																	<i class="ace-icon fa fa-pencil bigger-130"></i>
																</a>
																<a class="hidden" class="blue" >
																	<i class="ace-icon fa fa-print bigger-130"></i>
																</a>
																
															</div>
														</td>
													</tr>
												{{/each}}
											</tbody>

											</table>


										
										
										
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

			<div class="footer">
				<div class="footer-inner">
					<div class="footer-content">
						<span class="bigger-120">
							<span class="blue bolder">Soft</span>
							Route
						</span>

						&nbsp; &nbsp;
						<span class="action-buttons">
							<a href="#">
								<i class="ace-icon fa fa-twitter-square light-blue bigger-150"></i>
							</a>

							<a href="#">
								<i class="ace-icon fa fa-facebook-square text-primary bigger-150"></i>
							</a>

		
						</span>
					</div>
				</div>
			</div>

			<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse display">
				<i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
			</a>
		</div><!-- /.main-container ace-save-state -->

		<!-- basic scripts -->

				<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		

		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
			"language": { "url": "/js/lang/datatable-pt-br.json" },
			"aaSorting": [],
			"aoColumns": [{ "bSortable": false }, null, null, null,null, null, null,null,null, { "bSortable": false }],
			"responsive": true,
			"lengthMenu": [ 100, 200],
			"lengthChange": true,
			"autoWidth": true,
			"paging": true,
			"lengthChange": true,
			"searching": true,
			"ordering": true,
			"info": true,
			
			select: {
						style: 'multi'
					}
			});
		});
		//$.fn.dataTable.Buttons.defaults.dom.container.className = 'dt-buttons btn-overlap btn-group btn-overlap';
		</script>
		<script>
			document.addEventListener("DOMContentLoaded", function () {
				aplicarCoresPrazo();
			});
		</script>

	</body>

</html>