<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Aniversariantes do Dia</title>
    <style>
        @media print {
            .noprint {
                display: none;
            }
        }
    </style>
</head>
<body onload="javascript:controlaNave();" class="no-skin">
    <div class="main-container ace-save-state" id="main-container">
        <div class="main-content">
            <div class="main-content-inner noprint">
                <div class="breadcrumbs ace-save-state" id="breadcrumbs" style="display: none">
                    <ul class="breadcrumb">
                        <li>
                            <i class="ace-icon fa fa-home home-icon"></i>
                            <a href="#">Home</a>
                        </li>
                        <li class="active">Aniversariantes do Dia</li>
                    </ul><!-- /.breadcrumb -->
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <!-- PAGE CONTENT BEGINS -->
                    <div class="space-6"></div>
                    <div class="row">
                        <div class="col-sm-6 col-sm-offset-1">
                            <div class="widget-box transparent">
                                <div style="text-align: center;">
                                    <img width="140" height="60" alt="150x150" style="alight: center"
                                        src="/images/gallery/logo_route_centro.png">
                                </div>
                                <div class="widget-header widget-header-large">
                                    <h3 class="widget-title grey lighter">
                                        <i class="ace-icon fa fa-leaf green"></i>
                                        Aniversariantes do Dia
                                    </h3>
                                </div>
                                <div class="widget-body">
                                    <div class="widget-main padding-24">
                                        <div>
                                            {{#if aniversariantesDoDia.length}}
                                                <table class="table table-striped table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th style="width:10%">Dia/Mês</th>
                                                            <th>Nome</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        {{#each aniversariantesDoDia}}
                                                            <tr>
                                                                <td>{{this.diaNascimento}}/{{this.mesNascimento}}</td>
                                                                <td>{{this.usuario_nome}}</td>
                                                            </tr>
                                                        {{/each}}
                                                    </tbody>
                                                </table>
                                            {{else}}
                                                <p>Não há aniversariantes hoje.</p>
                                            {{/if}}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div><!-- PAGE CONTENT ENDS -->
                </div><!-- /.col -->
            </div><!-- /.row -->
        </div><!-- /.main-content -->
    </div><!-- /.main-container --><!-- basic scripts -->
</body>
</html>