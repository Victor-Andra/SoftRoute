<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Configuração de Padrões de Evolução dos Supervisores</title>
		<style>
			/* Tooltip personalizado */
			.custom-tooltip {
				position: relative; /* Garante que o tooltip seja posicionado em relação a este elemento */
				display: inline-block; /* Permite que o tooltip seja alinhado corretamente */
			}

			.custom-tooltip .tooltip-text {
				display: none; /* Inicialmente oculto e fora do fluxo */
				width: auto; /* Ajusta automaticamente ao conteúdo */
				background-color: rgb(243, 223, 223); /* Fundo escuro para contraste */
				color: red; /* Cor do texto vermelha */
				font-size: 7px; /* Tamanho da fonte pequena */
				text-align: center;
				padding: 2px 5px; /* Espaçamento interno */
				border-radius: 4px; /* Borda arredondada */

				/* Posicionamento do tooltip */
				position: absolute;
				top: -20px; /* Acima do ícone */
				left: 50%; /* Centralizado horizontalmente */
				transform: translateX(-50%); /* Ajuste fino para centralizar */
				z-index: 1; /* Garante que o tooltip fique acima de outros elementos */
				white-space: nowrap; /* Evita que o texto quebre linha */
			}

			/* Mostra o tooltip quando o mouse passa sobre o link */
			.custom-tooltip:hover .tooltip-text {
						display: block; /* Torna o tooltip visível e flutuante */
					}
			@media print and (orientation: landscape) {
				.noprint {
					display: none;
				}
			}
			@media print {
               .noprint {
                  display: none;
               }
            }
			 /* OCULTA O LINK GERADO PELO NAVEGADOR NA IMPRESSÃO */
			@media print {
				a[href]:after {
					content: none !important;
					display: none !important;
				}

				.action-buttons a {
					text-decoration: none !important;
					color: inherit !important;
					background: transparent !important;
				}
			}
			#tabela-customizada {
				border-collapse: separate; /* Permite usar border-spacing */
				border-spacing: 10px 5px; /* Espaçamento menor entre células (horizontal e vertical) */
				border: none; /* Remove borda externa */
				}

				#tabela-customizada th,
				#tabela-customizada td {
				border: none; /* Remove bordas das células */
				padding: 4px; /* Reduz o preenchimento interno para aproximar ainda mais */
				white-space: nowrap; /* Evita quebra de linha no cabeçalho */
				flex-direction: column;
    			align-items: flex-start;
				}
			#dynamic-table th,
			#dynamic-table td {
				font-size: 10px;
			}
			.btn-purple {
				color: #fff;
				background-color: #9D8AC7;
				border-color: #9D8AC7;
			}
			.btn-purple:hover {
				background-color: #8A77B9;
				border-color: #8A77B9;
			}
			/* Correção para scroll em dispositivos móveis com DataTables */
			.dataTables_wrapper {
				overflow-x: auto;
				-webkit-overflow-scrolling: touch; /* Suaviza o scroll em iOS */
			}

			/* Garante que o corpo da página possa rolar normalmente */
			body, html {
				height: 100%;
				overflow-x: hidden; /* Evita scroll horizontal da página */
			}
			
			
		</style>
		
		
		
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
						<li class="active">Configuração de Padrões de Evolução dos Supervisores</li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								
								<div class="row">
									<div class="col-xs-12">
									<table id="dynamic-table" class="table table-striped table-bordered table-hover">
										<thead>
											<tr>
											<th class="center" style="width: 20px;">
												<label class="pos-rel">
												<input type="checkbox" class="ace" />
												<span class="lbl"></span>
												</label>
											</th>
											<th>Categoria</th>
											<th>Tipo</th>
											<th>Padrão de Evolução</th>
											<th class="center" style="width: 100px;">Ação&nbsp;&nbsp;&nbsp;&nbsp;
												<a class="blue" href="/menu/area/evolucaoconf/evolucaoconfcad">
													<i class="ace-icon fa fa-plus bigger-130"></i>
												</a>

											</th>
											</tr>
										</thead>
										<tbody>
											{{#each evolucaoconfs}}
											<tr>
												<td class="center" style="width: 20px;">
													<label class="pos-rel">
													<input type="checkbox" class="ace" />
													<span class="lbl"></span>
													</label>
												</td>
												<td>{{evolucaoconf_categoria}}</td>
												<td>{{evolucaoconf_titulo}}</td>
												<td style="max-width: 300px; word-wrap: break-word;">{{evolucaoconf_evolucaopad}}</td>
												<td>
													<div class="action-buttons">
														<a class="green" href="/menu/area/evolucaoconf/edi/{{_id}}">
															<i class="ace-icon fa fa-pencil bigger-130"></i>
														</a>
														<a class="red" href="/menu/area/evolucaoconf/del/{{_id}}" onclick="return confirm('Tem certeza que deseja mover este registro para a lixeira?');">
															<i class="ace-icon fa fa-trash-o bigger-130"></i>
														</a>
														<a class="purple custom-tooltip" name="acaoCrud" id="acaoCrud-{{_id}}">
															<i class="ace-icon fa fa-eye bigger-130"></i>
															<span class="tooltip-text">
																<!-- Bloco Última Edição -->
																<strong>Última Edição:</strong>
																{{#if dataedi}}
																	<p><b>{{dataedi}}</b></p>
																{{else}}
																	<p>--/--/----</p>
																{{/if}}
																{{#if usuarioEdiNome}}
																	<p>Por: {{usuarioEdiNome}}</p>
																{{else}}
																	<p>Por: Não informado</p>
																{{/if}}

																<!-- Bloco Cadastrado em -->
																<strong>Cadastrado em:</strong>
																{{#if datacad}}
																	<p><b>{{datacad}}</b></p>
																{{else}}
																	<p>--/--/----</p>
																{{/if}}
																{{#if usuarioCadNome}}
																	<p>Por: {{usuarioCadNome}}</p>
																{{else}}
																	<p>Por: Não informado</p>
																{{/if}}
															</span>
														</a>
													</div>
												</td>
											</tr>
											{{/each}}
										</tbody>
										</table>	
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

		
		</div><!-- /.main-container ace-save-state -->

		<!-- basic scripts -->

				<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		
		<script>
			document.addEventListener("DOMContentLoaded", function () {
				$("#dynamic-table").DataTable({
					"language": {
						"url": "/js/lang/datatable-pt-br.json"
					},
					"aaSorting": [],
					"columnDefs": [
						{ "orderable": false, "targets": [0, 4] } // desativa ordenação nas colunas de checkbox e ação
					],
					"lengthMenu": [100, 200],
					"lengthChange": true,
					"paging": true,
					"searching": true,
					"ordering": true,
					"info": true,
					"responsive": true,
					"autoWidth": false,
					"select": { style: 'multi' }
				});
			});
			</script>

	</body>

</html>