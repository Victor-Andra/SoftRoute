								<strong>
									<i class="ace-icon fa fa-check"></i>
									{{flash.texto}}
								</strong>
								<button type="button" class="close" onclick="javascript:OcultaMsg()">
									<i class="ace-icon fa fa-times"></i>
								</button>
							</p>
						</div>
						<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-success">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
					{{else}}
						{{#compareString flash.sucesso "false"}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">
								<p>
									<strong>
										<i class="ace-icon fa fa-times"></i>
										{{flash.texto}}
									</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()">
										<i class="ace-icon fa fa-times"></i>
									</button>
								</p>
							</div>
							<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
						{{else}}
						{{/compareString}}
					{{/compareString}}
					<div class="hidden">
						<input id="carregaFiltro" value="{{carregaFiltro.carregaFiltro}}" />
						<input id="bordoTerapeutaFil" value="{{bordoTerapeuta.bordoTerapeuta}}" />
						<input id="bordoBeneficiarioFil" value="{{bordoBeneficiario.bordoBeneficiario}}" />
						<input id="dataFinalFil" value="{{dataFinal.dataFinal}}" />
						<input id="mesBordoFil" value="{{mesBordo.mesBordo}}" />
						<input id="anoBordoFil" value="{{anoBordo.anoBordo}}" />
						<input id="tipoPessoaFil" value="{{tipoPessoa.tipoPessoa}}" />
						<input id="tipoDataFil" value="{{tipoData.tipoData}}" />
						<input id="dataIniFil" value="{{dataIni.dataIni}}" />
						<input id="dataFimFil" value="{{dataFim.dataFim}}" />
						<input id="usuarioAtual" value="{{usuario._id}}" >
						<input id="idsChecked" value="" />
					</div>
					<div class="page-content"><!-- .page-content -->
						<form id="divFormPesquisa" class="form-horizontal" role="form" action="/menu/area/bordo/lisF" method="POST">
							<div class="toolbar-pesquisa noprint">
								<div class="row">
									<!-- 🔹 TIPO DATA -->
									<div class="col-sm-2">
										<div class="input-group">
											<label>Tipo Filtro:&nbsp;</label>
											<select name="tipoData" id="tipoData" class="select2" onchange="trocaFiltroData()">
												<option value="Ano/Mes">Ano/Mês</option>
												<option value="Semana">Semana</option>
												<option value="Dia">Dia</option>
											</select>
										</div>
									</div>

									<!-- 🔹 FILIAL (OCULTO) -->
									<div class="col-sm-2 hidden">
										<div class="input-group">
											<label>Filial:&nbsp;</label>
											<select name="empresaFilial" id="empresaFilial" class="select2">
												<option value="Matriz">Matriz</option>
												<option value="Filial 1">Filial 1</option>
												<option value="Filial 2">Filial 2</option>
												<option value="Filial 3">Filial 3</option>
												<option value="Filial 4">Filial 4</option>
											</select>
										</div>
									</div>

									<!-- 🔹 ANO -->
									<div id="divAnoBordo" class="col-sm-2">
										<div class="input-group">
											<label>Ano:&nbsp;</label>
											<select name="anoBordo" id="anoBordo" class="select2" onchange="formataData();">
												{{#each anos}}
													<option value="{{ano_nome}}">{{ano_nome}}</option>
												{{/each}}
											</select>
										</div>
									</div>

									<!-- 🔹 MÊS -->
									<div id="divMesBordo" class="col-sm-2">
										<div class="input-group">
											<label>Mês:&nbsp;</label>
											<select name="mesBordo" id="mesBordo" class="select2"
												onchange="formataData();">
												<option value="0">Janeiro</option>
												<option value="1">Fevereiro</option>
												<option value="2">Março</option>
												<option value="3">Abril</option>
												<option value="4">Maio</option>
												<option value="5">Junho</option>
												<option value="6">Julho</option>
												<option value="7">Agosto</option>
												<option value="8">Setembro</option>
												<option value="9">Outubro</option>
												<option value="10">Novembro</option>
												<option value="11">Dezembro</option>
											</select>
										</div>
									</div>

									<!-- 🔹 DATA -->
									<div id="divDataFil" class="col-sm-2">
										<div class="input-group">
											<label>Data:&nbsp;</label>
											<input type="date" id="dataFil" name="dataFil"
