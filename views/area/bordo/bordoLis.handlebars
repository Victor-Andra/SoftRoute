									</div>

									<!-- 🔹 TIPO PESSOA -->
									<div class="col-sm-2">
										<div class="input-group">
											<label>Tipo:&nbsp;</label>
											<select name="bordoTipoPessoa" id="bordoTipoPessoa" class="select2" onchange="trocaFilpessoa()">
