																{{bene_nome}}
															{{/ifEqual}}
														{{/each}}
														</td>
														<td>
														{{#each ../terapeutasinas}}<!-- Ok -->
															{{#ifEqual this._id ../bordo_terapeutaid}}
																{{usuario_nome}}
															{{/ifEqual}}
														{{/each}}
														</td>
														<td>
