			function mudaSeausente() {
				let mudaausente = document.getElementById("bordoFrequencia").value;
				
				if (mudaausente == "Ausente") {
					document.getElementById('parte01').style.display = 'none';
					document.getElementById('parte02').style.display = 'none';
					document.getElementById('parte03').style.display = 'none';
				} else {
				document.getElementById('parte01').style.display = 'block';
					document.getElementById('parte02').style.display = 'block';
					document.getElementById('parte03').style.display = 'block';
				}
   			}
			
			function carregaBody(){
			document.getElementById("usuarioAtual").value = document.getElementById(document.getElementById("bordoTerapeutaid").value).value;
			
			const terapeutaIdField = document.getElementById("bordoTerapeutaid");
			const usuarioAtualField = document.getElementById("usuarioAtual");
			
			if(terapeutaIdField?.value && usuarioAtualField) {
				const nomeElement = document.getElementById(terapeutaIdField.value);
				if(nomeElement) {
					usuarioAtualField.value = nomeElement.value;
				}
			}
			
			}
