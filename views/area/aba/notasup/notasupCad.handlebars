			function addTrObs(programas) {
				const table = document.getElementById("tbody_NotasupObs");
				const row = document.createElement("tr");

				// Obter o template Handlebars
				const source = document.getElementById("programas-template").innerHTML;
				const template = Handlebars.compile(source);

				// Gerar o HTML para as opções usando o template
				const optionsHtml = template({ Progtipos: programas });

				row.innerHTML = `
					<td>
						<select name="observacoes[${obsCount}][programa]" class="form-control">
							<option value="766f69643132333435366964">Selecione</option>
							${optionsHtml}
						</select>
					</td>
					<td><input type="text" name="observacoes[${obsCount}][analise]" class="form-control"></td>
					<td><input type="text" name="observacoes[${obsCount}][sugestao]" class="form-control"></td>
					<td><button type="button" onclick="this.closest('tr').remove();">Remover</button></td>
				`;

				table.appendChild(row);
				obsCount++;
				document.getElementById("qtdTrNotasupObs").value = obsCount;
			}

