				document.getElementById("notasupAlvosdominados").value = document.getElementById("notasupAlvosdominadosEdi").value;
				document.getElementById("notasupNotasdicas").value = document.getElementById("notasupNotasdicasEdi").value;
				document.getElementById("notasupNotasprog").value = document.getElementById("notasupNotasprogEdi").value;
				document.getElementById("notasupInfteracoment").value = document.getElementById("notasupInfteracomentEdi").value;
				document.getElementById("notasupInfteraduvid").value = document.getElementById("notasupInfteraduvidEdi").value;
