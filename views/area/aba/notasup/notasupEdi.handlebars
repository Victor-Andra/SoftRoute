				document.getElementById("notasupBenedatanasc").value = document.getElementById("notasupBenedatanasctext").value;
				let datanascformatada = formatDate(document.getElementById("notasupBenedatanasc").value);
				document.getElementById("notasupBeneid").value = document.getElementById("beneid").value;
				let progsBene = document.getElementsByName("progBene");
				let qtd = document.getElementById("qtdTrNotasupObs").value;
				let beneid = document.getElementById("notasupBeneid").value;
				let progOpts = document.getElementsByName("optProgId");

				progOpts.forEach((po)=>{
					let oculta = true;
					progsBene.forEach((b)=>{
						if ((""+b.id+"") == ("prog_"+beneid)){
							//console.log("poid: "+(""+po.id+""));
							//console.log("bvalue: "+(""+b.value+""));
							if((""+po.id+"") == (""+b.value+"")){
								oculta = false;
							}
						}
					})
					if (oculta){
						po.style.display = 'none';
					}
				})
				//Carrega Campos
				document.getElementById("notasupDatanotasup").value = document.getElementById("notasupDatanotasupEdi").value;
				document.getElementById("notasupHoranotasup").value = document.getElementById("notasupHoranotasupEdi").value;
				document.getElementById("notasupTerapeutaid").value = document.getElementById("notasupTerapeutaidEdi").value;
				document.getElementById("notasupBeneid").value = document.getElementById("notasupBeneidEdi").value;
				document.getElementById("notasupBenedatanasc").value = document.getElementById("notasupBenedatanascEdi").value;
				document.getElementById("notasupBeneidade").value = document.getElementById("notasupBeneidadeEdi").value;
				document.getElementById("notasupTiposup").value = document.getElementById("notasupTiposupEdi").value;
				document.getElementById("notasupSupid").value = document.getElementById("notasupSupidEdi").value;
				document.getElementById("notasupTopocomp").value = document.getElementById("notasupTopocompEdi").value;
				document.getElementById("notasupFugaevit").value = document.getElementById("notasupFugaevitEdi").value;
				document.getElementById("notasupAtencao").value = document.getElementById("notasupAtencaoEdi").value;
				document.getElementById("notasupTangivel").value = document.getElementById("notasupTangivelEdi").value;
				document.getElementById("notasupAutomatico").value = document.getElementById("notasupAutomaticoEdi").value;
				document.getElementById("notasupNotanarratfunc").value = document.getElementById("notasupNotanarratfuncEdi").value;
				document.getElementById("notasupAbc").value = document.getElementById("notasupAbcEdi").value;
				document.getElementById("notasupDuracao").value = document.getElementById("notasupDuracaoEdi").value;
				document.getElementById("notasupTaxa").value = document.getElementById("notasupTaxaEdi").value;
				document.getElementById("notasupGravevento").value = document.getElementById("notasupGraveventoEdi").value;
				document.getElementById("notasupProdper").value = document.getElementById("notasupProdperEdi").value;
