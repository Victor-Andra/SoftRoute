<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Gráfico do Programa ABA</title>
	</head>
	<body onload="javascript:controlaNave();" class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="espace">
					</div>
					<div class="page-header">
						<h1>
							Gráfico do Programa ABA
							<small>
								<i class="ace-icon fa fa-angle-double-right"></i>
								Cadastro e Índice Geral Gráfico do Programa ABA
							</small>
						</h1>
					</div><!-- /.page-header -->
					<div class="row">
						<div class="col-xs-12">
							<form class="form-horizontal" role="form" action="" method="POST">
							
								<div class="col-xs-12">
									<div class="widget-box">
										<div class="widget-header">
											<h4 class="widget-title">
												<i class="red ace-icon fa fa-bookmark-o bigger-110"></i>
												
												Cabeçalho</h4>

											<span class="widget-toolbar">

												<a href="#" data-action="reload">
													<i class="ace-icon fa fa-refresh"></i>
												</a>

												<a href="#" data-action="collapse">
													<i class="ace-icon fa fa-chevron-up"></i>
												</a>

											</span>
										</div>

										<div class="widget-body">
											<div class="widget-main">
												<div class="col-xs-12" class="row">
													<div class="alert alert-warning">
														<button type="button" class="close" data-dismiss="alert">
															<i class="ace-icon fa fa-times"></i>
														</button>
														<strong>Observação! </strong>
														Aqui você cadastra informações Gráfico do Programa ABA
														<br>
													</div>
												</div><br>

												<div class="col-xs-12" class="row">
													<div class="col-xs-12 col-sm-2">
														<label for="id-date-picker-1">Programa</label>
														<div class="row">
															<div class="col-sm-4">
																<div class="input-group">
																	<input name="folRegprograma" id="folRegprograma" type="text" />
																</div>
															</div>
														</div>
													</div>
													<div class="col-xs-12 col-sm-2">
														<label for="id-date-picker-1">SET</label>
														<div class="row">
															<div class="col-sm-4">
																<div class="input-group">
																	<input name="folRegset" id="folRegset" type="text" />
																</div>
															</div>
														</div>
													</div>
												</div>
													
												<div class="col-xs-12" class="row">
													<div class="col-xs-12 col-sm-2">
														<label for="id-date-picker-1">Data do Registro</label>
														<div class="row">
															<div class="col-sm-4">
																<div class="input-group">
																	<input name="folRegdatareg" id="folRegdatareg" type="date" onchange="javascript:atualizaData()" />
																</div>
															</div>
														</div>
													</div>
													<div class="col-xs-12 col-sm-2">
														<label for="id-date-picker-1">Data da Acsição</label>
														<div class="row">
															<div class="col-sm-4">
																<div class="input-group">
																	<input name="folRegdataac" id="folRegdataac" type="date" onchange="javascript:atualizaData()" />
																</div>
															</div>
														</div>
													</div>
													<div class="col-xs-12 col-sm-4">
														<label>Beneficiário</label>
														<div class="form-group">
															<div class="col-sm-4">
																<select name="folRegBeneid" id="folRegBeneid" class="select2" data-placeholder="Escolha..." >
																	{{#each Benes}}
																		<option value="{{_id}}">{{bene_nome}}</option>
																	{{/each}}
																</select>
															</div>
														</div>
													</div>												
													<div class="col-xs-12 col-sm-4">
														<label>Técnico Aplicador</label>
														<div class="form-group">
															<div class="col-sm-4">
																<select name="folRegterapeutaid" id="folRegterapeutaid" class="select2" data-placeholder="Escolha..." >
																	{{#each Terapeutas}}
																		<option value="{{_id}}">{{usuario_nome}}</option>
																	{{/each}}
																</select>
															</div>
														</div>
													</div>																								
												</div>

												<label>Observações:</label>
												<div class="form-group">
													<div class="col-sm-12">
														<textarea type="text" name="folRegobs" id="folRegobs" placeholder="" class="form-control" rows="3"  data-iconlibrary="fa">
														</textarea>
													</div>
												</div>

												<div class="row">
													<div class="col-sm-4">
													<table id="dynamic-table" class="table table-striped table-bordered table-hover">
														<thead>
															<h5 class="widget-title bigger lighter">
																<i class="ace-icon fa fa-table"></i>
																Ordem das cores para registro diário do gráfico do programa!
															</h5>
															<tr>
																<th >Cor</th>
																<th >Sigla</th>
																<th >Descrição</th>
															</tr>
														</thead>

														<tbody>
															<tr><!-- 1Reg -->
																<td >
																	<div style="width:4px;height:0;border:5px solid #66ff06;overflow:hidden"></div>
																</td>
																<td>
																	<span class="badge badge-success">I</span>
																</td>
																<td>
																	<span class="badge badge-purple">Sem Observação</span>
																</td>
															</tr>
															<tr><!-- 2Reg -->
																<td >
																	<div style="width:4px;height:0;border:5px solid #ffa806;overflow:hidden"></div>
																</td>
																<td>
																	<span class="badge badge-warning">+d</span>
																</td>
																<td>
																	<span class="badge badge-purple">Sem Observação</span>
																</td>
															</tr>
															<tr><!-- 3Reg -->
																<td >
																	<div style="width:4px;height:0;border:5px solid #fff700;overflow:hidden"></div>
																</td>
																<td>
																	<span class="badge badge-yellow">E</span>
																</td>
																<td>
																	<span class="badge badge-purple">Sem Observação</span>
																</td>
															</tr>
															<tr><!-- 4Reg -->
																<td >
																	<div style="width:4px;height:0;border:5px solid #ee06ff;overflow:hidden"></div>
																</td>
																<td>
																	<span class="badge badge-pink">-d</span>
																</td>
																<td>
																	<span class="badge badge-purple">Sem Observação</span>
																</td>
															</tr>
														</tbody>
													</table>
													</div>
												</div>
											</div>		
										</div>
									</div>
								</div>
							
								
								<div class="col-xs-10">
									<div class="widget-box">
										<div class="widget-header">
											<h4 class="widget-title">
												<i class="red ace-icon fa fa-bookmark-o bigger-110"></i>
												
												Gráfico Diário</h4>

											<span class="widget-toolbar">

												<a href="#" data-action="reload">
													<i class="ace-icon fa fa-refresh"></i>
												</a>

												<a href="#" data-action="collapse">
													<i class="ace-icon fa fa-chevron-up"></i>
												</a>

											</span>
										</div>

										<div class="widget-body">
											<div class="widget-main">
												<table class="table table-sm table-bordered" style="font-size: 9px;" id="dynamic-table" role="grid" aria-describedby="dynamic-table_info">
													<thead>
														<tr role="row">	
															<th tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="3">
																<b>I = </b>
																<span class="label label label-success arrowed">Independente</span>
																
																<b>+d = </b>
																<span class="label label label-danger arrowed">Dica</span>

																<b>E = </b>
																<span class="label label label-danger arrowed">Dica</span>
																
																<b>-d = </b>
																<span class="label label label-danger arrowed">Dica</span>

																<b>- = </b>
																<span class="label label label arrowed">Sem Avaliação</span>
															</th>
															
														</tr>
													</thead>
													<tbody>
														<tr role="row" class="odd">
															
															<td name="dia" rowspan="1" style="width: 40px;">
																<select name="beneStatus" id="beneStatus" class="select2" data-placeholder="Escolha...">
																	<option value="-">-</option>
																	<option value="I">I</option>
																	<option value="+d">+d</option>
																	<option value="E">E</option>
																	<option value="-d">-d</option>
																</select>
															</td>													
															
														</tr>
														<tr role="row" class="odd">
															
															<td name="dia" rowspan="1" style="width: 40px;">
																<select name="beneStatus" id="beneStatus" class="select2" data-placeholder="Escolha...">
																	<option value="-">-</option>
																	<option value="I">I</option>
																	<option value="+d">+d</option>
																	<option value="E">E</option>
																	<option value="-d">-d</option>
																</select>
															</td>													
															
														</tr>
														<tr role="row" class="odd">
															
															<td name="dia" rowspan="1" style="width: 40px;">
																<select name="beneStatus" id="beneStatus" class="select2" data-placeholder="Escolha...">
																	<option value="-">-</option>
																	<option value="I">I</option>
																	<option value="+d">+d</option>
																	<option value="E">E</option>
																	<option value="-d">-d</option>
																</select>
															</td>													
															
														</tr>
														<tr role="row" class="odd">
															
															<td name="dia" rowspan="1" style="width: 40px;">
																<select name="beneStatus" id="beneStatus" class="select2" data-placeholder="Escolha...">
																	<option value="-">-</option>
																	<option value="I">I</option>
																	<option value="+d">+d</option>
																	<option value="E">E</option>
																	<option value="-d">-d</option>
																</select>
															</td>													
															
														</tr>
														<tr role="row" class="odd">
															
															<td name="dia" rowspan="1" style="width: 40px;">
																<select name="beneStatus" id="beneStatus" class="select2" data-placeholder="Escolha...">
																	<option value="-">-</option>
																	<option value="I">I</option>
																	<option value="+d">+d</option>
																	<option value="E">E</option>
																	<option value="-d">-d</option>
																</select>
															</td>													
															
														</tr>
														<tr role="row" class="odd">
															
															<td name="dia" rowspan="1" style="width: 40px;">
																<select name="beneStatus" id="beneStatus" class="select2" data-placeholder="Escolha...">
																	<option value="-">-</option>
																	<option value="I">I</option>
																	<option value="+d">+d</option>
																	<option value="E">E</option>
																	<option value="-d">-d</option>
																</select>
															</td>													
															
														</tr>
														<tr role="row" class="odd">
															
															<td name="dia" rowspan="1" style="width: 40px;">
																<select name="beneStatus" id="beneStatus" class="select2" data-placeholder="Escolha...">
																	<option value="-">-</option>
																	<option value="I">I</option>
																	<option value="+d">+d</option>
																	<option value="E">E</option>
																	<option value="-d">-d</option>
																</select>
															</td>													
															
														</tr>
														<tr role="row" class="odd">
															
															<td name="dia" rowspan="1" style="width: 40px;">
																<select name="beneStatus" id="beneStatus" class="select2" data-placeholder="Escolha...">
																	<option value="-">-</option>
																	<option value="I">I</option>
																	<option value="+d">+d</option>
																	<option value="E">E</option>
																	<option value="-d">-d</option>
																</select>
															</td>													
															
														</tr>
														<tr role="row" class="odd">
															
															<td name="dia" rowspan="1" style="width: 40px;">
																<select name="beneStatus" id="beneStatus" class="select2" data-placeholder="Escolha...">
																	<option value="-">-</option>
																	<option value="I">I</option>
																	<option value="+d">+d</option>
																	<option value="E">E</option>
																	<option value="-d">-d</option>
																</select>
															</td>													
															
														</tr>
													</tbody>
												</table>
											</div>
										</div>		
									</div>
								</div>
								
								<div class="col-xs-12">
									<br>
								</div>
								<div class="row">
									<div class="col-md-offset-3 col-md-12">
										<button class="btn btn-info" name="acao" type="submit">
											<i class="ace-icon fa fa-check bigger-110"></i>
											Salvar
										</button>
										&nbsp; &nbsp; &nbsp;
										<button class="btn btn-warning"  type="reset">
											<i class="ace-icon fa fa-undo bigger-110"></i>
											Voltar
										</button>
									</div>
								</div>
							</form>
						</div>
					</div>
				</div><!-- /.main-container -->
			</div><!-- /.main-content -->
		</div>
	</body>
</html>