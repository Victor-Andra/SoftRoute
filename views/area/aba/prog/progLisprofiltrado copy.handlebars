			<script>
				function initEasySparkline() {
					if (typeof $.fn.sparkline !== "function") return;
					const fixedColors = ['#00FF00', '#FFFF00', '#FFA500', '#FF69B4', '#00FF00', '#FFFF00', '#FFA500', '#FF69B4'];
					$('.sparkline').each(function () {
						const $this = $(this);
						const values = $this.data('values');
						if (!values) return;
						try {
							$this.sparkline('html', {
								tagValuesAttribute: 'data-values',
								type: 'bar',
								barWidth: 8,
								height: '30px',
								chartRangeMin: 0,
								colorMap: fixedColors.slice(0, values.split(',').length),
								barColor: null 
							});
						} catch (error) { console.error("Erro Sparkline:", error); }
					});
				}
				
				function initEasyPieCharts() {
					$('.easy-pie-chart').each(function() {
						var $this = $(this);
						var startDate = $this.data('start');
						var endDate = $this.data('end');
						var percent = calculatePercent(startDate, endDate);
						var barColor = percent <= 50 ? 'green' : percent <= 75 ? 'orange' : 'red';
						$this.easyPieChart({ barColor: barColor, trackColor: '#f2f2f2', scaleColor: false, lineWidth: 8, size: 46, animate: 1000 });
						$this.data('easyPieChart').update(percent);
						$this.find('.percent').text(percent);
					});
				}

				function calculatePercent(startDate, endDate) {
					const currentDate = new Date();
					const start = new Date(startDate);
					const end = new Date(endDate);
					if (start >= currentDate) return 0;
					const totalDuration = (end - start) / (1000 * 60 * 60 * 24);
					const elapsedDuration = (currentDate - start) / (1000 * 60 * 60 * 24);
					if (elapsedDuration >= totalDuration) return 100;
					return Math.round((elapsedDuration / totalDuration) * 100);
				}

				function carregaBody(){
					initEasyPieCharts();
					initEasySparkline();
				}

				function formatDate(date) {
					let d = new Date(date);
					return `${d.getFullYear()}/${(d.getMonth() + 1).toString().padStart(2, '0')}/${d.getDate().toString().padStart(2, '0')}`;
				}

				window.addEventListener('DOMContentLoaded', (event) => {
					document.getElementById('dataAtual').textContent = formatDate(new Date());
				});
			</script>
	</head>
