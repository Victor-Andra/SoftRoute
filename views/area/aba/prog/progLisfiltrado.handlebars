		<script>
			function initEasySparkline() {
				console.log("Iniciando Sparkline");
				if (typeof $.fn.sparkline !== "function") {
					console.error("Biblioteca Sparkline não carregada.");
					return;
				}
				const fixedColors = [
					'#00FF00', // Verde
					'#FFFF00', // Amarelo
					'#FFA500', // Laranja
					'#FF69B4',  // Rosa
					'#00FF00', // Verde
					'#FFFF00', // Amarelo
					'#FFA500', // Laranja
					'#FF69B4',  // Rosa
				];
				$('.sparkline').each(function () {
					const $this = $(this);
					const values = $this.data('values');
					if (!values) {
						console.error("Atributo data-values não definido ou vazio:", $this);
						return;
					}
					try {
						$this.sparkline('html', {
							tagValuesAttribute: 'data-values',
							type: 'bar',
							barWidth: 8,
							height: '30px',
							chartRangeMin: 0,
							colorMap: fixedColors.slice(0, values.split(',').length), // Seleciona cores com base na quantidade de barras
							barColor: null // Evita sobrescrever o colorMap com uma cor única
						});
						console.log("Sparkline desenhado com cores fixas no elemento:", $this);
					} catch (error) {
						console.error("Erro ao desenhar Sparkline:", error);
					}
				});
			}
		</script>
		<script>
			function initEasyPieCharts() {
				// Seleciona todos os elementos com a classe easy-pie-chart
				$('.easy-pie-chart').each(function() {
					var $this = $(this);
					var startDate = $this.data('start');
					var endDate = $this.data('end');
					var percent = calculatePercent(startDate, endDate);
					// Determina a cor do gráfico com base na porcentagem
					var barColor;
					if (percent <= 50) {
						barColor = 'green';
					} else if (percent <= 75) {
						barColor = 'orange';
					} else {
						barColor = 'red';
					}
					// Inicializa o EasyPieChart
					$this.easyPieChart({
						barColor: barColor, // Cor do gráfico
						trackColor: '#f2f2f2', // Cor de fundo
						scaleColor: false,
						lineWidth: 8, // Largura da linha do gráfico
						size: 46, // Tamanho do gráfico
						animate: 1000 // Duração da animação
					});
					// Atualiza o valor percentual do gráfico
					$this.data('easyPieChart').update(percent);
					$this.find('.percent').text(percent); // Atualiza o texto da porcentagem
				});
			}
			function calculatePercent(startDate, endDate) {
				const currentDate = new Date();
				const start = new Date(startDate);
				const end = new Date(endDate);
				// Se a data inicial for superior ou igual à data atual, retorna 0%
				if (start >= currentDate) {
					return 0;
				}
				const totalDuration = (end - start) / (1000 * 60 * 60 * 24); // Duração total em dias
				const elapsedDuration = (currentDate - start) / (1000 * 60 * 60 * 24); // Duração passada em dias
				if (elapsedDuration >= totalDuration) {
					return 100; // Se a duração passada é maior ou igual à duração total, retorna 100%
				}
				const percent = (elapsedDuration / totalDuration) * 100;
				return Math.round(percent); // Arredonda a porcentagem para o valor inteiro mais próximo
			}
			$(document).ready(function() {
				// Inicializar os gráficos
				initEasyPieCharts();
			});
			function carregaBody(){
				console.log("Função carregaBody iniciada"); // Log para verificar
				// Inicializar os gráficos
				initEasyPieCharts();
				initEasySparkline();
			}
			function confirmeDeletar(id){
				let confirmado = confirm("Quer mesmo deletar essa Exceção?");
				if(confirmado == true){
					window.location.href=("/menu/beneficiario/excecao/del/"+id);
				}
			}
			// Função para formatar a data no formato desejado
			function formatDate(date) {
				let d = new Date(date);
				let year = d.getFullYear();
				let month = (d.getMonth() + 1).toString().padStart(2, '0');
				let day = d.getDate().toString().padStart(2, '0');
				return `${year}/${month}/${day}`;
			}
			// Função para definir a data formatada no span
			function setFormattedDate() {
				let dataAtual = new Date();
				let dataFormatada = formatDate(dataAtual);
				document.getElementById('dataAtual').textContent = dataFormatada;
			}
			// Executa a função setFormattedDate após o carregamento da página
			window.addEventListener('DOMContentLoaded', (event) => {
				setFormattedDate();
			});
		</script>
	</head>
