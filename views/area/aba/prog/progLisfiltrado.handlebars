		function activateBootstrapTabs() {
			$('#myTab a[data-toggle="tab"]').off('click.bs.tab').on('click.bs.tab', function(e) {
				e.preventDefault();
				$(this).tab('show');
			});
			if ($('#myTab .active').length === 0) $('#myTab a:first').tab('show');
		}


		$(document).ready(function() {
