			document.addEventListener('DOMContentLoaded', () => {
				// Seleciona todos os contêineres que possuem o texto
				document.querySelectorAll('[id^="prog-dicatipo-container-"]').forEach(container => {
					const progDicaTipoText = container.textContent.trim(); // Pega o texto do contêiner

