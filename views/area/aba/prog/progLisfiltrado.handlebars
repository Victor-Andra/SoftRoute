				height: 30px;  /* Ajuste conforme necessário */
				display: flex;
				align-items: center;
				justify-content: center;
				height: 100%; /* Garante que o contêiner ocupe toda a altura do botão */
			}
			.btn-wider {
				display: flex; /* Ativa o Flexbox */
				align-items: center; /* Centraliza verticalmente */
				justify-content: center; /* Centraliza horizontalmente */
				padding: 5px 10px; /* Espaçamento interno para o botão */
				width: auto; /* Largura automática para acomodar o conteúdo */
				min-width: 100px; /* Largura mínima para evitar botões muito pequenos */
			}
			.statusfol {
				display: inline-block;
				width: 100px;  /* Ajuste conforme necessário */
				height: 30px;  /* Ajuste conforme necessário */
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 9px;
			}
		</style>
