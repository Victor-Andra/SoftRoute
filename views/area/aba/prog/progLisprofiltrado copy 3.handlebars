			$(document).ready(function() {
				$("#dynamic-table1").DataTable({
					"language": { "url": "/js/lang/datatable-pt-br.json" },
					"aaSorting": [],
					"aoColumns": [{ "bSortable": false }],
					"responsive": true,
					"paging": false,
					"searching": false,
					"info": false
				});
			});
			
			document.addEventListener('DOMContentLoaded', () => {
				document.querySelectorAll('[id^="prog-dicatipo-container-"]').forEach(container => {
					const progDicaTipoText = container.textContent.trim();
					container.innerHTML = '';
					const partes = progDicaTipoText.split(',').map(parte => parte.trim());
					partes.forEach(parte => {
						const span = document.createElement('span');
						span.className = 'label label-danger arrowed-right';
						span.innerHTML = `&nbsp;${parte}`;
						container.appendChild(span);
						container.appendChild(document.createTextNode(' '));
					});
				});
			});
		</script>
		
	</body>
</html>