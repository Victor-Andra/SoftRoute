<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta charset="utf-8">
    <title>Localizar Programas por Tipo</title>
    <meta name="description" content="Static &amp; Dynamic Tables">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    
    <style>
        /* ============================================
          SELECT2 - ESTILOS GERAIS
          ============================================ */
        .select2-container { 
            min-width: 120px !important; 
        }
        .select2-container--default .select2-selection--single {
            height: 30px !important; 
            border: 1px solid #ced4da !important;
            border-radius: 4px !important; 
            background: white !important;
            display: flex !important; 
            align-items: center !important;
            padding: 0 8px !important; 
            font-size: 12px !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 28px !important; 
            right: 5px !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 28px !important; 
            padding-left: 0 !important; 
            color: #333 !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__placeholder {
            color: #999 !important;
        }
        .select2-dropdown {
            border: 1px solid #ced4da !important; 
            border-radius: 4px !important;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1) !important;
        }
        .select2-container--default .select2-search--dropdown .select2-search__field {
            border: 1px solid #ced4da !important; 
            border-radius: 4px !important;
            padding: 4px 8px !important; 
            font-size: 12px !important; 
            margin: 4px !important;
        }
        .select2-container--default .select2-results__option {
            padding: 6px 10px !important; 
            font-size: 12px !important;
        }
        .select2-container--default .select2-results__option--highlighted[aria-selected] {
            background-color: #2196f3 !important; 
            color: white !important;
        }
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #2196f3 !important;
            box-shadow: 0 0 0 2px rgba(33,150,243,0.2) !important;
        }

        /* Largura específica para os selects */
        #pesquisaProgtipoId + .select2-container,
        #pesquisaStatus + .select2-container {
            width: 100% !important;
        }

        /* Responsivo */
        @media (max-width: 768px) {
            .select2-container { 
                width: 100% !important; 
            }
        }
    </style>
</head>

	<body onload="controlaNave();carregaBody();" class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					{{#compareString flash.sucesso "true"}}
						<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-success">
							<p><strong><i class="ace-icon fa fa-check"></i> {{flash.texto}}</strong>
								<button type="button" class="close" onclick="javascript:OcultaMsg()"><i class="ace-icon fa fa-times"></i></button>
							</p>
						</div>
					{{else}}
						{{#compareString flash.sucesso "false"}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">
								<p><strong><i class="ace-icon fa fa-times"></i> {{flash.texto}}</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()"><i class="ace-icon fa fa-times"></i></button>
								</p>
							</div>
						{{else}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-warning">
								<p><strong><i class="ace-icon fa fa-check"></i> {{flash.texto}}</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()"><i class="ace-icon fa fa-times"></i></button>
								</p>
							</div>
						{{/compareString}}
					{{/compareString}}
					
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li><i class="ace-icon fa fa-home home-icon"></i><a href="#">Home</a></li>
							<li class="active">Localizar Programas por Tipo</li>
						</ul>
					</div>
					
					<div hidden id="divCarrega">
						{{#each usuarios}}
							<span id="{{_id}}_span" class="tag">{{usuario_nome}}</span>
						{{/each}}
					</div>
					
					{{#each error}}
					<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{/each}}
					
					<div class="page-content">
						<div class="row">
							<div class="col-xs-12 col-sm-12">
								<form id="formEnv" action="" method="GET">
									<div hidden>
										<input type="text" id="DataAgora" name="DataAgora" />
										<input type="text" id="usuIdEnv" name="usuIdEnv" value="" />
									</div>
									
									<div class="col-xs-12">
										<div class="alert alert-warning">
											<strong>Localize Programas pelo Tipo</strong><br />
											Escolha o Tipo do Programa para listar os programas associados a ele.
										</div>
									</div>
									
									<div class="row justify-content-center"> 
										<!-- Tipo do Programa -->
										<div class="col-xs-12 col-sm-4 mb-3 px-2">
											<label for="pesquisaProgtipoId" class="block mb-1">Escolha o Tipo do Programa</label>
											<select name="pesquisaProgtipoId" id="pesquisaProgtipoId" class="select2">
												<option value="766f69643132333435366964">-</option>
												{{#each progtipos}}
													<option value="{{_id}}">{{nome}}</option>
												{{/each}}
											</select>
										</div>

										<!-- Botão Pesquisar -->
										<div class="col-xs-12 col-sm-4 mb-3 px-2 text-center">
											<div class="mb-1">
												<span class="label label-sm label-info">Listar Programas Ativos / Em Andamento</span>
											</div>
											<button name="acaoPesquisarF" id="acaoPesquisarF" type="submit" class="btn btn-xs btn-info btn-block">
												<i class="ace-icon fa fa-search-plus"></i> Localizar Programas
											</button>
										</div>

										<!-- Botão Manutenção -->
										<div class="col-xs-12 col-sm-4 mb-3 px-2 text-center">
											<div class="mb-1">
												<span class="label label-sm label-warning">Listar Programas em Manutenção</span>
											</div>
											<button name="acaoPesquisarM" id="acaoPesquisarM" type="button" class="btn btn-xs btn-danger btn-block">
												<i class="ace-icon fa fa-search-plus"></i> Localizar em Manutenção
											</button>
										</div>
									</div>
									<hr class="mt-2 mb-3">
								</form>

								<!-- Tabela de Instrução -->
								<table id="dynamic-table1" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid">
									<thead>
										<tr role="row">
											<th class="sorting" tabindex="0" rowspan="1" colspan="1">Filtro por Tipo</th>
										</tr>
									</thead>
									<tbody>
										<tr>
											<td>
												<label>Selecione o Tipo do Programa acima e clique no botão "Localizar" para carregar a lista.</label>
											</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		<script>
			// Lógica para o botão Localizar (Submit)
			document.getElementById('formEnv').addEventListener('submit', function (event) {
				const select = document.getElementById('pesquisaProgtipoId');
				const selectedId = select.value;

				if (!selectedId || selectedId === "766f69643132333435366964") {
					alert('Por favor, selecione um tipo de programa válido.');
					event.preventDefault();
					return;
				}

				// ✅ APONTA PARA A NOVA ROTA DE TIPO
				this.action = `/menu/area/aba/prog/proglisproTipo/${selectedId}`;
			});

			// Lógica para o botão Manutenção (Click)
			document.getElementById('acaoPesquisarM').addEventListener('click', function () {
				const select = document.getElementById('pesquisaProgtipoId');
				const selectedId = select.value;

				if (!selectedId || selectedId === "766f69643132333435366964") {
					alert('Por favor, selecione um tipo de programa válido.');
					return;
				}

				const form = document.getElementById('formEnv');
				// ✅ APONTA PARA A NOVA ROTA E INJETA O STATUS MANUTENÇÃO NA URL
				form.action = `/menu/area/aba/prog/proglisproTipo/${selectedId}?status=Manutenção`;
				form.submit(); 
			});
		</script>
	</body>
</html>