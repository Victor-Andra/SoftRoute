<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Localizar Container ABA</title>

		<meta name="description" content="Static &amp; Dynamic Tables">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">

		<script>//Filtro para localizar
				
				function carregaBody(){
					
				}
		</script>
		
	</head>

	<body onload="controlaNave();carregaBody();" class="no-skin" class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					{{#compareString flash.sucesso "true"}}
						<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-success">
							<p>
								<strong>
									<i class="ace-icon fa fa-check"></i>
									{{flash.texto}}
								</strong>
								<button type="button" class="close" onclick="javascript:OcultaMsg()">
									<i class="ace-icon fa fa-times"></i>
								</button>
							</p>
						</div>
						<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-success">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
					{{else}}
						{{#compareString flash.sucesso "false"}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">
								<p>
									<strong>
										<i class="ace-icon fa fa-times"></i>
										{{flash.texto}}
									</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()">
										<i class="ace-icon fa fa-times"></i>
									</button>
								</p>
							</div>
							<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
						{{else}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-warning">
								<p>
									<strong>
										<i class="ace-icon fa fa-check"></i>
										{{flash.texto}}
									</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()">
										<i class="ace-icon fa fa-times"></i>
									</button>
								</p>
							</div>
							<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
						{{/compareString}}
					{{/compareString}}
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Localizar container ABA</li>
						</ul><!-- /.breadcrumb -->
					</div>
					<div hidden id="divCarrega">
						{{#each usuarios}}
							<span id="{{_id}}_span" class="tag">{{usuario_nome}}</span>
						{{/each}}
					</div>
					{{#each error}}
					<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<div class="row"><!--.row -->
							<div class="col-xs-12 col-sm-12">
								<form id="formEnv" action="" method="GET">
									<div hidden>
										<input type="text" id="DataAgora" name="DataAgora" />
										<!--.dados do beneficiário -->
										<input type="text" id="progsetBeneidEnv" name="progsetBeneidEnv" value="{{prog.prog_beneid}}" />
										<!--.dados do programa ABA -->
										<input type="text" id="progProgidEnv" name="progProgidEnv" value="{{prog.prog_progid}}" />
										<input type="text" id="progProgtipoidEnv" name="progProgtipoidEnv" value="{{prog.prog_progtipoid}}" />
										<input type="text" id="progPrognivelidEnv" name="progPrognivelidEnv" value="{{prog.prog_prognivelid}}" />
										<!--.dados do SET -->
										<input type="text" id="progsetProgidEnv" name="progsetProgidEnv" value="{{progset._id}}" />
										<input type="text" id="progsetNumEnv" name="progsetNumEnv" value="{{progset.progset_num}}" />
										<!--.dados do Usuário Logado -->
										<input type="text" id="usuIdEnv" name="usuIdEnv" value="" />
									</div>
									<div class="col-xs-12">
										<div class="alert alert-warning">
											<strong>Localize o Container do Beneficiário</strong><br />
											Escolha o Beneficiário para localizar o container para trabalhar com o ABA
											<br />
										</div>
									</div>
								<div class="row justify-content-center"> <!-- Centraliza os blocos -->
								<!-- Beneficiário -->
								<div class="col-xs-12 col-sm-4 mb-3 px-2">
									<label for="pesquisaBeneid" class="block mb-1">Escolha o Beneficiário</label>
									<select name="pesquisaBeneid" id="pesquisaBeneid" class="select2">
										<option value="766f69643132333435366964">-</option>
										{{#each benes}}
											<option value="{{_id}}">{{bene_nome}}</option>
										{{/each}}
									</select>
								</div>

								<!-- ABA em Andamento -->
								<div class="col-xs-12 col-sm-4 mb-3 px-2 text-center">
									<div class="mb-1">
									<span class="label label-sm label-warning">ABA em Andamento, Iniciados, Pausados</span>
									</div>
									<button
									name="acaoPesquisarF"
									id="acaoPesquisarF"
									type="submit"
									class="btn btn-xs btn-info btn-block"
									>
									<i class="ace-icon fa fa-search-plus"></i>
									Localizar Container
									</button>
								</div>

								<!-- ABA em Manutenção -->
								<div class="col-xs-12 col-sm-4 mb-3 px-2 text-center">
									<div class="mb-1">
									<span class="label label-sm label-warning">ABA em Manutenção</span>
									</div>
									<button
									name="acaoPesquisarM"
									id="acaoPesquisarM"
									type="button"
									class="btn btn-xs btn-danger btn-block"
									>
									<i class="ace-icon fa fa-search-plus"></i>
									Localizar Container em Manutenção
									</button>
								</div>
								</div>

								<hr class="mt-2 mb-3">
									
								</form>



								<!-- PAGE CONTENT BEGINS -->
								<table id="dynamic-table1" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
									<thead>
										<tr role="row">
											<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1" >Beneficiário</th>
										</tr>
									</thead>
									<tbody>
										<tr>
											<td>
												<label>Escolha o Beneficiário e clique no botão Localizar para buscar o container do Beneficiário.</label>
											</td>
										</tr>
										 
									</tbody>
								</table>
								
							</div>
						</div>
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->
		</div><!-- /.main-container ace-save-state --><!-- basic scripts --><!--[if !IE]> -->
		<script type="text/javascript">
			if('ontouchstart' in document.documentElement) document.write("<script src='../../../assets/js/jquery.mobile.custom.min.js'>"+"<"+"/script>");
		</script>
		<!-- basic scripts -->
		<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		<!-- inline scripts related to this page -->
		
		<script type="text/javascript">
			$(document).ready(function() {
				$("#dynamic-table1").DataTable({
				"language": { "url": "/js/lang/datatable-pt-br.json" },
				"aaSorting": [],
				"aoColumns": [{ "bSortable": false }],
				"responsive": true,
				"lengthMenu": [ 100, 200],
				"lengthChange": true,
				"autoWidth": false,
				"paging": true,
				"lengthChange": true,
				"searching": true,
				"ordering": true,
				"info": true,
				select: {
							style: 'multi'
						}
				});
			});
		</script>
		<script>
			document.getElementById('formEnv').addEventListener('submit', function (event) {
				// Impede o envio padrão do formulário se a URL não estiver configurada corretamente.
				const select = document.getElementById('pesquisaBeneid');
				const selectedId = select.value;

				if (!selectedId || selectedId === "766f69643132333435366964") {
					alert('Por favor, selecione um beneficiário válido.');
					event.preventDefault();
					return;
				}

				// Altere o "action" do formulário dinamicamente com o ID selecionado.
				this.action = `/menu/area/aba/prog/proglisF/${selectedId}`;
			});

			document.getElementById('acaoPesquisarM').addEventListener('click', function () {
				// Busca o ID selecionado no select
				const select = document.getElementById('pesquisaBeneid');
				const selectedId = select.value;

				if (!selectedId || selectedId === "766f69643132333435366964") {
					alert('Por favor, selecione um beneficiário válido.');
					return;
				}

				// Redireciona para o novo formulário
				const form = document.getElementById('formEnv');
				form.action = `/menu/area/aba/prog/proglisM/${selectedId}`;
				form.submit(); // Submete o formulário manualmente
			});
		</script>
		
	</body>

</html>