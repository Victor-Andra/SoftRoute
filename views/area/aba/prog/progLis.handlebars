<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta charset="utf-8">
    <title>Localizar Container ABA</title>
    <meta name="description" content="Static &amp; Dynamic Tables">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    
    <style>
        /* ============================================
          SELECT2 - ESTILOS GERAIS
          ============================================ */
        .select2-container { 
            min-width: 100% !important; 
        }
        .select2-container--default .select2-selection--single {
            height: 30px !important; 
            border: 1px solid #ced4da !important;
            border-radius: 4px !important; 
            background: white !important;
            display: flex !important; 
            align-items: center !important;
            padding: 0 8px !important; 
            font-size: 12px !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 28px !important; 
            right: 5px !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 28px !important; 
            padding-left: 0 !important; 
            color: #333 !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__placeholder {
            color: #999 !important;
        }
        .select2-dropdown {
            border: 1px solid #ced4da !important; 
            border-radius: 4px !important;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1) !important;
        }
        .select2-container--default .select2-search--dropdown .select2-search__field {
            border: 1px solid #ced4da !important; 
            border-radius: 4px !important;
            padding: 4px 8px !important; 
            font-size: 12px !important; 
            margin: 4px !important;
        }
        .select2-container--default .select2-results__option {
            padding: 6px 10px !important; 
            font-size: 12px !important;
        }
        .select2-container--default .select2-results__option--highlighted[aria-selected] {
            background-color: #2196f3 !important; 
            color: white !important;
        }
        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #2196f3 !important;
            box-shadow: 0 0 0 2px rgba(33,150,243,0.2) !important;
        }

        /* Ajuste para botões ficarem na mesma altura dos selects */
        .btn-alinhado {
            margin-top: 24px !important; /* Compensa a altura do label + select */
        }
    </style>
</head>

<body onload="controlaNave();" class="no-skin">
    <div class="main-container ace-save-state" id="main-container">
        <div class="main-content">
            <div class="main-content-inner">
                {{#compareString flash.sucesso "true"}}
                    <div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-success">
                        <p>
                            <strong><i class="ace-icon fa fa-check"></i> {{flash.texto}}</strong>
                            <button type="button" class="close" onclick="javascript:OcultaMsg()"><i class="ace-icon fa fa-times"></i></button>
                        </p>
                    </div>
                {{else}}
                    {{#compareString flash.sucesso "false"}}
                        <div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">
                            <p>
                                <strong><i class="ace-icon fa fa-times"></i> {{flash.texto}}</strong>
                                <button type="button" class="close" onclick="javascript:OcultaMsg()"><i class="ace-icon fa fa-times"></i></button>
                            </p>
                        </div>
                    {{else}}
                        <div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-warning">
                            <p>
                                <strong><i class="ace-icon fa fa-check"></i> {{flash.texto}}</strong>
                                <button type="button" class="close" onclick="javascript:OcultaMsg()"><i class="ace-icon fa fa-times"></i></button>
                            </p>
                        </div>
                    {{/compareString}}
                {{/compareString}}
                
                <div class="breadcrumbs ace-save-state" id="breadcrumbs">
                    <ul class="breadcrumb">
                        <li><i class="ace-icon fa fa-home home-icon"></i><a href="#">Home</a></li>
                        <li class="active">Localizar container ABA</li>
                    </ul>
                </div>

                <div hidden id="divCarrega">
                    {{#each usuarios}}
                        <span id="{{_id}}_span" class="tag">{{usuario_nome}}</span>
                    {{/each}}
                </div>

                {{#each error}}
                    <div class="alert alert-danger">{{texto}}{{error}}</div>
                {{/each}}

                <div class="page-content">
                    <div class="row">
                        <div class="col-xs-12 col-sm-12">
                            <form id="formEnv" action="" method="GET">
                                <div hidden>
                                    <input type="text" id="DataAgora" name="DataAgora" />
                                    <input type="text" id="progsetBeneidEnv" name="progsetBeneidEnv" value="{{prog.prog_beneid}}" />
                                    <input type="text" id="progProgidEnv" name="progProgidEnv" value="{{prog.prog_progid}}" />
                                    <input type="text" id="progProgtipoidEnv" name="progProgtipoidEnv" value="{{prog.prog_progtipoid}}" />
                                    <input type="text" id="progPrognivelidEnv" name="progPrognivelidEnv" value="{{prog.prog_prognivelid}}" />
                                    <input type="text" id="progsetProgidEnv" name="progsetProgidEnv" value="{{progset._id}}" />
                                    <input type="text" id="progsetNumEnv" name="progsetNumEnv" value="{{progset.progset_num}}" />
                                    <input type="text" id="usuIdEnv" name="usuIdEnv" value="" />
                                </div>
                                
                                <div class="col-xs-12">
                                    <div class="alert alert-warning">
                                        <strong>Localize o Container do Beneficiário</strong><br />
                                        Escolha o Beneficiário para localizar o container para trabalhar com o ABA
                                    </div>
                                </div>

                                <!-- LINHA ÚNICA DE FILTROS E BOTÕES (Soma 12 colunas no md) -->
                                <div class="row mb-2">
                                    <!-- 1. Filtro Beneficiário (3 colunas) -->
                                    <div class="col-xs-12 col-sm-4 col-md-3 mb-2">
                                        <label for="pesquisaBeneid" class="block mb-1">Beneficiário</label>
                                        <select name="pesquisaBeneid" id="pesquisaBeneid" class="select2">
                                            <option value="766f69643132333435366964">-</option>
                                            {{#each benes}}
                                                <option value="{{_id}}">{{bene_nome}}</option>
                                            {{/each}}
                                        </select>
                                    </div>

                                    <!-- 2. Filtro Programa (3 colunas) -->
                                    <div class="col-xs-12 col-sm-4 col-md-3 mb-2">
                                        <label for="progTipoId" class="block mb-1">Programa</label>
                                        <select name="progTipoId" id="progTipoId" class="select2" >
                                            <option value="todos">Todos</option>
                                        </select>
                                    </div>

                                    <!-- 3. Filtro Status (2 colunas) -->
                                    <div class="col-xs-12 col-sm-4 col-md-2 mb-2">
                                        <label for="status" class="block mb-1">Status</label>
                                        <select name="status" id="status" class="select2">
                                            <option value="todos">Todos</option>
                                            <option value="Aguardando">Aguardando</option>
                                            <option value="Inicio">Início</option>
                                            <option value="Andamento">Andamento</option>
                                            <option value="Pausado">Pausado</option>
                                        </select>
                                    </div>

                                    <!-- 4. Botão Pesquisar F (2 colunas) -->
                                    <div class="col-xs-12 col-sm-6 col-md-2 mb-2">
                                        <button name="acaoPesquisarF" id="acaoPesquisarF" type="submit" class="btn btn-info btn-block btn-alinhado">
                                            <i class="ace-icon fa fa-search-plus"></i> Localizar
                                        </button>
                                    </div>

                                    <!-- 5. Botão Pesquisar M (2 colunas) -->
                                    <div class="col-xs-12 col-sm-6 col-md-2 mb-2">
                                        <button name="acaoPesquisarM" id="acaoPesquisarM" type="button" class="btn btn-danger btn-block btn-alinhado">
                                            <i class="ace-icon fa fa-wrench"></i> Manutenção
                                        </button>
                                    </div>
                                </div>

                                <hr class="mt-1 mb-3">
                            </form>

                            <!-- PAGE CONTENT BEGINS -->
                            <table id="dynamic-table1" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
                                <thead>
                                    <tr role="row">
                                        <th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1">Beneficiário</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <label>Escolha o Beneficiário e clique no botão Localizar para buscar o container do Beneficiário.</label>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div><!-- /.page-content -->
            </div><!-- /.main-content-inner -->
        </div><!-- /.main-content -->
    </div><!-- /.main-container ace-save-state -->

    <!-- basic scripts -->
    <!--[if !IE]> -->
    <script type="text/javascript">
        if('ontouchstart' in document.documentElement) document.write("<script src='../../../assets/js/jquery.mobile.custom.min.js'>"+"<"+"/script>");
    </script>
    <!-- page specific plugin scripts -->
    <script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
    
	<script type="text/javascript">
    $(document).ready(function() {
        $("#dynamic-table1").DataTable({
            "language": { "url": "/js/lang/datatable-pt-br.json" },
            "aaSorting": [],
            "aoColumns": [{ "bSortable": false }],
            "responsive": true,
            "lengthMenu": [ 100, 200],
            "lengthChange": true,
            "autoWidth": false,
            "paging": true,
            "searching": true,
            "ordering": true,
            "info": true,
            "select": { "style": 'multi' }
        });

        $('#pesquisaBeneid').select2({ placeholder: "Selecione o Beneficiario" });
        $('#progTipoId').select2({ placeholder: "Selecione o Programa" });
        $('#status').select2({ placeholder: "Selecione o Status" });

        // Logica de filtro dinamico de programas (SEM DISABLED)
        $('#pesquisaBeneid').on('change', function() {
            const beneId = $(this).val();
            const $progSelect = $('#progTipoId');
            
            // Limpa e coloca a opcao padrao
            $progSelect.empty().append('<option value="todos">Todos</option>');

            if (beneId && beneId !== "766f69643132333435366964") {
                const progsDoBene = dadosProgramas.filter(p => String(p.beneId) === String(beneId));
                const uniqueTipoIds = [...new Set(progsDoBene.map(p => String(p.tipoId)).filter(id => id !== "" && id !== "undefined"))];

                if (uniqueTipoIds.length > 0) {
                    const tiposDoBene = uniqueTipoIds.map(tipoIdStr => {
                        const tipoInfo = dadosTipos.find(t => String(t._id) === String(tipoIdStr));
                        return { 
                            id: tipoIdStr, 
                            nome: tipoInfo ? tipoInfo.nome : 'Nome nao encontrado' 
                        };
                    });

                    tiposDoBene.sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR', { sensitivity: 'base' }));

                    // SEM DISABLED - apenas popula as opcoes
                    tiposDoBene.forEach(tipo => {
                        $progSelect.append(new Option(tipo.nome, tipo.id));
                    });
                    $progSelect.trigger('change');
                }
            }
        });
    });

    // Dados injetados pelo backend
    const dadosProgramas = {{{json progs}}};
    const dadosTipos = {{{json progtipos}}};

    // Handler do formulario principal (SIMPLIFICADO - SEM DISABLED)
    document.getElementById('formEnv').addEventListener('submit', function (event) {
        const selectBene = document.getElementById('pesquisaBeneid');
        const selectedId = selectBene.value;
        
        // Leitura direta dos valores (sem disabled atrapalhando)
        const progTipoId = $('#progTipoId').val() || 'todos';
        const status = $('#status').val() || 'todos';

        console.log("=== [FRONTEND] Valores que serao enviados ===");
        console.log("Beneficiario:", selectedId);
        console.log("Tipo Programa:", progTipoId);
        console.log("Status:", status);

        if (!selectedId || selectedId === "766f69643132333435366964") {
            alert('Por favor, selecione um beneficiario valido.');
            event.preventDefault();
            return;
        }

        this.action = `/menu/area/aba/prog/proglisF/${selectedId}?progTipoId=${progTipoId}&status=${status}`;
        console.log("URL final:", this.action);
    });

   document.getElementById('formEnv').addEventListener('submit', function (event) {
    const selectBene = document.getElementById('pesquisaBeneid');
    const selectedId = selectBene.value;

    if (!selectedId || selectedId === "766f69643132333435366964") {
        alert('Por favor, selecione um beneficiario valido.');
        event.preventDefault();
        return;
    }

    // ✅ Apenas o caminho base. O method="GET" anexa ?progTipoId=X&status=Y automaticamente
    this.action = `/menu/area/aba/prog/proglisF/${selectedId}`;
});
</script>
</body>
</html>