            function marcaImput(inputName) {
            let elementoAlvo = document.getElementById(inputName);
            if (elementoAlvo.checked == true) {
            elementoAlvo.value = "true";
            } else {
            elementoAlvo.value = "false";
            }
            }

            function marcaRadioImput(inputName, index, valor) {
            let elementoAlvo = document.getElementById(inputName+index);
            if (elementoAlvo.checked == true) {
            elementoAlvo.value = "true";
            document.getElementById(inputName).value = valor;
            } else {
            elementoAlvo.value = "false";
            }
            }

            function preencherInputAlvo(inputName,index) {
            let elementoAlvo = document.getElementById(inputName);
            if (elementoAlvo.checked == true) {
            document.getElementById(inputName+index).value = "true";
            } else {
            document.getElementById(inputName+index).value = "false";
            }
            }

            function mudaRegistro() {
            let tipodoc = document.getElementById("folregTiporeg").value;
            console.log(tipodoc)
            if (tipodoc == "Não Informado") {
            document.getElementById('simples').style.display = 'none';
            document.getElementById('duplo').style.display = 'none';
            } else if (tipodoc == "Duplo") {
            document.getElementById('duplo').style.display = 'block';
            document.getElementById('simples').style.display = 'none';
            } else if (tipodoc == "Simples") {
            document.getElementById('duplo').style.display = 'none';
            document.getElementById('simples').style.display = 'block';
            } else {
            document.getElementById('simples').style.display = 'none';
            document.getElementById('duplo').style.display = 'none';
            }
            }

            function caseClasseCor(letra){
                let retorno = "";
                switch (letra){
                    case "A": retorno = "label label-sm label-cian arrowed arrowed-righ"; break;
                    case "B": retorno = "label label-sm label-warning arrowed arrowed-righ"; break;
                    case "C": retorno = "label label-sm label-pink arrowed arrowed-righ"; break;
                    case "D": retorno = "label label-sm label-info arrowed arrowed-righ"; break;
                    case "E": retorno = "label label-sm label-warning arrowed arrowed-righ"; break;
                    case "F": retorno = "label label-sm label-pink arrowed arrowed-righ"; break;
                    case "G": retorno = "label label-sm label-purple arrowed arrowed-righ"; break;
                    case "H": retorno = "label label-sm label-success arrowed arrowed-righ"; break;
                    case "I": retorno = "label label-sm label-danger arrowed arrowed-righ"; break;
                    case "J": retorno = "label label-sm label-cyan arrowed arrowed-righ"; break;
                    default: retorno = "label label-sm label-cyan arrowed arrowed-righ"; break;
                }
                return retorno;
            }

