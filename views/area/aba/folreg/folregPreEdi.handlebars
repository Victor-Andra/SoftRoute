            function somaResEstSI() {
                let totalI = 0;
                let totalE = 0;
                let totalMaisD = 0;
                let totalMenosD = 0;
                let inputs = document.querySelectorAll('input[name$="Ressimplesradio"]:checked');
                inputs.forEach(function(input) {
                switch((input.id).substring((input.id).length-1,(input.id).length)) {
                case '1': totalI++; break;
                case '2': totalE++; break;
                case '3': totalMaisD++; break;
                case '4': totalMenosD++; break;
                default: break;
            }
            });
