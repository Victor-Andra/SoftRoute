                        <script>
                            //######################################################################################################
                            //GRAFICO SIMPLES
                            const data = {
                            labels: ['SET'],
                            datasets: [
                            { label: 'I', backgroundColor: 'rgba(0, 255, 0, 0.5)', data: [0] },
                            { label: 'E', backgroundColor: 'rgba(255, 255, 0, 0.5)', data: [0] },
                            { label: '+d', backgroundColor: 'rgba(255, 165, 0, 0.5)', data: [0] },
                            { label: '-d', backgroundColor: 'rgba(255, 99, 132, 0.5)', data: [0] }
                            ]
                            };

                            // ✅ CORREÇÃO CRÍTICA: fallback quando folreg.folreg_qtest está vazio
                            // Antes era: const tentativas = {{folreg.folreg_qtest}}; que virava "const tentativas = ;" = ERRO DE SINTAXE
                            let tentativas = "{{folreg.folreg_qtest}}";
                            if (!tentativas || tentativas === "" || tentativas === "undefined" || tentativas === "{{folreg.folreg_qtest}}") {
                            // Pega do elemento qtEst que foi preenchido pelo Handlebars
                            const qtEstEl = document.getElementById("qtEst");
                            tentativas = qtEstEl ? qtEstEl.value : "1";
                            }
                            console.log("Valor do campo qtEst (seguro):", tentativas);

                            const options = {
                            scales: {
                            x: { stacked: true },
                            y: { stacked: true, min: 0, max: tentativas != "10" ? 90 : 100 }
                            }
                            };

                            const config = {
                            type: 'bar',
                            data: data,
                            options: options
                            };

                            let grafico = null;

                            function renderizarGrafico() {
                            const ctx = document.getElementById('stackedBarChart-Simples');
                            if (ctx) {
                            if (grafico !== null) {
                            grafico.destroy();
                            }
                            grafico = new Chart(ctx, config);
                            } else {
                            console.error('Não foi possível encontrar o elemento canvas.');
                            }
                            }

                            function atualizarEAtualizarGrafico() {
                            const valorI = parseInt(document.getElementById("folregTotalsimples_i").value) * 10;
                            const valorE = parseInt(document.getElementById("folregTotalsimples_e").value) * 10;
                            const valorMaisD = parseInt(document.getElementById("folregTotalsimples_plusd").value) * 10;
                            const valorMenosD = parseInt(document.getElementById("folregTotalsimples_minusd").value) * 10;

                            data.datasets[0].data = [valorI];
                            data.datasets[1].data = [valorE];
                            data.datasets[2].data = [valorMaisD];
                            data.datasets[3].data = [valorMenosD];

                            if (grafico !== null) {
                            grafico.update();
                            } else {
                            console.error('O gráfico não foi inicializado corretamente.');
                            }
                            }

                            document.querySelectorAll('input[name$="Ressimples"]').forEach(function(input) {
                            input.addEventListener("change", atualizarEAtualizarGrafico);
                            });

                            document.addEventListener('DOMContentLoaded', function() {
                            renderizarGrafico();
                            });

                            //######################################################################################################
                            //GRAFICO Duplo
                            let graficoDuplo = null;

                            const dataDuplo = {
                            labels: ['Esquerda', 'Direita'],
                            datasets: [
                            { label: 'I', backgroundColor: 'rgba(0, 255, 0, 0.5)', data: [0, 0] },
                            { label: 'E', backgroundColor: 'rgba(255, 255, 0, 0.5)', data: [0, 0] },
                            { label: '+d', backgroundColor: 'rgba(255, 165, 0, 0.5)', data: [0, 0] },
                            { label: '-d', backgroundColor: 'rgba(255, 99, 132, 0.5)', data: [0, 0] }
                            ]
                            };

                            console.log('Dados do gráfico duplo:', dataDuplo);

                            function renderizarGraficoDuplo() {
                            console.log('Iniciando renderização do gráfico duplo...');
                            const ctx = document.getElementById('graficoDuplo')?.getContext('2d');
                            if (!ctx) {
                            console.error('Elemento canvas para o gráfico duplo não encontrado.');
                            return;
                            }
                            console.log('Elemento canvas encontrado:', ctx);

                            // ✅ CORREÇÃO: mesmo fallback seguro para o gráfico duplo
                            let tentativasduplo = "{{folreg.folreg_qtest}}";
                            if (!tentativasduplo || tentativasduplo === "" || tentativasduplo === "undefined") {
                            const qtEstEl = document.getElementById("qtEst");
                            tentativasduplo = qtEstEl ? qtEstEl.value : "1";
                            }

                            const options = {
                            scales: {
                            x: { stacked: true },
                            y: { stacked: true, min: 0, max: tentativasduplo != "10" ? 90 : 100 }
                            }
                            };

                            console.log('Opções do gráfico duplo:', options);

                            const config = {
                            type: 'bar',
                            data: dataDuplo,
                            options: options
                            };

                            console.log('Configuração completa do gráfico duplo:', config);

                            if (graficoDuplo !== null) {
                            console.log('Destruindo gráfico duplo existente...');
                            graficoDuplo.destroy();
                            }

                            console.log('Criando novo gráfico duplo...');
                            graficoDuplo = new Chart(ctx, config);
                            console.log('Gráfico duplo criado com sucesso.');
                            }

                            function atualizarDuploGrafico() {
                            console.log('Iniciando atualização do gráfico duplo...');
                            const valoresqI = parseInt(document.getElementById("folregTotalduploesq_i").value) * 10 || 0;
                            const valoresqE = parseInt(document.getElementById("folregTotalduploesq_e").value) * 10 || 0;
                            const valoresqMaisD = parseInt(document.getElementById("folregTotalduploesq_plusd").value) * 10 || 0;
                            const valoresqMenosD = parseInt(document.getElementById("folregTotalduploesq_minusd").value) * 10 || 0;
                            const valordirI = parseInt(document.getElementById("folregTotalduplodir_i").value) * 10 || 0;
                            const valordirE = parseInt(document.getElementById("folregTotalduplodir_e").value) * 10 || 0;
                            const valordirMaisD = parseInt(document.getElementById("folregTotalduplodir_plusd").value) * 10 || 0;
                            const valordirMenosD = parseInt(document.getElementById("folregTotalduplodir_minusd").value) * 10 || 0;

                            console.log('Valores calculados para o gráfico duplo:', {
                            valoresqI, valoresqE, valoresqMaisD, valoresqMenosD,
                            valordirI, valordirE, valordirMaisD, valordirMenosD
                            });

                            if (graficoDuplo !== null) {
                            graficoDuplo.data.datasets[0].data = [valoresqI, valordirI];
                            graficoDuplo.data.datasets[1].data = [valoresqE, valordirE];
                            graficoDuplo.data.datasets[2].data = [valoresqMaisD, valordirMaisD];
                            graficoDuplo.data.datasets[3].data = [valoresqMenosD, valordirMenosD];
                            graficoDuplo.update();
                            console.log('Gráfico duplo atualizado com sucesso.');
                            } else {
                            console.error('O gráfico duplo não foi inicializado corretamente.');
                            }
                            }

                            document.querySelectorAll('input[name$="Resesqu"]').forEach(function(input) {
                            input.addEventListener("change", function() {
                            console.log('Input de esquerda alterado. Atualizando gráfico...');
                            atualizarDuploGrafico();
                            });
                            });

                            document.querySelectorAll('input[name$="Resdir"]').forEach(function(input) {
                            input.addEventListener("change", function() {
                            console.log('Input de direita alterado. Atualizando gráfico...');
                            atualizarDuploGrafico();
                            });
                            });

                            document.addEventListener('DOMContentLoaded', function() {
                            console.log('DOM pronto. Renderizando gráfico duplo...');
                            renderizarGraficoDuplo();
                            });

                            function carregaRamdomico() {
                            const qtestValue = parseInt(document.getElementById('folregQtest').value, 10);
                            const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
                            if (isNaN(qtestValue) || qtestValue < 1 || qtestValue > 9) {
                            console.error('Invalid value for folregQtest. Please provide a number between 1 and 9.');
                            return;
                            }
                            const letters = alphabet.slice(0, qtestValue).split('');
                            const shuffledLetters = shuffleArray(letters);
                            const tableRows = document.querySelectorAll('#dynamic-table tbody tr');
                            let letterIndex = 0;
                            tableRows.forEach((row, index) => {
                            if (index < tableRows.length - 1) {
                            const raCell = row.querySelector('td:nth-child(2) .RA');
                            raCell.innerText = shuffledLetters[letterIndex];
                            letterIndex = (letterIndex + 1) % shuffledLetters.length;
                            }
                            });
                            }

                            function shuffleArray(array) {
                            const newArray = array.slice();
                            for (let i = newArray.length - 1; i > 0; i--) {
                            const j = Math.floor(Math.random() * (i + 1));
                            [newArray[i], newArray[j]] = [newArray[j], newArray[i]];
                            }
                            return newArray;
                            }

                            document.addEventListener("DOMContentLoaded", function() {
                            const selects = ['folregBeneid', 'folregProgtipoid', 'folregPrognivelid'];
                            selects.forEach(function(id) {
                            var select = document.getElementById(id);
                            if (select) {
                            select.addEventListener("mousedown", function(event) { event.preventDefault(); });
                            select.addEventListener("keydown", function(event) { event.preventDefault(); });
                            }
                            });
                            });

                            function populateCheckboxes(containerId, inputId) {
                            if (document.getElementById(inputId) == null){
                            } else {
                            const nomesdicas = document.getElementById(inputId).value;
                            const progDicatipotext = nomesdicas.split(',');
                            const checkboxes = document.querySelectorAll(`#${containerId} .checkbox`);
                            checkboxes.forEach((checkbox, index) => {
                            if (index < progDicatipotext.length) {
                            const label = checkbox.querySelector('.label');
                            if (label) label.textContent = progDicatipotext[index];
                            checkbox.style.display = 'block';
                            } else {
                            checkbox.style.display = 'none';
                            }
                            });
                            }
                            }

                            document.addEventListener('DOMContentLoaded', () => {
                            populateCheckboxes('checkboxContainer1', 'progDicatipotext1');
                            populateCheckboxes('checkboxContainer2', 'progDicatipotext2');
                            populateCheckboxes('checkboxContainer3', 'progDicatipotext3');
                            });
                            </script>
                        <script>
                            document.addEventListener("DOMContentLoaded", function () {
                            carregaBody();
                            });
                            </script>
                    </body>
                </html>
