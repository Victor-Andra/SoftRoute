                document.getElementById("folregTotalsimples_e").value = totalE;
                document.getElementById("folregTotalsimples_plusd").value = totalMaisD;
                document.getElementById("folregTotalsimples_minusd").value = totalMenosD;
                atualizarEAtualizarGrafico();
            }

