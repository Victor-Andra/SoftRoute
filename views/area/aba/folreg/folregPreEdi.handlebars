            function showStimulusFieldsWithValues() {
                var fields = ['folregEsta', 'folregEstb', 'folregEstc', 'folregEstd', 'folregEste', 'folregEstf', 'folregEstg', 'folregEsth', 'folregEsti','folregEstj'];
                fields.forEach(function(fieldId) {
