		<script>
			// ✅ IDs dos perfis master/supervisor/root
			const PERFIS_MASTER = ['644743aa78166939169f8486', '62421801a12aa557219a0fb9', '644742e378166939169f82a1'];
			
			// ✅ Função para verificar se é master
			function ehMaster() {
				const perfilAtual = document.getElementById("usuperfilId").value;
				return PERFIS_MASTER.some(perfil => perfilAtual.includes(perfil));
			}

			function carregaBody(){
				document.getElementById("progsetProgid").value = document.getElementById("progsetProgidEdi").value;
				document.getElementById("progsetTeraid").value = document.getElementById("progsetTeraidEdi").value;
				document.getElementById("progsetNum").value = document.getElementById("progsetNumEdi").value;
				document.getElementById("progsetDataset").value = document.getElementById("progsetDatasetEdi").value;
				document.getElementById("progsetDataini").value = document.getElementById("progsetDatainiEdi").value;
				document.getElementById("progsetDatafin").value = document.getElementById("progsetDatafinEdi").value;
				document.getElementById("progsetDatameta").value = document.getElementById("progsetDatametaEdi").value;
				document.getElementById("progsetStatus").value = document.getElementById("progsetStatusEdi").value;
				document.getElementById("progsetTiporeg").value = document.getElementById("progsetTiporegEdi").value;
				document.getElementById("progsetDesc").value = document.getElementById("progsetDescEdi").value;
				document.getElementById("progsetQtest").value = document.getElementById("progsetQtestEdi").value;
				document.getElementById("progsetEsta").value = document.getElementById("progsetEstaEdi").value;
				document.getElementById("progsetEstb").value = document.getElementById("progsetEstbEdi").value;
				document.getElementById("progsetEstc").value = document.getElementById("progsetEstcEdi").value;
				document.getElementById("progsetEstd").value = document.getElementById("progsetEstdEdi").value;
				document.getElementById("progsetEste").value = document.getElementById("progsetEsteEdi").value;
				document.getElementById("progsetEstf").value = document.getElementById("progsetEstfEdi").value;
				document.getElementById("progsetEstg").value = document.getElementById("progsetEstgEdi").value;
				document.getElementById("progsetEsth").value = document.getElementById("progsetEsthEdi").value;
				document.getElementById("progsetEsti").value = document.getElementById("progsetEstiEdi").value;
				document.getElementById("progsetEstj").value = document.getElementById("progsetEstjEdi").value;
				document.getElementById("progsetMetatipo").value = document.getElementById("progsetMetatipoEdi").value;
				document.getElementById("progsetObs").value = document.getElementById("progsetObsEdi").value;
				
				updateStimulusFields();
				$('.chosen-select').trigger('chosen:updated');
				
				// ✅ Aplica as restrições baseadas no perfil
				aplicaRestricoesPerfil();
			}
			
			// ✅ NOVA FUNÇÃO: Aplica restrições baseado no perfil do usuário
			function aplicaRestricoesPerfil() {
				const isMaster = ehMaster();
				console.log("É master?", isMaster);
				
				if (!isMaster) {
					// ✅ BLOQUEIA TODOS OS CAMPOS EXCETO STATUS
					
					// Bloqueia selects
					document.getElementById("progsetTeraid").disabled = true;
					document.getElementById("progsetTiporeg").disabled = true;
					document.getElementById("progsetQtest").disabled = true;
					document.getElementById("progsetMetatipo").disabled = true;
					
					// Bloqueia inputs de texto e datas
					document.getElementById("progsetNum").readOnly = true;
					document.getElementById("progsetDataset").readOnly = true;
					document.getElementById("progsetDataini").readOnly = true;
					document.getElementById("progsetDatafin").readOnly = true;
					document.getElementById("progsetDatameta").readOnly = true;
					
					// Bloqueia textareas
					document.getElementById("progsetDesc").readOnly = true;
					document.getElementById("progsetObs").readOnly = true;
					
					// Bloqueia campos de estímulo
					document.getElementById("progsetEsta").readOnly = true;
					document.getElementById("progsetEstb").readOnly = true;
					document.getElementById("progsetEstc").readOnly = true;
					document.getElementById("progsetEstd").readOnly = true;
					document.getElementById("progsetEste").readOnly = true;
					document.getElementById("progsetEstf").readOnly = true;
					document.getElementById("progsetEstg").readOnly = true;
					document.getElementById("progsetEsth").readOnly = true;
					document.getElementById("progsetEsti").readOnly = true;
					document.getElementById("progsetEstj").readOnly = true;
					
					// ✅ Remove opções "Pausado" e "Manutenção" do select de status
					const selectStatus = document.getElementById("progsetStatus");
					const opcoes = selectStatus.options;
					
					// Itera de trás pra frente para remover sem problemas de índice
					for (let i = opcoes.length - 1; i >= 0; i--) {
						if (opcoes[i].value === "Pausado" || opcoes[i].value === "Manutenção") {
							selectStatus.remove(i);
						}
					}
					
					// Adiciona estilo visual para campos bloqueados
					const camposBloqueados = document.querySelectorAll('[readonly], [disabled]');
					camposBloqueados.forEach(campo => {
						campo.style.backgroundColor = '#f5f5f5';
						campo.style.cursor = 'not-allowed';
					});
				}
			}

			function updateStimulusFields() {
				var select = document.getElementById('progsetQtest');
				var value = parseInt(select.value, 10);

				var fields = document.querySelectorAll('.stimulus-field');
				fields.forEach(function(field) {
					field.style.display = 'none';
				});

				for (var i = 0; i < value; i++) {
					document.getElementById('stimulus' + String.fromCharCode(65 + i)).style.display = 'block';
				}
			}

			document.addEventListener('DOMContentLoaded', function() {
				carregaBody();
				document.getElementById('progsetQtest').addEventListener('change', updateStimulusFields);
			});
			
			function somaResEstSI() {
				let totalI = 0;
				let totalE = 0;
				let totalMaisD = 0;
				let totalMenosD = 0;

				let inputs = document.querySelectorAll('input[name$="Ressimples"]:checked');

				inputs.forEach(function(input) {
					switch(input.value) {
						case 'I':
							totalI++;
							break;
						case 'E':
							totalE++;
							break;
						case '+d':
							totalMaisD++;
							break;
						case '-d':
							totalMenosD++;
							break;
						default:
							break;
					}
				});

				document.getElementById("folregTotalsimples1").value = totalI;
				document.getElementById("folregTotalsimples2").value = totalE;
				document.getElementById("folregTotalsimples3").value = totalMaisD;
				document.getElementById("folregTotalsimples4").value = totalMenosD;
			}

			function somaResEstDuplo() {
				let totalEsqI = 0;
				let totalEsqE = 0;
				let totalEsqMaisD = 0;
				let totalEsqMenosD = 0;

				let inputsEsq = document.querySelectorAll('input[name$="Resesqu"]:checked');

				inputsEsq.forEach(function(input) {
				switch(input.value) {
					case 'I':
						totalEsqI++;
						break;
					case 'E':
						totalEsqE++;
						break;
					case '+d':
						totalEsqMaisD++;
						break;
					case '-d':
						totalEsqMenosD++;
						break;
					default:
						break;
				}
			});

				document.getElementById("folregTotalduploesq_i").value = totalEsqI;
				document.getElementById("folregTotalduploesq_e").value = totalEsqE;
				document.getElementById("folregTotalduploesq_plusd").value = totalEsqMaisD;
				document.getElementById("folregTotalduploesq_minusd").value = totalEsqMenosD;

				let totalDirI = 0;
				let totalDirE = 0;
				let totalDirMaisD = 0;
				let totalDirMenosD = 0;

				let inputsDir = document.querySelectorAll('input[name$="Resdir"]:checked');

				inputsDir.forEach(function(input) {
					switch(input.value) {
						case 'I':
							totalDirI++;
							break;
						case 'E':
							totalDirE++;
							break;
						case '+d':
							totalDirMaisD++;
							break;
						case '-d':
							totalDirMenosD++;
							break;
						default:
							break;
					}
				});

				document.getElementById("folregTotalduplodir_i").value = totalDirI;
				document.getElementById("folregTotalduplodir_e").value = totalDirE;
				document.getElementById("folregTotalduplodir_plusd").value = totalDirMaisD;
				document.getElementById("folregTotalduplodir_minusd").value = totalDirMenosD;
			}

			function atualizarGraficoDuplo() {
				const valoresEsq = [
					parseInt(document.getElementById("folregTotalduploesq_i").value) * 10,
					parseInt(document.getElementById("folregTotalduploesq_e").value) * 10,
					parseInt(document.getElementById("folregTotalduploesq_plusd").value) * 10,
					parseInt(document.getElementById("folregTotalduploesq_minusd").value) * 10
				];

				const valoresDir = [
					parseInt(document.getElementById("folregTotalduplodir_i").value) * 10,
					parseInt(document.getElementById("folregTotalduplodir_e").value) * 10,
					parseInt(document.getElementById("folregTotalduplodir_plusd").value) * 10,
					parseInt(document.getElementById("folregTotalduplodir_minusd").value) * 10
				];

				dataDuplo.datasets[0].data = valoresEsq;
				dataDuplo.datasets[1].data = valoresDir;

				if (graficoDuplo !== null) {
					graficoDuplo.update();
				} else {
					console.error('O gráfico duplo não foi inicializado corretamente.');
				}
			}

			document.querySelectorAll('input[name$="Resesqu"]').forEach(function(input) {
				input.addEventListener("change", function() {
					somaResEstDuplo();
					atualizarGraficoDuplo();
				});
			});

			document.querySelectorAll('input[name$="Resdir"]').forEach(function(input) {
				input.addEventListener("change", function() {
					somaResEstDuplo();
					atualizarGraficoDuplo();
				});
			});
			
			// ✅ FUNÇÃO ATUALIZADA: Validação de transição de status baseada no perfil
			function mudarstatusSet(selectElement) {
				let statusAtual = document.getElementById("progsetStatusEdi").value;
				let novoStatus = selectElement.value;
				const isMaster = ehMaster();

				console.log("Status atual:", statusAtual);
				console.log("Novo status:", novoStatus);
				console.log("É master?", isMaster);

				// ✅ Se for master, permite qualquer transição
				if (isMaster) {
					console.log(`Master: Status alterado para: ${novoStatus}`);
					return true;
				}

				// ✅ Se for terapeuta, valida as transições permitidas
				// Transições permitidas para terapeuta:
				// - Agendado → Andamento ✅
				// - Andamento → Meta ✅
				// Qualquer outra = BLOQUEADA
				
				const transicoesPermitidas = {
					'Agendado': ['Andamento'],
					'Andamento': ['Meta'],
					'Meta': [] // Meta não pode voltar pra nada
				};

				const permitidas = transicoesPermitidas[statusAtual] || [];
				
				if (permitidas.includes(novoStatus)) {
					console.log(`Terapeuta: Status alterado para: ${novoStatus}`);
					return true;
				} else {
					alert(`Mudança de status não permitida!\n\nDe "${statusAtual}" para "${novoStatus}" não é permitido para seu perfil.\n\nTransições permitidas:\n- Agendado → Andamento\n- Andamento → Meta`);
					selectElement.value = statusAtual;
					return false;
				}
			}

		</script>
	</head>
