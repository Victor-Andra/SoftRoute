<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>SET Cadastrar</title>
		<style>
			/* ============================================
			  SELECT2 - ESTILOS GERAIS (Baseado na view de Atendimentos)
			  ============================================ */
			.select2-container { 
				min-width: 120px !important; 
			}
			.select2-container--default .select2-selection--single {
				height: 30px !important; 
				border: 1px solid #ced4da !important;
				border-radius: 4px !important; 
				background: white !important;
				display: flex !important; 
				align-items: center !important;
				padding: 0 8px !important; 
				font-size: 12px !important;
			}
			.select2-container--default .select2-selection--single .select2-selection__arrow {
				height: 28px !important; 
				right: 5px !important;
			}
			.select2-container--default .select2-selection--single .select2-selection__rendered {
				line-height: 28px !important; 
				padding-left: 0 !important; 
				color: #333 !important;
			}
			.select2-container--default .select2-selection--single .select2-selection__placeholder {
				color: #999 !important;
			}
			.select2-dropdown {
				border: 1px solid #ced4da !important; 
				border-radius: 4px !important;
				box-shadow: 0 2px 8px rgba(0,0,0,0.1) !important;
			}
			.select2-container--default .select2-search--dropdown .select2-search__field {
				border: 1px solid #ced4da !important; 
				border-radius: 4px !important;
				padding: 4px 8px !important; 
				font-size: 12px !important; 
				margin: 4px !important;
			}
			.select2-container--default .select2-results__option {
				padding: 6px 10px !important; 
				font-size: 12px !important;
			}
			.select2-container--default .select2-results__option--highlighted[aria-selected] {
				background-color: #2196f3 !important; 
				color: white !important;
			}
			.select2-container--default.select2-container--focus .select2-selection--single {
				border-color: #2196f3 !important;
				box-shadow: 0 0 0 2px rgba(33,150,243,0.2) !important;
			}

			/* Largura específica para os selects desta view */
			#progsetBeneid + .select2-container,
			#progsetProgtipoid + .select2-container,
			#progsetPrognivelid + .select2-container,
			#progsetTeraid + .select2-container,
			#progsetMetatipo + .select2-container,
			#progsetStatus + .select2-container,
			#progsetTiporeg + .select2-container,
			#progsetQtest + .select2-container {
				width: 100% !important;
			}

			/* Responsivo */
			@media (max-width: 768px) {
				.select2-container { 
					width: 100% !important; 
				}
			}

			/* 🟧 Laranja pastel para campos com erro */
			.field-error {
				border: 2px solid #ffb380 !important;
				background-color: #fff5ec !important;
				box-shadow: 0 0 5px rgba(255, 179, 128, 0.6) !important;
			}
			/* Para selects com Select2, destacamos o container */
			.select2-container--default .select2-selection--single.field-error,
			.select2-container--default .select2-selection--multiple.field-error {
				border: 2px solid #ffb380 !important;
				background-color: #fff5ec !important;
			}
		</style>
		<script>
			function carregaBody() {
				// ✅ Para Select2: use .trigger('change.select2')
				var beneVal = $('#progBene').val();
				$('#progsetBeneid').val(beneVal).trigger('change.select2');
				
				$('#progsetProgtipoid').val($('#progTipo').val()).trigger('change.select2');
				$('#progsetPrognivelid').val($('#progNivel').val()).trigger('change.select2');
				
				// Se progStatus também for Select2:
				$('#progStatus').val($('#progStatusEdi').val()).trigger('change.select2');
			}

			// ✅ Preenche o Técnico Aplicador com o usuário atual
			var usuarioAtualId = document.getElementById("usuarioAtual")?.value;
			if(usuarioAtualId){
				var $select = jQuery('#folregUsuid');
				
				$('#folregUsuid').val(usuarioAtualId).trigger('change');
				
				if($select.data('select2')){
					$select.val(usuarioAtualId).trigger('change.select2');
				}
			}

			// ✅ Função para atualizar campos de estímulo (reutilizável)
			function updateStimulusFields() {
				const select = $('#progsetQtest');
				const value = parseInt(select.val(), 10) || 0;

				// Esconde todos
				$('.stimulus-field').hide();

				// Mostra só os necessários (A, B, C...)
				for (let i = 0; i < value && i < 10; i++) {
					$('#stimulus' + String.fromCharCode(65 + i)).show();
				}
			}

			// ✅ Função para mudar tipo de registro
			function mudaRegistro() {
				const tipoReg = $('#progsetTiporeg').val();
				console.log("Tipo de registro selecionado:", tipoReg);
			}

			// ✅ Inicializa ao carregar a página
			$(document).ready(function() {
				initChosen?.(); // opcional

				$('#progsetQtest').on('change', updateStimulusFields);
				$('#progsetTiporeg').on('change', mudaRegistro);

				updateStimulusFields();
			});

			// =========================================================
			// 🔒 VALIDAÇÃO DO FORMULÁRIO + MODAL + PINTURA LARANJA
			// =========================================================
			$(document).ready(function() {
				// Remove destaque laranja ao digitar/selecionar
				$('input, select, textarea').on('input change', function() {
					$(this).removeClass('field-error');
					// Para Select2: remove do container também
					$(this).siblings('.select2-container').find('.select2-selection').removeClass('field-error');
					$(this).closest('.form-group').find('.select2-selection').removeClass('field-error');
				});

				$('#formProgSet').on('submit', function(e) {
					// Limpa erros anteriores
					$('.field-error').removeClass('field-error');
					$('.select2-selection').removeClass('field-error');

					const erros = [];
					const campos = [
						{ id: 'progsetBeneid',     nome: 'Beneficiário' },
						{ id: 'progsetProgtipoid', nome: 'Tipo do Programa' },
						{ id: 'progsetPrognivelid',nome: 'Nível do Programa' },
						{ id: 'progsetNum',        nome: 'Número do SET' },
						{ id: 'progsetDataset',    nome: 'Data de criação do SET' },
						{ id: 'progsetDataini',    nome: 'Data de início do SET' },
						{ id: 'progsetDesc',       nome: 'Descrição do SET' },
						{ id: 'progsetQtest',      nome: 'Quantidade de Estímulos' },
						{ id: 'progsetTiporeg',    nome: 'Tipo do Registro' }
					];

					campos.forEach(c => {
						const el = $('#' + c.id);
						const val = (el.val() || '').toString().trim();

						let invalido = false;

						if (c.id === 'progsetTiporeg') {
							// Regra especial: não pode ser "Não Informado"
							if (!val || val === 'Não Informado' || val === '-') {
								invalido = true;
								erros.push('Tipo do Registro não pode ser "Não Informado".');
							}
						} else {
							if (!val || val === '-' || val === '766f69643132333435366964' /* valor do option placeholder */) {
								invalido = true;
								erros.push('Campo obrigatório: <b>' + c.nome + '</b>');
							}
						}

						if (invalido) {
							el.addClass('field-error');
							// Destaca também o Select2 visível (se houver)
							el.siblings('.select2-container')
							  .find('.select2-selection')
							  .addClass('field-error');
							el.closest('.form-group')
							  .find('.select2-selection')
							  .addClass('field-error');
						}
					});

					if (erros.length > 0) {
						e.preventDefault(); // 🔒 Impede o envio

						// Monta a lista HTML
						const lista = erros.map(e => '<li>' + e + '</li>').join('');
						$('#modalErrosBody').html(
							'<p class="lead text-danger">Por favor, corrija os seguintes itens:</p>' +
							'<ul>' + lista + '</ul>'
						);

						$('#modalErros').modal('show');

						// Rola até o primeiro campo com erro
						const primeiro = $('.field-error').first();
						if (primeiro.length) {
							$('html, body').animate({
								scrollTop: primeiro.offset().top - 100
							}, 400);
						}
						return false;
					}
				});
			});
		</script>
	</head>
	<body onload="javascript:controlaNave();carregaBody();" class="no-skin">
		<!-- ================================ -->
		<!-- 🟧 MODAL DE ERROS DE VALIDAÇÃO   -->
		<!-- ================================ -->
