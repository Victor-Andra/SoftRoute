						</h4>
					</div>
					<div class="modal-body" id="modalErrosBody">
						<!-- preenchido dinamicamente -->
					</div>
					<div class="modal-footer">
						<button class="btn btn-warning" data-dismiss="modal">
							<i class="ace-icon fa fa-check"></i> Entendi
						</button>
					</div>
				</div>
			</div>
		</div>

