		<script type="text/javascript">
			// === FUNÇÃO PARA ABRIR MODAL DE DELETAÇÃO ===
			function abreModalDeletar(idTrat, nomeBeneficiario) {
				// Preenche os dados do modal
				document.getElementById('tratIdDeletar').value = idTrat;
				document.getElementById('modalBeneNome').textContent = nomeBeneficiario || 'Não identificado';
				
				// Formata data/hora atual
				const agora = new Date();
				const dataFormatada = agora.toLocaleDateString('pt-BR') + ' ' + 
									agora.toLocaleTimeString('pt-BR');
				document.getElementById('modalDataHora').textContent = dataFormatada;
				
				// Limpa e foca no campo de motivo
				const campoMotivo = document.getElementById('motivoDeletar');
				campoMotivo.value = '';
				campoMotivo.focus();
				
				// Atualiza action do form com o ID
				document.getElementById('formDeletarLogico').action = 
					'/menu/area/plano/lixo/' + idTrat;
				
				// Abre o modal (compatível com Bootstrap 3/4 e Ace Admin)
				$('#modalDeletar').modal('show');
			}
			
			// === VALIDAÇÃO DO FORMULÁRIO DE DELETAÇÃO ===
			document.getElementById('formDeletarLogico')?.addEventListener('submit', function(e) {
				const motivo = document.getElementById('motivoDeletar').value.trim();
				
				if (motivo.length < 10) {
					e.preventDefault();
					alert('⚠️ Por favor, descreva um motivo mais detalhado (mínimo 10 caracteres).');
					document.getElementById('motivoDeletar').focus();
					return false;
				}
				
				// Desabilita botão para evitar duplo clique
				const btn = document.getElementById('btnConfirmarDeletar');
				btn.disabled = true;
				btn.innerHTML = '<i class="ace-icon fa fa-spinner fa-spin"></i> Processando...';
				
				return true;
			});
			
			// === RESETAR BOTÃO AO FECHAR MODAL ===
			$('#modalDeletar').on('hidden.bs.modal', function () {
				const btn = document.getElementById('btnConfirmarDeletar');
				if(btn) {
					btn.disabled = false;
					btn.innerHTML = '<i class="ace-icon fa fa-trash"></i> Confirmar Exclusão';
				}
			});
			
			// === OCULTAR BOTÃO DE DELETE POR PERMISSÃO (mantendo sua lógica) ===
			function ocultaDelete(){
				let perfilAtual = document.getElementById("perfilAtual")?.value;
				const idsPermitidos = ['62421801a12aa557219a0fb9','62421903a12aa557219a0fd3'];
				
				if (perfilAtual && idsPermitidos.includes(perfilAtual)) {
					console.log("✓ Permissão de exclusão concedida");
				} else {
					// Remove todos os botões de deletar da página
					document.querySelectorAll('a[title="Deletar"]').forEach(el => {
						el.style.display = 'none';
					});
					console.log("✗ Permissão de exclusão negada");
				}
			}
		</script>

