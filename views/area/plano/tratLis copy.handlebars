<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista de Planos de Tratamentos</title>
	<style>
		#dynamic-table {
			table-layout: fixed;
			width: 100%;
			border-collapse: collapse;
			font-size: 11px;
		}

		/* === COLUNAS DE DATA - AINDA MAIS ESTREITAS === */
		#dynamic-table th:nth-child(2), /* Data Plano */
		#dynamic-table td:nth-child(2) {
			width: 70px !important;
			text-align: center;
			white-space: normal;
			word-wrap: break-word;
		}

		#dynamic-table th:nth-child(10), /* Data cadastro */
		#dynamic-table td:nth-child(10),
		#dynamic-table th:nth-child(11), /* Data edição */
		#dynamic-table td:nth-child(11) {
			width: 70px !important;
			text-align: center;
			white-space: normal;
			word-wrap: break-word;
		}

		/* === COLUNA AÇÃO === */
		#dynamic-table th:nth-child(12),
		#dynamic-table td:nth-child(12) {
			width: 80px !important;
			text-align: center;
			padding: 4px;
		}

		/* === BENEFICIÁRIO - MAIOR ESPAÇO === */
		#dynamic-table th:nth-child(3),
		#dynamic-table td:nth-child(3) {
			width: 180px !important;
			word-wrap: break-word;
			white-space: normal;
			overflow: hidden;
		}

		/* === TERAPEUTAS (Padrão, IS, AVD) === */
		#dynamic-table th:nth-child(4),
		#dynamic-table td:nth-child(4),
		#dynamic-table th:nth-child(6),
		#dynamic-table td:nth-child(6),
		#dynamic-table th:nth-child(8),
		#dynamic-table td:nth-child(8) {
			width: 120px !important;
			word-wrap: break-word;
			white-space: normal;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		/* === TERAPIAS (Padrão, IS, AVD) - QUEBRA FORÇADA MESMO SEM ESPAÇOS === */
		#dynamic-table th:nth-child(5),
		#dynamic-table td:nth-child(5),
		#dynamic-table th:nth-child(7),
		#dynamic-table td:nth-child(7),
		#dynamic-table th:nth-child(9),
		#dynamic-table td:nth-child(9) {
			width: 130px !important;
			word-break: break-all;        /* Quebra mesmo sem espaços */
			white-space: normal;          /* Permite múltiplas linhas */
			overflow: hidden;
			text-overflow: ellipsis;
			line-height: 1.3;
			padding: 5px 4px;
		}

		/* === TIPO DE PLANO === */
		#dynamic-table th:nth-child(1),
		#dynamic-table td:nth-child(1) {
			width: 90px !important;
			text-align: center;
		}

		/* === AJUSTE GERAL DAS CÉLULAS === */
		#dynamic-table td, 
		#dynamic-table th {
			overflow: hidden;
			text-overflow: ellipsis;
			padding: 5px 4px;
			line-height: 1.3;
		}
		</style>
		<script type="text/javascript">
			function ocultaEditar(){
				let biscoito = procuraBiscoito("lvlUsu");
				document.getElementById("botaoEditar").value;
			}
			function ajustaData(){
				let fullDatas = document.getElementsByName("fullData");
				fullDatas.forEach((elementox)=>{
					let id = "tratdata"+elementox.id;
					let dat = new Date(elementox.value);
					let mes = (dat.getMonth()+1).toString();
					let dia = (dat.getUTCDate()).toString();

					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}

					let fulldate=(dia+"/"+mes+"/"+dat.getFullYear()).toString();
				})
			}
			
			function trocaFiltroData(){
				let fill = document.getElementById("tipoData").value;
				if(fill == "Ano"){
					document.getElementById("divAnoBordo").hidden = false;
					document.getElementById("divMesBordo").hidden = true;
					document.getElementById("divDataFil").hidden = true;
				} else if(fill == "Ano/Mes"){
					document.getElementById("divAnoBordo").hidden = false;
					document.getElementById("divMesBordo").hidden = false;
					document.getElementById("divDataFil").hidden = true;
				} else if (fill == "Semana"){
					document.getElementById("divAnoBordo").hidden = true;
					document.getElementById("divMesBordo").hidden = true;
					document.getElementById("divDataFil").hidden = false;
				} else {
					document.getElementById("divAnoBordo").hidden = true;
					document.getElementById("divMesBordo").hidden = true;
					document.getElementById("divDataFil").hidden = false;
				}
			}
			function trocaFilpessoa() {
				let fillTipopessoa = document.getElementById("tratTipoPessoa").value;
				if(fillTipopessoa == "Geral"){
					document.getElementById("divBordoBeneficiario").hidden = true;
					document.getElementById("divBordoTerapeuta").hidden = true;
				} else if(fillTipopessoa == "Beneficiario"){
					document.getElementById("divBordoBeneficiario").hidden = false;
					document.getElementById("divBordoTerapeuta").hidden = true;
				} else {
					document.getElementById("divBordoBeneficiario").hidden = true;
					document.getElementById("divBordoTerapeuta").hidden = false;
				}
			}
			function carregaBody(){
				trocaFiltroData();
				trocaFilpessoa();
				
				
				this.ocultaDelete();
			}

			function confirmeDeletar(id){
				let confirmado = confirm("Quer mesmo deletar este plano de tratamento?");
				if(confirmado == true){
					window.location.href=("/menu/area/plano/del/"+id);
				}
			}

			function ocultaDelete(){
				let perfilAtual = document.getElementById("perfilAtual").value;
				if (perfilAtual == '62421801a12aa557219a0fb9'){
					console.log("Ok")
				} else {
					document.getElementById("acaoDel").remove();
					console.log("NOT Ok")
				}
			}

			function formataDataold(){
				let dt = document.getElementById('dataFil').value;
				let dia = dt.substring(8,10);
				let mes = dt.substring(5,7);
				let ano = dt.substring(0,4);
				let fulldate=(ano+"-"+mes+"-"+dia+' 00:00:00.000Z').toString();
				document.getElementById('dataFinal').value = fulldate;
				console.log("dataFinal:"+document.getElementById('dataFinal').value);
			}
			function formataData(){//Melhorada se  haver campo com resultado vazio 05/08/2025 11:00
				let dtInput = document.getElementById('dataFil');
				let dt = dtInput.value;
				if (!dt) return;
				let [ano, mes, dia] = dt.split("-");
				let fulldate = `${ano}-${mes}-${dia} 00:00:00.000Z`;
				document.getElementById('dataFinal').value = fulldate;
			}
		</script>
	</head>
	<body onload="javascript:controlaNave();carregaBody();" class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Route</a>
							</li>
							<li class="active">Lista de Planos de Tratamentos</li>
						</ul><!-- /.breadcrumb -->
					</div>
					<div id="divCarrega" class="hidden">
						<input type="hidden" id="perfilAtual" name="perfilAtual" value="{{perfilAtual}}" />
					</div>
					{{#compareString flash.sucesso "true"}}
						<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-success">
							<p>
								<strong>
									<i class="ace-icon fa fa-check"></i>
									{{flash.texto}}
								</strong>
								<button type="button" class="close" onclick="javascript:OcultaMsg()">
									<i class="ace-icon fa fa-times"></i>
								</button>
							</p>
						</div>
						<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-success">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
					{{else}}
						{{#compareString flash.sucesso "false"}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">
								<p>
									<strong>
										<i class="ace-icon fa fa-times"></i>
										{{flash.texto}}
									</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()">
										<i class="ace-icon fa fa-times"></i>
									</button>
								</p>
							</div>
							<!--<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">{{flash.texto}}<button onclick="javascript:OcultaMsg()">X</button></div>-->
						{{else}}
						{{/compareString}}
					{{/compareString}}
					<div class="page-content"><!-- .page-content -->
						<form id="divFormPesquisa" class="form-horizontal" role="form" action="/menu/area/plano/lisF" method="POST">
							<div class="col-xs-12">
								<div class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label>Filtro por:&nbsp;</label>
											<select name="tipoData" id="tipoData" class="chosen-select" data-placeholder="Escolha..." onchange="javascript:trocaFiltroData()">
												<option value="Ano">Ano</option>
												<option value="Ano/Mes" selected>Ano/Mês</option>
												<option value="Semana">Semana</option>
												<option value="Dia">Dia</option>
											</select>
										</div>
									</div>
								</div>
								<div class="hidden col-sm-2">
									<div class="row">
										<div class="input-group">
											<label> Filial:&nbsp;</label>
											<select name="empresaFilial" id="empresaFilial" class="chosen-select" data-placeholder="Escolha..." value="Natriz">
												<option value="Matriz">Matriz</option>
												<option value="Filial 1">Filial 1</option>
												<option value="Filial 2">Filial 2</option>
												<option value="Filial 3">Filial 3</option>
												<option value="Filial 4">Filial 4</option>
											</select>
										</div>
									</div>
								</div>
								<div id="divAnoBordo" class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label>Ano:&nbsp;</label>
											<select name="anoBordo" id="anoBordo" class="chosen-select" data-placeholder="Escolha..." value="2023" onchange="javascript:formataData();">
												{{#each anos}}
													<option value="{{ano_nome}}">{{ano_nome}}</option>
												{{/each}}
											</select>
										</div>
									</div>
								</div>
								<div id="divMesBordo" class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label for="id-date-picker-1">Mês:&nbsp;</label>
											<select name="mesBordo" id="mesBordo" class="chosen-select" data-placeholder="Escolha..." value="Janeiro" onchange="javascript:formataData();">
												<option value="0">Janeiro</option>
												<option value="1">Fevereiro</option>
												<option value="2">Março</option>
												<option value="3">Abril</option>
												<option value="4">Maio</option>
												<option value="5">Junho</option>
												<option value="6">Julho</option>
												<option value="7">Agosto</option>
												<option value="8">Setembro</option>
												<option value="9">Outubro</option>
												<option value="10">Novembro</option>
												<option value="11">Dezembro</option>
											</select>
										</div>
									</div>
								</div>
								<div id="divDataFil" class="col-sm-2">
									<div class="input-group">
										<label>Data:&nbsp;</label>
										<input style="height: 30px;" id="dataFil" name="dataFil" type="date" onchange="javascript:formataData();">
										<input class="hidden" id="dataFinal" name="dataFinal" />
									</div>
								</div>

								<div class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label>Tipo de filtro:&nbsp;</label>
											<select name="tratTipoPessoa" id="tratTipoPessoa" class="chosen-select" data-placeholder="Escolha..." value="Geral" onchange="javascript:trocaFilpessoa()">
												<option value="Geral">Geral</option>
												<option value="Beneficiario">Beneficiário</option>
												<option value="Terapeuta">Terapeuta</option>
											</select>
										</div>
									</div>
								</div>
								<div id="divBordoBeneficiario" class="col-xs-12 col-sm-4">
									<div class="row">
										<div class="input-group">
											<label>Beneficiário:&nbsp;</label>
											<select name="tratBeneficiario" id="tratBeneficiario" class="chosen-select" data-placeholder="Escolha..." value="">
												{{#each benes}}
													<option value="{{_id}}">{{bene_nome}}</option>
												{{/each}}
											</select>
										</div>
									</div>
								</div>
								<div id="divBordoTerapeuta" class="col-xs-12 col-sm-2">
									<div class="row">
										<div class="input-group">
											<label>Terapeuta:&nbsp;</label>
											<select name="tratTerapeuta" id="tratTerapeuta" class="chosen-select" data-placeholder="Escolha..." value="">
												{{#each terapeutas}}
													<option value="{{_id}}">{{usuario_nome}}</option>
												{{/each}}
											</select>
										</div>
									</div>
								</div>
								<div class="row">
									<button name="acaoPesquisar" id="acaoPesquisar" type="submit" class="btn btn-xs btn-danger" style="margin-left: 25px;">
										<i class="ace-icon fa fa-search-plus "></i>
										Filtrar
									</button>
									
								</div>
								<hr>
							</div>
							
						</form>
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<div class="row">
									<div class="col-xs-12">
										<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
											<thead style="font-size: 11px;">
												<tr>
													<th tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="3" >Plano Tratamento</th>
													<th tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="2" >Padrão</th>
													<th tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="4" >Ocupacional</th>
													<th tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="3" >Obs</th>
												</tr>
												<tr role="row">
													
													<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1" >Tipo Plano:</th>
													<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data Plano:</th>
													<th class="sorting" tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="1" >Beneficiário:</th>
													<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapeuta:</th>
													<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapia:</th>
													<th class="sorting" tabindex="4" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapeuta IS:</th>
													<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapia:</th>
													<th class="sorting" tabindex="5" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapeuta AVD:</th>
													<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapia:</th>
													<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data cadastro:</th>
													<th class="sorting" tabindex="7" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data edição:</th>
													<th >Ação</th>
												</tr>
											</thead>
											<tbody style="font-size: 11px;">
												{{#each trats}}
													
														<tr role="row" class="odd">
															
															<td>
																{{#ifEqual this.trat_planotipo "Padrão"}}
																	<span class="label label-sm label-warning arrowed">{{trat_planotipo}}</span>
																{{else}}
																	<span class="label label-sm label-danger arrowed">{{trat_planotipo}}</span>
																{{/ifEqual}}
															</td>
															<td>{{tratdata}}</td>
															<td>
															{{#each ../benes}}
																{{#ifEqual this._id ../trat_beneid}}
																	{{bene_nome}}
																{{/ifEqual}}
															{{/each}}
															</td>
															<td>
																{{#each ../usuarios}}
																	{{#ifEqual this._id ../trat_terapeutaidpad}}
																		{{usuario_nome}}
																	{{/ifEqual}}
																{{/each}}
															</td>
															<td>
																{{trat_especialidadepad}}
															</td>
															
															<td>
																{{#each ../usuarios}}
																	{{#ifEqual this._id ../trat_terapeutaidis}}
																		{{usuario_nome}}
																	{{/ifEqual}}
																{{/each}}
															</td>
															<td>
																{{trat_especialidadeis}}
															</td>
															<td>
																{{#each ../usuarios}}
																	{{#ifEqual this._id ../trat_terapeutaidavd}}
																		{{usuario_nome}}
																	{{/ifEqual}}
																{{/each}}
															</td>
															<td>
																{{trat_especialidadeavd}}
															</td>
															
															<td >{{datacad}}</td>
															<td >
															{{#if dataedi}}
																{{#ifEqual this.dataedi "NaN-NaN-NaN"}}
																	&nbsp;
																	{{else}}
																		{{dataedi}}
																{{/ifEqual}}
															{{else}}
																&nbsp;
															{{/if}}
															</td>
															<td>
																<div class="action-buttons" style="display: flex; justify-content: center; gap: 8px;">
																	<a class="green" href="/menu/area/plano/edi/{{_id}}" title="Editar">
																		<i class="ace-icon fa fa-search bigger-130"></i>
																	</a>
																	<!-- Botão de deletar com modal -->
																	<a class="red cursor-pointer" title="Deletar" 
																	onclick="abreModalDeletar('{{_id}}', '{{#each ../benes}}{{#ifEqual this._id ../trat_beneid}}{{bene_nome}}{{/ifEqual}}{{/each}}')">
																		<i class="ace-icon fa fa-trash bigger-130"></i>
																	</a>
																	<a class="pink" href="/menu/area/plano/imp/{{_id}}" title="Imprimir">
																		<i class="ace-icon fa fa-file-pdf-o bigger-130"></i>
																	</a>
																</div>
															</td>
														</tr>
													
												{{/each}}
											</tbody>
										</table>
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->
			<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse display">
				<i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
			</a>
		</div><!-- /.main-container ace-save-state -->
		<!-- MODAL DE CONFIRMAÇÃO DE EXCLUSÃO LÓGICA -->
		<div id="modalDeletar" class="modal fade" tabindex="-1" role="dialog">
			<div class="modal-dialog" role="document">
				<div class="modal-content">
					<form id="formDeletarLogico" method="POST" action="/menu/area/plano/lixo/">
						<div class="modal-header">
							<h4 class="modal-title text-danger">
								<i class="ace-icon fa fa-warning"></i> Confirmar Exclusão
							</h4>
							<button type="button" class="close" data-dismiss="modal" aria-label="Close">
								<span aria-hidden="true">&times;</span>
							</button>
						</div>
						<div class="modal-body">
							<input type="hidden" id="tratIdDeletar" name="tratId" value="">
							
							<div class="alert alert-warning">
								<strong>Atenção:</strong> Esta ação enviará o plano para a lixeira. 
							</div>
							
							<div class="form-group">
								<label><i class="ace-icon fa fa-user"></i> Beneficiário:</label>
								<p class="form-control-static" id="modalBeneNome"></p>
							</div>
							
							<div class="form-group">
								<label><i class="ace-icon fa fa-clock-o"></i> Data/Hora da Exclusão:</label>
								<p class="form-control-static" id="modalDataHora"></p>
							</div>
							
							<div class="form-group">
								<label><i class="ace-icon fa fa-user"></i> Usuário Responsável:</label>
								<p class="form-control-static" id="modalUsuarioNome">{{usuarioNomeLogado}}</p>
							</div>
							
							<div class="form-group has-feedback">
								<label class="control-label" for="motivoDeletar">
									<i class="ace-icon fa fa-exclamation-triangle text-orange"></i> 
									Motivo da Exclusão <span class="text-danger">*</span>:
								</label>
								<textarea class="form-control" id="motivoDeletar" name="motivo" 
										rows="3" placeholder="Descreva o motivo da exclusão..." required></textarea>
								<span class="help-block">Campo obrigatório. Mínimo de 10 caracteres.</span>
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-default" data-dismiss="modal">
								<i class="ace-icon fa fa-times"></i> Cancelar
							</button>
							<button type="submit" class="btn btn-danger" id="btnConfirmarDeletar">
								<i class="ace-icon fa fa-trash"></i> Confirmar Exclusão
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>
		<!-- basic scripts -->

		<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		

		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
			"language": { "url": "/js/lang/datatable-pt-br.json" },
			"aaSorting": [],
			"aoColumns": [ null, null, null,null, null, null, null, null, null, null, null, { "bSortable": false }],
			"responsive": true,
