			function carregaBody() {
				console.log("🟢 Iniciando carregaBody...");
				
				// 🔹 Helper: formata ISO → yyyy-mm-dd para input[date]
				function formatarParaInputDate(iso) {
					if (!iso) return "";
					const d = new Date(iso);
					if (isNaN(d)) return iso; // já vem formatado?
					return d.toISOString().split('T')[0];
				}

				// 🔹 Helper: atualiza Chosen se existir
				function atualizaCampo(id, valor) {
					const el = document.getElementById(id);
					if (!el) {
						console.warn(`⚠️ Campo não encontrado: #${id}`);
						return false;
					}
					
					// Checkbox
					if (el.type === "checkbox") {
						el.checked = (valor === "true" || valor === "1" || valor === true);
						console.log(`✅ Checkbox #${id} = ${el.checked}`);
						return true;
					}
					
					// Radio: marca pelo value dentro do mesmo name
					if (el.type === "radio") {
						document.querySelectorAll(`input[name="${el.name}"]`).forEach(r => {
							r.checked = (r.value === valor);
						});
						console.log(`✅ Radio group "${el.name}" marcado com valor: ${valor}`);
						return true;
					}
					
					// Select com Chosen
					if (el.tagName === "SELECT") {
						el.value = valor;
						if (typeof jQuery !== 'undefined' && jQuery.fn.chosen) {
							jQuery(el).trigger('chosen:updated');
							console.log(`✅ Select Chosen #${id} atualizado`);
						}
						return true;
					}
					
					// Date input
					if (el.type === "date" && valor) {
						el.value = formatarParaInputDate(valor);
						console.log(`✅ Date #${id} = ${el.value}`);
						return true;
					}
					
					// Text, textarea, number, etc.
					el.value = valor ?? "";
					console.log(`✅ Campo #${id} = "${el.value}"`);
					return true;
				}

				// 🔹 Itera sobre todos os campos *Edi*
				const inputsEdi = document.querySelectorAll('#divCarrega input[id$="Edi"]');
				console.log(`📦 Encontrados ${inputsEdi.length} campos Edi para popular`);
				
				inputsEdi.forEach(inputEdi => {
					try {
						const idEdi = inputEdi.id; // ex: avafisiodataavaEdi
						const valor = inputEdi.value;
						const idBase = idEdi.replace(/Edi$/, ''); // remove "Edi" do final
						
						// Ignora campos que não devem ser populados diretamente
						if (['id', 'avafisio_id'].includes(idBase)) return;
						
						atualizaCampo(idBase, valor);
					} catch (err) {
						console.error(`❌ Erro ao popular ${inputEdi?.id}:`, err);
					}
				});
				
				// 🔹 Após popular todos os campos Edi, popula dados do beneficiário
					function populaDadosBeneficiarioEdicao() {
						// Data de nascimento (formata para yyyy-MM-dd)
						const beneDatanascEdi = document.getElementById("beneDatanascEdi")?.value;
						if (beneDatanascEdi && beneDatanascEdi !== "undefined") {
							const dataFmt = new Date(beneDatanascEdi);
							if (!isNaN(dataFmt)) {
								document.getElementById("beneDatanasc").value = formataData(dataFmt);
								// Recalcula idade se necessário
								document.getElementById("beneIdade").value = calculaIdade(dataFmt);
							}
						}
						
						// Idade (caso já venha calculada do backend)
						const beneIdadeEdi = document.getElementById("beneIdadeEdi")?.value;
						if (beneIdadeEdi && beneIdadeEdi !== "undefined") {
							document.getElementById("beneIdade").value = beneIdadeEdi;
						}
						
						// Diagnóstico
						const laudoDiagEdi = document.getElementById("laudoDiagEdi")?.value;
						if (laudoDiagEdi && laudoDiagEdi !== "undefined") {
							document.getElementById("laudoDiag").value = laudoDiagEdi;
						}
						
						console.log("✅ Dados do beneficiário populados na edição");
					}

					setTimeout(() => {
						populaDadosBeneficiarioEdicao();
					}, 50); // Pequeno delay para garantir que os campos já existem no DOM
					
				console.log("✅ carregaBody finalizado!");
			}

			function atualizaData(){
				var dataIso = document.getElementById("b").value+"T00:00:00.000Z";
				var dataFmt = new Date(dataIso);
				console.log(dataFmt.toISOString());
				document.getElementById("a").value = dataFmt;
			}
			function formataData(date) {//yyyy-MM-dd
				var d = new Date(date);
				if (d.getTimezoneOffset() == 180){
					d.setHours(d.getHours()+3);
				}
				console.log("d:"+d);
					month = '' + (d.getMonth() + 1);
					day = '' + d.getDate();
					year = d.getFullYear();

				if (month.length == 1) {
					month = '0' + month;
				}
					
				if (day.length == 1) {
					day = '0' + day;
				}

				return [year, month, day].join('-');
			}
			function atualizaDadosbene(){
				let beneid = document.getElementById("tratBeneid").value;

				var dataIso = new Date(document.getElementById(beneid+"_beneDatanasc").value);
				if ((""+dataIso.toLocaleTimeString()+"").substring(0,2) != "00") {
					let num = parseInt((""+dataIso.toLocaleTimeString()+"").substring(0,2));
					let dif = 24-num;
					dataIso = new Date(dataIso.getTime() + dif * 60 * 60 * 1000)//add 3h ao gtm
				}
				if (dataIso != undefined && dataIso != "undefined"){
					var dataFmt = new Date(dataIso);
					document.getElementById("beneDatanasc").value = formataData(dataFmt);//document.getElementById("_beneDatanasc").value;
					document.getElementById("beneIdade").value = calculaIdade(dataFmt);
				}
				console.log("beneid:"+beneid)
				console.log(document.getElementById(beneid+"_laudoDiagEdi"));
				if (document.getElementById(beneid+"_laudoDiagEdi") != "undefined" && document.getElementById(beneid+"_laudoDiagEdi") != null){
					document.getElementById("laudoDiag").value = document.getElementById(beneid+"_laudoDiagEdi").value;
				}
				//document.getElementById("beneMae").value = document.getElementById(beneid+"_beneMae").value;
				//document.getElementById("benePai").value = document.getElementById(beneid+"_benePai").value;
			}
			function calculaIdade(dataFmt) {
				// Data atual
				const hoje = new Date();

				// Data de aniversário
				const aniversario = new Date(dataFmt);

				// Cálculo da idade
				let idadeAnos = hoje.getFullYear() - aniversario.getFullYear();
				let idadeMeses = hoje.getMonth() - aniversario.getMonth();

				// Ajuste caso o dia de aniversário ainda não tenha ocorrido este ano
				if (hoje.getDate() < aniversario.getDate()) {
					idadeMeses--;
				}

				// Se o mês do aniversário for maior que o mês atual, ajusta a idade
				if (idadeMeses < 0) {
					idadeAnos--;
					idadeMeses += 12;
				}
				return (idadeAnos + " anos e " + (""+idadeMeses+"").replace("-","") + " meses.");
				
			}
		</script>
