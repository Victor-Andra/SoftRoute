<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista de Planos de Tratamentos</title>
		<style>
			#dynamic-table {
				table-layout: fixed;
				width: 100%;
				border-collapse: collapse;
				font-size: 11px;
			}

			/* === COLUNAS DE DATA === */
			#dynamic-table th:nth-child(2),
			#dynamic-table td:nth-child(2) {
				width: 70px !important;
				text-align: center;
				white-space: normal;
				word-wrap: break-word;
			}

			#dynamic-table th:nth-child(10),
			#dynamic-table td:nth-child(10),
			#dynamic-table th:nth-child(11),
			#dynamic-table td:nth-child(11) {
				width: 70px !important;
				text-align: center;
				white-space: normal;
				word-wrap: break-word;
			}

			/* === COLUNA AÇÃO === */
			#dynamic-table th:nth-child(12),
			#dynamic-table td:nth-child(12) {
				width: 80px !important;
				text-align: center;
				padding: 4px;
			}

			/* === BENEFICIÁRIO === */
			#dynamic-table th:nth-child(3),
			#dynamic-table td:nth-child(3) {
				width: 180px !important;
				word-wrap: break-word;
				white-space: normal;
				overflow: hidden;
			}

			/* === TERAPEUTAS === */
			#dynamic-table th:nth-child(4),
			#dynamic-table td:nth-child(4),
			#dynamic-table th:nth-child(6),
			#dynamic-table td:nth-child(6),
			#dynamic-table th:nth-child(8),
			#dynamic-table td:nth-child(8) {
				width: 120px !important;
				word-wrap: break-word;
				white-space: normal;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			/* === TERAPIAS === */
			#dynamic-table th:nth-child(5),
			#dynamic-table td:nth-child(5),
			#dynamic-table th:nth-child(7),
			#dynamic-table td:nth-child(7),
			#dynamic-table th:nth-child(9),
			#dynamic-table td:nth-child(9) {
				width: 130px !important;
				word-break: break-all;
				white-space: normal;
				overflow: hidden;
				text-overflow: ellipsis;
				line-height: 1.3;
				padding: 5px 4px;
			}

			/* === TIPO DE PLANO === */
			#dynamic-table th:nth-child(1),
			#dynamic-table td:nth-child(1) {
				width: 90px !important;
				text-align: center;
			}

			/* === GERAL === */
			#dynamic-table td, 
			#dynamic-table th {
				overflow: hidden;
				text-overflow: ellipsis;
				padding: 5px 4px;
				line-height: 1.3;
			}
			
			/* Cursor pointer para links clicáveis */
			.cursor-pointer { cursor: pointer; }
		</style>
		
		<script type="text/javascript">
			function ocultaEditar(){
				let biscoito = procuraBiscoito("lvlUsu");
				document.getElementById("botaoEditar").value;
			}
			function ajustaData(){
				let fullDatas = document.getElementsByName("fullData");
				fullDatas.forEach((elementox)=>{
					let id = "tratdata"+elementox.id;
					let dat = new Date(elementox.value);
					let mes = (dat.getMonth()+1).toString();
					let dia = (dat.getUTCDate()).toString();

					if (mes.length == 1){ mes = "0"+mes; }
					if (dia.length == 1){ dia = "0"+dia; }
					let fulldate=(dia+"/"+mes+"/"+dat.getFullYear()).toString();
				})
			}
			
			function trocaFiltroData(){
				let fill = document.getElementById("tipoData").value;
				if(fill == "Ano"){
					document.getElementById("divAnoBordo").hidden = false;
					document.getElementById("divMesBordo").hidden = true;
					document.getElementById("divDataFil").hidden = true;
				} else if(fill == "Ano/Mes"){
					document.getElementById("divAnoBordo").hidden = false;
					document.getElementById("divMesBordo").hidden = false;
					document.getElementById("divDataFil").hidden = true;
				} else if (fill == "Semana"){
					document.getElementById("divAnoBordo").hidden = true;
					document.getElementById("divMesBordo").hidden = true;
					document.getElementById("divDataFil").hidden = false;
				} else {
					document.getElementById("divAnoBordo").hidden = true;
					document.getElementById("divMesBordo").hidden = true;
					document.getElementById("divDataFil").hidden = false;
				}
			}
			function trocaFilpessoa() {
				let fillTipopessoa = document.getElementById("tratTipoPessoa").value;
				if(fillTipopessoa == "Geral"){
					document.getElementById("divBordoBeneficiario").hidden = true;
					document.getElementById("divBordoTerapeuta").hidden = true;
				} else if(fillTipopessoa == "Beneficiario"){
					document.getElementById("divBordoBeneficiario").hidden = false;
					document.getElementById("divBordoTerapeuta").hidden = true;
				} else {
					document.getElementById("divBordoBeneficiario").hidden = true;
					document.getElementById("divBordoTerapeuta").hidden = false;
				}
			}
			function carregaBody(){
				trocaFiltroData();
				trocaFilpessoa();
				formataData();
				
				// === RESTAURAR FILTROS SE carregaFiltro == "true" ===
				if (document.getElementById("carregaFiltro")?.value == "true"){
					
					// Restaurar tipo de filtro de data
					const tipoDataFil = document.getElementById("tipoDataFil")?.value;
					if(tipoDataFil){
						document.getElementById("tipoData").value = tipoDataFil;
						trocaFiltroData(); // Atualiza visibilidade dos campos
					}
					
					// Restaurar Ano/Mês se aplicável
					if(tipoDataFil == "Ano/Mes"){
						const anoFil = document.getElementById("anoBordoFil")?.value;
						const mesFil = document.getElementById("mesBordoFil")?.value;
						if(anoFil) document.getElementById("anoBordo").value = anoFil;
						if(mesFil) document.getElementById("mesBordo").value = mesFil;
					} else {
						// Restaurar data única
						const dataFil = document.getElementById("dataFinalFil")?.value;
						if(dataFil) document.getElementById("dataFil").value = dataFil;
					}
					
					// Restaurar tipo de filtro de pessoa
					const tipoPessoaFil = document.getElementById("tipoPessoaFil")?.value;
					if(tipoPessoaFil){
						document.getElementById("tratTipoPessoa").value = tipoPessoaFil;
						trocaFilpessoa(); // Atualiza visibilidade dos campos
					}
					
					// Restaurar Beneficiário/Terapeuta
					const beneFil = document.getElementById("tratBeneficiarioFil")?.value;
					const terpFil = document.getElementById("tratTerapeutaFil")?.value;
					if(beneFil) document.getElementById("tratBeneficiario").value = beneFil;
					if(terpFil) document.getElementById("tratTerapeuta").value = terpFil;
					
					// Atualizar Chosen selects se existir
					if(typeof $ !== 'undefined' && $.fn.chosen){
						$('#tipoData, #anoBordo, #mesBordo, #tratTipoPessoa, #tratBeneficiario, #tratTerapeuta')
							.trigger('chosen:updated');
					}
				}
				
				document.getElementById("atualizaValores").value = "false";
			}

			function formataData(){
				let dtInput = document.getElementById('dataFil');
				let dt = dtInput.value;
				if (!dt) return;
				let [ano, mes, dia] = dt.split("-");
				let fulldate = `${ano}-${mes}-${dia} 00:00:00.000Z`;
				document.getElementById('dataFinal').value = fulldate;
			}
			
			// === FUNÇÃO PARA ABRIR MODAL DE DELETAÇÃO ===
			function abreModalDeletar(idTrat, nomeBeneficiario) {
				document.getElementById('tratIdDeletar').value = idTrat;
				document.getElementById('modalBeneNome').textContent = nomeBeneficiario || 'Não identificado';
				
				const agora = new Date();
				const dataFormatada = agora.toLocaleDateString('pt-BR') + ' ' + 
									agora.toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'});
				document.getElementById('modalDataHora').textContent = dataFormatada;
				
				const campoMotivo = document.getElementById('motivoDeletar');
				campoMotivo.value = '';
				campoMotivo.focus();
				
				$('#modalDeletar').modal('show');
			}
			
			// === CONFIRMAÇÃO DE DELETAÇÃO (ENVIA VIA GET) ===
			function confirmarDeletar() {
				const motivo = document.getElementById('motivoDeletar').value.trim();
				const id = document.getElementById('tratIdDeletar').value;
				
				if (motivo.length < 10) {
					alert('⚠️ Por favor, descreva um motivo mais detalhado (mínimo 10 caracteres).');
					document.getElementById('motivoDeletar').focus();
					return false;
				}
				
				const motivoEncoded = encodeURIComponent(motivo);
				const btn = document.getElementById('btnConfirmarDeletar');
				btn.disabled = true;
				btn.innerHTML = '<i class="ace-icon fa fa-spinner fa-spin"></i> Processando...';
				
				// 🔁 Redireciona via GET com motivo na query string
				window.location.href = `/menu/area/plano/lixo/${id}?motivo=${motivoEncoded}`;
				return false;
			}
			
			// === OCULTAR BOTÃO DE DELETE POR PERMISSÃO ===
			function ocultaDelete(){
				let perfilAtual = document.getElementById("perfilAtual")?.value;
				
				// ✅ MESMOS IDs DO BACKEND (fail-safe também no frontend)
				const idsPermitidos = ['62421801a12aa557219a0fb9', '62421857a12aa557219a0fc1'];
				
				// ✅ FAIL-SAFE: Se não tiver perfil ou não estiver na lista, ESCONDE
				if (!perfilAtual || !idsPermitidos.includes(perfilAtual)) {
					document.querySelectorAll('a[title="Deletar"]').forEach(el => {
						el.style.display = 'none';
					});
					console.log("✗ Permissão de exclusão negada - perfil:", perfilAtual);
				} else {
					console.log("✓ Permissão de exclusão concedida");
				}
			}
		</script>
	</head>
	
	<body onload="javascript:controlaNave();carregaBody();" class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Route</a>
							</li>
							<li class="active">Lista de Planos de Tratamentos</li>
						</ul>
					</div>
					
					<div id="divCarrega" class="hidden">
						<input type="hidden" id="perfilAtual" name="perfilAtual" value="{{perfilAtual}}" />
					</div>
					<!-- === INPUTS HIDDEN PARA PERSISTÊNCIA DE FILTROS === -->
					<div class="hidden">
						<input id="carregaFiltro" value="{{carregaFiltro}}" />
						<input id="tipoDataFil" value="{{tipoData}}" />
						<input id="tipoPessoaFil" value="{{tipoPessoa}}" />
						<input id="anoBordoFil" value="{{anoBordo}}" />
						<input id="mesBordoFil" value="{{mesBordo}}" />
						<input id="dataFinalFil" value="{{dataFinal}}" />
						<input id="tratBeneficiarioFil" value="{{tratBeneficiario}}" />
						<input id="tratTerapeutaFil" value="{{tratTerapeuta}}" />
					</div>
					
					{{#compareString flash.sucesso "true"}}
						<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-success">
							<p>
								<strong><i class="ace-icon fa fa-check"></i> {{flash.texto}}</strong>
								<button type="button" class="close" onclick="javascript:OcultaMsg()">
									<i class="ace-icon fa fa-times"></i>
								</button>
							</p>
						</div>
					{{else}}
						{{#compareString flash.sucesso "false"}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">
								<p>
									<strong><i class="ace-icon fa fa-times"></i> {{flash.texto}}</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()">
										<i class="ace-icon fa fa-times"></i>
									</button>
								</p>
							</div>
						{{/compareString}}
					{{/compareString}}
					
					<div class="page-content">
						<form id="divFormPesquisa" class="form-horizontal" role="form" action="/menu/area/plano/lisF" method="POST">
							<div class="col-xs-12">
								<div class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label>Filtro por:&nbsp;</label>
											<select name="tipoData" id="tipoData" class="select2" data-placeholder="Escolha..." onchange="javascript:trocaFiltroData()">
												<option value="Ano">Ano</option>
												<option value="Ano/Mes" selected>Ano/Mês</option>
												<option value="Semana">Semana</option>
												<option value="Dia">Dia</option>
											</select>
										</div>
									</div>
								</div>
								<div class="hidden col-sm-2">
									<div class="row">
										<div class="input-group">
											<label> Filial:&nbsp;</label>
											<select name="empresaFilial" id="empresaFilial" class="select2" data-placeholder="Escolha..." value="Matriz">
												<option value="Matriz">Matriz</option>
												<option value="Filial 1">Filial 1</option>
												<option value="Filial 2">Filial 2</option>
												<option value="Filial 3">Filial 3</option>
												<option value="Filial 4">Filial 4</option>
											</select>
										</div>
									</div>
								</div>
								<div id="divAnoBordo" class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label>Ano:&nbsp;</label>
											<select name="anoBordo" id="anoBordo" class="select2" data-placeholder="Escolha..." value="2023" onchange="javascript:formataData();">
												{{#each anos}}
													<option value="{{ano_nome}}">{{ano_nome}}</option>
												{{/each}}
											</select>
										</div>
									</div>
								</div>
								<div id="divMesBordo" class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label for="id-date-picker-1">Mês:&nbsp;</label>
											<select name="mesBordo" id="mesBordo" class="select2" data-placeholder="Escolha..." value="Janeiro" onchange="javascript:formataData();">
												<option value="0">Janeiro</option>
												<option value="1">Fevereiro</option>
												<option value="2">Março</option>
												<option value="3">Abril</option>
												<option value="4">Maio</option>
												<option value="5">Junho</option>
												<option value="6">Julho</option>
												<option value="7">Agosto</option>
												<option value="8">Setembro</option>
												<option value="9">Outubro</option>
												<option value="10">Novembro</option>
												<option value="11">Dezembro</option>
											</select>
										</div>
									</div>
								</div>
								<div id="divDataFil" class="col-sm-2">
									<div class="input-group">
										<label>Data:&nbsp;</label>
										<input style="height: 30px;" id="dataFil" name="dataFil" type="date" onchange="javascript:formataData();">
										<input class="hidden" id="dataFinal" name="dataFinal" />
									</div>
								</div>

								<div class="col-sm-2">
									<div class="row">
										<div class="input-group">
											<label>Tipo de filtro:&nbsp;</label>
											<select name="tratTipoPessoa" id="tratTipoPessoa" class="select2" data-placeholder="Escolha..." value="Geral" onchange="javascript:trocaFilpessoa()">
												<option value="Geral">Geral</option>
												<option value="Beneficiario">Beneficiário</option>
												<option value="Terapeuta">Terapeuta</option>
											</select>
										</div>
									</div>
								</div>
								<div id="divBordoBeneficiario" class="col-xs-12 col-sm-4">
									<div class="row">
										<div class="input-group">
											<label>Beneficiário:&nbsp;</label>
											<select name="tratBeneficiario" id="tratBeneficiario" class="select2" data-placeholder="Escolha..." value="">
												{{#each benes}}
													<option value="{{_id}}">{{bene_nome}}</option>
												{{/each}}
											</select>
										</div>
									</div>
								</div>
								<div id="divBordoTerapeuta" class="col-xs-12 col-sm-2">
									<div class="row">
										<div class="input-group">
											<label>Terapeuta:&nbsp;</label>
											<select name="tratTerapeuta" id="tratTerapeuta" class="select2" data-placeholder="Escolha..." value="">
												{{#each terapeutas}}
													<option value="{{_id}}">{{usuario_nome}}</option>
												{{/each}}
											</select>
										</div>
									</div>
								</div>
								<div class="row">
									<button name="acaoPesquisar" id="acaoPesquisar" type="submit" class="btn btn-xs btn-danger" style="margin-left: 25px;">
										<i class="ace-icon fa fa-search-plus "></i>
										Filtrar
									</button>
								</div>
								<hr>
							</div>
						</form>
						
						<div class="row">
							<div class="col-xs-12">
								<div class="row">
									<div class="col-xs-12">
										<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid">
											<thead style="font-size: 11px;">
												<tr>
													<th rowspan="1" colspan="3">Plano Tratamento</th>
													<th rowspan="1" colspan="2">Padrão</th>
													<th rowspan="1" colspan="4">Ocupacional</th>
													<th rowspan="1" colspan="3">Obs</th>
												</tr>
												<tr role="row">
													<th class="sorting">Tipo Plano:</th>
													<th class="sorting">Data Plano:</th>
													<th class="sorting">Beneficiário:</th>
													<th class="sorting">Terapeuta:</th>
													<th class="sorting">Terapia:</th>
													<th class="sorting">Terapeuta IS:</th>
													<th class="sorting">Terapia:</th>
													<th class="sorting">Terapeuta AVD:</th>
													<th class="sorting">Terapia:</th>
													<th class="sorting">Data cadastro:</th>
													<th class="sorting">Data edição:</th>
													<th>Ação</th>
												</tr>
											</thead>
											<tbody style="font-size: 11px;">
												{{#each trats}}
													<tr role="row" class="odd">
														<td>
															{{#ifEqual this.trat_planotipo "Padrão"}}
																<span class="label label-sm label-warning arrowed">{{trat_planotipo}}</span>
															{{else}}
																<span class="label label-sm label-danger arrowed">{{trat_planotipo}}</span>
															{{/ifEqual}}
														</td>
