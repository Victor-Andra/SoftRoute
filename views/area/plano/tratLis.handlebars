		<script type="text/javascript">
			function ocultaEditar(){
				let biscoito = procuraBiscoito("lvlUsu");
				document.getElementById("botaoEditar").value;
			}
			function ajustaData(){
				let fullDatas = document.getElementsByName("fullData");
				fullDatas.forEach((elementox)=>{
					let id = "tratdata"+elementox.id;
					let dat = new Date(elementox.value);
					let mes = (dat.getMonth()+1).toString();
					let dia = (dat.getUTCDate()).toString();

					if (mes.length == 1){ mes = "0"+mes; }
					if (dia.length == 1){ dia = "0"+dia; }
					let fulldate=(dia+"/"+mes+"/"+dat.getFullYear()).toString();
				})
			}
			
			function formataData(){
    let tipo = document.getElementById("tipoData").value;
    if(tipo == "Ano/Mes"){
        let ano = document.getElementById('anoAtend').value;
        let mes = document.getElementById('mesAtend').value;
        if (!ano || !mes) return;
        let dat = new Date(Date.UTC(parseInt(ano), parseInt(mes), 1));
        let mesStr = (dat.getUTCMonth() + 1).toString().padStart(2, '0');
        let diaStr = dat.getUTCDate().toString().padStart(2, '0');
        let fulldate = `${dat.getUTCFullYear()}-${mesStr}-${diaStr}T00:00:00.000Z`;
        document.getElementById('dataFinal').value = fulldate;
    } else if (tipo == "Semana" || tipo == "Dia"){
        let dataInput = document.getElementById('dataFil').value;
        if (!dataInput) return;
        let dat = new Date(dataInput);
        let mesStr = (dat.getUTCMonth() + 1).toString().padStart(2, '0');
        let diaStr = dat.getUTCDate().toString().padStart(2, '0');
        let fulldate = `${dat.getUTCFullYear()}-${mesStr}-${diaStr}`;
        document.getElementById('dataFinal').value = fulldate;
    }
}

function trocaFiltroData(){
    const tipo = document.getElementById("tipoData").value;
    
    // 1. Oculta tudo primeiro
    document.getElementById("divAnoAtend").classList.add('hidden-div');
    document.getElementById("divMesAtend").classList.add('hidden-div');
    document.getElementById("divDataFil").classList.add('hidden-div');
    
    // 2. Mostra apenas o relevante
    if(tipo == "Ano/Mes"){
        document.getElementById("divAnoAtend").classList.remove('hidden-div');
        document.getElementById("divMesAtend").classList.remove('hidden-div');
    } else if (tipo == "Semana" || tipo == "Dia"){
        document.getElementById("divDataFil").classList.remove('hidden-div');
    }
}

function trocaFilpessoa() {
    const tipo = document.getElementById("atendTipoPessoa").value;

    // 1. Oculta todos primeiro
    document.getElementById("divAtendBeneficiario").classList.add('hidden-div');
    document.getElementById("divAtendTerapeuta").classList.add('hidden-div');

    // 2. Mostra apenas o relevante
    if (tipo === 'Beneficiario') {
        document.getElementById("divAtendBeneficiario").classList.remove('hidden-div');
    } else if (tipo === 'Terapeuta') {
        document.getElementById("divAtendTerapeuta").classList.remove('hidden-div');
    }
}

function carregaBody() {
    // ETAPA 1: Definir os valores crus nos inputs (Baseado no filtro salvo ou no padrão)
    if (document.getElementById("carregaFiltro").value == "true") {
        document.getElementById("tipoData").value = document.getElementById("tipoDataFil").value || "Ano/Mes";
        document.getElementById("atendTipoPessoa").value = document.getElementById("tipoPessoaFil").value || "Geral";

        if (document.getElementById("tipoData").value == "Ano/Mes") {
            document.getElementById("anoAtend").value = document.getElementById("anoAtendFil").value || "";
            document.getElementById("mesAtend").value = document.getElementById("mesAtendFil").value || "0";
        } else {
            let dataFilVal = document.getElementById("dataFinalFil").value;
            if (dataFilVal) document.getElementById("dataFil").value = dataFilVal.split('T')[0];
        }

        if (document.getElementById("atendTipoPessoa").value == "Beneficiario") {
            document.getElementById("atendBeneficiario").value = document.getElementById("atendBeneficiarioFil").value || "";
        } else if (document.getElementById("atendTipoPessoa").value == "Terapeuta") {
            document.getElementById("atendTerapeuta").value = document.getElementById("atendTerapeutaFil").value || "";
        }
    } else {
        // Padrão universal na primeira carga
        document.getElementById("tipoData").value = "Ano/Mes";
        document.getElementById("atendTipoPessoa").value = "Geral";
    }

    // ETAPA 2: Aplicar a lógica de mostrar/ocultar DIVs baseado nos valores definidos acima
    trocaFiltroData();
    trocaFilpessoa();
    formataData();

    // ETAPA 3: INICIALIZAR O SELECT2 *DEPOIS* de tudo estar definido.
    // Isso faz o Select2 ler o atributo 'selected' correto do HTML e desenhar a UI certa.
    if (typeof $.fn.select2 === 'function') {
        $('.select, .select2').select2({
            placeholder: "Escolha...",
            allowClear: false,
            width: 'resolve'
        });

        // ETAPA 4: Vincular os eventos de change do Select2 para garantir reatividade
        $('#tipoData').on('change', function() {
            trocaFiltroData();
            formataData();
        });

        $('#atendTipoPessoa').on('change', function() {
            trocaFilpessoa();
        });
    }

    // Função de permissão original
    ocultaDelete(); 
}

					
			// === FUNÇÃO PARA ABRIR MODAL DE DELETAÇÃO ===
			function abreModalDeletar(idTrat, nomeBeneficiario) {
				document.getElementById('tratIdDeletar').value = idTrat;
				document.getElementById('modalBeneNome').textContent = nomeBeneficiario || 'Não identificado';
				
				const agora = new Date();
				const dataFormatada = agora.toLocaleDateString('pt-BR') + ' ' + 
									agora.toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'});
				document.getElementById('modalDataHora').textContent = dataFormatada;
				
				const campoMotivo = document.getElementById('motivoDeletar');
				campoMotivo.value = '';
				campoMotivo.focus();
				
				$('#modalDeletar').modal('show');
			}
			
			// === CONFIRMAÇÃO DE DELETAÇÃO (ENVIA VIA GET) ===
			function confirmarDeletar() {
				const motivo = document.getElementById('motivoDeletar').value.trim();
				const id = document.getElementById('tratIdDeletar').value;
				
				if (motivo.length < 10) {
					alert('⚠️ Por favor, descreva um motivo mais detalhado (mínimo 10 caracteres).');
					document.getElementById('motivoDeletar').focus();
					return false;
				}
				
				const motivoEncoded = encodeURIComponent(motivo);
				const btn = document.getElementById('btnConfirmarDeletar');
				btn.disabled = true;
				btn.innerHTML = '<i class="ace-icon fa fa-spinner fa-spin"></i> Processando...';
				
				// 🔁 Redireciona via GET com motivo na query string
				window.location.href = `/menu/area/plano/lixo/${id}?motivo=${motivoEncoded}`;
				return false;
			}
			
			// === OCULTAR BOTÃO DE DELETE POR PERMISSÃO ===
			function ocultaDelete(){
				let perfilAtual = document.getElementById("perfilAtual")?.value;
				
				// ✅ MESMOS IDs DO BACKEND (fail-safe também no frontend)
				const idsPermitidos = ['62421801a12aa557219a0fb9', '62421857a12aa557219a0fc1'];
				
				// ✅ FAIL-SAFE: Se não tiver perfil ou não estiver na lista, ESCONDE
				if (!perfilAtual || !idsPermitidos.includes(perfilAtual)) {
					document.querySelectorAll('a[title="Deletar"]').forEach(el => {
						el.style.display = 'none';
					});
					console.log("✗ Permissão de exclusão negada - perfil:", perfilAtual);
				} else {
					console.log("✓ Permissão de exclusão concedida");
				}
			}
		</script>
	</head>
	
	<body onload="javascript:controlaNave();carregaBody();" class="no-skin">
