					<div class="page-content">
						<!-- === BARRA DE PESQUISA === -->
<div class="toolbar-pesquisa">
    <h5><i class="ace-icon fa fa-search"></i> <span>Filtros de Pesquisa</span></h5>
    <form id="divFormPesquisa" class="form-inline" role="form" action="/menu/area/plano/lisF" method="POST">
        
        <!-- Tipo de Filtro -->
        <div class="form-group">
            <label>Tipo Filtro</label>
            <select name="tipoData" id="tipoData" class="form-control select" data-placeholder="Escolha..." onchange="trocaFiltroData()">
                <option value="Ano/Mes" {{#ifEqual filtroTipo "Ano/Mes"}}selected{{/ifEqual}}>Ano/Mês</option>
                <option value="Semana" {{#ifEqual filtroTipo "Semana"}}selected{{/ifEqual}}>Semana</option>
                <option value="Dia" {{#ifEqual filtroTipo "Dia"}}selected{{/ifEqual}}>Dia</option>
            </select>
        </div>
        
        <!-- Ano -->
        <div id="divAnoAtend" class="form-group">
            <label>Ano</label>
            <select name="anoAtend" id="anoAtend" class="form-control select" data-placeholder="Escolha..." onchange="formataData()">
                <option value="">Selecione...</option>
                {{#each anos}}
                    <option value="{{this.ano_nome}}" {{#ifEqual ../filtroAno this.ano_nome}}selected{{/ifEqual}}>{{this.ano_nome}}</option>
                {{/each}}
            </select>
        </div>
        
        <!-- Mês -->
        <div id="divMesAtend" class="form-group">
            <label>Mês</label>
            <select name="mesAtend" id="mesAtend" class="form-control select" data-placeholder="Escolha..." onchange="formataData()">
                <option value="0" {{#ifEqual filtroMes "0"}}selected{{/ifEqual}}>Janeiro</option>
                <option value="1" {{#ifEqual filtroMes "1"}}selected{{/ifEqual}}>Fevereiro</option>
                <option value="2" {{#ifEqual filtroMes "2"}}selected{{/ifEqual}}>Março</option>
                <option value="3" {{#ifEqual filtroMes "3"}}selected{{/ifEqual}}>Abril</option>
                <option value="4" {{#ifEqual filtroMes "4"}}selected{{/ifEqual}}>Maio</option>
                <option value="5" {{#ifEqual filtroMes "5"}}selected{{/ifEqual}}>Junho</option>
                <option value="6" {{#ifEqual filtroMes "6"}}selected{{/ifEqual}}>Julho</option>
                <option value="7" {{#ifEqual filtroMes "7"}}selected{{/ifEqual}}>Agosto</option>
                <option value="8" {{#ifEqual filtroMes "8"}}selected{{/ifEqual}}>Setembro</option>
                <option value="9" {{#ifEqual filtroMes "9"}}selected{{/ifEqual}}>Outubro</option>
                <option value="10" {{#ifEqual filtroMes "10"}}selected{{/ifEqual}}>Novembro</option>
                <option value="11" {{#ifEqual filtroMes "11"}}selected{{/ifEqual}}>Dezembro</option>
            </select>
        </div>
        
        <!-- Data (Dia/Semana) -->
        <div id="divDataFil" class="form-group{{#ifEqual filtroTipo "Dia"}}{{else}}{{#ifEqual filtroTipo "Semana"}}{{else}} hidden-div{{/ifEqual}}{{/ifEqual}}">
            <label>Data</label>
            <input style="height: 30px;" id="dataFil" name="dataFil" type="date" value="{{filtroData}}" onchange="formataData()">
            <input class="hidden" id="dataFinal" name="dataFinal" value="{{filtroData}}" />
        </div>
        
        <!-- Tipo de Pessoa -->
        <div class="form-group">
            <label>Tipo</label>
            <select name="atendTipoPessoa" id="atendTipoPessoa" class="form-control select" data-placeholder="Escolha..." onchange="trocaFilpessoa()">
                <option value="Geral" {{#ifEqual filtroTipoPessoa "Geral"}}selected{{/ifEqual}}>Geral</option>
                <option value="Beneficiario" {{#ifEqual filtroTipoPessoa "Beneficiario"}}selected{{/ifEqual}}>Beneficiário</option>
                <option value="Terapeuta" {{#ifEqual filtroTipoPessoa "Terapeuta"}}selected{{/ifEqual}}>Terapeuta</option>
            </select>
        </div>
        
        <!-- Beneficiário -->
        <div id="divAtendBeneficiario" class="form-group{{#ifEqual filtroTipoPessoa "Beneficiario"}}{{else}} hidden-div{{/ifEqual}}">
            <label>Beneficiário</label>
            <select name="atendBeneficiario" id="atendBeneficiario" class="form-control select" data-placeholder="Escolha...">
                <option value=""></option>
                {{#each benes}}
                    <option value="{{this._id}}" {{#ifEqual ../filtroBeneficiario this._id}}selected{{/ifEqual}}>{{this.bene_nome}}</option>
                {{/each}}
            </select>
        </div>
        
        <!-- Terapeuta -->
        <div id="divAtendTerapeuta" class="form-group{{#ifEqual filtroTipoPessoa "Terapeuta"}}{{else}} hidden-div{{/ifEqual}}">
            <label>Terapeuta</label>
            <select name="atendTerapeuta" id="atendTerapeuta" class="form-control select" data-placeholder="Escolha...">
                <option value=""></option>
                {{#each terapeutas}}
                    <option value="{{this._id}}" {{#ifEqual ../filtroTerapeuta this._id}}selected{{/ifEqual}}>{{this.usuario_nome}}</option>
                {{/each}}
            </select>
        </div>
        
        <!-- Botão Pesquisar -->
        <button name="acaoPesquisar" id="acaoPesquisar" type="submit" class="btn-pesquisar">
            <i class="ace-icon fa fa-search-plus"></i> Pesquisar
        </button>
    </form>
</div>
						
						<div class="row">
							<div class="col-xs-12">
								<div class="row">
									<div class="col-xs-12">
										<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid">
											<thead style="font-size: 11px;">
												<tr>
													<th rowspan="1" colspan="3">Plano Tratamento</th>
													<th rowspan="1" colspan="2">Padrão</th>
													<th rowspan="1" colspan="4">Ocupacional</th>
													<th rowspan="1" colspan="3">Obs</th>
												</tr>
												<tr role="row">
													<th class="sorting">Tipo Plano:</th>
													<th class="sorting">Data Plano:</th>
													<th class="sorting">Beneficiário:</th>
													<th class="sorting">Terapeuta:</th>
													<th class="sorting">Terapia:</th>
													<th class="sorting">Terapeuta IS:</th>
													<th class="sorting">Terapia:</th>
													<th class="sorting">Terapeuta AVD:</th>
													<th class="sorting">Terapia:</th>
													<th class="sorting">Data cadastro:</th>
													<th class="sorting">Data edição:</th>
													<th>Ação</th>
												</tr>
											</thead>
											<tbody style="font-size: 11px;">
												{{#each trats}}
													<tr role="row" class="odd">
														<td>
															{{#ifEqual this.trat_planotipo "Padrão"}}
																<span class="label label-sm label-warning arrowed">{{trat_planotipo}}</span>
															{{else}}
																<span class="label label-sm label-danger arrowed">{{trat_planotipo}}</span>
															{{/ifEqual}}
														</td>
														<td>{{tratdata}}</td>
														<td>
															{{#each ../benes}}
																{{#ifEqual this._id ../trat_beneid}}{{bene_nome}}{{/ifEqual}}
															{{/each}}
														</td>
														<td>
															{{#each ../usuarios}}
																{{#ifEqual this._id ../trat_terapeutaidpad}}{{usuario_nome}}{{/ifEqual}}
															{{/each}}
														</td>
														<td>{{trat_especialidadepad}}</td>
														<td>
															{{#each ../usuarios}}
																{{#ifEqual this._id ../trat_terapeutaidis}}{{usuario_nome}}{{/ifEqual}}
															{{/each}}
														</td>
														<td>{{trat_especialidadeis}}</td>
														<td>
															{{#each ../usuarios}}
																{{#ifEqual this._id ../trat_terapeutaidavd}}{{usuario_nome}}{{/ifEqual}}
															{{/each}}
														</td>
														<td>{{trat_especialidadeavd}}</td>
														<td>{{datacad}}</td>
														<td>
															{{#if dataedi}}
																{{#ifEqual this.dataedi "NaN-NaN-NaN"}}&nbsp;{{else}}{{dataedi}}{{/ifEqual}}
															{{else}}&nbsp;{{/if}}
														</td>
														<td>
															<div class="action-buttons" >
																<a class="green" href="/menu/area/plano/edi/{{_id}}" title="Editar">
																	<i class="ace-icon fa fa-search bigger-130"></i>
																</a>
																
																<!-- Botão de deletar com modal -->
																<a class="red cursor-pointer" title="Deletar" 
																   onclick="abreModalDeletar('{{_id}}', '{{#each ../benes}}{{#ifEqual this._id ../trat_beneid}}{{bene_nome}}{{/ifEqual}}{{/each}}')">
																	<i class="ace-icon fa fa-trash bigger-130"></i>
																</a>
																
																<a class="pink" href="/menu/area/plano/imp/{{_id}}" title="Imprimir">
																	<i class="ace-icon fa fa-file-pdf-o bigger-130"></i>
																</a>
															</div>
														</td>
													</tr>
												{{/each}}
											</tbody>
										</table>
									</div>
								</div>				
							</div>
						</div>
					</div>
				</div>
			</div>
			
			<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse display">
				<i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
			</a>
		</div>
		
		<!-- === MODAL DE CONFIRMAÇÃO DE EXCLUSÃO LÓGICA === -->
		<!-- SEM <form> para evitar submit POST -->
		<div id="modalDeletar" class="modal fade" tabindex="-1" role="dialog">
			<div class="modal-dialog" role="document">
				<div class="modal-content">
					<div class="modal-header">
						<h4 class="modal-title text-danger">
							<i class="ace-icon fa fa-warning"></i> Confirmar Exclusão
						</h4>
						<button type="button" class="close" data-dismiss="modal" aria-label="Close">
							<span aria-hidden="true">&times;</span>
						</button>
					</div>
					<div class="modal-body">
						<input type="hidden" id="tratIdDeletar" value="">
						
						<div class="alert alert-warning">
							<strong>Atenção:</strong> Esta ação enviará o plano para a lixeira. 
							O registro não será apagado permanentemente.
						</div>
						
						<div class="form-group">
							<label><i class="ace-icon fa fa-user"></i> Beneficiário:</label>
							<p class="form-control-static" id="modalBeneNome"></p>
						</div>
						
						<div class="form-group">
							<label><i class="ace-icon fa fa-clock-o"></i> Data/Hora da Exclusão:</label>
							<p class="form-control-static" id="modalDataHora"></p>
						</div>
						
						<div class="form-group">
							<label><i class="ace-icon fa fa-user"></i> Usuário Responsável:</label>
							<p class="form-control-static" id="modalUsuarioNome">{{usuarioNomeLogado}}</p>
						</div>
						
						<div class="form-group has-feedback">
							<label class="control-label" for="motivoDeletar">
								<i class="ace-icon fa fa-exclamation-triangle text-orange"></i> 
								Motivo da Exclusão <span class="text-danger">*</span>:
							</label>
							<textarea class="form-control" id="motivoDeletar" name="motivo" 
								  rows="3" placeholder="Descreva o motivo da exclusão..." required minlength="10"></textarea>
							<span class="help-block">Campo obrigatório. Mínimo de 10 caracteres.</span>
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-default" data-dismiss="modal">
							<i class="ace-icon fa fa-times"></i> Cancelar
						</button>
						<!-- type="button" + onclick para controlar via JS -->
						<button type="button" class="btn btn-danger" id="btnConfirmarDeletar" onclick="confirmarDeletar()">
							<i class="ace-icon fa fa-trash"></i> Confirmar Exclusão
						</button>
					</div>
				</div>
			</div>
		</div>
		
		<!-- basic scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		
		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
				"language": { "url": "/js/lang/datatable-pt-br.json" },
				"aaSorting": [],
				"aoColumns": [ null, null, null, null, null, null, null, null, null, null, null, { "bSortable": false }],
				"responsive": true,
				"lengthMenu": [ 100, 200, 300],
				"lengthChange": true,
				"autoWidth": false,
				"paging": true,
				"searching": true,
				"ordering": true,
				"info": true,
				select: { style: 'multi' }
			});
		});
		
		// Resetar botão ao fechar modal
		$('#modalDeletar').on('hidden.bs.modal', function () {
			const btn = document.getElementById('btnConfirmarDeletar');
			if(btn) {
				btn.disabled = false;
				btn.innerHTML = '<i class="ace-icon fa fa-trash"></i> Confirmar Exclusão';
			}
			document.getElementById('motivoDeletar').value = '';
		});
		</script>
	</body>
</html>