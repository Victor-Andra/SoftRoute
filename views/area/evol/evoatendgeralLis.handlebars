		<script type="text/javascript">
			function evolucaoEditar(id){
				document.getElementById("idEdi").value = id;
				let form = document.getElementById("divFormPesquisa");
				form.action = ("/menu/agenda/evolucaosup");
				form.submit();
			}
			function evolucaoRemover(id){
				let form = document.getElementById("divFormPesquisa");
				let confirmado = confirm("Quer mesmo deletar esta evolução?");
				if(confirmado == true){
					document.getElementById("idDeletar").value = id;
					form.action = ("/menu/agenda/evolucaoRemoverGeral");
					form.submit();
				}
			}
			function retornar(){
				history.back();
			}
			function formataData(){
				let tipo = document.getElementById("tipoData").value;
				console.log("tipoData:"+tipoData);
				if(tipo == "Ano/Mes"){
					let dat = new Date(document.getElementById('anoAtend').value+"-"+document.getElementById('mesAtend').value+"-01 00:00:00.000Z");
					let mes = (dat.getUTCMonth()+1).toString();
					let dia = (dat.getUTCDate()).toString();
					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}
					let fulldate = (dat.getFullYear()+"-"+mes+"-"+dia+' 00:00:00.000Z').toString();
					document.getElementById('dataFinal').value = fulldate;
					console.log("dataFinal:"+document.getElementById('dataFinal').value);
				} else if (tipo == "Semana"){
					let dat = new Date(document.getElementById('dataFil').value);
					let mes = (dat.getUTCMonth()).toString();
					let dia = (dat.getUTCDate()).toString();
					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}
					let fulldate = (dat.getFullYear()+"-"+mes+"-"+dia+' 00:00:00.000Z').toString();
					document.getElementById('dataFinal').value = fulldate;
					console.log("dataFinal:"+document.getElementById('dataFinal').value);
				} else if (tipo == "Dia"){
					let dat = new Date(document.getElementById('dataFil').value);
					let mes = (dat.getUTCMonth()).toString();
					let dia = (dat.getUTCDate()).toString();
					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}
					let fulldate = (dat.getFullYear()+"-"+mes+"-"+dia+' 00:00:00.000Z').toString();
					document.getElementById('dataFinal').value = fulldate;
					console.log("dataFinal:"+document.getElementById('dataFinal').value);
				}
			}
			const $id = (id) => document.getElementById(id);  // ← ADICIONAR ISSO!
	/* =========================
    FILTROS UI - NOMES PADRONIZADOS
    ========================= */
	function trocaFiltroData() {
		const tipo = $('#tipoData').val();
		const isAnoMes = (tipo === 'Ano/Mes');
		
		// ✅ LÓGICA CORRIGIDA:
		// Se for Ano/Mês → mostra Ano e Mês, OCULTA Data
		// Se for Semana/Dia → oculta Ano e Mês, MOSTRA Data
		$('#divAnoAtend').toggle(isAnoMes);
		$('#divMesAtend').toggle(isAnoMes);
		$('#divDataFil').toggleClass('hidden-div', isAnoMes); // ← CORREÇÃO: era !isAnoMes
		
		// ✅ Força Select2 recalcular após mudar visibilidade
		setTimeout(() => {
			if (isAnoMes) {
				// Atualiza Ano e Mês
				['#anoAtend', '#mesAtend'].forEach(sel => {
					const $el = $(sel);
					if ($el.data('select2')) {
						$el.select2('destroy').select2({ 
							width: 'resolve', 
							placeholder: "Selecione...",
							allowClear: false  // ← Remove o X
						});
					}
				});
			} else {
				// Atualiza Data
				const $el = $('#dataFil');
				if ($el.data('select2')) {
					$el.select2('destroy').select2({ 
						width: 'resolve', 
						placeholder: "Selecione...",
						
					});
				}
			}
		}, 50);
		
		console.log('[DEBUG] Tipo Data:', tipo, '| isAnoMes:', isAnoMes);
	}

function trocaFilpessoa() {
    const tipo = $('#atendTipoPessoa').val();
    
    // Mostra/Oculta campos
    $('#divAtendBeneficiario').toggleClass('hidden-div', tipo !== 'Beneficiario');
    $('#divAtendTerapeuta').toggleClass('hidden-div', tipo !== 'Terapeuta');
    
    // ✅ FORÇA SELECT2 RECALCULAR APÓS MUDAR VISIBILIDADE
    setTimeout(() => {
        $('#atendBeneficiario, #atendTerapeuta').each(function() {
            if ($(this).data('select2')) {
                $(this).select2('destroy').select2({ width: 'resolve', allowClear: true, placeholder: "Selecione..." });
            }
        });
    }, 50);
    
    console.log('[DEBUG] Tipo Pessoa:', tipo);
}
			function carregaBody(){
				// Carrega filtros apenas se carregaFiltro == "true"
				if (document.getElementById("carregaFiltro")?.value == "true"){
					
					// === Tipo de data ===
					const tipoDataVal = document.getElementById("tipoDataFil")?.value || "Ano/Mes";
					document.getElementById("tipoData").value = tipoDataVal;
					
					if(tipoDataVal == "Ano/Mes"){
						document.getElementById("anoAtend").value = document.getElementById("anoAtendFil")?.value || "";
						document.getElementById("mesAtend").value = document.getElementById("mesAtendFil")?.value || "";
					} else if (tipoDataVal == "Semana" || tipoDataVal == "Dia"){
						const dataFilVal = document.getElementById("dataFinalFil")?.value || "";
						if(dataFilVal){
							const dat = new Date(dataFilVal);
							const mes = String(dat.getUTCMonth()).padStart(2,'0');
							const dia = String(dat.getUTCDate()).padStart(2,'0');
							document.getElementById("dataFil").value = `${dat.getFullYear()}-${mes}-${dia}`;
						}
					}
					
					// === Tipo de pessoa ===
					const tipoPessoaVal = document.getElementById("tipoPessoaFil")?.value || "Geral";
					document.getElementById("atendTipoPessoa").value = tipoPessoaVal;
					
					if(tipoPessoaVal == "Beneficiario"){
						document.getElementById("atendBeneficiario").value = document.getElementById("atendBeneficiarioFil")?.value || "";
					} else if(tipoPessoaVal == "Terapeuta"){
						document.getElementById("atendTerapeuta").value = document.getElementById("atendTerapeutaFil")?.value || "";
					}
					
					// === Concluído ===
					document.getElementById("AtendConcluido").value = document.getElementById("AtendConcluidoFil")?.value || "Todos";
					
					// === Selo (NOVO) ===
					document.getElementById("atendSelo").value = document.getElementById("atendSeloFil")?.value || "Todos";
				}
				
				// === Carregamento via edição (Edi) ===
				const tipoDataEdi = document.getElementById("tipoDataEdi")?.value;
				const tipoPessoaEdi = document.getElementById("tipoPessoaEdi")?.value;
				
				if (tipoDataEdi){
					document.getElementById("tipoData").value = tipoDataEdi;
					if(tipoDataEdi == "Ano/Mes"){
						document.getElementById("anoAtend").value = document.getElementById("anoAtendEdi")?.value || "";
						document.getElementById("mesAtend").value = document.getElementById("mesAtendEdi")?.value || "";
					} else if(tipoDataEdi == "Semana" || tipoDataEdi == "Dia"){
						const dataEdiVal = document.getElementById("dataFinalEdi")?.value;
						if(dataEdiVal){
							const dat = new Date(dataEdiVal);
							const mes = String(dat.getUTCMonth()).padStart(2,'0');
							const dia = String(dat.getUTCDate()).padStart(2,'0');
							document.getElementById("dataFil").value = `${dat.getFullYear()}-${mes}-${dia}`;
						}
					}
				}
				
				if(tipoPessoaEdi){
					document.getElementById("atendTipoPessoa").value = tipoPessoaEdi;
					if(tipoPessoaEdi == "Beneficiario"){
						document.getElementById("atendBeneficiario").value = document.getElementById("atendBeneficiarioEdi")?.value || "";
					} else if(tipoPessoaEdi == "Terapeuta"){
						document.getElementById("atendTerapeuta").value = document.getElementById("atendTerapeutaEdi")?.value || "";
					}
				}
				
				// === Atualiza visibilidade dos campos ===
				trocaFiltroData();
				trocaFilpessoa();
				
				// === ATUALIZA TODOS OS CHOSEN ===
				$('.chosen-select').trigger('chosen:updated');
			}
		</script>
