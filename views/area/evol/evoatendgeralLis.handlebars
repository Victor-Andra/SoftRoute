        /*Tooltip personalizado */
        .custom-tooltip {
            position: relative;
            display: inline-block;
            cursor: pointer;
        }

        .tooltip-text {
            visibility: hidden;
            width: max-content;
            background-color: #f3dfdf;
            color: red;
            font-size: 8px;
            text-align: left;
            border-radius: 4px;
            padding: 8px 12px;
            position: absolute;
            z-index: 9999;
            bottom: 125%;
            left: 50%;
            transform: translateX(-50%);
            opacity: 0.9;
            white-space: normal;
            min-width: 150px;
            max-width: 300px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            transition: opacity 0.3s;
        }

        .tooltip-text::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 50%;
            margin-left: -5px;
            border-width: 5px;
            border-style: solid;
            border-color: #f3dfdf transparent transparent transparent;
        }

        .custom-tooltip:hover .tooltip-text {
            visibility: visible;
        }

        /* ============================================
           BARRA DE PESQUISA - CLASSE SEPARADA
           ============================================ */
        .toolbar-pesquisa {
            background: linear-gradient(135deg, #2196f3 0%, #1976d2 100%); /* Azul */
            color: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border: 1px solid #1976d2;
        }

        .toolbar-pesquisa h5 {
            margin: 0 0 10px 0;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .toolbar-pesquisa h5 i {
            font-size: 18px;
        }

        .toolbar-pesquisa .form-inline {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }

        .toolbar-pesquisa .form-group {
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .toolbar-pesquisa label {
            font-size: 11px;
            font-weight: 500;
            margin-bottom: 4px;
            color: #f8f9fa;
            white-space: nowrap;
        }

        .toolbar-pesquisa input[type="text"],
