	 <script type="text/javascript">
     const $id = (id) => document.getElementById(id);

function formataData(){
        let tipo = $id("tipoPeriodo").value;
        if(tipo == "Ano/Mes"){
          let dat = new Date($id('anoAtend').value+"-"+$id('mesAtend').value+"-01 00:00:00.000Z");
          let mes = (dat.getUTCMonth()+1).toString().padStart(2,'0');
          let dia = (dat.getUTCDate()).toString().padStart(2,'0');
          let fulldate = `${dat.getFullYear()}-${mes}-${dia} 00:00:00.000Z`;
          $id('dataFinal').value = fulldate;
        } else {
          let dat = new Date($id('dataFil').value);
          let mes = (dat.getUTCMonth()+1).toString().padStart(2,'0');
          let dia = (dat.getUTCDate()).toString().padStart(2,'0');
          let fulldate = `${dat.getFullYear()}-${mes}-${dia} 00:00:00.000Z`;
          $id('dataFinal').value = fulldate;
        }
      }

function trocaFiltroData() {
  const tipo = $('#tipoPeriodo').val();
  const isAnoMes = (tipo === 'Ano/Mes');
  
  $('#divAnoAtend, #divMesAtend').toggle(isAnoMes);
  $('#divdataFinal').toggle(!isAnoMes);
  
  setTimeout(() => {
    ['#anoAtend', '#mesAtend', '#dataFinal'].forEach(sel => {
      const $el = $(sel);
      if ($el.length && $el.data('select2')) {
        $el.select2('destroy').select2({ 
          width: 'resolve', 
          placeholder: "Selecione...", 
          allowClear: false 
        });
      }
    });
  }, 50);
}

function trocaFilpessoa() {
  const tipo = $('#atendTipoPessoa').val();
  
  $('#divAtendBeneficiario, #divAtendTerapeuta, #divAtendConv').hide();
  
  if(tipo === 'Beneficiario') $('#divAtendBeneficiario').show();
  else if(tipo === 'Terapeuta') $('#divAtendTerapeuta').show();
  else if(tipo === 'Convenio') $('#divAtendConv').show();
  
  setTimeout(() => {
    $('#atendBeneficiario, #atendTerapeuta, #atendConv').each(function() {
      if ($(this).data('select2')) {
        $(this).select2('destroy').select2({ 
          width: 'resolve', 
          allowClear: true, 
          placeholder: "Selecione..." 
        });
      }
    });
  }, 50);
}

// ✅ FUNÇÃO AUXILIAR: Define valor no Select2 corretamente
function setSelect2Value(id, value) {
  const $el = $(`#${id}`);
  if ($el.length) {
    $el.val(value).trigger('change.select2');
  }
}

function carregaBody(){
  // Valores padrão APENAS se não vier do backend
  if(!$id("tipoPeriodo").value) $id("tipoPeriodo").value = "Ano/Mes";
  if(!$id("atendTipoPessoa").value) $id("atendTipoPessoa").value = "Geral";
  
  // ✅ PRIORIDADE: Se tem filtro salvo, carrega ANTES de aplicar visibilidade
  if($id("carregaFiltro")?.value === "true") {
    carregarFiltros();
  }
  
  // ✅ SÓ DEPOIS aplica a visibilidade com os valores já definidos
  trocaFiltroData();
  trocaFilpessoa();
  
  $id("atualizaValores").value = "false";
}

function carregarFiltros() {
  const tipoPeriodo = $id("tipoPeriodoFil")?.value || "Ano/Mes";
  const tipoPessoa = $id("tipoPessoaFil")?.value || "Geral";

  // ✅ 1º: Define os valores PRIMEIRO (usando método correto para Select2)
  setSelect2Value('tipoPeriodo', tipoPeriodo);
  setSelect2Value('atendTipoPessoa', tipoPessoa);

  if(tipoPeriodo === "Ano/Mes") {
    setSelect2Value('anoAtend', $id("anoAtendFil")?.value || "");
    setSelect2Value('mesAtend', $id("mesAtendFil")?.value || "0");
  } else {
    const data = $id("dataFinalFil")?.value;
    if(data) {
      // Formata data para YYYY-MM-DD (formato do input date)
      const dataFormatada = data.split('T')[0];
      setSelect2Value('dataFinal', dataFormatada);
    }
  }

  if(tipoPessoa === "Beneficiario") {
    setSelect2Value('atendBeneficiario', $id("atendBeneficiarioFil")?.value || "");
  }
  if(tipoPessoa === "Terapeuta") {
    setSelect2Value('atendTerapeuta', $id("atendTerapeutaFil")?.value || "");
  }
  
  // ✅ 2º: SÓ AGORA aplica a visibilidade com os valores já carregados
  trocaFiltroData();
  trocaFilpessoa();
}

     </script>
	
	</head>
