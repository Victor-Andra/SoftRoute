														{{else}}
															<td>{{agenda_data_dia}}</td>
														{{/dataIgual}}

														<td>{{agenda_hora}}</td>
															<td>
															{{#compareThis agenda_categoria "Padrão"}}
																<span name="ageCateg" id="ageCateg" class="label label-success arrowed">Atendido</span>

															{{else}}
															{{#compareThis agenda_categoria "Feriado"}}
																<span name="ageCateg" id="ageCateg" class="label label-black">{{agenda_categoria}}</span>

															{{else}}
															{{#compareThis agenda_categoria "Substituição"}}
																<span name="ageCateg" id="ageCateg" class="label label-ciano">Atendido por substituição</span>

															{{else}}
															{{#compareThis agenda_categoria "Falta Absoluta"}}
																<span name="ageCateg" id="ageCateg" class="label label-warning">{{agenda_categoria}}</span>

															{{else}}
															{{#compareThis agenda_categoria "Falta Justificada"}}
																<span name="ageCateg" id="ageCateg" class="label label-black">{{agenda_categoria}}</span>

															{{else}}
															{{#compareThis agenda_categoria "Falta"}}
																<span name="ageCateg" id="ageCateg" class="label label-yellow">Planejamento</span>

															{{else}}
															{{#compareThis agenda_categoria "SubstitutoFixo"}}
																<span name="ageCateg" id="ageCateg" class="label label-success arrowed">Atendido</span>
															
															{{else}}
															{{#compareThis agenda_categoria "Extra"}}
																<span name="ageCateg" id="ageCateg" class="label label-success arrowed">Atendido</span>
															
															{{else}}
															{{#compareThis agenda_categoria "Nenhuma Observação"}}
																<span name="ageCateg" id="ageCateg" class="label label-success arrowed">Atendido</span>
															
															{{else}}
																<span name="verselo" id="verselo" class="label label-info arrowed-in">{{agenda_categoria}}</span>
															{{/compareThis}}
															{{/compareThis}}
															{{/compareThis}}
															{{/compareThis}}
															{{/compareThis}}
															{{/compareThis}}
															{{/compareThis}}
															{{/compareThis}}
															{{/compareThis}}
														</td>
														<td>
														{{#each ../terapias}}<!-- Ok -->
															{{#ifEqual this._id ../agenda_terapiaid}}
																{{terapia_nomecid}}
															{{/ifEqual}}
														{{/each}}
														</td>
													
														
														<td>
															{{#each ../terapeutas}}
																{{#ifEqual this._id ../agenda_usuid}}
																	{{usuario_nome}}
																{{/ifEqual}}
															{{/each}}
														</td>
														<td>
															{{#each ../benes}}
																{{#ifEqual this._id ../agenda_beneid}}
																	{{bene_nome}}
																{{/ifEqual}}
															{{/each}}
														</td>
														<td>{{agenda_evolucao}}</td>
														<td>
															{{#compareThis agenda_selo "true"}}
																<span name="verselo" id="verselo" class="label label-success arrowed">Afirmativo</span>
															{{else}}
																<span name="verselo" id="verselo" class="label label-danger arrowed-in">Negado</span>
															{{/compareThis}}
														</td>
														
														<td>
															{{#compareThis agenda_selo "true"}}
																{{#compareThis agenda_atrazo "true"}}
																	<span class="label label-warning arrowed-right">Não</span>
																{{else}}
																	<span class="label label-success arrowed-right">Sim</span>
																{{/compareThis}}
															{{else}}
																<span class="label label-purple arrowed-right">Não</span>
															{{/compareThis}}
														</td>
														
														<td>
															{{#compareThis agenda_categoria "Feriado"}}
																<div class="action-buttons">
																	<a class="red" >
																		<i class="ace-icon fa fa-ban bigger-130"></i>
																	</a>
																</div>

															{{else}}
															
															{{#compareThis agenda_categoria "Falta Absoluta"}}
																<div class="action-buttons">
																	<a class="orange">
																		<i class="ace-icon fa fa-ban bigger-130"></i>
																	</a>
																</div>

															{{else}}
																<div class="action-buttons">
																	<a class="blue" href="/menu/agenda/evolucao/{{_id}}">
																		<i class="ace-icon fa fa-pencil bigger-130"></i>
																	</a>
																</div>
															{{/compareThis}}
															{{/compareThis}}
															
															
														</td>
													</tr>
												{{/each}}
											</tbody>
										</table>
									</div>
