    #breadcrumbs {
        display: none !important;
    }
    
    /* Esconde botões de ação */
    .tableTools-container,
    .action-buttons,
    .btn-toolbar,
    button[type="submit"],
    .pull-right {
        display: none !important;
    }
    
    /* Ajusta o layout para impressão */
    body {
        margin: 0 !important;
        padding: 0 !important;
    }
    
    .main-container {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
    }
    
