	/* ============================================
   REGRAS DE IMPRESSÃO - GARANTE QUE MENU E FILTROS NÃO APAREÇAM
   ============================================ */
@media print {
    /* Esconde a barra de navegação/sidebar */
    .sidebar,
    .navbar,
    #sidebar,
    .main-container > .sidebar,
    .ace-save-state > .sidebar,
    nav,
    .nav-menu,
    .menu-container {
        display: none !important;
        visibility: hidden !important;
        width: 0 !important;
        height: 0 !important;
        overflow: hidden !important;
    }
    
    /* Esconde a toolbar de pesquisa */
    .toolbar-pesquisa,
    .noprint,
