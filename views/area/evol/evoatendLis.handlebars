														{{/each}}
														{{#each ../benes}}
															{{#ifEqual this._id ../agenda_beneid}}
																<td>{{bene_nome}}</td>
															{{/ifEqual}}
														{{/each}}
														<td>{{agenda_evolucao}}</td>
														<td>
															{{#compareThis agenda_selo 'true'}}
																Sim
																<!-- mover data24h agenda_dataSelo para aqui -->
																	{{#isTrue agenda_temp}}
																	<td>
																		<div class="action-buttons">
																			<a class="red" name="acaoEvolucaoSemanalCorrecao" id="acaoEvolucaoSemanalCorrecao" onclick="javascript:evolucaoSemanalEmDia('{{_id}}');">
																				<i class="ace-icon fa fa-clock-o bigger-130"></i>
																			</a>
																		</div>
																	</td>
																	{{else}}
																	<td>
																		<div class="action-buttons">
																			<a class="red" name="acaoEvolucaoCorrecao" id="acaoEvolucaoCorrecao" onclick="javascript:evolucaoEmDia('{{_id}}');">
																				<i class="ace-icon fa fa-clock-o bigger-130"></i>
																			</a>
																		</div>
																	</td>
																	{{/isTrue}}
																	
																{{#data24h agenda_dataSelo}}
																<!-- retirei a condição temporariamente para os terapeutas se acostumarem ,sera adicionado uma config para ativar e desativar edições em ate 24h -->
																{{else}}
																	<!--
																	<td>-</td>
																	-->
																{{/data24h}}
															{{else}}
																Não
																<td>
																	{{#dataIgual agenda_data_dia}}
																		{{#isTrue agenda_temp}}
																		<div class="action-buttons">
																			<a class="blue" name="acaoEvolucaoSemanal" id="acaoEvolucaoSemanal" onclick="javascript:evolucaoSemanalEmDia('{{_id}}');">
																				<i class="ace-icon fa fa-pencil bigger-130"></i>
																			</a>
																		</div>
																		{{else}}
																		<div class="action-buttons">
																			<a class="blue" name="acaoEvolucao" id="acaoEvolucao" onclick="javascript:evolucaoEmDia('{{_id}}');">
																				<i class="ace-icon fa fa-pencil bigger-130"></i>
																			</a>
																		</div>
																		{{/isTrue}}
																	{{else}}
																		{{#dataInferior agenda_data_dia}}
																			{{#isTrue agenda_temp}}
																				<div class="action-buttons">
																					<a class="red" name="acaoEvolucaoSemanalComAtraso" id="acaoEvolucaoSemanalComAtraso" onclick="javascript:evolucaoSemanalComAtraso('{{_id}}');">
																						<i class="ace-icon fa fa-clock-o bigger-130"></i>
																					</a>
																				</div>
																			{{else}}
																			<div class="action-buttons">
																				<a class="red" name="acaoEvolucaoComAtraso" id="acaoEvolucaoComAtraso" onclick="javascript:evolucaoComAtraso('{{_id}}');">
																					<i class="ace-icon fa fa-clock-o bigger-130"></i>
																				</a>
																			</div>
																			{{/isTrue}}
																		{{/dataInferior}}
																	{{/dataIgual}}
																</td>
															{{/compareThis}}
														</td>
													</tr>
												{{/each}}
											</tbody>
										</table>
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

			

