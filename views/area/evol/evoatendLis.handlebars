							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Route</a>
							</li>
							<li class="active">Minhas Evoluções</li>
						</ul><!-- /.breadcrumb -->
					</div>
					
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<form id="divFormPesquisa" class="form-horizontal" role="form" action="/menu/area/evoatendfil" method="POST">
							<div class="toolbar-pesquisa noprint">
								<div class="row">
								<!-- 🔒 CAMPOS HIDDEN -->
								<div class="hidden">
									<input id="carregaFiltro" value="{{carregaFiltro.carregaFiltro}}" />
									<input id="atendBeneficiarioFil" value="{{atendBeneficiario.atendBeneficiario}}" />
									<input id="dataFinalFil" value="{{dataFinal.dataFinal}}" />
									<input id="mesAtendFil" value="{{mesAtend.mesAtend}}" />
									<input id="anoAtendFil" value="{{anoAtend.anoAtend}}" />
									<input id="tipoPessoaFil" value="{{tipoPessoa.tipoPessoa}}" />
									<input id="tipoDataFil" value="{{tipoData.tipoData}}" />
									<input id="dataIniFil" value="{{dataIni.dataIni}}" />
									<input id="dataFimFil" value="{{dataFim.dataFim}}" />
									<input id="idsChecked" value="" />
								</div>

								<!-- 🔹 TIPO DE FILTRO DATA -->
								<div class="col-sm-2">
									<div class="input-group">
										<label>Tipo Filtro:&nbsp;</label>
										<select name="tipoData" id="tipoData" class="select2"
											onchange="trocaFiltroData()">
											<option value="Ano/Mes">Ano/Mês</option>
											<option value="Semana">Semana</option>
											<option value="Dia">Dia</option>
										</select>
									</div>
								</div>

								<!-- 🔹 FILIAL (OCULTO) -->
								<div class="col-sm-2 hidden">
									<div class="input-group">
										<label>Filial:&nbsp;</label>
										<select name="empresaFilial" id="empresaFilial" class="select2">
											<option value="Matriz">Matriz</option>
											<option value="Filial 1">Filial 1</option>
											<option value="Filial 2">Filial 2</option>
											<option value="Filial 3">Filial 3</option>
											<option value="Filial 4">Filial 4</option>
										</select>
									</div>
								</div>

								<!-- 🔹 ANO -->
								<div id="divAnoAtend" class="col-sm-2">
									<div class="input-group">
										<label>Ano:&nbsp;</label>
										<select name="anoAtend" id="anoAtend" class="select2"
											onchange="formataData();">
											{{#each anos}}
												<option value="{{ano_nome}}">{{ano_nome}}</option>
											{{/each}}
										</select>
									</div>
								</div>

								<!-- 🔹 MÊS -->
								<div id="divMesAtend" class="col-sm-2">
									<div class="input-group">
										<label>Mês:&nbsp;</label>
										<select name="mesAtend" id="mesAtend" class="select2"
											onchange="formataData();">
											<option value="0">Janeiro</option>
											<option value="1">Fevereiro</option>
											<option value="2">Março</option>
											<option value="3">Abril</option>
											<option value="4">Maio</option>
											<option value="5">Junho</option>
											<option value="6">Julho</option>
											<option value="7">Agosto</option>
											<option value="8">Setembro</option>
											<option value="9">Outubro</option>
											<option value="10">Novembro</option>
											<option value="11">Dezembro</option>
										</select>
									</div>
								</div>

								<!-- 🔹 DATA (DIA) -->
								<div id="divDataFil" class="col-sm-2">
									<div class="input-group">
										<label>Data:&nbsp;</label>
										<input type="date" id="dataFil" name="dataFil"
											style="height: 30px;"
											onchange="formataData();" />
										<input type="hidden" id="dataFinal" name="dataFinal" />
									</div>
								</div>

								<!-- 🔹 TIPO PESSOA -->
								<div id="divTipoFil" class="col-sm-2">
									<div class="input-group">
										<label>Tipo:&nbsp;</label>
										<select name="atendTipoPessoa" id="atendTipoPessoa"
											class="select2"
											onchange="trocaFilpessoa()">
											<option value="Geral">Geral</option>
											<option value="Beneficiario">Beneficiário</option>
										</select>
									</div>
								</div>

								<!-- 🔹 BENEFICIÁRIO -->
								<div id="divAtendBeneficiario" class="col-sm-4">
									<div class="input-group">
										<label>Beneficiário:&nbsp;</label>
										<select name="atendBeneficiario" id="atendBeneficiario"
											class="select2">
											{{#each benes}}
												<option value="{{_id}}">{{bene_nome}}</option>
											{{/each}}
										</select>
									</div>
								</div>

								<!-- 🔍 BOTÃO -->
								<div class="col-sm-12" style="margin-top: 10px;">
									<button id="acaoPesquisar" name="acaoPesquisar"
										type="submit"
										class="btn btn-xs btn-danger">
										<i class="ace-icon fa fa-search-plus"></i>
										Pesquisar
									</button>
								</div>

								<div class="col-sm-12">
									<hr>
								</div>

							</div>
							</div>
							
						</form>
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<div class="row">
									<div class="alert alert-warning">
										<button type="button" class="close" data-dismiss="alert">
											<i class="ace-icon fa fa-times"></i>
										</button>
										Se houver na lista, atendimento que não foi realizado evolução. Ir ao menu "Minha Agenda" e menu "Da Semana", localizar o agendamento e clicar no relógio ao lado. <br>
										Vale salientar que sua falta ou atraso na evolução, ficará registrada e será reportada ao administrativo.<br>

									</div>
									<div class="col-xs-12">
										<div class="clearfix" >
											<div class="pull-right tableTools-container">
											</div>
										</div>
										<div id="dynamic-table_wrapper" class="dataTables_wrapper form-inline no-footer">
										</div>
										<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
											<thead>
												<tr role="row">
													<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1" width="100px;">Data</th>
													<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1" width="70px;">Hora</th>
													<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Terapia</th>
													<th class="sorting" tabindex="4" aria-controls="dynamic-table" rowspan="1" colspan="1" >Beneficiário</th>
													<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1" >Evolução</th>
													<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1" width="100px;">Concluída</th>
													<th class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1" width="70x;">Ação</th>
												</tr>
											</thead>
											<tbody>
												{{#each agendas}}

													<tr role="row" class="odd">
														<td>{{agenda_data_dia}}</td>

														<td>{{agenda_hora}}</td>
														
														{{#each ../terapias}}<!-- Ok -->
															{{#ifEqual this._id ../agenda_terapiaid}}
																<td>{{terapia_nomecid}}</td>
															{{/ifEqual}}
														{{/each}}
														{{#each ../benes}}
															{{#ifEqual this._id ../agenda_beneid}}
																<td>{{bene_nome}}</td>
															{{/ifEqual}}
														{{/each}}
														<td>{{agenda_evolucao}}</td>
														<td>
															{{#compareThis agenda_selo 'true'}}
																Sim
																<!-- mover data24h agenda_dataSelo para aqui -->
																	{{#isTrue agenda_temp}}
																	<td>
																		<div class="action-buttons">
																			<a class="red" name="acaoEvolucaoSemanalCorrecao" id="acaoEvolucaoSemanalCorrecao" onclick="javascript:evolucaoSemanalEmDia('{{_id}}');">
																				<i class="ace-icon fa fa-clock-o bigger-130"></i>
																			</a>
																		</div>
																	</td>
																	{{else}}
																	<td>
																		<div class="action-buttons">
																			<a class="red" name="acaoEvolucaoCorrecao" id="acaoEvolucaoCorrecao" onclick="javascript:evolucaoEmDia('{{_id}}');">
																				<i class="ace-icon fa fa-clock-o bigger-130"></i>
																			</a>
																		</div>
																	</td>
																	{{/isTrue}}
																	
																{{#data24h agenda_dataSelo}}
																<!-- retirei a condição temporariamente para os terapeutas se acostumarem ,sera adicionado uma config para ativar e desativar edições em ate 24h -->
																{{else}}
																	<!--
																	<td>-</td>
																	-->
																{{/data24h}}
															{{else}}
																Não
																<td>
																	{{#dataIgual agenda_data_dia}}
																		{{#isTrue agenda_temp}}
																		<div class="action-buttons">
																			<a class="blue" name="acaoEvolucaoSemanal" id="acaoEvolucaoSemanal" onclick="javascript:evolucaoSemanalEmDia('{{_id}}');">
																				<i class="ace-icon fa fa-pencil bigger-130"></i>
																			</a>
																		</div>
																		{{else}}
																		<div class="action-buttons">
																			<a class="blue" name="acaoEvolucao" id="acaoEvolucao" onclick="javascript:evolucaoEmDia('{{_id}}');">
																				<i class="ace-icon fa fa-pencil bigger-130"></i>
																			</a>
																		</div>
																		{{/isTrue}}
																	{{else}}
																		{{#dataInferior agenda_data_dia}}
																			{{#isTrue agenda_temp}}
																				<div class="action-buttons">
																					<a class="red" name="acaoEvolucaoSemanalComAtraso" id="acaoEvolucaoSemanalComAtraso" onclick="javascript:evolucaoSemanalComAtraso('{{_id}}');">
																						<i class="ace-icon fa fa-clock-o bigger-130"></i>
																					</a>
																				</div>
																			{{else}}
																			<div class="action-buttons">
																				<a class="red" name="acaoEvolucaoComAtraso" id="acaoEvolucaoComAtraso" onclick="javascript:evolucaoComAtraso('{{_id}}');">
																					<i class="ace-icon fa fa-clock-o bigger-130"></i>
																				</a>
																			</div>
																			{{/isTrue}}
																		{{/dataInferior}}
																	{{/dataIgual}}
																</td>
															{{/compareThis}}
														</td>
													</tr>
												{{/each}}
											</tbody>
										</table>
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

			

		</div><!-- /.main-container ace-save-state -->

		
