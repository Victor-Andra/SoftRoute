<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista dos Relatórios semestrais</title>
		<style>
			/* Tooltip personalizado para o ícone de olho */
			.custom-tooltip {
				position: relative;
				display: inline-block;
				cursor: pointer;
			}
			.tooltip-text {
				visibility: hidden;
				width: max-content;
				background-color: #f3dfdf;
				color: #c00;
				font-size: 11px;
				text-align: left;
				border-radius: 4px;
				padding: 6px 10px;
				position: absolute;
				z-index: 9999;
				bottom: 125%;
				left: 50%;
				transform: translateX(-50%);
				opacity: 0.95;
				white-space: normal;
				min-width: 180px;
				max-width: 280px;
				box-shadow: 0 4px 8px rgba(0,0,0,0.2);
				transition: opacity 0.2s;
				line-height: 1.4;
			}
			.tooltip-text::after {
				content: "";
				position: absolute;
				top: 100%;
				left: 50%;
				margin-left: -5px;
				border-width: 5px;
				border-style: solid;
				border-color: #f3dfdf transparent transparent transparent;
			}
			.custom-tooltip:hover .tooltip-text {
				visibility: visible;
				opacity: 1;
			}
		</style>
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Route</a>
							</li>
							<li class="active">Lista dos Relatórios Semestrais
								
							</li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
					
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<div class="row">
									<div class="col-xs-12">
										<div class="clearfix" >
											<div class="pull-right tableTools-container">
											</div>
										</div>
										<div id="dynamic-table_wrapper" class="dataTables_wrapper form-inline no-footer">
										</div>
										<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
											<thead>
												<tr role="row">
													<th class="center">
														<label class="pos-rel">
															<input type="checkbox" class="ace" />
															<span class="lbl"></span>
														</label>
													</th>
													<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1" aria-label="Tipo Plano: activate to sort column ascending">Data</th>
													<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1" aria-label="Benficiário: activate to sort column ascending">Ano/Mês</th>
													<th class="sorting" tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="1" aria-label="Idade:     activate to sort column ascending">Beneficiário</th>
													<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" aria-label="Idade:     activate to sort column ascending">Terapeuta</th>
													<th class="sorting" tabindex="4" aria-controls="dynamic-table" rowspan="1" colspan="1" aria-label="Idade:     activate to sort column ascending">Terapia</th>
													<th>Ação</th>
												</tr>
											</thead>
											<tbody>
												{{#each relsems}}
												<tr role="row" class="odd">
													<td class="center">
														<label class="pos-rel">
															<input type="checkbox" class="ace" />
															<span class="lbl"></span>
														</label>
													</td>
													<td>{{relsem_data_formatada}}</td>  <!-- ✅ dd/mm/yyyy -->
													<td>{{relsem_mes}}</td>
													
													<!-- ✅ Beneficiário: vem do populate -->
													<td>{{#if relsem_beneid}}{{relsem_beneid.bene_nome}}{{else}}—{{/if}}</td>
													
													<!-- ✅ Terapeuta: vem da resolução manual -->
													<td>{{terapeuta_nome}}</td>
													
													<td>{{relsem_terapia}}</td>
													
													<td>
														<div class="action-buttons">
															<a class="green" href="/menu/area/relsem/edi/{{_id}}">
																<i class="ace-icon fa fa-pencil bigger-130"></i>
															</a>
															<a class="blue" href="/menu/area/relsem/imp/{{_id}}">
																<i class="ace-icon fa fa-print bigger-130"></i>
															</a>
															<a class="brown" href="/menu/area/relsem/capa/{{_id}}">
																<i class="ace-icon fa fa-bookmark-o bigger-130"></i>
															</a>
															<a class="red" href="#" onclick="confirmeDeletar('{{_id}}');">
																<i class="ace-icon fa fa-trash-o bigger-130"></i>
															</a>
														</div>
													</td>
												</tr>
												{{else}}
												<tr>
													<td colspan="7" class="text-center text-muted">
														<i class="ace-icon fa fa-info-circle"></i> Nenhum relatório cadastrado ainda.
													</td>
												</tr>
												{{/each}}
											</tbody>
										</table>
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

		
		</div><!-- /.main-container ace-save-state -->
<!-- basic scripts -->

		<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		

		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
			"language": { "url": "/js/lang/datatable-pt-br.json" },
			"aaSorting": [],
			"aoColumns": [{ "bSortable": false }, null, null, null,null,null, { "bSortable": false }],
			"responsive": true,
			"lengthMenu": [ 200, 500, 1000],
			"lengthChange": true,
			"autoWidth": true,
			"paging": true,
			"lengthChange": true,
			"searching": true,
			"ordering": true,
			"info": true,
			
			select: {
						style: 'multi'
					}
			});
		});
		$.fn.dataTable.Buttons.defaults.dom.container.className = 'dt-buttons btn-overlap btn-group btn-overlap';
		</script>
	

	</body>

</html>