<!DOCTYPE html>
<html lang="pt-br">
<head>
	<title>Avaliação Fisioterapêutica</title>
	<style>
		h2,.progress-title{
		color: #0a1829;
		}
		h4{
		color: #166d9e;
		}
		h4 .material-icons, .message-read h4 .fa, .message-read h4 .glyphicon {
			margin-right: 15px;
			display: inline-flex;
			vertical-align: middle;
		}
		.material-icons {
			font-size: 20px;
		}
		.progress-title{
			font-size: 14px;
			font-weight: 700;
			margin-bottom: 16px;
			margin-top: 44px;
		}
		.progress-name{
			font-size: 12px;
			font-weight: 700;
			vertical-align: middle;
			color: #000;
			text-shadow: 0 0 1px #fff, 0 0 1px #fff, 0 0 1px #fff, 0 0 1px #fff;
			line-height: 30px;
		}
		.progress{
			height: 30px;
			background: #e9e9e9;
			border-radius: 0;
			box-shadow: none;
			margin-bottom: 30px;
			overflow: visible;
		}
		.progress .progress-bar{
			box-shadow: none;
			position: relative;
			-webkit-animation: animate-positive 2s;
			animation: animate-positive 2s;
			height: 30px;
		}
		.progress .progress-value{
			font-size: 15px;
			font-weight: bold;
			color: #000;
			position: absolute;
			top: -18px;
			right: 0;
		}
		.col-sm-7 input[type="text"] {
			width: 100%;
		}
		.spanAzul {
			display: inline-block;
			position: relative;
			font-weight: 400;
			vertical-align: baseline;
			white-space: nowrap;
			background-color: #91b8d0;color: #fff;
			text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.15);
			padding: 4px 22px 5px 9px;
			margin-bottom: 3px;
			margin-right: 3px;
			max-width: 45%;
		}
		.aClose {
			position: absolute;
			top: 0;
			bottom: 0;
			right: 0;
			width: 18px;
			height: auto;
			line-height: 25px;
			text-align: center;
		}
		.table-bordered {
			border: 1px solid #ddd;
		}
		.table > thead > tr > th,
		.table > tbody > tr > td {
			vertical-align: middle;
			text-align: center;
		}
		/* Cabeçalhos de tabela em cinza escuro */
		table th {
			background-color: #fdfbdb7c !important;
			color: #000000 !important;
		}
	</style>
</head>
<body onload="javascript:controlaNave();" class="no-skin">
