							<script>
							function preencherFormularioComTestes() {
								// Função auxiliar para obter o texto do label associado
								function getLabelText(input) {
									const id = input.id;
									if (id) {
										const label = document.querySelector(`label[for="${id}"]`);
										if (label) return label.textContent.trim().replace(/:$/, '');
									}
									// Tenta buscar label ancestral (ex: <label><input>Texto</label>)
									let parent = input.parentElement;
									while (parent && parent.tagName !== 'LABEL') {
										parent = parent.parentElement;
									}
									if (parent) {
										return parent.textContent.trim().replace(/:$/, '').replace(/\s*\*?\s*$/, '');
									}
									return input.name || 'campo';
								}
								// Preenche todos os inputs, selects, textareas
								const form = document.querySelector('form');
								if (!form) return;
								// Text inputs
								form.querySelectorAll('input[type="text"]').forEach(input => {
									const label = getLabelText(input);
									input.value = `Teste: ${label}`;
								});
								// Date inputs
								const hoje = new Date().toISOString().split('T')[0];
								form.querySelectorAll('input[type="date"]').forEach(input => {
									input.value = hoje;
								});
								// Textareas
								form.querySelectorAll('textarea').forEach(textarea => {
									const label = getLabelText(textarea);
									textarea.value = `Observações de teste para ${label}`;
								});
								// Selects (exceto os que já têm valor)
								form.querySelectorAll('select').forEach(select => {
									if (!select.value || select.value === '') {
										// Pula a primeira opção se for placeholder (ex: "-")
										const opts = Array.from(select.options).filter(opt => 
											opt.value !== '' && 
											opt.value !== '-' && 
											!opt.value.toLowerCase().includes('selec') &&
											!opt.value.toLowerCase().includes('escolh')
										);
										if (opts.length > 0) {
											select.value = opts[0].value;
										}
									}
								});
								// Checkboxes → marca todos
								form.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
									checkbox.checked = true;
									// Se tiver campo de texto associado (ex: "Qual?"), preenche também
									const next = checkbox.closest('div')?.nextElementSibling;
									if (next && next.querySelector('input[type="text"], textarea')) {
										const textInput = next.querySelector('input[type="text"], textarea');
										const label = getLabelText(checkbox);
										textInput.value = `Detalhe de teste para ${label}`;
									}
								});
								// Radios → marca o primeiro de cada grupo
								const radioGroups = {};
								form.querySelectorAll('input[type="radio"]').forEach(radio => {
									if (!radioGroups[radio.name]) {
										radio.checked = true;
										radioGroups[radio.name] = true;
									}
								});
								console.log('✅ Formulário preenchido com dados de teste!');
							}
							</script>
							<!-- Botão para testar (opcional) -->
							<button hidden type="button" class="btn btn-warning" onclick="preencherFormularioComTestes()">
								Preencher com Dados de Teste
							</button>
						</form>
