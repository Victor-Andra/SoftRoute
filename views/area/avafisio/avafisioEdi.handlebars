function carregaBody() {
    console.log("🟢 Iniciando carregamento dos campos...");
    
    setTimeout(() => {
        const inputsEdi = document.querySelectorAll('[id$="Edi"]');
        
        inputsEdi.forEach(inputEdi => {
            try {
                const idEdi = inputEdi.id;
                const valor = inputEdi.value?.trim();
                const idBase = idEdi.replace('Edi', '');
                
                if (!idBase || !valor) return;
                
                // 1️⃣ Tenta buscar pelo ID primeiro (para inputs normais)
                let campoReal = document.getElementById(idBase);
                
                // 2️⃣ Se não encontrou, tenta buscar radios pelo NAME
                if (!campoReal) {
                    const radios = document.querySelectorAll(`input[name="${idBase}"]`);
                    if (radios.length > 0) {
                        // Normaliza valor (remove vírgula para comparação numérica)
                        const valorNormalizado = valor.replace(',', '.');
                        radios.forEach(radio => {
                            const radioValue = radio.value.replace(',', '.');
                            if (radioValue === valorNormalizado || radio.value === valor) {
                                radio.checked = true;
                                console.log(`✅ Radio marcado: ${idBase} = ${valor}`);
                            }
                        });
                        // Atualiza campo de texto associado se existir
                        const campoTexto = document.getElementById(idBase.replace('q', 'Q'));
                        if (campoTexto) campoTexto.value = valor;
                    }
                    return;
                }
                
                // 3️⃣ Checkbox
                if (campoReal.type === "checkbox") {
                    campoReal.checked = (valor === "true" || valor === "1" || valor === "on");
                    return;
                }
                
                // 4️⃣ Radio (quando encontrado por ID)
                if (campoReal.type === "radio") {
                    const radios = document.querySelectorAll(`input[name="${campoReal.name}"]`);
                    const valorNormalizado = valor.replace(',', '.');
                    radios.forEach(radio => {
                        const radioValue = radio.value.replace(',', '.');
                        if (radioValue === valorNormalizado || radio.value === valor) {
                            radio.checked = true;
                        }
                    });
                    return;
                }
                
                // 5️⃣ Campos de data
                const camposDeData = [
                    "anamnDataanamnese", "anamnBenedatanasc", "carsCarsdata",
                    "avafisiodataava", "avafisiodatainitrat", "avafisiodatanasc",
                    "avafisiodatanascmae", "avafisiodatanascpai"
                ];
                if (camposDeData.includes(idBase) && campoReal.type === "date") {
                    campoReal.value = formatarDataParaInput(valor);
                    return;
                }
                
                // 6️⃣ Select com Chosen/Select2
                if (campoReal.tagName === "SELECT") {
                    campoReal.value = valor;
                    if (typeof jQuery !== 'undefined' && jQuery.fn.chosen) {
                        jQuery(campoReal).trigger('chosen:updated');
                    }
                    if (typeof jQuery !== 'undefined' && jQuery.fn.select2) {
                        jQuery(campoReal).trigger('change');
                    }
                    return;
                }
                
                // 7️⃣ Input/Textarea comum
                if (campoReal.tagName === "TEXTAREA" || campoReal.tagName === "INPUT") {
                    campoReal.value = valor;
                    return;
                }
                
            } catch (err) {
                console.warn(`⚠️ Erro ao popular campo ${inputEdi.id}:`, err);
            }
        });
        
        console.log("✅ Campos populados!");
        
        // 🔄 Força atualização visual dos plugins após tudo estar pronto
        if (typeof jQuery !== 'undefined') {
            jQuery('.chosen-select').trigger('chosen:updated');
            jQuery('.select2').trigger('change');
        }
        
    }, 150); // Delay um pouco maior para garantir que plugins estejam inicializados
}

// 🔹 Helper para formatar data ISO para input[type="date"]
function formatarDataParaInput(dataISO) {
    if (!dataISO) return "";
    const data = new Date(dataISO);
    if (isNaN(data.getTime())) return "";
    const dia = String(data.getDate()).padStart(2, '0');
    const mes = String(data.getMonth() + 1).padStart(2, '0');
    const ano = data.getFullYear();
    return `${ano}-${mes}-${dia}`;
}
</script>
	
