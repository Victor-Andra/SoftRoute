<script>
// 🔹 Helper para atualizar Select2 (substituto do Chosen)
function atualizaSelect2(selectId, valor) {
    if (typeof jQuery !== 'undefined' && jQuery.fn.select2) {
        const $select = $('#' + selectId);
        $select.val(valor).trigger('change');
        // Atualiza visualmente o Select2
        if ($select.data('select2')) {
            $select.select2('destroy').select2({
                width: '100%',
                allowClear: true,
                placeholder: $select.attr('placeholder') || 'Selecione...'
            });
            $select.val(valor).trigger('change');
        }
    } else {
        // Fallback puro JS
        const el = document.getElementById(selectId);
        if (el) el.value = valor;
    }
}

// 🔹 Lista de TODOS os campos Select2 do formulário
