	<script type="text/javascript">
$(document).ready(function() {
    // 1. Inicializa Select2 em TODOS os selects da página
    if (typeof $.fn.select2 === 'function') {
        $('.select2').each(function() {
            const $el = $(this);
            if (!$el.data('select2')) {
                $el.select2({
                    width: '100%',
                    allowClear: true,
                    placeholder: $el.attr('placeholder') || 'Selecione...',
                    language: {
                        noResults: function() {
                            return "Nenhum resultado encontrado";
                        }
                    }
                });
            }
        });
    }
    
    // 2. Carrega os valores do formulário (APÓS Select2 estar pronto)
    if (typeof carregaBody === 'function') {
        setTimeout(carregaBody, 150); // delay maior para garantir inicialização
    }
    
    // 3. Inicializa navegação do Ace Admin
    if (typeof controlaNave === 'function') {
        controlaNave();
    }
});
</script>
