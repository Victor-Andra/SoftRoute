    'avafisioforcaextensaopunhodir', 'avafisioforcaextensaopunhoesq',
    
    // Força Muscular - Membros Inferiores
    'avafisioforcaflexaoquadrildir', 'avafisioforcaflexaoquadrilesq',
    'avafisioforcaextensaoquadrildir', 'avafisioforcaextensaoquadrilesq',
    'avafisioforcaabducaoquadrildir', 'avafisioforcaabducaoquadrilesq',
    'avafisioforcaaducaoquadrildir', 'avafisioforcaaducaoquadrilesq',
