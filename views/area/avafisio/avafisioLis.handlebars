<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista das Avaliações de Fisioterapia</title>
		<style>
			/* Tooltip personalizado */
			.custom-tooltip {
				position: relative; /* Garante que o tooltip seja posicionado em relação a este elemento */
				display: inline-block; /* Permite que o tooltip seja alinhado corretamente */
			}

			.custom-tooltip .tooltip-text {
				display: none; /* Inicialmente oculto e fora do fluxo */
				width: auto; /* Ajusta automaticamente ao conteúdo */
				background-color: rgb(243, 223, 223); /* Fundo escuro para contraste */
				color: red; /* Cor do texto vermelha */
				font-size: 7px; /* Tamanho da fonte pequena */
				text-align: center;
				padding: 2px 5px; /* Espaçamento interno */
				border-radius: 4px; /* Borda arredondada */

				/* Posicionamento do tooltip */
				position: absolute;
				top: -20px; /* Acima do ícone */
				left: 50%; /* Centralizado horizontalmente */
				transform: translateX(-50%); /* Ajuste fino para centralizar */
				z-index: 1; /* Garante que o tooltip fique acima de outros elementos */
				white-space: nowrap; /* Evita que o texto quebre linha */
			}

			/* Mostra o tooltip quando o mouse passa sobre o link */
			.custom-tooltip:hover .tooltip-text {
						display: block; /* Torna o tooltip visível e flutuante */
					}
			@media print and (orientation: landscape) {
				.noprint {
					display: none;
				}
			}
			@media print {
               .noprint {
                  display: none;
               }
            }
			 /* OCULTA O LINK GERADO PELO NAVEGADOR NA IMPRESSÃO */
			@media print {
				a[href]:after {
					content: none !important;
					display: none !important;
				}

				.action-buttons a {
					text-decoration: none !important;
					color: inherit !important;
					background: transparent !important;
				}
			}
			#tabela-customizada {
				border-collapse: separate; /* Permite usar border-spacing */
				border-spacing: 10px 5px; /* Espaçamento menor entre células (horizontal e vertical) */
				border: none; /* Remove borda externa */
				}

				#tabela-customizada th,
				#tabela-customizada td {
				border: none; /* Remove bordas das células */
				padding: 4px; /* Reduz o preenchimento interno para aproximar ainda mais */
				white-space: nowrap; /* Evita quebra de linha no cabeçalho */
				flex-direction: column;
    			align-items: flex-start;
				}
			#dynamic-table th,
			#dynamic-table td {
				font-size: 10px;
			}
			.btn-purple {
				color: #fff;
				background-color: #9D8AC7;
				border-color: #9D8AC7;
			}
			.btn-purple:hover {
				background-color: #8A77B9;
				border-color: #8A77B9;
			}
		</style>
		<script type="text/javascript">
			function ocultaEditar(){
				let biscoito = procuraBiscoito("lvlUsu");
				document.getElementById("botaoEditar").value;
			}
			function ajustaData() {
				// Seleciona todos os spans com a classe 'data-iso'
				const elementosData = document.querySelectorAll('span.data-iso');
				
				elementosData.forEach(span => {
					const isoString = span.textContent.trim();
					if (!isoString) return;

					const dat = new Date(isoString);
					if (isNaN(dat.getTime())) {
						// Se não for data válida, mantém o original
						return;
					}

					// Usa getUTC... se a data vem em UTC (ex: "2025-10-14T00:00:00.000Z")
					// ou get... se é data local. Como vem do banco com "Z", use UTC.
					const dia = String(dat.getUTCDate()).padStart(2, '0');
					const mes = String(dat.getUTCMonth() + 1).padStart(2, '0'); // mês é 0-11
					const ano = dat.getUTCFullYear();

					const fulldate = `${dia}/${mes}/${ano}`;
					span.textContent = fulldate; // 👈 AQUI está a correção: atualiza o texto!
				});
			}
			function formataData(){
				let tipo = document.getElementById("tipoData").value;
				console.log("tipoData:"+tipoData);
				if(tipo == "Ano/Mes"){
					let dat = new Date(document.getElementById('anoBordo').value+"-"+document.getElementById('mesBordo').value+"-01 00:00:00.000Z");
					let mes = (dat.getUTCMonth()+1).toString();
					let dia = (dat.getUTCDate()).toString();
					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}
					let fulldate = (dat.getFullYear()+"-"+mes+"-"+dia+' 00:00:00.000Z').toString();
					document.getElementById('dataFinal').value = fulldate;
					console.log("dataFinal:"+document.getElementById('dataFinal').value);
				} else if (tipo == "Semana"){
					let dat = new Date(document.getElementById('dataFil').value);
					let mes = (dat.getUTCMonth()).toString();
					let dia = (dat.getUTCDate()).toString();
					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}
					let fulldate = (dat.getFullYear()+"-"+mes+"-"+dia+' 00:00:00.000Z').toString();
					document.getElementById('dataFinal').value = fulldate;
					console.log("dataFinal:"+document.getElementById('dataFinal').value);
				} else if (tipo == "Dia"){
					let dat = new Date(document.getElementById('dataFil').value);
					let mes = (dat.getUTCMonth()).toString();
					let dia = (dat.getUTCDate()).toString();
					if (mes.length == 1){
						mes = "0"+mes;
					}
					if (dia.length == 1){
						dia = "0"+dia;
					}
					let fulldate = (dat.getFullYear()+"-"+mes+"-"+dia+' 00:00:00.000Z').toString();
					document.getElementById('dataFinal').value = fulldate;
					console.log("dataFinal:"+document.getElementById('dataFinal').value);
				}
			}
			
			
			function carregaBody(){
			}

			function confirmeDeletar(id){
				let confirmado = confirm("Quer mesmo deletar esta avaliação fisioterápica?");
				if(confirmado == true){
					window.location.href=("/menu/area/avafisio/del/"+id);
				}
			}
			
		
		</script>
		
		
	</head>

	<body onload="javascript:controlaNave(); carregaBody();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
						<li class="active">Lista das Avaliações de Fisioterapia</li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								
								<div class="row">
									<div class="col-xs-12">
										<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
											
											<thead>
											<tr role="row">
												<th class="center" tabindex="1">
													<label class="pos-rel">
														<input type="checkbox" class="ace" />
														<span class="lbl"></span>
													</label>
												</th>
												<th class="sorting" tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="1" >Beneficiário</th>
												<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data Nascimento</th>
												<th class="sorting" tabindex="4" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data da Avaliação</th>
												<th class="sorting" tabindex="5" aria-controls="dynamic-table" rowspan="1" colspan="1" >Início Tratamento</th>
												<th class="sorting" tabindex="10" aria-controls="dynamic-table" rowspan="1" colspan="1" >Data alteração</th>
												<th class="center" tabindex="11">
													Ação&nbsp;&nbsp;&nbsp;&nbsp;
													<a class="green" id="botaoAdicionar" href="/menu/area/avafisio/cad">
														<i class="ace-icon fa fa-plus bigger-130"></i>
													</a>
												</th>
											</tr>
										</thead>
											
											<tbody>
											{{#each avafisios}}

												<tr role="row" class="odd">
													<td class="center">
														<label class="pos-rel">
															<input type="checkbox" class="ace" />
															<span class="lbl"></span>
														</label>
													</td>
													<td>{{avafisio_nomebene}}</td>
													<td><span class="data-iso">{{avafisio_datanasc}}</span></td>
													<td><span class="data-iso">{{avafisio_dataava}}</span></td>
													<td><span class="data-iso">{{avafisio_datainitrat}}</span></td>
													<td><span class="data-iso">{{avafisio_datacad}}</span></td>
													<td>
														<div class="action-buttons">
															<a class="green" id="botaoEditar" href="/menu/area/avafisio/edi/{{_id}}">
																<i class="ace-icon fa fa-pencil bigger-130"></i>
															</a>
															<a class="purple custom-tooltip" name="acaoCrud" id="acaoCrud-{{_id}}">
															<i class="ace-icon fa fa-eye bigger-130"></i>
															<span class="tooltip-text">
																<!-- Bloco Última Edição -->
																<strong>Última Edição:</strong>
																{{#if dataedi}}
																	<p><b>{{dataedi}}</b></p>
																{{else}}
																	<p>--/--/----</p>
																{{/if}}
																{{#if usuarioEdiNome}}
																	<p>Por: {{usuarioEdiNome}}</p>
																{{else}}
																	<p>Por: Não informado</p>
																{{/if}}

																<!-- Bloco Cadastrado em -->
																<strong>Cadastrado em:</strong>
																{{#if datacad}}
																	<p><b>{{datacad}}</b></p>
																{{else}}
																	<p>--/--/----</p>
																{{/if}}
																{{#if usuarioCadNome}}
																	<p>Por: {{usuarioCadNome}}</p>
																{{else}}
																	<p>Por: Não informado</p>
																{{/if}}
															</span>
														</a>
														</div>
													</td>
												</tr>
											{{/each}}
										</tbody>

										</table>
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

		
		</div><!-- /.main-container ace-save-state -->

		<!-- basic scripts -->

				<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		<!-- inline scripts related to this page -->
		<script type="text/javascript">
			$(document).ready(function() {
				const table = $("#dynamic-table").DataTable({
					"language": { "url": "/js/lang/datatable-pt-br.json" },
					"aaSorting": [],
					"aoColumns": [{ "bSortable": false }, null, null, null, null, null, { "bSortable": false }],
					"responsive": true,
					"lengthMenu": [200, 300, 500],
					"lengthChange": true,
					"autoWidth": false,
					"paging": true,
					"searching": true,
					"ordering": true,
					"info": true,
					"select": {
						style: 'multi'
					}
				});

				// Formata as datas na primeira vez
				ajustaData();

				// E também sempre que a tabela for redesenhada (paginação, busca, etc.)
				$('#dynamic-table').on('draw.dt', function() {
					ajustaData();
				});
			});
			</script>
	</body>

</html>