<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista de Escala EBAI</title>

		<meta name="description" content="Static & Dynamic Tables">
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
		<style>
        /*Tooltip personalizado */
            .custom-tooltip {
                position: relative;
                display: inline-block;
                cursor: pointer;
            }

            .tooltip-text {
                visibility: hidden;
                width: max-content;
                background-color: #f3dfdf;
                color: red;
                font-size: 8px;
                text-align: left;
                border-radius: 4px;
                padding: 8px 12px;
                position: absolute;
                z-index: 9999;
                bottom: 125%; /* Acima do ícone */
                left: 50%;
                transform: translateX(-50%);
                opacity: 0.9;
                white-space: normal;
                min-width: 150px;
                max-width: 300px;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
                transition: opacity 0.3s;
            }

            .tooltip-text::after {
                content: "";
                position: absolute;
                top: 100%;
                left: 50%;
                margin-left: -5px;
                border-width: 5px;
                border-style: solid;
                border-color: #f3dfdf transparent transparent transparent;
            }

            /* Mostra o tooltip quando o mouse passa sobre o link */
            .custom-tooltip:hover .tooltip-text {
                visibility: visible;
            }
		</style>
		
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Nutrição</a>
							</li>
							<li>
								<a href="#">Escala EBAI</a>
							</li>
							<li class="active">Lista</li>
							
						</ul><!-- /.breadcrumb -->
					</div>
					
					<!-- Alerta de Sucesso -->
					{{#if success_message}}
					<div class="alert alert-success">
						<button type="button" class="close" data-dismiss="alert">
							<i class="ace-icon fa fa-times"></i>
						</button>
						<strong>
							<i class="ace-icon fa fa-check"></i>
							Sucesso!
						</strong>
						{{success_message}}
					</div>
					{{/if}}
					
					<!-- Alerta de Erro -->
					{{#if error_message}}
					<div class="alert alert-danger">
						<button type="button" class="close" data-dismiss="alert">
							<i class="ace-icon fa fa-times"></i>
						</button>
						<strong>
							<i class="ace-icon fa fa-times"></i>
							Erro!
						</strong>
						{{error_message}}
					</div>
					{{/if}}
					
					<div class="page-content"><!-- .page-content -->
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<div class="row">
									<div class="col-xs-12">
											<div class="clearfix" >
												
											</div>

											<div id="dynamic-table_wrapper" class="dataTables_wrapper form-inline no-footer">
											</div>
											
											<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
												
												<thead>
													<tr role="row">
														<th class="center">
															<label class="pos-rel">
																<input type="checkbox" class="ace" />
																<span class="lbl"></span>
															</label>
														</th>

														<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1">Data Aplicação</th>
														<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1">Beneficiário</th>
														<th class="sorting" tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="1">Aplicador (Terapeuta)</th>
														<th>Ação
															&nbsp;&nbsp;&nbsp;&nbsp;
															<a href="/menu/nutricao/ebai/cad">
																<i class="menu-icon fa fa-plus purple"></i>
															</a>
														</th>

													</tr>
													
												</thead>
												
												<tbody>
													{{#each ebais}}
														<tr role="row" class="odd">

															<th class="center">
																<label class="pos-rel">
																	<input type="checkbox" class="ace" />
																	<span class="lbl"></span>
																</label>
															</th>

															<td>{{this.dataaplica}}</td>
															<td>{{this.beneficiarioNome}}</td>
															<td>{{this.usuarioCadNome}}</td>

															<td>
																<div class="action-buttons">
																
																	<a class="green" href="/menu/nutricao/ebai/edi/{{this._id}}">
																		<i class="ace-icon fa fa-pencil bigger-130"></i>
																	</a>
																	<a class="red" href="/menu/nutricao/ebai/del/{{this._id}}" onclick="return confirm('Tem certeza que deseja excluir esta escala EBAI?');">
																		<i class="ace-icon fa fa-trash-o bigger-130"></i>
																	</a>
																	<a class="purple custom-tooltip" name="acaoCrud" id="acaoCrud-{{this._id}}">
																			<i class="ace-icon fa fa-eye bigger-130"></i>
																			<span class="tooltip-text">
																				<!-- Bloco Última Edição -->
																				<strong>Última Edição:</strong>
																				{{#if this.dataedi}}
																					<p><b>{{this.dataedi}}</b></p>
																				{{else}}
																					<p>--/--/---- h--:--</p>
																				{{/if}}
																				{{#if this.usuarioEdiNome}}
																					<p>Por: {{this.usuarioEdiNome}}</p>
																				{{else}}
																					<p>Por: Não informado</p>
																				{{/if}}

																				<!-- Bloco Cadastrado em -->
																				<strong>Cadastrado em:</strong>
																				{{#if this.datacad}}
																					<p><b>{{this.datacad}}</b></p>
																				{{else}}
																					<p>--/--/---- h--:--</p>
																				{{/if}}
																				{{#if this.usuarioCadNome}}
																					<p>Por: {{this.usuarioCadNome}}</p>
																				{{else}}
																					<p>Por: Não informado</p>
																				{{/if}}
																			</span>
																		</a>
																	
																</div>
																										
															</td>
												  
														</tr>
													{{/each}}
												</tbody>

											</table>

											<div class="space-4"></div>
											
										
											
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->



			<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse display">
				<i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
			</a>
		</div><!-- /.main-container ace-save-state -->

		
		<script type="text/javascript">
			if('ontouchstart' in document.documentElement) document.write("<script src='../../../assets/js/jquery.mobile.custom.min.js'>"+"<"+"/script>");
		</script>
		<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		

		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
			"language": { "url": "/js/lang/datatable-pt-br.json" },
			"aaSorting": [],
			"responsive": true,
			"lengthMenu": [ 200, 300, 500],
			"lengthChange": true,
			"autoWidth": true,
			"paging": true,
			"searching": true,
			"ordering": true,
			"info": true,
			
			select: {
						style: 'multi'
					}
			});
		});
		$.fn.dataTable.Buttons.defaults.dom.container.className = 'dt-buttons btn-overlap btn-group btn-overlap';
		</script>
	

	</body>

</html>