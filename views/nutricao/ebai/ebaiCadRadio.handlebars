																<input type="hidden" name="ebaiCrescimento" id="ebaiCrescimento" value="" />
																<div class="ebai-slider-labels">
																	<span>Crescendo pouco</span>
																	<span style="float: right;">Crescendo bem</span>
																</div>
															</td>
															<td class="center">
																<span class="ebai-slider-value" id="value-ebaiCrescimento">Não respondido</span>
															</td>
														</tr>
														
														<!-- Questão 13 -->
														<tr>
															<td>13. Como a alimentação influencia sua relação com a criança?</td>
															<td>
																<div class="ebai-slider" id="slider-ebaiRelacaocrianca"></div>
																<input type="hidden" name="ebaiRelacaocrianca" id="ebaiRelacaocrianca" value="" />
