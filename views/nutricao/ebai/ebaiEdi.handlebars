		</style>
		<script>
		function carregaBody() {
			console.log("🔍 Iniciando carregaBody EBAI...");
			
			// 1️⃣ Formata data de aplicação (converte de ISO para yyyy-mm-dd)
			const dataAplicaEdi = document.getElementById("ebaiDataaplicaEdi")?.value;
			console.log("📅 Data recebida do banco:", dataAplicaEdi);
			
			if (dataAplicaEdi) {
				try {
					const dataObj = new Date(dataAplicaEdi);
					
					if (!isNaN(dataObj.getTime())) {
						const ano = dataObj.getFullYear();
						const mes = String(dataObj.getMonth() + 1).padStart(2, '0');
						const dia = String(dataObj.getDate()).padStart(2, '0');
						
						const dataFormatada = `${ano}-${mes}-${dia}`;
						console.log("✅ Data formatada:", dataFormatada);
						
						document.getElementById("ebaiDataaplica").value = dataFormatada;
					} else {
						console.error("❌ Data inválida:", dataAplicaEdi);
					}
				} catch (error) {
					console.error("❌ Erro ao formatar data:", error);
				}
			} else {
				console.warn("⚠️ Campo de data vazio");
			}
			
			// 2️⃣ Mapeamento de campos simples (select e textarea)
			const mapaCampos = [
				["ebaiBeneid", "ebaiBeneidEdi"],
				["ebaiComentarios", "ebaiComentariosEdi"]
			];

			// 3️⃣ Popula campos simples
			mapaCampos.forEach(([dest, orig]) => {
				const elOrig = document.getElementById(orig);
				const elDest = document.getElementById(dest);
				
				if (!elOrig || !elDest) return;
				
				const valor = elOrig.value;
				
				if (elDest.tagName === "SELECT") {
					$(elDest).val(valor).trigger('change');
				} else {
					elDest.value = valor;
				}
			});

			// 4️⃣ Lista de todos os sliders com suas descrições
			const sliders = [
				{ id: 'ebaiMomentosrefeicao', labels: ['1 - Muito difícil', '2', '3', '4', '5', '6', '7 - Fácil'] },
				{ id: 'ebaiPreocupacao', labels: ['1 - Não estou preocupado', '2', '3', '4', '5', '6', '7 - Estou muito preocupado'] },
				{ id: 'ebaiApetite', labels: ['1 - Nunca tem fome', '2', '3', '4', '5', '6', '7 - Tem um Bom apetite'] },
				{ id: 'ebaiRecusacomer', labels: ['1 - No início', '2', '3', '4', '5', '6', '7 - No fim'] },
				{ id: 'ebaiTemporefeicao', labels: ['1 - 1-10 min', '2 - 11-20', '3 - 21-30', '4 - 31-40', '5 - 41-50', '6 - 51-60', '7 - >60 min'] },
				{ id: 'ebaiComportamento', labels: ['1 - Se comporta bem', '2', '3', '4', '5', '6', '7 - Faz bagunça'] },
				{ id: 'ebaiNauseavomita', labels: ['1 - Nunca', '2', '3', '4', '5', '6', '7 - Na maioria'] },
				{ id: 'ebaiComidaparada', labels: ['1 - Na maioria', '2', '3', '4', '5', '6', '7 - Nunca'] },
				{ id: 'ebaiDistrações', labels: ['1 - Nunca', '2', '3', '4', '5', '6', '7 - Na maioria'] },
				{ id: 'ebaiForçarcomer', labels: ['1 - Na maioria', '2', '3', '4', '5', '6', '7 - Nunca'] },
				{ id: 'ebaiMastigacao', labels: ['1 - Boa', '2', '3', '4', '5', '6', '7 - Muito ruim'] },
				{ id: 'ebaiCrescimento', labels: ['1 - Crescendo pouco', '2', '3', '4', '5', '6', '7 - Crescendo bem'] },
				{ id: 'ebaiRelacaocrianca', labels: ['1 - Muito negativa', '2', '3', '4', '5', '6', '7 - Não influencia'] },
				{ id: 'ebaiRelacaofamiliar', labels: ['1 - Não influencia', '2', '3', '4', '5', '6', '7 - Muito negativa'] }
			];

			// 5️⃣ Popula sliders com valores salvos
			sliders.forEach(slider => {
				const valorSalvo = document.getElementById(slider.id + "Edi")?.value;
				const $sliderEl = $('#slider-' + slider.id);
				const $valueEl = $('#value-' + slider.id);
				const $hiddenInput = $('#' + slider.id);
				
				console.log(`🎚️ Processando slider ${slider.id}:`, valorSalvo);
				
				if (valorSalvo && valorSalvo !== '' && valorSalvo !== '0') {
					const valor = parseInt(valorSalvo);
					
					if (valor >= 1 && valor <= 7) {
						// Configura o slider para o valor salvo
						$sliderEl.slider("value", valor);
						// Atualiza o texto exibido
						$valueEl.text(slider.labels[valor - 1]);
						// Atualiza o hidden input
						$hiddenInput.val(valor);
						console.log(`✅ Slider ${slider.id} configurado para ${valor}`);
					} else {
						console.warn(`⚠️ Valor inválido para ${slider.id}:`, valor);
					}
				} else {
					// Valor vazio ou 0 - mantém como não respondido
					$sliderEl.slider("value", 0);
					$valueEl.text('Não respondido');
					$hiddenInput.val('');
					console.log(`ℹ️ Slider ${slider.id} mantido como não respondido`);
				}
			});

			// 6️⃣ Terapeuta já está carregado via Handlebars
			console.log("✅ carregaBody EBAI concluído!");
		}
		</script>
	</head>

