			}
			
			/* Estilo personalizado para os sliders - COM MAIS ESPAÇO */
			.ebai-slider {
				margin: 20px 15px !important;
				width: calc(100% - 30px) !important;
				height: 12px !important;
				background: #e0e0e0 !important;
