<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Escala EBAI - Cadastro</title>
		<link rel="stylesheet" href="/assets/css/jquery-ui.custom.min.css" />
		<style>
			/* Aumentar padding das células da tabela */
			.table tbody td {
				padding: 15px 20px !important;
				vertical-align: middle !important;
			}
			
			/* Estilo personalizado para os sliders - COM MAIS ESPAÇO */
			.ebai-slider {
				margin: 20px 15px !important;
				width: calc(100% - 30px) !important;
				height: 12px !important;
				background: #e0e0e0 !important;
				border: 2px solid #b0b0b0 !important;
				border-radius: 6px !important;
				position: relative;
				cursor: pointer;
			}
			
			.ebai-slider .ui-slider-range {
				background: #2196f3 !important;
				border-radius: 4px !important;
				height: 100% !important;
			}
			
			.ebai-slider .ui-slider-handle {
				width: 24px !important;
				height: 24px !important;
				background: linear-gradient(135deg, #4fc3f7 0%, #2196f3 100%) !important;
				border: 3px solid #fff !important;
				border-radius: 50% !important;
				cursor: grab !important;
				outline: none !important;
				box-shadow: 0 2px 6px rgba(0,0,0,0.3) !important;
				position: absolute !important;
				top: 50% !important;
				transform: translateY(-50%) !important;
				margin-left: -12px !important;
				transition: all 0.2s ease !important;
			}
			
			.ebai-slider .ui-slider-handle:hover {
				background: linear-gradient(135deg, #64ddda 0%, #42a5f5 100%) !important;
				box-shadow: 0 4px 10px rgba(33,150,243,0.5) !important;
				transform: translateY(-50%) scale(1.15) !important;
			}
			
			.ebai-slider .ui-slider-handle:active {
				cursor: grabbing !important;
				transform: translateY(-50%) scale(1.1) !important;
			}
			
			.ebai-slider .ui-slider-handle:focus {
				outline: 2px solid #2196f3 !important;
				outline-offset: 2px !important;
			}
			
			.ebai-slider-value {
				font-weight: bold;
				color: #2196f3;
				min-width: 200px;
				text-align: center;
				display: inline-block;
				font-size: 13px;
				padding: 8px 15px;
				background: #f5f5f5;
				border-radius: 4px;
				border: 1px solid #ddd;
			}
			
			.ebai-slider-labels {
				font-size: 11px;
				color: #666;
				margin-top: 10px;
				display: flex;
				justify-content: space-between;
				padding: 0 5px;
			}
			
			/* Garantir que o slider seja visível mesmo sem jQuery UI */
			.ebai-slider::before {
				content: '← Arraste →';
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				font-size: 11px;
				color: #999;
				pointer-events: none;
				z-index: 0;
			}
			
			.ebai-slider.ui-slider::before {
				display: none;
			}
			
			/* Ajustar largura das colunas */
			.table thead th {
				padding: 12px 20px !important;
				font-weight: bold;
				background: #f5f5f5;
			}
		</style>
		<style>
			/* Botões de escore */
			.ebai-btn-score {
				border-radius: 10px;
				padding: 20px 15px;
				text-align: center;
				color: #fff;
				box-shadow: 0 4px 10px rgba(0,0,0,0.15);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
				min-height: 110px;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.ebai-btn-score:hover {
				transform: translateY(-3px);
				box-shadow: 0 6px 15px rgba(0,0,0,0.25);
			}
			.ebai-btn-score-label {
				font-size: 13px;
				text-transform: uppercase;
				letter-spacing: 1px;
				opacity: 0.9;
				margin-bottom: 8px;
				font-weight: 600;
			}
			.ebai-btn-score-value {
				font-size: 32px;
				font-weight: bold;
				line-height: 1.1;
			}

			/* Radio buttons de inversão - Tamanho ajustado e proporcional */
.radio-inv-group {
    display: inline-flex;
    gap: 6px;
    align-items: center;
}
.radio-inv-group label {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
    font-size: 12px; /* Fonte reduzida */
    padding: 4px 10px; /* Padding reduzido */
    border-radius: 4px;
    border: 1px solid #ccc; /* Borda mais fina */
    transition: all 0.2s ease;
    margin: 0;
    background: #fff;
}
.radio-inv-group label:hover {
    border-color: #aaa;
    background: #f9f9f9;
}
.radio-inv-group input[type="radio"] {
    width: 16px; /* Tamanho padrão, sem scale */
    height: 16px;
    margin: 0 6px 0 0;
    cursor: pointer;
    vertical-align: middle;
}
.radio-inv-group label.radio-sim {
    color: #c62828;
}
.radio-inv-group label.radio-nao {
    color: #2e7d32;
}
/* Estado marcado - Sim (Vermelho suave) */
.radio-inv-group label.radio-sim:has(input:checked) {
    background: #ffebee;
    border-color: #ef5350;
}
/* Estado marcado - Não (Verde suave) */
.radio-inv-group label.radio-nao:has(input:checked) {
    background: #e8f5e9;
    border-color: #66bb6a;
}

/* Classe para destacar campos obrigatórios não preenchidos */
.campo-erro {
    border: 2px solid #f44336 !important;
    background-color: #fff8f8 !important;
    transition: all 0.3s ease;
}
		</style>
		
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">

		<div class="main-container ace-save-state" id="main-container">

			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Nutrição</a>
							</li>
							<li>
								<a href="#">Escala EBAI</a>
							</li>
							<li class="active">Cadastro</li>
						</ul>
					</div>

					<div class="row">
						<div class="col-xs-12">
							<form class="form-horizontal" id="formEbai" role="form" action="/menu/nutricao/ebai/add" method="POST">
								
								<!-- Widget Dados Básicos -->
								<div class="widget-box">
