													</tbody>
												</table>
											</div>
											
										</div>
									</div>
								</div>
								<div class="space-4"></div>
								
								<!-- Widget Comentários -->
								<div class="widget-box">
									<div class="widget-header">
										<h4 class="widget-title">Comentários adicionais</h4>
										<span class="widget-toolbar">
											<a href="#" data-action="reload">
												<i class="ace-icon fa fa-refresh"></i>
											</a>
											<a href="#" data-action="collapse">
												<i class="ace-icon fa fa-chevron-up"></i>
											</a>
										</span>
									</div>
									<div class="widget-body">
										<div class="widget-main">
											
											<label>Observações</label>
											<div class="form-group">
												<div class="col-sm-12">
													<textarea name="ebaiComentarios" id="ebaiComentarios" class="form-control" rows="4" placeholder="Digite aqui observações adicionais sobre a avaliação..."></textarea>
												</div>
											</div>
											
										</div>
									</div>
								</div>
								
								<div class="space-4"></div>
								<div class="space-4"></div>

								<div class="form-actions">
									<div class="col-md-offset-3 col-md-9">
										<button class="btn btn-info" name="acao" type="submit">
											<i class="ace-icon fa fa-check bigger-110"></i>
											Salvar
										</button>
										&nbsp; &nbsp; &nbsp;
										<button class="btn btn-warning" type="reset">
											<i class="ace-icon fa fa-undo bigger-110"></i>
											Limpar
										</button>
										&nbsp; &nbsp; &nbsp;
										<a href="/menu/nutricao/ebai/lis" class="btn btn-danger">
											<i class="ace-icon fa fa-times bigger-110"></i>
											Cancelar
										</a>
									</div>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- Modal de Aviso de Perguntas Não Respondidas -->
			<div class="modal fade" id="modalAvisoEbai" tabindex="-1" role="dialog" aria-labelledby="modalAvisoLabel">
				<div class="modal-dialog" role="document">
					<div class="modal-content">
						<div class="modal-header" style="background-color: #ff9800; color: white;">
							<button type="button" class="close" data-dismiss="modal" aria-label="Close">
								<span aria-hidden="true" style="color: white;">&times;</span>
							</button>
							<h4 class="modal-title" id="modalAvisoLabel">
								<i class="ace-icon fa fa-exclamation-triangle"></i> Atenção
							</h4>
						</div>
						<div class="modal-body">
							<p>Existem <strong id="qtdPerguntasNaoRespondidas" style="color: #d32f2f; font-size: 18px;">0</strong> pergunta(s) que ainda não foram respondidas (valor 0).</p>
							<p>Deseja salvar mesmo assim para continuar depois, ou prefere voltar e responder agora?</p>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-default" data-dismiss="modal">
								<i class="ace-icon fa fa-arrow-left"></i> Voltar e responder
							</button>
							<button type="button" class="btn btn-warning" id="btnForcarSalvar">
								<i class="ace-icon fa fa-save"></i> Salvar mesmo assim
							</button>
						</div>
					</div>
				</div>
			</div>
		<!-- Scripts -->
		<script src="/assets/js/jquery.min.js"></script>
		<script src="/assets/js/jquery-ui.custom.min.js"></script>
		<script>
			$(document).ready(function() {
				// Definição das perguntas e seus estados
				const perguntas = [
					{ n:1,  id:'ebaiMomentosrefeicao',  texto:'O que você acha dos momentos de refeições com a sua criança?', invDefault:true },
					{ n:2,  id:'ebaiPreocupacao',       texto:'Quão preocupado você está com a alimentação da sua criança?', invDefault:false },
					{ n:3,  id:'ebaiApetite',           texto:'Quanto de apetite (fome) sua criança tem?', invDefault:true },
					{ n:4,  id:'ebaiRecusacomer',       texto:'Quando a sua criança começa a se recusar a comer durante as refeições?', invDefault:true },
					{ n:5,  id:'ebaiTemporefeicao',     texto:'Quanto tempo (em minutos) dura a refeição da sua criança?', invDefault:false },
					{ n:6,  id:'ebaiComportamento',     texto:'Como a sua criança se comporta durante a refeição?', invDefault:false },
					{ n:7,  id:'ebaiNauseavomita',      texto:'A sua criança nausea, cospe ou vomita com algum tipo de alimento?', invDefault:false },
					{ n:8,  id:'ebaiComidaparada',      texto:'A sua criança fica com a comida parada na boca sem engolir?', invDefault:true },
					{ n:9,  id:'ebaiDistrações',        texto:'Você precisa ir atrás da sua criança ou usar distrações durante a refeição?', invDefault:false },
					{ n:10, id:'ebaiForçarcomer',       texto:'Você precisa forçar a sua criança a comer ou beber?', invDefault:true },
					{ n:11, id:'ebaiMastigacao',        texto:'Como é a habilidade de mastigação da sua criança?', invDefault:false },
					{ n:12, id:'ebaiCrescimento',       texto:'O que você acha do crescimento da sua criança?', invDefault:true },
					{ n:13, id:'ebaiRelacaocrianca',    texto:'Como a alimentação influencia sua relação com a criança?', invDefault:true },
					{ n:14, id:'ebaiRelacaofamiliar',   texto:'Como a alimentação influencia as relações familiares?', invDefault:false }
				];
				
				// Labels descritivos (APENAS PARA EXIBIÇÃO NA TELA)
				const labelsMap = {
					'ebaiMomentosrefeicao': ['1 - Muito difícil','2','3','4','5','6','7 - Fácil'],
					'ebaiPreocupacao':      ['1 - Não estou preocupado','2','3','4','5','6','7 - Estou muito preocupado'],
					'ebaiApetite':          ['1 - Nunca tem fome','2','3','4','5','6','7 - Tem um Bom apetite'],
					'ebaiRecusacomer':      ['1 - No início','2','3','4','5','6','7 - No fim'],
					'ebaiTemporefeicao':    ['1 - 1-10 min','2 - 11-20','3 - 21-30','4 - 31-40','5 - 41-50','6 - 51-60','7 - >60 min'],
					'ebaiComportamento':    ['1 - Se comporta bem','2','3','4','5','6','7 - Faz bagunça'],
					'ebaiNauseavomita':     ['1 - Nunca','2','3','4','5','6','7 - Na maioria'],
					'ebaiComidaparada':     ['1 - Na maioria','2','3','4','5','6','7 - Nunca'],
					'ebaiDistrações':       ['1 - Nunca','2','3','4','5','6','7 - Na maioria'],
					'ebaiForçarcomer':      ['1 - Na maioria','2','3','4','5','6','7 - Nunca'],
					'ebaiMastigacao':       ['1 - Boa','2','3','4','5','6','7 - Muito ruim'],
					'ebaiCrescimento':      ['1 - Crescendo pouco','2','3','4','5','6','7 - Crescendo bem'],
					'ebaiRelacaocrianca':   ['1 - Muito negativa','2','3','4','5','6','7 - Não influencia'],
					'ebaiRelacaofamiliar':  ['1 - Não influencia','2','3','4','5','6','7 - Muito negativa']
				};
				
				// Tabela de conversão Escore Bruto -> Escore T
				const tabelaT = {
					14:35,15:36,16:37,17:38,18:39,19:39,20:40,21:41,22:42,23:43,
					24:43,25:44,26:45,27:46,28:46,29:47,30:48,31:49,32:50,33:50,
					34:51,35:52,36:53,37:54,38:54,39:55,40:56,41:57,42:57,43:58,
					44:59,45:60,46:60,47:61,48:61,49:62,50:63,51:63,52:64,53:65,
					54:65,55:66,56:66,57:67,58:68,59:68,60:69,61:70,62:70,63:71,
					64:72,65:72,66:73,67:74,68:75,69:76,70:76,71:77,72:78,73:79,
					74:80,75:80,76:81,77:82,78:83,79:83,80:84,81:85,82:86,83:87,
					84:87,85:88,86:89,87:90,88:91,89:91,90:92,91:93,92:94,93:94,
					94:95,95:96,96:97,97:98,98:98
				};
				
				// Objeto em memória para controle absoluto dos valores
				const estado = {};
				perguntas.forEach(p => {
					estado[p.id] = { valor: 0, invertido: p.invDefault };
				});
				
				// ============================================================
				// INICIALIZAÇÃO DOS SLIDERS (CORRIGIDA E BLINDADA)
				// ============================================================
				perguntas.forEach(p => {
					const $sliderEl = $('#slider-' + p.id);
					const $valueEl  = $('#value-' + p.id);
					
					if ($.fn.slider) {
						$sliderEl.slider({
							value: 0, min: 0, max: 7, step: 1,
							create: function() { 
								$valueEl.text('Não respondido'); 
								// Garante que o hidden comece vazio
								const hidden = document.getElementById(p.id);
								if(hidden) hidden.value = ''; 
							},
							slide: function(e, ui) { 
								setValor(p.id, ui.value); // ui.value é SEMPRE o número (0 a 7)
							},
							change: function(e, ui) { 
								setValor(p.id, ui.value);
							}
						});
					}
				});
				
				// ============================================================
				// FUNÇÃO QUE ATUALIZA O VALOR (SEPARA VISUAL DO DADO)
				// ============================================================
				function setValor(id, valor) {
					estado[id].valor = valor;
					
					// 1. ATUALIZA APENAS O TEXTO VISUAL PARA O TERAPEUTA
					const $valueEl = $('#value-' + id);
					const labels = labelsMap[id];
					if (valor === 0) {
						$valueEl.text('Não respondido');
					} else {
						$valueEl.text(labels[valor - 1]); // Ex: "4 - 31-40"
					}
					
					// 2. ARMAZENA APENAS O NUMERAL NO CAMPO HIDDEN (PARA O BANCO)
					const hiddenSlider = document.getElementById(id);
					if (hiddenSlider) {
						hiddenSlider.value = valor; // Ex: "4" (NUNCA a descrição)
					}
					
					// 3. RECÁLCULO IMEDIATO
					recalcularTudo();
				}
				
				// ============================================================
				// MONTA A TABELA DE RESUMO COM RADIO BUTTONS
				// ============================================================
				const $tbody = $('#tblResumoEbai tbody');
				perguntas.forEach(p => {
					const checkedSim = p.invDefault ? 'checked' : '';
					const checkedNao = p.invDefault ? '' : 'checked';
					const linha = `
						<tr data-id="${p.id}">
							<td class="center"><strong>${p.n}</strong></td>
							<td>${p.texto}</td>
							<td class="center"><span class="val-original">-</span></td>
							<td class="center">
								<div class="radio-inv-group">
									<label class="radio-sim">
										<input type="radio" name="ebaiInvRadio${p.n}" value="true" ${checkedSim} />
										<span>Sim</span>
									</label>
									<label class="radio-nao">
										<input type="radio" name="ebaiInvRadio${p.n}" value="false" ${checkedNao} />
										<span>Não</span>
									</label>
								</div>
								<input type="hidden" name="ebaiInv${capitalize(p.id)}" class="hid-inv" data-id="${p.id}" value="${p.invDefault}" />
							</td>
							<td class="center"><strong class="val-final">0</strong></td>
						</tr>
					`;
					$tbody.append(linha);
				});
				
				function capitalize(s){ return s.charAt(0).toUpperCase() + s.slice(1); }
				
				// ============================================================
				// EVENTO: MUDANÇA NOS RADIOS DE INVERSÃO
				// ============================================================
				$(document).on('change', '.radio-inv-group input[type="radio"]', function(){
					const $tr  = $(this).closest('tr');
					const id   = $tr.data('id');
					const val  = $(this).val() === 'true'; 
					
					estado[id].invertido = val;
					$tr.find('.hid-inv').val(val ? 'true' : 'false');
					recalcularTudo();
				});
				
				// ============================================================
				// FUNÇÃO PRINCIPAL DE CÁLCULO
				// ============================================================
				function recalcularTudo() {
					let escoreBruto = 0;
					
					perguntas.forEach(p => {
						const original  = estado[p.id].valor;
						const invertido = estado[p.id].invertido;
						
						let final = 0;
						if (original > 0) {
							final = invertido ? (8 - original) : original;
						}
						
						const $row = $('tr[data-id="' + p.id + '"]');
						$row.find('.val-original').text(original > 0 ? original : '-');
						$row.find('.val-final').text(final);
						
						escoreBruto += final;
					});
					
					const escoreT = tabelaT[escoreBruto] || 0;
					let interpretacao = '';
					if (escoreBruto === 0) interpretacao = 'Aguardando...';
					else if (escoreT <= 60) interpretacao = 'Sem dificuldades';
					else if (escoreT <= 65) interpretacao = 'Dificuldades leves';
					else if (escoreT <= 70) interpretacao = 'Dificuldades moderadas';
					else interpretacao = 'Dificuldades severas';
					
					$('#resEscoreBruto').text(escoreBruto);
					$('#resEscoreT').text(escoreT);
					$('#resInterpretacao').text(interpretacao);
					
					// Atualiza hiddens finais para o backend
					document.getElementById('ebaiEscoreBruto').value = escoreBruto;
					document.getElementById('ebaiEscoreT').value = escoreT;
					document.getElementById('ebaiInterpretacao').value = interpretacao;
				}
				
				// ============================================================
				// SELECT2
				// ============================================================
				if (typeof $.fn.select2 === 'function') {
					$('.select2').select2({ width:'100%', placeholder:'Escolha...', allowClear:true });
				}
				
				// Inicializa cálculo
				recalcularTudo();

				    // ============================================================
    // VARIÁVEL DE CONTROLE PARA ENVIO FORÇADO
    // ============================================================
    let allowSubmit = false; 

    // ============================================================
    // VALIDAÇÃO NO ENVIO DO FORMULÁRIO
    // ============================================================
    $('#formEbai').on('submit', function(e) {
        let isValidMandatory = true;
        let mensagensMandatory = [];
        
        // Limpa estilos de erro anteriores
        $('#ebaiBeneid, #ebaiDataaplica').removeClass('campo-erro');
        
        // 1. Validação RÍGIDA: Beneficiário e Data (NÃO permite salvar)
        const beneId = $('#ebaiBeneid').val();
        if (!beneId || beneId === '') {
            isValidMandatory = false;
            mensagensMandatory.push("• Selecione o Beneficiário.");
            $('#ebaiBeneid').addClass('campo-erro');
        }
        
        const dataAplica = $('#ebaiDataaplica').val();
        if (!dataAplica || dataAplica === '') {
            isValidMandatory = false;
            mensagensMandatory.push("• Informe a Data da Aplicação.");
            $('#ebaiDataaplica').addClass('campo-erro');
        }
        
        if (!isValidMandatory) {
            e.preventDefault(); // Cancela o submit imediatamente
            alert("Atenção: Dados obrigatórios ausentes!\n\n" + mensagensMandatory.join("\n") + "\n\nPor favor, preencha os campos destacados em vermelho.");
            
            $('html, body').animate({
                scrollTop: $(".campo-erro").first().offset().top - 150
            }, 600);
            
            setTimeout(() => { $('.campo-erro').removeClass('campo-erro'); }, 3000);
            return false; // Para a execução do script aqui
        }
        
        // 2. Validação SUAVE: Perguntas não respondidas (Apenas avisa)
        if (!allowSubmit) {
            let naoRespondidas = 0;
            perguntas.forEach(p => {
                if (estado[p.id].valor === 0) {
                    naoRespondidas++;
                }
            });
            
            if (naoRespondidas > 0) {
                e.preventDefault(); // Impede o envio imediato
                $('#qtdPerguntasNaoRespondidas').text(naoRespondidas);
                $('#modalAvisoEbai').modal('show'); // Mostra o modal
                return false;
            }
        }
        
        // Se chegou aqui, está tudo ok (ou o usuário clicou em "Salvar mesmo assim")
        return true;
    });
    
    // ============================================================
    // AÇÃO DO BOTÃO "SALVAR MESMO ASSIM" NO MODAL
    // ============================================================
    $('#btnForcarSalvar').on('click', function() {
        allowSubmit = true; // Autoriza o envio na próxima tentativa
        $('#modalAvisoEbai').modal('hide'); // Fecha o modal
        
        // Dispara o submit do formulário programaticamente após fechar o modal
        setTimeout(function() {
            $('#formEbai').submit();
        }, 300);
    });
    
    // Reseta a flag se o usuário fechar o modal pelo "X" ou clicando fora
    $('#modalAvisoEbai').on('hidden.bs.modal', function () {
        allowSubmit = false;
    });
			});
		</script>
	</body>
</html>