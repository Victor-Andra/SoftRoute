			}
			
			// Fator 7: Alergias e Intolerância (itens 24-26)
			function calcularFator7() {
				var item24 = parseInt($('#valItem24').text()) || 0;
				var item25 = parseInt($('#valItem25').text()) || 0;
				var item26 = parseInt($('#valItem26').text()) || 0;
				var total = item24 + item25 + item26;
				
				$('#totFator7Final').text(total);
				$('#compaliTotalergiasintolerancia').val(total);
			}
			
			// Total Geral
			function calcularTotalGeral() {
				var fator1 = parseInt($('#totFator1Final').text()) || 0;
				var fator2 = parseInt($('#totFator2Final').text()) || 0;
				var fator3 = parseInt($('#totFator3Final').text()) || 0;
				var fator4 = parseInt($('#totFator4Final').text()) || 0;
				var fator5 = parseInt($('#totFator5Final').text()) || 0;
				var fator6 = parseInt($('#totFator6Final').text()) || 0;
				var fator7 = parseInt($('#totFator7Final').text()) || 0;
				var totalGeral = fator1 + fator2 + fator3 + fator4 + fator5 + fator6 + fator7;
				
				$('#totGeral').text(totalGeral);
				$('#compaliTottotalgeral').val(totalGeral);
			}
		</script>
		
