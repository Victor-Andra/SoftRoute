		<script type="text/javascript">
			// Função para atualizar os totais quando um radio button for selecionado
			$(document).on('change', 'input[type="radio"][data-item]', function() {
				var itemNum = $(this).data('item');
				var valor = parseInt($(this).val());
				
				// Atualiza o valor do item na tabela de totais
				$('#valItem' + itemNum).text(valor);
				
				// Calcula os totais de cada fator
				calcularFator1();
				calcularFator2();
				calcularFator3();
				calcularFator4();
				calcularFator5();
				calcularFator6();
				calcularFator7();
				
				// Calcula o total geral
				calcularTotalGeral();
			});
			
			// Fator 1: Motricidade na Mastigação (itens 1-4)
			function calcularFator1() {
				var item1 = parseInt($('#valItem1').text()) || 0;
				var item2 = parseInt($('#valItem2').text()) || 0;
				var item3 = parseInt($('#valItem3').text()) || 0;
				var item4 = parseInt($('#valItem4').text()) || 0;
				var total = item1 + item2 + item3 + item4;
				
				$('#totFator1Final').text(total);
				$('#compaliTotmotricidademastigacao').val(total);
			}
			
			// Fator 2: Seletividade Alimentar (itens 5-7)
			function calcularFator2() {
				var item5 = parseInt($('#valItem5').text()) || 0;
				var item6 = parseInt($('#valItem6').text()) || 0;
				var item7 = parseInt($('#valItem7').text()) || 0;
				var total = item5 + item6 + item7;
				
				$('#totFator2Final').text(total);
				$('#compaliTotseletividadealimentar').val(total);
			}
			
			// Fator 3: Habilidades nas Refeições (itens 8-12)
			function calcularFator3() {
				var item8 = parseInt($('#valItem8').text()) || 0;
				var item9 = parseInt($('#valItem9').text()) || 0;
				var item10 = parseInt($('#valItem10').text()) || 0;
				var item11 = parseInt($('#valItem11').text()) || 0;
				var item12 = parseInt($('#valItem12').text()) || 0;
				var total = item8 + item9 + item10 + item11 + item12;
				
				$('#totFator3Final').text(total);
				$('#compaliTothabilidadesrefeicoes').val(total);
			}
			
			// Fator 4: Comportamento Inadequado (itens 13-14)
			function calcularFator4() {
				var item13 = parseInt($('#valItem13').text()) || 0;
				var item14 = parseInt($('#valItem14').text()) || 0;
				var total = item13 + item14;
				
				$('#totFator4Final').text(total);
				$('#compaliTotcomportinadequadorefeicoes').val(total);
			}
			
			// Fator 5: Comportamentos Rígidos (itens 15-20)
			function calcularFator5() {
				var item15 = parseInt($('#valItem15').text()) || 0;
				var item16 = parseInt($('#valItem16').text()) || 0;
				var item17 = parseInt($('#valItem17').text()) || 0;
				var item18 = parseInt($('#valItem18').text()) || 0;
				var item19 = parseInt($('#valItem19').text()) || 0;
				var item20 = parseInt($('#valItem20').text()) || 0;
				var total = item15 + item16 + item17 + item18 + item19 + item20;
				
				$('#totFator5Final').text(total);
				$('#compaliTotcomportrigidosalimentacao').val(total);
			}
			
			// Fator 6: Comportamento Opositor (itens 21-23)
			function calcularFator6() {
				var item21 = parseInt($('#valItem21').text()) || 0;
				var item22 = parseInt($('#valItem22').text()) || 0;
