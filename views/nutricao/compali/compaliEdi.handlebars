		<script>
		function carregaBody() {
			// 1️⃣ Formata data de aplicação (converte de ISO para yyyy-mm-dd)
			const dataAplicaEdi = document.getElementById("compaliDataaplicaEdi")?.value;
			console.log("🔍 Data recebida do banco:", dataAplicaEdi);
			
			if (dataAplicaEdi) {
				try {
					const dataObj = new Date(dataAplicaEdi);
					if (!isNaN(dataObj.getTime())) {
						const ano = dataObj.getFullYear();
						const mes = String(dataObj.getMonth() + 1).padStart(2, '0');
						const dia = String(dataObj.getDate()).padStart(2, '0');
						const dataFormatada = `${ano}-${mes}-${dia}`;
						console.log("✅ Data formatada:", dataFormatada);
						document.getElementById("compaliDataaplica").value = dataFormatada;
					} else {
						console.error("❌ Data inválida:", dataAplicaEdi);
					}
				} catch (error) {
					console.error("❌ Erro ao formatar data:", error);
				}
			}
			
			// 2️⃣ Mapeamento de campos (exceto radio buttons)
			const mapaCampos = [
				["compaliBeneid", "compaliBeneidEdi"],
				["compaliComentarios", "compaliComentariosEdi"]
			];

			// 3️⃣ Popula campos com verificação de segurança
			mapaCampos.forEach(([dest, orig]) => {
				const elOrig = document.getElementById(orig);
				const elDest = document.getElementById(dest);
				
				if (!elOrig || !elDest) return;
				
				const valor = elOrig.value;
				
				if (elDest.tagName === "SELECT") {
					$(elDest).val(valor).trigger('change');
				} else {
					elDest.value = valor;
				}
			});

			// 4️⃣ Popula radio buttons
			const camposRadio = [
				"compaliMastigar", "compaliEngolesem", "compaliLevaalimento", "compaliBocaaberta",
				"compaliEvitavegetais", "compaliRetiratempero", "compaliEvitafrutas", "compaliInquietacao",
				"compaliSentarmesa", "compaliTalheres", "compaliDerramacomida", "compaliObjetosestranhos",
				"compaliVomita", "compaliGolfa", "compaliMesmosutens", "compaliMesmolugar",
				"compaliMesmosalim", "compaliCoresemel", "compaliMesmamarca", "compaliRitualcomer",
				"compaliPegaforahor", "compaliPegaoutros", "compaliGrandequant", "compaliIntolgluten",
				"compaliAlergia", "compaliIntollactose"
			];

			camposRadio.forEach(nome => {
				const elEdi = document.getElementById(nome + "Edi");
				if (elEdi && elEdi.value) {
					const valor = elEdi.value;
					const radio = document.querySelector(`input[name="${nome}"][value="${valor}"]`);
					if (radio) {
						radio.checked = true;
						// Atualiza visualmente o valor do item
						var itemNum = $(radio).data('item');
						if (itemNum) {
							$('#valItem' + itemNum).text(valor);
						}
					}
				}
			});

			// 5️⃣ Carrega os totais do banco e atualiza a interface
			carregarTotaisDoBanco();
			
			// 6️⃣ Recalcula todos os totais para garantir consistência
			calcularFator1();
			calcularFator2();
			calcularFator3();
			calcularFator4();
			calcularFator5();
			calcularFator6();
			calcularFator7();
			calcularTotalGeral();
		}
		
		// Função para carregar os totais do banco
		function carregarTotaisDoBanco() {
			// Carrega valores dos totais
			const totais = {
				'compaliTotmotricidademastigacaoEdi': 'totFator1Final',
				'compaliTotseletividadealimentarEdi': 'totFator2Final',
				'compaliTothabilidadesrefeicoesEdi': 'totFator3Final',
				'compaliTotcomportinadequadorefeicoesEdi': 'totFator4Final',
				'compaliTotcomportrigidosalimentacaoEdi': 'totFator5Final',
				'compaliTotcomportopositoralimentacaoEdi': 'totFator6Final',
				'compaliTotalergiasintoleranciaEdi': 'totFator7Final',
				'compaliTottotalgeralEdi': 'totGeral'
			};
			
			for (let [orig, dest] of Object.entries(totais)) {
				const elOrig = document.getElementById(orig);
				const elDest = document.getElementById(dest);
				if (elOrig && elDest && elOrig.value) {
					elDest.textContent = elOrig.value;
				}
			}
		}
		</script>
