<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Avaliação de Escala de LABIRINTO - Cadastro</title>
		<link rel="stylesheet" href="/assets/css/jquery-ui.custom.min.css" />
		<style>
			/* Aumentar padding das células da tabela */
			.table tbody td {
				padding: 15px 20px !important;
				vertical-align: middle !important;
			}
			
			/* Estilo personalizado para os sliders */
			.compali-slider {
				margin: 20px 15px !important;
				width: calc(100% - 30px) !important;
				height: 12px !important;
				background: #e0e0e0 !important;
				border: 2px solid #b0b0b0 !important;
				border-radius: 6px !important;
				position: relative;
				cursor: pointer;
			}
			
			.compali-slider .ui-slider-range {
				background: #2196f3 !important;
				border-radius: 4px !important;
				height: 100% !important;
			}
			
			.compali-slider .ui-slider-handle {
				width: 24px !important;
				height: 24px !important;
				background: linear-gradient(135deg, #4fc3f7 0%, #2196f3 100%) !important;
				border: 3px solid #fff !important;
				border-radius: 50% !important;
				cursor: grab !important;
				outline: none !important;
				box-shadow: 0 2px 6px rgba(0,0,0,0.3) !important;
				position: absolute !important;
				top: 50% !important;
				transform: translateY(-50%) !important;
				margin-left: -12px !important;
				transition: all 0.2s ease !important;
			}
			
			.compali-slider .ui-slider-handle:hover {
				background: linear-gradient(135deg, #64ddda 0%, #42a5f5 100%) !important;
				box-shadow: 0 4px 10px rgba(33,150,243,0.5) !important;
				transform: translateY(-50%) scale(1.15) !important;
			}
			
			.compali-slider .ui-slider-handle:active {
				cursor: grabbing !important;
				transform: translateY(-50%) scale(1.1) !important;
			}
			
			.compali-slider .ui-slider-handle:focus {
				outline: 2px solid #2196f3 !important;
				outline-offset: 2px !important;
			}
			
			.compali-slider-value {
				font-weight: bold;
				color: #2196f3;
				min-width: 200px;
				text-align: center;
				display: inline-block;
				font-size: 13px;
				padding: 8px 15px;
				background: #f5f5f5;
				border-radius: 4px;
				border: 1px solid #ddd;
			}
			
			.compali-slider-labels {
				font-size: 11px;
				color: #666;
				margin-top: 10px;
				display: flex;
				justify-content: space-between;
				padding: 0 5px;
			}
			
			/* Garantir que o slider seja visível mesmo sem jQuery UI */
			.compali-slider::before {
				content: '← Arraste →';
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				font-size: 11px;
				color: #999;
				pointer-events: none;
				z-index: 0;
			}
			
			.compali-slider.ui-slider::before {
				display: none;
			}
			
			/* Ajustar largura das colunas */
			.table thead th {
				padding: 12px 20px !important;
				font-weight: bold;
				background: #f5f5f5;
			}
		</style>
	</head>

