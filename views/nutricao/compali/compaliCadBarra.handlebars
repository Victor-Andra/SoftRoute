		<!-- Scripts -->
		<script src="/assets/js/jquery.min.js"></script>
		<script src="/assets/js/jquery-ui.custom.min.js"></script>
		<script>
			$(document).ready(function() {
				// Labels para cada posição do slider (6 posições: 0-5)
				// Posição 0 = "-" (não preenchido)
				// Posições 1-5 = valores 0-4
				const labels = [
					'Não preenchido',      // posição 0 → valor "-"
					'0 - Não',             // posição 1 → valor "0"
					'1 - Raramente',       // posição 2 → valor "1"
					'2 - Às vezes',        // posição 3 → valor "2"
					'3 - Frequentemente',  // posição 4 → valor "3"
					'4 - Sempre'           // posição 5 → valor "4"
				];

				// Lista de todos os campos do COMPALI
				const campos = [
					'compaliMastigar', 'compaliEngolesem', 'compaliLevaalimento',
					'compaliBocaaberta', 'compaliEvitavegetais', 'compaliRetiratempero',
					'compaliEvitafrutas', 'compaliInquietacao', 'compaliSentarmesa',
					'compaliTalheres', 'compaliDerramacomida', 'compaliObjetosestranhos',
					'compaliVomita', 'compaliGolfa', 'compaliMesmosutens',
					'compaliMesmolugar', 'compaliMesmosalim', 'compaliCoresemel',
					'compaliMesmamarca', 'compaliRitualcomer', 'compaliPegaforahor',
					'compaliPegaoutros', 'compaliGrandequant', 'compaliIntolgluten',
					'compaliAlergia', 'compaliIntollactose'
				];

				// Inicializa cada slider
				campos.forEach(campo => {
					const $sliderEl = $('#slider-' + campo);
					const $valueEl = $('#value-' + campo);
					const $hiddenInput = $('#' + campo);
					
					if ($.fn.slider) {
						$sliderEl.slider({
							value: 0,
							min: 0,
							max: 5,
							step: 1,
							create: function(event, ui) {
								$valueEl.text('Não preenchido');
								$hiddenInput.val('-');
							},
							slide: function(event, ui) {
								if (ui.value === 0) {
									$valueEl.text('Não preenchido');
									$hiddenInput.val('-');
								} else {
									$valueEl.text(labels[ui.value]);
									$hiddenInput.val(ui.value - 1);
								}
							},
							change: function(event, ui) {
								if (ui.value === 0) {
									$valueEl.text('Não preenchido');
									$hiddenInput.val('-');
								} else {
									$valueEl.text(labels[ui.value]);
									$hiddenInput.val(ui.value - 1);
								}
							}
						});
					} else {
						console.error('jQuery UI Slider não está carregado!');
						$valueEl.text('Erro: jQuery UI não carregado');
					}
				});

				// Inicializa Select2
				if (typeof $.fn.select2 === 'function') {
					$('.select2').select2({
						width: '100%',
						placeholder: 'Escolha...',
						allowClear: true
					});
				}
			});
		</script>
