		<style>
			/* ========================================================================
			🎨 TOOLTIP - COMPORTAMENTO HOVER (CRÍTICO)
			======================================================================== */

			/* Container do tooltip */
			.custom-tooltip {
				position: relative;
				display: inline-block;
				cursor: help;
				z-index: 99999 !important;
				vertical-align: middle;
			}

			/* Caixa do tooltip - INICIALMENTE OCULTA */
			.tooltip-text {
				visibility: hidden !important;      /* ← ESSENCIAL */
				opacity: 0 !important;              /* ← ESSENCIAL */
				width: max-content;
				max-width: 280px;
				background-color: #f3dfdf;
				color: #c00;
				font-size: 9px !important;
				text-align: left;
				border-radius: 4px;
				padding: 8px 10px;
				position: absolute;
				z-index: 100000 !important;
				bottom: 130%;
				left: 50%;
				transform: translateX(-50%);
				white-space: normal;
				box-shadow: 0 4px 10px rgba(0,0,0,0.2);
				border: 1px solid #e0b0b0;
				transition: opacity 0.2s ease, visibility 0.2s ease;
				line-height: 1.4;
				pointer-events: none !important;
			}

			/* Seta do tooltip */
			.tooltip-text::after {
				content: "";
				position: absolute;
				top: 100%;
				left: 50%;
				margin-left: -5px;
				border-width: 5px;
				border-style: solid;
				border-color: #f3dfdf transparent transparent transparent;
			}

			/* 👉 HOVER - MOSTRAR TOOLTIP (seletores redundantes para garantir) */
			.custom-tooltip:hover .tooltip-text,
			.custom-tooltip:hover > .tooltip-text,
			.custom-tooltip a:hover + .tooltip-text,
			.custom-tooltip i:hover + .tooltip-text {
				visibility: visible !important;
				opacity: 1 !important;
				pointer-events: none !important;
			}

			/* 👉 GARANTIR QUE A CÉLULA NÃO CORTE O TOOLTIP */
			#dynamic-table1 td:last-child {
				overflow: visible !important;
				position: static !important;
			}
			#dynamic-table1 tr {
				position: static !important;
			}
		</style>
