					document.getElementById("naveAdministradorEFinanceiro").remove();
					document.getElementById("naveTerapeuta").remove();
					document.getElementById("naveRecepcionista").remove();
					document.getElementById("naveAT").remove();
					document.getElementById("naveHo").remove();
					document.getElementById("naveCoordenador").remove();
					document.getElementById("naveSupervisor").remove();
					document.getElementById("naveGuia").remove();
					document.getElementById("naveFinan").remove();
					document.getElementById("naveFatura").remove();
					document.getElementById("naveAge").remove();
					document.getElementById("naveMkt").remove();
					document.getElementById("naveTaba").remove();
					document.getElementById("naveEvo").remove();
					document.getElementById("naveT").remove();
					//console.log("naveTerapeuta");
				}
			}
			
					
			function getCookie(name) {
				const value = `; ${document.cookie}`;
				const parts = value.split(`; ${name}=`);
				if (parts.length === 2) return parts.pop().split(';').shift();
				return null;
			}
			function identifyDb(){
				let db = ""; 
				switch (getCookie("preferredDb")) {
					case "SoftRoute":
						db = "";
						break;
					case "SoftRouteFazendinha":
						db = "Fazendinha";
						break;
					case "TESTE":
						db = "AREA DE TESTE";
						break;
					default:
						db = "";
						break;
				}
				console.log("Cookie preferredDb:"+ db);

				if (!db) {
					db = ""; // valor padrão
				}
				document.getElementById("empresaFantasia").innerHTML = `<small><i class="fa fa-puzzle-piece white"></i> Sis Route ${db}</small>`;
			}

			document.addEventListener("DOMContentLoaded", function() {
				const body = document.getElementById("main-body");
				const preferredDb = getCookie("preferredDb");

				if (preferredDb === "SoftRoute") {
					// Remove qualquer skin → "no-skin"
					body.className = "no-skin"; // ou body.removeAttribute("class");
				} else if (preferredDb === "SoftRouteFazendinha") {
					// Remove qualquer skin → "no-skin"
					body.className = "skin-5"; // ou body.removeAttribute("class");
				} else {
					// Aplica skin-5 para qualquer outro valor
					body.className = "skin-1";
				}
			});

		</script>
	</head>
