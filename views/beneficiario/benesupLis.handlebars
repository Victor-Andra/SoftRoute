<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista de beneficiários</title>
		 <style>
        /*Tooltip personalizado */
            .custom-tooltip {
                position: relative;
                display: inline-block;
                cursor: pointer;
            }

            .tooltip-text {
                visibility: hidden;
                width: max-content;
                background-color: #f3dfdf;
                color: red;
                font-size: 8px;
                text-align: left;
                border-radius: 4px;
                padding: 8px 12px;
                position: absolute;
                z-index: 9999;
                bottom: 125%; /* Acima do ícone */
                left: 50%;
                transform: translateX(-50%);
                opacity: 0.9;
                white-space: normal;
                min-width: 150px;
                max-width: 300px;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
                transition: opacity 0.3s;
            }

            .tooltip-text::after {
                content: "";
                position: absolute;
                top: 100%;
                left: 50%;
                margin-left: -5px;
                border-width: 5px;
                border-style: solid;
                border-color: #f3dfdf transparent transparent transparent;
            }

            /* Mostra o tooltip quando o mouse passa sobre o link */
            .custom-tooltip:hover .tooltip-text {
                visibility: visible;
            }
    </style>
		
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Lista dos Beneficiários - Visão dos Supervisores e Coordenador.</li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								
										<!-- PAGE CONTENT BEGINS -->
										<div class="row">
											<div class="col-xs-12">
												<div class="clearfix" >
													<div class="pull-right tableTools-container">
													</div>
												</div>

												<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid" aria-describedby="dynamic-table_info">
													<thead>
														<tr role="row">
															<th class="center">
																<label class="pos-rel">
																	<input type="checkbox" class="ace" />
																	<span class="lbl"></span>
																</label>
															</th>
															<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1">Beneficiário</th>
															<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1">Apelido</th>
															<th class="sorting" tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="1">Data Nascimento</th>
															<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1">Escola</th>
															<th class="sorting" tabindex="4" aria-controls="dynamic-table" rowspan="1" colspan="1">Endereço</th>
															<th class="sorting" tabindex="5" aria-controls="dynamic-table" rowspan="1" colspan="1">Ano Letivo</th>
															<th style="white-space: wrap;" class="sorting" tabindex="6" aria-controls="dynamic-table" rowspan="1" colspan="1">Série</th>
															<th class="sorting" tabindex="7" aria-controls="dynamic-table" rowspan="1" colspan="1">Turno</th>
															<th class="sorting" tabindex="8" aria-controls="dynamic-table" rowspan="1" colspan="1">Horário</th>
															<th class="sorting" tabindex="9" aria-controls="dynamic-table" rowspan="1" colspan="1">Responsáveis</th>
															<th class="sorting" tabindex="10" aria-controls="dynamic-table" rowspan="1" colspan="1">Contatos</th>
															<th style="white-space: wrap;" tabindex="11" aria-controls="dynamic-table" rowspan="1" colspan="1">E-mail</th>
															<th class="sorting" tabindex="12" aria-controls="dynamic-table" rowspan="1" colspan="1">Status</th>
															<th>Ação</th>
														</tr>
													</thead>
													<tbody>
														{{#each benes}}

															<tr role="row" class="odd">
																<td class="center">
																	<label class="pos-rel">
																		<input type="checkbox" class="ace" />
																		<span class="lbl"></span>
																	</label>
																</td>
																<td><span class="badge badge-info" style="white-space: wrap;">{{bene_nome}}</span></td>
																<td>{{bene_apelido}}</td>
																<td>{{datanasc}}</td>
																<td><span class="badge badge-info" style="white-space: wrap;">{{bene_escolanome}}</span></td>
																<td>
																	{{bene_escolaend}}<br>
																	{{bene_escolacomp}} 
																	{{bene_escolabairro}} {{bene_escolacidade}} {{bene_escolacep}}<br>
																	{{#each ../estados}}
																		{{#ifEqual this._id ../bene_escolauf}}
																			{{estado_uf}}
																		{{/ifEqual}}
																	{{/each}}
																</td>
																<td><span class="badge badge-danger">{{bene_escolaano}}</span></td>
																<td><span class="badge badge-pink" style="white-space: wrap;">{{bene_escolaserie}}</span></td>
																<td><span class="badge badge-warning" style="white-space: wrap;">{{bene_escolaturno}}</td>
																<td><span class="badge badge-info">Hora Ini:&nbsp;{{bene_escolahoraini}}<br>
																	<span class="badge badge-info">Hora Fim:&nbsp;{{bene_escolahorafim}}<br>
																</td>
																<td>
																	<span class="badge badge-danger" style="white-space: wrap;">{{bene_escolacoord}}</span><br>
																	<span class="badge badge-warning" style="white-space: wrap;">{{bene_escolaoutro1}}</span><br>
																	<span class="badge badge-pink" style="white-space: wrap;">{{bene_escolaoutro2}}</span><br>
																	<span class="badge badge-info" style="white-space: wrap;">{{bene_escolaoutro3}}</span><br>
																</td>
																<td>
																	<span class="badge badge-danger">{{bene_escolacoordtel}}</span><br>
																	<span class="badge badge-warning">{{bene_escolaoutro1tel}}</span><br>
																	<span class="badge badge-pink">{{bene_escolaoutro2tel}}</span><br>
																	<span class="badge badge-info">{{bene_escolaoutro3tel}}</span><br>
																</td>
																<td>
																	<a class="red">
																		<i class="ace-icon fa fa-envelope-o bigger-130" title="{{bene_escolaemail}}"></i>
																	</a>
																</td>
																{{#ifEqual this.bene_status "Inativo"}}
																	<td><span class="label label-sm label-danger">{{bene_status}}</span></td>
																	{{else}}
																	<td><span class="label label-sm label-success">{{bene_status}}</span></td>
																{{/ifEqual}}
																<td>
																	<div class="action-buttons">
																		<a class="blue" href="/menu/beneficiario/imp/{{_id}}">
																			<i class="ace-icon fa fa-print bigger-130"></i>
																		</a>
																		<a class="green" href="/menu/beneficiario/edisup/{{_id}}">
																			<i class="ace-icon fa fa-search bigger-130"></i>
																		</a>
																		<a class="purple custom-tooltip" name="acaoCrud" id="acaoCrud-{{_id}}">
																			<i class="ace-icon fa fa-eye bigger-130"></i>
																			<span class="tooltip-text">
																				<!-- Bloco Última Edição -->
																				<strong>Última Edição:</strong>
																				{{#if dataedi}}
																					<p><b>{{dataedi}}</b></p>
																				{{else}}
																					<p>--/--/----</p>
																				{{/if}}
																				{{#if usuarioEdiNome}}
																					<p>Por: {{usuarioEdiNome}}</p>
																				{{else}}
																					<p>Por: Não informado</p>
																				{{/if}}

																				<!-- Bloco Cadastrado em -->
																				<strong>Cadastrado em:</strong>
																				{{#if datacad}}
																					<p><b>{{datacad}}</b></p>
																				{{else}}
																					<p>--/--/----</p>
																				{{/if}}
																				{{#if usuarioCadNome}}
																					<p>Por: {{usuarioCadNome}}</p>
																				{{else}}
																					<p>Por: Não informado</p>
																				{{/if}}
																			</span>
																		</a>
																	</div>
																</td>
															</tr>
														{{/each}}
													</tbody>
												</table>
											</div>
										</div>
									
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

		
			<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse display">
				<i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
			</a>
		</div><!-- /.main-container ace-save-state -->

		<script type="text/javascript">
			if('ontouchstart' in document.documentElement) document.write("<script src='../../../assets/js/jquery.mobile.custom.min.js'>"+"<"+"/script>");
		</script>
		
		<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		

		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
			"language": { "url": "/js/lang/datatable-pt-br.json" },
			"aaSorting": [],
			"aoColumns": [{ "bSortable": false }, null, null, null, null, null, null, null, null, null, null, null, null, null, { "bSortable": false }],
			"responsive": true,
			"lengthMenu": [ 50, 100, 200],
			"lengthChange": true,
			"autoWidth": false,
			"paging": true,
			"lengthChange": true,
			"searching": true,
			"ordering": true,
			"info": true,
			
			select: {
						style: 'multi'
					}
			});
		});
		$.fn.dataTable.Buttons.defaults.dom.container.className = 'dt-buttons btn-overlap btn-group btn-overlap';
		</script>
	

	</body>

</html>