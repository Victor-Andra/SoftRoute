		<script type="text/javascript">
			// Nova função para pegar a data atual no formato dd/mm/yyyy
			function getDataAtualFormatada() {
				let data = new Date();
				let dia = String(data.getDate()).padStart(2, '0');
				let mes = String(data.getMonth() + 1).padStart(2, '0'); // Janeiro é 0!
				let ano = data.getFullYear();
				return `${dia}/${mes}/${ano}`;
			}

			// Função para converter data brasileira para objeto Date
			function parseDataBr(dataStr) {
				let [dia, mes, ano] = dataStr.split('/');
				return new Date(ano, mes - 1, dia);
			}

			// Sua função ajustaData modificada para aceitar o valor formatado em dd/mm/yyyy
			function ajustaData(){
				let fullDatas = document.getElementsByName("fullData");
				fullDatas.forEach((elementox)=>{
					let id = "atenddata"+elementox.id;
					let dat = new Date(elementox.value);

					// Trata possíveis datas inválidas
					if (isNaN(dat.getTime())) {
						dat = parseDataBr(elementox.value); // tenta parsear se for formato BR
					}

					let mes = (dat.getMonth()+1).toString().padStart(2, '0');
					let dia = dat.getDate().toString().padStart(2, '0');

					let fulldate = `${dia}/${mes}/${dat.getFullYear()}`;
				});
			}

			// Função para obter o início e fim da semana (domingo a sábado)
			function getInicioFimSemana(data) {
				const dataRef = new Date(data);
				const diaSemana = dataRef.getDay(); // 0 = domingo, 1 = segunda, etc.
				
				// Calcular início da semana (domingo)
				const inicio = new Date(dataRef);
				inicio.setDate(dataRef.getDate() - diaSemana); // Volta para o domingo da semana
				
				// Calcular fim da semana (sábado)
				const fim = new Date(inicio);
				fim.setDate(inicio.getDate() + 6); // Adiciona 6 dias para chegar no sábado
				
				return { inicio, fim };
			}

			// Função para formatar data para dd/mm/yyyy
			function formatDateToBR(date) {
				return `${String(date.getDate()).padStart(2, '0')}/${String(date.getMonth() + 1).padStart(2, '0')}/${date.getFullYear()}`;
			}

			function formataData(){
				// Como não temos tipoData no HTML, vamos direto atualizar a data final e o período
				let dataInput = document.getElementById('dataFil').value;
				
				if (!dataInput) return;
				
				let dat = new Date(dataInput);
				let mes = String(dat.getUTCMonth() + 1).padStart(2, '0'); // UTC
				let dia = String(dat.getUTCDate()).padStart(2, '0');
				let fulldate = `${dat.getFullYear()}-${mes}-${dia} 00:00:00.000Z`;
				document.getElementById('dataFinal').value = fulldate;
				
				// Sempre atualiza o período da semana quando a data muda
				atualizaPeriodoSemana();
			}

			function trocaFilpessoa() {
				var tipo = document.getElementById("atendTipoPessoa").value;
				var tdBene = document.getElementById("tdBeneDivFil");
				var tdTera = document.getElementById("tdTeraFil");

				// Oculta todos inicialmente
				tdBene.style.display = "none";
				tdTera.style.display = "none";

				if (tipo === "Beneficiario") {
					tdBene.style.display = "table-cell";
				} else if (tipo === "Terapeuta") {
					tdTera.style.display = "table-cell";
				}
				// Se for "Geral", mantém tudo oculto
			}

			// Função para atualizar o período da semana quando a data mudar
			function atualizaPeriodoSemana() {
				let dataInput = document.getElementById('dataFil').value;
				
				if (dataInput) {
					let dat = new Date(dataInput);
					const { inicio, fim } = getInicioFimSemana(dat);
					const datainiSemana = formatDateToBR(inicio);
					const datafimSemana = formatDateToBR(fim);
					document.getElementById('periodoSemana').value = `${datainiSemana} até ${datafimSemana}`;
				}
			}

			function trocaFiltroData(){
				// Função vazia ou remova se não estiver usando
			}

			// Função carregaBody para chamar a atualização inicial
			function carregaBody(){
				// Preenche o campo #dataFil com a data atual no formato dd/mm/yyyy
				const dataAtual = getDataAtualFormatada();
				document.getElementById("dataFil").value = dataAtual.split('/').reverse().join('-'); // formato yyyy-mm-dd para input date
				document.getElementById("dataFinal").value = dataAtual; // ou qualquer outro uso que você precise
				
				// Atualiza o período da semana inicial
				atualizaPeriodoSemana();
				
				if (document.getElementById("carregaFiltro") && document.getElementById("carregaFiltro").value == "true"){
					document.getElementById("tipoData").value = document.getElementById("tipoDataFil").value;
					if(document.getElementById("tipoData").value == "Ano/Mes"){
						document.getElementById("anoAtend").value = document.getElementById("anoAtendFil").value;
						document.getElementById("mesAtend").value = document.getElementById("mesAtendFil").value;
					} else if (document.getElementById("tipoData").value == "Semana" || document.getElementById("tipoData").value == "Dia"){
						document.getElementById("dataFil").value = document.getElementById("dataFinalFil").value;
					}

					document.getElementById("atendTipoPessoa").value = document.getElementById("tipoPessoaFil").value;
					if (document.getElementById("atendTipoPessoa").value == "Geral"){
						// nada por enquanto
					} else if (document.getElementById("atendTipoPessoa").value == "Beneficiario"){
						document.getElementById("atendBeneficiario").value = document.getElementById("atendBeneficiarioFil").value;
					} else if (document.getElementById("atendTipoPessoa").value == "Terapeuta"){
						document.getElementById("atendTerapeuta").value = document.getElementById("atendTerapeutaFil").value;
					}
				}
				
				// Adicione esta linha no final para atualizar a exibição dos campos
				trocaFilpessoa();
			}
		</script>
	</head>

	<body onload="javascript:controlaNave(); carregaBody();" class="no-skin">
<form class="form-horizontal" role="form" action="/menu/beneficiario/plansubsfixoFill" method="POST">
    <div class="breadcrumbs" id="pesquisaAge">
        <div class="col-xs-12">
            <div class="row">
                <table style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <!-- Espaçador -->
                        <td>&nbsp;</td>

                        <!-- Campo Data -->
                        <td style="width: 80px;">
                            <label for="dataFil">Data:</label>
                        </td>
                        <td style="width: 100px;">
                            <!-- Este campo envia 'dataFil' (formato yyyy-mm-dd) -->
                            <input style="height: 30px;" id="dataFil" name="dataFil" type="date" onchange="formataData(); atualizaPeriodoSemana();">
                            <!-- Este campo envia 'dataFinal' (formato yyyy-mm-ddThh:mm:ss.SSSZ) -->
                            <input class="hidden" id="dataFinal" name="dataFinal">
                        </td>

                        <!-- Espaçador -->
                        <td>&nbsp;</td>

                        <!-- Campo Semana -->
                        <td style="width: 150px;">
                            <label for="periodoSemana">Semana selecionada:</label>
                        </td>
                        <td style="width: 220px;">
                            <!-- Este campo NÃO é enviado no formulário, é apenas para exibição -->
                            <input class="form-control form-control-sm" id="periodoSemana" readonly value="--/-- até --/--">
                        </td>

                        <!-- Espaçador -->
                        <td>&nbsp;</td>

                        <!-- Campo Tipo Filtro -->
                        <td style="width: 80px;">
                            <label for="atendTipoPessoa">Tipo Filtro:&nbsp;</label>
                        </td>
                        <td style="width: 10px;">
                            <!-- Este campo envia 'atendTipoPessoa' (Geral, Beneficiario, Terapeuta) -->
                            <select name="atendTipoPessoa" id="atendTipoPessoa" class="select2" data-placeholder="Escolha..." onchange="trocaFilpessoa()">
                                <option value="Geral">Geral</option>
                                <option value="Beneficiario">Beneficiário</option>
                                <option value="Terapeuta">Terapeuta</option>
                            </select>
                        </td>

                        <!-- Espaçador -->
                        <td>&nbsp;</td>

                        <!-- Campo Beneficiário (condicional) -->
                        <td id="tdBeneDivFil" style="display: none;">
                            <label for="agendaBeneid" id="beneFilDiv">Beneficiário:&nbsp;</label>
                            <!-- Este campo envia 'agendaBeneid' (ObjectId do beneficiário) -->
                            <select id="agendaBeneid" name="agendaBeneid" class="select2" data-placeholder="Escolha..." onchange="formataData();">
                                {{#each benes}}
                                <option value="{{_id}}">{{bene_apelido}}</option>
                                {{/each}}
                            </select>
                        </td>

                        <!-- Espaçador -->
                        <td>&nbsp;</td>

                        <!-- Campo Terapeuta (condicional) -->
                        <td id="tdTeraFil" style="display: none;">
                            <label for="agendaUsuid" id="teraFilDiv">Terapeuta:&nbsp;</label>
                            <!-- Este campo envia 'agendaUsuid' (ObjectId do terapeuta) -->
                            <select id="agendaUsuid" name="agendaUsuid" class="select2" data-placeholder="Escolha..." onchange="formataData();">
                                {{#each terapeutas}}
                                <option value="{{_id}}">{{usuario_nome}}</option>
                                {{/each}}
                            </select>
                        </td>

                        <!-- Espaçador -->
                        <td>&nbsp;</td>

                        <!-- Botão de Envio -->
                        <td>
                            <button name="acaoPesquisar" id="acaoPesquisar" type="submit" class="btn btn-xs btn-info">
                                <i class="ace-icon fa fa-search-plus"></i>
                            </button>
                        </td>

                         <!-- Espaçador -->
                         <td>&nbsp;</td>
                    </tr>
                </table>

                <!-- Campo Hidden Fixo -->
                <!-- Este campo sempre envia 'soFixo=true' -->
                <input type="hidden" id="soFixo" name="soFixo" value="true">

            </div>
        </div>
    </div><!-- /.breadcrumb -->
</form>
