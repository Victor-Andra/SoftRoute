			function selectConv(){
			let	v1 = document.getElementById(document.getElementById("sessaoBeneid").value).value.toString();
				console.log(v1)
				document.getElementById("sessaoConvid").value = v1;
			}

			function atualizaConvId(){
			let	convId = document.getElementById("sessaoConvid").value;
				console.log(convId)
			}

			function carregaBody() {
				const fields = [
					"sessaoBeneid",
					"sessaoConvid"
				];

				// Preenche campos principais como sessaoBeneid, sessaoConvid
				fields.forEach(field => {
					const input = document.getElementById(field);
					const inputEdi = document.getElementById(`${field}Edi`);
					if (input && inputEdi) input.value = inputEdi.value;
				});

				// Loop para carregar os 25 campos dinamicamente
				for (let i = 1; i <= 25; i++) {
					let index = i.toString().padStart(2, '0'); // 01, 02, ..., 25

					// Campos que devem ser copiados
					const fieldGroups = [
						{ prefix: "sessaoTerapiaid", suffix: "" },
						{ prefix: "sessaoQtterapiaprev", suffix: "" },
						{ prefix: "sessaoObssessao", suffix: "" }
					];

					fieldGroups.forEach(group => {
						const idView = `${group.prefix}${index}`;
						const idHidden = `${group.prefix}${index}Edi`;

						const elementView = document.getElementById(idView);
						const elementHidden = document.getElementById(idHidden);

						if (!elementView || !elementHidden) return;

						const value = elementHidden.value;

						if (group.prefix === "sessaoTerapiaid" && value === "766f69643132333435366964") {
							elementView.value = ""; // ou mantenha o placeholder "-"
						} else {
							elementView.value = value;
						}
					});
				}

				// Atualiza o convênio caso tenha select específico
				selectConv();
			}

			function selectConv(){
				const beneId = document.getElementById("sessaoBeneid").value;
				const beneInput = document.getElementById(beneId);

				if (beneInput) {
					const convId = beneInput.value;
					const convSelect = document.getElementById("sessaoConvid");
					if (convSelect) convSelect.value = convId;
				}
			}
		</script>
		
