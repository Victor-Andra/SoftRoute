<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista de Sessões por Beneficiários</title>
		<style>
			@media print and (orientation: landscape) {
				.noprint {
					display: none;
				}
			}
			@media print {
               .noprint {
                  display: none;
               }
            }
			@media print {
				.print-hide-link::after {
					content: none !important;
				}
			}
			/*Tooltip personalizado */
			.custom-tooltip {
				position: relative;
				display: inline-block;
				cursor: pointer;
			}

			.tooltip-text {
				visibility: hidden;
				width: max-content;
				background-color: #f3dfdf;
				color: red;
				font-size: 8px;
				text-align: left;
				border-radius: 4px;
				padding: 8px 12px;
				position: absolute;
				z-index: 9999;
				bottom: 125%; /* Acima do ícone */
				left: 50%;
				transform: translateX(-50%);
				opacity: 0.9;
				white-space: normal;
				min-width: 150px;
				max-width: 300px;
				box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
				transition: opacity 0.3s;
			}

			.tooltip-text::after {
				content: "";
				position: absolute;
				top: 100%;
				left: 50%;
				margin-left: -5px;
				border-width: 5px;
				border-style: solid;
				border-color: #f3dfdf transparent transparent transparent;
			}

			/* Mostra o tooltip quando o mouse passa sobre o link */
			.custom-tooltip:hover .tooltip-text {
				visibility: visible;
			}
		</style>
		
	</head>
	<body onload="javascript:controlaNave();carregaBody();" class="no-skin">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Lista de Quadro de Sessões por Beneficiários</li>
						</ul><!-- /.breadcrumb -->
					</div>
					
					{{#each error}}
					<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<form id="divFormPesquisa" class="form-horizontal" role="form" action="/menu/beneficiario/sessao/lisindfil" method="POST">
							<div class="row mb-3">
								<!-- Tipo Filtro -->
								<div class="col-12 col-sm-6 col-md-3 col-lg-2">
									<label for="tipoData">Tipo Filtro:</label>
									<select name="tipoData" id="tipoData" class="chosen-select form-control form-control-sm" data-placeholder="Escolha..." onchange="trocaFiltroData()">
										<option value="Semana" selected>Semana</option>
									</select>
								</div>

								<!-- Campo Data -->
								<div class="col-12 col-sm-6 col-md-3 col-lg-2">
									<label for="dataFil">Data:</label>
									<input id="dataFil" name="data_inicio" type="date" class="form-control form-control-sm" onchange="atualizaDatas()" />
									<input type="hidden" id="dataFinal" name="data_fim">
								</div>

								<!-- Período da Semana -->
								<div class="col-12 col-md-6 col-lg-4">
									<label>Período da semana selecionada:</label><br>
									<input class="form-control form-control-sm" id="periodoSemana" readonly value="--/-- até --/--">
								</div>

								<!-- Beneficiário -->
								<div class="col-12 col-md-6 col-lg-3">
									<label for="atendBeneficiario">Beneficiário:</label>
									<select name="bene_id" id="atendBeneficiario" class="chosen-select form-control form-control-sm" data-placeholder="Escolha...">
										<option value="-">-</option>
										{{#each benes}}
											<option value="{{_id}}">{{bene_nome}}</option>
										{{/each}}
									</select>
								</div>

								<!-- Botão Pesquisar -->
								<div class="col-12 col-lg-1 d-flex align-items-end">
									<button name="acaoPesquisar" id="acaoPesquisar" type="submit" class="btn btn-sm btn-info w-100">
										<i class="ace-icon fa fa-search-plus"></i>
										<span class="d-none d-md-inline"> Pesquisar</span>
									</button>
								</div>
							</div>
						</form>
						<hr>
						<div class="row"><!--.row -->
							<div class="col-xs-12 col-sm-12">
								<!-- PAGE CONTENT BEGINS -->
								{{#if sessoesNaoEncontradas}}
