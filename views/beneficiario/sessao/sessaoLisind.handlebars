			/*Tooltip personalizado */
			.custom-tooltip {
				position: relative;
				display: inline-block;
				cursor: pointer;
			}

			.tooltip-text {
				visibility: hidden;
				width: max-content;
				background-color: #f3dfdf;
				color: red;
				font-size: 8px;
				text-align: left;
				border-radius: 4px;
				padding: 8px 12px;
				position: absolute;
				z-index: 9999;
				bottom: 125%; /* Acima do ícone */
				left: 50%;
				transform: translateX(-50%);
				opacity: 0.9;
				white-space: normal;
				min-width: 150px;
				max-width: 300px;
				box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
				transition: opacity 0.3s;
			}

			.tooltip-text::after {
				content: "";
				position: absolute;
				top: 100%;
				left: 50%;
				margin-left: -5px;
				border-width: 5px;
				border-style: solid;
				border-color: #f3dfdf transparent transparent transparent;
			}

			/* Mostra o tooltip quando o mouse passa sobre o link */
			.custom-tooltip:hover .tooltip-text {
				visibility: visible;
			}
		</style>
		<script type="text/javascript">
			// Função para formatar data como DD/MM/YYYY
			function formatDateToBR(date) {
				return `${String(date.getDate()).padStart(2, '0')}/${String(date.getMonth() + 1).padStart(2, '0')}/${date.getFullYear()}`;
			}
			// Função para calcular início e fim da semana (domingo a sábado)
			function getInicioFimSemana(data) {
				const dia = data.getDay(); // 0 = domingo
				const inicioSemana = new Date(data);
				inicioSemana.setDate(data.getDate() - dia); // volta ao domingo
				inicioSemana.setHours(0, 0, 0, 0);

				const fimSemana = new Date(inicioSemana);
				fimSemana.setDate(inicioSemana.getDate() + 6);
				fimSemana.setHours(23, 59, 59, 999);

				return {
					inicio: inicioSemana,
					fim: fimSemana
				};
			}
			// Atualiza campo hidden com data_fim e mostra período na tela
			function atualizaDatas() {
				const dataInput = document.getElementById("dataFil").value;
				if (!dataInput) return;

				const dataSelecionada = new Date(dataInput);
				const { inicio, fim } = getInicioFimSemana(dataSelecionada);

				// Atualiza o campo hidden "dataFinal"
				document.getElementById("dataFinal").value = fim.toISOString();

				// Atualiza o campo "periodoSemana" (agora é um input)
				const periodoInput = document.getElementById("periodoSemana");
				periodoInput.value = `${formatDateToBR(inicio)} até ${formatDateToBR(fim)}`;
			}
			// Nova função para pegar a data atual no formato dd/mm/yyyy
			function getDataAtualFormatada() {
				let data = new Date();
				let dia = String(data.getDate()).padStart(2, '0');
				let mes = String(data.getMonth() + 1).padStart(2, '0'); // Janeiro é 0!
				let ano = data.getFullYear();
				return `${dia}/${mes}/${ano}`;
			}

			// Função para converter data brasileira para objeto Date
			function parseDataBr(dataStr) {
				let [dia, mes, ano] = dataStr.split('/');
				return new Date(ano, mes - 1, dia);
			}

			// Sua função ajustaData modificada para aceitar o valor formatado em dd/mm/yyyy
			function ajustaData(){
				let fullDatas = document.getElementsByName("fullData");
				fullDatas.forEach((elementox)=>{
					let id = "atenddata"+elementox.id;
					let dat = new Date(elementox.value);

					// Trata possíveis datas inválidas
					if (isNaN(dat.getTime())) {
						dat = parseDataBr(elementox.value); // tenta parsear se for formato BR
					}

					let mes = (dat.getMonth()+1).toString().padStart(2, '0');
					let dia = dat.getDate().toString().padStart(2, '0');

					let fulldate = `${dia}/${mes}/${dat.getFullYear()}`;
				});
			}

			function formataData(){
				let tipo = document.getElementById("tipoData").value;

				if(tipo == "Ano/Mes"){
					let dat = new Date(document.getElementById('anoAtend').value+"-"+document.getElementById('mesAtend').value+"-01 00:00:00.000Z");
					let mes = String(dat.getUTCMonth()+1).padStart(2, '0');
					let dia = String(dat.getUTCDate()).padStart(2, '0');
					let fulldate = `${dat.getFullYear()}-${mes}-${dia} 00:00:00.000Z`;
					document.getElementById('dataFinal').value = fulldate;
				} else if (tipo == "Semana" || tipo == "Dia") {
					let dat = new Date(document.getElementById('dataFil').value);
					let mes = String(dat.getUTCMonth() + 1).padStart(2, '0'); // UTC
					let dia = String(dat.getUTCDate()).padStart(2, '0');
					let fulldate = `${dat.getFullYear()}-${mes}-${dia} 00:00:00.000Z`;
					document.getElementById('dataFinal').value = fulldate;
				}
			}

			function trocaFiltroData(){
				let fill = document.getElementById("tipoData").value;
				if(fill == "Ano/Mes"){
					document.getElementById("divAnoAtend").hidden = false;
					document.getElementById("divMesAtend").hidden = false;
					document.getElementById("divDataFil").hidden = true;
				} else {
					document.getElementById("divAnoAtend").hidden = true;
					document.getElementById("divMesAtend").hidden = true;
					document.getElementById("divDataFil").hidden = false;
				}
			}

			function formatDateToBR(date) {
					return `${String(date.getDate()).padStart(2, '0')}/${String(date.getMonth() + 1).padStart(2, '0')}/${date.getFullYear()}`;
				}

				const { inicio, fim } = getInicioFimSemana(hoje);
				const datainiSemana = formatDateToBR(inicio);
				const datafimSemana = formatDateToBR(fim);

				// Adicionando às sessões para uso no front
				for (const sessao of sessaoList) {
					sessao.datainiSemana = datainiSemana;
					sessao.datafimSemana = datafimSemana;
				}
			
			function carregaBody(){
				trocaFiltroData();
				formataData();

				// Preenche o campo #dataFil com a data atual no formato dd/mm/yyyy
				const hoje = new Date();
				document.getElementById("dataFil").value = hoje.toISOString().split('T')[0]; // yyyy-mm-dd
				atualizaDatas(); // calcula início e fim da semana

				const dataAtual = getDataAtualFormatada();
				document.getElementById("dataFil").value = dataAtual.split('/').reverse().join('-'); // formato yyyy-mm-dd para input date
				document.getElementById("dataFinal").value = dataAtual; // ou qualquer outro uso que você precise

				if (document.getElementById("carregaFiltro").value == "true"){
					document.getElementById("tipoData").value = document.getElementById("tipoDataFil").value;
					if(document.getElementById("tipoData").value == "Ano/Mes"){
						document.getElementById("anoAtend").value = document.getElementById("anoAtendFil").value;
						document.getElementById("mesAtend").value = document.getElementById("mesAtendFil").value;
					} else if (document.getElementById("tipoData").value == "Semana" || document.getElementById("tipoData").value == "Dia"){
						document.getElementById("dataFil").value = document.getElementById("dataFinalFil").value;
					}

					document.getElementById("atendTipoPessoa").value = document.getElementById("tipoPessoaFil").value;
					if (document.getElementById("atendTipoPessoa").value == "Geral"){
						// nada por enquanto
					} else if (document.getElementById("atendTipoPessoa").value == "Beneficiario"){
						document.getElementById("atendBeneficiario").value = document.getElementById("atendBeneficiarioFil").value;
					} else if (document.getElementById("atendTipoPessoa").value == "Terapeuta"){
						document.getElementById("atendTerapeuta").value = document.getElementById("atendTerapeutaFil").value;
					}
				}
			}

		</script>
	</head>
