	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container" id="main-container">


			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs " id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>

							<li class="active">Tabela de Sessões</li>
						</ul><!-- /.breadcrumb -->

					</div>

					<div class="row">
						<div class="col-xs-12">
							<!-- PAGE CONTENT BEGINS -->
							<form class="form-horizontal" role="form" action="/menu/beneficiario/sessao/add" method="POST">
								<div class="form-horizontal" role="form">
									<div class="col-sm-4" style="padding-top: 50px;"><!-- Widget Dados Básicos -->
										<div class="widget-box">
											<div class="widget-header">
												<h4 class="widget-title">Cadastro do índice do beneficiário e convênio</h4>

												<span class="widget-toolbar">

													<a href="#" data-action="reload">
														<i class="ace-icon fa fa-refresh"></i>
													</a>

													<a href="#" data-action="collapse">
														<i class="ace-icon fa fa-chevron-up"></i>
													</a>

												</span>
											</div>
											<div class="widget-body">
												<div class="widget-main">

													<label>Beneficiário</label>
													<div class="hidden">
														{{#each benes}}
															{{#each ../convs}}
																{{#ifEqual ../bene_convid _id}}
																	<input value="{{../bene_convid}}" id="{{../_id}}" name="refBeneConv" />
																{{/ifEqual}}
															{{/each}}
														{{/each}}
														<input value="X" id="X" name="refBeneConv" />
													</div>
													<div class="form-group">
														<div class="col-sm-4">
															<select id="sessaoBeneid" name="sessaoBeneid" class="select2" data-placeholder="Escolha..." onchange="javascript:selectConv()">
																	<option value="766f69643132333435366964"></option>
																	{{#each benes}}
																	<option value="{{_id}}">{{bene_nome}}</option>
																	{{/each}}
															</select>
														</div>
													</div>
													<label>Convênio</label>		
													<div class="form-group">
															<div class="col-sm-4">
																<select style="pointer-events: none;touch-action: none;" tabindex="-1" aria-disabled="true" id="sessaoConvid" name="sessaoConvid" class="select2" data-placeholder="Escolha...">
																		<option value="766f69643132333435366964"></option>
																		{{#each benes}}
																			{{#each ../convs}}
																				{{#ifEqual ../bene_convid _id}}
																					<option value="{{../bene_convid}}">{{conv_nome}}</option>
																				{{/ifEqual}}
																			{{/each}}
																		{{/each}}
																</select>
															</div>
													</div>

													
															<div class="alert alert-danger">
																<button type="button" class="close" data-dismiss="alert">
																	<i class="ace-icon fa fa-times"></i>
																</button>
																	<span><b>Ao selecionar a Terapia tenha em mente que:</b></span>
																	<hr>
																	<span>- Existem terapias remuneradas e não remuneradas pelos convênios.</span>
																	<br>
																	<span>- Terapias remuneradas devem ser cadastradas primeiro.</span>
																	<br>
																	<span>- Terapias não remuneradas e as quantidades deve haver substitutas com respectivas quantidades reservadas.</span>
																	<br>
																	<span>- Terapias não remuneradas e as quantidades deve haver substitutas com respectivas quantidades reservadas.</span>
																	<br>	
																	
																	<span>- Em caso de terapias substitutas, a quantidade de sessões pode variar em relação a quantidade substituída.</span>
																	<br>
																	
																	<span>- Existem terapias específicas para alguns beneficiários, pois os valores a ele referenciado tanto para receita como para pagamento aos terapeutas são diferentes.</span>
																	<br>
																	<span>- O quantitativo de sessões é semanal.</span>
																	<br>
																	<span><span>- O quantitativo de sessões é semanal.</span>
																	<br>
																	
																	
															</div>
														
												</div>
											</div>
										</div>
									</div>
									
