<!DOCTYPE html>
<html lang="pt-br"><head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
		<meta charset="utf-8">
		<title>Lista de Reponsáveis pelos beneficiários</title>
		 <style>
        /*Tooltip personalizado */
            .custom-tooltip {
                position: relative;
                display: inline-block;
                cursor: pointer;
            }

            .tooltip-text {
                visibility: hidden;
                width: max-content;
                background-color: #f3dfdf;
                color: red;
                font-size: 8px;
                text-align: left;
                border-radius: 4px;
                padding: 8px 12px;
                position: absolute;
                z-index: 9999;
                bottom: 125%; /* Acima do ícone */
                left: 50%;
                transform: translateX(-50%);
                opacity: 0.9;
                white-space: normal;
                min-width: 150px;
                max-width: 300px;
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
                transition: opacity 0.3s;
            }

            .tooltip-text::after {
                content: "";
                position: absolute;
                top: 100%;
                left: 50%;
                margin-left: -5px;
                border-width: 5px;
                border-style: solid;
                border-color: #f3dfdf transparent transparent transparent;
            }

            /* Mostra o tooltip quando o mouse passa sobre o link */
            .custom-tooltip:hover .tooltip-text {
                visibility: visible;
            }
    </style>
		
	</head>

	<body onload="javascript:controlaNave();" class="no-skin">


		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Lista de Reponsáveis pelos beneficiários</li>
						</ul><!-- /.breadcrumb -->
					</div>
					{{#each error}}
						<div class="alert alert-danger">{{texto}}{{error}}</div>
					{{else}}
					{{/each}}
					<div class="page-content"><!-- .page-content -->
						<div class="row"><!--.row -->
							<div class="col-xs-12">
								<!-- PAGE CONTENT BEGINS -->
								<div class="row">
									<div class="col-xs-12">
										<div class="clearfix">
											<div class="pull-right tableTools-container">
												<div class="dt-buttons btn-overlap btn-group">
													
													<a class="dt-button buttons-copy buttons-html5 btn btn-white btn-primary btn-bold" tabindex="0" aria-controls="dynamic-table" data-original-title="" title="Copiar para área de transferência">
														<span>
															<i class="fa fa-copy bigger-110 pink"></i>
															<span class="hidden">Copy to clipboard</span>
														</span>
													</a>
													<a class="dt-button buttons-csv buttons-html5 btn btn-white btn-primary btn-bold" tabindex="0" aria-controls="dynamic-table" data-original-title="" title="Expotar como CSV">
														<span>
															<i class="fa fa-database bigger-110 orange"></i>
															<span class="hidden">Export to CSV</span>
														</span>
													</a>
													<a class="dt-button buttons-print btn btn-white btn-primary btn-bold" tabindex="0" aria-controls="dynamic-table" data-original-title="" title="Imprimir Lista">
														<span>
															<i class="fa fa-print bigger-110 grey"></i>
															<span class="hidden">Print</span>
														</span>
													</a>
												</div>
											</div>
										</div>
										<div id="dynamic-table_wrapper" class="dataTables_wrapper form-inline no-footer">
										</div>
										<table id="dynamic-table" class="table table-striped table-bordered table-hover dataTable " role="grid" aria-describedby="dynamic-table_info">
											<thead>
												<tr role="row">
													<th class="center">
														<label class="pos-rel">
															<input type="checkbox" class="ace" />
															<span class="lbl"></span>
														</label>
													</th>
													<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1">Nome</th>
													<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1">Convênio</th>
													<th class="sorting" tabindex="0" aria-controls="dynamic-table" rowspan="1" colspan="1">Apelido</th>
													<th class="sorting" tabindex="1" aria-controls="dynamic-table" rowspan="1" colspan="1"><span class="badge badge-success">Responsável</span></th>
													<th class="sorting" tabindex="2" aria-controls="dynamic-table" rowspan="1" colspan="1"><span class="badge badge-info">Pai</span></th>
													<th class="sorting" tabindex="3" aria-controls="dynamic-table" rowspan="1" colspan="1"><span class="badge badge-pink">Mãe</span></th>
													<th class="sorting" tabindex="4" aria-controls="dynamic-table" rowspan="1" colspan="1">Status</th>
													<th>Ação</th>
												</tr>
											</thead>
											<tbody>
												{{#each benes}}

													<tr role="row" class="odd">
														<td class="center">
															<label class="pos-rel">
																<input type="checkbox" class="ace" />
																<span class="lbl"></span>
															</label>
														</td>
														
														<td>{{bene_nome}}</td>
														{{#each ../convs}}
															{{#ifEqual this._id ../bene_convid}}
																<td>{{conv_nome}}</td>
															{{/ifEqual}}
														{{/each}}
														<td>{{bene_apelido}}</td>
														<td>
															<span class="badge badge-success">{{bene_out}}</span><br>
															CPF:&nbsp;{{bene_outcpf}}<br>
															Parentesco:&nbsp;{{bene_graupar}}<br>
															Cel:&nbsp;{{bene_outcel}}&nbsp;&nbsp;Cel:&nbsp;{{bene_outcel2}}<br>
															E-mail:&nbsp;{{bene_outemail}}
														</td>
														<td>
															<span class="badge badge-info">{{bene_pai}}</span><br>
															CPF:&nbsp;{{bene_paicpf}}<br>
															Cel:&nbsp;{{bene_paicel}}&nbsp;&nbsp;Cel:&nbsp;{{bene_paicel2}}<br>
															E-mail:&nbsp;{{bene_paiemail}}
														</td>					
														<td>
															<span class="badge badge-pink">{{bene_mae}}</span><br>
															CPF:&nbsp;{{bene_maecpf}}<br>
															Cel:&nbsp;{{bene_maecel}}&nbsp;&nbsp;Cel:&nbsp;{{bene_maecel2}}<br>
															E-mail:&nbsp;{{bene_maeemail}}
														</td>
														{{#ifEqual this.bene_status "Inativo"}}
															<td><span class="label label-sm label-danger">{{bene_status}}</span></td>
															{{else}}
															<td><span class="label label-sm label-success">{{bene_status}}</span></td>
														{{/ifEqual}}
														
														<td>
															<div class="action-buttons">
																<a class="green" href="/menu/beneficiario/edi/{{_id}}">
																	<i class="ace-icon fa fa-pencil bigger-130"></i>
																</a>
																<a class="purple custom-tooltip" name="acaoCrud" id="acaoCrud-{{_id}}">
																			<i class="ace-icon fa fa-eye bigger-130"></i>
																			<span class="tooltip-text">
																				<!-- Bloco Última Edição -->
																				<strong>Última Edição:</strong>
																				{{#if dataedi}}
																					<p><b>{{dataedi}}</b></p>
																				{{else}}
																					<p>--/--/----</p>
																				{{/if}}
																				{{#if usuarioEdiNome}}
																					<p>Por: {{usuarioEdiNome}}</p>
																				{{else}}
																					<p>Por: Não informado</p>
																				{{/if}}

																				<!-- Bloco Cadastrado em -->
																				<strong>Cadastrado em:</strong>
																				{{#if datacad}}
																					<p><b>{{datacad}}</b></p>
																				{{else}}
																					<p>--/--/----</p>
																				{{/if}}
																				{{#if usuarioCadNome}}
																					<p>Por: {{usuarioCadNome}}</p>
																				{{else}}
																					<p>Por: Não informado</p>
																				{{/if}}
																			</span>
																		</a>
															</div>
														</td>
													</tr>
												{{/each}}
											</tbody>
										</table>
									</div>
								</div>				
							</div>
						</div><!-- /.row -->
					</div><!-- /.page-content -->
				</div><!-- /.main-content-inner -->
			</div><!-- /.main-content -->

		
			<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse display">
				<i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
			</a>
		</div><!-- /.main-container ace-save-state -->

	<!-- page specific plugin scripts -->
		<script type="text/javascript" charset="utf8" src="/js/jquery.dataTables.js"></script>
		

		<!-- inline scripts related to this page -->
		<script type="text/javascript">
		$(document).ready(function() {
			$("#dynamic-table").DataTable({
			"language": {
            "url": "/js/lang/datatable-pt-br.json" // Substitua pelo caminho correto
        },
			"aaSorting": [],
			"aoColumns": [{ "bSortable": false }, null, null, null, null, null, null, null, { "bSortable": false }],
			"responsive": true,
			"lengthMenu": [ 100, 200, 300],
			"lengthChange": true,
			"autoWidth": true,
			"paging": true,
			"lengthChange": true,
			"searching": true,
			"ordering": true,
			"info": true,
			
			select: {
						style: 'multi'
					}
			});
		});
		$.fn.dataTable.Buttons.defaults.dom.container.className = 'dt-buttons btn-overlap btn-group btn-overlap';
		</script>

	</body>

</html>