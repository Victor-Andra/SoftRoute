		<script type="text/javascript">
(function(){
  function log(...args){ if(window.console) console.log("[Evolucao]", ...args); }

  // lê o valor de um elemento por id/name, tenta interpretar booleano
  function readFlag(id){
    var el = document.getElementById(id);
    if(el){
      var v = el.value;
      log("readFlag id:", id, "raw:", v);
      if(typeof v === "string") v = v.trim();
      if(v === "true" || v === true) return true;
      if(v === "false" || v === false) return false;
      // se for checkbox
      if(el.type === "checkbox") return !!el.checked;
      return null;
    }
    var byName = document.getElementsByName(id);
    if(byName && byName.length){
      var v2 = byName[0].value;
      log("readFlag name:", id, "raw:", v2);
      if(typeof v2 === "string") v2 = v2.trim();
      if(v2 === "true" || v2 === true) return true;
      if(v2 === "false" || v2 === false) return false;
      return null;
    }
    return null;
  }

  // tenta múltiplos lugares comuns onde a flag pode estar
  function detectSupervisorFlag(){
    var candidates = ["isAgendaSuperCoo","isAgendaTerapeuta","isAgendaSuperCooInput","isAgendaTerapeutaInput"];
    for(var i=0;i<candidates.length;i++){
      var val = readFlag(candidates[i]);
      if(val === true || val === false){
        log("Flag detectada em:", candidates[i], "=", val);
        return {found:true, id:candidates[i], value:val};
      }
    }
    // também procura por inputs hidden com substring no name/id
    var inputs = document.querySelectorAll('input[type="hidden"], input');
    for(var j=0;j<inputs.length;j++){
      var inp = inputs[j];
      var nid = (inp.id||"") + "|" + (inp.name||"");
      if(nid.indexOf("isAgendaSuper") !== -1 || nid.indexOf("AgendaSuper") !== -1){
        var vv = inp.value;
        log("Possível flag encontrada em (fallback):", inp.id||inp.name, "=", vv);
        if(vv === "true") return {found:true, id: inp.id||inp.name, value:true};
        if(vv === "false") return {found:true, id: inp.id||inp.name, value:false};
      }
    }
    log("Flag não encontrada por heurística.");
    return {found:false, id:null, value:false};
  }

  document.addEventListener("DOMContentLoaded", function(){
    try {
      // elementos esperados
      var catSelect = document.getElementById("evolucaoconfCategoria");
      var tituloSelect = document.getElementById("evolucaoconfTitulo");
      var evolPad = document.getElementById("evolucaoconfEvolucaopad");
      var evolucaoTxt = document.getElementById("agendaEvolucao");
      var divEvolucaoConf = document.getElementById("divEvolucaoConf");

      if(!catSelect || !tituloSelect || !evolPad || !evolucaoTxt || !divEvolucaoConf){
        log("Elementos obrigatórios não encontrados:", {
          cat: !!catSelect, titulo: !!tituloSelect, pad: !!evolPad, ag: !!evolucaoTxt, div: !!divEvolucaoConf
        });
        return;
      }

      function setSelectOnlyDefault(selectEl){
        selectEl.innerHTML = "";
        var opt = document.createElement("option");
        opt.value = "-";
        opt.textContent = "-";
        selectEl.appendChild(opt);
        selectEl.value = "-";
      }

      function resetAndHide(){
        // limpa, reseta e desabilita
        try { catSelect.value = "-"; } catch(e){}
        setSelectOnlyDefault(tituloSelect);
        try { tituloSelect.value = "-"; } catch(e){}
        evolPad.value = "";
        evolucaoTxt.value = "";
        divEvolucaoConf.style.display = "none";
        catSelect.setAttribute("disabled","disabled");
        tituloSelect.setAttribute("disabled","disabled");
        log("Campos resetados, ocultos e desabilitados (isSuper = false).");
      }

      function enableAndShowAndPopulate(categorias){
        // popula categorias se receber lista; senão mantém as existentes
        if(Array.isArray(categorias)){
          catSelect.innerHTML = "";
          var optPad = document.createElement("option"); optPad.value = "-"; optPad.textContent = "-"; catSelect.appendChild(optPad);
          categorias.sort().forEach(function(cat){
            var opt = document.createElement("option");
            opt.value = cat;
            opt.textContent = cat;
            catSelect.appendChild(opt);
          });
        }
        divEvolucaoConf.style.display = "";
        catSelect.removeAttribute("disabled");
        tituloSelect.removeAttribute("disabled");
        log("Campos habilitados e visíveis (isSuper = true).");
      }

      // função que popula títulos para categoria (mantém "-" como padrão)
      function preencherTitulosPara(categoria, evolucaoconfs){
        tituloSelect.innerHTML = "";
        var optPadrao = document.createElement("option"); optPadrao.value = "-"; optPadrao.textContent = "-"; tituloSelect.appendChild(optPadrao);
        if(!categoria || categoria === "-") return;
        var filtrados = evolucaoconfs.filter(e => e.evolucaoconf_categoria === categoria);
        filtrados.sort((a,b)=> (a.evolucaoconf_titulo > b.evolucaoconf_titulo)?1:-1);
        filtrados.forEach(function(f){
          var opt = document.createElement("option");
          opt.value = f.evolucaoconf_titulo;
          opt.textContent = f.evolucaoconf_titulo;
          opt.setAttribute("data-evol", f.evolucaoconf_evolucaopad || "");
          tituloSelect.appendChild(opt);
        });
      }

      // carrega evolucaoconfs do bloco oculto (fallback)
      function loadFromSource(){
        var nodes = document.querySelectorAll("#evolucaoconfSource .evitem");
        var arr = [];
        nodes.forEach(function(span){
          arr.push({
            evolucaoconf_categoria: span.getAttribute("data-cat") || "",
            evolucaoconf_titulo: span.getAttribute("data-titulo") || "",
            evolucaoconf_evolucaopad: span.getAttribute("data-evol") || ""
          });
        });
        return arr;
      }

      var evolucaoconfs = loadFromSource();

      // listeners padrões
      catSelect.addEventListener("change", function(){
        var v = this.value;
        if(!v || v === "-"){
          setSelectOnlyDefault(tituloSelect);
          evolPad.value = "";
          evolucaoTxt.value = "";
          return;
        }
        preencherTitulosPara(v, evolucaoconfs);
        evolPad.value = "";
        evolucaoTxt.value = "";
      });

      tituloSelect.addEventListener("change", function(){
        var opt = this.options[this.selectedIndex];
        if(!opt || opt.value === "-"){
          evolPad.value = "";
          evolucaoTxt.value = "";
          return;
        }
        var pad = opt.getAttribute("data-evol") || "";
        evolPad.value = pad;
        evolucaoTxt.value = opt.value + "\n" + pad;
      });

      // função central que aplica visibilidade conforme flag
      function aplicarSegunFlagObj(flagObj){
        var isSuper = (flagObj && flagObj.value === true);
        if(isSuper){
          // popula categorias únicas a partir do source e habilita
          var cats = Array.from(new Set(evolucaoconfs.map(e=>e.evolucaoconf_categoria).filter(Boolean)));
          enableAndShowAndPopulate(cats);
        } else {
          resetAndHide();
        }
      }

      // primeira aplicação
      var flagDetected = detectSupervisorFlag();
      aplicarSegunFlagObj(flagDetected);

      // observa mudanças no elemento de flag se existir
      if(flagDetected.found && flagDetected.id){
        var flagEl = document.getElementById(flagDetected.id) || document.getElementsByName(flagDetected.id)[0];
        if(flagEl){
          flagEl.addEventListener("change", function(){
            var newVal = (String(this.value).trim() === "true");
            log("Flag mudou via evento change em", flagDetected.id, "->", newVal);
            aplicarSegunFlagObj({found:true, id: flagDetected.id, value: newVal});
          });
          flagEl.addEventListener("input", function(){
            var newVal = (String(this.value).trim() === "true");
            log("Flag mudou via evento input em", flagDetected.id, "->", newVal);
            aplicarSegunFlagObj({found:true, id: flagDetected.id, value: newVal});
          });
          // MutationObserver para mudanças no atributo value (algumas libs atualizam assim)
          try {
            var mo = new MutationObserver(function(muts){
              muts.forEach(function(mut){
                if(mut.attributeName === "value"){
                  var v = String(flagEl.value).trim() === "true";
                  log("Flag mudou via MutationObserver ->", v);
                  aplicarSegunFlagObj({found:true, id: flagDetected.id, value: v});
                }
              });
            });
            mo.observe(flagEl, {attributes:true, attributeFilter:["value"]});
            log("MutationObserver instalado na flag:", flagDetected.id);
          } catch(e){
            log("MutationObserver falhou:", e);
          }
        }
      } else {
        // Se não foi encontrada a flag, garante reset (defensivo)
        log("Flag não detectada; aplicando reset defensivo (ocultar e limpar).");
        aplicarSegunFlagObj({found:false, value:false});
      }

    } catch(err){
      console.error("[Evolucao] Erro no script:", err);
    }
  });
})();
</script>

