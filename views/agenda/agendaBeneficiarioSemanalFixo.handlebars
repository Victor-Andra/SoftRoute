                                <span class="legenda-color" style="background-color: salmon;"></span>
                                <span>Roberta Disponível</span>
                            </div>
                            <div class="legenda-item">
                                <span class="legenda-color" style="background-color: lightpink;"></span>
                                <span>Supervisor</span>
