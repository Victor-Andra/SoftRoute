    <script type="text/javascript">
        function formataData(){
            let dt = document.getElementById('dataFil').value;
            let dia = dt.substring(8,10);
            let mes = dt.substring(5,7);
            let ano = dt.substring(0,4);
            let fulldate=(ano+"-"+mes+"-"+dia+' 00:00:00.000Z').toString();
            document.getElementById('dataFinal').value = fulldate;
            console.log("dataFinal:"+document.getElementById('dataFinal').value);
        }
		function carregaBody(){
    let dias = ["seg","ter","qua","qui","sex"];
    try{
        dias.forEach((dia)=>{
            console.log("dia:"+dia)
            document.getElementsByName(dia).forEach((e)=>{
                let id = "hora"+e.id;
                let valor = e.value;
                console.log("valor")
                console.log(valor)
                if(valor != "766f69643132333435366964"){
                    if(e.id.indexOf("TerapiaId_") != -1){
                        console.log("CLONE: " +valor)
                        let val = document.getElementById(valor).cloneNode(true);
                        val.id = val.id+"x";
                        
                        // Adicionar classe de estilo ao card - Terapia
                        val.className = 'terapia-card';
                        val.innerHTML = '<span class="terapia-nome">' + val.textContent.trim() + '</span>';
                        
                        document.getElementById(id).append(val);
                        let color = e.id + "_" + e.value;
                        let hav = document.getElementById(color)
                        if (hav != null){
                            let motivo = hav.value;
                            console.log("motivo:"+motivo)
                            switch (motivo) {
                                case "Falta" :
                                    val.style.backgroundColor = "yellow";
                                    val.className += ' terapia-falta';
                                    break;
                                case "Falta Justificada":
                                    val.style.backgroundColor = "orange";
                                    val.className += ' terapia-falta-justificada';
                                    break;
                                case "Falta Absoluta":
                                    val.style.backgroundColor = "orange";
                                    val.className += ' terapia-falta-absoluta';
                                    break;
                                case "Substituição":
                                    val.style.backgroundColor = "cyan";
                                    val.className += ' terapia-substituicao';
                                    break;
                                case "Roberta Disponpivel":
                                    val.style.backgroundColor = "salmon";
                                    val.className += ' terapia-roberta-disponivel';
                                    break;
                                case "Supervisor":
                                    val.style.backgroundColor = "lightpink";
                                    val.className += ' terapia-supervisor';
                                    break;
                                case "Ordinario":
                                    val.style.backgroundColor = "aquamarine";
                                    val.className += ' terapia-ordinario';
                                    break;
                                case "Nenhuma Observação":
                                    val.style.backgroundColor = "lightgreen";
                                    val.className += ' terapia-sem-evento';
                                    break;
                                default :
                                    break;
                            }
                        }
                    } else if(e.id.indexOf("TeraId_") != -1){
                        console.log("clone: "+valor)
                        let val = document.getElementById(valor).cloneNode(true);
                        val.id = val.id+"x";
                        
                        // Adicionar classe de estilo ao card - Terapeuta
                        val.className = 'terapia-card';
                        val.innerHTML = '<span class="terapeuta-nome">' + val.textContent.trim() + '</span>';
                        
                        document.getElementById(id).append(val);
                        let color = e.id + "_" + e.value;
                        let hav = document.getElementById(color)
                        if (hav != null){
                            let motivo = hav.value;
                            console.log("motivo:"+motivo)
                            switch (motivo) {
                                case "Falta" :
                                    val.style.backgroundColor = "yellow";
                                    val.className += ' terapia-falta';
                                    break;
                                case "Falta Justificada":
                                    val.style.backgroundColor = "orange";
                                    val.className += ' terapia-falta-justificada';
                                    break;
                                case "Falta Absoluta":
                                    val.style.backgroundColor = "orange";
                                    val.className += ' terapia-falta-absoluta';
                                    break;
                                case "Substituição":
                                    val.style.backgroundColor = "cyan";
                                    val.className += ' terapia-substituicao';
                                    break;
                                case "Roberta Disponpivel":
                                    val.style.backgroundColor = "salmon";
                                    val.className += ' terapia-roberta-disponivel';
                                    break;
                                case "Supervisor":
                                    val.style.backgroundColor = "lightpink";
                                    val.className += ' terapia-supervisor';
                                    break;
                                case "Ordinario":
                                    val.style.backgroundColor = "aquamarine";
                                    val.className += ' terapia-ordinario';
                                    break;
                                case "Nenhuma Observação":
                                    val.style.backgroundColor = "lightgreen";
                                    val.className += ' terapia-sem-evento';
                                    break;
                                default :
                                    break;
                            }
                        }
                    }
                }
            })
            
            // Processar botões de ação
            document.getElementsByName(dia).forEach((e)=>{
                if(e.id.indexOf("AcaoId_") != -1){
                    let id = "hora"+e.id;
                    console.log("id:"+id)
                    let el = document.getElementById(e.id);
                    console.log("el:"+el)
                    document.getElementById(id).append(el);
                    
                    // Verificar se é SubstitutoFixo e adicionar botão
                    let hora = e.id.split('_')[1];
                    let categoriaInput = document.getElementById(dia + 'Categoria_' + hora);
                    
                    if (categoriaInput && categoriaInput.value === "SubstitutoFixo") {
                        // Obter os nomes dos campos de merge
                        let mergeTerapiaId = document.getElementById(dia + 'MergeTerapia_' + hora)?.value || '';
                        let mergeTerapeutaId = document.getElementById(dia + 'MergeTerapeuta_' + hora)?.value || '';
                        
                        let mergeTerapiaNome = mergeTerapiaId ? document.getElementById(mergeTerapiaId)?.textContent || '—' : '—';
                        let mergeTerapeutaNome = mergeTerapeutaId ? document.getElementById(mergeTerapeutaId)?.textContent || '—' : '—';
                        
                        // Criar botão Subfix com tooltip
                        let subfixBtn = document.createElement('a');
                        subfixBtn.className = 'acao-btn subfix custom-tooltip';
                        subfixBtn.href = '#';
                        subfixBtn.innerHTML = `
                            <i class="ace-icon fa fa-random"></i>
                            <span class="tooltip-text">
                                Subfix:<br>
                                Terapia: ${mergeTerapiaNome}<br>
                                Terapeuta: ${mergeTerapeutaNome}
                            </span>
                        `;
                        
                        document.getElementById(id).prepend(subfixBtn);
                    }
                    
                    // Estilizar botões existentes
                    let botoes = document.getElementById(id).getElementsByTagName('a');
                    for(let i = 0; i < botoes.length; i++) {
                        if(botoes[i].className.includes('green')) {
                            botoes[i].className = 'acao-btn add';
                            botoes[i].innerHTML = '<i class="ace-icon fa fa-plus"></i>';
                        } else if(botoes[i].className.includes('blue')) {
                            botoes[i].className = 'acao-btn edit';
                            botoes[i].innerHTML = '<i class="ace-icon fa fa-pencil"></i>';
                        } else if(botoes[i].className.includes('red')) {
                            botoes[i].className = 'acao-btn delete';
                            botoes[i].innerHTML = '<i class="ace-icon fa fa-trash"></i>';
                        }
                    }
                }
            })
        })
    } catch(err){
        console.log(err)
    }
    
    // Aplicar estilo por hora após carregar
    setTimeout(aplicarEstiloPorHora, 100);
}
		
		function aplicarEstiloPorHora() {
				$('tbody tr').each(function () {
					const $linha = $(this);
					const $horaCell = $linha.find('td:first-child');
					const horaTexto = $horaCell.text().trim().replace(/<[^>]*>/g, '').replace(/&nbsp;/g, '');

					if (!horaTexto) return;

					// Remover classes existentes
					$linha.removeClass('manha-row tarde-row divisoria-meio-dia');

					// Definir horas da manhã (até 11:20)
					const horasManha = ['08:00', '08:40', '09:20', '10:00', '10:40', '11:20'];
					const horasTarde = ['13:20', '14:00', '14:40', '15:20', '16:00', '16:40', '17:20', '18:00'];

					// Verificar se é manhã
					if (horasManha.includes(horaTexto)) {
						$linha.addClass('manha-row');
						
						// Se for exatamente 11:20, adicionar linha divisória
						if (horaTexto === '11:20') {
							$linha.addClass('divisoria-meio-dia');
						}
					} 
					// Verificar se é tarde
					else if (horasTarde.includes(horaTexto)) {
						$linha.addClass('tarde-row');
					}
				});
			}
        $(document).ready(function () {
            // Inicializa DataTable
            var table = $('#dynamic-table').DataTable({
                "language": { "url": "/js/lang/datatable-pt-br.json" },
                "aaSorting": [],
                "aoColumns": [null, null, null,null, null, null, null, null,null, null, null,null, null, null, null, null],
                "responsive": true,
                "autoWidth": false,
                "paging": false,
                "searching": false,
                "ordering": true,
                "info": false,
                "scrollX": true,
                select: {
                    style: 'multi'
                }
            });

            // Aplica estilo sempre que a tabela for redesenhada
            table.on('draw.dt', function () {
                aplicarEstiloPorHora();
            });

            // Inicializa Chosen Select
            $(".chosen-select").chosen({
                width: "100%",
                no_results_text: "Não encontrado..."
            });

            // Primeira execução após carregar a página
            aplicarEstiloPorHora();
        });
    </script>
