                                <span class="legenda-color" style="background-color: yellow;"></span>
                                <span>Falta</span>
                            </div>
                            <div class="legenda-item">
                                <span class="legenda-color" style="background-color: orange;"></span>
                                <span>Falta Justificada / Absoluta</span>
                            </div>
                            <div class="legenda-item">
                                <span class="legenda-color" style="background-color: cyan;"></span>
                                <span>Substituição</span>
                            </div>
