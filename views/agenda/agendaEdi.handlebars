		<!-- Scripts de inicialização do Chosen e correção de carregamento -->
		<script type="text/javascript">
		$(document).ready(function() {
			
			// === 1. Inicializa TODOS os chosen-select da página ===
			$('.chosen-select').chosen({
				allow_single_deselect: true,
				no_results_text: 'Nenhum resultado encontrado',
				width: '100%',
				disable_search_threshold: 10 // Esconde busca se menos de 10 opções
			});
			
			// === 2. Função auxiliar para atualizar visual do Chosen após mudar valor ===
			window.updateChosenField = function(fieldId) {
				if ($('#' + fieldId).length && typeof $.fn.chosen !== 'undefined') {
					$('#' + fieldId).trigger('chosen:updated');
				}
			};
			
			// === 3. Corrige a função carregaBody para atualizar o Chosen ===
			var originalCarregaBody = window.carregaBody;
			window.carregaBody = function() {
				// Executa a lógica original primeiro
				if (typeof originalCarregaBody === 'function') {
					originalCarregaBody();
				}
				
				// === AGORA atualiza a UI do Chosen com os valores definidos ===
				setTimeout(function() {
					[
						'agendaHora', 'agendaOrg', 'agendaCateg', 
						'agendaBeneid', 'agendaConvid', 'agendaUsuid', 
						'agendaTerapiaid', 'agendaMergeterapeutaid', 
						'agendaMergeterapiaid', 'agendaSalaid'
					].forEach(function(id) {
						window.updateChosenField(id);
					});
					
					// Força refresh do campo que tem estilo disabled via CSS
					if ($('#agendaConvid').prop('disabled')) {
						$('#agendaConvid').prop('disabled', true).trigger('chosen:updated');
					}
				}, 100); // Pequeno delay para garantir que o DOM terminou de renderizar
			};
			
			// === 4. Corrige o evento do agendaCateg (onload não funciona em select) ===
			$('#agendaCateg').off('change').on('change', function() {
				window.mudaSubis();
			});
			
			// === 5. Garante que controlaCategoria também atualize o Chosen ===
			var originalControlaCategoria = window.controlaCategoria;
			window.controlaCategoria = function() {
				if (typeof originalControlaCategoria === 'function') {
					originalControlaCategoria();
				}
				window.updateChosenField('agendaCateg');
			};
			
			// === 6. Botão Cancelar com handler seguro ===
			$('#acaoCancelar').off('click').on('click', function(e) {
				e.preventDefault();
				window.history.back();
			});
		});
		</script>
	</body>
