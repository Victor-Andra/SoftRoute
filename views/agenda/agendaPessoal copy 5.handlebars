                    {{/if}}
                {{/ifEqual}}
                
                <!-- Tooltip: IRMÃO do ícone, com pointer-events: none -->
                <span class="tooltip-text">
                    <strong style="color:#c00">{{ui.tooltipTitulo}}</strong><br>
                    {{ui.tooltipTexto}}
                </span>
            </div>
            
        {{else}}
            <!-- Inputs para pintaAgenda -->
            <input name="{{agenda_data_semana}}BeneId_{{agenda_hora}}_{{agenda_beneid}}" 
                   value="{{#if visual.temCadeia}}{{cadeia.ultimoCategoria}}{{else}}{{agenda_categoria}}{{/if}}">
            <input name="{{agenda_data_semana}}SalaId_{{agenda_hora}}_{{agenda_salaid}}" 
                   value="{{#if visual.temCadeia}}{{cadeia.ultimoCategoria}}{{else}}{{agenda_categoria}}{{/if}}">
            
            <!-- 👉 AÇÃO PARA PAI: Mesma estrutura -->
            <div id="{{agenda_data_semana}}AcaoId_{{agenda_hora}}" name="{{agenda_data_semana}}" class="custom-tooltip">
                <!-- Ícone -->
                {{#ifEqual ui.icone "ban"}}
                    <i class="red ace-icon fa fa-ban bigger-130"></i>
                {{else}}
                    {{#if ui.temLink}}
                        <a class="blue" href="/menu/agenda/evolucao/{{_id}}" style="position:relative;z-index:2;">
                            <i class="ace-icon fa fa-pencil bigger-130"></i>
                        </a>
                    {{else}}
