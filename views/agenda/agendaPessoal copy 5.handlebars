                {{/ifEqual}}
                
                <!-- Tooltip -->
                <span class="tooltip-text">
                    <strong style="color:#c00">{{ui.tooltipTitulo}}</strong><br>
                    {{ui.tooltipTexto}}
                </span>
            </div>
        {{/isTrue}}
    {{/compareThis}}
{{/each}}
						{{#each benes}}
							<label style="width:85px;border:0px;margin-bottom: 2px;font-size:10px;" id="{{_id}}">{{bene_apelido}}<br/></label>
