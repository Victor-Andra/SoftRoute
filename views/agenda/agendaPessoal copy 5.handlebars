						{{/each}}
					</div>
					<!-- Substitua o form existente por: -->
					<!-- Form de pesquisa com validação -->
					<form class="form-horizontal" role="form" action="/menu/agenda/filPessoalDia" method="POST" onsubmit="return formataData()">
