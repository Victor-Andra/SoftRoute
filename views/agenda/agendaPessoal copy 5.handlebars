					<!-- ======================================================================= -->
					<!-- 🔹 TABELA DA AGENDA - MODO DIÁRIO (4 COLUNAS) -->
					<!-- ======================================================================= -->
					<div class="tab-content">
						<div class="row">
							<div class="col-xs-12 col-sm-12">
								<div id="seg" class="tab-pane fade active in">
									<table class="table table-sm table-bordered" style="font-size: 9px;" id="dynamic-table" role="grid">
										<thead>
											<!-- 📌 ALERTA INFO: Dia Filtrado (NOVO) -->
											<tr role="row">
												<th class="center" colspan="4" style="padding: 5px;">
