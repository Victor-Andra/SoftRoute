<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Agendamentos</title>
		<style>
			/* Modal responsivo para mobile/tablet - Ace Admin */
			@media (max-width: 767px) {
				.modal-dialog { width: 95% !important; margin: 10px auto !important; }
				.modal-title { font-size: 16px !important; line-height: 1.4 !important; }
				.modal-body p { font-size: 14px !important; line-height: 1.5 !important; }
				.modal-footer { display: flex !important; flex-direction: column !important; gap: 8px !important; padding: 10px 15px !important; }
				.modal-footer .btn { width: 100% !important; min-height: 44px !important; font-size: 14px !important; text-align: left !important; padding: 10px 15px !important; }
				.modal-footer .btn i { margin-right: 8px !important; width: 20px !important; text-align: center; }
			}
			@media (min-width: 768px) and (max-width: 991px) {
				.modal-dialog { width: 90% !important; max-width: 600px !important; }
				.modal-footer .btn { min-height: 38px; padding: 6px 12px; }
			}
			.modal-content .text-left, .modal-content p, .modal-content h4 { text-align: left !important; }
			.modal-body { padding: 15px !important; }
			.modal-footer { padding: 10px 15px 15px !important; border-top: 1px solid #e5e5e5; }
		</style>
		<script type="text/javascript">
			function selectConv(){
				var v1 = document.getElementById(document.getElementById("agendaBeneid").value).value.toString();
				console.log(v1)
				document.getElementById("agendaConvid").value = v1;
			}
			function atualizaConvId(){
				let convId = document.getElementById("agendaConvid").value;
				console.log(convId)
			}
			function atualizaData(){
				var dataIso = document.getElementById("dataAg").value+"T"+document.getElementById("agendaHora").value+":00.000Z";
				var dataFmt = new Date(dataIso);
				console.log(dataIso);
				document.getElementById("agendaData").value = dataFmt;
			}
			function carregaBody(){
				document.getElementById("dataAg").value = document.getElementById("agendaDataEdi").value;
				document.getElementById("agendaHora").value = document.getElementById("agendaHoraEdi").value;
				document.getElementById("agendaBeneid").value = document.getElementById("agendaBeneidEdi").value;
				document.getElementById("agendaConvid").value = document.getElementById("agendaConvidEdi").value;
				document.getElementById("agendaTerapiaid").value = document.getElementById("agendaTerapiaidEdi").value;
				document.getElementById("agendaUsuid").value = document.getElementById("agendaUsuidEdi").value;
				document.getElementById("agendaSalaid").value = document.getElementById("agendaSalaidEdi").value;
				document.getElementById("agendaOrg").value = document.getElementById("agendaOrgEdi").value;
				document.getElementById("agendaCateg").value = document.getElementById("agendaCategEdi").value;
				document.getElementById("agendaEvolucao").value = document.getElementById("agendaEvolucaoEdi").value;
				atualizaData();
				if (document.getElementById("agendaSelamento").value == 'false'){
					document.getElementById("agendaSelo").checked = false;
					document.getElementById("agendaSelo").style = '';
				}
				if (document.getElementById("isAgendaTerapeuta").value == 'true'){
					document.getElementById("divEvolucao").style = '';
				}
			}
			function alteraMigrado(){
				let chck = document.getElementById("agendaMigrado");
				if(chck.checked){
					chck.value="true";
					console.log(chck.value);
				} else {
					chck.value="false";
					console.log(chck.value);
				}
			}
			function controlaCategoria(){
				let origem = document.getElementById("agendaOrg").value;
				if(origem == "Padrão"){
					document.getElementById("agendaCateg").value = "Padrão";
					document.getElementById("Padrão").style.display = "";
					document.getElementById("Falta").style.display = "none";
					document.getElementById("Apoio").style.display = "none";
					document.getElementById("Supervisão").style.display = "none";
					document.getElementById("Pais").style.display = "none";
					document.getElementById("Substituto").style.display = "none";
					document.getElementById("Glosa").style.display = "none";
					document.getElementById("Extra").style.display = "none";
				} else {
					document.getElementById("agendaCateg").value = "Apoio";
					document.getElementById("Padrão").style.display = "none";
					document.getElementById("Falta").style.display = "";
					document.getElementById("Apoio").style.display = "";
					document.getElementById("Supervisão").style.display = "";
					document.getElementById("Pais").style.display = "";
					document.getElementById("Substituto").style.display = "";
					document.getElementById("Glosa").style.display = "";
					document.getElementById("Extra").style.display = "";
				}
			}
			function selamento(){
				document.getElementById("agendaSelamento").value = document.getElementById("agendaSelo").checked;
			}
		</script>
	</head>
	<body class="no-skin" onload="javascript:controlaCategoria();carregaBody();controlaNave();">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					{{#compareString flash.sucesso "true"}}
						<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-block alert-success">
							<p>
								<strong><i class="ace-icon fa fa-check"></i> {{flash.texto}}</strong>
								<button type="button" class="close" onclick="javascript:OcultaMsg()"><i class="ace-icon fa fa-times"></i></button>
							</p>
						</div>
					{{else}}
						{{#compareString flash.sucesso "false"}}
							<div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">
								<p>
									<strong><i class="ace-icon fa fa-times"></i> {{flash.texto}}</strong>
									<button type="button" class="close" onclick="javascript:OcultaMsg()"><i class="ace-icon fa fa-times"></i></button>
								</p>
							</div>
						{{else}}
						{{/compareString}}
					{{/compareString}}
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li><i class="ace-icon fa fa-home home-icon"></i><a href="#">Home</a></li>
							<li class="active">Evolução do atendimento pelos supervisores.</li>
						</ul>
					</div>
					<div class="row">
						<div class="col-xs-12">
							<form class="form-horizontal" role="form" action="/menu/agenda/evolucao" method="POST">
								<div class="col-sm-12">
									<div class="widget-box">
										<div class="widget-header">
											<h4 class="widget-title">Evolução e atendimento</h4>
											<span class="widget-toolbar">
												<a href="#" data-action="reload"><i class="ace-icon fa fa-refresh"></i></a>
												<a href="#" data-action="collapse"><i class="ace-icon fa fa-chevron-up"></i></a>
											</span>
										</div>
										<div class="widget-body">
											<div class="widget-main">
												<div class="row">
													<div id="divEvolucao">
														<div class="col-sm-6">														
															<label> Evolução</label>
															<div class="form-group">
																<div class="col-sm-12">
																	<!-- ID ÚNICO E CORRETO MANTIDO AQUI -->
																	<input id="agendaEvolucaoEdi" name="agendaEvolucaoEdi" hidden value="{{agenda.agenda_evolucao}}" />
																	<textarea rows="4" id="agendaEvolucao" name="agendaEvolucao" placeholder="" class="form-control">{{agenda.agenda_evolucao}}</textarea>
																</div>
															</div>
															<label class="pos-rel">
																{{#isTrue selo}}
																<input type="checkbox" style="display: none;" name="agendaSelo" id="agendaSelo" value="{{agenda.agenda_selo}}" />
																<b>Evolução Finalizada!</b>
																{{else}}
																<input type="checkbox" name="agendaSelo" id="agendaSelo" value="{{agenda.agenda_selo}}" onchange="javascript:selamento();" />
																Evolução Finalizada? <b>Marque para concluir a evolução.</b>
																{{/isTrue}}
															</label>
														</div>
													</div>
												</div>
												<hr>
												<div class="form-actions">
													<div class="col-md-offset-3 col-md-9" style="align-items: center;">
														<button class="btn btn-info" name="acaoSalvar" id="acaoSalvar" type="submit">
															<i class="ace-icon fa fa-check bigger-110"></i> Salvar
														</button>
														&nbsp; &nbsp; &nbsp;
														<button class="btn btn-warning" name="acaoCancelar" id="acaoCancelar" type="button" onclick="verificarSaida(event)">
															<i class="ace-icon fa fa-undo bigger-110"></i> Voltar
														</button>
														&nbsp; &nbsp; &nbsp;
														<button class="btn btn-info" id="btnRecuperarRascunho" type="button" style="display: none;" onclick="recuperarRascunho()">
															<i class="ace-icon fa fa-undo bigger-110"></i> Recuperar Rascunho
														</button>
													</div>
												</div>
												<hr>
												<div class="alert alert-warning">
													<button type="button" class="close" data-dismiss="alert"><i class="ace-icon fa fa-times"></i></button>
													Informações do agendamento.<br>
												</div>
												<div class="row">
													<div class="col-xs-12 col-sm-6">
														<label for="id-date-picker-1">Data Agendamento</label>
														<div class="row">
															<div class="col-sm-2">
																<div class="input-group">
																	<input name="dataAg" id="dataAg" type="date" style="width: 200px;" onchange="javascript:atualizaData()">
																</div>
															</div>
														</div>
													</div>
													<div class="col-xs-12 col-sm-6">
														<label for="id-date-picker-1">Hora Agendamento</label>
														<div class="form-group">
															<div class="col-sm-2">
																<select style="pointer-events: none;touch-action: none;" tabindex="-1" aria-disabled="true" name="agendaHora" id="agendaHora" class="select2" data-placeholder="Escolha..." onchange="javascript:atualizaData()">
																	{{#each horaages}}
																		<option value="{{horaage_hora}}">{{horaage_hora}}</option>
																	{{/each}}
																</select>
															</div>
														</div>
													</div>
												</div>
												<div class="row">
													<div class="col-xs-12">
														<label>Beneficiário</label>
														<div class="hidden" class="col-sm-5">
															<div class="row" aria-hidden="true">
																<div class="col-xs-12 col-sm-6">
																	<label for="id-date-picker-1">Origem Agendamento</label>
																	<div class="row">
																		<div class="col-sm-4">
																			<div class="input-group">
																				<select style="pointer-events: none;touch-action: none;" tabindex="-1" aria-disabled="true" id="agendaOrg" name="agendaOrg" class="select" data-placeholder="Escolhaa a opção..." onchange="javascript:controlaCategoria()">
																					<option value="Padrão">Padrão</option>
																					<option value="Administrativo">Administrativo</option>
																				</select>
																			</div>
																		</div>
																	</div>
																</div>
																<div class="col-xs-12 col-sm-2">
																	<label for="id-date-picker-1">Categoria</label>
																	<div class="form-group">
																		<div class="col-sm-8">
																			<select style="pointer-events: none;touch-action: none;" tabindex="-1" aria-disabled="true" id="agendaCateg" name="agendaCateg" class="select2" data-placeholder="Escolha a opção..." onload="javascript:ajustaOption()">
																				<option id="Apoio" value="Apoio">Apoio</option>
																				<option id="Extra" value="Extra">Extra</option>
																				<option id="Falta" value="Falta">Falta</option>
																				<option id="Glosa" value="Glosa">Glosa</option>
																				<option id="Padrão" value="Padrão" style="display: none;">Padrão</option>
																				<option id="Pais" value="Pais">Pais</option>
																				<option id="Substituto" value="Substituto">Substituto</option>
																				<option id="Supervisão" value="Supervisão">Supervisão</option>
																			</select>
																		</div>
																	</div>
																</div>
															</div>
															{{#each benes}}
																{{#each ../convs}}
																	{{#ifEqual ../bene_convid _id}}
																		<input value="{{../bene_convid}}" id="{{../_id}}" name="refAgendaConvid" />
																	{{/ifEqual}}
																{{/each}}
															{{/each}}
															<input value="X" id="X" name="refAgendaConv" />
														</div>
														<div class="form-group">
															<div class="col-sm-5">
																<select style="pointer-events: none;touch-action: none;" tabindex="-1" aria-disabled="true" name="agendaBeneid" id="agendaBeneid" class="select" data-placeholder="Escolha..." onchange="javascript:selectConv()">
																	{{#each benes}}
																		<option value="{{_id}}">{{bene_nome}}</option>
																	{{/each}}
																</select>
															</div>
														</div>
													</div>
													<div class="col-xs-12 col-sm-2 hidden">
														<label>Convênio</label>
														<div class="form-group">
															<div class="col-sm-6" style="width: 500px;">
																<select style="pointer-events: none;touch-action: none;" tabindex="-1" aria-disabled="true" name="agendaConvid" id="agendaConvid" class="select" data-placeholder="Escolha...">
																	{{#each benes}}
																		{{#each ../convs}}
																			{{#ifEqual ../bene_convid _id}}
																				<option value="{{../bene_convid}}">{{conv_nome}}</option>
																			{{/ifEqual}}
																		{{/each}}
																	{{/each}}
																</select>
															</div>
														</div>
													</div>
												</div>
												<div class="row">
													<div class="col-xs-6">
														<label>Terapeuta</label>
														<div class="form-group">
															<div class="col-sm-4">
																<select style="pointer-events: none;touch-action: none;" tabindex="-1" aria-disabled="true" name="agendaUsuid" id="agendaUsuid" class="select" data-placeholder="Escolha...">
																	{{#each terapeutas}}
																		<option value="{{_id}}">{{usuario_nome}}</option>
																	{{/each}}
																</select>
															</div>
														</div>												
													</div>
												</div>
												<div class="row">
													<div class="col-xs-6">														
														<label>Terapia</label>
														<div class="form-group">
															<div class="col-sm-6">
																<select style="pointer-events: none;touch-action: none;" tabindex="-1" aria-disabled="true" name="agendaTerapiaid" id="agendaTerapiaid" class="select" data-placeholder="Escolha..." onchange="javascript:carregaValores()">
																	{{#each terapias}}
																		<option value="{{_id}}">{{terapia_nome}}</option>
																	{{/each}}
																</select>
															</div>
														</div>
													</div>
												</div>
												<div class="row">
													<div class="col-xs-6">														
														<label>Local</label>
														<div class="form-group">
															<div class="col-sm-4" style="width: 300px;">
																<select style="pointer-events: none;touch-action: none;" tabindex="-1" aria-disabled="true" name="agendaSalaid" id="agendaSalaid" class="select" data-placeholder="Escolha..." onchange="javascript:carregaValores()">
																	{{#each salas}}
																		<option value="{{_id}}">{{sala_nome}}</option>
																	{{/each}}
																</select>
															</div>
														</div>
													</div>
												</div>
												<div class="row">
													<div class="col-sm-12">														
														<label> Observação da agenda</label>
														<div class="form-group">
															<div class="col-sm-12">
																<input style="pointer-events: none;touch-action: none;" tabindex="-1" aria-disabled="true" type="text" id="agendaObs" name="agendaObs" placeholder="" class="form-control" />
															</div>
														</div>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
								
								<div class="hidden">
									<input id="agendaSelamento" name="agendaSelamento" value="{{selo}}" />
									<input id="isAgendaTerapeuta" name="isAgendaTerapeuta" value="{{isAgendaTerapeuta}}" />
									<input id="id" name="id" value="{{agenda._id}}" />
									<input id="agendaTemp" name="agendaTemp" value="{{agenda.agenda_temp}}" />
									<input id="agendaData" name="agendaData" />
									<input id="agendaDataEdi" name="agendaDataEdi" value="{{agenda.agenda_data_dia}}" />
									<input id="agendaHoraEdi" name="agendaHoraEdi" value="{{agenda.agenda_hora}}" />
									<input id="agendaCategEdi" name="agendaCategEdi" value="{{agenda.agenda_categoria}}" />
									<input id="agendaOrgEdi" name="agendaOrgEdi" value="{{agenda.agenda_org}}" />
									<input id="agendaBeneidEdi" name="agendaBeneidEdi" value="{{agenda.agenda_beneid}}" />
									<input id="agendaConvidEdi" name="agendaConvidEdi" value="{{agenda.agenda_convid}}" />
									<input id="agendaSalaidEdi" name="agendaSalaidEdi" value="{{agenda.agenda_salaid}}" />
									<input id="agendaTerapiaidEdi" name="agendaTerapiaidEdi" value="{{agenda.agenda_terapiaid}}" />
									<input id="agendaUsuidEdi" name="agendaUsuidEdi" value="{{agenda.agenda_usuid}}" />
									<input id="agendaAtrazo" name="agendaAtrazo" value="{{atrazo}}" />
									<input id="tipoData" name="tipoData" value="{{filtroTela.tipoData}}" />
									<input id="anoAtend" name="anoAtend" value="{{filtroTela.anoAtend}}" />
									<input id="mesAtend" name="mesAtend" value="{{filtroTela.mesAtend}}" />
									<input id="dataFinal" name="dataFinal" value="{{filtroTela.dataFinal}}" />
									<input id="atendTipoPessoa" name="atendTipoPessoa" value="{{filtroTela.tipoPessoa}}" />
									<input id="atendBeneficiario" name="atendBeneficiario" value="{{filtroTela.atendBeneficiario}}" />
									<input id="atendTerapeuta" name="atendTerapeuta" value="{{filtroTela.atendTerapeuta}}" />
									<!-- REMOVIDO: Input duplicado de agendaEvolucaoEdi que estava aqui e causava o bug -->
								</div>
								<hr>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Modal de confirmação para Evolução não finalizada -->
		<div id="modalEvolucaoNaoFinalizada" class="modal fade" tabindex="-1" role="dialog">
			<div class="modal-dialog" role="document">
				<div class="modal-content">
					<div class="modal-header">
						<button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><i class="ace-icon fa fa-times"></i></button>
						<h4 class="modal-title text-left"><i class="ace-icon fa fa-exclamation-triangle orange"></i> Atenção</h4>
					</div>
					<div class="modal-body text-left">
						<p class="blue" style="text-align: left; margin: 0; padding: 5px 0;">Você tentou salvar a evolução sem marcar a <b>Evolução como finalizada</b>. O que deseja fazer?</p>
					</div>
					<div class="modal-footer text-left" style="text-align: left;">
						<button id="btnMarcarSalvar" class="btn btn-success btn-sm" type="button"><i class="ace-icon fa fa-check"></i> Marcar e salvar</button>
						<button id="btnSalvarSemMarcar" class="btn btn-danger btn-sm" type="button"><i class="ace-icon fa fa-times"></i> Não marcar, irei editar mais tarde!</button>
						<button id="btnCancelarModal" class="btn btn-default btn-sm" type="button" data-dismiss="modal"><i class="ace-icon fa fa-ban"></i> Cancelar</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Modal de confirmação para Saída sem Salvar -->
		<div id="modalConfirmarSaida" class="modal fade" tabindex="-1" role="dialog">
			<div class="modal-dialog" role="document">
				<div class="modal-content">
					<div class="modal-header">
						<button type="button" class="close" data-dismiss="modal" aria-label="Fechar"><i class="ace-icon fa fa-times"></i></button>
						<h4 class="modal-title text-left"><i class="ace-icon fa fa-exclamation-triangle orange"></i> Atenção</h4>
					</div>
					<div class="modal-body text-left">
						<p class="blue" style="text-align: left; margin: 0; padding: 5px 0;">Existem alterações na evolução que ainda não foram salvas.<br><b>Deseja realmente sair e perder essas alterações?</b></p>
					</div>
					<div class="modal-footer text-left" style="text-align: left;">
						<button id="btnSairSemSalvar" class="btn btn-danger btn-sm" type="button"><i class="ace-icon fa fa-times"></i> Sim, sair e perder alterações</button>
						<button id="btnContinuarEditando" class="btn btn-success btn-sm" type="button" data-dismiss="modal"><i class="ace-icon fa fa-ban"></i> Não, continuar editando</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Script do modal de evolução -->
		<script type="text/javascript">
			(function(){
				function $(id){ return document.getElementById(id); }
				var form = document.querySelector('form[action="/menu/agenda/evolucao"]');
				var btnSalvar = $('acaoSalvar');
				var modal = $('modalEvolucaoNaoFinalizada');
				var txtEvolucao = $('agendaEvolucao');
				var txtOriginal = $('agendaEvolucaoEdi');
				var chkFinalizada = $('agendaSelo');
				var inputSelamento = $('agendaSelamento');
				var submitPending = false;

				function initModal(){ if(window.jQuery && jQuery.fn.modal){ jQuery(modal).modal({show: false, backdrop: 'static', keyboard: false}); } }
				function showModal(){ if(window.jQuery && jQuery.fn.modal){ jQuery(modal).modal('show'); } else { modal.style.display = 'block'; } }
				function hideModal(){ if(window.jQuery && jQuery.fn.modal){ jQuery(modal).modal('hide'); } else { modal.style.display = 'none'; } }
				function evolucaoFoiAlterada(){ return (txtEvolucao.value || '').trim() !== (txtOriginal.value || '').trim(); }

				function prepararESubmit(marcarFinalizada){
					if(marcarFinalizada){
						chkFinalizada.checked = true; chkFinalizada.value = "true"; inputSelamento.value = "true";
						if(typeof selamento === 'function') selamento();
					}
					
					// 🚩 DESATIVA O AVISO NATIVO antes do submit programático
					if (typeof window.desativarAvisoSaida === 'function') {
						window.desativarAvisoSaida();
					}

					form.removeEventListener('submit', interceptSubmit, true);
					form.submit();
				}

				function interceptSubmit(e){
					if(submitPending) return true;
					var divEvolucao = $('divEvolucao');
					if(!divEvolucao || divEvolucao.offsetParent === null) return true;
					
					var evolucaoPreenchida = (txtEvolucao.value || '').trim().length > 0;
					var estaFinalizada = chkFinalizada.checked;

					if(evolucaoFoiAlterada() && evolucaoPreenchida && !estaFinalizada){
						e.preventDefault(); e.stopPropagation();
						if(!btnSalvar.dataset.modalBound){
							$('btnMarcarSalvar').addEventListener('click', function(){ hideModal(); prepararESubmit(true); });
							$('btnSalvarSemMarcar').addEventListener('click', function(){ hideModal(); prepararESubmit(false); });
							btnSalvar.dataset.modalBound = "true";
						}
						showModal(); return false;
					}
					
					// 🚩 Se chegou aqui, é um salvamento direto e válido. Desativa o aviso.
					if (typeof window.desativarAvisoSaida === 'function') {
						window.desativarAvisoSaida();
					}
					return true;
				}

				function bindEvents(){
					if(form) form.addEventListener('submit', interceptSubmit, true);
					if(btnSalvar) btnSalvar.addEventListener('click', function(e){ if(!interceptSubmit(e)) e.preventDefault(); });
					initModal();
				}
				if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindEvents); else bindEvents();

				document.addEventListener("DOMContentLoaded", function(){
					var btnCancelar = $("btnCancelarModal");
					if(btnCancelar && modal){
						btnCancelar.addEventListener("click", function(){
							if(window.jQuery && jQuery.fn.modal) jQuery(modal).modal("hide"); else modal.style.display = "none";
							
							// Se cancelou o salvamento, garantimos que a proteção continue ativa
							if (typeof window.reativarAvisoSaida === 'function') {
								window.reativarAvisoSaida();
							}
						});
					}
				});
			})();
		</script>
		
			<!-- Script Unificado: Saída Segura + Auto-Save + Recuperação (COM INTERCEPTADOR E CONTROLE DE AVISO) -->
		<script type="text/javascript">
		(function(){
			console.log("=== INÍCIO DO SCRIPT DE AUTO-SAVE E SAÍDA ===");
			try {
				var txtEvolucao = document.getElementById('agendaEvolucao');
				var txtOriginal = document.getElementById('agendaEvolucaoEdi');
				var btnRecuperar = document.getElementById('btnRecuperarRascunho');
				var idInput = document.getElementById('id');
				var form = document.querySelector('form[action="/menu/agenda/evolucao"]');
				var modalSaida = document.getElementById('modalConfirmarSaida');
				var rotaBase = "/menu/agenda/lisPessoal";

				if (!txtEvolucao || !txtOriginal) { 
					console.error("❌ ERRO CRÍTICO: Campos de evolução não encontrados!"); 
					return; 
				}
				
				var idAgendamento = idInput ? idInput.value : 'sem_id';
				var storageKey = 'rascunho_evolucao_' + idAgendamento;
				console.log("✅ Elementos encontrados. Chave:", storageKey);

				function houveAlteracao() {
					var atual = (txtEvolucao.value || '').trim();
					var original = (txtOriginal.value || '').trim();
					return atual !== original;
				}

				function autoSalvarRascunho() {
					try {
						var valorAtual = txtEvolucao.value;
						if (valorAtual && valorAtual.trim() !== '') {
							localStorage.setItem(storageKey, valorAtual);
						} else {
							localStorage.removeItem(storageKey);
						}
					} catch (e) { console.error("Falha ao salvar no localStorage:", e); }
				}

				// TRUQUE AVANÇADO: Interceptar QUALQUER alteração no 'value' do textarea
				const originalSet = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, 'value').set;
				Object.defineProperty(txtEvolucao, 'value', {
					set: function(newValue) {
						originalSet.call(this, newValue);
						this.dispatchEvent(new Event('input', { bubbles: true }));
					}
				});

				txtEvolucao.addEventListener('input', autoSalvarRascunho);

				window.recuperarRascunho = function() {
					try {
						var rascunho = localStorage.getItem(storageKey);
						if (rascunho !== null) {
							txtEvolucao.value = rascunho;
							btnRecuperar.style.display = 'none';
						}
					} catch (e) { console.error("Falha ao recuperar rascunho:", e); }
				};

				function verificarRascunhoAoCarregar() {
					try {
						var rascunho = localStorage.getItem(storageKey);
						var valorBanco = txtOriginal.value.trim();
						var valorAtual = txtEvolucao.value.trim();
						if (rascunho && rascunho !== valorBanco && rascunho !== valorAtual) {
							btnRecuperar.style.display = 'inline-block';
						}
					} catch (e) { console.error("Erro ao verificar rascunho:", e); }
				}

				function limparRascunhoNoSucesso() { 
					localStorage.removeItem(storageKey); 
				}
				if (form) {
					form.addEventListener('submit', limparRascunhoNoSucesso, true);
				}

				// 🚩 DEFINIMOS O LISTENER EM UMA VARIÁVEL PARA PODER REMOVÊ-LO
				var beforeUnloadListener = function (e) {
					if (houveAlteracao()) {
						e.preventDefault();
						e.returnValue = 'Você tem alterações não salvas na evolução. Deseja realmente sair?';
					}
				};
				
				// Adiciona o listener ao carregar
				window.addEventListener('beforeunload', beforeUnloadListener);

				// 🚩 FUNÇÕES GLOBAIS PARA CONTROLAR O AVISO (Chamadas pelo Script 1)
				window.desativarAvisoSaida = function() {
					console.log("[Saida] Salvamento legítimo detectado. Desativando aviso nativo do navegador.");
					window.removeEventListener('beforeunload', beforeUnloadListener);
				};

				window.reativarAvisoSaida = function() {
					console.log("[Saida] Ação de salvamento cancelada. Reativando proteção.");
					window.addEventListener('beforeunload', beforeUnloadListener);
				};

				window.verificarSaida = function(e){
					if(e) e.preventDefault();
					if(houveAlteracao()){
						if(window.jQuery && jQuery.fn.modal && modalSaida) {
							jQuery(modalSaida).modal('show');
						} else if (modalSaida) {
							modalSaida.style.display = 'block';
						}
					} else {
						window.location.href = rotaBase;
					}
				};

				function init() {
					verificarRascunhoAoCarregar();
					
					var btnSair = document.getElementById('btnSairSemSalvar');
					var btnContinuar = document.getElementById('btnContinuarEditando');
					
					if(btnSair) {
						btnSair.addEventListener('click', function(){ 
							if(window.jQuery && jQuery.fn.modal && modalSaida) jQuery(modalSaida).modal('hide');
							else if (modalSaida) modalSaida.style.display = 'none';
							window.location.href = rotaBase; 
						});
					}
					if(btnContinuar) {
						btnContinuar.addEventListener('click', function(){ 
							if(window.jQuery && jQuery.fn.modal && modalSaida) jQuery(modalSaida).modal('hide');
							else if (modalSaida) modalSaida.style.display = 'none';
						});
					}
				}

				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', init);
				} else {
					init();
				}
				
				console.log("=== FIM DO SCRIPT DE AUTO-SAVE (Carregado com Sucesso) ===");

			} catch (erroGeral) {
				console.error("💥 ERRO FATAL NO SCRIPT DE AUTO-SAVE:", erroGeral);
			}
		})();
		</script>
	</body>
</html>