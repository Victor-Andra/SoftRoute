		<script type="text/javascript">
			$(document).ready(function () {
				// Função principal para aplicar estilos por hora
				function aplicarEstiloPorHora() {
					$('tbody tr').each(function () {
						const $linha = $(this);
						const $horaCell = $linha.find('td:eq(0)');
						const horaTexto = $horaCell.text().trim(); // Ex: "11:20"
						if (!horaTexto) return;

						const [horaStr, minutoStr] = horaTexto.split(':');
						const hora = parseInt(horaStr, 10);

						// Aplica estilos de fundo
						$linha.find('td').each(function (index) {
							$(this).removeClass('bg-verde-suave bg-amarelo-suave');

							if (hora < 12) {
								$(this).addClass('bg-verde-suave');
							} else {
								$(this).addClass('bg-amarelo-suave');
							}

							// Negrito na primeira coluna (hora)
							if (index === 0) {
								$(this).html('<b>' + horaTexto + '</b>');
							}
						});
					});
				}

				// Inicializa DataTable
				var table = $('#dynamic-table').DataTable({
					"language": { "url": "/js/lang/datatable-pt-br.json" },
					"aaSorting": [],
					"aoColumns": [null, null, null,null, null, null, null, null,null, null, null,null, null, null, null, null],
					"responsive": true,
					
					"autoWidth": true,
					"paging": false,
					"searching": false,
					"ordering": true,
					"info": false,
					select: {
						style: 'multi'
					}
				});

				// Aplica estilo sempre que a tabela for redesenhada
				table.on('draw.dt', function () {
					aplicarEstiloPorHora();
				});

				// Primeira execução após carregar a página
				aplicarEstiloPorHora();
			});
		</script>
