<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <title>Agendamentos Cadastro Fixo</title>
    <!-- jQuery e Chosen CSS -->
    <link rel="stylesheet" href="/js/chosen/chosen.min.css">
    <style>
      .spanAzul {
        display: inline-block;
        position: relative;
        font-weight: 400;
        vertical-align: baseline;
        white-space: nowrap;
        background-color: #91b8d0;
        color: #fff;
        text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.15);
        padding: 4px 22px 5px 9px;
        margin-bottom: 3px;
        margin-right: 3px;
      }
      .aClose {
        position: absolute;
        top: 0;
        bottom: 0;
        right: 0;
        width: 18px;
        height: auto;
        line-height: 25px;
        text-align: center;
      }
      .icon-container {
        position: relative;
        display: inline-block;
      }
      .icon-text {
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%);
        background-color: rgba(0, 0, 0, 0.8);
        color: #fff;
        font-size: 14px;
        padding: 5px 10px;
        border-radius: 5px;
        display: none;
        white-space: pre-line;
        z-index: 9999;
        max-width: 250px;
      }
      .icon-container:hover .icon-text {
        display: block;
      }
      /* Destaque visual para campos com erro de validação */
      .chosen-container.chosen-error .chosen-single {
        border-color: #f00 !important;
        box-shadow: 0 0 5px rgba(255,0,0,0.5) !important;
      }
      /* Remove sombras e degrade do Chosen - fundo transparente */
      .chosen-container-single .chosen-single,
      .chosen-container-active .chosen-single,
      .chosen-container-single .chosen-single:focus,
      .chosen-container-single .chosen-single:active,
      .chosen-container-single.chosen-container-single-nosearch .chosen-single {
        background: transparent !important;
        background-image: none !important;
        filter: none !important;
        box-shadow: none !important;
        -webkit-box-shadow: none !important;
        -moz-box-shadow: none !important;
        border-color: #aaa !important;
      }
      .chosen-drop {
        background: #fff !important;
        background-image: none !important;
        box-shadow: none !important;
        -webkit-box-shadow: none !important;
        -moz-box-shadow: none !important;
        border-color: #aaa !important;
      }
      .chosen-results li {
        background: transparent !important;
      }
      .chosen-results li.highlighted {
        background: #eee !important;
        background-image: none !important;
        color: #333 !important;
      }
      /* Campo Convênio - visual de somente leitura */
      #agendaConvid_chosen .chosen-single {
        background-color: #f9f9f9 !important;
        background-image: none !important;
        color: #666 !important;
        cursor: not-allowed !important;
      }
    </style>
    <script type="text/javascript">
      function controlaCategoria(){
        let origem = document.getElementById("agendaOrg").value;
        if(origem == "Padrão"){
          document.getElementById("agendaCateg").value = "Padrão";
          document.getElementById("Padrão").style.display = "";
          document.getElementById("Falta").style.display = "none";
          document.getElementById("Apoio").style.display = "none";
          document.getElementById("Supervisão").style.display = "none";
          document.getElementById("Pais").style.display = "none";
          document.getElementById("Glosa").style.display = "none";
          document.getElementById("Extra").style.display = "none";
          document.getElementById("SubstitutoFixo").style.display = "none";
          document.getElementById("Padrão").ariaSelected=true;
        } else {
          document.getElementById("agendaCateg").value = "Padrão";
          document.getElementById("Padrão").style.display = "";
          document.getElementById("Falta").style.display = "";
          document.getElementById("Apoio").style.display = "";
          document.getElementById("Supervisão").style.display = "";
          document.getElementById("Pais").style.display = "";
          document.getElementById("Glosa").style.display = "";
          document.getElementById("Extra").style.display = "";
          document.getElementById("SubstitutoFixo").style.display = "";
        }
        this.mudaSubis();
        if(typeof jQuery !== 'undefined' && jQuery('#agendaCateg').data('chosen')) {
          jQuery('#agendaCateg').trigger('chosen:updated');
        }
      }

      function selectConv(){
        var beneId = document.getElementById("agendaBeneid").value;
        if(!beneId || beneId === '766f69643132333435366964' || beneId === '-') return;
        var v1 = document.getElementById(beneId).value.toString();
        console.log(v1);
        document.getElementById("agendaConvid").value = v1;
        if(typeof jQuery !== 'undefined' && jQuery('#agendaConvid').data('chosen')) {
          jQuery('#agendaConvid').trigger('chosen:updated');
        }
      }

      function atualizaConvId(){
        let convId = document.getElementById("agendaConvid").value;
        console.log(convId);
      }

      function carregaBody(){
        let data= new Date();
        let mes = (data.getMonth()+1).toString();
        let dia = (data.getUTCDate()).toString();
        if (mes.length == 1){ mes = "0"+mes; }
        if (dia.length == 1){ dia = "0"+dia; }
        let fulldate=(data.getFullYear()+"-"+mes+"-"+dia).toString();
        document.getElementById("agendaData").value = fulldate;
        document.getElementById("agendaExtra").value = "false";
        document.getElementById("agendaExtra").checked = false;
        console.log("carregou!");
        
        let arr = document.getElementsByName("tagContainerTerapeuta");
        arr.forEach((a)=>{
          let novo_vetor;
          let input = document.getElementById(a.id + "_input");
          if (input && input.value){
            novo_vetor = input.value.split(",");
            novo_vetor.forEach((e)=>{
              let excecao = document.getElementById(e+"_span");
              if(excecao) a.append(excecao.cloneNode(true));
            })
          }
        })
        
        let arrBene = document.getElementsByName("beneid");
        arrBene.forEach((bene)=>{
          let beneval = bene.value;
          let inputExcecao = document.getElementsByName("idBeneExceTera_"+beneval);
          if (inputExcecao){
            inputExcecao.forEach((exec)=>{
              let idExcecao = exec.value;
              let idsExceTera = document.getElementById(idExcecao+"_idsExceTera");
              if (idsExceTera && idsExceTera.value){
                let arr = idsExceTera.value;
                let container = document.getElementById("containerExecaoTerapeuta_"+idExcecao+"_"+beneval);
                if(container){
                  if (arr.includes(",")){
                    let arrIdTera = arr.split(",");
                    arrIdTera.forEach((tera)=>{
                      let el = document.getElementById(tera+"_span");
                      if(el) container.append(el.cloneNode(true));
                    })
                  } else {
                    let el = document.getElementById(idsExceTera.value+"_span");
                    if(el) container.append(el.cloneNode(true));
                  }
                }
              }
            })
          }
          let inputSubstituto = document.getElementsByName("idBeneSubsTera_"+beneval);
          if (inputSubstituto && inputSubstituto != ""){
            inputSubstituto.forEach((subs)=>{
              let idSubstituto = subs.value;
              let idsSubsTera = document.getElementById(idSubstituto+"_idsSubsTera");
              if (idsSubsTera && idsSubsTera.value) {
                let arr = idsSubsTera.value;
                let container = document.getElementById("containerSubsTerapeuta_"+idSubstituto+"_"+beneval);
                if(container){
                  if (arr.includes(",")){
                    let arrIdSubs = arr.split(",");
                    arrIdSubs.forEach((subs)=>{
                      let el = document.getElementById(subs+"_span");
                      if(el) container.append(el.cloneNode(true));
                    })
                  } else {
                    let el = document.getElementById(idsSubsTera.value+"_span");
                    if(el) container.append(el.cloneNode(true));
                  }
                }
              }
            })
          }
        });
        document.getElementById("divHoraInputIni").style.display = 'none';
        document.getElementById("divHoraInputFim").style.display = 'none';
      }

      var toogle = false;
      function alternaHorario(){
        document.getElementById("agendaHoraToogle").value = (toogle ? 'true' : 'false');;
        document.getElementById("agendaHoraToogleButton").value = (toogle ? 'Agenda padrão' : 'Agenda AT');
        document.getElementById("divHoraInputIni").style.display = (toogle ? 'none' : '');
        document.getElementById("divHoraInputFim").style.display = (toogle ? 'none' : '');
        document.getElementById("divHoraSelect").style.display = (!toogle ? 'none' : '');
        toogle = !toogle;
      }

      function alteraMigrado(){
        let chck = document.getElementById("agendaMigrado");
        chck.value = chck.checked ? "true" : "false";
        console.log(chck.value);
      }

      function alteraCheck(checkboxid, elementoid){
        let chck = document.getElementById(checkboxid);
        let elemento = document.getElementById(elementoid);
        elemento.value = chck.checked ? "true" : "false";
      }

      function mudaSubis() {
        let tipodoc = document.getElementById("agendaCateg").value;
        console.log(tipodoc);
        let widget = document.getElementById('widgetboxSubs');
        if (tipodoc == "SubstitutoFixo" && widget) {
          widget.style.display = 'block';
        } else if (widget) {
          widget.style.display = 'none';
        }
      }

      // FUNÇÃO DESATIVADA CONFORME SOLICITADO
      function selectSessao(){
        return;
      }

      function selectExcecao() {
        document.getElementById("blocoExcecaos").innerHTML = "";
        let beneId = document.getElementById("agendaBeneid").value;
        if(!beneId || beneId === '766f69643132333435366964' || beneId === '-') return;
        let tableClone = document.getElementById(beneId+"_divBeneExcecao");
        if(tableClone){
          document.getElementById("blocoExcecaos").append(tableClone.cloneNode(true));
        }
      }

      function validarCamposObrigatorios(e) {
        const campos = [
          { id: 'agendaBeneid', nome: 'Beneficiário' },
          { id: 'agendaUsuid', nome: 'Terapeuta' },
          { id: 'agendaTerapiaid', nome: 'Terapia' },
          { id: 'agendaSalaid', nome: 'Sala' }
        ];
        let erro = false;
        campos.forEach(c => {
          const el = document.getElementById(c.id);
          const val = el ? el.value : '';
          if (!val || val === '766f69643132333435366964' || val === '-') {
            alert('O campo "' + c.nome + '" é obrigatório e não pode ficar em branco ou com "-"!');
            if(typeof jQuery !== 'undefined' && jQuery('#'+c.id).data('chosen')) {
              jQuery('#'+c.id).closest('.chosen-container').addClass('chosen-error');
              jQuery('#'+c.id).trigger('chosen:updated');
            }
            erro = true;
          } else {
            if(typeof jQuery !== 'undefined') {
              jQuery('#'+c.id).closest('.chosen-container').removeClass('chosen-error');
            }
          }
        });
        if (erro) {
          e.preventDefault();
          return false;
        }
        return true;
      }
    </script>
  </head>
  <body class="no-skin" onload="javascript:controlaNave();carregaBody();controlaCategoria();">
    <div class="main-container ace-save-state" id="main-container">
      <div class="main-content">
        <div class="main-content-inner">
          <div class="breadcrumbs ace-save-state" id="breadcrumbs">
            <ul class="breadcrumb">
              <li>
                <i class="ace-icon fa fa-home home-icon"></i>
                <a href="#">Home</a>
              </li>
              <li class="active">Agendamentos Cadastro Fixo</li>
            </ul>
          </div>

          {{#compareString flash.sucesso "true"}}
