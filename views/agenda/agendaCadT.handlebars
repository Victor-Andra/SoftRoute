              <p>
                <strong><i class="ace-icon fa fa-check"></i>{{flash.texto}}</strong>
                <button type="button" class="close" onclick="javascript:OcultaMsg()">
                  <i class="ace-icon fa fa-times"></i>
                </button>
              </p>
            </div>
          {{else}}
            {{#compareString flash.sucesso "false"}}
              <div id="alertMsgFlash" name="alertMsgFlash" class="alert alert-danger">
                <p>
                  <strong><i class="ace-icon fa fa-times"></i>{{flash.texto}}</strong>
                  <button type="button" class="close" onclick="javascript:OcultaMsg()">
                    <i class="ace-icon fa fa-times"></i>
                  </button>
                </p>
              </div>
            {{/compareString}}
          {{/compareString}}

          <div class="row">
            <div class="col-xs-12">
              <div id="divCarrega" hidden>
                {{#each terapeutas}}
                  <span id="{{_id}}_span" class="spanAzul">{{usuario_nome}}</span>
                {{/each}}

                {{#each benes}}
                  <input class="hidden" id="bene" name="beneid" value="{{_id}}" />
                  <div id="{{_id}}_divBeneExcecao" name="excecaoAmostra">
                    <table id="dynamic-table2" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid">
                      <thead>
                        <tr role="row">
                          <th style="width: 15%;">Terapia</th>
                          <th style="width: 15%;">Terapeutas</th>
                          <th style="width: 15%;">Substitutos</th>
                          <th style="width: 15%;">Terapia Substituta</th>
                          <th style="width: 5%;">Obs</th>
                        </tr>
                      </thead>
                      <tbody>
                        {{#each ../excecaos}}
                          {{#ifEqual this.excecao_beneid ../_id}}
                            {{#isNull excecao_terapiaid}}{{else}}
                              <tr role="row" class="odd">
                                {{#each ../../terapias}}
                                  {{#ifEqual this._id ../excecao_terapiaid}}
                                    <td>{{terapia_nome}}</td>
                                  {{/ifEqual}}
                                {{/each}}
                                <td>
                                  <div class="tags" id="containerExecaoTerapeuta_{{_id}}_{{excecao_beneid}}" name="tagContainerTerapeuta">
                                    <input hidden id="{{_id}}_idsExceTera" name="idsExceTera" value="{{excecao_terapeutaid}}" />
                                    <input hidden id="idBeneExceTera_{{_id}}" name="idBeneExceTera_{{excecao_beneid}}" value="{{_id}}" />
                                  </div>
                                </td>
                                <td>
                                  <div class="tags" id="containerSubsTerapeuta_{{_id}}_{{excecao_beneid}}" name="tagContainerTerapeuta">
                                    <input hidden id="{{_id}}_idsSubsTera" name="idsSubsTera" value="{{excecao_substitutoid}}" />
                                    <input hidden id="idBeneSubsTera_{{_id}}" name="idBeneSubsTera_{{excecao_beneid}}" value="{{_id}}" />
                                  </div>
                                </td>
                                {{#each ../../terapias}}
                                  {{#ifEqual this._id ../excecao_substerapiaid}}
                                    <td>{{terapia_nome}}</td>
                                  {{/ifEqual}}
                                {{/each}}
                                <td>
                                  <input class="hidden" id="{{_id}}_exce_obs" value="{{excecao_obs}}" />
                                  <div class="icon-container">
                                    <i class="ace-icon fa fa-search bigger-130"></i>
                                    <span class="icon-text">Observação<br>{{excecao_obs}}</span>
                                  </div>
                                </td>
                              </tr>
                            {{/isNull}}
                          {{/ifEqual}}
                        {{/each}}
                      </tbody>
                    </table>
                  </div>
                {{/each}}
              </div>

              <form class="form-horizontal" role="form" action="/menu/agenda/add" method="POST" onsubmit="return validarCamposObrigatorios(event);">
                <div class="col-xs-12 col-sm-9">
                  <div class="widget-box">
                    <div class="widget-header">
                      <h4 class="widget-title">Agendamentos Fixos</h4>
                      <span class="widget-toolbar">
                        <a href="#" data-action="reload"><i class="ace-icon fa fa-refresh"></i></a>
                        <a href="#" data-action="collapse"><i class="ace-icon fa fa-chevron-up"></i></a>
                      </span>
                    </div>
                    <div class="widget-body">
                      <div class="widget-main">
                        <div class="row">
                          <div class="col-xs-12 col-sm-3">
