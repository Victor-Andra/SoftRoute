                            <div class="form-group">
                              <div class="col-sm-8">
                                <input id="agendaHora" name="agendaHora" type="text" />
                                {{!-- <select name="agendaHoraSelect" id="agendaHoraSelect" class="chosen-select" data-placeholder="Escolha...">
                                  {{#each horaages}}
                                    <option value="{{horaage_hora}}">{{horaage_hora}}</option>
