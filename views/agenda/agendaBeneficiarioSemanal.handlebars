<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Agenda Semanal por Beneficiário</title>
		<style>
			/* Estilo atualizado para funcionar tanto em th quanto em td */
			th.dia-semana,
			td.dia-semana {
				border-right: 3px solid #000 !important;
			}

			/* Fundo verde claro */
			.bg-verde-suave {
				background-color: #e5f5e5 !important;
			}

			/* Fundo amarelo claro */
			.bg-amarelo-suave {
				background-color: #f3f1e0 !important;
			}

			/* Linha divisória grossa após 11:20 */
			.divisoria-meio-dia td {
				border-bottom: 4px solid #999 !important;
			}
		</style>

		<script type="text/javascript">
			function atualizaData(){
				var dataIso = document.getElementById("dataAg").value+"T"+document.getElementById("agendaHora").value+":00.000Z";
				var dataFmt = new Date(dataIso);
				console.log(dataIso);
				document.getElementById("agendaData").value = dataFmt;

				$(document).ready(function () {
				// Executar após DataTables terminar de desenhar a tabela
				$('#dynamic-table').on('draw.dt', function () {
					aplicarEstiloPorHora();
				});

				// Primeira execução
				aplicarEstiloPorHora();
			});
			}
			function criarLinhaEspacadora(colspanTotal) {
				return `<tr class="espacador"><td colspan="${colspanTotal}"></td></tr>`;
			}
			function aplicarEstiloPorHora() {
				$('tbody tr').each(function () {
					const $linha = $(this);
					const $horaCell = $linha.find('td:eq(0)');
					const horaTexto = $horaCell.text().trim(); // Ex: "11:20"

					if (!horaTexto) return;

					const [horaStr, minutoStr] = horaTexto.split(':');
					const hora = parseInt(horaStr, 10);
					const minuto = parseInt(minutoStr, 10);

					// Aplica estilos de fundo
					$linha.find('td').each(function (index) {
						$(this).removeClass('bg-verde-suave bg-amarelo-suave');

						if (hora < 12) {
							$(this).addClass('bg-verde-suave');
						} else {
							$(this).addClass('bg-amarelo-suave');
						}

						if (index === 0) {
							$(this).html('<b>' + horaTexto + '</b>');
						}
					});

					// Aplica linha divisória se for exatamente 11:20
					if (hora === 11 && minuto === 20) {
						$linha.addClass('divisoria-meio-dia');
					} else {
						$linha.removeClass('divisoria-meio-dia');
					}
				});
			}
			function carregaBody(){
				let dias = ["seg","ter","qua","qui","sex"];
				try{
					dias.forEach((dia)=>{
						console.log("dia:"+dia)
						document.getElementsByName(dia).forEach((e)=>{
							let id = "hora"+e.id;
							let valor = e.value;
							console.log("valor")
							console.log(valor)
							//console.log("id")
							//console.log(id)
							if(valor != "766f69643132333435366964"){
								if(e.id.indexOf("TerapiaId_") != -1){
									console.log("CKLOINE: " +valor)
									let val = document.getElementById(valor).cloneNode(true);
									val.id = val.id+"x";
									document.getElementById(id).append(val);
									let color = e.id + "_" + e.value;
								let hav = document.getElementById(color)
								let extra = document.getElementsByName(color+"_extra")
								if (hav != null){
									let motivo = hav.value;
									console.log("motivo:"+motivo)
									switch (motivo) {
										case "Falta" :
											val.style.backgroundColor = "yellow";
											break;
										case "Falta Justificada":
											val.style.backgroundColor = "orange";
											break;
										case "Falta Absoluta":
											val.style.backgroundColor = "orange";
											break;
										case "Substituição":
											val.style.backgroundColor = "cyan";
											break;
										case "Roberta Disponpivel":
											val.style.backgroundColor = "salmon";
											break;
										case "Supervisor":
											val.style.backgroundColor = "lightpink";
											break;
										case "Ordinario":
											val.style.backgroundColor = "aquamarine";
											break;
										case "Nenhuma Observação":
											val.style.backgroundColor = "lightgreen";
											break;
										default :
											break;
									}
								}
								} else if(e.id.indexOf("TeraId_") != -1){//caso não seja ação precisa obter o nome do bene/tera pelos outros registros através do atributo valor q armazena o ID do mesmo
								console.log("clone: "+valor)
									let val = document.getElementById(valor).cloneNode(true);
									val.id = val.id+"x";
									document.getElementById(id).append(val);
									let color = e.id + "_" + e.value;
								let hav = document.getElementById(color)
								let extra = document.getElementsByName(color+"_extra")
								if (hav != null){
									let motivo = hav.value;
									console.log("motivo:"+motivo)
									switch (motivo) {
										case "Falta" :
											val.style.backgroundColor = "yellow";
											break;
										case "Falta Justificada":
											val.style.backgroundColor = "orange";
											break;
										case "Falta Absoluta":
											val.style.backgroundColor = "orange";
											break;
										case "Substituição":
											val.style.backgroundColor = "cyan";
											break;
										case "Roberta Disponpivel":
											val.style.backgroundColor = "salmon";
											break;
										case "Supervisor":
											val.style.backgroundColor = "lightpink";
											break;
										case "Ordinario":
											val.style.backgroundColor = "aquamarine";
											break;
										case "Nenhuma Observação":
											val.style.backgroundColor = "lightgreen";
											break;
										default :
											break;
									}
								}
								}
							}
						})
						document.getElementsByName(dia).forEach((e)=>{
							if(e.id.indexOf("AcaoId_") != -1){//se for a ação vai retornar a posição da string e caso não -1
								let id = "hora"+e.id;//td para receber o append
								console.log("id:"+id)
								let el = document.getElementById(e.id);//elemento da acao
								console.log("el:"+el)
								document.getElementById(id).append(el);
								//elemento td recebendo acao
							}
						})
					})
					//horasegTerapiaId_
				} catch(err){
					console.log(err)
				}
			}
			function formataData(){
				let dt = document.getElementById('dataFil').value;
				let dia = dt.substring(8,10);
				let mes = dt.substring(5,7);
				let ano = dt.substring(0,4);
				let fulldate=(ano+"-"+mes+"-"+dia+' 00:00:00.000Z').toString();
				document.getElementById('dataFinal').value = fulldate;
				console.log("dataFinal:"+document.getElementById('dataFinal').value);
			}
		</script>
	</head>
