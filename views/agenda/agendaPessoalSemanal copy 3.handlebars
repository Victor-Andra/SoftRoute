																			{{#each ../salas}}{{#ifEqual ../agenda_salaid _id}}{{sala_nome}}{{/ifEqual}}{{/each}} / 
																			{{#each ../benes}}{{#ifEqual ../agenda_beneid _id}}{{bene_apelido}}{{/ifEqual}}{{/each}} - {{agenda_obs}}</label><br>
																	{{/isNull}}
																{{/each}}
															</div>
														</div>
													</div>
												</th>
											</tr>
											<!-- Alerta do Terapeuta -->
											<tr role="row">
												<th class="center colgroup" aria-controls="dynamic-table" colspan="15">
													<div id="divAlertas">
														<div class="col-xs-12" style="padding-top: 2px;">
															<div class="alert alert-warning">
