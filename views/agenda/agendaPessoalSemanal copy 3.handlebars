									<i class="ace-icon fa fa-search-plus "></i>
								</button>
							</div>
						</div>
					</form>
					<div class="tab-content">
						<div class="row">
							<div class="col-xs-12">
								<div id="seg" class="tab-pane fade active in">
									<!-- ✅ Adicionada classe 'tabela-agenda' -->
									<table class="table table-sm table-bordered tabela-agenda" style="font-size: 9px;" id="dynamic-table" role="grid" aria-describedby="dynamic-table_info">
										<thead>
											<!-- Alerta da Agenda -->
											<tr role="row">
