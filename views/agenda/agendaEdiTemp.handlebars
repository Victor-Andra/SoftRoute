<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<title>Agendamentos</title>
	<script>
		// Variável global para salvar o valor da hora única quando o intervalo for ativado
			let valorHoraSalvo = null;

			function mudamuda(cor) {
				document.getElementById(cor).style.backgroundColor = cor;
			}

			function selectConv() {
				var beneId = document.getElementById("agendaBeneid").value;
				var refInput = document.getElementById(beneId);
				if (refInput) {
					document.getElementById("agendaConvid").value = refInput.value.toString();
					jQuery('#agendaConvid').trigger('chosen:updated');
				}
			}

			function carregaValores() {
				const v1 = document.getElementById("novaAgendaTerapiaid").value;
				console.log("novaAgendaTerapiaid selecionado:", v1);
				// Se precisar sincronizar com outro campo, descomente abaixo:
				// document.getElementById("agendaTerapiaidEdi").value = v1;
				jQuery("#novaAgendaTerapiaid").trigger("chosen:updated");
			}

			function atualizaData() {
				let horaParaSalvar = "";
				
				// Verifica se o intervalo está marcado para decidir qual hora usar
				if ($('#chkIntervaloHora').is(':checked')) {
					let ini = $('#agendaHoraIni').val();
					// Se tiver hora inicial, usa ela como base (ajuste conforme sua regra de backend)
					if (ini) horaParaSalvar = ini; 
				} else {
					horaParaSalvar = $('#agendaHoraSelect').val();
				}

				let dataStr = document.getElementById("dataAg").value;
				if (dataStr && horaParaSalvar) {
					let dataIso = dataStr + "T" + horaParaSalvar + ":00.000Z";
					let dataFmt = new Date(dataIso);
					document.getElementById("agendaData").value = dataFmt;
				}
			}

			function carregaBody() {
				// 1. Popula os campos com os valores dos inputs ocultos
				document.getElementById("dataAg").value = document.getElementById("agendaDataEdi").value || "";
				document.getElementById("agendaOrg").value = document.getElementById("agendaOrgEdi").value || "Padrão";
				document.getElementById("agendaCateg").value = document.getElementById("agendaCategEdi").value || "Padrão";
				document.getElementById("agendaBeneid").value = document.getElementById("agendaBeneidEdi").value || "";
				document.getElementById("agendaConvid").value = document.getElementById("agendaConvidEdi").value || "";
				document.getElementById("agendaTerapiaid").value = document.getElementById("agendaTerapiaidEdi").value || "";
				document.getElementById("novaAgendaTerapiaid").value = document.getElementById("agendaTerapiaidEdi").value || "";
				document.getElementById("agendaUsuid").value = document.getElementById("agendaUsuidEdi").value || "";
				document.getElementById("agendaSalaid").value = document.getElementById("agendaSalaidEdi").value || "";

				// 2. Lógica do Checkbox de Intervalo ao carregar (se houver hora ini/fim salva, ativa o modo intervalo)
				let horaIniEdi = document.getElementById("agendaHoraIniEdi")?.value;
				let horaFimEdi = document.getElementById("agendaHoraFimEdi")?.value;
				
				if (horaIniEdi && horaFimEdi && horaIniEdi !== horaFimEdi) {
					$('#chkIntervaloHora').prop('checked', true);
					$('#divHoraSelect').hide();
					$('#divHoraIntervalo').show();
					$('#agendaHoraIni').val(horaIniEdi);
					$('#agendaHoraFim').val(horaFimEdi);
				} else {
					// Modo hora única
					$('#chkIntervaloHora').prop('checked', false);
					$('#divHoraSelect').show();
					$('#divHoraIntervalo').hide();
					let horaEdi = document.getElementById("agendaHoraEdi").value;
					if (horaEdi) {
						$('#agendaHoraSelect').val(horaEdi);
						valorHoraSalvo = horaEdi; // Já salva na variável global
					}
				}

				// 3. Força a atualização visual de TODOS os selects (Chosen)
				if (typeof jQuery !== 'undefined') {
					const selectsChosen = ['agendaBeneid', 'agendaConvid', 'agendaOrg', 'agendaCateg', 'agendaUsuid', 'agendaTerapiaid', 'novaAgendaTerapiaid', 'agendaSalaid', 'agendaHoraSelect'];
					selectsChosen.forEach(id => {
						if (document.getElementById(id)) {
							jQuery(`#${id}`).trigger('chosen:updated');
						}
					});
				}

				// 4. Configurações de UI (Selo, Evolução, Botão Voltar)
				if (document.getElementById("agendaSelo").value === 'false') {
					document.getElementById("agendaSelo").checked = false;
				}
				if (document.getElementById("isAgendaTerapeuta").value === 'true') {
					document.getElementById("divEvolucao").style.display = "";
					document.getElementById("divEvolucao").removeAttribute("hidden");
				}
				
				document.getElementById('acaoCancelar').addEventListener('click', function() {
					window.history.back();
				});

				// 5. Finaliza montando a data oculta para o form
				atualizaData();
			}

			function alteraMigrado() {
				let chck = document.getElementById("agendaMigrado");
				chck.value = chck.checked ? "true" : "false";
			}

			function validarCamposObrigatorios(e) {
				const campos = [
					{ id: 'agendaBeneid', nome: 'Beneficiário' },
					{ id: 'agendaUsuid', nome: 'Terapeuta' },
					{ id: 'novaAgendaTerapiaid', nome: 'Terapia (substituição)' },
					{ id: 'agendaSalaid', nome: 'Local' },
					{ id: 'dataAg', nome: 'Data Agendamento' },
					{ id: 'agendaCateg', nome: 'Categoria' },
					{ id: 'agendaOrg', nome: 'Origem Agendamento' }
				];

				let camposComErro = [];

				campos.forEach(c => {
					const el = document.getElementById(c.id);
					if (!el) return;

					const val = el.value?.trim();
					if (!val || val === '766f69643132333435366964' || val === '-') {
						camposComErro.push(c.nome);
						if (typeof jQuery !== 'undefined' && jQuery('#' + c.id).data('chosen')) {
							jQuery('#' + c.id).closest('.chosen-container').addClass('chosen-error');
							jQuery('#' + c.id).trigger('chosen:updated');
						} else if (el.tagName === 'SELECT') {
							el.style.borderColor = '#f00';
						}
					} else {
						if (typeof jQuery !== 'undefined' && jQuery('#' + c.id).data('chosen')) {
							jQuery('#' + c.id).closest('.chosen-container').removeClass('chosen-error');
						} else if (el.tagName === 'SELECT') {
							el.style.borderColor = '';
						}
					}
				});

				if (camposComErro.length > 0) {
					e.preventDefault();
					alert('⚠️ Campos obrigatórios não preenchidos:\n\n• ' + camposComErro.join('\n• ') + '\n\nPor favor, selecione uma opção válida para continuar.');
					return false;
				}
				return true;
			}

			// FUNÇÃO CORRIGIDA COM VARIÁVEL GLOBAL
			function toggleIntervaloHora() {
				var isIntervalo = $('#chkIntervaloHora').is(':checked');
				
				if (isIntervalo) {
					// 1. SALVA o valor atual na variável global ANTES de limpar
					valorHoraSalvo = $('#agendaHoraSelect').val();
					
					// 2. Alterna a visibilidade
					$('#divHoraSelect').hide();
					$('#divHoraIntervalo').show();
					
					// 3. Limpa o select único para não enviar dado conflitante
					$('#agendaHoraSelect').val('');
					$('#agendaHoraSelect').trigger('chosen:updated');
				} else {
					// 1. Alterna a visibilidade de volta
					$('#divHoraSelect').show();
					$('#divHoraIntervalo').hide();
					
					// 2. Limpa os campos de intervalo
					$('#agendaHoraIni').val('');
					$('#agendaHoraFim').val('');
					
					// 3. RESTAURA o valor que estava salvo na variável global
					if (valorHoraSalvo) {
						$('#agendaHoraSelect').val(valorHoraSalvo);
					}
					$('#agendaHoraSelect').trigger('chosen:updated');
				}
				
				// Atualiza a data oculta sempre que o estado mudar
				atualizaData();
			}
	</script>
	</head>
	<body class="no-skin" onload="javascript:carregaBody();controlaNave();ajustaOption();">
