			function mudamuda(cor){
				document.getElementById(cor).style.backgroundColor = cor;
			}
			function selectConv(){
				var v1 = document.getElementById(document.getElementById("agendaBeneid").value).value.toString();
				console.log(v1)
				document.getElementById("agendaConvid").value = v1;
			}
			function carregaValores() {
				const v1 = document.getElementById("novaAgendaTerapiaid").value;
				console.log("novaAgendaTerapiaid selecionado:", v1);

				// Atualiza o valor do campo de edição e do select bloqueado
				//document.getElementById("agendaTerapiaid").value = v1;
				//document.getElementById("agendaTerapiaidEdi").value = v1;

				// Força o Chosen a atualizar o select desativado
				$("#agendaTerapiaid").trigger("chosen:updated");
			}
			function atualizaConvId(){
				let convId = document.getElementById("agendaConvid").value;
				console.log(convId)
			}
			function atualizaData(){
				var dataIso = document.getElementById("dataAg").value+"T"+document.getElementById("agendaHora").value+":00.000Z";
				var dataFmt = new Date(dataIso);
				console.log(dataIso);
				document.getElementById("agendaData").value = dataFmt;
			}
			function carregaBody(){
				document.getElementById("dataAg").value = document.getElementById("agendaDataEdi").value;
				document.getElementById("agendaHora").value = document.getElementById("agendaHoraEdi").value;
				document.getElementById("agendaOrg").value = document.getElementById("agendaOrgEdi").value;
				document.getElementById("agendaCateg").value = document.getElementById("agendaCategEdi").value;
				document.getElementById("agendaBeneid").value = document.getElementById("agendaBeneidEdi").value;
				document.getElementById("agendaConvid").value = document.getElementById("agendaConvidEdi").value;
				document.getElementById("agendaTerapiaid").value = document.getElementById("agendaTerapiaidEdi").value;
				document.getElementById("novaAgendaTerapiaid").value = document.getElementById("agendaTerapiaidEdi").value;
				document.getElementById("agendaUsuid").value = document.getElementById("agendaUsuidEdi").value;
				document.getElementById("agendaSalaid").value = document.getElementById("agendaSalaidEdi").value;
				//document.getElementById("agendaTempMotivo").value = document.getElementById("agendaTempMotivoEdi").value;
				atualizaData();
				if (document.getElementById("agendaSelo").value == 'false'){
					document.getElementById("agendaSelo").checked = false;
					document.getElementById("agendaSelo").style = '';
				}
				if (document.getElementById("isAgendaTerapeuta").value == 'true'){
					document.getElementById("divEvolucao").style = '';
				}
				document.getElementById('acaoCancelar').addEventListener('click', function() {
					window.history.back();
				});
			}
			function alteraMigrado(){
				let chck = document.getElementById("agendaMigrado");
				if(chck.checked){
					chck.value="true";
					console.log(chck.value);
				} else {
					chck.value="false";
					console.log(chck.value);
				}
			}
			function validarCamposObrigatorios(e) {
				// Campos obrigatórios + nomes amigáveis
				const campos = [
					{ id: 'agendaBeneid', nome: 'Beneficiário' },
					{ id: 'agendaUsuid', nome: 'Terapeuta' },
					{ id: 'novaAgendaTerapiaid', nome: 'Terapia (substituição)' },
					{ id: 'agendaSalaid', nome: 'Local' },
					{ id: 'agendaHora', nome: 'Hora Agendamento' },
					{ id: 'dataAg', nome: 'Data Agendamento' },
					{ id: 'agendaCateg', nome: 'Categoria' },
					{ id: 'agendaOrg', nome: 'Origem Agendamento' }
				];

				let camposComErro = [];

				campos.forEach(c => {
					const el = document.getElementById(c.id);
					if (!el) return;

					const val = el.value?.trim();
					
					// Verifica vazio, placeholder ou "-"
					if (!val || val === '766f69643132333435366964' || val === '-') {
					camposComErro.push(c.nome);
					
					// Destaque no Chosen
					if (typeof jQuery !== 'undefined' && jQuery('#' + c.id).data('chosen')) {
						jQuery('#' + c.id).closest('.chosen-container').addClass('chosen-error');
						jQuery('#' + c.id).trigger('chosen:updated');
					} else if (el.tagName === 'SELECT') {
						el.style.borderColor = '#f00';
					}
					} else {
					// Remove destaque se válido
					if (typeof jQuery !== 'undefined' && jQuery('#' + c.id).data('chosen')) {
						jQuery('#' + c.id).closest('.chosen-container').removeClass('chosen-error');
					} else if (el.tagName === 'SELECT') {
						el.style.borderColor = '';
					}
					}
				});

				// Bloqueia e mostra mensagem se houver erro
				if (camposComErro.length > 0) {
					e.preventDefault();
					
					const mensagem = '⚠️ Campos obrigatórios não preenchidos:\n\n• ' + 
									camposComErro.join('\n• ') + 
									'\n\nPor favor, selecione uma opção válida para continuar.';
					
					alert(mensagem);
					return false;
				}

				return true;
				}
			
		</script>
	</head>
	<body class="no-skin" onload="javascript:carregaBody();controlaNave();ajustaOption();">
		<div class="main-container ace-save-state" id="main-container">
			<div class="main-content">
				<div class="main-content-inner">
					<div class="breadcrumbs ace-save-state" id="breadcrumbs">
						<ul class="breadcrumb">
							<li>
								<i class="ace-icon fa fa-home home-icon"></i>
								<a href="#">Home</a>
							</li>
							<li class="active">Agendamentos Editar</li>
						</ul><!-- /.breadcrumb -->
					</div>
					<div class="row">
						<div class="col-xs-12">
							<!-- PAGE CONTENT BEGINS -->
							<form class="form-horizontal" role="form" action="/menu/agenda/atualizaTemp" method="POST" onsubmit="return validarCamposObrigatorios(event);">
								<div class="col-xs-12"><!-- Widget Dados Básicos -->
									<div class="widget-box">
										<div class="widget-header">
											<h4 class="widget-title">Agendamentos</h4>
											<input class="hidden" id="agendaId" name="agendaId" value="{{agenda._id}}" />
											<span class="widget-toolbar">
												<a href="#" data-action="reload">
													<i class="ace-icon fa fa-refresh"></i>
												</a>
												<a href="#" data-action="collapse">
													<i class="ace-icon fa fa-chevron-up"></i>
												</a>
											</span>
										</div>
										<div class="widget-body">
											<div class="widget-main">
												<div class="row">
													<div class="col-xs-12 col-sm-6">
														<label for="id-date-picker-1">Data Agendamento</label>
														<div class="row">
															<div class="col-xs-12 col-sm-8">
																<div class="input-group">
																	<input name="dataAg" id="dataAg" type="date" class="form-control" onchange="javascript:atualizaData()">
																</div>
															</div>
														</div>
													</div>
													<div class="col-xs-12 col-sm-6">
														<label for="id-date-picker-1">Hora Agendamento</label>
														<div class="form-group">
															<div class="col-xs-12 col-sm-10">
																<select name="agendaHora" id="agendaHora" class="select" data-placeholder="Escolha..." onchange="javascript:atualizaData()">
																	{{#each horaages}}
																		<option value="{{horaage_hora}}">{{horaage_hora}}</option>
																	{{/each}}
																</select>
															</div>
														</div>
													</div>
												</div>
												<div class="row">
													<div class="col-xs-12 col-sm-6">
														<label>Origem Agendamento</label>
														<div class="form-group">
															<div class="col-xs-12 col-sm-10">
																<select id="agendaOrg" name="agendaOrg" class="select" data-placeholder="Escolhaa a opção..." onchange="javascript:controlaCategoria()">
																	<option value="Administrativo">Administrativo</option>
																	<option value="Padrão">Padrão</option>
																</select>
															</div>
														</div>
													</div>
													<div class="col-xs-12 col-sm-6">
														<label>Categoria</label>
														<div class="form-group">
															<div class="col-xs-12 col-sm-10">
																<select id="agendaCateg" name="agendaCateg" class="select" data-placeholder="Escolha a opção..." onchange="javascript:ajustaOption();">
																	<option style="backgroundColor:lightgray" id="Padrão" value="Padrão" style="display: none;">Padrão</option>
																	<option style="backgroundColor:yellow" id="Falta" value="Falta">Falta</option>
																	<option style="backgroundColor:orange" id="Falta Justificada" value="Falta Justificada">Falta Justificada</option>
																	<option style="backgroundColor:orange" id="Falta Absoluta" value="Falta Absoluta">Falta Absoluta</option>
																	<option style="backgroundColor:orange" id="Feriado" value="Feriado">Feriado</option>
																	<option style="backgroundColor:gray" id="Glosa" value="Glosa">Glosa</option>
																	<option style="backgroundColor:cyan;" value="Substituição">Substituição</option>
																	<option style="backgroundColor:lightgreen" id="Pais" value="Pais">Pais</option>
																	<option style="backgroundColor:cyan" id="Substituto" value="Substituto">Substituto</option>
																	<option style="backgroundColor:rgb(225, 0, 255)" id="Supervisor" value="Supervisor">Supervisor</option>
																	<option style="background-color: lightgreen;" value="Nenhuma Observação">Nenhuma Observação</option>
																</select>
															</div>
														</div>
													</div>
												</div>
												<div class="row">
													<div class="col-xs-12 col-sm-6">
														<label>Beneficiário</label>
														<div class="hidden">
															{{#each benes}}
																{{#each ../convs}}
																	{{#ifEqual ../bene_convid _id}}
																		<input value="{{../bene_convid}}" id="{{../_id}}" name="refAgendaConvid" />
																	{{/ifEqual}}
																{{/each}}
															{{/each}}
														</div>
														<div class="form-group">
															<div class="col-xs-12 col-sm-10">
																<select name="agendaBeneid" id="agendaBeneid" class="select" data-placeholder="Escolha..." onchange="javascript:selectConv()">
																	{{#each benes}}
																		<option value="{{_id}}">{{bene_nome}}</option>
																	{{/each}}
																</select>
															</div>
														</div>
													</div>
													<div class="col-xs-12 col-sm-6">
														<label>Convênio</label>
														<div class="form-group">
															<div class="col-xs-12 col-sm-10">
																<select style="pointer-events: none; touch-action: none;" tabindex="-1" aria-disabled="true" name="agendaConvid" id="agendaConvid" class="select" data-placeholder="Escolha...">
																	{{#each benes}}
																		{{#each ../convs}}
																			{{#ifEqual ../bene_convid _id}}
																				<option value="{{../bene_convid}}">{{conv_nome}}</option>
																			{{/ifEqual}}
																		{{/each}}
																	{{/each}}
																</select>
															</div>
														</div>
													</div>
												</div>
												<div class="row">
													<div class="col-xs-12 col-sm-6">
														<label>Terapeuta</label>
														<div class="form-group">
															<div class="col-xs-12 col-sm-10">
