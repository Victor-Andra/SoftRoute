																	{{/if}}
																</div>
															</div>
														</div>
													</div>
												</div>
											</div>
										</div>
									</div>		
								</div>
								<div class="widget-box" id="obsterapeuta">
									<div class="widget-header">
										<h4 class="widget-title">
											<i class="red ace-icon fa fa-bookmark bigger-110"></i>
											Observações do Terapeuta
										</h4>
										<span class="widget-toolbar">
											<a href="#" data-action="collapse">
												<i class="ace-icon fa fa-chevron-up"></i>
											</a>
										</span>
									</div>
									<div class="widget-body">
										<div class="widget-main">
											<div class="row">
											<!-- 📌 ALERTA: Observações do Terapeuta -->
												<div role="row">
													<th class="center" colspan="4" style="padding: 5px;">
														<div id="divAlertas">
															<div class="col-xs-12 col-sm-12" style="padding-top: 2px;">
																<div class="alert alert-warning" style="margin-bottom: 0;">
																	<strong>Terapeuta</strong><br>
																	{{usu.usuario_obs}}
																</div>
															</div>
														</div>
													</th>
												</div>
											</div>
										</div>
									</div>		
								</div>
								<div class="widget-box" id="agendaDia">
									<div class="widget-header">
										<h4 class="widget-title">
											<i class="red ace-icon fa fa-bookmark bigger-110"></i>
											Minha Agenda do Dia
										</h4>
										<span class="widget-toolbar">
											<a href="#" data-action="collapse">
												<i class="ace-icon fa fa-chevron-up"></i>
											</a>
										</span>
									</div>
									<div class="widget-body">
										<div class="widget-main">
											<div class="row">
												
													<table id="dynamic-table1" class="table table-striped table-bordered table-hover dataTable no-footer" role="grid">
														<thead>
															<tr role="row">
																<th style="width: 60px;">Hora</th>
