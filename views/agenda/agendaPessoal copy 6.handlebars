								</button>
								<!-- Botão Voltar para Hoje -->
								&nbsp;&nbsp;&nbsp;&nbsp;
								<button type="button" class="btn btn-xs btn-warning" onclick="window.location.href='/menu/agenda/lisPessoal'" style="margin-left: 10px;">
									<i class="ace-icon fa fa-calendar-day"></i> Hoje
								</button>
							</div>
						</div>
					</form>
			
					<div class="tab-content">
						<div class="row">
							<div class="col-xs-12 col-sm-12">
								<div class="widget-box" id="obsAgenda">
									<div class="widget-header">
										<h4 class="widget-title">
											<i class="red ace-icon fa fa-bookmark bigger-110"></i>
											Observações da Agenda
										</h4>
										<span class="widget-toolbar">
											<a href="#" data-action="collapse">
												<i class="ace-icon fa fa-chevron-up"></i>
											</a>
										</span>
									</div>
									<div class="widget-body">
										<div class="widget-main">
											<div class="row">
												<!-- 📌 ALERTA: Observações do Terapeuta -->
												<div role="row">
													<div class="center" colspan="4" style="padding: 5px;">
														<div id="divAlertas">
															<div class="col-xs-12 col-sm-12" style="padding-top: 2px;">
																<div class="alert alert-danger" style="margin-bottom: 0;">
																	<strong>Agenda</strong><br>
																	{{#each agendas}}
																		{{#isNull agenda_obs}}
																		{{else}}
																			<label style="font-size: 9px;">
																				{{agenda_data_dia}} {{agenda_hora}} / 
																				{{#each ../salas}}
																					{{#ifEqual ../agenda_salaid _id}}
																						{{sala_nome}}
																					{{/ifEqual}}
																				{{/each}}
																				/ {{#each ../benes}}
																					{{#ifEqual ../agenda_beneid _id}}
																						{{bene_apelido}}
																					{{/ifEqual}}
																				{{/each}}
																				- {{agenda_obs}}
																			</label><br>
																		{{/isNull}}
																	{{/each}}
