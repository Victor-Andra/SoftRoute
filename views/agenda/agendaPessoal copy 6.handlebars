																</td>
																
																<!-- 👉 Evoluir: ícone com tooltip -->
																	<td class="text-center" style="vertical-align: middle; width: 50px;">
																		{{#ifEqual agenda_selo true}}
																			<span class="badge badge-success badge-ok">Ok</span>
																		{{else}}
																			<div class="custom-tooltip">
																				{{#ifEqual ui.icone "ban"}}
																					<i class="ace-icon fa fa-ban bigger-130"></i>
																				{{else}}
																					{{#if ui.temLink}}
																						<a href="javascript:evolucaoSemanalEmDia('{{_id}}');" style="display:inline-block;">
																							<i class="ace-icon fa fa-pencil bigger-130"></i>
																						</a>
																					{{else}}
																						<i class="ace-icon fa fa-pencil bigger-130"></i>
																					{{/if}}
																				{{/ifEqual}}
																				<span class="tooltip-text">
																					<strong style="color:#c00">{{ui.tooltipTitulo}}</strong><br>
																					{{ui.tooltipTexto}}
																				</span>
																			</div>
																		{{/ifEqual}}
																	</td>
															</tr>
															{{/each}}
														</tbody>
													</table>
												
											</div>
											<!-- 👉 LABELS OCULTOS: Nomes dos beneficiários (para o JS clonar) -->
											<div class="hidden" id="divBeneLabels">
												{{#each benes}}
													<label id="{{_id}}" style="display:none;">{{bene_nome}}</label>
												{{/each}}
											</div>

											<!-- 👉 INPUTS PARA JS: Mapeia dia/hora → beneId + categoria -->
											<div class="hidden" id="divBeneData">
												{{#each agendas}}
													<input name="{{agenda_data_semana}}BeneId_{{agenda_hora}}_{{agenda_beneid}}" 
														value="{{cadeia.ultimoCategoria}}{{#unless cadeia.ultimoCategoria}}{{agenda_categoria}}{{/unless}}">
												{{/each}}
											</div>
											
										</div>
									</div>		
								</div>
							</div>
						</div>
					</div>
				</div>

			</div><!-- /.main-content -->
		</div><!-- /.main-container -->
		<!-- basic scripts -->
		
		<script>
			// 🎨 FUNÇÃO UNIFICADA: pintaAgenda (COR DO TEXTO, igual branco.hbs)
			function pintaAgenda(val, motivo, meta){
	const texto = val?.textContent?.trim() || val?.innerText?.trim() || "—";

	const corFundo = meta?.cor || "transparent";
	const corBorda = meta?.borda || "transparent";
	const cadeia = parseInt(meta?.cadeia || "1");

	if (val) {
		val.innerHTML = '';

		const badge = document.createElement('span');
		badge.className = 'badge-agenda';

		badge.style.cssText = `
			background-color: ${corFundo} !important;
			border: 1px solid ${corBorda};
			color: #212529;
			display: inline-block;
			padding: 2px 6px;
			font-size: 9px;
			font-weight: 500;
			border-radius: 3px;
			white-space: nowrap;
			line-height: 1.3;
		`;

		// 🔗 Cadeia
		let prefixo = "";
		if (cadeia > 1) prefixo = "🔗 ";

		badge.textContent = prefixo + texto;
		val.appendChild(badge);
	}

	console.log(`🎨 BackendColor: ${corFundo} | Cat: ${motivo} | Cadeia: ${cadeia}`);
}
			// ✅ Garante que a função seja aplicada após o DOM carregar
			document.addEventListener('DOMContentLoaded', function() {
				console.log("🚀 [Agenda Pessoal] DOM pronto, formatando cores...");
				// Se carregaBody já roda no onload, não precisa chamar aqui
				// Mas se quiser forçar uma reaplicação:
				// setTimeout(() => carregaBody(), 150);
			});
		</script>
	</body>
</html>