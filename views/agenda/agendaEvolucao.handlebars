			function mudamuda(cor){
				document.getElementById(cor).style.backgroundColor = cor;
			}
			function selectConv(){
				var v1 = document.getElementById(document.getElementById("agendaBeneid").value).value.toString();
				console.log(v1)
				document.getElementById("agendaConvid").value = v1;
			}
			function atualizaConvId(){
				let convId = document.getElementById("agendaConvid").value;
				console.log(convId)
			}
			function atualizaData(){
				var dataIso = document.getElementById("dataAg").value+"T"+document.getElementById("agendaHora").value+":00.000Z";
				var dataFmt = new Date(dataIso);
				console.log(dataIso);
				document.getElementById("agendaData").value = dataFmt;
			}
			function controlaCategoria() {
				const origem = document.getElementById("agendaOrg").value;
				const selectEl = document.getElementById("agendaCateg");
				
				// Limpa opções
				selectEl.innerHTML = '';

				let opcoes = [];
				let valorPadrao = "Apoio";

				if (origem === "Padrão") {
					opcoes = [{ value: "Padrão", label: "Padrão" }];
					valorPadrao = "Padrão";
				} else {
					opcoes = [
						{ value: "Apoio", label: "Apoio" },
						{ value: "Extra", label: "Extra" },//
						{ value: "Falta", label: "Falta" },
						{ value: "Falta Justificada", label: "Falta Justificada" },//Falta N evoluir
						{ value: "Falta Absoluta", label: "Falta Absoluta" },//Falta N evoluir
						{ value: "Feriado", label: "Feriado" },//
						{ value: "Glosa", label: "Glosa" },//
						{ value: "Pais", label: "Pais" },
						{ value: "Substituição", label: "Substituto" },
						{ value: "SubstitutoFixo", label: "Substituto Fixo" },//Padrao
						{ value: "Supervisão", label: "Supervisão" }//
					];
				}

				// Adiciona opções
				opcoes.forEach(opt => {
					const option = document.createElement("option");
					option.value = opt.value;
					option.textContent = opt.label;
					selectEl.appendChild(option);
				});

				// Define valor padrão
				selectEl.value = valorPadrao;

				// ✅ Atualiza Chosen
				if (typeof jQuery !== 'undefined') {
					$(selectEl).trigger("chosen:updated");
				}
			}
			function carregaBody(){
				// 1. Preenche os valores nos selects (DOM puro)
				var dataEdi = document.getElementById("agendaDataEdi").value;
				var horaEdi = document.getElementById("agendaHoraEdi").value;
				var orgEdi = document.getElementById("agendaOrgEdi").value;
				var categEdi = document.getElementById("agendaCategEdi").value;
				var beneEdi = document.getElementById("agendaBeneidEdi").value;
				var convEdi = document.getElementById("agendaConvidEdi").value;
				var terapiaEdi = document.getElementById("agendaTerapiaidEdi").value;
				var usuidEdi = document.getElementById("agendaUsuidEdi").value;
				var salaidEdi = document.getElementById("agendaSalaidEdi").value;

				if (dataEdi) document.getElementById("dataAg").value = dataEdi;
				if (horaEdi) document.getElementById("agendaHora").value = horaEdi;
				if (orgEdi) document.getElementById("agendaOrg").value = orgEdi;
				if (categEdi) document.getElementById("agendaCateg").value = categEdi;
				if (beneEdi) document.getElementById("agendaBeneid").value = beneEdi;
				if (convEdi) document.getElementById("agendaConvid").value = convEdi;
				if (terapiaEdi) document.getElementById("agendaTerapiaid").value = terapiaEdi;
				if (usuidEdi) document.getElementById("agendaUsuid").value = usuidEdi;
				if (salaidEdi) document.getElementById("agendaSalaid").value = salaidEdi;

				// 2. Atualiza os Chosen (obrigatório após mudar .value de um select)
				//    — Só executa se jQuery estiver disponível (como deve estar, por main.handlebars)
				if (typeof jQuery !== 'undefined') {
					try {
						$("#agendaHora, #agendaOrg, #agendaCateg, #agendaBeneid, #agendaConvid, #agendaTerapiaid, #agendaUsuid, #agendaSalaid")
							.trigger("chosen:updated");
					} catch (e) {
						console.warn("[carregaBody] chosen:updated falhou — verificar init do Chosen", e);
					}
				}

				// 3. Atualiza data composta (ISO)
				atualizaData();

				// 4. Checkbox de selo
				var selamentoEl = document.getElementById("agendaSelamento");
				var seloCheckbox = document.getElementById("agendaSelo");
				if (selamentoEl && seloCheckbox) {
					if (selamentoEl.value === 'false') {
						seloCheckbox.checked = false;
						seloCheckbox.removeAttribute("disabled"); // mantém editável
					} else {
						seloCheckbox.checked = true;
					}
				}

				// 5. Evolução (só mostra se for terapeuta/supervisor)
				var isTerapeuta = document.getElementById("isAgendaTerapeuta");
				var divEvolucao = document.getElementById("divEvolucao");
				if (isTerapeuta && isTerapeuta.value === 'true' && divEvolucao) {
					divEvolucao.style.display = "";
				}

				// 6. Campo de evolução (textarea)
				var evolEdi = document.getElementById("agendaEvolucaoEdi");
				var evolTxt = document.getElementById("agendaEvolucao");
				if (evolEdi && evolTxt) {
					evolTxt.value = evolEdi.value || "";
				}

				// 7. Botão Cancelar → volta
				var btnCancelar = document.getElementById('acaoCancelar');
				if (btnCancelar) {
					btnCancelar.addEventListener('click', function(e) {
						e.preventDefault();
						window.history.back();
					});
				}
			}
			function alteraMigrado(){
				let chck = document.getElementById("agendaMigrado");
				if(chck.checked){
					chck.value="true";
					console.log(chck.value);
				} else {
					chck.value="false";
					console.log(chck.value);
				}
			}
			function selamento(){
				document.getElementById("agendaSelamento").value = document.getElementById("agendaSelo").checked;
			}
		</script>
		<script type="text/javascript">
(function(){
  function log(...args){ if(window.console) console.log("[Evolucao]", ...args); }

  // lê valor de elemento por id ou name e normaliza pra boolean quando possível
  function readValueFromEl(el){
    if(!el) return null;
    var v = el.value;
    if(typeof v === "string") v = v.trim().toLowerCase();
    if(v === "true") return true;
    if(v === "false") return false;
    if(el.type === "checkbox") return !!el.checked;
    return null;
  }

  // tenta localizar a flag em uma lista de ids/names conhecidos
  function detectSupervisorFlag(){
    var candidates = ["isAgendaSuperCoo","isAgendaTerapeuta","isAgendaSuperCooInput","isAgendaTerapeutaInput","agendasup","agendatera"];
    for(var i=0;i<candidates.length;i++){
      var id = candidates[i];
      var elById = document.getElementById(id);
      if(elById){
        var v = readValueFromEl(elById);
        if(v === true || v === false) { log("flag detectada por id:", id, v); return {found:true, id:id, value:v}; }
      }
      var elsByName = document.getElementsByName(id);
      if(elsByName && elsByName.length){
        var v2 = readValueFromEl(elsByName[0]);
        if(v2 === true || v2 === false) { log("flag detectada por name:", id, v2); return {found:true, id:id, value:v2}; }
      }
    }

    // fallback: procura inputs cujo id/name contenham 'super' ou 'sup'
    var inputs = document.querySelectorAll('input');
    for(var j=0;j<inputs.length;j++){
      var inp = inputs[j];
      var token = (inp.id||"") + "|" + (inp.name||"");
      if(/super|sup/i.test(token)){
        var vv = readValueFromEl(inp);
        log("fallback candidate:", token, "value:", inp.value);
        if(vv === true || vv === false) return {found:true, id: inp.id||inp.name||token, value: vv};
      }
    }

    // fallback 2: procura os campos explícitos que você adicionou (agendasup / agendatera) mesmo sem id
    var byNameAgSup = document.getElementsByName("agendasup");
    if(byNameAgSup && byNameAgSup.length){
      var v = readValueFromEl(byNameAgSup[0]);
      if(v === true || v === false) { log("flag detectada por name: agendasup", v); return {found:true, id:"agendasup", value:v}; }
    }
    var byNameAgTer = document.getElementsByName("agendatera");
    if(byNameAgTer && byNameAgTer.length){
      var v = readValueFromEl(byNameAgTer[0]);
      if(v === true || v === false) { log("flag detectada por name: agendatera", v); return {found:true, id:"agendatera", value:v}; }
    }

    log("nenhuma flag clara encontrada; retornando found:false (value=false)");
    return {found:false, id:null, value:false};
  }

  // utilitários DOM esperados
  function $(id){ return document.getElementById(id); }

  document.addEventListener("DOMContentLoaded", function(){
    try {
      var catSelect = $("evolucaoconfCategoria");
      var tituloSelect = $("evolucaoconfTitulo");
      var evolPad = $("evolucaoconfEvolucaopad");
      var evolucaoTxt = $("agendaEvolucao");
      var divEvolucaoConf = $("divEvolucaoConf");
      var sourceNodes = document.querySelectorAll("#evolucaoconfSource .evitem");

      if(!catSelect || !tituloSelect || !evolPad || !evolucaoTxt || !divEvolucaoConf){
        log("Elementos obrigatórios faltando:", {
          cat: !!catSelect, titulo: !!tituloSelect, pad: !!evolPad, ag: !!evolucaoTxt, div: !!divEvolucaoConf
        });
        return;
      }

      // carrega dados do bloco oculto
      var evolucaoconfs = [];
      sourceNodes.forEach(function(span){
        evolucaoconfs.push({
          evolucaoconf_categoria: span.getAttribute("data-cat") || "",
          evolucaoconf_titulo: span.getAttribute("data-titulo") || "",
          evolucaoconf_evolucaopad: span.getAttribute("data-evol") || ""
        });
      });
      log("items evolucaoconf lidos:", evolucaoconfs.length);

      function setOnlyDash(selectEl){
        selectEl.innerHTML = "";
        var o = document.createElement("option");
        o.value = "-"; o.textContent = "-";
        selectEl.appendChild(o);
        selectEl.value = "-";
      }

      function preencherCategorias(){
        catSelect.innerHTML = "";
        var optPad = document.createElement("option"); optPad.value = "-"; optPad.textContent = "-"; catSelect.appendChild(optPad);
        var cats = Array.from(new Set(evolucaoconfs.map(e=>e.evolucaoconf_categoria).filter(Boolean)));
        cats.sort();
        cats.forEach(function(c){
          var o = document.createElement("option"); o.value = c; o.textContent = c; catSelect.appendChild(o);
        });
      }

      function preencherTitulos(categoria){
        tituloSelect.innerHTML = "";
        var optPad = document.createElement("option"); optPad.value = "-"; optPad.textContent = "-"; tituloSelect.appendChild(optPad);
        if(!categoria || categoria === "-") return;
        var filtrados = evolucaoconfs.filter(e => e.evolucaoconf_categoria === categoria);
        filtrados.sort((a,b)=> a.evolucaoconf_titulo > b.evolucaoconf_titulo ? 1 : -1);
        filtrados.forEach(function(f){
          var o = document.createElement("option"); o.value = f.evolucaoconf_titulo; o.textContent = f.evolucaoconf_titulo;
          o.setAttribute("data-evol", f.evolucaoconf_evolucaopad || "");
          tituloSelect.appendChild(o);
        });
      }

      // eventos
      catSelect.addEventListener("change", function(){
        var v = this.value;
        if(!v || v === "-"){
          setOnlyDash(tituloSelect);
          evolPad.value = "";
          evolucaoTxt.value = "";
		  console.log("FUCK1");
          return;
        }
        preencherTitulos(v);
        evolPad.value = "";
        evolucaoTxt.value = "";
		console.log("FUCK2");
      });

      tituloSelect.addEventListener("change", function(){
        var sel = this.options[this.selectedIndex];
        if(!sel || sel.value === "-"){
          evolPad.value = "";
          evolucaoTxt.value = "";
		  console.log("FUCK3");
          return;
        }
        var pad = sel.getAttribute("data-evol") || "";
        evolPad.value = pad;
        evolucaoTxt.value = sel.value + "\n" + pad;
      });

      function resetAndHideAll(){
        try{ catSelect.value = "-"; }catch(e){}
        setOnlyDash(tituloSelect);
        try{ tituloSelect.value = "-"; }catch(e){}
        evolPad.value = "";
        evolucaoTxt.value = "";
		console.log("FUCK4");
        divEvolucaoConf.style.display = "none";
        catSelect.setAttribute("disabled","disabled");
        tituloSelect.setAttribute("disabled","disabled");
        log("reset e hide executados");
      }

      function enableAndShow(){
        var cats = Array.from(new Set(evolucaoconfs.map(e=>e.evolucaoconf_categoria).filter(Boolean)));
        preencherCategorias();
        divEvolucaoConf.style.display = "";
        catSelect.removeAttribute("disabled");
        tituloSelect.removeAttribute("disabled");
        log("enableAndShow executado");
      }

      // aplica conforme flag detectada
      function aplicarSegunFlag(){
        var flag = detectSupervisorFlag();
        log("detectSupervisorFlag ->", flag);
        if(flag.found && flag.value === true){
          enableAndShow();
        } else {
          resetAndHideAll();
        }
        return flag;
      }

      // primeira execução
      var flag = aplicarSegunFlag();

      // observa inputs que possamos ter utilizado
      var watchNames = ["isAgendaSuperCoo","isAgendaTerapeuta","agendasup","agendatera"];
      watchNames.forEach(function(nm){
        var el = document.getElementById(nm) || document.getElementsByName(nm)[0];
        if(el){
          el.addEventListener("change", function(){
            log("watcher change em", nm, "=>", el.value);
            aplicarSegunFlag();
          });
          el.addEventListener("input", function(){
            log("watcher input em", nm, "=>", el.value);
            aplicarSegunFlag();
          });
        }
      });

    } catch(err){
      console.error("[Evolucao] erro:", err);
    }
  });
})();
</script>



	</head>
